@using System.Globalization

@* A box for a weight that is stored in grams. It shows the number in the unit that goes with the length
   setting (ounces when lengths are in inches) and gives back grams. Text that is left as it was shown is
   not given back, so opening and saving leaves the stored grams exactly as they were. *@

<input type="number" step="any" inputmode="decimal" value="@Shown" @onchange="ChangedAsync" @attributes="Attributes" />

@code {
    /// <summary>The weight as stored, in grams.</summary>
    [Parameter]
    public decimal? Value { get; set; }

    [Parameter]
    public EventCallback<decimal?> ValueChanged { get; set; }

    /// <summary>Id, class, aria-label, min and the rest go on the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Attributes { get; set; }

    private string Shown => Value is { } grams ? Weights.ToInput(grams).ToString("0.####", CultureInfo.InvariantCulture) : "";

    private async Task ChangedAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim() ?? "";
        if (text == Shown)
            return;

        if (!Weights.TryParse(text, out var grams))
            return;

        await ValueChanged.InvokeAsync(grams);
    }
}
