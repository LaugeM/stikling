@* Shows a stored photo. The image data is read from the device database via PhotoService. On a
   synced device, a full size that isn't here yet is fetched, with the thumbnail shown meanwhile.
   Where it's cropped, it is moved and zoomed the way the photo was framed. *@
@implements IDisposable
@using Stikling.Core.Sync
@inject PhotoService Photos
@inject SyncRunner Sync

@if (url is not null)
{
    <img src="@url" alt="@Alt" class="@ImageClass" style="@FrameStyle" loading="lazy" decoding="async" />
}
else
{
    <span class="@Class photo-placeholder" role="img" aria-label="@(missing ? "Photo missing" : "Loading photo")"></span>
}

@code {
    [Parameter, EditorRequired]
    public Guid PhotoId { get; set; }

    /// <summary>Use the small version (lists, grids) instead of the full-size one.</summary>
    [Parameter]
    public bool Thumbnail { get; set; } = true;

    [Parameter]
    public string Alt { get; set; } = "";

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Move and zoom it the way it was framed. Off where the whole photo is shown.</summary>
    [Parameter]
    public bool Framed { get; set; } = true;

    private string? url;
    private bool missing;
    private bool small;
    private (Guid, bool) loadedFor;
    private PhotoFrame? frame;
    private double aspect;
    private Guid? frameFor;

    protected override void OnInitialized()
    {
        Sync.PhotosArrived += OnPhotosArrived;
        Photos.FrameChanged += OnFrameChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Framed && frameFor != PhotoId)
        {
            frameFor = PhotoId;
            UseFrameOf(await Photos.GetDetailsAsync(PhotoId));
        }

        if (loadedFor == (PhotoId, Thumbnail) && (url is not null || missing))
            return;

        loadedFor = (PhotoId, Thumbnail);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (id, thumbnail) = loadedFor;
        url = await Photos.GetUrlAsync(id, thumbnail);
        small = false;

        if (url is null && !thumbnail)
        {
            url = await Photos.GetUrlAsync(id, true);
            small = url is not null;
            _ = FetchFullAsync(id);
        }

        missing = url is null;
    }

    private async Task FetchFullAsync(Guid id)
    {
        if (!await Sync.FetchPhotoAsync(id, PhotoSize.Full) || loadedFor != (id, false))
            return;

        url = await Photos.GetUrlAsync(id, false) ?? url;
        missing = url is null;
        small = false;
        StateHasChanged();
    }

    private void OnPhotosArrived()
    {
        // Only a photo shown as missing needs another look. A full size shown small is fetched on its own
        if (!missing || small)
            return;

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private bool IsFramed => Framed && frame is not null && aspect > 0;

    private string? ImageClass => IsFramed ? $"{Class} framed".Trim() : Class;

    // The "framed" class in app.css does the placing, from the photo's shape and these numbers
    private string? FrameStyle => IsFramed && frame is { } f
        ? FormattableString.Invariant($"--fx:{f.X:0.###};--fy:{f.Y:0.###};--z:{f.Zoom:0.###};--a:{aspect:0.####}")
        : null;

    private void UseFrameOf(Photo? photo)
    {
        frame = photo?.Frame;
        aspect = photo is { Width: > 0, Height: > 0 } ? (double)photo.Width / photo.Height : 0;
    }

    private void OnFrameChanged(Photo photo)
    {
        if (photo.Id != PhotoId || !Framed)
            return;

        _ = InvokeAsync(() =>
        {
            UseFrameOf(photo);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Sync.PhotosArrived -= OnPhotosArrived;
        Photos.FrameChanged -= OnFrameChanged;
    }
}
