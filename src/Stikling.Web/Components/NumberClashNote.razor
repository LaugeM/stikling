@* "Big Monstera also has #117.", with the names linking to the plants or propagations that share the number.
   Only a note: two with the same number are never changed or blocked. *@
@if (Clashes.Count > 0)
{
    <p class="number-clash">
        @Names()
    </p>
}

@code {
    [Parameter]
    public string? Code { get; set; }

    private MarkupString Names()
    {
        var links = string.Join(", ", Clashes.Select(clash =>
            $"<a href=\"{(clash.IsPropagation ? "propagations" : "plants")}/{clash.Id}\">{System.Net.WebUtility.HtmlEncode(clash.Name)}</a>"));
        var format = Clashes.Count == 1 ? Strings.Plants.NumberClashOne : Strings.Plants.NumberClashMany;
        return (MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, format, links, System.Net.WebUtility.HtmlEncode(CollectionNumbers.Normalize(Code) ?? ""));
    }

    [Parameter]
    public IReadOnlyList<CodeClash> Clashes { get; set; } = [];
}
