@* Logging a treatment on a pest case. The next date is prefilled from the case's interval.
   Changing it here is how you get a different gap without changing the interval itself.
   With Check set it logs a look for pests on a case being watched: only a date and notes.
   A saved recipe is picked from chips and copied onto the treatment. Anything else is typed. *@
@inject IPestTreatmentRepository Repository
@inject ITreatmentRecipeRepository Recipes
@inject TimeProvider Time

<div class="care-sheet">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    @if (!Check && recipes.Count > 0)
    {
        <div class="mb-2">
            <div class="form-label">Recipe</div>
            <div class="chip-row" role="group" aria-label="Recipes">
                @foreach (var recipe in recipes)
                {
                    <button type="button" class="chip @(recipeId == recipe.Id ? "picked" : null)"
                            aria-pressed="@(recipeId == recipe.Id ? "true" : "false")"
                            @onclick="() => recipeId = recipe.Id">@recipe.Name</button>
                }
                <button type="button" class="chip new @(recipeId is null ? "picked" : null)"
                        aria-pressed="@(recipeId is null ? "true" : "false")"
                        @onclick="() => recipeId = null">Something else</button>
            </div>
            @if (Picked is { } picked)
            {
                @if (picked.Ingredients.Count > 0)
                {
                    <div class="form-text">@string.Join(" · ", picked.Ingredients)</div>
                }
                @if (!string.IsNullOrWhiteSpace(picked.Method))
                {
                    <div class="form-text treatment-method">@picked.Method</div>
                }
            }
        </div>
    }

    <div class="row g-2">
        @if (!Check && recipeId is null)
        {
            <div class="col-7">
                <label class="form-label" for="treatment-what">What you used</label>
                <input type="text" id="treatment-what" class="form-control form-control-sm"
                       placeholder="e.g. Alcohol spray, both sides" @bind="what" @bind:event="oninput" />
            </div>
        }
        <div class="col-5">
            <label class="form-label" for="treatment-date">When</label>
            <input type="date" id="treatment-date" class="form-control form-control-sm"
                   max="@Today.ToString("yyyy-MM-dd")" value="@occurredOn.ToString("yyyy-MM-dd")"
                   @onchange="DateChanged" />
        </div>
    </div>

    @if (!Check)
    {
        <div class="mt-2">
            <label class="form-label" for="treatment-next">Next one due</label>
            <input type="date" id="treatment-next" class="form-control form-control-sm"
                   min="@occurredOn.ToString("yyyy-MM-dd")" value="@nextDue.ToString("yyyy-MM-dd")"
                   @onchange="NextDueChanged" />
            <div class="form-text">Every @Labels.Count(Case.IntervalDays, "day") by default. Change it to leave a longer gap.</div>
        </div>
    }

    @if (!Check && loaded && recipes.Count == 0)
    {
        <div class="form-text">
            Make up the same spray each time? Save it under <a href="treatment-recipes">Treatment recipes</a>
            and pick it here.
        </div>
    }

    <div class="mt-2">
        <label class="form-label" for="treatment-notes">Notes</label>
        <input type="text" id="treatment-notes" class="form-control form-control-sm"
               placeholder="@(Check ? "e.g. Nothing under the leaves" : "e.g. Still webbing under the new leaf")"
               @bind="notes" @bind:event="oninput" />
    </div>

    <div class="care-actions">
        <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick="LogAsync">@(Check ? "Log check" : "Log treatment")</button>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="OnCancel">Cancel</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required PestCase Case { get; set; }

    /// <summary>The treatments so far, so the last recipe can be offered again.</summary>
    [Parameter]
    public IReadOnlyList<PestTreatment> Existing { get; set; } = [];

    /// <summary>Called after a treatment is saved, so the page can reload what it shows.</summary>
    [Parameter]
    public EventCallback OnLogged { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Log a check on a case being watched instead of a treatment.</summary>
    [Parameter]
    public bool Check { get; set; }

    private string? what;
    private Guid? recipeId;
    private IReadOnlyList<TreatmentRecipe> recipes = [];
    private bool loaded;
    private string? notes;
    private DateOnly occurredOn;
    private DateOnly nextDue;
    private string? error;
    private bool busy;

    private DateOnly Today => Time.Today();

    private TreatmentRecipe? Picked => recipes.FirstOrDefault(r => r.Id == recipeId);

    protected override async Task OnInitializedAsync()
    {
        Reset();
        recipes = (await Recipes.GetAllAsync())
            .OrderBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        loaded = true;
        // Again now the recipes are here, so the last one used can be offered
        Reset();
    }

    private void Reset()
    {
        var draft = PestService.StartTreatment(Case, Existing, Today, recipes);
        recipeId = draft.RecipeId;
        what = draft.RecipeId is null ? draft.What : null;
        notes = null;
        occurredOn = draft.OccurredOn;
        nextDue = Default(occurredOn);
    }

    private DateOnly Default(DateOnly on) => on.AddDays(Case.IntervalDays);

    // Moving the treatment moves the default gap with it, unless a date was picked by hand
    private void DateChanged(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), out var picked))
            return;

        var followed = nextDue == Default(occurredOn);
        occurredOn = picked;
        if (followed)
            nextDue = Default(picked);
    }

    private void NextDueChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var picked))
            nextDue = picked;
    }

    private async Task LogAsync()
    {
        busy = true;
        error = null;
        try
        {
            var entry = Check ? PestService.StartCheck(Case, occurredOn) : new PestTreatment
            {
                CaseId = Case.Id,
                OccurredOn = occurredOn,
                What = Clean(what),
                // Only a date that isn't the plain interval is worth storing, so changing the
                // interval later still moves the cases that never had a gap set by hand
                NextDueOn = nextDue == Default(occurredOn) ? null : nextDue
            };
            if (!Check && Picked is { } recipe)
                entry.Use(recipe);
            entry.Notes = Clean(notes);
            await Repository.SaveAsync(entry);

            Reset();
            await OnLogged.InvokeAsync();
        }
        catch (Exception ex)
        {
            error = $"Couldn't log that: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
