@* Counting a sticky trap on a pest case. The count is everything on the trap, which is easier
   than telling old from new, and the case works out what's new since last time. A new trap
   can be put up after counting, or on its own with the count left empty. *@
@inject IPestTreatmentRepository Repository
@inject ILogger<TrapCountSheet> Logger
@inject TimeProvider Time

<div class="care-sheet">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    <div class="row g-2">
        <div class="col-7">
            <label class="form-label" for="trap-count">@Strings.Pests.TrapCountOnTrap</label>
            <input type="number" id="trap-count" class="form-control form-control-sm" min="0" inputmode="numeric"
                   placeholder="@Strings.Pests.TrapCountPlaceholder" @bind="onTrap" @bind:event="oninput" />
        </div>
        <div class="col-5">
            <label class="form-label" for="trap-date">@Strings.Pests.TrapCountWhen</label>
            <input type="date" id="trap-date" class="form-control form-control-sm"
                   max="@Today.ToString("yyyy-MM-dd")" @bind="occurredOn" />
        </div>
    </div>
    <div class="form-text">@Strings.Pests.TrapCountHint</div>

    <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" id="trap-new" @bind="newTrap" />
        <label class="form-check-label" for="trap-new">
            @(onTrap is null ? Strings.Pests.TrapCountNewTrap : Strings.Pests.TrapCountNewTrapAfter)
        </label>
    </div>

    <div class="mt-2">
        <label class="form-label" for="trap-notes">@Strings.Pests.TrapCountNotes</label>
        <input type="text" id="trap-notes" class="form-control form-control-sm"
               placeholder="@Strings.Pests.TrapCountNotesPlaceholder" @bind="notes" @bind:event="oninput" />
    </div>

    <div class="care-actions">
        <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick="LogAsync">
            @(onTrap is null && newTrap ? Strings.Pests.TrapCountLogNew : Strings.Pests.TrapCountLogCount)
        </button>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="OnCancel">@Strings.Common.Cancel</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required PestCase Case { get; set; }

    /// <summary>Called after the count is saved, so the page can reload what it shows.</summary>
    [Parameter]
    public EventCallback OnLogged { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private int? onTrap;
    private bool newTrap;
    private string? notes;
    private DateOnly occurredOn;
    private string? error;
    private bool busy;

    private DateOnly Today => Time.Today();

    protected override void OnInitialized() => occurredOn = Today;

    private async Task LogAsync()
    {
        busy = true;
        error = null;
        try
        {
            var entry = PestService.StartTrapCount(Case, occurredOn);
            entry.OnTrap = onTrap;
            entry.NewTrap = newTrap;
            entry.Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim();

            if (entry.Validate(Today) is [var first, ..])
            {
                error = first;
                return;
            }

            await Repository.SaveAsync(entry);
            await OnLogged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the trap count failed");
            error = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.TrapCountFailed, ex.Message);
        }
        finally
        {
            busy = false;
        }
    }
}
