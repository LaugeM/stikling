@* One row in a propagation list: "3× corm · LECA · day 24". In select mode the card is a checkbox instead of a link. *@
@inject TimeProvider Time
@inject PlantNameService Names

@if (Selectable)
{
    <label class="item-card selectable @(Selected ? "selected" : null)">
        <input type="checkbox" class="form-check-input plant-check" checked="@Selected" @onchange="() => OnToggle.InvokeAsync(Propagation)" />
        @Content
    </label>
}
else
{
    <a class="item-card" href="propagations/@Propagation.Id">
        @Content
    </a>
}

@code {
    private EverydayNameBook? everyday;

    protected override async Task OnInitializedAsync() => everyday = await Names.GetEverydayNamesAsync();

    [Parameter, EditorRequired]
    public required Propagation Propagation { get; set; }

    /// <summary>Shown as "from Big alocasia" when set.</summary>
    [Parameter]
    public string? ParentName { get; set; }

    /// <summary>
    /// How it's doing against earlier batches. Only a slow one says so on the card, since
    /// "on time" on every card would be noise.
    /// </summary>
    [Parameter]
    public RootingPace? Pace { get; set; }

    /// <summary>Show the stage as a badge (lists that aren't already grouped by stage).</summary>
    [Parameter]
    public bool ShowStage { get; set; }

    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<Propagation> OnToggle { get; set; }

    private DateOnly Today => Time.Today();

    private RenderFragment Content => @<text>
    <PropagationThumb Propagation="Propagation" Days="@(Propagation.IsActive ? Propagation.DaysSinceStart(Today) : null)" />

    <div class="item-text">
        <div class="item-name"><NumberTag Code="@Propagation.CollectionNumber" />@Propagation.DisplayName</div>
        @if (ParentName is not null)
        {
            <div class="item-sub">from @ParentName</div>
        }
        else if (!string.IsNullOrWhiteSpace(Propagation.Nickname) && Propagation.BotanicalName is { } botanical)
        {
            <div class="item-sub">@botanical</div>
        }
        else if (everyday?.For(Propagation.Genus, Propagation.Species, Propagation.Cultivar) is { } called)
        {
            <div class="item-sub everyday-name">@called</div>
        }
        <div class="item-meta">
            @if (Propagation.IsActive)
            {
                @if (ShowStage)
                {
                    <StageBadge Stage="Propagation.Stage" Type="Propagation.Type" />
                }
                @if (Propagation.IsDormant)
                {
                    <span class="badge dormant-badge">Dormant</span>
                }
                @if (Propagation.SpareAvailable > 0)
                {
                    <span class="badge swap-badge">@Propagation.SpareAvailable to swap</span>
                }
                <span>@Labels.Summary(Propagation)</span>
                @if (Propagation.DaysToRoot is { } days)
                {
                    <span class="rooted-in">· rooted in @Labels.Count(days, "day")</span>
                }
                @if (Propagation.RemainingCount != Propagation.InitialCount)
                {
                    <span>· @Propagation.RemainingCount left</span>
                }
                @if (Pace is { IsSlow: true })
                {
                    <span class="pace-slow">· slower than usual</span>
                }
            }
            else
            {
                <span class="badge @(Propagation.Stage == PropagationStage.Failed ? "text-bg-secondary" : "stage-badge")">@Labels.Stage(Propagation.Stage)</span>
                <span>@Labels.Summary(Propagation) · @PropagationService.Outcome(Propagation)</span>
                @if (Propagation.DaysToRoot is { } days)
                {
                    <span class="rooted-in">· rooted in @Labels.Count(days, "day")</span>
                }
            }
        </div>
    </div>
    </text>;
}
