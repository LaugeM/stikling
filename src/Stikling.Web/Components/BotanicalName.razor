@* A botanical name set the usual way: genus and species in italics, the cultivar upright in single quotes *@
@if (Latin is { } latin)
{
    <i>@latin</i>
}
@if (PlantNames.Cultivar(Cultivar) is { } cultivar)
{
    @(Latin is null ? null : " ")<span class="cultivar">'@cultivar'</span>
}
@if (PlantNames.Note(Note) is { } note)
{
    @(Latin is null && PlantNames.Cultivar(Cultivar) is null ? null : " ")<span>@note</span>
}

@code {
    [Parameter]
    public string? Genus { get; set; }

    [Parameter]
    public string? Species { get; set; }

    [Parameter]
    public string? Cultivar { get; set; }

    /// <summary>How sure the name is, so "cf." and "sp." are set in with the Latin part.</summary>
    [Parameter]
    public NameQualifier? Qualifier { get; set; }

    /// <summary>The locality or collector code, set upright last.</summary>
    [Parameter]
    public string? Note { get; set; }

    private string? Latin => PlantNames.Botanical(Genus, Species, null, Qualifier, null);
}
