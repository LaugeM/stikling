@* A whole-row link with a name and a line under it, used by Settings and Supplies. *@

<a class="item-card settings-row" href="@Href">
    @if (Icon is not null)
    {
        <span class="settings-row-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">@Icon</svg>
        </span>
    }
    <span class="item-text">
        <span class="item-name">@Title</span>
        <span class="settings-row-detail @(Alert ? "alert" : null)">@(ChildContent is null ? Detail : ChildContent)</span>
    </span>
    <svg class="settings-row-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The line under the name, when plain text is enough.</summary>
    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The SVG paths of a stroked icon, drawn on a leaf-tinted tile.</summary>
    [Parameter]
    public RenderFragment? Icon { get; set; }

    /// <summary>Colours the line under the name as a problem.</summary>
    [Parameter]
    public bool Alert { get; set; }
}
