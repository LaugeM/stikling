@* The tile at the start of a propagation row. While it's going the tile shows how many days
   it has been: the number fills the tile when there's no photo, and sits in a corner of the
   photo when there is one. A finished propagation shows its photo or the glass icon. *@

@inject CoverPhotos Covers

@if (Covers.Shown(Propagation.CoverPhotoId) is { } coverId)
{
    <div class="item-thumb">
        <PhotoImage PhotoId="coverId" />
        @if (Days is { } days)
        {
            <span class="thumb-days" title="@DaysText(days)"><span aria-hidden="true">@(days)d</span><span class="visually-hidden">@DaysText(days)</span></span>
        }
    </div>
}
else if (Days is { } days)
{
    <div class="item-thumb day-thumb">
        <b>@days</b>
        <small>@Plural.Of(days, Strings.Propagations.ThumbDay_One, Strings.Propagations.ThumbDay_Other)</small>
    </div>
}
else
{
    <div class="item-thumb" aria-hidden="true">
        <svg viewBox="0 0 24 24">@Icons.Feed</svg>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required Propagation Propagation { get; set; }

    /// <summary>Days since it started, or null for a finished propagation.</summary>
    [Parameter]
    public int? Days { get; set; }

    private static string DaysText(int days) => Plural.Of(days, Strings.Propagations.Days_One, Strings.Propagations.Days_Other);
}
