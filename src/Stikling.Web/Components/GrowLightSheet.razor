@* A Sheet to add a grow light or change or remove one: its name, the room or spot it lights, the watts, the hours
   a day and a note. Adding, removing and moving a light writes a line on the plants and propagations it starts or
   stops lighting (see GrowLightService). *@
@using System.Globalization
@inject GrowLightService Lights
@inject RoomService Rooms
@inject ILogger<GrowLightSheet> Logger

<Sheet Title="@(Light is null ? LightStrings.LampSheetAdd : LightStrings.LampSheetEdit)" Open="Open" OpenChanged="OpenChanged">
    <div class="lamp-sheet">
        @if (error is not null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3" role="alert">@error</div>
        }

        <div class="mb-3">
            <label class="form-label" for="@nameId">@LightStrings.LampName</label>
            <input id="@nameId" type="text" class="form-control" maxlength="60" @bind="name" @bind:event="oninput" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="@placeId">@LightStrings.LampLights</label>
            <select id="@placeId" class="form-select" @bind="placeText">
                @foreach (var (id, text) in choices)
                {
                    <option value="@id">@text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label" for="@wattsId">@LightStrings.LampWattsLabel</label>
            <div class="input-group">
                <input id="@wattsId" type="number" step="1" min="1" max="@GrowLight.MaxWatts" inputmode="numeric" class="form-control"
                       @bind="wattsText" @bind:event="oninput" />
                <span class="input-group-text">W</span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="@hoursId">@LightStrings.LampHoursLabel</label>
            <input id="@hoursId" type="number" step="0.5" min="0" max="24" inputmode="decimal" class="form-control"
                   @bind="hoursText" @bind:event="oninput" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="@noteId">@LightStrings.LampNote</label>
            <textarea id="@noteId" class="form-control" rows="2" @bind="note" @bind:event="oninput"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(name))" @onclick="SaveAsync">@Strings.Common.Save</button>
            @if (Light is not null)
            {
                <button type="button" class="btn btn-link text-danger ms-auto" disabled="@busy" @onclick="RemoveAsync">@LightStrings.LampRemove</button>
            }
        </div>
    </div>
</Sheet>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The light being changed. Without it a new one is added.</summary>
    [Parameter]
    public GrowLight? Light { get; set; }

    /// <summary>The room or spot a new light starts on.</summary>
    [Parameter]
    public Guid? StartPlaceId { get; set; }

    /// <summary>Raised after a light was saved or removed, so the page can close the Sheet and show it.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private readonly string nameId = $"lamp-name-{Guid.NewGuid():N}";
    private readonly string placeId = $"lamp-place-{Guid.NewGuid():N}";
    private readonly string wattsId = $"lamp-watts-{Guid.NewGuid():N}";
    private readonly string hoursId = $"lamp-hours-{Guid.NewGuid():N}";
    private readonly string noteId = $"lamp-note-{Guid.NewGuid():N}";

    private string name = "";
    private string placeText = "";
    private string? wattsText;
    private string? hoursText;
    private string? note;
    private List<(Guid Id, string Text)> choices = [];
    private string? error;
    private bool busy;
    private bool wasOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen)
        {
            error = null;
            busy = false;
            var places = await Rooms.GetPlacesAsync();
            choices = [];
            foreach (var room in places.Rooms.OrderBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase))
            {
                choices.Add((room.Id, room.Name));
                foreach (var spot in places.SpotsIn(room.Id).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase))
                    choices.Add((spot.Id, places.NameOf(spot.Id) ?? spot.Name));
            }

            if (Light is { } light)
            {
                name = light.Name;
                placeText = (places.Find(light.PlaceId)?.Id ?? light.PlaceId)?.ToString() ?? "";
                wattsText = light.Watts?.ToString(CultureInfo.InvariantCulture);
                hoursText = light.HoursPerDay?.ToString("0.#", CultureInfo.InvariantCulture);
                note = light.Notes;
            }
            else
            {
                name = LightStrings.LampDefaultName;
                placeText = (places.Find(StartPlaceId)?.Id ?? StartPlaceId)?.ToString() ?? "";
                wattsText = hoursText = note = null;
            }
        }
        wasOpen = Open;
    }

    private static decimal? Number(string? text) =>
        decimal.TryParse(text?.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) ? value : null;

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            var light = Light is null ? new GrowLight() : new GrowLight { Id = Light.Id, CreatedAt = Light.CreatedAt, UpdatedAt = Light.UpdatedAt, DeletedAt = Light.DeletedAt };
            light.Name = name;
            light.PlaceId = Guid.TryParse(placeText, out var place) ? place : null;
            light.Watts = Number(wattsText) is { } watts ? (int)Math.Round(Math.Clamp(watts, -1m, 100000m), MidpointRounding.AwayFromZero) : null;
            light.HoursPerDay = Number(hoursText);
            light.Notes = note;
            await Lights.SaveAsync(light);
            await OnSaved.InvokeAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving a grow light failed");
            error = F(LightStrings.LampSaveError, ex.Message);
        }
        busy = false;
    }

    private async Task RemoveAsync()
    {
        if (Light is not { } light)
            return;

        busy = true;
        try
        {
            await Lights.DeleteAsync(light.Id);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a grow light failed");
            error = F(LightStrings.LampSaveError, ex.Message);
        }
        busy = false;
    }
}
