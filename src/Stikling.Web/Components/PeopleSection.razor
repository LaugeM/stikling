@using System.Net
@using Stikling.Core.People
@inject CollectionsService Collections
@inject StiklingApi Api
@inject BackupService Backup
@inject ShareCardService Cards
@inject NavigationManager Nav
@implements IDisposable
@* The inside of the People section on the Account page: the collections on this device, who is in the open
   one, inviting, handing over and leaving. The heading is on the page. Everything is fetched when the section
   loads and after each action, and again when a sync brings in changes. *@

<ReloadOnSync Reload="() => LoadAsync(refresh: false)" />

@if (!loaded)
{
    <p class="settings-hint" role="status">@Strings.Account.Loading</p>
}
else
{
    @if (loadProblem is not null)
    {
        <p class="settings-message" role="alert">@loadProblem</p>
    }

    @if (registry is not null && (registry.Collections.Count > 1 || Collections.IsSharedOpen))
    {
        <h3 class="h6 mt-3">@Strings.People.OnDeviceTitle</h3>
        @foreach (var collection in registry.Collections)
        {
            var isOpen = collection.Id == openId;
            <div class="room-row">
                <span class="room-name">@collection.Name</span>
                @if (isOpen)
                {
                    <span class="settings-hint ms-auto my-0">@Strings.People.OpenNow</span>
                }
                else
                {
                    <button type="button" class="btn btn-link btn-sm link-action ms-auto" disabled="@busy"
                            @onclick="() => Collections.SwitchToAsync(collection.Id)">@Strings.People.Open</button>
                }
            </div>
            <p class="settings-hint mt-0">@CollectionHint(collection)</p>
        }
    }

    @if (current is { Gone: true } gone)
    {
        <p class="settings-hint">@Strings.People.GoneText</p>
        <div class="settings-actions">
            <button type="button" class="btn btn-outline-primary" disabled="@busy"
                    @onclick="SaveBackupAsync">@Strings.People.SaveBackup</button>
            <button type="button" class="btn btn-outline-primary" disabled="@busy"
                    @onclick="() => removingFromDevice = true">@Strings.People.RemoveFromDevice</button>
        </div>
        @if (backupMessage is not null)
        {
            <p class="settings-message" role="status">@backupMessage</p>
        }
        @if (removingFromDevice)
        {
            <div class="confirm-card confirm-card-danger">
                <p>@F(Strings.People.RemoveFromDeviceExplain, gone.Name)</p>
                <div class="settings-actions">
                    <button type="button" class="btn btn-danger" disabled="@busy"
                            @onclick="() => RemoveFromDeviceAsync(gone.Id)">@Strings.Common.Remove</button>
                    <button type="button" class="btn btn-link" disabled="@busy"
                            @onclick="() => removingFromDevice = false">@Strings.Common.Cancel</button>
                </div>
            </div>
        }
    }
    else if (registry is not null && current is { } here)
    {
        @* The open collection's name *@
        @if (renaming)
        {
            <div class="mt-3">
                <RoomRenameRow Name="@here.Name" Label="@Strings.People.CollectionName" Busy="busy"
                               OnSave="RenameAsync" OnCancel="@(() => renaming = false)" />
            </div>
        }
        else
        {
            <div class="room-row mt-3">
                <span class="room-name">@here.Name</span>
                @if (access.CanEdit)
                {
                    <button type="button" class="btn btn-link btn-sm link-action ms-auto" disabled="@busy"
                            @onclick="() => renaming = true">@Strings.People.Rename</button>
                }
            </div>
        }

        @if (details is { } found)
        {
            <h3 class="h6 mt-3">@Strings.People.MembersTitle</h3>
            <ul class="room-list people-members">
                @foreach (var member in found.Members)
                {
                    var target = new MemberAccess(member.PersonId, member.RoleKind, member.ManagesPeople, member.IsOwner);
                    var choice = RoleChoice.Of(member.RoleKind, member.ManagesPeople);
                    var name = string.IsNullOrWhiteSpace(member.Name) ? Strings.People.NoNameYet : member.Name!;
                    var options = RoleChoice.ForChange(access, target);
                    <li>
                        <div class="room-row">
                            <span class="room-name">@name</span>
                            @if (member.PersonId == registry.PersonId)
                            {
                                <span class="settings-hint my-0">@Strings.People.You</span>
                            }
                            @if (access.CanRemove(target))
                            {
                                <button type="button" class="btn btn-link btn-sm link-action ms-auto" disabled="@busy"
                                        @onclick="() => removingMember = member.PersonId">@Strings.Common.Remove</button>
                            }
                        </div>
                        <p class="settings-hint mt-0">
                            @(member.IsOwner ? F(Strings.People.MemberOwner, RoleText.Label(choice)) : RoleText.Label(choice))
                        </p>
                        @if (options.Count > 0)
                        {
                            <div class="member-role">
                                <select class="form-select form-select-sm" aria-label="@F(Strings.People.ChangeRoleFor, name)"
                                        disabled="@busy" @onchange="e => ChangeRoleAsync(member, e.Value?.ToString())">
                                    @foreach (var option in options)
                                    {
                                        <option value="@IndexOf(option)" selected="@(option == choice)">@RoleText.Label(option)</option>
                                    }
                                </select>
                                @if (savingRole == member.PersonId)
                                {
                                    <span class="settings-hint my-0" role="status">@Strings.People.Saving</span>
                                }
                            </div>
                        }
                        @if (removingMember == member.PersonId)
                        {
                            <div class="confirm-card confirm-card-danger">
                                <p>@F(Strings.People.RemoveMemberExplain, name)</p>
                                <div class="settings-actions">
                                    <button type="button" class="btn btn-danger" disabled="@busy"
                                            @onclick="() => RemoveMemberAsync(member)">@Strings.Common.Remove</button>
                                    <button type="button" class="btn btn-link" disabled="@busy"
                                            @onclick="() => removingMember = null">@Strings.Common.Cancel</button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>

            @if (access.CanManage)
            {
                @if (showNameDialog && inviteAfterName)
                {
                    <NameDialog Name="@registry.PersonName" OnSaved="NameSavedAsync" OnCancel="CancelNameDialog" />
                }
                else if (inviteStep == InviteStep.None)
                {
                    <div class="settings-actions">
                        <button type="button" class="btn btn-outline-primary" disabled="@busy"
                                @onclick="StartInvite">@Strings.People.InviteSomeone</button>
                    </div>
                }
                else if (inviteStep == InviteStep.Choosing)
                {
                    <div class="confirm-card">
                        <fieldset>
                            <legend class="h6">@Strings.People.InviteChoose</legend>
                            @foreach (var option in RoleChoice.ForInvite(access))
                            {
                                var id = $"invite-role-{IndexOf(option)}";
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="invite-role" id="@id"
                                           checked="@(option == inviteChoice)" @onchange="() => inviteChoice = option" />
                                    <label class="form-check-label" for="@id">@RoleText.Label(option)</label>
                                </div>
                            }
                        </fieldset>
                        <div class="settings-actions">
                            <button type="button" class="btn btn-primary" disabled="@busy"
                                    @onclick="MakeInviteAsync">@Strings.People.MakeLink</button>
                            <button type="button" class="btn btn-link" disabled="@busy"
                                    @onclick="() => inviteStep = InviteStep.None">@Strings.Common.Cancel</button>
                        </div>
                    </div>
                }
                else if (made is { } invite && link is not null)
                {
                    <div class="confirm-card">
                        <label class="form-label" for="invite-link">@Strings.People.InviteLinkLabel</label>
                        <input id="invite-link" class="form-control invite-link" readonly value="@link" onfocus="this.select()"
                               autocomplete="off" autocapitalize="off" spellcheck="false" />
                        <p class="settings-hint">@F(Strings.People.InviteLinkHint, RoleText.Verb(invite.Choice), PeopleLimits.InviteDays)</p>
                        <div class="settings-actions">
                            @if (canShare)
                            {
                                <button type="button" class="btn btn-primary" @onclick="ShareAsync">@Strings.People.Share</button>
                            }
                            <button type="button" class="btn @(canShare ? "btn-outline-primary" : "btn-primary")" @onclick="CopyAsync">
                                @(copied ? Strings.People.Copied : Strings.People.Copy)
                            </button>
                            <button type="button" class="btn btn-outline-primary" aria-expanded="@showQr"
                                    @onclick="() => showQr = !showQr">@(showQr ? Strings.People.HideQr : Strings.People.ShowQr)</button>
                            <button type="button" class="btn btn-link" @onclick="CloseInvite">@Strings.Common.Done</button>
                        </div>
                        @if (showQr)
                        {
                            <svg class="invite-qr" viewBox="0 0 @(qrSize + 8) @(qrSize + 8)" role="img"
                                 aria-label="@Strings.People.QrDescription" shape-rendering="crispEdges">
                                <rect width="@(qrSize + 8)" height="@(qrSize + 8)" fill="#fff" />
                                <path d="@qrPath" transform="translate(4 4)" fill="#000" />
                            </svg>
                        }
                    </div>
                }

                @if (invites.Where(i => i.Id != made?.Id).ToList() is { Count: > 0 } open)
                {
                    <h3 class="h6 mt-3">@Strings.People.OpenInvites</h3>
                    <ul class="room-list">
                        @foreach (var invite in open)
                        {
                            <li>
                                <div class="room-row">
                                    <span class="room-name">@RoleText.Label(invite.Choice)</span>
                                    <button type="button" class="btn btn-link btn-sm link-action ms-auto" disabled="@busy"
                                            @onclick="() => WithdrawAsync(invite)">@Strings.People.Withdraw</button>
                                </div>
                                <p class="settings-hint mt-0">@F(Strings.People.InviteRunsOut, Labels.Date(DateOnly.FromDateTime(invite.ExpiresAt.ToLocalTime().DateTime)))</p>
                            </li>
                        }
                    </ul>
                }
            }

            @if (access.CanHandOver && OtherMembers.Count > 0)
            {
                @if (handingOver)
                {
                    <div class="confirm-card">
                        <p><strong>@Strings.People.HandOverTitle</strong></p>
                        <p class="settings-hint">@Strings.People.HandOverHint</p>
                        <label class="form-label" for="hand-over-to">@Strings.People.HandOverChoose</label>
                        <select id="hand-over-to" class="form-select" disabled="@busy"
                                @onchange="e => handOverTo = Guid.TryParse(e.Value?.ToString(), out var picked) ? picked : null">
                            <option value="" selected="@(handOverTo is null)"></option>
                            @foreach (var member in OtherMembers)
                            {
                                <option value="@member.PersonId" selected="@(handOverTo == member.PersonId)">@MemberName(member)</option>
                            }
                        </select>
                        @if (OtherMembers.FirstOrDefault(m => m.PersonId == handOverTo) is { } next)
                        {
                            <p class="mt-2">@F(Strings.People.HandOverConfirm, MemberName(next))</p>
                        }
                        <div class="settings-actions">
                            <button type="button" class="btn btn-danger" disabled="@(busy || handOverTo is null)"
                                    @onclick="HandOverAsync">@Strings.People.HandOverButton</button>
                            <button type="button" class="btn btn-link" disabled="@busy"
                                    @onclick="() => handingOver = false">@Strings.Common.Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="settings-actions">
                        <button type="button" class="btn btn-outline-primary" disabled="@busy"
                                @onclick="() => handingOver = true">@Strings.People.HandOverTitle</button>
                    </div>
                }
            }
        }

        @if (access.CanLeave && Collections.IsSharedOpen)
        {
            @if (leaving)
            {
                <div class="confirm-card confirm-card-danger">
                    <p>@F(Strings.People.LeaveConfirm, here.Name)</p>
                    <div class="settings-actions">
                        <button type="button" class="btn btn-outline-primary" disabled="@busy"
                                @onclick="SaveBackupAsync">@Strings.People.LeaveSaveFirst</button>
                    </div>
                    @if (backupMessage is not null)
                    {
                        <p class="settings-message" role="status">@backupMessage</p>
                    }
                    <div class="settings-actions">
                        <button type="button" class="btn btn-danger" disabled="@busy"
                                @onclick="LeaveAsync">@Strings.People.Leave</button>
                        <button type="button" class="btn btn-link" disabled="@busy"
                                @onclick="() => leaving = false">@Strings.Common.Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <div class="settings-actions">
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy"
                            @onclick="StartLeave">@Strings.People.LeaveButton</button>
                </div>
            }
        }
        else if (access.IsOwner && Collections.IsSharedOpen)
        {
            <p class="settings-hint">@Strings.People.OwnerCantLeave</p>
        }

        @* Your name *@
        @if (showNameDialog && !inviteAfterName)
        {
            <NameDialog Name="@registry.PersonName" OnSaved="NameSavedAsync" OnCancel="CancelNameDialog" />
        }
        else
        {
            <div class="room-row mt-3">
                <span>@(string.IsNullOrWhiteSpace(registry.PersonName) ? Strings.People.YourNameNone : F(Strings.People.YourName, registry.PersonName))</span>
                <button type="button" class="btn btn-link btn-sm link-action ms-auto" disabled="@busy"
                        @onclick="OpenNameDialog">@(string.IsNullOrWhiteSpace(registry.PersonName) ? Strings.People.SetName : Strings.People.ChangeName)</button>
            </div>
            <p class="settings-hint mt-0">@Strings.People.YourNameHint</p>
        }
    }

    @if (message is not null)
    {
        <p class="settings-message" role="alert">@message</p>
    }
}

@code {
    private enum InviteStep { None, Choosing, Made }

    private bool loaded;
    private bool disposed;
    private bool busy;
    private string? loadProblem;
    private string? message;
    private string? backupMessage;

    private CollectionRegistry? registry;
    private RegisteredCollection? current;
    private Guid? openId;
    private MemberAccess access = MemberAccess.Full(Guid.Empty);
    private CollectionDetails? details;
    private List<InviteInfo> invites = [];

    private bool renaming;
    private Guid? removingMember;
    private Guid? savingRole;
    private bool removingFromDevice;
    private bool leaving;
    private bool handingOver;
    private Guid? handOverTo;

    private bool showNameDialog;
    private bool inviteAfterName;
    private InviteStep inviteStep = InviteStep.None;
    private RoleChoice inviteChoice = RoleChoice.CanView;
    private InviteInfo? made;
    private string? link;
    private bool canShare;
    private bool copied;
    private bool showQr;
    private int qrSize;
    private string qrPath = "";

    private IReadOnlyList<CollectionMember> OtherMembers =>
        details is null || registry is null ? [] : [.. details.Members.Where(m => m.PersonId != registry.PersonId)];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(refresh: true);
        try
        {
            canShare = await Cards.CanShareLinkAsync();
        }
        catch (JSException)
        {
            canShare = false;
        }
    }

    private static int IndexOf(RoleChoice choice)
    {
        for (var i = 0; i < RoleChoice.All.Count; i++)
        {
            if (RoleChoice.All[i] == choice)
                return i;
        }
        return -1;
    }

    private static string MemberName(CollectionMember member) =>
        string.IsNullOrWhiteSpace(member.Name) ? Strings.People.NoNameYet : member.Name!;

    private string CollectionHint(RegisteredCollection collection)
    {
        if (collection.Gone)
            return Strings.People.CollectionGone;
        if (collection.IsOwner)
            return Strings.People.CollectionYours;

        var verb = RoleText.Verb(collection.Role, collection.ManagesPeople);
        return string.IsNullOrWhiteSpace(collection.OwnerName)
            ? F(Strings.People.CollectionSharedNoOwner, verb)
            : F(Strings.People.CollectionShared, collection.OwnerName, verb);
    }

    /// <summary>Reads the list of collections and the open one's people. With <paramref name="refresh"/> the server is asked who the person is first.</summary>
    private async Task LoadAsync(bool refresh)
    {
        if (disposed)
            return;

        loadProblem = null;
        if (refresh)
        {
            try
            {
                await Collections.RefreshAsync();
            }
            catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.Unauthorized)
            {
                loadProblem = Strings.Account.ShareSignInRanOut;
            }
            catch (Exception e) when (e is HttpRequestException or AccountUnavailableException or JSException or TaskCanceledException)
            {
                loadProblem = Strings.Account.ShareUnreachable;
            }
        }

        registry = await Collections.GetRegistryAsync();
        current = Collections.Current;
        openId = current?.Id;
        access = await Collections.GetAccessAsync();
        details = null;
        invites = [];

        if (registry is not null && current is { Gone: false } here && loadProblem is null)
        {
            try
            {
                details = await Api.GetCollectionAsync(here.Id);
                if (access.CanManage)
                {
                    var listed = await Api.GetInvitesAsync(here.Id);
                    if (listed.Ok)
                        invites = listed.Value!;
                }
            }
            catch (HttpRequestException e) when (e.StatusCode == HttpStatusCode.Forbidden)
            {
                loadProblem = Strings.People.NotAllowed;
            }
            catch (Exception e) when (e is HttpRequestException or AccountUnavailableException or JSException or TaskCanceledException)
            {
                loadProblem = Strings.Account.ShareUnreachable;
            }
        }

        loaded = true;
        StateHasChanged();
    }

    /// <summary>Runs a call, and says in plain words why it failed. After a success, or a failure that may mean the person's place changed, it reads everything again.</summary>
    private async Task<bool> RunAsync<T>(Func<Task<PeopleOutcome<T>>> call, int nameMax = PeopleLimits.MaxPersonNameLength)
    {
        busy = true;
        message = null;
        try
        {
            var result = await call();
            if (!result.Ok)
            {
                message = PeopleText.Problem(result.Failure!.Value, result.Field, nameMax);
                if (result.Failure is PeopleFailure.Forbidden or PeopleFailure.NotFound)
                    await LoadAsync(refresh: true);
                return false;
            }

            await LoadAsync(refresh: true);
            return true;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RenameAsync(string name)
    {
        if (current is null)
            return;

        if (await RunAsync(() => Api.RenameCollectionAsync(current.Id, name), PeopleLimits.MaxCollectionNameLength))
            renaming = false;
    }

    private async Task ChangeRoleAsync(CollectionMember member, string? picked)
    {
        if (current is null || !int.TryParse(picked, out var index) || index < 0 || index >= RoleChoice.All.Count)
            return;

        var choice = RoleChoice.All[index];
        savingRole = member.PersonId;
        try
        {
            await RunAsync(() => Api.ChangeMemberAsync(current.Id, member.PersonId, choice.Role, choice.ManagesPeople));
        }
        finally
        {
            savingRole = null;
        }
    }

    private async Task RemoveMemberAsync(CollectionMember member)
    {
        if (current is null)
            return;

        if (await RunAsync(() => Api.RemoveMemberAsync(current.Id, member.PersonId)))
            removingMember = null;
    }

    // Inviting needs a name, since it is what the invited person sees. It is asked for first when there is none
    private void StartInvite()
    {
        message = null;
        if (string.IsNullOrWhiteSpace(registry?.PersonName))
        {
            inviteAfterName = true;
            showNameDialog = true;
            return;
        }

        BeginChoosing();
    }

    private void BeginChoosing()
    {
        var offered = RoleChoice.ForInvite(access);
        inviteChoice = offered.Count > 0 ? offered[0] : RoleChoice.CanView;
        inviteStep = InviteStep.Choosing;
    }

    private async Task MakeInviteAsync()
    {
        if (current is null)
            return;

        busy = true;
        message = null;
        try
        {
            var result = await Api.CreateInviteAsync(current.Id, inviteChoice.Role, inviteChoice.ManagesPeople);
            if (result is { Failure: PeopleFailure.Invalid, Field: "name" })
            {
                // The server has no name for the person, though the device thought it did
                inviteAfterName = true;
                showNameDialog = true;
                inviteStep = InviteStep.None;
                return;
            }

            if (!result.Ok)
            {
                message = PeopleText.Problem(result.Failure!.Value, result.Field);
                return;
            }

            made = result.Value;
            link = made!.Token is null ? null : $"{Nav.BaseUri}join/{made.Token}";
            if (link is null)
            {
                inviteStep = InviteStep.None;
                return;
            }

            copied = false;
            showQr = false;
            BuildQr(link);
            inviteStep = InviteStep.Made;
            var listed = await Api.GetInvitesAsync(current.Id);
            if (listed.Ok)
                invites = listed.Value!;
        }
        finally
        {
            busy = false;
        }
    }

    private void BuildQr(string text)
    {
        var rows = Stikling.Core.Labels.QrCode.Rows(text);
        qrSize = rows.Count;

        // One run of dark modules per piece of the path
        var path = new System.Text.StringBuilder();
        for (var y = 0; y < rows.Count; y++)
        {
            var x = 0;
            while (x < rows[y].Length)
            {
                if (rows[y][x] != '1')
                {
                    x++;
                    continue;
                }

                var start = x;
                while (x < rows[y].Length && rows[y][x] == '1')
                    x++;
                path.Append(System.Globalization.CultureInfo.InvariantCulture, $"M{start} {y}h{x - start}v1h-{x - start}z");
            }
        }
        qrPath = path.ToString();
    }

    private void CloseInvite()
    {
        inviteStep = InviteStep.None;
        made = null;
        link = null;
        showQr = false;
    }

    private async Task ShareAsync()
    {
        if (link is null || current is null)
            return;

        string outcome;
        try
        {
            outcome = await Cards.ShareLinkAsync(F(Strings.People.ShareTitle, current.Name), link);
        }
        catch (JSException)
        {
            outcome = "failed";
        }

        // The share menu failed, so the link is copied instead, which always works
        if (outcome == "failed")
            await CopyAsync();
    }

    private async Task CopyAsync()
    {
        if (link is null)
            return;

        try
        {
            copied = await Cards.CopyTextAsync(link);
        }
        catch (JSException)
        {
            copied = false;
        }

        if (!copied)
            return;

        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));
        if (disposed)
            return;

        copied = false;
        StateHasChanged();
    }

    private async Task WithdrawAsync(InviteInfo invite)
    {
        if (current is not null)
            await RunAsync(() => Api.WithdrawInviteAsync(current.Id, invite.Id));
    }

    private async Task HandOverAsync()
    {
        if (current is null || handOverTo is not { } next)
            return;

        if (await RunAsync(() => Api.HandOverAsync(current.Id, next)))
        {
            handingOver = false;
            handOverTo = null;
        }
    }

    private async Task SaveBackupAsync()
    {
        busy = true;
        backupMessage = null;
        try
        {
            await Backup.ExportAsync();
            backupMessage = Strings.People.BackupSaved;
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or IOException)
        {
            backupMessage = Strings.People.BackupFailed;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartLeave()
    {
        message = null;
        backupMessage = null;
        leaving = true;
    }

    private async Task LeaveAsync()
    {
        if (current is not { } here)
            return;

        busy = true;
        message = null;
        try
        {
            var result = await Api.LeaveAsync(here.Id);
            if (!result.Ok)
            {
                message = PeopleText.Problem(result.Failure!.Value, result.Field);
                if (result.Failure is PeopleFailure.Owner or PeopleFailure.Forbidden)
                    await LoadAsync(refresh: true);
                return;
            }

            // Takes the database off the device and opens the person's own collection, reloading the app
            leaving = false;
            await Collections.RemoveFromDeviceAsync(here.Id);
            await LoadAsync(refresh: true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveFromDeviceAsync(Guid id)
    {
        busy = true;
        try
        {
            await Collections.RemoveFromDeviceAsync(id);
            removingFromDevice = false;
            await LoadAsync(refresh: false);
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenNameDialog()
    {
        inviteAfterName = false;
        showNameDialog = true;
    }

    private void CancelNameDialog()
    {
        showNameDialog = false;
        inviteAfterName = false;
    }

    private async Task NameSavedAsync()
    {
        showNameDialog = false;
        await LoadAsync(refresh: false);
        if (inviteAfterName)
            BeginChoosing();
        inviteAfterName = false;
    }

    public void Dispose() => disposed = true;
}
