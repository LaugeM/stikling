@* A dose the way the bottle puts it: "5 ml per 4 L". Used for a product's usual dose, a feed's doses and the doses on a care entry,
   and for the amounts in a treatment recipe, where there's no product to take the unit from and it's picked here instead. *@

<div class="input-group dose-input @(Small ? "input-group-sm" : null)">
    <input type="number" id="@Id" class="form-control dose-amount" min="0" step="any" inputmode="decimal"
           placeholder="@Strings.Supplies.DosePlaceholder" aria-label="@Label" @bind="AmountValue" />
    @if (UnitChanged.HasDelegate)
    {
        <select class="form-select dose-unit" aria-label="@Strings.Supplies.DoseUnitLabel" @bind="UnitValue">
            @foreach (var unit in Enum.GetValues<DoseUnit>())
            {
                <option value="@unit">@Doses.Symbol(unit)</option>
            }
        </select>
        <span class="input-group-text">@Strings.Supplies.DosePer</span>
    }
    else
    {
        <span class="input-group-text">@Doses.Symbol(Unit) @Strings.Supplies.DosePer</span>
    }
    <input type="number" class="form-control dose-per" min="0" step="any" inputmode="decimal"
           aria-label="@PerLabel" @bind="PerValue" />
    <select class="form-select dose-per-unit" aria-label="@Strings.Supplies.LitresOrMillilitres" @bind="PerUnitValue">
        @foreach (var unit in Enum.GetValues<WaterUnit>())
        {
            <option value="@unit">@Doses.Symbol(unit)</option>
        }
    </select>
</div>

@code {
    /// <summary>The id of the amount box, for a label to point at.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>For a screen reader when there's no label pointing at <see cref="Id"/>.</summary>
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public decimal? Amount { get; set; }

    [Parameter]
    public EventCallback<decimal?> AmountChanged { get; set; }

    /// <summary>What the product is measured in. Picked on the product, so only shown here unless <see cref="UnitChanged"/> is bound.</summary>
    [Parameter]
    public DoseUnit Unit { get; set; }

    [Parameter]
    public EventCallback<DoseUnit> UnitChanged { get; set; }

    [Parameter]
    public decimal Per { get; set; } = 1;

    [Parameter]
    public EventCallback<decimal> PerChanged { get; set; }

    [Parameter]
    public WaterUnit PerUnit { get; set; }

    [Parameter]
    public EventCallback<WaterUnit> PerUnitChanged { get; set; }

    [Parameter]
    public bool Small { get; set; } = true;

    private string PerLabel => Label is null
        ? Strings.Supplies.DoseForWaterDefault
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.DoseForWater, Label.ToLowerInvariant());

    private decimal? AmountValue
    {
        get => Amount;
        set => AmountChanged.InvokeAsync(value);
    }

    private DoseUnit UnitValue
    {
        get => Unit;
        set => UnitChanged.InvokeAsync(value);
    }

    private decimal PerValue
    {
        get => Per;
        set => PerChanged.InvokeAsync(value);
    }

    private WaterUnit PerUnitValue
    {
        get => PerUnit;
        set => PerUnitChanged.InvokeAsync(value);
    }
}
