@* A short acknowledgement straight after a milestone is logged on a page. It is page state only, never stored. *@
<section class="moment" role="status">
    <svg class="moment-leaf" viewBox="0 0 24 24" aria-hidden="true">@Icons.Seedling</svg>
    <div class="moment-text">
        <p class="moment-title">@Title</p>
        @if (!string.IsNullOrWhiteSpace(Line))
        {
            <p class="moment-line">@Line</p>
        }
        <div class="moment-actions">
            <button type="button" class="btn btn-outline-primary" @onclick="OnShare">@Strings.Shared.ShareButton</button>
            <button type="button" class="btn btn-link link-action moment-close" @onclick="OnClose">@Strings.Common.Close</button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Line { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
