@* A short acknowledgement straight after a milestone is logged on a page. It is page state only, never stored. *@
<section class="moment" role="status">
    <svg class="moment-leaf" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-9" /><path d="M12 12C6 12 4 8 4 4c6 0 8 3.500 8 8Z" /><path d="M12 15c5 0 8-3 8-7-5 0-8 3-8 7Z" /></svg>
    <div class="moment-text">
        <p class="moment-title">@Title</p>
        @if (!string.IsNullOrWhiteSpace(Line))
        {
            <p class="moment-line">@Line</p>
        }
        <div class="moment-actions">
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OnShare">@Strings.Shared.ShareButton</button>
            <button type="button" class="btn btn-link btn-sm link-action" @onclick="OnClose">@Strings.Common.Close</button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Line { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
