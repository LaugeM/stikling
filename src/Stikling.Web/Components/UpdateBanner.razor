@* Shows a bar when a new version of the app has been downloaded in the background. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ready)
{
    <div class="update-banner" role="status">
        @if (updating)
        {
            <span><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Updating Stikling. The page reloads when it's done.</span>
        }
        else
        {
            <span>A new version of Stikling is ready.</span>
            <button type="button" class="btn btn-primary btn-sm" @onclick="ReloadAsync">Reload</button>
            <button type="button" class="btn btn-link btn-sm" @onclick="() => SetReadyAsync(false)">Later</button>
        }
    </div>
}

@code {
    /// <summary>Raised when the banner appears, so the page can leave room for it.</summary>
    [Parameter]
    public EventCallback<bool> ReadyChanged { get; set; }

    internal const string ModulePath = "./js/update.js";
    internal const string WatchMethod = "watch";
    internal const string ApplyMethod = "apply";

    private IJSObjectReference? module;
    private DotNetObjectReference<UpdateBanner>? self;
    private bool ready;
    private bool updating;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync(WatchMethod, self);
        }
        catch (JSException)
        {
            // No service worker (e.g. running from dotnet run): nothing to watch
        }
    }

    [JSInvokable]
    public async Task OnUpdateReady() => await InvokeAsync(async () =>
    {
        await SetReadyAsync(true);
        StateHasChanged();
    });

    private async Task SetReadyAsync(bool value)
    {
        if (ready == value)
            return;
        ready = value;
        await ReadyChanged.InvokeAsync(value);
    }

    private async Task ReloadAsync()
    {
        // The new version takes a moment to switch on, so say it's happening
        updating = true;
        StateHasChanged();
        try
        {
            if (module is not null)
                await module.InvokeVoidAsync(ApplyMethod);
        }
        catch (JSException)
        {
            // Couldn't switch over, so offer the buttons again
            updating = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
            await module.DisposeAsync();
        self?.Dispose();
    }
}
