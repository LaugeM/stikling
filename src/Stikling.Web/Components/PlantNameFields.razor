@* A search box that takes everyday or botanical names and fills in the fields under it, then the
   genus, species and cultivar fields, with names to tap under the one being typed in. Chips
   rather than a datalist, which a phone won't show. Anything can still be typed. The chips keep
   the field focused when tapped (mousedown is cancelled), so the keyboard stays up. The search
   results don't: picking one is the end of the search, so the keyboard can go away. *@
@implements IAsyncDisposable
@inject PlantNameService Names
@inject IJSRuntime JS

<div class="mb-3">
    <label class="form-label" for="name-search">What plant is it?</label>
    <input id="name-search" type="search" class="form-control" value="@query" placeholder="e.g. snake plant or Monstera deliciosa"
           autocomplete="off" spellcheck="false" enterkeyhint="search" aria-controls="name-results"
           @oninput="e => query = e.Value?.ToString()" @ref="searchInput" />
    @if (Found is { Count: > 0 } found)
    {
        <div id="name-results" class="name-results" role="group" aria-label="Plants found">
            @foreach (var result in found)
            {
                <button type="button" class="name-result" @onclick="() => PickFoundAsync(result)">
                    @if (result.Formerly is { } old)
                    {
                        <span class="name-result-main"><i>@old</i></span>
                        <span class="name-result-sub">now <BotanicalName Genus="@result.Genus" Species="@result.Species" Cultivar="@result.Cultivar" /></span>
                    }
                    else if (result.Everyday is { } resultCalled)
                    {
                        <span class="name-result-main">@resultCalled</span>
                        <span class="name-result-sub"><BotanicalName Genus="@result.Genus" Species="@result.Species" Cultivar="@result.Cultivar" /></span>
                    }
                    else
                    {
                        <span class="name-result-main"><BotanicalName Genus="@result.Genus" Species="@result.Species" Cultivar="@result.Cultivar" /></span>
                    }
                </button>
            }
        </div>
    }
    else if (suggester is not null && NameKeyLength >= NameSuggester.MinLettersWithoutGenus)
    {
        <div id="name-results" class="form-text">Nothing by that name in the app's list. You can still type it in below.</div>
    }
</div>
<div class="row g-2 mb-3">
    <div class="col-6">
        <label class="form-label" for="genus">Genus</label>
        <input id="genus" class="form-control" value="@Genus" placeholder="@GenusPlaceholder"
               autocomplete="off" autocapitalize="words" spellcheck="false"
               @oninput="e => TypeAsync(NameField.Genus, e)" @onfocus="() => active = NameField.Genus" @onblur="Blur"
               @ref="genusInput" />
    </div>
    <div class="col-6">
        <label class="form-label" for="species">Species</label>
        <input id="species" class="form-control" value="@Species" placeholder="@SpeciesPlaceholder"
               autocomplete="off" autocapitalize="none" spellcheck="false"
               @oninput="e => TypeAsync(NameField.Species, e)" @onfocus="() => active = NameField.Species" @onblur="Blur"
               @ref="speciesInput" />
    </div>
    @if (active is NameField.Genus or NameField.Species)
    {
        <div class="col-12">@Chips</div>
    }
</div>
<div class="mb-1">
    <label class="form-label" for="cultivar">Cultivar / variety</label>
    <input id="cultivar" class="form-control" value="@Cultivar" placeholder="@CultivarPlaceholder"
           autocomplete="off" autocapitalize="words" spellcheck="false"
           @oninput="e => TypeAsync(NameField.Cultivar, e)" @onfocus="() => active = NameField.Cultivar" @onblur="Blur"
           @ref="cultivarInput" />
    @if (active is NameField.Cultivar)
    {
        <div class="mt-2">@Chips</div>
    }
    @if (everyday?.For(Genus, Species, Cultivar) is { } called)
    {
        <div class="form-text">Everyday name: @called</div>
    }
</div>

@code {
    [Parameter]
    public string? Genus { get; set; }

    [Parameter]
    public EventCallback<string?> GenusChanged { get; set; }

    [Parameter]
    public string? Species { get; set; }

    [Parameter]
    public EventCallback<string?> SpeciesChanged { get; set; }

    [Parameter]
    public string? Cultivar { get; set; }

    [Parameter]
    public EventCallback<string?> CultivarChanged { get; set; }

    [Parameter]
    public string GenusPlaceholder { get; set; } = "e.g. Monstera";

    [Parameter]
    public string SpeciesPlaceholder { get; set; } = "e.g. deliciosa";

    [Parameter]
    public string CultivarPlaceholder { get; set; } = "e.g. Thai Constellation";

    private NameSuggester? suggester;
    private EverydayNameBook? everyday;
    private string? query;
    private ElementReference searchInput;
    private IJSObjectReference? enterPicks;
    private NameField? active;
    private ElementReference genusInput;
    private ElementReference speciesInput;
    private ElementReference cultivarInput;
    private ElementReference? focusNext;

    // The fields work straight away. Suggestions turn up once the names are read.
    protected override async Task OnInitializedAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        suggester = await Names.GetSuggesterAsync();
    }

    // Searched again only when the words change, not each time a field below is typed in
    private (NameSuggester? Suggester, string? Query, IReadOnlyList<NameSuggestion> Results) found = (null, null, []);

    private IReadOnlyList<NameSuggestion> Found
    {
        get
        {
            if (found.Suggester != suggester || found.Query != query)
                found = (suggester, query, suggester?.Search(query) ?? []);
            return found.Results;
        }
    }

    private int NameKeyLength => (query ?? "").Count(char.IsLetter);

    // Everything it names, and nothing left over from a name typed before
    private async Task PickFoundAsync(NameSuggestion found)
    {
        query = null;
        await SetGenusAsync(found.Genus);
        await SetSpeciesAsync(found.Species);
        await SetCultivarAsync(found.Cultivar);
    }

    private IReadOnlyList<NameSuggestion> Suggestions =>
        suggester is not null && active is { } typing ? suggester.Suggest(typing, Genus, Species, Cultivar) : [];

    private RenderFragment Chips => @<text>
        @if (Suggestions is { Count: > 0 } suggestions)
        {
            <div class="chip-row" role="group" aria-label="Suggested names">
                @foreach (var suggestion in suggestions)
                {
                    <button type="button" class="chip name-chip" tabindex="-1"
                            @onmousedown:preventDefault @onclick="() => PickAsync(suggestion)">
                        @ChipText(suggestion)
                    </button>
                }
            </div>
        }
    </text>;

    // Only what the field needs: a species on its own when the genus is already there, and an old
    // name with the one it goes by now.
    private RenderFragment ChipText(NameSuggestion s) => active switch
    {
        NameField.Genus when s.Formerly is { } old =>
            @<text><i>@old</i> <span class="chip-note">now <i>@s.Genus</i></span></text>,
        NameField.Genus => @<i>@s.Genus</i>,
        NameField.Species when s.Formerly is { } old =>
            @<text><i>@(SameGenus(old.Split(' ', 2)[0]) ? old.Split(' ', 2)[1] : old)</i> <span class="chip-note">now <i>@s.Genus @s.Species</i></span></text>,
        NameField.Species => SameGenus(s.Genus) ? @<i>@s.Species</i> : @<i>@s.Genus @s.Species</i>,
        _ when !SameGenus(s.Genus) =>
            @<text>'@s.Cultivar' <span class="chip-note"><i>@s.Genus @s.Species</i></span></text>,
        _ when s.Species is not null && string.IsNullOrWhiteSpace(Species) =>
            @<text>'@s.Cultivar' <span class="chip-note"><i>@s.Species</i></span></text>,
        _ => @<text>'@s.Cultivar'</text>
    };

    private bool SameGenus(string genus) => string.Equals(PlantNames.Genus(Genus), genus, StringComparison.OrdinalIgnoreCase);

    private Task TypeAsync(NameField field, ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        return field switch
        {
            NameField.Genus => SetGenusAsync(text),
            NameField.Species => SetSpeciesAsync(text),
            _ => SetCultivarAsync(text)
        };
    }

    // Picking fills in the rest of the name it belongs to, then moves on to the next field
    private async Task PickAsync(NameSuggestion suggestion)
    {
        var field = active;
        await SetGenusAsync(suggestion.Genus);
        if (field is not NameField.Genus && suggestion.Species is not null)
            await SetSpeciesAsync(suggestion.Species);
        if (field is NameField.Cultivar)
            await SetCultivarAsync(suggestion.Cultivar);

        focusNext = field switch
        {
            NameField.Genus => speciesInput,
            NameField.Species => cultivarInput,
            _ => null
        };
    }

    private void Blur() => active = null;

    private Task SetGenusAsync(string? value)
    {
        Genus = value;
        return GenusChanged.InvokeAsync(value);
    }

    private Task SetSpeciesAsync(string? value)
    {
        Species = value;
        return SpeciesChanged.InvokeAsync(value);
    }

    private Task SetCultivarAsync(string? value)
    {
        Cultivar = value;
        return CultivarChanged.InvokeAsync(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Enter in the search box picks the first plant found, rather than saving the form
        if (firstRender)
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
            enterPicks = await module.InvokeAsync<IJSObjectReference>("enterPicksFirst", searchInput);
        }

        if (focusNext is not { } input)
            return;

        focusNext = null;
        await input.FocusAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (enterPicks is null)
            return;
        try
        {
            await enterPicks.InvokeVoidAsync("dispose");
            await enterPicks.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
