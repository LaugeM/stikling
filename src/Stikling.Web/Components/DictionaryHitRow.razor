@* A name found in the plant dictionary, as a row that opens its page: the botanical name, and under it the
   everyday name, or what an old name is now *@
@using System.Globalization

<a class="item-card @Class" href="@Hit.Href" @onclick="OnOpen">
    <span class="item-text">
        @if (Hit.Name.Formerly is { } old)
        {
            <span class="item-name"><i class="hit-name">@old</i></span>
            <span class="item-meta">@string.Format(CultureInfo.CurrentCulture, Strings.Plants.NameNow, PlantNames.Botanical(Hit.Name.Genus, Hit.Name.Species, Hit.Name.Cultivar))</span>
        }
        else
        {
            <span class="item-name hit-name"><BotanicalName Genus="@Hit.Name.Genus" Species="@Hit.Name.Species" Cultivar="@Hit.Name.Cultivar" /></span>
            @if (Hit.Name.Everyday is { } called)
            {
                <span class="item-meta">@called</span>
            }
        }
    </span>
</a>

@code {
    [Parameter, EditorRequired]
    public DictionaryHit Hit { get; set; } = null!;

    /// <summary>Added to the row, like the search-stop the Search page puts on its rows.</summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnOpen { get; set; }
}
