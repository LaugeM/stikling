@* A year of waterings, feeds and meter readings for one plant, one row per month. *@

@if (Calendar is { IsEmpty: false } calendar)
{
    <div class="care-calendar">
        <p class="visually-hidden">@calendar.Summary</p>
        @foreach (var month in calendar.Months)
        {
            var marked = month.Days.Where(d => d.Mark != CareDayMark.None).ToList();
            var key = month.Year * 12 + month.Month;
            var open = openMonth == key;
            <div class="cal-month-block">
                @if (marked.Count == 0)
                {
                    <div class="cal-row">
                        <span class="cal-month">@MonthName(month)</span>
                        <span class="cal-days" aria-hidden="true">
                            @foreach (var day in month.Days)
                            {
                                <span class="cal-day @ClassFor(day)"></span>
                            }
                        </span>
                    </div>
                }
                else
                {
                    <button type="button" class="cal-row cal-row-button" aria-expanded="@(open ? "true" : "false")"
                            aria-label="@F(marked.Count, Strings.Plants.CalendarMonthDays_One, Strings.Plants.CalendarMonthDays_Other, MonthName(month), month.Year, marked.Count)"
                            @onclick="() => openMonth = open ? null : key">
                        <span class="cal-month">@MonthName(month)</span>
                        <span class="cal-days" aria-hidden="true">
                            @foreach (var day in month.Days)
                            {
                                <span class="cal-day @ClassFor(day)" title="@TitleFor(day)"></span>
                            }
                        </span>
                    </button>
                    @if (open)
                    {
                        <ul class="cal-entries">
                            @foreach (var day in marked)
                            {
                                <li>@F(Strings.Plants.CalendarDayMark, day.Date.ToString(Strings.Plants.CalendarDayFormat, TextCulture.ForDates), MarkText(day.Mark))</li>
                            }
                        </ul>
                    }
                }
            </div>
        }
        <div class="cal-legend" aria-hidden="true">
            <span><span class="cal-day cal-watered"></span> @Strings.Plants.CalendarWatered</span>
            <span><span class="cal-day cal-fed"></span> @Strings.Plants.CalendarFed</span>
            <span><span class="cal-day cal-reading"></span> @Strings.Plants.CalendarReading</span>
        </div>
        <p class="cal-hint">@Strings.Plants.CalendarHint</p>
    </div>
}

@code {
    [Parameter] public CareCalendar? Calendar { get; set; }

    private static string F(string format, params object?[] args) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, format, args);

    private static string F(int count, string one, string other, params object?[] args) => F(count == 1 ? one : other, args);

    private int? openMonth;

    private static string MonthName(CareCalendarMonth month) =>
        new DateOnly(month.Year, month.Month, 1).ToString("MMM", TextCulture.ForDates);

    private static string ClassFor(CareCalendarDay day) => day.Mark switch
    {
        _ when day.Future => "cal-future",
        CareDayMark.Fed => "cal-fed",
        CareDayMark.Watered => "cal-watered",
        CareDayMark.Reading => "cal-reading",
        _ => ""
    };

    private static string MarkText(CareDayMark mark) => mark switch
    {
        CareDayMark.Fed => Strings.Plants.CalendarFedDay,
        CareDayMark.Watered => Strings.Plants.CalendarWateredDay,
        _ => Strings.Plants.CalendarReadingDay
    };

    private static string TitleFor(CareCalendarDay day)
    {
        var date = Labels.Date(day.Date);
        return day.Mark switch
        {
            CareDayMark.Fed => F(Strings.Plants.CalendarDayMark, date, Strings.Plants.CalendarFedDay),
            CareDayMark.Watered => F(Strings.Plants.CalendarDayMark, date, Strings.Plants.CalendarWateredDay),
            CareDayMark.Reading => F(Strings.Plants.CalendarDayMark, date, Strings.Plants.CalendarReadingDay),
            _ => date
        };
    }
}
