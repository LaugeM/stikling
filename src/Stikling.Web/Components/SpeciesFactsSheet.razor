@* The inside of the About this species sheet: a short text from Wikipedia and a few facts from Trefle, with their
   credits. It is only on the page while the sheet is open, so nothing is fetched before someone asks. The text is
   shown as plain text, never as markup. Nothing is stored on the device. *@
@using Stikling.Core.Flowering
@using Stikling.Core.PlantFacts
@inject StiklingApi Api

<div class="species-facts">
    @switch (state)
    {
        case Load.Loading:
            <p class="text-body-secondary">@Strings.Plants.Loading</p>
            break;
        case Load.Offline:
            <p class="text-body-secondary">@Strings.Common.FactsOffline</p>
            break;
        case Load.Failed:
            <p class="text-body-secondary">@Strings.Common.FactsFailed</p>
            break;
        default:
            @if (facts is not { Summary: not null } && TrefleData is null)
            {
                <p class="text-body-secondary">@Strings.Common.FactsNothing</p>
            }
            else
            {
                @if (facts?.Summary is { } summary)
                {
                    @* lang so a screen reader reads the English article in English *@
                    <p class="species-facts-text" lang="@summary.Language">@summary.Text</p>
                    @if (summary.Language != Language)
                    {
                        <p class="detail-sub">@Strings.Common.FactsInEnglish</p>
                    }
                }

                @if (TrefleData is { } trefle)
                {
                    <dl class="detail-list species-facts-list">
                        @if (trefle.MaxHeightCm is { } height)
                        {
                            <dt>@Strings.Common.FactsHeight</dt>
                            <dd>@F(Strings.Common.FactsHeightUpTo, Lengths.Cm(height))</dd>
                        }
                        @if (trefle.BloomMonths.Count > 0)
                        {
                            <dt>@Strings.Common.FactsBloom</dt>
                            <dd>@string.Join(", ", trefle.BloomMonths.Select(FloweringText.MonthName))</dd>
                        }
                        @if (HabitText(trefle.GrowthHabit) is { } habit)
                        {
                            <dt>@Strings.Common.FactsHabit</dt>
                            <dd>@habit</dd>
                        }
                    </dl>
                }

                @if (!string.IsNullOrWhiteSpace(Cultivar))
                {
                    <p class="detail-sub">@F(Strings.Common.FactsCultivarNote, Cultivar)</p>
                }

                <p class="species-facts-credits">
                    @if (facts?.Summary is { } article)
                    {
                        <span><a href="@article.PageUrl" target="_blank" rel="noopener">@Strings.Common.FactsWikipediaCredit<span class="visually-hidden"> @Strings.Common.OpensInNewTab</span></a></span>
                    }
                    @if (TrefleData is { } data)
                    {
                        <span>
                            <a href="https://trefle.io/" target="_blank" rel="noopener">@Strings.Common.FactsTrefleCredit<span class="visually-hidden"> @Strings.Common.OpensInNewTab</span></a>@if (data.Sources.Count > 0)
                            {
                                <text>: </text>
                                @for (var i = 0; i < data.Sources.Count; i++)
                                {
                                    var source = data.Sources[i];
                                    @(i > 0 ? ", " : "")
                                    @if (source.Url is { } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener">@source.Name<span class="visually-hidden"> @Strings.Common.OpensInNewTab</span></a>
                                    }
                                    else
                                    {
                                        @source.Name
                                    }
                                }
                            }
                        </span>
                    }
                </p>
            }
            break;
    }
</div>

@code {
    private enum Load { Loading, Done, Offline, Failed }

    /// <summary>The genus, as it goes by now.</summary>
    [Parameter, EditorRequired]
    public string Genus { get; set; } = "";

    /// <summary>The species as it goes by now. Null asks about the genus.</summary>
    [Parameter]
    public string? Species { get; set; }

    /// <summary>The plant's cultivar, which only adds the line saying the card is about the species.</summary>
    [Parameter]
    public string? Cultivar { get; set; }

    /// <summary>"en" or "da": the app's language.</summary>
    [Parameter]
    public string Language { get; set; } = "en";

    private Load state = Load.Loading;
    private PlantFacts? facts;

    // Trefle's facts are only shown when there is something in them
    private TrefleFacts? TrefleData => facts?.Facts;

    // What the last load was for, so an answer that arrives after the names changed or the sheet was
    // opened again is ignored instead of replacing the state of a newer load
    private string? loadedFor;
    private int request;

    protected override async Task OnParametersSetAsync()
    {
        var wanted = $"{Genus}|{Species}|{Language}";
        if (wanted == loadedFor)
            return;

        loadedFor = wanted;
        var mine = ++request;
        state = Load.Loading;
        facts = null;

        Load result;
        PlantFacts? answer = null;
        try
        {
            answer = await Api.GetPlantFactsAsync(Genus, Species, Language);
            result = Load.Done;
        }
        catch (Exception e) when (e is TaskCanceledException || e is HttpRequestException { StatusCode: null })
        {
            result = Load.Offline;
        }
        catch (Exception)
        {
            result = Load.Failed;
        }

        if (mine != request)
            return;

        facts = answer;
        state = result;
    }

    private static string? HabitText(string? habit) => habit switch
    {
        "Tree" => Strings.Common.FactsHabitTree,
        "Shrub" => Strings.Common.FactsHabitShrub,
        "Subshrub" => Strings.Common.FactsHabitSubshrub,
        "Vine" => Strings.Common.FactsHabitVine,
        "Forb/herb" => Strings.Common.FactsHabitHerb,
        _ => null,
    };
}
