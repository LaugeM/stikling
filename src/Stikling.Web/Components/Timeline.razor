@* History of a plant or propagation, newest first and grouped by day. Photos and notes are added with EntryComposer. *@
@inject ITimelineRepository Entries
@inject TimelineService TimelineService
@inject IPhotoRepository PhotoRepository
@inject PhotoService Photos
@inject TimeProvider Time

<ReloadOnSync Reload="LoadAsync" />

@if (days is null)
{
    <p class="text-body-secondary">Loading history…</p>
}
else if (days.Count == 0)
{
    <div class="empty-state"><p>@EmptyText</p></div>
}
else
{
    <h2 class="visually-hidden">History</h2>
    <ol class="timeline">
        @foreach (var (day, entries) in days)
        {
            <li class="timeline-day">
                <h3>@DayLabel(day)</h3>
                <ol>
                    @foreach (var entry in entries)
                    {
                        var entryPhotos = entry.PhotoIds.Where(photoIndex.ContainsKey).ToList();
                        <li class="timeline-entry kind-@entry.Kind.ToString().ToLowerInvariant()">
                            <div class="entry-head">
                                <span class="entry-kind">@KindIcon(entry)@KindLabel(entry)</span>
                                @* "Added" is dated by the acquired date, which has no real time of day *@
                                @if (entry.Kind != TimelineKind.Created)
                                {
                                    <time datetime="@entry.OccurredAt.ToString("o")">@Labels.Time(entry.OccurredAt)</time>
                                    @if (entry.Kind == TimelineKind.Photo && PhotoDayCount.Day(DayOne, LocalDay(entry.OccurredAt)) is { } photoDay)
                                    {
                                        <span class="entry-day">day @photoDay</span>
                                    }
                                    @if (entry.Edits.Count > 0)
                                    {
                                        <button type="button" class="entry-edited" aria-expanded="@(versionsId == entry.Id ? "true" : "false")"
                                                @onclick="() => versionsId = versionsId == entry.Id ? null : entry.Id">edited</button>
                                    }
                                    <span class="entry-actions">
                                        @if (TimelineService.CanCorrect(entry) && editId != entry.Id)
                                        {
                                            <button type="button" class="entry-action" @onclick="() => StartEdit(entry)"
                                                    aria-label="Correct entry" title="Correct entry">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                                            </button>
                                        }
                                        <button type="button" class="entry-action" @onclick="() => confirmDeleteId = entry.Id"
                                                aria-label="Delete entry" title="Delete entry">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                                        </button>
                                    </span>
                                }
                            </div>

                            @if (editId == entry.Id)
                            {
                                <div class="entry-editor">
                                    <textarea class="form-control" rows="2" aria-label="Corrected note" @bind="editText" @bind:event="oninput"></textarea>
                                    <div class="entry-editor-row">
                                        <label for="@editDateId">Happened on</label>
                                        <input id="@editDateId" type="date" class="form-control form-control-sm" @bind="editDay"
                                               max="@Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                    @if (editError is not null)
                                    {
                                        <p class="entry-editor-error" role="alert">@editError</p>
                                    }
                                    <div class="entry-editor-row">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SaveEditAsync(entry)"
                                                disabled="@(busy || (entryPhotos.Count == 0 && string.IsNullOrWhiteSpace(editText)))">Save</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(entry.Text))
                            {
                                <p class="entry-text">@entry.Text</p>
                            }

                            @if (versionsId == entry.Id)
                            {
                                <div class="entry-versions">
                                    <p class="entry-versions-title">Earlier versions</p>
                                    <ol>
                                        @foreach (var version in Enumerable.Reverse(entry.Edits))
                                        {
                                            <li>
                                                <span class="entry-versions-meta">
                                                    Dated @Labels.Date(LocalDay(version.OccurredAt)) · changed @Labels.Date(LocalDay(version.ReplacedAt))
                                                </span>
                                                @if (string.IsNullOrWhiteSpace(version.Text))
                                                {
                                                    <span class="entry-versions-empty">No text</span>
                                                }
                                                else
                                                {
                                                    <span class="entry-text">@version.Text</span>
                                                }
                                            </li>
                                        }
                                    </ol>
                                </div>
                            }

                            @if (entry.RelatedId is { } relatedId)
                            {
                                <a class="entry-link link-action" href="@(entry.RelatedType == SubjectType.Plant ? "plants" : "propagations")/@relatedId">
                                    @(entry.RelatedType == SubjectType.Plant ? "Open plant" : "Open propagation")
                                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                                </a>
                            }

                            @if (entryPhotos.Count > 0)
                            {
                                <div class="entry-photos">
                                    @foreach (var photoId in entryPhotos)
                                    {
                                        <button type="button" class="entry-photo" @onclick="() => viewerIndex = photoIndex[photoId]"
                                                aria-label="Open photo">
                                            <PhotoImage PhotoId="photoId" />
                                        </button>
                                    }
                                </div>
                            }

                            @if (confirmDeleteId == entry.Id)
                            {
                                <div class="entry-confirm">
                                    <span>@(entryPhotos.Count > 0 ? "Delete this entry and its photos?" : "Delete this entry?")</span>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteEntryAsync(entry)">Delete</button>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => confirmDeleteId = null">Cancel</button>
                                </div>
                            }
                        </li>
                    }
                </ol>
            </li>
        }
    </ol>
}

<PhotoViewer PhotoList="photos" @bind-Index="viewerIndex" CoverPhotoId="CoverPhotoId" DayOne="DayOne"
             OnSetCover="SetCoverAsync" OnFrame="FrameAsync" OnDelete="DeletePhotoAsync" />

@code {
    [Parameter, EditorRequired]
    public SubjectType SubjectType { get; set; }

    [Parameter, EditorRequired]
    public Guid SubjectId { get; set; }

    [Parameter]
    public Guid? CoverPhotoId { get; set; }

    /// <summary>The day photos count from (day 0). Without it, no day count is shown.</summary>
    [Parameter]
    public DateOnly? DayOne { get; set; }

    /// <summary>What to say while there is nothing yet.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "No photos or notes yet.";

    /// <summary>Raised when the cover photo should change (null = no cover).</summary>
    [Parameter]
    public EventCallback<Guid?> OnCoverChanged { get; set; }

    private readonly string editDateId = $"edit-date-{Guid.NewGuid():N}";

    private IReadOnlyList<(DateOnly Day, IReadOnlyList<TimelineEntry> Entries)>? days;
    private IReadOnlyList<Photo> photos = [];
    private Dictionary<Guid, int> photoIndex = [];

    private bool busy;
    private Guid? confirmDeleteId;
    private int? viewerIndex;
    private Guid? editId;
    private string? editText;
    private DateOnly editDay;
    private string? editError;
    private Guid? versionsId;
    private Guid loadedFor;
    private Guid? openWhenLoaded;

    private DateOnly Today => Time.Today();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != SubjectId)
        {
            loadedFor = SubjectId;
            openWhenLoaded = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var entries = await Entries.GetForAsync(SubjectId);
        var stored = await PhotoRepository.GetForAsync(SubjectId);

        // The viewer pages through photos in the same order as the timeline shows them
        var byId = stored.ToDictionary(p => p.Id);
        var inTimeline = entries.SelectMany(e => e.PhotoIds).Where(byId.ContainsKey).Distinct().Select(id => byId[id]);
        photos = inTimeline.Concat(stored.Where(p => !entries.Any(e => e.PhotoIds.Contains(p.Id)))).ToList();
        photoIndex = photos.Select((p, i) => (p.Id, i)).ToDictionary(x => x.Id, x => x.i);
        days = TimelineOrder.ByDay(entries, Time);

        // A photo tapped before the photos were here opens as soon as they are
        if (openWhenLoaded is { } waiting)
        {
            openWhenLoaded = null;
            OpenPhoto(waiting);
        }
    }

    private async Task DeleteEntryAsync(TimelineEntry entry)
    {
        confirmDeleteId = null;
        foreach (var photoId in entry.PhotoIds)
            await RemovePhotoAsync(photoId);
        await Entries.DeleteAsync(entry.Id);
        await LoadAsync();
    }

    private async Task DeletePhotoAsync(Photo photo)
    {
        await RemovePhotoAsync(photo.Id);
        await TimelineService.RemoveEmptiedEntriesAsync(SubjectId, photo.Id);
        await LoadAsync();
        viewerIndex = photos.Count == 0 ? null : Math.Min(viewerIndex ?? 0, photos.Count - 1);
    }

    private async Task RemovePhotoAsync(Guid photoId)
    {
        await Photos.DeleteAsync(photoId);
        if (photoId == CoverPhotoId)
            await OnCoverChanged.InvokeAsync(null);
    }

    private void StartEdit(TimelineEntry entry)
    {
        editId = entry.Id;
        editText = entry.Text;
        editDay = LocalDay(entry.OccurredAt);
        editError = null;
        confirmDeleteId = null;
    }

    private void CancelEdit()
    {
        editId = null;
        editError = null;
    }

    private async Task SaveEditAsync(TimelineEntry entry)
    {
        busy = true;
        try
        {
            await TimelineService.CorrectAsync(entry, editText, editDay);
            CancelEdit();
        }
        catch (ArgumentException ex)
        {
            // The rule's own message, without " (Parameter 'day')"
            editError = ex.Message.Split(" (Parameter")[0];
        }

        await LoadAsync();
        busy = false;
    }

    private DateOnly LocalDay(DateTimeOffset moment) => Time.LocalDay(moment);

    private Task SetCoverAsync(Photo photo) => OnCoverChanged.InvokeAsync(photo.Id);

    private Task FrameAsync((Photo Photo, PhotoFrame? Frame) change) => Photos.SetFrameAsync(change.Photo, change.Frame);

    /// <summary>
    /// Opens a photo full screen, e.g. the cover when it's tapped at the top of the page. Before
    /// the photos have loaded it opens once they have.
    /// </summary>
    public void OpenPhoto(Guid photoId)
    {
        if (days is null)
        {
            openWhenLoaded = photoId;
            return;
        }

        if (photoIndex.TryGetValue(photoId, out var index))
        {
            viewerIndex = index;
            StateHasChanged();
        }
    }

    private string DayLabel(DateOnly day) =>
        day == Today ? "Today"
        : day == Today.AddDays(-1) ? "Yesterday"
        : Labels.Date(day);

    private static string KindLabel(TimelineEntry entry) => TimelineEvents.Of(entry) switch
    {
        TimelineEvent.PottedUp => "Potted up",
        TimelineEvent.Failed => "Didn't make it",
        _ => KindLabel(entry.Kind)
    };

    private static MarkupString KindIcon(TimelineEntry entry) => TimelineEvents.Of(entry) switch
    {
        TimelineEvent.PottedUp => new("""<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 11V7" /><path d="M12 8c0-2.5 1.7-4 4.5-4 0 2.5-1.7 4-4.5 4Z" /><path d="M12 9c0-2-1.4-3-3.5-3 0 2 1.4 3 3.5 3Z" /><path d="M5 11h14l-1.6 9H6.6Z" /></svg>"""),
        TimelineEvent.Failed => new("""<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21v-8" /><path d="M9 13c-4 0-6-2-6-5 3 0 6 1 6 5Z" /><path d="M15 4.500l5 5M20 4.500l-5 5" /></svg>"""),
        _ => KindIcon(entry.Kind)
    };

    private static string KindLabel(TimelineKind kind) => kind switch
    {
        TimelineKind.Created => "Added",
        TimelineKind.Note => "Note",
        TimelineKind.Photo => "Photo",
        TimelineKind.Change => "Updated",
        TimelineKind.Propagated => "Propagated",
        _ => kind.ToString()
    };

    // Static markup, one icon per kind, so the entry can be placed at a glance
    // without reading the label.
    private static MarkupString KindIcon(TimelineKind kind) => new(kind switch
    {
        TimelineKind.Created => """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-8" /><path d="M12 13c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>""",
        TimelineKind.Note => """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>""",
        TimelineKind.Photo => """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h3.5L8 6h8l1.5 2H21v11H3Z" /><circle cx="12" cy="13" r="3.5" /></svg>""",
        TimelineKind.Change => """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h14l-3.5-3.5" /><path d="M20 15H6l3.5 3.5" /></svg>""",
        TimelineKind.Propagated => """<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.5" /><circle cx="6" cy="17.5" r="2.5" /><path d="M8.2 7.8 19 17M8.2 16.2 19 7" /></svg>""",
        _ => ""
    });
}
