@* History of a plant or propagation, newest first and grouped by day. Photos and notes are added with EntryComposer. *@
@inject ITimelineRepository Entries
@inject IPestCaseRepository PestCases
@inject TimelineService TimelineService
@inject IPhotoRepository PhotoRepository
@inject IReceivedHistoryRepository ReceivedHistories
@inject PhotoService Photos
@inject ShelfService Shelf
@inject TimeProvider Time
@inject PropagationService PropagationService
@inject MeasurementService MeasureService
@using System.Globalization
@using Stikling.Core.Sharing
@using Stikling.Core.Propagations

<ReloadOnSync Reload="LoadAsync" />

@if (references.Count > 0)
{
    <section class="reference-photos" aria-labelledby="@referenceId">
        <p class="reference-label" id="@referenceId">@(SubjectType == SubjectType.Plant ? Strings.Propagations.TlReferencePlant : Strings.Propagations.TlReferencePropagation)</p>
        <div class="reference-row">
            @foreach (var photo in references)
            {
                <button type="button" class="reference-photo" @onclick="() => viewerIndex = photoIndex[photo.Id]" aria-label="@Strings.Propagations.TlOpenReference">
                    <PhotoImage PhotoId="photo.Id" />
                </button>
            }
        </div>
    </section>
}

@if (days is null)
{
    <p class="text-body-secondary">@Strings.Propagations.TlLoading</p>
}
else if (days.Count == 0)
{
    <div class="empty-state"><p>@EmptyText</p></div>
}
else
{
    <h2 class="visually-hidden">@Strings.Propagations.TlHistory</h2>
    <ol class="timeline">
        @foreach (var (day, entries) in days)
        {
            <li class="timeline-day">
                <h3>@DayLabel(day)</h3>
                <ol>
                    @foreach (var row in RowsOf(day, entries))
                    {
                        @if (row.Shelf is { } shot)
                        {
                            @* A photo of a shelf this one is marked in. It is read from the marks, not saved as an entry, so nothing in it can be changed here. *@
                            <li class="timeline-entry kind-shelf">
                                <div class="entry-head">
                                    <span class="entry-kind">@KindIcon(TimelineKind.Photo)@Strings.Shelf.HistoryLabel</span>
                                    <time datetime="@shot.Photo.TakenAt.ToString("o")">@Labels.Time(shot.Photo.TakenAt)</time>
                                </div>
                                @if (shot.PlaceName is { } shotPlace)
                                {
                                    <p class="entry-text">@shotPlace</p>
                                }
                                <a class="shelf-history-photo" href="shelf/@shot.Photo.Id?mark=@SubjectId"
                                   aria-label="@F(Strings.Shelf.HistoryOpen, Labels.Date(LocalDay(shot.Photo.TakenAt)))">
                                    <PhotoImage PhotoId="shot.Photo.Id" Thumbnail="false" FrameOverride="PhotoFrame.From(shot.X, shot.Y, 2.5)" />
                                </a>
                            </li>
                            continue;
                        }
                        var entry = row.Entry!;
                        var entryPhotos = entry.PhotoIds.Where(id => photoIndex.ContainsKey(id) && !referenceIds.Contains(id)).ToList();
                        <li id="entry-@entry.Id" class="timeline-entry kind-@entry.Kind.ToString().ToLowerInvariant()">
                            <div class="entry-head">
                                <span class="entry-kind">@KindIcon(entry)@KindLabel(entry)</span>
                                @* "Added" is dated by the acquired date, which has no real time of day *@
                                @if (entry.Kind != TimelineKind.Created)
                                {
                                    <time datetime="@entry.OccurredAt.ToString("o")">@Labels.Time(entry.OccurredAt)</time>
                                    @if (entry.Kind == TimelineKind.Photo && PhotoAge?.Invoke(LocalDay(entry.OccurredAt)) is { } photoAge)
                                    {
                                        <span class="entry-day">@photoAge</span>
                                    }
                                    @if (entry.Edits.Count > 0)
                                    {
                                        <button type="button" class="entry-edited" aria-expanded="@(versionsId == entry.Id ? "true" : "false")"
                                                @onclick="() => versionsId = versionsId == entry.Id ? null : entry.Id">@Strings.Propagations.TlEdited</button>
                                    }
                                    @if (earlierIds.Contains(entry.Id))
                                    {
                                        <span class="entry-day">@Strings.Propagations.TlAsCutting</span>
                                    }
                                    else
                                    {
                                    <span class="entry-actions">
                                        @if (TimelineService.CanCorrect(entry) && editId != entry.Id)
                                        {
                                            <button type="button" class="entry-action" @onclick="() => StartEdit(entry)"
                                                    aria-label="@Strings.Propagations.TlCorrect" title="@Strings.Propagations.TlCorrect">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Pencil</svg>
                                            </button>
                                        }
                                        <button type="button" class="entry-action" @onclick="() => AskDeleteAsync(entry)"
                                                aria-label="@Strings.Propagations.TlDelete" title="@Strings.Propagations.TlDelete">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Close</svg>
                                        </button>
                                    </span>
                                    }
                                }
                            </div>

                            @if (editId == entry.Id)
                            {
                                <div class="entry-editor">
                                    @if (!MeasuredEntries.IsMeasured(entry))
                                    {
                                        <textarea class="form-control" rows="2" aria-label="@Strings.Propagations.TlCorrectedNote" @bind="editText" @bind:event="oninput"></textarea>
                                    }
                                    <MeasureFields Draft="editMeasure" Changed="() => { }" Disabled="busy" />
                                    <div class="entry-editor-row">
                                        <label for="@editDateId">@Strings.Propagations.TlHappenedOn</label>
                                        <input id="@editDateId" type="date" class="form-control form-control-sm" @bind="editDay"
                                               max="@Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                    @if (entry.Kind == TimelineKind.Note)
                                    {
                                        <BringItBack Choice="editBringBack" NoteDay="editDay" Stored="entry.ComesBackOn" Changed="() => { }" />
                                    }
                                    @if (editError is not null)
                                    {
                                        <p class="entry-editor-error" role="alert">@editError</p>
                                    }
                                    <div class="entry-editor-row">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SaveEditAsync(entry)"
                                                disabled="@(busy || !CanSaveEdit(entry, entryPhotos.Count))">@Strings.Common.Save</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="CancelEdit">@Strings.Common.Cancel</button>
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(entry.Text) && TimelineEvents.Of(entry) != TimelineEvent.LookedOver
                                && !(MeasuredEntries.IsMeasured(entry) && measurementsByEntry.ContainsKey(entry.Id)))
                            {
                                <p class="entry-text">@HistoryText.Show(entry, Labels.For, Labels.English, CultureInfo.CurrentUICulture)</p>
                            }
                            @if (editId != entry.Id && measurementsByEntry.TryGetValue(entry.Id, out var taken))
                            {
                                <p class="entry-measures">@string.Join(" · ", taken.Select(m => MeasureText.Phrase(m)))</p>
                            }
                            @if (editId != entry.Id && entry.Kind == TimelineKind.Note && entry.ComesBackOn is { } comesBack)
                            {
                                <p class="entry-comes-back">@F(Strings.Propagations.TlComesBack, Labels.Date(comesBack))</p>
                            }

                            @if (versionsId == entry.Id)
                            {
                                <div class="entry-versions">
                                    <p class="entry-versions-title">@Strings.Propagations.TlEarlierVersions</p>
                                    <ol>
                                        @foreach (var version in Enumerable.Reverse(entry.Edits))
                                        {
                                            <li>
                                                <span class="entry-versions-meta">
                                                    @F(Strings.Propagations.TlVersionMeta, Labels.Date(LocalDay(version.OccurredAt)), Labels.Date(LocalDay(version.ReplacedAt)))
                                                </span>
                                                @if (string.IsNullOrWhiteSpace(version.Text))
                                                {
                                                    <span class="entry-versions-empty">@Strings.Propagations.TlNoText</span>
                                                }
                                                else
                                                {
                                                    <span class="entry-text">@version.Text</span>
                                                }
                                            </li>
                                        }
                                    </ol>
                                </div>
                            }

                            @if (earlierIds.Contains(entry.Id) && EarlierPropagationId is { } cuttingId)
                            {
                                <a class="entry-link link-action" href="propagations/@cuttingId">
                                    @Strings.Propagations.TlOpenPropagation
                                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronRight</svg>
                                </a>
                            }
                            else if (entry.PestCaseId is { } caseId && pestCaseIds.Contains(caseId))
                            {
                                <a class="entry-link link-action" href="pests/@caseId">
                                    @Strings.Propagations.TlOpenPestCase
                                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronRight</svg>
                                </a>
                            }
                            else if (entry.RelatedId is { } relatedId)
                            {
                                <a class="entry-link link-action" href="@(entry.RelatedType == SubjectType.Plant ? "plants" : "propagations")/@relatedId">
                                    @(entry.RelatedType == SubjectType.Plant ? Strings.Propagations.TlOpenPlant : Strings.Propagations.TlOpenPropagation)
                                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronRight</svg>
                                </a>
                            }

                            @if (entryPhotos.Count > 0)
                            {
                                <div class="entry-photos">
                                    @foreach (var photoId in entryPhotos)
                                    {
                                        <button type="button" class="entry-photo" @onclick="() => viewerIndex = photoIndex[photoId]"
                                                aria-label="@Strings.Propagations.TlOpenPhoto">
                                            <PhotoImage PhotoId="photoId" />
                                        </button>
                                    }
                                </div>
                            }

                            @if (confirmDeleteId == entry.Id)
                            {
                                <div class="entry-confirm">
                                    <span>@(entryPhotos.Count > 0 ? Strings.Propagations.TlConfirmWithPhotos : Strings.Propagations.TlConfirm)@ClearsText</span>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteEntryAsync(entry)">@Strings.Common.Delete</button>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => confirmDeleteId = null">@Strings.Common.Cancel</button>
                                </div>
                            }
                        </li>
                    }
                </ol>
            </li>
        }
    </ol>
}

@if (received is not null)
{
    @* What it had before it came here, frozen as the giver's page showed it. Nothing on it can be changed. *@
    <section class="before-history" aria-labelledby="@beforeId">
        <div class="before-divider"><span id="@beforeId">@Strings.Propagations.TlBefore</span></div>
        <h3 class="before-name">@received.Name</h3>
        <ol class="timeline">
            @foreach (var (day, items) in beforeDays)
            {
                <li class="timeline-day">
                    <h4>@DayLabel(day)</h4>
                    <ol>
                        @foreach (var item in items)
                        {
                            var itemPhotos = item.PhotoIds.Where(photoIndex.ContainsKey).ToList();
                            <li class="timeline-entry kind-@BeforeClass(item)">
                                <div class="entry-head">
                                    <span class="entry-kind">@BeforeIcon(item.Kind)@(item.Kind == ShareItemKind.Milestone ? item.Text : item.Kind == ShareItemKind.Note ? Strings.Propagations.TlKindNote : Strings.Propagations.TlKindPhoto)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.DayCount))
                                    {
                                        <span class="entry-day">@item.DayCount</span>
                                    }
                                </div>
                                @if (item.Kind == ShareItemKind.Note && !string.IsNullOrWhiteSpace(item.Text))
                                {
                                    <p class="entry-text">@item.Text</p>
                                }
                                @if (itemPhotos.Count > 0)
                                {
                                    <div class="entry-photos">
                                        @foreach (var photoId in itemPhotos)
                                        {
                                            <button type="button" class="entry-photo" @onclick="() => viewerIndex = photoIndex[photoId]"
                                                    aria-label="@Strings.Propagations.TlOpenPhoto">
                                                <PhotoImage PhotoId="photoId" />
                                            </button>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                </li>
            }
        </ol>
    </section>
}

<PhotoViewer PhotoList="photos" @bind-Index="viewerIndex" CoverPhotoId="CoverPhotoId" PhotoAge="PhotoAge"
             OnSetCover="SetCoverAsync" OnSetReference="SetReferenceAsync" OnFrame="FrameAsync" OnDelete="DeletePhotoAsync" KeptPhotoIds="earlierPhotoIds" OnCompare="OpenCompare" />

@if (compare is { } open)
{
    <PhotoCompare Photos="open.Photos" Start="open.Start" ViewedId="open.ViewedId" PhotoAge="PhotoAge"
                  ShowBeforeAfter="OnBeforeAfter.HasDelegate" NotShareable="earlierPhotoIds" OnBeforeAfter="BeforeAfterAsync" OnClose="CloseCompare" />
}

@code {
    [Parameter, EditorRequired]
    public SubjectType SubjectType { get; set; }

    [Parameter, EditorRequired]
    public Guid SubjectId { get; set; }

    [Parameter]
    public Guid? CoverPhotoId { get; set; }

    /// <summary>The day photos count from (day 0). Without it, no day count is shown.</summary>
    [Parameter]
    public Func<DateOnly, string?>? PhotoAge { get; set; }

    /// <summary>What to say while there is nothing yet.</summary>
    [Parameter]
    public string EmptyText { get; set; } = Strings.Propagations.TlEmpty;

    /// <summary>
    /// On a plant potted up from a propagation: the propagation, whose entries with photos show on
    /// the history as "As a cutting". They can't be changed here.
    /// </summary>
    [Parameter]
    public Guid? EarlierPropagationId { get; set; }

    /// <summary>The day it was potted up. Only the propagation's entries up to then show.</summary>
    [Parameter]
    public DateOnly? EarlierUntil { get; set; }

    /// <summary>Raised when the measurements on the history changed, by correcting or deleting an entry, so the page can draw its growth curves again.</summary>
    [Parameter]
    public EventCallback OnMeasurementsChanged { get; set; }

    /// <summary>Raised when the cover photo should change (null = no cover).</summary>
    [Parameter]
    public EventCallback<Guid?> OnCoverChanged { get; set; }

    /// <summary>Raised when deleting an entry changed the subject itself, like clearing a first leaf date.</summary>
    [Parameter]
    public EventCallback OnSubjectChanged { get; set; }

    /// <summary>Raised with the older and the newer photo when Before and after is picked in the compare view. It shows only when this is set.</summary>
    [Parameter]
    public EventCallback<(Guid Before, Guid After)> OnBeforeAfter { get; set; }

    private sealed record CompareState(IReadOnlyList<Photo> Photos, (Guid First, Guid Second) Start, Guid ViewedId, int? ReturnTo);

    private readonly string referenceId = $"reference-{Guid.NewGuid():N}";
    private readonly string beforeId = $"before-{Guid.NewGuid():N}";
    private readonly string editDateId = $"edit-date-{Guid.NewGuid():N}";

    private IReadOnlyList<(DateOnly Day, IReadOnlyList<TimelineEntry> Entries)>? days;
    private ReceivedHistory? received;
    private IReadOnlyList<(DateOnly Day, IReadOnlyList<ReceivedItem> Items)> beforeDays = [];
    private IReadOnlyList<Photo> photos = [];
    private IReadOnlyList<Photo> references = [];
    private HashSet<Guid> referenceIds = [];
    private HashSet<Guid> earlierIds = [];
    private HashSet<Guid> earlierPhotoIds = [];
    private Dictionary<Guid, int> photoIndex = [];
    private Dictionary<DateOnly, List<ShelfHistoryItem>> shelfByDay = [];

    private bool busy;
    private Guid? confirmDeleteId;
    private int? viewerIndex;
    private CompareState? compare;
    private Guid? editId;
    private string? editText;
    private DateOnly editDay;
    private BringBackChoice editBringBack = new();
    private MeasureDraft editMeasure = new();
    private IReadOnlyDictionary<Guid, IReadOnlyList<Measurement>> measurementsByEntry = new Dictionary<Guid, IReadOnlyList<Measurement>>();
    private string? editError;
    private Guid? versionsId;
    private Guid loadedFor;
    private Guid? openWhenLoaded;

    private DateOnly Today => Time.Today();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor != SubjectId)
        {
            loadedFor = SubjectId;
            openWhenLoaded = null;
            await LoadAsync();
        }
    }

    // The pest cases that still exist, for the links on the lines about a pest. Only read when there is such a line.
    private HashSet<Guid> pestCaseIds = [];

    private async Task LoadAsync()
    {
        var allEntries = await Entries.GetForAsync(SubjectId);
        pestCaseIds = allEntries.Any(e => !e.IsDeleted && e.PestCaseId is not null)
            ? (await PestCases.GetAllAsync()).Where(c => !c.IsDeleted).Select(c => c.Id).ToHashSet()
            : [];
        var allStored = await PhotoRepository.GetForAsync(SubjectId);
        references = PhotoKinds.References(allStored);
        referenceIds = references.Select(p => p.Id).ToHashSet();
        var stored = PhotoKinds.Own(allStored).ToList();

        // An entry that was only reference photos is no longer part of the history
        var entries = allEntries
            .Where(e => !PhotoKinds.OnlyReferences(e, referenceIds))
            .ToList();
        received = await ReceivedHistories.GetForAsync(SubjectId);

        // Newest first like the own history, and the same way round inside a day
        beforeDays = received is null
            ? []
            : received.Items
                .Select((item, index) => (item, index))
                .GroupBy(x => x.item.Day)
                .OrderByDescending(g => g.Key)
                .Select(g => (g.Key, (IReadOnlyList<ReceivedItem>)g.OrderByDescending(x => x.index).Select(x => x.item).ToList()))
                .ToList();

        // The propagation's photo entries, for a plant that was potted up from one
        IReadOnlyList<TimelineEntry> earlier = [];
        var earlierPhotos = new Dictionary<Guid, Photo>();
        if (EarlierPropagationId is { } fromId && EarlierUntil is { } until)
        {
            var cuttingPhotos = await PhotoRepository.GetForAsync(fromId);
            earlier = CarriedPhotos.EarlierEntries(
                await Entries.GetForAsync(fromId), PhotoKinds.References(cuttingPhotos).Select(p => p.Id).ToHashSet(), until, Time);
            earlierPhotos = PhotoKinds.Own(cuttingPhotos).ToDictionary(p => p.Id);
        }
        earlierIds = earlier.Select(e => e.Id).ToHashSet();
        var earlierShown = earlier.SelectMany(e => e.PhotoIds).Where(earlierPhotos.ContainsKey).Distinct().Select(id => earlierPhotos[id]).ToList();
        earlierPhotoIds = earlierShown.Select(p => p.Id).ToHashSet();

        // The viewer pages through photos in the same order as the page shows them: the own entries,
        // the own photos in no entry, then the copied ones as the history before reads
        var byId = stored.ToDictionary(p => p.Id);
        var inTimeline = entries.SelectMany(e => e.PhotoIds).Where(byId.ContainsKey).Distinct().Select(id => byId[id]);
        var inEntries = entries.SelectMany(e => e.PhotoIds).ToHashSet();
        var copied = beforeDays.SelectMany(d => d.Items).SelectMany(i => i.PhotoIds).Where(byId.ContainsKey).Distinct().Select(id => byId[id]);
        photos = inTimeline
            .Concat(stored.Where(p => p.ReceivedHistoryId is null && !inEntries.Contains(p.Id)))
            .Concat(earlierShown)
            .Concat(copied)
            .ToList();
        // The reference photos come last, so the row under the history opens the viewer on them
        photos = [.. photos, .. references];
        photoIndex = photos.Select((p, i) => (p.Id, i)).ToDictionary(x => x.Id, x => x.i);
        days = WithShelfPhotos(TimelineOrder.ByDay(entries.Concat(earlier), Time), await Shelf.HistoryForAsync(SubjectId));
        measurementsByEntry = await MeasureService.ForEntriesAsync(entries.Concat(earlier).Select(e => e.Id));

        // A photo tapped before the photos were here opens as soon as they are
        if (openWhenLoaded is { } waiting)
        {
            openWhenLoaded = null;
            OpenPhoto(waiting);
        }
    }

    // The viewer closes behind the compare view and comes back at the same photo when it is closed
    private void OpenCompare(Photo photo)
    {
        var comparable = Stikling.Core.Timeline.PhotoCompare.Comparable(photos);
        if (Stikling.Core.Timeline.PhotoCompare.StartPair(comparable, photo.Id) is not { } start)
            return;
        compare = new CompareState(comparable, start, photo.Id, viewerIndex);
        viewerIndex = null;
    }

    private void CloseCompare()
    {
        viewerIndex = compare?.ReturnTo;
        compare = null;
    }

    private async Task BeforeAfterAsync((Guid Older, Guid Newer) pair)
    {
        compare = null;
        await OnBeforeAfter.InvokeAsync((pair.Older, pair.Newer));
    }

    private sealed record Row(DateTimeOffset At, TimelineEntry? Entry, ShelfHistoryItem? Shelf);

    // The days of the history, with the days of the shelf photos this is marked in added. A shelf photo
    // is not an entry, so it stays out of the viewer, the cover and everything else that goes by entries.
    private IReadOnlyList<(DateOnly Day, IReadOnlyList<TimelineEntry> Entries)> WithShelfPhotos(
        IReadOnlyList<(DateOnly Day, IReadOnlyList<TimelineEntry> Entries)> own, IReadOnlyList<ShelfHistoryItem> shots)
    {
        shelfByDay = shots.GroupBy(s => LocalDay(s.Photo.TakenAt)).ToDictionary(g => g.Key, g => g.ToList());
        if (shelfByDay.Count == 0)
            return own;

        var merged = own.ToList();
        foreach (var day in shelfByDay.Keys.Where(d => own.All(o => o.Day != d)))
            merged.Add((day, []));
        return [.. merged.OrderByDescending(d => d.Day)];
    }

    // The day's entries and shelf photos, newest first. At the same moment an entry comes before a shelf photo.
    private IEnumerable<Row> RowsOf(DateOnly day, IReadOnlyList<TimelineEntry> entries)
    {
        var rows = entries.Select(e => new Row(e.OccurredAt, e, null));
        if (shelfByDay.TryGetValue(day, out var shots))
            rows = rows.Concat(shots.Select(s => new Row(s.Photo.TakenAt, null, s)));
        return rows.OrderByDescending(r => r.At);
    }

    private IReadOnlyList<Milestone> clearsOnDelete = [];

    private string ClearsText => clearsOnDelete switch
    {
        [] => "",
        [Milestone.FirstLeaf] => " " + Strings.Propagations.TlConfirmClearsFirstLeaf,
        [Milestone.FirstRoot] => " " + Strings.Propagations.TlConfirmClearsFirstRoot,
        _ => " " + Strings.Propagations.TlConfirmClearsBoth
    };

    private async Task AskDeleteAsync(TimelineEntry entry)
    {
        clearsOnDelete = entry.SubjectType == SubjectType.Propagation
            ? await PropagationService.UndoneByDeleteAsync(entry)
            : [];
        confirmDeleteId = entry.Id;
    }

    private async Task DeleteEntryAsync(TimelineEntry entry)
    {
        confirmDeleteId = null;
        foreach (var photoId in entry.PhotoIds)
            await RemovePhotoAsync(photoId);
        IReadOnlyList<Milestone> cleared = [];
        if (entry.SubjectType == SubjectType.Propagation)
            cleared = await PropagationService.DeleteEntryAsync(entry);
        else
            await Entries.DeleteAsync(entry.Id);
        await TimelineService.RemoveMeasurementsAsync(entry.Id);
        await LoadAsync();
        await OnMeasurementsChanged.InvokeAsync();
        if (cleared.Count > 0)
            await OnSubjectChanged.InvokeAsync();
    }

    private async Task DeletePhotoAsync(Photo photo)
    {
        await RemovePhotoAsync(photo.Id);
        await TimelineService.RemoveEmptiedEntriesAsync(SubjectId, photo.Id);
        await LoadAsync();
        await OnMeasurementsChanged.InvokeAsync();
        viewerIndex = photos.Count == 0 ? null : Math.Min(viewerIndex ?? 0, photos.Count - 1);
    }

    private async Task RemovePhotoAsync(Guid photoId)
    {
        await Photos.DeleteAsync(photoId);
        if (photoId == CoverPhotoId)
            await OnCoverChanged.InvokeAsync(null);
    }

    private void StartEdit(TimelineEntry entry)
    {
        editId = entry.Id;
        editText = MeasuredEntries.IsMeasured(entry) ? null : entry.Text;
        editMeasure = MeasureDraft.For(measurementsByEntry.GetValueOrDefault(entry.Id) ?? []);
        editDay = LocalDay(entry.OccurredAt);
        editBringBack = BringBackChoice.For(entry.ComesBackOn);
        editError = null;
        confirmDeleteId = null;
    }

    private void CancelEdit()
    {
        editId = null;
        editError = null;
    }

    // A note or a photo entry needs its text or photos, or measurements to stay as an entry of its own. An entry of measurements keeps at least one.
    private bool CanSaveEdit(TimelineEntry entry, int photoCount)
    {
        if (MeasuredEntries.IsMeasured(entry))
            return editMeasure.HasInput;
        var hasContent = photoCount > 0 || !string.IsNullOrWhiteSpace(editText);
        if (!hasContent)
            return editMeasure.HasInput;
        return entry.Kind != TimelineKind.Note || editBringBack.IsValid(editDay, Today, entry.ComesBackOn);
    }

    private async Task SaveEditAsync(TimelineEntry entry)
    {
        busy = true;
        try
        {
            var values = editMeasure.Values(out var measureError);
            if (values is null)
            {
                editError = measureError;
                return;
            }

            await MeasureService.CheckAsync(entry, values);
            await TimelineService.CorrectAsync(entry, editText, editDay, keepsMeasurements: values.Count > 0);
            await MeasureService.SetForEntryAsync(entry, values);
            if (entry.Kind == TimelineKind.Note || entry.ComesBackOn is not null)
                await TimelineService.SetComesBackAsync(entry, editBringBack.Resolve(editDay, Today));
            CancelEdit();
            await OnMeasurementsChanged.InvokeAsync();
        }
        catch (ArgumentException ex)
        {
            // The rule's own message, without " (Parameter 'day')"
            editError = ex.Message.Split(" (Parameter")[0];
        }
        catch (InvalidOperationException ex)
        {
            editError = ex.Message;
        }
        finally
        {
            busy = false;
        }

        await LoadAsync();
    }

    private DateOnly LocalDay(DateTimeOffset moment) => Time.LocalDay(moment);

    private Task SetCoverAsync(Photo photo) => OnCoverChanged.InvokeAsync(photo.Id);

    private async Task SetReferenceAsync(Photo photo)
    {
        await Photos.SetReferenceAsync(photo, !photo.IsReference);
        // A photo added as a reference has no entry, so back in the history it needs one to show
        await TimelineService.EnsureOnHistoryAsync(photo);
        viewerIndex = null;
        await LoadAsync();
        // A reference photo can't be the cover, so the newest photo left in the history takes over.
        // A photo coming back to a page with no cover becomes it.
        if (photo.IsReference && photo.Id == CoverPhotoId)
            await OnCoverChanged.InvokeAsync(photos.Where(p => !p.IsReference).MaxBy(p => p.TakenAt)?.Id);
        else if (!photo.IsReference && CoverPhotoId is null)
            await OnCoverChanged.InvokeAsync(photo.Id);
    }

    private Task FrameAsync((Photo Photo, PhotoFrame? Frame) change) => Photos.SetFrameAsync(change.Photo, change.Frame);

    /// <summary>
    /// Opens a photo full screen, e.g. the cover when it's tapped at the top of the page. Before
    /// the photos have loaded it opens once they have.
    /// </summary>
    public void OpenPhoto(Guid photoId)
    {
        if (days is null)
        {
            openWhenLoaded = photoId;
            return;
        }

        if (photoIndex.TryGetValue(photoId, out var index))
        {
            viewerIndex = index;
            StateHasChanged();
        }
    }

    private string DayLabel(DateOnly day) =>
        day == Today ? Strings.Propagations.TlToday
        : day == Today.AddDays(-1) ? Strings.Propagations.TlYesterday
        : Labels.Date(day);

