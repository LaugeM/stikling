@* Scrolls to an element on the page and marks it for a moment, so a result opened from Search shows
   which note or item it meant. Put it on a page with the element's id, once the page has its data. *@
@inject IJSRuntime JS

@code {
    /// <summary>The id of the element, like "entry-…". Nothing happens without one.</summary>
    [Parameter]
    public string? ElementId { get; set; }

    /// <summary>False until the page has what the element is part of.</summary>
    [Parameter]
    public bool Ready { get; set; } = true;

    private string? shownFor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Ready || string.IsNullOrEmpty(ElementId) || shownFor == ElementId)
            return;

        shownFor = ElementId;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
            await module.InvokeVoidAsync("showFound", ElementId);
        }
        catch (JSException)
        {
            // Not finding the spot only loses the highlight
        }
    }
}
