@* A plant as a tile with a large square photo, for grids. In select mode the tile is a checkbox instead of a link.
   Anything in ChildContent is shown as the last line. *@
@inject PlantNameService Names

@if (Selectable)
{
    <label class="plant-tile selectable @(Selected ? "selected" : null) @(Faded ? "faded" : null)">
        <input type="checkbox" class="form-check-input tile-check" checked="@Selected" @onchange="() => OnToggle.InvokeAsync(Plant)" />
        @Content
    </label>
}
else
{
    <a class="plant-tile @(Faded ? "faded" : null)" href="@(Href ?? $"plants/{Plant.Id}")">
        @Content
    </a>
}

@code {
    [Parameter, EditorRequired]
    public required Plant Plant { get; set; }

    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<Plant> OnToggle { get; set; }

    /// <summary>Open pest cases covering this plant.</summary>
    [Parameter]
    public IReadOnlyList<PestCase> Pests { get; set; } = [];

    /// <summary>In flower or in bud now, for the badge.</summary>
    [Parameter]
    public FloweringNow? Flowering { get; set; }

    /// <summary>The plant has a problem that isn't over, for the badge.</summary>
    [Parameter]
    public bool OpenProblem { get; set; }

    /// <summary>Where the tile links to. Defaults to the plant's page.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Shown at 60% opacity, for plants that died or left.</summary>
    [Parameter]
    public bool Faded { get; set; }

    /// <summary>An extra last line, in meta style.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private EverydayNameBook? everyday;

    // Read once for the whole app, so a long grid doesn't wait on it
    protected override async Task OnInitializedAsync() => everyday = await Names.GetEverydayNamesAsync();

    private bool HasBadges =>
        Plant.Status != PlantStatus.Active || Plant.InQuarantine || Plant.IsDormant || Plant.IsOffered || Pests.Count > 0 || (OpenProblem && Plant.Status == PlantStatus.Active) || ShowsFlowering(out _);

    private bool ShowsFlowering(out FloweringNow now)
    {
        now = Flowering!;
        return Flowering is { Stale: false } && Plant.Status == PlantStatus.Active;
    }

    private RenderFragment Content => @<text>
        <div class="tile-photo potted" aria-hidden="true">
            @if (Plant.CoverPhotoId is { } coverId)
            {
                <PhotoImage PhotoId="coverId" />
            }
            else
            {
                <svg viewBox="0 0 24 24"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
            }
        </div>

        <div class="tile-text">
            <div class="item-name @(Plant.Favourite ? "has-star" : null)">
                <span class="item-name-text">@Plant.DisplayName</span>
                @if (Plant.Favourite)
                {
                    <svg class="favourite-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8Z" /></svg>
                    <span class="visually-hidden">Favourite</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Plant.Nickname) && Plant.BotanicalName is { } botanical)
            {
                <div class="item-sub">@botanical</div>
            }
            else if (everyday?.For(Plant.Genus, Plant.Species, Plant.Cultivar) is { } called)
            {
                <div class="item-sub everyday-name">@called</div>
            }
            @if (HasBadges)
            {
                <div class="tile-badges">
                    @if (Plant.Status != PlantStatus.Active)
                    {
                        <span class="badge text-bg-secondary">@Labels.For(Plant.Status)</span>
                    }
                    @if (Plant.InQuarantine)
                    {
                        <span class="badge quarantine-badge">Quarantine</span>
                    }
                    @if (Plant.IsDormant && Plant.Status == PlantStatus.Active)
                    {
                        <span class="badge dormant-badge">Dormant</span>
                    }
                    @if (ShowsFlowering(out var flowering))
                    {
                        <span class="badge flowering-badge">@FloweringText.Badge(flowering.Stage)</span>
                    }
                    @if (Plant.IsOffered && Plant.Spare is { } spare)
                    {
                        <span class="badge swap-badge">@SwapLists.MarkText(spare)</span>
                    }
                    @foreach (var pest in Pests)
                    {
                        <span class="badge pest-badge">@Labels.For(pest.Pest)</span>
                    }
                    @if (OpenProblem && Plant.Status == PlantStatus.Active)
                    {
                        <span class="badge problem-badge"><svg viewBox="0 0 24 24" aria-hidden="true">@ProblemIcons.WiltingLeaf</svg>Problem</span>
                    }
                </div>
            }
            @if (ChildContent is not null)
            {
                <div class="tile-meta">@ChildContent</div>
            }
        </div>
    </text>;
}
