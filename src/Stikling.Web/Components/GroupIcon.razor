@* The paths of a stroked icon for a group of the plant dictionary, for the Icon of a SettingsRow or inside an svg *@
@switch (Group)
{
    case DictionaryGroup.Aroids:
        <path d="M12 21C7 17.5 4 14 4 10a4.5 4.5 0 0 1 8-2.5A4.5 4.5 0 0 1 20 10c0 4-3 7.5-8 11Z" /><path d="M12 21V8" />
        break;
    case DictionaryGroup.PrayerPlants:
        <path d="M12 3c3.500 3 5 6.500 5 10s-2.200 6.500-5 8c-2.800-1.500-5-4.500-5-8s1.500-7 5-10Z" /><path d="M12 21V7M12 11 9 9M12 11l3-2M12 15l-3-2M12 15l3-2" />
        break;
    case DictionaryGroup.Begonias:
        <path d="M6 19C4 12 7 5 15 4c3 3 5 7 4 10-1 3.500-5.500 5.500-13 5Z" /><path d="M6 19 14 10M10 14.500 9 10.500M12.500 12 16.500 12.500" />
        break;
    case DictionaryGroup.Carnivorous:
        <path d="M7 4.500h10" /><path d="M8 4.500c0 6-2 8-2 10.500a6 6 0 0 0 12 0c0-2.500-2-4.500-2-10.500" />
        break;
    case DictionaryGroup.Cacti:
        <path d="M10 21V6a2 2 0 0 1 4 0v15" /><path d="M10 14H8a2 2 0 0 1-2-2V9" /><path d="M14 11h2a2 2 0 0 0 2-2V7" /><path d="M7 21h10" />
        break;
    case DictionaryGroup.Succulents:
        @for (var i = 0; i < 5; i++)
        {
            <path d="M12 12C9.800 9.800 9.800 6 12 4c2.200 2 2.200 5.800 0 8Z" transform="@($"rotate({i * 72} 12 12)")" />
        }
        break;
    case DictionaryGroup.Orchids:
        <path d="M12 12C10 8.500 10 5.500 12 3c2 2.500 2 5.500 0 9Z" /><path d="M12 12C8 11 5 9 4.500 6.500 8 6 11 8 12 12Z" /><path d="M12 12c4-1 7-3 7.500-5.500C16 6 13 8 12 12Z" /><path d="M12 12c-2.500 1-3.500 3.500-3 6 1.500 1.500 4.500 1.500 6 0 .5-2.500-.5-5-3-6Z" />
        break;
    case DictionaryGroup.Bromeliads:
        <path d="M12 21c-1.500-4-2-9 0-17 2 8 1.500 13 0 17Z" /><path d="M12 21C8.500 18 6.500 13 6 7c3 2 5.500 6 6 14Z" /><path d="M12 21c3.500-3 5.500-8 6-14-3 2-5.500 6-6 14Z" /><path d="M12 21c-4-1-7-3.500-9-7 3.500 0 7 2.500 9 7Z" /><path d="M12 21c4-1 7-3.500 9-7-3.500 0-7 2.500-9 7Z" />
        break;
    default:
        @Icons.Sprout
        break;
}

@code {
    [Parameter, EditorRequired]
    public DictionaryGroup Group { get; set; }
}
