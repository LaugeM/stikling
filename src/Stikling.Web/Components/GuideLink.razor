@* A quiet link to a guide from the place it is about, with a stroked open book in front. *@

@if (guide is not null || (Guide.Length == 0 && Text is not null))
{
    <a class="guide-link" href="@(guide is null ? GuideLinks.Index : GuideLinks.Href(guide.Id, From))" target="@(NewTab ? "_blank" : null)" rel="@(NewTab ? "noopener" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Book</svg>
        <span>@(Text ?? GuideLinks.Text(guide!.LinkKey))</span>
    </a>
}

@code {
    /// <summary>The id of the guide, or nothing for a link to the list of guides, which needs <see cref="Text"/>.</summary>
    [Parameter]
    public string Guide { get; set; } = "";

    /// <summary>Where the guide is opened from, see <see cref="GuideLinks.Href"/>.</summary>
    [Parameter]
    public string? From { get; set; }

    /// <summary>The words of the link, when they are not the guide's own.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Opens the guide in a new tab, for links inside a form, so what has been typed is not lost.</summary>
    [Parameter]
    public bool NewTab { get; set; }

    private Guide? guide => GuideBook.Find(Guide);
}
