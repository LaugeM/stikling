@* The sheet behind a page's Share link: the card as it will be posted, a choice of size and photo,
   and the words on it, which the app writes and the person can change. Nothing about a card is saved.
   The picture is drawn by ShareCardService, which keeps it in JavaScript. A time-lapse video is made
   by TimelapseService, which keeps it there too. Link mode is the exception: it turns on a public page
   for the plant, and the settings of that page (the notes switch, the photos left off, the words) are
   saved to the link on the server through ShareLinkService, never on the device. *@
@using System.Globalization
@using System.Text.Json
@using Stikling.Core.Sync
@implements IAsyncDisposable
@inject ShareCardService Cards
@inject TimelapseService Timelapse
@inject IPhotoRepository PhotoRepository
@inject SyncRunner Sync
@inject ShareLinkService Links
@inject AccountService Account
@inject NavigationManager Navigation
@inject TimeProvider Time

<Sheet Title="Share" Open="Open" OpenChanged="OpenChanged">
    @if (ready)
    {
        @if (mode == ShareMode.Link)
        {
            <div class="share-page-preview">
                <div class="share-page-cover">
                    @if (PreviewPhoto is { } cover)
                    {
                        <PhotoImage PhotoId="cover.Id" Framed="false" />
                    }
                </div>
                <div class="share-page-words">
                    <div class="share-page-name">@PreviewName</div>
                    @if (Text.Latin is not null || Text.Cultivar is not null)
                    {
                        <div class="share-page-latin">
                            @if (Text.Latin is not null)
                            {
                                <i>@Text.Latin</i>
                            }
                            @if (Text.Cultivar is not null)
                            {
                                <span>@(Text.Latin is null ? null : " ")'@Text.Cultivar'</span>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(PreviewLine))
                    {
                        <div class="share-page-line">@PreviewLine</div>
                    }
                    <div class="share-page-count">@Labels.Count(PhotosOnPage, "photo")</div>
                </div>
            </div>
        }
        else
        {
            <div class="share-preview">
                <canvas @ref="canvas" width="1080" height="@PreviewHeight" role="img"
                        aria-label="@($"Preview of the {(mode == ShareMode.Timelapse ? "time-lapse" : "card")} for {CardName}")"></canvas>
            </div>
        }
        @if (mode == ShareMode.Timelapse && reducedMotion && UsablePhotos.Count >= 2 && videoState != VideoState.Making)
        {
            <div class="share-field">
                <button type="button" class="btn btn-outline-primary" @onclick="TogglePlay">@(previewPlaying ? "Stop preview" : "Play preview")</button>
            </div>
        }

        @if (allPhotos.Count >= 2 || LinkAvailable)
        {
            <div class="share-field">
                <div class="share-label" id="share-mode-label">Card</div>
                <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="share-mode-label">
                    <input type="radio" class="btn-check" name="share-mode" id="share-mode-one"
                           checked="@(mode == ShareMode.One)" @onchange="() => SetModeAsync(ShareMode.One)" disabled="@Making" />
                    <label class="btn btn-outline-primary" for="share-mode-one">One photo</label>
                    @if (allPhotos.Count >= 2)
                    {
                        <input type="radio" class="btn-check" name="share-mode" id="share-mode-pair"
                               checked="@(mode == ShareMode.Pair)" @onchange="() => SetModeAsync(ShareMode.Pair)" disabled="@Making" />
                        <label class="btn btn-outline-primary" for="share-mode-pair">Before and after</label>
                    }
                    @if (allPhotos.Count >= 3)
                    {
                        <input type="radio" class="btn-check" name="share-mode" id="share-mode-timelapse"
                               checked="@(mode == ShareMode.Timelapse)" @onchange="() => SetModeAsync(ShareMode.Timelapse)" disabled="@Making" />
                        <label class="btn btn-outline-primary" for="share-mode-timelapse">Time-lapse</label>
                    }
                    @if (LinkAvailable)
                    {
                        <input type="radio" class="btn-check" name="share-mode" id="share-mode-link"
                               checked="@(mode == ShareMode.Link)" @onchange="() => SetModeAsync(ShareMode.Link)" disabled="@Making" />
                        <label class="btn btn-outline-primary" for="share-mode-link">Link</label>
                    }
                </div>
            </div>
        }

        @if (mode != ShareMode.Link)
        {
            <div class="share-field">
                <div class="share-label" id="share-format-label">Size</div>
                <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="share-format-label">
                    @foreach (var (value, label) in ShareCardService.Formats)
                    {
                        var id = $"share-format-{value}";
                        <input type="radio" class="btn-check" name="share-format" id="@id"
                               checked="@(ActiveFormat == value)" @onchange="() => SetFormatAsync(value)" disabled="@Making" />
                        <label class="btn btn-outline-primary" for="@id">@label</label>
                    }
                </div>
            </div>
        }

        @if (mode == ShareMode.Link)
        {
            @LinkPanel
        }
        else if (mode == ShareMode.Timelapse)
        {
            <div class="share-field">
                <div class="share-label" id="share-speed-label">Speed</div>
                <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="share-speed-label">
                    @foreach (var (value, label) in Speeds)
                    {
                        var id = $"share-speed-{value}";
                        <input type="radio" class="btn-check" name="share-speed" id="@id"
                               checked="@(speed == value)" @onchange="() => SetSpeedAsync(value)" disabled="@Making" />
                        <label class="btn btn-outline-primary" for="@id">@label</label>
                    }
                </div>
            </div>

            <div class="share-field">
                <div class="share-label" id="share-ticks-label">Photos in the video</div>
                <div class="share-photos" role="group" aria-labelledby="share-ticks-label">
                    @foreach (var photo in RowPhotos)
                    {
                        var ticked = !leftOut.Contains(photo.Id);
                        <button type="button" role="checkbox" aria-checked="@(ticked ? "true" : "false")"
                                aria-label="@($"Photo from {DayText(photo)}")" class="share-photo @(ticked ? "ticked" : "left-out")"
                                @onclick="() => ToggleTick(photo.Id)" disabled="@Making">
                            <PhotoImage PhotoId="photo.Id" Framed="false" />
                            @if (ticked)
                            {
                                <svg class="share-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12.5l4 4 8-9" /></svg>
                            }
                        </button>
                    }
                </div>
                <p class="form-text mb-0">@TickedPhotos.Count of @allPhotos.Count photos are in the video. Tap one to leave it out.</p>
                @if (TooLong)
                {
                    <p class="form-text mb-0">It has @allPhotos.Count photos, and a time-lapse takes up to @TimelapsePlan.MaxPhotos, so @TimelapsePlan.MaxPhotos spread over them are picked.</p>
                    <button type="button" class="btn btn-link btn-sm link-action ps-0" aria-expanded="@(showAllPhotos ? "true" : "false")"
                            @onclick="() => showAllPhotos = !showAllPhotos">@(showAllPhotos ? "Show only the photos in the video" : $"Show all {allPhotos.Count} photos")</button>
                }
                @if (tickNote is not null)
                {
                    <p class="form-text mb-0" role="status">@tickNote</p>
                }
                @if (MissingCount > 0)
                {
                    <p class="form-text mb-0">@(MissingCount == 1 ? "One photo isn't" : $"{MissingCount} photos aren't") on this device yet, so @(MissingCount == 1 ? "it is" : "they are") left out of the video.@(UsablePhotos.Count < 2 ? " That leaves too few to make one." : "")</p>
                }
                @if (SmallCount > 0 && videoState != VideoState.Making)
                {
                    <p class="form-text mb-0">@(SmallCount == 1 ? "One photo is" : $"{SmallCount} photos are") only a small copy on this device. Making the video gets the full @(SmallCount == 1 ? "one" : "ones") first when it can, so the video is sharp.</p>
                }
            </div>
        }
        else if (mode == ShareMode.Pair)
        {
            @foreach (var (label, key, current) in new[] { ("Before", "before", beforeId), ("After", "after", afterId) })
            {
                <div class="share-field">
                    <div class="share-label" id="@($"share-{key}-label")">@label</div>
                    <div class="share-photos" role="radiogroup" aria-labelledby="@($"share-{key}-label")">
                        @foreach (var photo in pairPhotos)
                        {
                            var picked = current == photo.Id;
                            <button type="button" role="radio" aria-checked="@(picked ? "true" : "false")"
                                    aria-label="@($"{label} photo from {DayText(photo)}")" class="share-photo @(picked ? "picked" : null)"
                                    @onclick="() => PickPair(key, photo.Id)">
                                <PhotoImage PhotoId="photo.Id" Framed="false" />
                            </button>
                        }
                    </div>
                </div>
            }
            @if (photoMissing)
            {
                <p class="form-text">One of those photos isn't on this device yet, so its place on the card is empty.</p>
            }
            else if (photoSmall && gettingFull)
            {
                <p class="form-text" role="status">Getting the full photos, so the card is sharp.</p>
            }
            else if (photoSmall)
            {
                <p class="form-text">Only a small copy of one of these photos is on this device, and the full one couldn't be fetched, so it may look blurry on the card. Try again when you're online and signed in, or pick another photo.</p>
            }
        }
        else if (photos.Count > 0)
        {
            <div class="share-field">
                <div class="share-label" id="share-photo-label">Photo</div>
                <div class="share-photos" role="radiogroup" aria-labelledby="share-photo-label">
                    @foreach (var (photo, number) in photos.Select((p, i) => (p, i + 1)))
                    {
                        <button type="button" role="radio" aria-checked="@(photoId == photo.Id ? "true" : "false")"
                                aria-label="@($"Photo {number}")" class="share-photo @(photoId == photo.Id ? "picked" : null)"
                                @onclick="() => photoId = photo.Id">
                            <PhotoImage PhotoId="photo.Id" Framed="false" />
                        </button>
                    }
                    <button type="button" role="radio" aria-checked="@(photoId is null ? "true" : "false")"
                            class="share-photo share-photo-none @(photoId is null ? "picked" : null)" @onclick="() => photoId = null">
                        No photo
                    </button>
                </div>
                @if (photoMissing)
                {
                    <p class="form-text">That photo isn't on this device yet, so the card uses the number instead.</p>
                }
                else if (photoSmall && gettingFull)
                {
                    <p class="form-text" role="status">Getting the full photo, so the card is sharp.</p>
                }
                else if (photoSmall)
                {
                    <p class="form-text">Only a small copy of this photo is on this device, and the full one couldn't be fetched, so it may look blurry on the card. Try again when you're online and signed in, or pick another photo.</p>
                }
            </div>
        }

        @if (mode != ShareMode.Link)
        {
            @WordsFields
        }

        @if (mode == ShareMode.Link)
        {
            @* Everything for the link is in the panel above *@
        }
        else if (mode == ShareMode.Timelapse)
        {
            @if (videoState == VideoState.Making)
            {
                <div class="share-progress-box">
                    <p class="form-text mb-1" role="status">@phase</p>
                    <progress class="share-progress" max="1" value="@ProgressValue" aria-label="Making the video"></progress>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline-primary" disabled="@cancelRequested" @onclick="CancelVideoAsync">Cancel</button>
                </div>
            }
            else if (VideoIsReady)
            {
                <div class="form-actions">
                    @if (canShareVideo)
                    {
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ShareVideoAsync">Share video</button>
                        <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="SaveVideoAsync">Save video</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveVideoAsync">Save video</button>
                    }
                </div>
            }
            else
            {
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(UsablePhotos.Count < 2)" @onclick="MakeVideoAsync">Make video</button>
                </div>
            }
        }
        else
        {
            <div class="form-actions">
                @if (canShare)
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ShareAsync">Share</button>
                    <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="SaveAsync">Save image</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">Save image</button>
                }
            </div>
        }

        @if (message is not null)
        {
            <p class="action-message mt-2 mb-0" role="status">@message</p>
        }
    }
</Sheet>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>What the app would write on the card.</summary>
    [Parameter, EditorRequired]
    public required ShareCardText Text { get; set; }

    /// <summary>"plant" or "propagation".</summary>
    [Parameter, EditorRequired]
    public required string Tone { get; set; }

    [Parameter, EditorRequired]
    public Guid SubjectId { get; set; }

    /// <summary>The day photos count from (day 0). Without it, dates have no day count.</summary>
    [Parameter]
    public DateOnly? DayOne { get; set; }

    /// <summary>The photo the card starts with, when there is one.</summary>
    [Parameter]
    public Guid? CoverPhotoId { get; set; }

    /// <summary>When both are set, the sheet opens on Before and after with these two photos picked.</summary>
    [Parameter]
    public Guid? StartBeforeId { get; set; }

    [Parameter]
    public Guid? StartAfterId { get; set; }

    /// <summary>The line for the starting pair, in place of how far apart the photos are. Picking other photos goes back to the count.</summary>
    [Parameter]
    public string? StartLine { get; set; }

    private enum ShareMode { One, Pair, Timelapse, Link }

    private enum VideoState { Idle, Making, Done }

    private static readonly (TimelapseSpeed Value, string Label)[] Speeds =
    [
        (TimelapseSpeed.Slow, "Slow"),
        (TimelapseSpeed.Normal, "Normal"),
        (TimelapseSpeed.Fast, "Fast"),
    ];

    private const string VideoFailed = "The video couldn't be made. Try again, or leave out some photos.";

    private ElementReference canvas;
    private IReadOnlyList<Photo> photos = [];
    private IReadOnlyList<Photo> allPhotos = [];
    private IReadOnlyList<Photo> pairPhotos = [];
    private ShareMode mode;
    private Guid? beforeId;
    private Guid? afterId;
    private string format = "square";
    private Guid? photoId;
    private string name = "";
    private string line = "";
    private bool ready;
    private bool canShare;
    private bool busy;
    private bool photoMissing;
    private bool photoSmall;
    private bool gettingFull;
    private readonly HashSet<Guid> triedFull = [];
    private string? message;
    private string? drawnKey;
    private bool wasOpen;

    // The time-lapse. Its size and speed are remembered on their own, apart from the card's size.
    private string videoFormat = "story";
    private TimelapseSpeed speed = TimelapseSpeed.Normal;
    private readonly HashSet<Guid> leftOut = [];
    private HashSet<Guid> smallIds = [];
    private HashSet<Guid> missingIds = [];
    private VideoState videoState;
    private double? progress;
    private string? phase;
    private string? tickNote;
    private string? madeKey;
    private string? previewKey;
    private bool cancelRequested;
    private bool showAllPhotos;
    private bool canShareVideo;
    private bool reducedMotion;
    private bool previewPlaying;
    private int makeRun;

    // The link. Its settings are kept on the server; these are the sheet's working copy of them.
    private bool canShareLink;
    private bool showNotes = true;
    private readonly HashSet<Guid> linkLeftOut = [];
    private Guid? linkLoadedFor;
    private string? cardName;
    private string? cardLine;
    private bool makingLink;
    private bool confirmingOff;
    private bool copied;
    private bool linkSaved;
    private string? linkError;
    private int waitingPhotos;

    // Links need an account, so they are only offered where signing in is
    private bool LinkAvailable => Account.IsAvailable;

    private ShareLinkInfo? Link => Links.For(SubjectId);

    private SubjectType LinkSubject => Tone == "propagation" ? SubjectType.Propagation : SubjectType.Plant;

    private int PhotosOnPage => allPhotos.Count(p => !linkLeftOut.Contains(p.Id));

    // The cover when it is on the page, otherwise the newest photo that is
    private Photo? PreviewPhoto
    {
        get
        {
            var shown = allPhotos.Where(p => !linkLeftOut.Contains(p.Id)).ToList();
            return shown.FirstOrDefault(p => p.Id == CoverPhotoId) ?? shown.LastOrDefault();
        }
    }

    // Before there is a link, the page would say what the app says
    private string PreviewName => Link is null ? Text.Name : CardName;

    private string? PreviewLine => Link is null ? Text.Line : line;

    private string ActiveFormat => mode == ShareMode.Timelapse ? videoFormat : format;

    // The first draw can't know the size yet, so the preview keeps the shape of the card
    private int PreviewHeight => ActiveFormat switch { "portrait" => 1350, "story" => 1920, _ => 1080 };

    private string CardName => string.IsNullOrWhiteSpace(name) ? Text.Name : name.Trim();

    private bool Edited => CardName != Text.Name || (line ?? "").Trim() != (DefaultLine ?? "");

    private IReadOnlyList<Photo> TickedPhotos => allPhotos.Where(p => !leftOut.Contains(p.Id)).ToList();

    // Ticked, and on this device in some size
    private IReadOnlyList<Photo> UsablePhotos => TickedPhotos.Where(p => !missingIds.Contains(p.Id)).ToList();

    private int MissingCount => TickedPhotos.Count(p => missingIds.Contains(p.Id));

    private int SmallCount => TickedPhotos.Count(p => smallIds.Contains(p.Id));

    private string ProgressValue => (progress ?? 0).ToString("0.###", CultureInfo.InvariantCulture);

    private bool Making => videoState == VideoState.Making;

    private bool TooLong => allPhotos.Count > TimelapsePlan.MaxPhotos;

    // A long history shows only the photos in the video until asked for all of them, since each thumbnail is read from the device when it is shown
    private IReadOnlyList<Photo> RowPhotos => TooLong && !showAllPhotos ? TickedPhotos : allPhotos;

    private bool VideoIsReady => videoState == VideoState.Done && madeKey == VideoKey(VideoSpec());

    private string VideoFileName => ShareCardService.FileNameFor(CardName, ShareFileKind.Timelapse);

    // What the app would write: the usual line, or how far apart the two photos are
    private string? DefaultLine => mode != ShareMode.Pair ? Text.Line
        : StartLine is not null && beforeId == StartBeforeId && afterId == StartAfterId ? StartLine
        : ApartLine(beforeId, afterId);

    private Photo? PhotoOf(Guid? id) => id is null ? null : allPhotos.FirstOrDefault(p => p.Id == id);

    private string DayText(Photo photo)
    {
        var day = Time.LocalDay(photo.TakenAt);
        return Labels.Date(day) + PhotoDayCount.Suffix(DayOne, day);
    }

    private string? ApartLine(Guid? before, Guid? after)
    {
        if (PhotoOf(before) is not { } a || PhotoOf(after) is not { } b)
            return null;
        var (older, newer) = a.TakenAt <= b.TakenAt ? (a, b) : (b, a);
        return ShareCardText.ApartLine(Time.LocalDay(older.TakenAt), Time.LocalDay(newer.TakenAt));
    }

    protected override void OnInitialized()
    {
        Links.Changed += OnLinksChanged;
        Sync.StatusChanged += OnSyncStatusChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Open == wasOpen)
            return;
        wasOpen = Open;
        if (!Open)
        {
            if (mode == ShareMode.Timelapse)
                await LeaveTimelapseAsync();
            ready = false;
            drawnKey = null;
            return;
        }

        confirmingOff = false;
        copied = false;
        linkSaved = false;
        linkError = null;
        linkLoadedFor = null;
        linkLeftOut.Clear();
        showNotes = true;
        waitingPhotos = 0;
        canShareLink = LinkAvailable && await Cards.CanShareLinkAsync();

        name = Text.Name;
        line = Text.Line ?? "";
        message = null;
        photoMissing = false;
        photoSmall = false;
        mode = ShareMode.One;
        leftOut.Clear();
        smallIds.Clear();
        missingIds.Clear();
        tickNote = null;
        triedFull.Clear();
        format =await Cards.GetFormatAsync();
        canShare = await Cards.CanShareAsync();

        // The cover first, then the newest, so the picture it starts with is the one on the page
        var all = await PhotoRepository.GetForAsync(SubjectId);
        photos = all.OrderByDescending(p => p.Id == CoverPhotoId).Take(40).ToList();
        photoId = photos.FirstOrDefault()?.Id;

        // Oldest first, so the history reads left to right. A very long history keeps its first and last photos.
        allPhotos = all.OrderBy(p => p.TakenAt).ToList();
        // A long history starts with 60 photos spread over it for the time-lapse; the rest are left out
        showAllPhotos = false;
        var starting = TimelapsePlan.Spread(allPhotos.Select(p => new TimelapsePhoto(p.Id, p.TakenAt))).Select(p => p.Id).ToHashSet();
        foreach (var p in allPhotos.Where(p => !starting.Contains(p.Id)))
            leftOut.Add(p.Id);
        pairPhotos = allPhotos.Count <= 60 ? allPhotos : allPhotos.Take(30).Concat(allPhotos.TakeLast(30)).ToList();
        beforeId = allPhotos.FirstOrDefault()?.Id;
        afterId = allPhotos.LastOrDefault()?.Id;
        if (PhotoOf(StartBeforeId) is not null && PhotoOf(StartAfterId) is not null)
        {
            mode = ShareMode.Pair;
            beforeId = StartBeforeId;
            afterId = StartAfterId;
            line = DefaultLine ?? "";
            // A long history leaves out its middle, so make sure the picked photos are there to see
            if (!pairPhotos.Any(p => p.Id == beforeId))
                pairPhotos = pairPhotos.Append(PhotoOf(beforeId)!).OrderBy(p => p.TakenAt).ToList();
        }
        ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open || !ready || mode == ShareMode.Link || canvas.Id is null)
            return;

        if (mode == ShareMode.Timelapse)
        {
            await SyncVideoAsync();
            return;
        }

        var spec = Spec();
        var key = JsonSerializer.Serialize(spec);
        if (key == drawnKey)
            return;
        drawnKey = key;

        if (await Cards.DrawAsync(canvas, spec) is { } drawn)
        {
            var missing = (spec.PhotoId is not null || spec.Pair is not null) && !drawn.Photo;
            if (missing != photoMissing || drawn.Small != photoSmall)
            {
                photoMissing = missing;
                photoSmall = drawn.Small;
                StateHasChanged();
            }

            IReadOnlyList<string> smallIds = spec.Pair is not null ? drawn.SmallPhotos ?? [] : drawn.Small && spec.PhotoId is not null ? [spec.PhotoId] : [];
            foreach (var id in smallIds)
                if (Guid.TryParse(id, out var small))
                    await GetFullPhotoAsync(small);
        }
    }

    // Only the small copy is here, so fetch the full one and draw again, the way opening the photo does
    private async Task GetFullPhotoAsync(Guid id)
    {
        if (gettingFull || triedFull.Contains(id))
            return;

        gettingFull = true;
        triedFull.Add(id);
        StateHasChanged();
        var fetched = await Sync.FetchPhotoAsync(id, PhotoSize.Full);
        gettingFull = false;

        // Draw again unless the sheet was closed meanwhile, which also clears the key
        if (fetched && Open)
            drawnKey = null;
        StateHasChanged();
    }

    private ShareCardSpec Spec()
    {
        if (mode != ShareMode.Pair || PhotoOf(beforeId) is not { } a || PhotoOf(afterId) is not { } b)
            return SinglePhotoSpec();

        // The older photo goes first, whichever way round they were picked
        var (older, newer) = a.TakenAt <= b.TakenAt ? (a, b) : (b, a);
        return SinglePhotoSpec() with
        {
            PhotoId = null,
            Frame = null,
            Pair = new ShareCardPair(Side(older), Side(newer)),
        };
    }

    private ShareCardSide Side(Photo photo) => new(photo.Id.ToString(), photo.Frame, DayText(photo));

    private ShareCardSpec SinglePhotoSpec() => new(
        format,
        Tone,
        CardName,
        Text.Latin,
        Text.Cultivar,
        string.IsNullOrWhiteSpace(line) ? null : line.Trim(),
        Text.Figure,
        photoId?.ToString(),
        photos.FirstOrDefault(p => p.Id == photoId)?.Frame);

    // The card and the video each keep their own size
    private async Task SetFormatAsync(string value)
    {
        if (mode == ShareMode.Timelapse)
        {
            videoFormat = value;
            await Timelapse.SetFormatAsync(value);
        }
        else
        {
            format = value;
            await Cards.SetFormatAsync(value);
        }
    }

    // The line follows the app's words until the person has changed it
    private async Task SetModeAsync(ShareMode value)
    {
        if (mode == value)
            return;
        var leaving = mode;

        // The link edits the name and line in place, so the card's own are kept for coming back
        if (leaving == ShareMode.Link)
        {
            name = cardName ?? name;
            line = cardLine ?? line;
        }
        else if (value == ShareMode.Link)
        {
            cardName = name;
            cardLine = line;
        }

        ChangeKeepingEditedLine(() => mode = value);
        photoMissing = false;
        photoSmall = false;
        message = null;

        if (leaving == ShareMode.Link)
            drawnKey = null;
        if (leaving == ShareMode.Timelapse)
            await LeaveTimelapseAsync();
        if (value == ShareMode.Timelapse)
            await EnterTimelapseAsync();
        if (value == ShareMode.Link)
            await EnterLinkAsync();
    }

    // ---- The link ----

    private async Task EnterLinkAsync()
    {
        confirmingOff = false;
        copied = false;
        linkSaved = false;
        linkError = null;
        linkLoadedFor = null;
        LoadLinkSettings();
        await RefreshWaitingAsync();
    }

    // The working copy comes from the link when the sheet first sees it. Later changes from other devices don't replace what is being edited.
    private void LoadLinkSettings()
    {
        if (Link is not { } link)
        {
            linkLoadedFor = null;
            return;
        }

        if (linkLoadedFor == link.Id)
            return;
        linkLoadedFor = link.Id;
        showNotes = link.ShowNotes;
        linkLeftOut.Clear();
        foreach (var id in link.LeftOutPhotoIds)
            linkLeftOut.Add(id);
        name = link.Name ?? Text.Name;
        line = link.Line ?? Text.Line ?? "";
    }

    private void OnLinksChanged()
    {
        if (!Open || mode != ShareMode.Link)
            return;

        _ = InvokeAsync(() =>
        {
            LoadLinkSettings();
            StateHasChanged();
        });
    }

    private void OnSyncStatusChanged()
    {
        if (!Open || mode != ShareMode.Link || Sync.Running)
            return;

        _ = InvokeAsync(async () =>
        {
            await RefreshWaitingAsync();
            StateHasChanged();
        });
    }

    // Photos that haven't reached the server show on the page once they have
    private async Task RefreshWaitingAsync()
    {
        try
        {
            waitingPhotos = await Sync.CountPhotosWaitingAsync(allPhotos.Select(p => p.Id).ToList());
        }
        catch (JSException)
        {
            waitingPhotos = 0;
        }
    }

    // The page has to be on the server before it can be shown from there, so the plant is synced first
    private async Task MakeLinkAsync()
    {
        makingLink = true;
        linkError = null;
        copied = false;
        StateHasChanged();
        try
        {
            await Sync.SyncNowAsync();
            var result = await Links.CreateAsync(LinkSubject, SubjectId, TimeZoneInfo.Local.Id, showNotes);
            if (result.Ok)
            {
                linkLoadedFor = null;
                LoadLinkSettings();
            }
            else
            {
                linkError = result.Offline ? "Connect to the internet to make a link." : result.Problem;
            }
        }
        finally
        {
            makingLink = false;
        }

        await RefreshWaitingAsync();
    }

    private async Task SaveLinkAsync()
    {
        if (Link is not { } link)
            return;

        linkError = null;
        linkSaved = false;
        copied = false;
        var result = await Links.UpdateAsync(link, showNotes, OwnWords(name, Text.Name), OwnWords(line, Text.Line), linkLeftOut.ToList(), TimeZoneInfo.Local.Id);
        if (result.Ok)
            linkSaved = true;
        else
            linkError = result.Offline ? "Couldn't save. Connect to the internet and try again." : result.Problem;
    }

    // The words are only saved to the link when they differ from the app's, so the page keeps following the app's as the plant changes
    private static string? OwnWords(string? written, string? appsWords)
    {
        var clean = ShareLinkRules.Clean(written);
        return clean is null || clean == appsWords ? null : clean;
    }

    private async Task WordsChangedAsync()
    {
        if (mode == ShareMode.Link)
            await SaveLinkAsync();
    }

    private async Task SetShowNotesAsync(ChangeEventArgs e)
    {
        showNotes = e.Value is true;
        await SaveLinkAsync();
    }

    private async Task ToggleLinkTickAsync(Guid id)
    {
        if (!linkLeftOut.Remove(id))
            linkLeftOut.Add(id);
        await SaveLinkAsync();
    }

    private async Task ShareLinkAsync()
    {
        if (Link is not { } link)
            return;

        copied = false;
        linkError = null;
        if (await Cards.ShareLinkAsync(PreviewName, link.Url) == "failed")
            linkError = "The share menu couldn't be opened. Copy the link instead.";
    }

    private async Task CopyLinkAsync()
    {
        if (Link is not { } link)
            return;

        linkError = null;
        copied = await Cards.CopyTextAsync(link.Url);
        if (!copied)
            linkError = "The link couldn't be copied. Select it and copy it by hand.";
    }

    private async Task TurnOffLinkAsync()
    {
        if (Link is not { } link)
            return;

        var result = await Links.TurnOffAsync(link);
        if (!result.Ok)
        {
            linkError = result.Offline ? "Connect to the internet to turn off the link." : result.Problem;
            return;
        }

        confirmingOff = false;
        linkError = null;
        linkSaved = false;
        copied = false;
        linkLoadedFor = null;
        linkLeftOut.Clear();
        showNotes = true;
        name = cardName ?? Text.Name;
        line = cardLine ?? Text.Line ?? "";
    }

    private async Task SignInAsync()
    {
        await OpenChanged.InvokeAsync(false);
        Navigation.NavigateTo("sign-in");
    }

    private RenderFragment LinkPanel => @<text>
        @if (!Sync.SignedIn)
        {
            <p class="share-link-note">A link opens a page that anyone can see, with this @Tone's photos. It needs an account, because the page is shown from the server.</p>
            <div class="form-actions">
                <button type="button" class="btn btn-primary" @onclick="SignInAsync">Sign in</button>
            </div>
        }
        else if (Link is not { } link)
        {
            <p class="share-link-note">The page shows this @Tone's photos and, if you leave it on, its notes. It never shows the room, prices or where it came from.</p>
            <div class="form-check form-switch share-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="share-notes" checked="@showNotes" @onchange="e => showNotes = e.Value is true" disabled="@makingLink" />
                <label class="form-check-label" for="share-notes">Show my notes</label>
            </div>
            @UploadingNote
            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@makingLink" @onclick="MakeLinkAsync">@(makingLink ? "Making the link…" : "Make link")</button>
            </div>
            @LinkMessages
        }
        else
        {
            <div class="share-field">
                <div class="share-label" id="share-link-label">The link</div>
                <p class="share-link-url" aria-labelledby="share-link-label">@link.Url</p>
                <div class="form-actions">
                    @if (canShareLink)
                    {
                        <button type="button" class="btn btn-primary" @onclick="ShareLinkAsync">Share link</button>
                        <button type="button" class="btn btn-outline-primary" @onclick="CopyLinkAsync">Copy link</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="CopyLinkAsync">Copy link</button>
                    }
                    <a class="btn btn-link link-action" href="@link.Url" target="_blank" rel="noopener">Open the page</a>
                </div>
                @if (copied)
                {
                    <p class="form-text mb-0" role="status">Copied</p>
                }
            </div>

            <div class="form-check form-switch share-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="share-notes" checked="@showNotes" @onchange="SetShowNotesAsync" />
                <label class="form-check-label" for="share-notes">Show my notes</label>
            </div>

            <div class="share-field">
                <div class="share-label" id="share-link-ticks-label">Photos on the page</div>
                <div class="share-photos" role="group" aria-labelledby="share-link-ticks-label">
                    @foreach (var photo in allPhotos)
                    {
                        var ticked = !linkLeftOut.Contains(photo.Id);
                        <button type="button" role="checkbox" aria-checked="@(ticked ? "true" : "false")"
                                aria-label="@($"Photo from {DayText(photo)}")" class="share-photo @(ticked ? "ticked" : "left-out")"
                                @onclick="() => ToggleLinkTickAsync(photo.Id)">
                            <PhotoImage PhotoId="photo.Id" Framed="false" />
                            @if (ticked)
                            {
                                <svg class="share-tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12.5l4 4 8-9" /></svg>
                            }
                        </button>
                    }
                </div>
                <p class="form-text mb-0">@PhotosOnPage of @allPhotos.Count photos are on the page. Tap one to leave it off.</p>
                @UploadingNote
            </div>

            @WordsFields

            @LinkMessages

            @if (confirmingOff)
            {
                <div class="confirm-card confirm-card-danger">
                    <p>Turn off the link? Anyone who opens it will see that the page is gone. Turning sharing on again makes a new link.</p>
                    <div class="form-actions">
                        <button type="button" class="btn btn-danger" @onclick="TurnOffLinkAsync">Turn off</button>
                        <button type="button" class="btn btn-link" @onclick="() => confirmingOff = false">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-link btn-sm text-danger link-action ps-0" @onclick="() => confirmingOff = true">Turn off the link</button>
            }
        }
    </text>;

    private RenderFragment UploadingNote => @<text>
        @if (waitingPhotos > 0)
        {
            <p class="form-text">@(waitingPhotos == 1 ? "1 photo is" : $"{waitingPhotos} photos are") still uploading. @(waitingPhotos == 1 ? "It shows" : "They show") on the page once @(waitingPhotos == 1 ? "it's" : "they're") up.</p>
        }
    </text>;

    private RenderFragment LinkMessages => @<text>
        @if (linkError is not null)
        {
            <p class="share-link-error" role="alert">@linkError</p>
        }
        else if (linkSaved)
        {
            <p class="action-message mb-0" role="status">Saved</p>
        }
    </text>;

    private RenderFragment WordsFields => @<text>
        <div class="share-field">
            <label class="share-label" for="share-name">Name</label>
            <input id="share-name" class="form-control" maxlength="80" @bind="name" @bind:event="oninput" @onchange="WordsChangedAsync" disabled="@Making" />
        </div>

        <div class="share-field">
            <label class="share-label" for="share-line">What it says</label>
            <textarea id="share-line" class="form-control" rows="3" maxlength="200" @bind="line" @bind:event="oninput" @onchange="WordsChangedAsync" disabled="@Making"></textarea>
            @if (Edited)
            {
                <button type="button" class="btn btn-link btn-sm link-action ps-0" @onclick="UseOriginalWords" disabled="@Making">Use the app's words again</button>
            }
        </div>
    </text>;

    // ---- The time-lapse ----

    private async Task EnterTimelapseAsync()
    {
        videoFormat = await Timelapse.GetFormatAsync();
        speed = await Timelapse.GetSpeedAsync();
        reducedMotion = await Timelapse.PrefersReducedMotionAsync();
        canShareVideo = await Timelapse.CanShareAsync();
        videoState = VideoState.Idle;
        madeKey = null;
        previewKey = null;
        previewPlaying = false;
        tickNote = null;
        await RefreshAvailabilityAsync();
    }

    // Stops the preview and anything being made, and drops the finished video. The card is drawn again if the sheet stays open.
    private async Task LeaveTimelapseAsync()
    {
        makeRun++;
        var making = videoState == VideoState.Making;
        videoState = VideoState.Idle;
        madeKey = null;
        previewKey = null;
        previewPlaying = false;
        progress = null;
        drawnKey = null;
        try
        {
            if (making)
                await Timelapse.CancelAsync();
            await Timelapse.StopPreviewAsync();
            await Timelapse.DiscardAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away
        }
    }

    private async Task RefreshAvailabilityAsync()
    {
        var found = await Timelapse.CheckAsync(allPhotos.Select(p => p.Id));
        smallIds = found.Small.Select(Guid.Parse).ToHashSet();
        missingIds = found.Missing.Select(Guid.Parse).ToHashSet();
    }

    private async Task SetSpeedAsync(TimelapseSpeed value)
    {
        speed = value;
        await Timelapse.SetSpeedAsync(value);
    }

    private void ToggleTick(Guid id)
    {
        if (leftOut.Contains(id))
        {
            if (TickedPhotos.Count >= TimelapsePlan.MaxPhotos)
            {
                tickNote = $"A time-lapse takes up to {TimelapsePlan.MaxPhotos} photos. Leave one out to add this one.";
                return;
            }
            leftOut.Remove(id);
            tickNote = null;
        }
        else if (allPhotos.Count - leftOut.Count <= 2)
        {
            tickNote = "A time-lapse needs at least 2 photos, so this one stays in.";
        }
        else
        {
            leftOut.Add(id);
            tickNote = null;
        }
    }

    private void TogglePlay() => previewPlaying = !previewPlaying;

    // What the video is made from. The photos are in the order they were taken, with the timing from TimelapsePlan.
    private TimelapseSpec VideoSpec()
    {
        var usable = UsablePhotos;
        var byId = usable.ToDictionary(p => p.Id);
        var plan = TimelapsePlan.Create(usable.Select(p => new TimelapsePhoto(p.Id, p.TakenAt)), speed);
        var shots = plan.Shots.Select(shot =>
        {
            var photo = byId[shot.PhotoId];
            return new TimelapseShotSpec(photo.Id.ToString(), photo.Frame, DayText(photo), shot.Start, shot.Hold);
        }).ToList();
        return new TimelapseSpec(
            videoFormat,
            CardName,
            Text.Latin,
            Text.Cultivar,
            string.IsNullOrWhiteSpace(line) ? null : line.Trim(),
            plan.Crossfade,
            plan.Total,
            shots);
    }

    private static string VideoKey(TimelapseSpec spec) => JsonSerializer.Serialize(spec);

    // Keeps the preview and the made video in step with what is on the sheet
    private async Task SyncVideoAsync()
    {
        if (videoState == VideoState.Making)
            return;

        var spec = VideoSpec();
        var inputs = VideoKey(spec);

        // Something it was made from has changed, so the video is dropped and Make video comes back
        if (videoState == VideoState.Done && madeKey != inputs)
        {
            videoState = VideoState.Idle;
            madeKey = null;
            await Timelapse.DiscardAsync();
            StateHasChanged();
        }

        var key = spec.Shots.Count < 2 ? "none" : $"{previewPlaying}|{!reducedMotion}|{inputs}";
        if (key == previewKey)
            return;
        previewKey = key;
        if (spec.Shots.Count < 2)
            await Timelapse.StopPreviewAsync();
        else
            await Timelapse.PreviewAsync(canvas, spec, !reducedMotion || previewPlaying);
    }

    private async Task MakeVideoAsync()
    {
        var run = ++makeRun;
        message = null;
        cancelRequested = false;
        progress = null;
        phase = "Getting ready.";
        videoState = VideoState.Making;
        previewKey = null;
        StateHasChanged();

        try
        {
            await Timelapse.StopPreviewAsync();

            // Photos that are only small here are fetched in full first, the way the card does
            var found = await Timelapse.CheckAsync(TickedPhotos.Select(p => p.Id));
            if (found.Small.Count > 0)
            {
                phase = "Getting the full photos, so the video is sharp.";
                StateHasChanged();
                foreach (var id in found.Small.Select(Guid.Parse))
                {
                    if (cancelRequested || run != makeRun)
                        break;
                    await Sync.FetchPhotoAsync(id, PhotoSize.Full);
                }
            }
            if (run != makeRun)
                return;
            if (cancelRequested)
            {
                videoState = VideoState.Idle;
                return;
            }

            await RefreshAvailabilityAsync();
            if (UsablePhotos.Count < 2)
            {
                videoState = VideoState.Idle;
                message = "Too few of those photos are on this device to make a video.";
                return;
            }

            // Cancel may have been tapped while the photos were being checked
            if (cancelRequested)
            {
                videoState = VideoState.Idle;
                return;
            }

            var spec = VideoSpec();
            phase = "Making the video.";
            progress = 0;
            StateHasChanged();
            var result = await Timelapse.MakeAsync(spec, fraction =>
            {
                if (run != makeRun)
                    return;
                progress = fraction;
                _ = InvokeAsync(StateHasChanged);
            });
            if (run != makeRun)
                return;

            switch (result)
            {
                case "done":
                    videoState = VideoState.Done;
                    madeKey = VideoKey(spec);
                    break;
                case "cancelled":
                    videoState = VideoState.Idle;
                    break;
                case "offline":
                    videoState = VideoState.Idle;
                    message = "The video maker couldn't be downloaded. Connect to the internet and try again. After that it works offline too.";
                    break;
                case "unsupported":
                    videoState = VideoState.Idle;
                    message = "This browser can't make videos.";
                    break;
                default:
                    videoState = VideoState.Idle;
                    message = VideoFailed;
                    break;
            }
        }
        catch (JSException)
        {
            if (run == makeRun)
            {
                videoState = VideoState.Idle;
                message = VideoFailed;
            }
        }
        finally
        {
            if (run == makeRun)
            {
                progress = null;
                previewKey = null;
            }
        }
    }

    private async Task CancelVideoAsync()
    {
        cancelRequested = true;
        phase = "Cancelling.";
        await Timelapse.CancelAsync();
    }

    private async Task ShareVideoAsync() => await RunVideoAsync(() => Timelapse.ShareAsync(VideoFileName));

    private async Task SaveVideoAsync() => await RunVideoAsync(() => Timelapse.SaveAsync(VideoFileName));

    private async Task RunVideoAsync(Func<Task<string>> action)
    {
        busy = true;
        message = null;
        try
        {
            message = await action() switch
            {
                "saved" => "Saved as a video on this device. It's in your downloads.",
                "failed" => "The video couldn't be shared. Make it again.",
                _ => null,
            };
        }
        finally
        {
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Links.Changed -= OnLinksChanged;
        Sync.StatusChanged -= OnSyncStatusChanged;
        if (mode == ShareMode.Timelapse)
            await LeaveTimelapseAsync();
    }

    private void PickPair(string side, Guid id) =>
        ChangeKeepingEditedLine(() =>
        {
            if (side == "before")
                beforeId = id;
            else
                afterId = id;
        });

    private void ChangeKeepingEditedLine(Action change)
    {
        var wasDefault = (line ?? "").Trim() == (DefaultLine ?? "");
        change();
        if (wasDefault)
            line = DefaultLine ?? "";
    }

    private async Task UseOriginalWords()
    {
        name = Text.Name;
        line = DefaultLine ?? "";
        if (mode == ShareMode.Link)
            await SaveLinkAsync();
    }

    private ShareFileKind CardFileKind => mode == ShareMode.Pair ? ShareFileKind.BeforeAfter : ShareFileKind.Photo;

    private async Task ShareAsync() => await RunAsync(() => Cards.ShareAsync(canvas, ShareCardService.FileNameFor(CardName, CardFileKind)));

    private async Task SaveAsync() => await RunAsync(() => Cards.SaveAsync(canvas, ShareCardService.FileNameFor(CardName, CardFileKind)));

    private async Task RunAsync(Func<Task<string>> action)
    {
        busy = true;
        message = null;
        try
        {
            message = await action() switch
            {
                "saved" => "Saved as a picture on this device. It's in your downloads.",
                "failed" => "The picture couldn't be made. Try again, or pick another photo.",
                _ => null,
            };
        }
        finally
        {
            busy = false;
        }
    }
}
