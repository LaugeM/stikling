@* Logging care. Used on one plant from its page, and on several at once from the plants list. *@
@inject CareService CareService
@inject OwnCareKindService OwnKindService
@inject ILogger<CareSheet> Logger
@inject IProductRepository ProductRepository
@inject IFeedRepository FeedRepository
@inject TimeProvider Time

<div class="care-sheet">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    <div class="row g-2">
        <div class="col-7">
            <label class="form-label" for="care-kind">What you did</label>
            <select id="care-kind" class="form-select form-select-sm" @bind="choice" @bind:after="ChoiceChanged">
                @foreach (var value in Enum.GetValues<CareKind>())
                {
                    <option value="@value">@KindLabel(value)</option>
                }
                @if (ownKinds.Count > 0)
                {
                    <optgroup label="Your own">
                        @foreach (var item in ownKinds)
                        {
                            <option value="@(OwnPrefix + item.Id)">@item.Name</option>
                        }
                    </optgroup>
                }
                <option value="@AddChoice">Add your own…</option>
            </select>
        </div>
        <div class="col-5">
            <label class="form-label" for="care-date">When</label>
            <input type="date" id="care-date" class="form-control form-control-sm"
                   max="@Today.ToString("yyyy-MM-dd")" value="@occurredOn.ToString("yyyy-MM-dd")"
                   @onchange="DateChanged" />
        </div>
    </div>

    @if (adding)
    {
        <div class="mt-2 own-kind-add">
            <OwnKindFields Prefix="care-own" @bind-Name="newName" @bind-CountsAs="newCountsAs" @bind-OnHistory="newOnHistory" />
            <div class="care-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(newName))" @onclick="AddKindAsync">Add</button>
                <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="CancelAdd">Cancel</button>
            </div>
        </div>
    }

    @if (kind == CareKind.MoistureReading)
    {
        <div class="mt-2">
            <label class="form-label" for="care-moisture">Reading (0 to 10)</label>
            <input type="number" id="care-moisture" class="form-control form-control-sm"
                   min="0" max="10" inputmode="numeric" @bind="moisture" />
        </div>
    }

    @if (CareKinds.TakesProducts(kind))
    {
        @if (feeds.Count > 0)
        {
            <div class="mt-2">
                <div class="form-label">Feed</div>
                <div class="chip-row" role="group" aria-label="Feeds">
                    @foreach (var item in feeds)
                    {
                        <button type="button" class="chip @(feed?.Id == item.Id ? "picked" : null)"
                                aria-pressed="@(feed?.Id == item.Id ? "true" : "false")"
                                @onclick="() => PickFeed(item)">@item.Name</button>
                    }
                </div>
            </div>
        }

        <div class="mt-2 care-water">
            <label class="form-label" for="care-water">Water</label>
            <WaterInput Id="care-water" Placeholder="Optional" @bind-Litres="water" />
        </div>

        @if (!showReadings && ec is null && ph is null)
        {
            <button type="button" class="btn btn-link btn-sm p-0 mt-2" @onclick="() => showReadings = true">Add EC and pH</button>
        }
        else
        {
            <div class="row g-2 mt-1">
                <div class="col-6">
                    <label class="form-label" for="care-ec">EC (mS/cm)</label>
                    <input type="number" id="care-ec" class="form-control form-control-sm"
                           min="0" max="20" step="0.1" inputmode="decimal" placeholder="Optional" @bind="ec" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="care-ph">pH</label>
                    <input type="number" id="care-ph" class="form-control form-control-sm"
                           min="0" max="14" step="0.1" inputmode="decimal" placeholder="Optional" @bind="ph" />
                </div>
            </div>
        }

        <div class="mt-2">
            <div class="form-label">What went in the water</div>
            @if (products.Count == 0)
            {
                <div class="form-text mt-0">No products yet. You can add your fertilisers under Supplies, then Products.</div>
            }
            else
            {
                <div class="chip-row" role="group" aria-label="Products">
                    @foreach (var product in products)
                    {
                        <button type="button" class="chip @(IsPicked(product) ? "picked" : null)"
                                aria-pressed="@(IsPicked(product) ? "true" : "false")"
                                @onclick="() => Toggle(product)">@product.Name</button>
                    }
                </div>

                @for (var i = 0; i < doses.Count; i++)
                {
                    var dose = doses[i];
                    var id = $"care-dose-{i}";
                    <div class="care-dose">
                        <div class="care-dose-head">
                            <label for="@id">@dose.Name</label>
                            @if (water > 0)
                            {
                                <span class="care-measure">@Measure(dose)</span>
                            }
                        </div>
                        <DoseInput Id="@id" Unit="dose.Unit"
                                   @bind-Amount="dose.Amount" @bind-Per="dose.Per" @bind-PerUnit="dose.PerUnit" />
                    </div>
                }
            }
        </div>
    }

    <div class="mt-2">
        <label class="form-label" for="care-notes">Notes</label>
        <input type="text" id="care-notes" class="form-control form-control-sm"
               placeholder="@NotesHint" @bind="notes" @bind:event="oninput" />
    </div>

    <div class="care-actions">
        <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || PlantIds.Count == 0)" @onclick="LogAsync">
            @SubmitText
        </button>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="OnCancel">Cancel</button>
        }
    </div>
</div>

@code {
    /// <summary>The plants this entry is for. One from a plant page, several from the list.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<Guid> PlantIds { get; set; }

    /// <summary>Called after the entry is saved, so the page can reload what it shows.</summary>
    [Parameter]
    public EventCallback OnLogged { get; set; }

    /// <summary>When set, a Cancel button is shown.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>How the plant is watered, when it is one plant. A reservoir is refilled, so that is what the sheet offers first.</summary>
    [Parameter]
    public WateringForm? Form { get; set; }

    private const string OwnPrefix = "own:";
    private const string AddChoice = "add";

    // What the select shows: a built-in kind's name, "own:" and the id of one of your own, or "add"
    private string choice = nameof(CareKind.Watered);
    private string previousChoice = nameof(CareKind.Watered);
    // What is logged. An own kind of care is the kind it counts as, so the sheet behaves like it.
    private CareKind kind = CareKind.Watered;
    private OwnCareKind? own;
    private IReadOnlyList<OwnCareKind> ownKinds = [];
    private bool adding;
    private string newName = "";
    private CareKind? newCountsAs;
    private bool newOnHistory;
    private DateOnly occurredOn;
    private int? moisture;
    private IReadOnlyList<Product> products = [];
    private IReadOnlyList<Feed> feeds = [];
    // The feed the doses came from, if one was picked. The doses can still be changed for this entry.
    private Feed? feed;
    // The water the products went into in litres, which is what turns a dose into an amount to measure
    private decimal? water;
    // The products picked for this entry, in the order they were picked, each with its own dose
    private readonly List<ProductDose> doses = [];
    private decimal? ec;
    private decimal? ph;
    private bool showReadings;
    private string? notes;
    private string? error;
    private bool busy;

    private DateOnly Today => Time.Today();

    private string SubmitText =>
        PlantIds.Count == 1 ? "Log it" : $"Log for {Labels.Plants(PlantIds.Count)}";

    // Topping up a reservoir is called refilling, the same as the tick on the watering screen
    private string KindLabel(CareKind value) =>
        value == CareKind.ToppedUp && Form == WateringForm.Reservoir ? WateringText.DoneLabel(WateringForm.Reservoir) : Labels.For(value);

    private string NotesHint => kind switch
    {
        CareKind.Fertilised => "e.g. Half strength",
        CareKind.Repotted => "e.g. Into the big terracotta",
        CareKind.Harvested => "e.g. A good handful of basil",
        _ => "Optional"
    };

    protected override async Task OnInitializedAsync()
    {
        occurredOn = Today;
        if (Form is { } form)
        {
            kind = WateringForms.DoneKind(form);
            choice = previousChoice = kind.ToString();
        }
        ownKinds = await OwnKindService.GetAllAsync();
        products =(await ProductRepository.GetAllAsync())
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        feeds = (await FeedRepository.GetAllAsync())
            .OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private void ChoiceChanged()
    {
        if (choice == AddChoice)
        {
            adding = true;
            return;
        }

        adding = false;
        own = choice.StartsWith(OwnPrefix, StringComparison.Ordinal) && Guid.TryParse(choice[OwnPrefix.Length..], out var id)
            ? ownKinds.FirstOrDefault(k => k.Id == id)
            : null;
        if (own is not null)
            kind = own.LogKind;
        else if (Enum.TryParse<CareKind>(choice, out var builtIn))
            kind = builtIn;
        else
            choice = nameof(CareKind.Watered);
        previousChoice = choice;
        KindChanged();
    }

    private void CancelAdd()
    {
        adding = false;
        choice = previousChoice;
    }

    private async Task AddKindAsync()
    {
        busy = true;
        error = null;
        try
        {
            var added = await OwnKindService.AddAsync(newName, newCountsAs, newOnHistory);
            ownKinds = await OwnKindService.GetAllAsync();
            newName = "";
            newCountsAs = null;
            newOnHistory = false;
            choice = OwnPrefix + added.Id;
            ChoiceChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding a kind of care failed");
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    // Only a moisture reading carries a number, and only a feed has products, so clear them when switching away
    private void KindChanged()
    {
        if (kind != CareKind.MoistureReading)
            moisture = null;
        if (!CareKinds.TakesProducts(kind))
        {
            doses.Clear();
            feed = null;
            water = null;
            ec = null;
            ph = null;
            showReadings = false;
        }
        error = null;
    }

    private bool IsPicked(Product product) => doses.Any(d => d.ProductId == product.Id);

    // Picking a product adds it at its usual dose, which can then be changed for this entry
    private void Toggle(Product product)
    {
        if (doses.FindIndex(d => d.ProductId == product.Id) is var index and >= 0)
            doses.RemoveAt(index);
        else
            doses.Add(ProductDose.From(product));

        // Taking everything out of a feed leaves nothing of it to log
        if (doses.Count == 0)
            feed = null;
    }

    // Picking a feed puts its products in, in order and at its doses. Picking it again takes them out.
    private void PickFeed(Feed item)
    {
        doses.Clear();
        if (feed?.Id == item.Id)
        {
            feed = null;
            return;
        }

        feed = item;
        doses.AddRange(item.Doses(products));
    }

    /// <summary>"4 ml" for the water given, or nothing when the dose isn't known.</summary>
    private string? Measure(ProductDose dose) =>
        water is { } litres && dose.For(litres) is { } amount ? Doses.Measured(amount, dose.Unit) : null;

    private void DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
            occurredOn = parsed;
    }

    private async Task LogAsync()
    {
        busy = true;
        error = null;
        try
        {
            await CareService.LogManyAsync(PlantIds, kind, occurredOn, notes, e => e is CareKind k ? KindLabel(k) : Labels.For(e), moisture, doses,
                feed, water > 0 ? water : null, ec, ph, own?.Id, own?.Name);
            notes = null;
            moisture = null;
            doses.Clear();
            feed = null;
            water = null;
            ec = null;
            ph = null;
            showReadings = false;
            occurredOn = Today;
            await OnLogged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the care log failed");
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
