@* Full-screen photo viewer with previous/next, and "set as cover", framing and delete where the page allows them. Photos copied from a received history can't be deleted. *@

@using Stikling.Core.Photos
@inject PhotoMarkupService Markups

@if (Current is { } photo)
{
    <div class="viewer" role="dialog" aria-modal="true" aria-label="@Strings.Shared.PhotoViewerLabel" @onkeydown="OnKeyDown" tabindex="-1" @ref="dialog">
        <div class="viewer-bar">
            <span class="viewer-count">@(Index + 1) / @PhotoList.Count · @Labels.Date(DateOnly.FromDateTime(photo.TakenAt.LocalDateTime))@PhotoDayCount.Suffix(PhotoAge?.Invoke(DateOnly.FromDateTime(photo.TakenAt.LocalDateTime)))@(Caption?.Invoke(photo) is { Length: > 0 } caption ? $" · {caption}" : null)</span>
            <button type="button" class="viewer-close" @onclick="CloseAsync" aria-label="@Strings.Common.Close"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true">@Icons.Close</svg></button>
        </div>

        @if (marking)
        {
            <PhotoMarker @key="photo.Id" Photo="photo" OnDone="list => MarkingDone(photo, list)" />
        }
        else if (framing)
        {
            <PhotoFramer @key="photo.Id" Photo="photo" OnSave="frame => SaveFrameAsync(photo, frame)" OnCancel="() => framing = false" />
        }
        else
        {
            <div class="viewer-stage">
                <PhotoImage PhotoId="photo.Id" Thumbnail="false" Framed="false" Class="viewer-img" Alt="@Strings.Shared.PhotoViewerAlt" />
                @if (MarksOf(photo) is { Count: > 0 } marks)
                {
                    @if (!marksHidden)
                    {
                        <PhotoMarkupLayer @key="photo.Id" Marks="marks" />
                    }
                    <button type="button" class="viewer-hide-marks" aria-pressed="@(marksHidden ? "true" : "false")" @onclick="() => marksHidden = !marksHidden">@(marksHidden ? Strings.Shared.MarkupShow : Strings.Shared.MarkupHide)</button>
                }
                @if (PhotoList.Count > 1)
                {
                    <button type="button" class="viewer-nav prev" @onclick="() => Move(-1)" aria-label="@Strings.Shared.PhotoViewerPrevious"><svg viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronLeft</svg></button>
                    <button type="button" class="viewer-nav next" @onclick="() => Move(1)" aria-label="@Strings.Shared.PhotoViewerNext"><svg viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronRight</svg></button>
                }
            </div>

            @if (HasActions)
            {
                <div class="viewer-actions @(CanMarkUp ? "markable" : null)">
                    @if (confirmDelete)
                    {
                        <span>@Strings.Shared.PhotoViewerDeleteConfirm</span>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                        <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
                    }
                    else
                    {
                        @if (OnSetCover.HasDelegate && !photo.IsReference)
                        {
                            @if (photo.Id == CoverPhotoId)
                            {
                                <span class="viewer-cover"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>@Strings.Shared.PhotoViewerCover</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light btn-sm" @onclick="() => OnSetCover.InvokeAsync(photo)">@Strings.Shared.PhotoViewerSetCover</button>
                            }
                        }
                        @if (OnFrame.HasDelegate)
                        {
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => framing = true">@Strings.Shared.PhotoViewerFrame</button>
                        }
                        @* A photo from a received history stays in the history it came with *@
                        @if (CanCompare(photo))
                        {
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => OnCompare.InvokeAsync(photo)">@Strings.Shared.PhotoViewerCompare</button>
                        }
                        @* The photo isn't changed, so it can be marked up wherever it came from *@
                        @if (CanMarkUp)
                        {
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => marking = true">@Strings.Shared.PhotoViewerMarkUp</button>
                        }
                        @if (OnSetReference.HasDelegate && photo.ReceivedHistoryId is null && !Kept(photo))
                        {
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => OnSetReference.InvokeAsync(photo)">@(photo.IsReference ? Strings.Shared.PhotoViewerMoveToHistory : Strings.Shared.PhotoViewerMoveToReference)</button>
                        }
                        @* A photo copied from the history it had before stays as it was given *@
                        @if (OnDelete.HasDelegate && photo.ReceivedHistoryId is null && !Kept(photo))
                        {
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="() => confirmDelete = true">@Strings.Common.Delete</button>
                        }
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Photo> PhotoList { get; set; } = [];

    /// <summary>Index of the photo being shown, or null when the viewer is closed.</summary>
    [Parameter]
    public int? Index { get; set; }

    [Parameter]
    public EventCallback<int?> IndexChanged { get; set; }

    [Parameter]
    public Guid? CoverPhotoId { get; set; }

    /// <summary>The day the photos count from (day 0). Without it, no day count is shown.</summary>
    [Parameter]
    public Func<DateOnly, string?>? PhotoAge { get; set; }

    /// <summary>Text shown after the date for a photo, like the plant it shows. Nothing is added when it returns null or empty.</summary>
    [Parameter]
    public Func<Photo, string?>? Caption { get; set; }

    [Parameter]
    public EventCallback<Photo> OnSetCover { get; set; }

    /// <summary>Moves a photo between the history and the reference photos. The action only shows when this is set.</summary>
    [Parameter]
    public EventCallback<Photo> OnSetReference { get; set; }

    /// <summary>Deletes a photo. Delete only shows when this is set.</summary>
    [Parameter]
    public EventCallback<Photo> OnDelete { get; set; }

    /// <summary>Saves how a photo sits where it's cropped. Frame only shows when this is set.</summary>
    [Parameter]
    public EventCallback<(Photo Photo, PhotoFrame? Frame)> OnFrame { get; set; }

    /// <summary>Opens the photo next to another one. Compare only shows when this is set, for a photo that isn't a reference photo and when there are two or more others to compare.</summary>
    [Parameter]
    public EventCallback<Photo> OnCompare { get; set; }

    /// <summary>Whether Mark up shows: drawing circles and arrows on the photo, which are kept as records of their own.</summary>
    [Parameter]
    public bool CanMarkUp { get; set; }

    /// <summary>Photos that belong to another page, like a cutting's photos on its plant. They can be framed and set as the cover, not moved or deleted from here.</summary>
    [Parameter]
    public IReadOnlySet<Guid>? KeptPhotoIds { get; set; }

    private bool Kept(Photo photo) => KeptPhotoIds?.Contains(photo.Id) == true;

    private ElementReference dialog;
    private bool confirmDelete;
    private bool framing;
    private bool marking;
    private bool marksHidden;
    private bool focusPending;
    private Dictionary<Guid, IReadOnlyList<PhotoMarkup>>? markups;

    /// <summary>Without any, the viewer is for looking only, like a pot's photos opened from a plant.</summary>
    private bool HasActions => OnSetCover.HasDelegate || OnSetReference.HasDelegate || OnFrame.HasDelegate || OnDelete.HasDelegate || OnCompare.HasDelegate || CanMarkUp;

    private bool CanCompare(Photo photo) =>
        OnCompare.HasDelegate && !photo.IsReference && PhotoList.Count(p => !p.IsReference) >= 2;

    private Photo? Current => Index is { } i && i >= 0 && i < PhotoList.Count ? PhotoList[i] : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Current is null)
        {
            // Closed: the marks are read again next time, and hiding them is forgotten
            markups = null;
            marksHidden = false;
            marking = false;
            return;
        }

        focusPending = true;
        if (markups is null || !markups.ContainsKey(Current.Id) && PhotoList.Any(p => !markupsFor.Contains(p.Id)))
            await LoadMarksAsync();
    }

    // The photos the marks were read for, since a photo with none isn't in the dictionary
    private HashSet<Guid> markupsFor = [];

    private async Task LoadMarksAsync()
    {
        var ids = PhotoList.Select(p => p.Id).ToList();
        var found = await Markups.GetForPhotosAsync(ids);
        markups = found.ToDictionary(x => x.Key, x => x.Value);
        markupsFor = ids.ToHashSet();
    }

    private IReadOnlyList<PhotoMarkup>? MarksOf(Photo photo) =>
        markups is not null && markups.TryGetValue(photo.Id, out var list) ? list : null;

    private void MarkingDone(Photo photo, IReadOnlyList<PhotoMarkup> list)
    {
        markups ??= [];
        if (list.Count == 0)
            markups.Remove(photo.Id);
        else
            markups[photo.Id] = list;
        marking = false;
        marksHidden = false;
        focusPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the dialog so arrow keys and Escape work straight away
        if (focusPending && Current is not null)
        {
            focusPending = false;
            await dialog.FocusAsync();
        }
    }

    private async Task SaveFrameAsync(Photo photo, PhotoFrame? frame)
    {
        await OnFrame.InvokeAsync((photo, frame));
        framing = false;
        focusPending = true;
    }

    private async Task Move(int step)
    {
        confirmDelete = false;
        var next = ((Index ?? 0) + step + PhotoList.Count) % PhotoList.Count;
        await IndexChanged.InvokeAsync(next);
    }

    private async Task CloseAsync()
    {
        confirmDelete = false;
        framing = false;
        marking = false;
        marksHidden = false;
        await IndexChanged.InvokeAsync(null);
    }

    private async Task DeleteAsync()
    {
        confirmDelete = false;
        if (Current is { } photo)
            await OnDelete.InvokeAsync(photo);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            // Marking has its own keys, and Escape there leaves marking, not the viewer
            case var _ when marking: break;
            case "Escape" when framing: framing = false; break;
            case "Escape": await CloseAsync(); break;
            case "ArrowLeft" when PhotoList.Count > 1 && !framing: await Move(-1); break;
            case "ArrowRight" when PhotoList.Count > 1 && !framing: await Move(1); break;
        }
    }
}
