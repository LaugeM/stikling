@using System.Globalization
@using System.Net
@* The front page: what a first visit sees while the app downloads, and what search engines read. It is not a
   page of the app (it has no @page). The deploy renders it with tools/static-pages/render.cs, once for each
   language, and prepare-pages.py puts it into index.html between the intro markers. Its text is in
   Resources/FrontPage.resx. Every class name and id here is used by the styles and the script in
   wwwroot/index.html. Like Help, it renders without a browser, so no calls into JavaScript. *@

<div class="intro" id="intro">
    <main>
        <div class="intro-hero">
            <div class="intro-brand"><img src="icon-192.png" alt="" width="32" height="32" />Stikling</div>
            <div class="intro-main">
                <div>
                    <h1>@Strings.FrontPage.HeroTitle</h1>
                    <p class="intro-lead">@Strings.FrontPage.HeroLead</p>
                    <p>@Strings.FrontPage.HeroFree</p>
                    <div class="intro-loading">
                        <div class="intro-bar" aria-hidden="true"><span></span></div>
                        <p class="intro-loading-text">@Strings.FrontPage.Loading</p>
                        <p class="intro-note">@Strings.FrontPage.LoadingNote</p>
                        <noscript><p>@Strings.FrontPage.NoJavaScript</p></noscript>
                    </div>
                </div>
                <div class="intro-shots">
                    <picture>
                        <source srcset="img/intro-cutting-dark.webp" media="(prefers-color-scheme: dark)" />
                        <img src="img/intro-cutting-light.webp" width="520" height="1085" decoding="async"
                             alt="@Strings.FrontPage.ShotCuttingAlt" />
                    </picture>
                    <picture>
                        <source srcset="img/intro-plant-dark.webp" media="(prefers-color-scheme: dark)" />
                        <img src="img/intro-plant-light.webp" width="520" height="1085" decoding="async"
                             alt="@Strings.FrontPage.ShotPlantAlt" />
                    </picture>
                </div>
            </div>
        </div>

        <div class="intro-more" id="intro-more">
            <section aria-labelledby="intro-story">
                <h2 id="intro-story">@Strings.FrontPage.StoryTitle</h2>
                <p>@Strings.FrontPage.StoryText</p>
                <ol class="intro-steps">
                    <li class="intro-step">
                        <span class="intro-step-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.5" /><circle cx="6" cy="17.5" r="2.5" /><path d="M8.2 7.8 19 17M8.2 16.2 19 7" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.Step1Title</h3>
                            <p class="intro-step-when">@Strings.FrontPage.Step1When</p>
                            <p>@Strings.FrontPage.Step1Text</p>
                        </div>
                    </li>
                    <li class="intro-step">
                        <span class="intro-step-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l-1 6v9a3 3 0 0 1-6 0V9Z" /><path d="M12 12v4M12 16l-2 2M12 16l2 2" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.Step2Title</h3>
                            <p class="intro-step-when">@Strings.FrontPage.Step2When</p>
                            <p>@Strings.FrontPage.Step2Text</p>
                        </div>
                    </li>
                    <li class="intro-step is-plant">
                        <span class="intro-step-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.Step3Title</h3>
                            <p class="intro-step-when">@Strings.FrontPage.Step3When</p>
                            <p>@Strings.FrontPage.Step3Text</p>
                        </div>
                    </li>
                    <li class="intro-step is-plant">
                        <span class="intro-step-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5.5" r="2.5" /><circle cx="6" cy="18.5" r="2.5" /><circle cx="18" cy="8.5" r="2.5" /><path d="M6 8v8M18 11c0 4-4.5 4.5-9.8 6.4" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.Step4Title</h3>
                            <p class="intro-step-when">@Strings.FrontPage.Step4When</p>
                            <p>@Strings.FrontPage.Step4Text</p>
                        </div>
                    </li>
                </ol>
            </section>

            <section class="intro-split" aria-labelledby="intro-keeps">
                <div>
                    <h2 id="intro-keeps">@Strings.FrontPage.KeepsTitle</h2>
                    <p>@Strings.FrontPage.KeepsText</p>
                </div>
                <ul class="intro-rows">
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsTodayTitle</h3>
                            <p>@Strings.FrontPage.KeepsTodayText</p>
                        </div>
                    </li>
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3.5 4.2 6 7.6 6 10.8a6 6 0 0 1-12 0C6 10.6 8.5 7.2 12 3Z" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsCareTitle</h3>
                            <p>@Strings.FrontPage.KeepsCareText</p>
                        </div>
                    </li>
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4" /><path d="M10 7a2 2 0 0 1 4 0M8 11H4.5M8 15H4.5M16 11h3.5M16 15h3.5M9 4.5 7.5 3M15 4.5 16.5 3" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsPestsTitle</h3>
                            <p>@Strings.FrontPage.KeepsPestsText</p>
                        </div>
                    </li>
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9M4 12h14M4 18h6" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsRootsTitle</h3>
                            <p>@Strings.FrontPage.KeepsRootsText</p>
                        </div>
                    </li>
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.5" /><path d="m21 15-4.5-4.5L8 19" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsPhotosTitle</h3>
                            <p>@Strings.FrontPage.KeepsPhotosText</p>
                        </div>
                    </li>
                    <li class="intro-row">
                        <span class="intro-row-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="14" height="10" rx="1.5" /><path d="M5 19h8" /><rect x="16" y="9" width="6" height="11" rx="1.5" /></svg>
                        </span>
                        <div>
                            <h3>@Strings.FrontPage.KeepsDevicesTitle</h3>
                            <p>@Strings.FrontPage.KeepsDevicesText</p>
                        </div>
                    </li>
                </ul>
            </section>

            <section class="intro-split" aria-labelledby="intro-questions">
                <div>
                    <h2 id="intro-questions">@Strings.FrontPage.QuestionsTitle</h2>
                    <p>@Markup(Strings.FrontPage.QuestionsMore, Link("help", Strings.FrontPage.HelpPageLink))</p>
                </div>
                <div class="intro-faq">
                    <details>
                        <summary>@Strings.FrontPage.FreeQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Strings.FrontPage.FreeA</p>
                    </details>
                    <details>
                        <summary>@Strings.FrontPage.AccountQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Strings.FrontPage.AccountA</p>
                    </details>
                    <details>
                        <summary>@Strings.FrontPage.OfflineQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Strings.FrontPage.OfflineA</p>
                    </details>
                    <details>
                        <summary>@Strings.FrontPage.PhoneQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Markup(Strings.FrontPage.PhoneA, Emphasis(Strings.FrontPage.PhoneAddToHome), Emphasis(Strings.FrontPage.PhoneInstall))</p>
                    </details>
                    <details>
                        <summary>@Strings.FrontPage.KeptQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Markup(Strings.FrontPage.KeptA, Link("privacy", Strings.FrontPage.PrivacyPageLink))</p>
                    </details>
                    <details>
                        <summary>@Strings.FrontPage.OpenSourceQ<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <p>@Markup(Strings.FrontPage.OpenSourceA, Link("https://github.com/LaugeM/stikling", Strings.FrontPage.OnGitHubLink))</p>
                    </details>
                </div>
            </section>
        </div>
    </main>

    <footer class="intro-foot">
        <span>@Strings.FrontPage.FooterName</span>
        <a href="help">@Strings.FrontPage.FooterHelp</a>
        <a href="privacy">@Strings.FrontPage.FooterPrivacy</a>
        <a href="https://github.com/LaugeM/stikling">@Strings.FrontPage.FooterSource</a>
    </footer>

    <div class="intro-ready" role="status">
        <div class="intro-ready-inner">
            <p>@Strings.FrontPage.ReadyText</p>
            <button type="button" class="intro-open" id="intro-open">@Strings.FrontPage.OpenButton</button>
        </div>
    </div>
</div>

@code {
    private static MarkupString Markup(string text, params string[] inner) =>
        new(string.Format(CultureInfo.CurrentCulture, text, inner));

    private static string Link(string href, string text) => $"<a href=\"{href}\">{WebUtility.HtmlEncode(text)}</a>";

    private static string Emphasis(string text) => $"<em>{WebUtility.HtmlEncode(text)}</em>";
}
