{
  "name": "Stikling – plant & propagation tracker",
  "short_name": "Stikling",
  "description": "A free app to keep track of your plants and the cuttings you propagate from them, with photos and notes for each one. Works offline, and needs no account.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f4",
  "theme_color": "#2f7d4f",
  "prefer_related_applications": false,
  "categories": ["lifestyle", "productivity"],
  "screenshots": [
    {
      "src": "img/intro-cutting-light.webp",
      "sizes": "520x1085",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "A pothos cutting rooting in a jar of water on day 14, with a link to the plant it was taken from"
    },
    {
      "src": "img/intro-plant-light.webp",
      "sizes": "520x1085",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The plant the cutting came from, with its photo, its name and its history"
    }
  ],
  "shortcuts": [
    {
      "name": "Add plant",
      "url": "./plants/new",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New propagation",
      "url": "./propagations/new",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pest cases",
      "url": "./pests",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    }
  ]
}
