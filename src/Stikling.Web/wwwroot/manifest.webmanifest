{
  "name": "Stikling – plant & propagation tracker",
  "short_name": "Stikling",
  "description": "Track your plants and propagations. Free, offline, your data stays on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f4",
  "theme_color": "#2f7d4f",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Add plant",
      "url": "./plants/new",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New propagation",
      "url": "./propagations/new",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pest cases",
      "url": "./pests",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    }
  ]
}
