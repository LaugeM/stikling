@page "/wishlist/new"
@page "/wishlist/{Id:guid}/edit"
@inject WishService WishService
@inject ILogger<WishEdit> Logger
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject PhotoService Photos
@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Add a wish" : "Edit wish") · Stikling</PageTitle>

@* No ReloadOnSync: like other edit pages, nothing changes under someone filling in the form *@

<a class="back-link" href="wishlist">Wishlist</a>
<h1>@(IsNew ? "Add a wish" : "Edit wish")</h1>

@if (wish is null)
{
    <p class="text-body-secondary">@(notFound ? "That wish doesn't exist." : "Loading…")</p>
}
else
{
    <EditForm Model="wish" OnSubmit="SaveAsync" class="edit-form" novalidate>
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>Which plant</legend>
            <PlantNameFields @bind-Genus="wish.Genus" @bind-Species="wish.Species" @bind-Cultivar="wish.Cultivar" />
            <div class="mt-3">
                <label class="form-label" for="wish-name">Your own name for it</label>
                <InputText id="wish-name" class="form-control" @bind-Value="wish.Name" placeholder="e.g. that pink syngonium" />
            </div>
            <div class="form-text">Give it a genus, a name of your own, or both.</div>
        </fieldset>

        <fieldset>
            <legend>Getting it</legend>
            <div class="mb-3">
                <label class="form-label" for="found-at">Where to find it</label>
                <InputText id="found-at" class="form-control" @bind-Value="wish.FoundAt" placeholder="e.g. the plant fair in May, or a seller's name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="most-to-pay">The most you would pay</label>
                <InputNumber id="most-to-pay" class="form-control" @bind-Value="wish.MostToPay" min="0" step="any" inputmode="decimal" />
            </div>
            <div class="mb-1">
                <label class="form-label" for="wish-notes">Notes</label>
                <InputTextArea id="wish-notes" class="form-control" rows="3" @bind-Value="wish.Notes" placeholder="What you liked about it, or what to look for" />
            </div>
        </fieldset>

        <fieldset>
            <legend>Photos</legend>
            @if (photos.Count > 0)
            {
                <div class="photo-picks">
                    @foreach (var photo in photos)
                    {
                        <div class="photo-pick">
                            <PhotoImage PhotoId="photo.Id" Alt="Photo of the wish" />
                            <button type="button" class="photo-remove" @onclick="() => RemovePhotoAsync(photo)"
                                    aria-label="Remove photo" title="Remove photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                        </div>
                    }
                </div>
            }
            <div class="composer-row">
                <label class="btn btn-outline-primary btn-sm icon-btn" for="wish-photos">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                    @(photos.Count > 0 ? "Add more" : "Add photos")
                </label>
                <input id="wish-photos" type="file" accept="image/*" multiple class="visually-hidden"
                       @ref="photoInput" @onchange="AddPhotosAsync" disabled="@(busy || saving)" />
            </div>
            <div class="form-text">The plant at a shop, or a listing. They move to the plant as reference photos when you get it.</div>
            @if (photoStatus is not null)
            {
                <p class="composer-status" role="status">@photoStatus</p>
            }
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(saving || busy)">Save</button>
            <a class="btn btn-link" href="wishlist">Cancel</a>
        </div>
    </EditForm>

    @if (!IsNew)
    {
        <section class="danger-zone">
            @if (confirmDelete)
            {
                <p class="mb-2">Delete this wish?@(wish.IsGot ? " The plant you got stays." : "")</p>
                <button class="btn btn-danger btn-sm" disabled="@saving" @onclick="DeleteAsync">Delete</button>
                <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">Cancel</button>
            }
            else
            {
                <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">Delete</button>
            }
        </section>
    }
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private Wish? wish;
    private bool notFound;
    private bool saving;
    private bool confirmDelete;
    private List<string> errors = [];

    // The photos shown. Ones added here only have their image data stored until the wish is saved,
    // and the data is dropped again when the form is left. Ones removed here go when the wish is saved.
    private readonly List<Photo> photos = [];
    private readonly List<Photo> added = [];
    private readonly List<Photo> removed = [];
    private ElementReference photoInput;
    private string? photoStatus;
    private bool busy;
    private bool done;
    private Guid? loadedFor;
    private bool loadedOnce;

    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;

        // Another wish (or a new one) in the same page: nothing of the last one carries over
        if (loadedOnce && loadedFor != Id)
        {
            await DiscardAddedAsync();
            photos.Clear();
            removed.Clear();
            photoStatus = null;
            errors = [];
            confirmDelete = false;
            wish = null;
        }
        loadedOnce = true;
        loadedFor = Id;

        if (IsNew)
        {
            wish ??= new Wish();
            return;
        }

        wish = (await WishService.GetAllAsync()).FirstOrDefault(w => w.Id == Id);
        notFound = wish is null;
        if (wish is not null && photos.Count == 0)
            photos.AddRange(await WishService.GetPhotosAsync(wish.Id));
    }

    private async Task AddPhotosAsync()
    {
        if (wish is null)
            return;

        busy = true;
        photoStatus = "Saving photos…";
        StateHasChanged();
        try
        {
            var result = await Photos.SaveFromInputAsync(photoInput, SubjectType.Wish, wish.Id, record: false);
            photos.InsertRange(0, result.Saved);
            added.AddRange(result.Saved);
            photoStatus = result.Message(guessesMatter: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding photos to a wish failed");
            photoStatus = $"Couldn't save the photos: {ex.Message}";
        }

        busy = false;
    }

    private async Task RemovePhotoAsync(Photo photo)
    {
        photos.Remove(photo);
        photoStatus = null;
        if (added.Remove(photo))
            await Photos.RemoveBytesAsync(photo.Id);
        else
            removed.Add(photo);
    }

    private async Task DiscardAddedAsync()
    {
        foreach (var photo in added.ToList())
            await Photos.RemoveBytesAsync(photo.Id);
        added.Clear();
    }

    /// <summary>Also covers leaving by Cancel, the back link or the phone's back button.</summary>
    public async ValueTask DisposeAsync()
    {
        if (done)
            return;
        try
        {
            await DiscardAddedAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the photos go with it
        }
    }

    private async Task SaveAsync()
    {
        if (wish is null)
            return;

        errors = [.. wish.Validate(Time.Today())];
        if (errors.Count > 0)
            return;

        saving = true;
        try
        {
            await WishService.SaveAsync(wish);
            await Photos.RecordSavedAsync(added);
            foreach (var photo in removed)
                await Photos.DeleteAsync(photo.Id);
            removed.Clear();
            added.Clear(); // they belong to the saved wish now
            done = true;
            Navigation.NavigateTo("wishlist");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the wish failed");
            errors = [$"Couldn't save: {ex.Message}"];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (wish is null)
            return;

        saving = true;
        try
        {
            var gone = await WishService.DeleteAsync(wish.Id);
            foreach (var id in gone)
                await Photos.RemoveBytesAsync(id);
            await DiscardAddedAsync();
            done = true;
            Navigation.NavigateTo("wishlist");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting the wish failed");
            errors = [$"Couldn't delete: {ex.Message}"];
            confirmDelete = false;
        }
        finally
        {
            saving = false;
        }
    }
}
