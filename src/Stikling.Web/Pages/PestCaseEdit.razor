@page "/pests/new"
@page "/pests/{Id:guid}/edit"
@inject IPestCaseRepository Repository
@inject ILogger<PestCaseEdit> Logger
@inject IPlantRepository PlantRepository
@inject ITreatmentPlanRepository PlanRepository
@inject IPestTreatmentRepository TreatmentRepository
@inject IPropagationRepository PropagationRepository
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@(IsNew ? Strings.Pests.OpenACase : Strings.Pests.CaseEditTitle) · Stikling</PageTitle>

<a class="back-link" href="@BackUrl">@Strings.Common.Back</a>
<h1>@(IsNew ? Strings.Pests.OpenACase : Strings.Pests.CaseEditTitle)</h1>

@if (item is null)
{
    <p class="text-body-secondary">@(notFound ? Strings.Pests.CaseNotFound : Strings.Pests.Loading)</p>
}
else
{
    <EditForm Model="item" OnSubmit="SaveAsync" class="edit-form">
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>@Strings.Pests.CaseEditWhatFound</legend>
            <div class="row g-2 mb-3">
                <div class="col-7">
                    <label class="form-label" for="pest">@Strings.Pests.CaseEditPest</label>
                    <InputSelect id="pest" class="form-select" @bind-Value="item.Pest">
                        @foreach (var pest in Enum.GetValues<Pest>())
                        {
                            <option value="@pest">@Labels.For(pest)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-5">
                    <label class="form-label" for="started">@Strings.Pests.CaseEditFoundOn</label>
                    <InputDate id="started" class="form-control" @bind-Value="item.StartedOn" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            @if (!IsNew)
            {
                <div class="mb-1">
                    <label class="form-label" for="status">@Strings.Pests.CaseEditHowItStands</label>
                    <InputSelect id="status" class="form-select" @bind-Value="item.Status" @bind-Value:after="StatusChanged">
                        @foreach (var status in Enum.GetValues<PestCaseStatus>())
                        {
                            <option value="@status">@Labels.For(status)</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-text">@Strings.Pests.CaseEditStatusHint</div>
                @if (item.Status == PestCaseStatus.Resolved)
                {
                    <div class="mt-3">
                        <label class="form-label" for="resolved">@Strings.Pests.CaseEditResolvedOn</label>
                        <InputDate id="resolved" class="form-control" @bind-Value="item.ResolvedOn"
                                   min="@item.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                }
            }
        </fieldset>

        <fieldset>
            <legend>@Strings.Pests.CaseEditWhatCovers</legend>
            <div class="btn-group segmented mb-3" role="radiogroup" aria-label="@Strings.Pests.CaseEditCoversLabel">
                @foreach (var (value, label) in scopeOptions)
                {
                    var id = $"scope-{value}";
                    <input type="radio" class="btn-check" name="scope" id="@id"
                           checked="@(item.Scope == value)" @onchange="() => SetScope(value)" />
                    <label class="btn btn-outline-primary" for="@id">@label</label>
                }
            </div>

            @if (item.Scope == PestScope.Room)
            {
                <div class="mb-1">
                    <RoomPicker @bind-Value="room" Rooms="rooms" Label="@Strings.Pests.CaseEditRoom" />
                </div>
            }
            else if (item.Scope == PestScope.PickedPlants)
            {
                <ul class="item-list pick-list">
                    @foreach (var plant in plants)
                    {
                        <li>
                            <label class="item-card selectable @(item.PlantIds.Contains(plant.Id) ? "selected" : null)">
                                <input type="checkbox" class="form-check-input plant-check"
                                       checked="@item.PlantIds.Contains(plant.Id)" @onchange="() => Toggle(plant.Id)" />
                                <div class="item-text">
                                    <div class="item-name">@plant.DisplayName</div>
                                    @if (places.NameOf(plant.PlaceId) is { } location)
                                    {
                                        <div class="item-meta"><span>@location</span></div>
                                    }
                                </div>
                            </label>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-body-secondary mb-0">@Strings.Pests.CaseEditEverywhere</p>
            }
        </fieldset>

        <fieldset>
            <legend>@Strings.Pests.CaseEditTreatment</legend>
            @if (IsNew && plans.Count > 0)
            {
                <div class="mb-3">
                    <div class="form-label">@Strings.Pests.CaseEditPlan</div>
                    <div class="chip-row" role="group" aria-label="@Strings.Pests.CaseEditPlans">
                        <button type="button" class="chip @(pickedPlan is null ? "picked" : null)"
                                aria-pressed="@(pickedPlan is null ? "true" : "false")"
                                @onclick="() => pickedPlan = null">@Strings.Pests.CaseEditNoPlan</button>
                        @foreach (var plan in plans)
                        {
                            <button type="button" class="chip @(pickedPlan == plan.Id ? "picked" : null)"
                                    aria-pressed="@(pickedPlan == plan.Id ? "true" : "false")"
                                    @onclick="() => pickedPlan = plan.Id">@plan.Name</button>
                        }
                    </div>
                    <div class="form-text">@(pickedPlan is null ? Strings.Pests.CaseEditPlanStartsWithout : Strings.Pests.CaseEditPlanStarts)</div>
                </div>
            }
            <div class="mb-1">
                <label class="form-label" for="interval">@Strings.Pests.CaseEditTreatEvery</label>
                <div class="input-group">
                    <InputNumber id="interval" class="form-control" @bind-Value="item.IntervalDays" min="1" inputmode="numeric" />
                    <span class="input-group-text">@Strings.Pests.CaseEditDays</span>
                </div>
            </div>
            @if (pickedPlan is not null)
            {
                <div class="form-text">@Strings.Pests.CaseEditUsedAfterPlan</div>
            }
            else if (FollowingPlan)
            {
                <div class="form-text">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseEditFollowing, item.PlanName)</div>
            }
            else
            {
                <div class="form-text">@Strings.Pests.CaseEditSpiderMites</div>
            }
        </fieldset>

        <fieldset>
            <legend>@Strings.Pests.CaseEditNotes</legend>
            <InputTextArea class="form-control" rows="3" @bind-Value="item.Notes" aria-label="@Strings.Pests.CaseEditNotes" />
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@saving">@(IsNew ? Strings.Pests.CaseEditOpen : Strings.Common.Save)</button>
            <a class="btn btn-link" href="@BackUrl">@Strings.Common.Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The plant whose page the case was opened from. It starts out as the one plant picked.</summary>
    [SupplyParameterFromQuery(Name = "plant")]
    public Guid? PlantId { get; set; }

    private static readonly (PestScope Value, string Label)[] scopeOptions =
    [
        (PestScope.PickedPlants, Strings.Pests.CaseEditPickPlants),
        (PestScope.Room, Strings.Pests.CaseEditOneRoom),
        (PestScope.Everywhere, Strings.Pests.CaseEditAllPlants)
    ];

    private PestCase? item;
    private bool notFound;
    private bool saving;
    private List<string> errors = [];
    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<Room> rooms = [];
    private Places places = Places.None;
    private IReadOnlyList<TreatmentPlan> plans = [];
    private IReadOnlyList<PestTreatment> caseTreatments = [];
    private Guid? pickedPlan;
    private string? room; // as picked, "Living room"; made into a room when saving

    private bool IsNew => Id is null;

    // The status the form opened with, since changing it in the form shouldn't hide the plan line
    private bool FollowingPlan =>
        item is { PlanStartedOn: not null, PlanStoppedOn: null } && loadedStatus == PestCaseStatus.Active;

    private DateOnly Today => Time.Today();

    private string BackUrl => IsNew ? (FromPlant ? $"plants/{PlantId}" : "pests") : $"pests/{Id}";

    private bool FromPlant => PlantId is { } id && plants.Any(p => p.Id == id);

    protected override async Task OnParametersSetAsync()
    {
        var allPlants = await PlantRepository.GetAllAsync();
        plants = allPlants
            .Where(p => p.InCollection)
            .OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        places = await RoomService.GetPlacesAsync();
        rooms = Room.List(places, allPlants, await PropagationRepository.GetAllAsync());

        plans = (await PlanRepository.GetAllAsync())
            .Where(p => !p.IsDeleted)
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        if (IsNew)
        {
            item = PestService.Start(Today);
            if (FromPlant)
            {
                item.Scope = PestScope.PickedPlants;
                item.PlantIds.Add(PlantId!.Value);
            }
        }
        else
        {
            item = (await Repository.GetAsync(Id!.Value))?.Copy();
            notFound = item is null;
            loadedStatus = item?.Status;
            caseTreatments = item is null ? [] : PestService.TreatmentsFor(await TreatmentRepository.GetAllAsync(), item.Id);
        }

        room = places.NameOf(item?.PlaceId);
    }

    private void SetScope(PestScope scope)
    {
        if (item is null)
            return;

        item.Scope = scope;
        if (scope != PestScope.Room)
            room = null;
        if (scope != PestScope.PickedPlants)
            item.PlantIds.Clear();
    }

    private void Toggle(Guid plantId)
    {
        if (item is null)
            return;

        if (!item.PlantIds.Remove(plantId))
            item.PlantIds.Add(plantId);
    }

    // Marking it resolved fills in today's date, so the usual case is one tap
    private void StatusChanged()
    {
        if (item is null)
            return;

        item.ResolvedOn = item.Status == PestCaseStatus.Resolved ? item.ResolvedOn ?? Today : null;
    }

    // The status the case had when the form opened, so going back to treating restarts the clean count
    private PestCaseStatus? loadedStatus;

    private async Task SaveAsync()
    {
        if (item is null)
            return;

        saving = true;
        try
        {
            item.PlaceId = item.Scope == PestScope.Room ? await RoomService.PlaceIdAsync(room) : null;
            errors = item.Validate(Today).ToList();
            if (errors.Count > 0)
                return;

            if (loadedStatus is { } from)
                PestService.StatusChanged(item, from, Today, caseTreatments);

            if (IsNew && plans.FirstOrDefault(p => p.Id == pickedPlan) is { } plan)
                item.StartPlan(plan, item.StartedOn);

            await Repository.SaveAsync(item);
            Navigation.NavigateTo($"pests/{item.Id}", replace: IsNew);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the pest case failed");
            errors = [string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CouldntSave, ex.Message)];
        }
        finally
        {
            saving = false;
        }
    }
}
