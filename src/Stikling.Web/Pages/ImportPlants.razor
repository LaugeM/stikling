@page "/plants/import"
@layout WideLayout
@using System.Globalization
@using System.Text.RegularExpressions
@using Stikling.Core.Import
@inject IPlantRepository Repository
@inject OwnFieldService FieldBook
@inject PlantNameService Names
@inject IDeviceLanguages Languages
@inject SpreadsheetImportService Importer
@inject TimeProvider Time
@inject ILogger<ImportPlants> Logger

<PageTitle>@Strings.Account.ImportPageTitle</PageTitle>

<a class="back-link" href="plants">@Strings.Common.Back</a>
<h1>@Strings.Account.ImportTitle</h1>

@if (step == Step.Choose)
{
    <div class="import-narrow">
        <p>@Strings.Account.ImportIntro</p>

        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="mb-4">
            <label class="btn btn-primary @(busy ? "disabled" : null)" for="import-file">@Strings.Account.ImportChooseFile</label>
            <InputFile id="import-file" class="visually-hidden" OnChange="ChooseFileAsync" disabled="@busy"
                       accept=".csv,.tsv,.txt,text/csv,text/tab-separated-values,text/plain" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="import-paste">@Strings.Account.ImportPasteLabel</label>
            <textarea id="import-paste" class="form-control" rows="5" spellcheck="false"
                      @bind="pasted" @bind:event="oninput"></textarea>
        </div>
        <button type="button" class="btn btn-outline-primary" disabled="@(busy || string.IsNullOrWhiteSpace(pasted))" @onclick="UsePasted">@Strings.Account.ImportUseCells</button>
    </div>
}
else if (step == Step.Result && result is not null)
{
    <div class="import-narrow">
        @if (undone)
        {
            <h2 class="import-title" role="status" tabindex="-1" @ref="resultHeading">@UndoneText</h2>
            <div class="import-buttons">
                <a class="btn btn-primary" href="plants">@Strings.Account.ImportGoToPlants</a>
                <button type="button" class="btn btn-outline-primary" @onclick="StartAgain">@Strings.Account.ImportImportMore</button>
            </div>
        }
        else
        {
            <h2 class="import-title" role="status" tabindex="-1" @ref="resultHeading">@(result.Added == 0 ? Strings.Account.ImportNoneAdded : Plural.Of(result.Added, Strings.Account.ImportAdded_One, Strings.Account.ImportAdded_Other))</h2>
            @if (MadeText is { } made)
            {
                <p class="import-muted">@made</p>
            }
            @if (addError is not null)
            {
                <div class="alert alert-danger" role="alert">@addError</div>
            }
            else if (added.Count > 0)
            {
                <div class="import-block mt-3">
                    @foreach (var row in added)
                    {
                        <div class="import-row">
                            <div class="import-name">@row.Draft.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(row.Place))
                            {
                                <div class="import-meta">@row.Place</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (result.Skipped.Count > 0)
            {
                <h2 class="section-label mt-4">@Strings.Account.ImportNotAdded</h2>
                <div class="import-block">
                    @foreach (var skipped in result.Skipped)
                    {
                        <div class="import-row">
                            <div class="import-name">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportRowName, skipped.Line, skipped.Name)</div>
                            <div class="import-meta">@skipped.Reason</div>
                        </div>
                    }
                </div>
            }
            @if (undoError is not null)
            {
                <div class="alert alert-danger mt-3" role="alert">@undoError</div>
            }
            <div class="import-buttons">
                <a class="btn btn-primary" href="plants">@Strings.Account.ImportGoToPlants</a>
                @if (result.Added > 0)
                {
                    <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="UndoAsync">@Strings.Account.ImportUndo</button>
                }
            </div>
        }
    </div>
}
else if (sheet is not null)
{
    <div class="import-review page-full">
        @* Columns. On a phone it is the first step; on a wide screen it sits beside the plants *@
        <section class="import-pane @(step == Step.Columns ? "current" : null)" aria-label="@Strings.Account.ImportColumnsLabel">
            <p class="import-muted">
                @SourceName · @Plural.Of(sheet.Rows.Count, Strings.Account.ImportRow_One, Strings.Account.ImportRow_Other) · @Plural.Of(sheet.Headings.Count, Strings.Account.ImportColumn_One, Strings.Account.ImportColumn_Other)
                <button type="button" class="btn btn-link link-action ms-2" @onclick="StartAgain">@Strings.Account.ImportStartAgain</button>
            </p>

            <div class="form-check mb-3 import-check">
                <input class="form-check-input" type="checkbox" id="import-headings" checked="@firstRowIsHeadings" @onchange="HeadingsChanged" />
                <label class="form-check-label" for="import-headings">@Strings.Account.ImportFirstRowHeadings</label>
            </div>

            <h2 class="section-label" tabindex="-1" @ref="columnsHeading">@Strings.Account.ImportYourColumns</h2>
            <div class="import-block">
                @for (var column = 0; column < sheet.Headings.Count; column++)
                {
                    var c = column;
                    <div class="import-row import-column">
                        <div class="import-column-text">
                            <div class="import-name">@sheet.Headings[c]</div>
                            <div class="import-meta">@Samples(c)</div>
                        </div>
                        <div class="import-column-pick">
                            <select class="form-select" aria-label="@sheet.Headings[c]" @onchange="e => MatchChanged(c, e)">
                                @foreach (var (group, fields) in ImportFields.Groups.Where(g => !g.Fields.Contains(ImportField.OwnField)))
                                {
                                    <optgroup label="@group">
                                        @foreach (var field in fields)
                                        {
                                            <option value="@field" selected="@(matches[c] == field)">@ImportFields.Label(field)</option>
                                        }
                                    </optgroup>
                                }
                                @if (NewFieldName(c) is not null || liveFields.Count > 0)
                                {
                                    <optgroup label="@Strings.Account.ImportYourFields">
                                        @if (NewFieldName(c) is { } offered)
                                        {
                                            <option value="@NewFieldValue" selected="@(targets[c] is { IsNew: true })">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportNewField, offered)</option>
                                        }
                                        @foreach (var field in liveFields)
                                        {
                                            <option value="@($"{ExistingFieldValue}{field.Id}")" selected="@(targets[c]?.ExistingId == field.Id)">@field.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            @if (matches[c] == ImportField.OwnField && targets[c] is { } target)
                            {
                                @if (target.IsNew)
                                {
                                    <select class="form-select" aria-label="@Strings.Account.ImportKindOfField" @onchange="e => KindChanged(c, e)">
                                        @foreach (var kind in Enum.GetValues<OwnFieldKind>())
                                        {
                                            <option value="@kind" selected="@(target.Kind == kind)">@KindName(kind)</option>
                                        }
                                    </select>
                                    <div class="import-meta">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportMakesField, target.Name)</div>
                                }
                                else
                                {
                                    <div class="import-meta">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportGoesIntoField, target.Name)</div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            @if (askOrder)
            {
                <div class="mt-3">
                    <div class="section-label" id="import-order-label">@Strings.Account.ImportDatesInFile</div>
                    <div class="btn-group segmented import-order" role="radiogroup" aria-labelledby="import-order-label">
                        <input type="radio" class="btn-check" name="import-order" id="import-day-first"
                               checked="@(order == DateOrder.DayFirst)" @onchange="() => OrderChanged(DateOrder.DayFirst)" />
                        <label class="btn btn-outline-primary" for="import-day-first">
                            <span>@Strings.Account.ImportDayFirst<small>@Strings.Account.ImportDayFirstExample</small></span>
                        </label>
                        <input type="radio" class="btn-check" name="import-order" id="import-month-first"
                               checked="@(order == DateOrder.MonthFirst)" @onchange="() => OrderChanged(DateOrder.MonthFirst)" />
                        <label class="btn btn-outline-primary" for="import-month-first">
                            <span>@Strings.Account.ImportMonthFirst<small>@Strings.Account.ImportMonthFirstExample</small></span>
                        </label>
                    </div>
                </div>
            }

            @if (!HasNameColumn)
            {
                <p class="import-muted mt-3">@Strings.Account.ImportNoNameColumn</p>
            }

            <div class="form-bar import-next">
                <button type="button" class="btn btn-primary" disabled="@(rows.Count == 0)" @onclick="() => GoTo(Step.Plants)">
                    @string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportNextCheck, Labels.Plants(rows.Count))
                </button>
            </div>
        </section>

        @* Plants *@
        <section class="import-pane @(step == Step.Plants ? "current" : null)" aria-label="@Strings.Account.ImportPlantsLabel">
            @if (rows.Count == 0)
            {
                <p class="import-muted">@Strings.Account.ImportNoPlants</p>
            }
            else
            {
                <h2 class="section-label" tabindex="-1" @ref="plantsHeading">@Strings.Account.ImportPlantsHeading</h2>
                <p class="import-muted" aria-live="polite">
                    @CountLine
                </p>
                <div class="mb-2">
                    <button type="button" class="btn btn-link link-action me-3" @onclick="TickAll">@Strings.Account.ImportTickAll</button>
                    <button type="button" class="btn btn-link link-action" @onclick="UntickAll">@Strings.Account.ImportUntickAll</button>
                </div>

                <div class="import-block import-plants">
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var index = i;
                        var row = rows[i];
                        <label class="import-row import-plant @(ticked.Contains(index) ? null : "unticked")">
                            <input type="checkbox" class="form-check-input" checked="@ticked.Contains(index)"
                                   disabled="@(row.CantAdd is not null || adding)" @onchange="() => Toggle(index)" />
                            <span class="import-plant-text">
                                <span class="import-name">@row.Draft.DisplayName</span>
                                @if (!string.IsNullOrWhiteSpace(row.Draft.Nickname) && !string.IsNullOrEmpty(row.Draft.BotanicalName))
                                {
                                    <span class="import-botanical"><BotanicalName Genus="@row.Draft.Genus" Species="@row.Draft.Species" Cultivar="@row.Draft.Cultivar" Qualifier="@row.Draft.NameQualifier" Note="@row.Draft.NameNote" /></span>
                                }
                                @if (TypedName(index) is { } typed)
                                {
                                    <span class="import-meta">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportFrom, typed)</span>
                                }
                                <span class="import-meta">@MetaLine(row)</span>
                                @if (!string.IsNullOrWhiteSpace(row.Draft.Notes))
                                {
                                    <span class="import-meta import-about">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportAboutIt, row.Draft.Notes.ReplaceLineEndings(" · "))</span>
                                }
                                @if (row.LooksLikeYours)
                                {
                                    <span class="import-yours">@Strings.Account.ImportLooksLikeYours</span>
                                }
                                @if (row.CantAdd is { } reason)
                                {
                                    <span class="import-cant">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportCantAdd, LowerFirst(reason))</span>
                                }
                                @foreach (var problem in row.Problems)
                                {
                                    <span class="import-meta">@problem</span>
                                }
                            </span>
                        </label>
                    }
                </div>

                <div class="form-bar import-add">
                    @if (adding)
                    {
                        <div class="import-progress">
                            <div class="import-bar" role="progressbar" aria-label="@Strings.Account.ImportAdding"
                                 aria-valuemin="0" aria-valuemax="@addTotal" aria-valuenow="@addDone">
                                <span style="@BarStyle"></span>
                            </div>
                            <p class="import-progress-text" aria-live="polite">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportAddingProgress, addDone, addTotal)</p>
                        </div>
                    }
                    else
                    {
                        @if (error is not null)
                        {
                            <div class="alert alert-danger" role="alert">@error</div>
                        }
                        <button type="button" class="btn btn-primary" disabled="@(ticked.Count == 0)" @onclick="AddAsync">
                            @(ticked.Count == 0 ? Strings.Account.ImportTickToAdd : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportAddPlants, Labels.Plants(ticked.Count)))
                        </button>
                        <button type="button" class="btn btn-link import-back" @onclick="() => GoTo(Step.Columns)">@Strings.Account.ImportBackToColumns</button>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private enum Step { Choose, Columns, Plants, Result }

    private const long MaxBytes = 5L * 1024 * 1024;

    private static readonly Regex NumericDate = new(@"^\s*\d{1,2}[/.\-]\d{1,2}[/.\-]\d{2,4}\s*$", RegexOptions.Compiled);

    private static readonly ImportField[] DateFields =
        [ImportField.GotOn, ImportField.LastWatered, ImportField.LastFed, ImportField.LastRepotted];

    private Step step = Step.Choose;
    private PlantDictionary dictionary = PlantDictionary.Empty;
    private IReadOnlyList<Plant> existing = [];
    private DateOrder languageOrder = DateOrder.DayFirst;

    private string pasted = "";
    private string? error;
    private bool busy;

    private string text = "";
    private string sourceName = "";
    private bool firstRowIsHeadings = true;
    private Stikling.Core.Import.Sheet? sheet;
    private List<ImportField> matches = [];
    private List<ImportOwnField?> targets = []; // where each column that is a field of its own goes, null for the others
    private IReadOnlyList<OwnField> liveFields = [];
    private DateOrder order = DateOrder.DayFirst;
    private DateOrder chosenOrder = DateOrder.DayFirst;
    private bool askOrder;
    private IReadOnlyList<ImportRow> rows = [];
    private HashSet<int> ticked = [];

    private bool adding;
    private int addDone;
    private int addTotal;
    private ImportResult? result;
    private string? addError;
    private string? undoError;
    private bool undone;
    private List<ImportRow> added = [];

    private ElementReference columnsHeading;
    private ElementReference plantsHeading;
    private ElementReference resultHeading;
    private Step? focusStep;

    private DateOnly Today => Time.Today();

    private string SourceName => sourceName;

    private static string LowerFirst(string text) =>
        text.Length > 1 && char.IsUpper(text[0]) && !char.IsUpper(text[1]) ? char.ToLowerInvariant(text[0]) + text[1..] : text;

    private bool HasNameColumn => matches.Any(m => m is ImportField.Name or ImportField.Nickname or ImportField.Genus);

    private int LooksLikeCount => rows.Count(r => r.LooksLikeYours);

    private int CantAddCount => rows.Count(r => r.CantAdd is not null);

    private string? BarStyle => addTotal > 0
        ? FormattableString.Invariant($"--done:{100.0 * addDone / addTotal:0.#}%")
        : null;

    private string? MadeText
    {
        get
        {
            var parts = new List<string>();
            if (result?.RoomsMade > 0)
                parts.Add(Plural.Of(result.RoomsMade, Strings.Account.ImportRoomMade_One, Strings.Account.ImportRoomMade_Other));
            if (result?.FieldsMade.Count > 0)
                parts.Add(Plural.Of(result.FieldsMade.Count, Strings.Account.ImportFieldMade_One, Strings.Account.ImportFieldMade_Other));
            if (result?.CareDates > 0)
                parts.Add(Plural.Of(result.CareDates, Strings.Account.ImportCareLogged_One, Strings.Account.ImportCareLogged_Other));
            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }

    /// <summary>"Removed the plant again.", with the fields it made when it made any.</summary>
    private string UndoneText
    {
        get
        {
            var plants = result!.Added;
            var fields = result.FieldsMade.Count;
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            return (plants == 1, fields) switch
            {
                (true, 0) => Strings.Account.ImportUndone_Plant,
                (true, 1) => Strings.Account.ImportUndone_PlantField,
                (true, _) => string.Format(culture, Strings.Account.ImportUndone_PlantFields, fields),
                (false, 0) => string.Format(culture, Strings.Account.ImportUndone_Plants, plants),
                (false, 1) => string.Format(culture, Strings.Account.ImportUndone_PlantsField, plants),
                _ => string.Format(culture, Strings.Account.ImportUndone_PlantsFields, plants, fields)
            };
        }
    }

    /// <summary>"3 of 12 ticked · 1 looks like one you have · 2 can't be added".</summary>
    private string CountLine
    {
        get
        {
            var parts = new List<string> { string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportTicked, ticked.Count, rows.Count) };
            if (LooksLikeCount > 0)
                parts.Add(Plural.Of(LooksLikeCount, Strings.Account.ImportLooksLike_One, Strings.Account.ImportLooksLike_Other));
            if (CantAddCount > 0)
                parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.ImportCantAddCount, CantAddCount));
            return string.Join(" · ", parts);
        }
    }

    private static string KindName(OwnFieldKind kind) => kind switch
    {
        OwnFieldKind.Text => Strings.Account.ImportKindText,
        OwnFieldKind.Number => Strings.Account.ImportKindNumber,
        OwnFieldKind.Date => Strings.Account.ImportKindDate,
        OwnFieldKind.Choice => Strings.Account.ImportKindChoice,
        _ => kind.ToString()
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The step that takes the screen takes the focus too, so it isn't left on a button that is now hidden
        if (focusStep is not { } next)
            return;
        focusStep = null;
        var heading = next switch
        {
            Step.Columns => columnsHeading,
            Step.Plants => plantsHeading,
            _ => resultHeading
        };
        if (heading.Context is not null)
            await heading.FocusAsync();
    }

    private void GoTo(Step next)
    {
        step = next;
        focusStep = next;
    }

    protected override async Task OnInitializedAsync()
    {
        dictionary = await Names.GetDictionaryAsync();
        existing = await Repository.GetAllAsync();
        liveFields = await FieldBook.GetAllAsync();
        languageOrder = DateOrderGuess.ForLanguages(await Languages.GetAsync());
        chosenOrder = languageOrder;
    }

    private async Task ChooseFileAsync(InputFileChangeEventArgs e)
    {
        error = null;
        var file = e.File;
        if (file.Size > MaxBytes)
        {
            error = Strings.Account.ImportFileTooBig;
            return;
        }

        busy = true;
        StateHasChanged();
        try
        {
            existing = await Repository.GetAllAsync();
            liveFields = await FieldBook.GetAllAsync();
            var bytes = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxBytes))
                await stream.CopyToAsync(bytes);
            Open(SheetReader.Decode(bytes.ToArray()), file.Name, Strings.Account.ImportNoPlantsInFile);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reading the spreadsheet file failed");
            error = Strings.Account.ImportCantRead;
        }
        busy = false;
    }

    private async Task UsePasted()
    {
        error = null;
        existing = await Repository.GetAllAsync();
        liveFields = await FieldBook.GetAllAsync();
        Open(pasted, Strings.Account.ImportPastedCells, Strings.Account.ImportNoPlantsPasted);
    }

    private void Open(string content, string name, string emptyMessage)
    {
        var read = SheetReader.Read(content, firstRowIsHeadings: true);
        if (read.Rows.Count == 0)
        {
            error = emptyMessage;
            return;
        }

        text = content;
        sourceName = name;
        firstRowIsHeadings = true;
        sheet = read;
        chosenOrder = languageOrder;
        Guess(read);
        GoTo(Step.Columns);
        Recompute();
    }

    private void StartAgain()
    {
        step = Step.Choose;
        sheet = null;
        rows = [];
        ticked = [];
        result = null;
        undone = false;
        added = [];
        undoError = null;
        addError = null;
        error = null;
        pasted = "";
    }

    private void HeadingsChanged(ChangeEventArgs e)
    {
        firstRowIsHeadings = e.Value is true;
        sheet = SheetReader.Read(text, firstRowIsHeadings);
        Guess(sheet);
        Recompute();
    }

    private void Guess(Stikling.Core.Import.Sheet read)
    {
        var guess = ImportFields.Guess(read, liveFields, chosenOrder, Today);
        matches = [.. guess.Matches];
        targets = [.. guess.Targets];
    }

    private const string NewFieldValue = "own:new";
    private const string ExistingFieldValue = "own:";

    // The heading as the name of a new field, or null when the heading is blank or a field has that name
    private string? NewFieldName(int column)
    {
        var name = sheet!.Headings[column].Trim();
        if (name.Length > OwnField.MaxNameLength)
            name = name[..OwnField.MaxNameLength].TrimEnd();
        return name.Length == 0 || liveFields.Any(f => string.Equals(f.Name.Trim(), name, StringComparison.CurrentCultureIgnoreCase))
            ? null
            : name;
    }

    private void KindChanged(int column, ChangeEventArgs e)
    {
        if (targets[column] is { IsNew: true } target && Enum.TryParse<OwnFieldKind>(e.Value?.ToString(), out var kind))
            targets[column] = target with { Kind = kind };
        Recompute();
    }

    private void MatchChanged(int column, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? nameof(ImportField.Skip);
        if (value.StartsWith("own:", StringComparison.Ordinal))
        {
            OwnFieldChosen(column, value);
            return;
        }

        var field = Enum.Parse<ImportField>(value);
        matches[column] = field;
        targets[column] = null;
        if (field is not (ImportField.Skip or ImportField.AboutLine))
        {
            // One column per field: the one that had it before goes to About it
            for (var other = 0; other < matches.Count; other++)
            {
                if (other != column && matches[other] == field)
                    matches[other] = ImportField.AboutLine;
            }
        }
        Recompute();
    }

    private void OwnFieldChosen(int column, string value)
    {
        ImportOwnField? target = null;
        if (value == NewFieldValue && NewFieldName(column) is { } name)
        {
            var cells = sheet!.Rows.Select(r => column < r.Count ? r[column] : "");
            target = new ImportOwnField(name, ImportFields.GuessKind(cells, chosenOrder, Today), null);
        }
        else if (Guid.TryParse(value[ExistingFieldValue.Length..], out var id) && liveFields.FirstOrDefault(f => f.Id == id) is { } live)
            target = new ImportOwnField(live.Name, live.Kind, live.Id);

        if (target is null)
            return;
        matches[column] = ImportField.OwnField;
        targets[column] = target;
        // One column per field: the one that had it before goes to About it
        for (var other = 0; other < matches.Count; other++)
        {
            if (other != column && targets[other]?.PreviewId == target.PreviewId)
            {
                matches[other] = ImportField.AboutLine;
                targets[other] = null;
            }
        }
        Recompute();
    }

    private void OrderChanged(DateOrder value)
    {
        chosenOrder = value;
        Recompute();
    }

    private void Recompute()
    {
        if (sheet is null)
            return;

        var cells = new List<string>();
        for (var column = 0; column < matches.Count; column++)
        {
            if (!DateFields.Contains(matches[column]) && targets[column]?.Kind != OwnFieldKind.Date)
                continue;
            foreach (var row in sheet.Rows)
            {
                if (column < row.Count && row[column].Trim() is { Length: > 0 } cell)
                    cells.Add(cell);
            }
        }

        var found = DateOrderGuess.FromValues(cells);
        askOrder = found is null && cells.Any(cell => NumericDate.IsMatch(cell));
        order = found ?? chosenOrder;

        rows = SpreadsheetImport.Preview(sheet, matches, order, dictionary, existing, Today, targets);
        ticked = [.. rows.Select((r, i) => (r, i)).Where(x => x.r.TickedByDefault).Select(x => x.i)];
    }

    private string Samples(int column)
    {
        var values = sheet!.Rows
            .Select(r => column < r.Count ? r[column].Trim() : "")
            .Where(v => v.Length > 0)
            .Take(2)
            .ToList();
        return values.Count == 0 ? Strings.Account.ImportEmpty : string.Join(" · ", values);
    }

    /// <summary>
    /// The name as the file has it, when the plant is shown by another one, like a common name read as
    /// its genus and species. Null when they are the same.
    /// </summary>
    private string? TypedName(int index)
    {
        var column = matches.IndexOf(ImportField.Name);
        if (column < 0 || sheet is null || index >= sheet.Rows.Count || column >= sheet.Rows[index].Count)
            return null;
        var typed = sheet.Rows[index][column].Trim();
        var draft = rows[index].Draft;
        // Not when it is shown already, as the name or kept in About it because a Nickname column took its place
        return typed.Length == 0
            || string.Equals(typed, draft.DisplayName, StringComparison.CurrentCultureIgnoreCase)
            || draft.Notes?.Contains($"{sheet.Headings[column]}: {typed}") == true
            ? null
            : typed;
    }

    private static string MetaLine(ImportRow row)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        var parts = new List<string> { string.Format(culture, Strings.Account.ImportRowLine, row.Line) };
        if (!string.IsNullOrWhiteSpace(row.Place))
            parts.Add(row.Place);
        if (row.Draft.AcquiredOn is { } got)
            parts.Add(string.Format(culture, Strings.Account.ImportGot, got.Text()));
        foreach (var care in row.Care)
        {
            var word = care.Kind switch
            {
                CareKind.Watered => Strings.Account.ImportCareWatered,
                CareKind.Fertilised => Strings.Account.ImportCareFed,
                CareKind.Repotted => Strings.Account.ImportCareRepotted,
                _ => Labels.For(care.Kind)
            };
            parts.Add(string.Format(culture, Strings.Account.ImportCareDate, word, Labels.Date(care.On)));
        }
        return string.Join(" · ", parts);
    }

    private void Toggle(int index)
    {
        if (!ticked.Remove(index))
            ticked.Add(index);
    }

    private void TickAll() =>
        ticked = [.. rows.Select((r, i) => (r, i)).Where(x => x.r.CantAdd is null).Select(x => x.i)];

    private void UntickAll() => ticked = [];

    private async Task AddAsync()
    {
        if (adding || ticked.Count == 0)
            return;

        var chosen = rows.Where((r, i) => ticked.Contains(i)).ToList();
        error = null;
        addError = null;
        undoError = null;
        undone = false;
        adding = true;
        addDone = 0;
        addTotal = chosen.Count;
        try
        {
            result = await Importer.ImportAsync(chosen, Labels.For, new Progress<int>(done =>
            {
                addDone = done;
                StateHasChanged();
            }), targets);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Importing the spreadsheet failed");
            // What was added before it failed can still be undone
            result = Importer.Last;
            addError = Strings.Account.ImportAddFailedSome;
        }
        adding = false;
        if (result is { Added: > 0 } || (result is not null && addError is null))
        {
            var skippedLines = result!.Skipped.Select(s => s.Line).ToHashSet();
            added = addError is null ? [.. chosen.Where(r => !skippedLines.Contains(r.Line))] : [];
            GoTo(Step.Result);
        }
        else
        {
            // Nothing was added, so it stays here with the columns and ticks as they were, ready to try again
            result = null;
            addError = null;
            error = Strings.Account.ImportAddFailedNone;
        }
    }

    private async Task UndoAsync()
    {
        if (result is null || busy)
            return;

        busy = true;
        undoError = null;
        try
        {
            await Importer.UndoAsync(result);
            undone = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Undoing the spreadsheet import failed");
            undoError = Strings.Account.ImportUndoFailed;
        }
        busy = false;
    }
}
