@page "/pots"
@layout WideLayout
@inject IPotRepository Repository
@inject ILogger<Pots> Logger
@inject PotService PotService
@inject PhotoService Photos
@inject GooglePhotosService Google
@inject DeviceFiles Device
@implements IAsyncDisposable

<PageTitle>@Strings.Supplies.PotsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<ShowFound ElementId="@(Show is { } shown ? $"item-{shown}" : null)" />

<a class="back-link" href="supplies">@Strings.Supplies.BackToSupplies</a>
<h1>@Strings.Supplies.PotsTitle</h1>

<p class="settings-hint">
    @Strings.Supplies.PotsIntro
</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (photoStatus is not null)
{
    <div class="alert alert-warning" role="status">@photoStatus</div>
}

<div class="btn-group segmented pot-kinds mb-3" role="radiogroup" aria-label="@Strings.Supplies.PotsWhichToShow">
    @foreach (var group in Enum.GetValues<PotKind>())
    {
        var id = $"pot-kind-{group}";
        <input type="radio" class="btn-check" name="pot-kind" id="@id"
               checked="@(kind == group)" @onchange="() => ShowKindAsync(group)" />
        <label class="btn btn-outline-primary" for="@id">@Labels.Tab(group)</label>
    }
</div>

@if (draft is not null)
{
    <section class="settings-section supply-form">
        <h2>@(editing is null ? (IsContainer ? Strings.Supplies.PotsAddContainer : Strings.Supplies.PotsAddPot) : (IsContainer ? Strings.Supplies.PotsEditContainer : Strings.Supplies.PotsEditPot))</h2>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.PotsWhatKind</div>
            <div class="chip-row" role="group" aria-label="@Strings.Supplies.PotsWhatKindOfPot">
                @foreach (var group in OfferedKinds)
                {
                    <button type="button" class="chip @Picked(draft.Kind == group)"
                            @onclick="() => SetDraftKind(group)">@Labels.For(group)</button>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="pot-name">@Strings.Supplies.Name</label>
            @if (Names.Count > 0)
            {
                <div class="chip-row mb-2" role="group" aria-label="@Strings.Supplies.PotsNamesInUse">
                    @foreach (var name in Names)
                    {
                        <button type="button" class="chip @Picked(Same(name, draft.Name))"
                                @onclick="() => draft.Name = name">@name</button>
                    }
                </div>
            }
            <input id="pot-name" class="form-control" placeholder="@(IsContainer ? Strings.Supplies.PotsContainerPlaceholder : Strings.Supplies.PotsPotPlaceholder)" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
            @if (IsContainer)
            {
                <div class="form-text">@Strings.Supplies.PotsContainerNameHint</div>
            }
            else
            {
                <div class="form-text">@Strings.Supplies.PotsPotNameHint</div>
            }
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.PotsPhotos</div>
            @if (formPhotos.Count > 0)
            {
                <div class="photo-picks">
                    @foreach (var photo in formPhotos)
                    {
                        <div class="photo-pick">
                            <PhotoImage PhotoId="photo.Id" Alt="@Strings.Supplies.PotsPhotoAlt" />
                            <button type="button" class="photo-remove" @onclick="() => RemoveFormPhoto(photo)"
                                    aria-label="@Strings.Supplies.PotsRemovePhoto" title="@Strings.Supplies.PotsRemovePhoto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                        </div>
                    }
                </div>
            }
            <div class="composer-row">
                <label class="btn btn-outline-primary btn-sm icon-btn" for="pot-camera">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                    @Strings.Supplies.PotsCamera
                </label>
                <input id="pot-camera" type="file" accept="image/*" capture="environment" class="visually-hidden"
                       @ref="cameraInput" @onchange="() => AddFormPhotosAsync(cameraInput)" disabled="@busy" />
                <label class="btn btn-outline-primary btn-sm icon-btn" for="pot-gallery">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-5 4 4 3-3 4 4" /></svg>
                    @Strings.Supplies.PotsGallery
                </label>
                <input id="pot-gallery" type="file" accept="image/*" multiple class="visually-hidden"
                       @ref="galleryInput" @onchange="() => AddFormPhotosAsync(galleryInput)" disabled="@busy" />
                @if (googleOn)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm icon-btn" @onclick="StartGoogleAsync"
                            disabled="@(busy || googleBusy)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                        @Strings.Supplies.PotsGooglePhotos
                    </button>
                }
            </div>
            @if (googleOn)
            {
                <GooglePhotosPick @ref="googlePick" SubjectType="SubjectType.Pot" SubjectId="draft!.Id" OnSaved="GoogleFormSavedAsync" BusyChanged="busy => googleBusy = busy" />
            }
            <div class="form-text">@Strings.Supplies.PotsPhotoHint</div>
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.PotsMadeOf</div>
            <div class="chip-row" role="group" aria-label="@Strings.Supplies.PotsMadeOfLabel">
                @foreach (var material in Enum.GetValues<PotMaterial>())
                {
                    <button type="button" class="chip @Picked(draft.Material == material)"
                            @onclick="() => draft.Material = material">@Labels.For(material)</button>
                }
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label" for="pot-top">@Strings.Supplies.PotsAcrossTop</label>
                <input id="pot-top" class="form-control" type="number" inputmode="decimal" min="0" step="0.1"
                       @bind="draft.TopCm" />
            </div>
            <div class="col-6">
                <label class="form-label" for="pot-owned">@Strings.Supplies.PotsHowMany</label>
                <input id="pot-owned" class="form-control" type="number" inputmode="numeric" min="1" step="1"
                       @bind="draft.Owned" />
            </div>
        </div>

        <details class="more-measurements mb-3" open="@detailsOpen">
            <summary>@Strings.Supplies.PotsMoreMeasurements</summary>

            <div class="row g-2 mt-2">
                <div class="col-6">
                    <label class="form-label" for="pot-bottom">@Strings.Supplies.PotsAcrossBottom</label>
                    <input id="pot-bottom" class="form-control" type="number" inputmode="decimal" min="0" step="0.1"
                           @bind="draft.BottomCm" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="pot-height">@Strings.Supplies.PotsHeight</label>
                    <input id="pot-height" class="form-control" type="number" inputmode="decimal" min="0" step="0.1"
                           @bind="draft.HeightCm" />
                </div>
            </div>
            <div class="form-text">
                @Strings.Supplies.PotsMeasurementsHint
            </div>

            @if (!IsContainer)
            {
                <div class="mt-3">
                    <label class="form-label" for="pot-rim">@Strings.Supplies.PotsRim</label>
                    <input id="pot-rim" class="form-control" type="number" inputmode="decimal" min="0" step="0.5"
                           @bind="draft.RimMm" />
                    <div class="form-text">@Strings.Supplies.PotsRimHint</div>
                </div>

                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pot-self-watering"
                               checked="@(draft.SelfWatering is not null)"
                               @onchange="e => SetSelfWatering((bool?)e.Value == true)" />
                        <label class="form-check-label" for="pot-self-watering">@Strings.Supplies.PotsWatersItself</label>
                    </div>
                    @if (draft.SelfWatering is { } watering)
                    {
                        <div class="chip-row mt-2" role="group" aria-label="@Strings.Supplies.PotsHowWatersItself">
                            @foreach (var option in Enum.GetValues<PotWatering>())
                            {
                                <button type="button" class="chip @Picked(watering == option)"
                                        @onclick="() => draft.SelfWatering = option">@Labels.For(option)</button>
                            }
                        </div>
                        <div class="form-text">@Strings.Supplies.PotsWateringHint</div>
                    }
                </div>
            }

            <div class="mt-3">
                <label class="form-label" for="pot-notes">@Strings.Supplies.Notes</label>
                <textarea id="pot-notes" class="form-control" rows="2" @bind="draft.Notes"></textarea>
            </div>
        </details>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(busy || googleBusy)" @onclick="() => SaveAsync(again: false)">
                @(editing is null ? (IsContainer ? Strings.Supplies.PotsSubmitAddContainer : Strings.Supplies.PotsSubmitAddPot) : Strings.Common.Save)
            </button>
            @if (editing is null)
            {
                <button type="button" class="btn btn-outline-primary" disabled="@(busy || googleBusy)" @onclick="() => SaveAsync(again: true)">
                    @Strings.Supplies.PotsSaveAndAnother
                </button>
            }
            <button type="button" class="btn btn-link" @onclick="CancelAsync">@Strings.Common.Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="() => StartNewAsync(null)">@AddText</button>
    </div>
}

@* One input for the Photo link on every row, so a photo goes straight onto the pot tapped *@
<input id="@RowInputId" type="file" accept="image/*" multiple class="visually-hidden" tabindex="-1"
       @ref="rowInput" @onchange="AddRowPhotosAsync" disabled="@busy" />

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (Shown.Count == 0)
{
    <div class="empty-state">
        <p>@EmptyTitle</p>
        <p class="text-body-secondary">@EmptyHint</p>
    </div>
}
else
{
    <section class="settings-section">
        <h2 class="visually-hidden">@Labels.Heading(kind)</h2>

        @foreach (var family in Shown.GroupBy(use => use.Pot.Name, StringComparer.CurrentCultureIgnoreCase))
        {
            <h3 class="pot-family">@family.Key</h3>
            <ul class="pot-list supply-grid">
                @foreach (var use in family)
                {
                    <li id="item-@use.Pot.Id">
                        @if (confirming == use.Pot.Id)
                        {
                            <div class="pot-confirm">
                                <p>@DeleteWarning(use.Pot)</p>
                                <div class="care-actions">
                                    <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                            @onclick="() => DeleteAsync(use.Pot)">@Strings.Common.Delete</button>
                                    <button type="button" class="btn btn-link btn-sm"
                                            @onclick="() => confirming = null">@Strings.Common.Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pot-row">
                                @if (covers.GetValueOrDefault(use.Pot.Id) is { } cover)
                                {
                                    <button type="button" class="pot-thumb" @onclick="() => OpenPhotosAsync(use.Pot)"
                                            aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsPhotosOf, use.Pot.DisplayName)">
                                        <PhotoImage PhotoId="cover.Id" />
                                    </button>
                                }
                                else if (AnyTiles)
                                {
                                    <span class="pot-thumb-space" aria-hidden="true"></span>
                                }
                                <div class="pot-main">
                                    <span class="pot-size">@SizeText(use.Pot)</span>
                                    <span class="pot-about">@About(use.Pot)</span>
                                    <span class="pot-use">@Labels.Use(use)</span>
                                    <span class="pot-actions">
                                        <label class="btn btn-link btn-sm link-action" for="@RowInputId"
                                               @onclick="() => photoTarget = use.Pot">@Strings.Supplies.PotsPhotoLink</label>
                                        <button type="button" class="btn btn-link btn-sm link-action"
                                                @onclick="() => StartEditAsync(use.Pot)">@Strings.Common.Edit</button>
                                        <button type="button" class="btn btn-link btn-sm link-action"
                                                @onclick="() => ConfirmAsync(use.Pot)">@Strings.Common.Delete</button>
                                    </span>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}

<PhotoViewer PhotoList="viewerPhotos" @bind-Index="viewerIndex" CoverPhotoId="ViewerCoverId"
             OnSetCover="SetCoverAsync" OnFrame="FrameAsync" OnDelete="DeleteViewerPhotoAsync" />

@code {
    /// <summary>An item to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public Guid? Show { get; set; }

    private IReadOnlyList<PotUse> uses = [];
    private IReadOnlyList<Pot> all = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private Pot? draft;
    private Pot? editing;
    private bool detailsOpen;
    private Guid? confirming;
    private PotLinks inUse = new(0, 0);
    private int photoCount;

    /// <summary>Which kind of pot is listed. Nursery and outer pots are used so differently that they never share a list.</summary>
    private PotKind kind;
    private const string KindKey = "pots-kind";

    /// <summary>The photo that stands for each pot that has one.</summary>
    private IReadOnlyDictionary<Guid, Photo> covers = new Dictionary<Guid, Photo>();

    // The photos in the form. Ones added are saved straight away and deleted again on Cancel,
    // and ones removed are only deleted on Save, so Cancel leaves the pot as it was.
    private List<Photo> formPhotos = [];
    private readonly List<Guid> addedInForm = [];
    private readonly List<Guid> removedInForm = [];
    private ElementReference cameraInput;
    private ElementReference galleryInput;

    private const string RowInputId = "pot-row-photo";
    private ElementReference rowInput;
    private Pot? photoTarget;
    private string? photoStatus;
    private GooglePhotosPick? googlePick;
    private bool googleBusy;

    private async Task StartGoogleAsync()
    {
        if (googlePick is not null)
            await googlePick.Start();
    }

    private bool googleOn;

    private Pot? viewerPot;
    private IReadOnlyList<Photo> viewerPhotos = [];
    private int? viewerIndex;

    protected override async Task OnInitializedAsync()
    {
        googleOn = await Google.IsEnabledAsync();
        await LoadAsync();
        kind = Enum.TryParse<PotKind>(await Device.GetAsync(KindKey), out var stored)
            ? stored
            : uses.Select(use => use.Pot.Kind).DefaultIfEmpty(PotKind.Inner).Min();
        // A pot asked for by Search is shown under its own kind
        if (uses.FirstOrDefault(use => use.Pot.Id == Show) is { } asked)
            kind = asked.Pot.Kind;
    }

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        uses = await PotService.GetAllAsync();
        covers = await PotService.GetCoversAsync();
        loading = false;
    }

    private IReadOnlyList<PotUse> Shown => uses.Where(use => use.Pot.Kind == kind).ToList();

    /// <summary>When some pots in the list have a photo, the rest keep its room, so the sizes line up.</summary>
    private bool AnyTiles => Shown.Any(use => covers.ContainsKey(use.Pot.Id));

    private async Task ShowKindAsync(PotKind group)
    {
        kind = group;
        confirming = null;
        await Device.SetAsync(KindKey, group.ToString());
    }

    private string AddText => kind switch
    {
        PotKind.Inner => Strings.Supplies.PotsAddNursery,
        PotKind.Outer => Strings.Supplies.PotsAddOuter,
        PotKind.Propagation => Strings.Supplies.PotsAddPropagation,
        _ => Strings.Supplies.PotsAddStandalone
    };

    private string EmptyTitle => kind switch
    {
        PotKind.Inner => Strings.Supplies.PotsEmptyNursery,
        PotKind.Outer => Strings.Supplies.PotsEmptyOuter,
        PotKind.Propagation => Strings.Supplies.PotsEmptyPropagation,
        _ => Strings.Supplies.PotsEmptyStandalone
    };

    private string EmptyHint => kind switch
    {
        PotKind.Propagation => Strings.Supplies.PotsHintPropagation,
        PotKind.Inner => Strings.Supplies.PotsHintNursery,
        PotKind.Outer => Strings.Supplies.PotsHintOuter,
        _ => Strings.Supplies.PotsHintStandalone
    };

    private IReadOnlyList<string> Names => draft is null ? [] : PotUse.Names(all, draft.Kind);

    private bool IsContainer => draft?.ForPropagation == true;

    /// <summary>Picking a kind sets both fields. A container is a standalone pot marked for propagation.</summary>
    private void SetDraftKind(PotKind picked)
    {
        draft!.ForPropagation = picked == PotKind.Propagation;
        draft.Group = picked switch
        {
            PotKind.Inner => PotGroup.Inner,
            PotKind.Outer => PotGroup.Outer,
            _ => PotGroup.Standalone
        };
        if (draft.ForPropagation)
            draft.RimMm = null;
    }

    /// <summary>
    /// The kinds the form offers. A saved pot can't move between plant pot and container, since
    /// plants or propagations already counted against it would stop counting.
    /// </summary>
    private IEnumerable<PotKind> OfferedKinds =>
        Enum.GetValues<PotKind>().Where(k => editing is null || (k == PotKind.Propagation) == editing.ForPropagation);

    private static string? Picked(bool picked) => picked ? "picked" : null;

    private static bool Same(string? a, string? b) =>
        string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string SizeText(Pot pot) => pot.TopCm is { } top
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsSizeCm, Pot.Size(top))
        : Strings.Supplies.PotsNoSize;

    /// <summary>The muted line beside a pot: what it's made of, and anything unusual about it.</summary>
    private static string About(Pot pot)
    {
        var parts = new List<string> { Labels.For(pot.Material) };
        if (pot.SelfWatering is { } watering)
            parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsSelfWatering, Labels.For(watering).ToLowerInvariant()));
        if (pot.HasRim)
            parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsRimMm, Pot.Size(pot.RimMm!.Value)));
        if (pot.HeightCm is { } height)
            parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsTallCm, Pot.Size(height)));
        return string.Join(" · ", parts);
    }

    private async Task StartNewAsync(Pot? like)
    {
        await ThrowAwayAddedPhotosAsync();
        editing = null;
        errors = [];
        confirming = null;
        detailsOpen = false;
        if (like is null)
        {
            draft = new Pot();
            SetDraftKind(kind);
        }
        else
        {
            draft = like;
        }
        formPhotos = [];
        removedInForm.Clear();
    }

    private async Task StartEditAsync(Pot pot)
    {
        await ThrowAwayAddedPhotosAsync();
        editing = pot;
        errors = [];
        confirming = null;
        // Open when there's something in there to see, so editing doesn't hide what's already set
        detailsOpen = pot.BottomCm is not null || pot.HeightCm is not null || pot.RimMm is not null
            || pot.SelfWatering is not null || !string.IsNullOrWhiteSpace(pot.Notes);
        draft = pot.Copy();
        formPhotos = (await PotService.GetPhotosAsync(pot.Id)).ToList();
        removedInForm.Clear();
    }

    private async Task CancelAsync()
    {
        await ThrowAwayAddedPhotosAsync();
        draft = null;
        editing = null;
        errors = [];
        formPhotos = [];
        removedInForm.Clear();
    }

    /// <summary>Photos taken in a form that was never saved belong to nothing, so they go again.</summary>
    private async Task ThrowAwayAddedPhotosAsync()
    {
        foreach (var id in addedInForm)
            await Photos.DeleteAsync(id);
        addedInForm.Clear();
    }

    /// <summary>Leaving the page with the form open is the same as Cancel for the photos taken in it.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await ThrowAwayAddedPhotosAsync();
        }
        catch (JSDisconnectedException)
        {
            // The app is closing, and the photos with it
        }
    }

    private async Task AddFormPhotosAsync(ElementReference input)
    {
        if (draft is null)
            return;

        busy = true;
        try
        {
            var result = await Photos.SaveFromInputAsync(input, SubjectType.Pot, draft.Id);
            formPhotos.InsertRange(0, result.Saved);
            addedInForm.AddRange(result.Saved.Select(p => p.Id));
            photoStatus = result.Message(guessesMatter: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding photos to a new pot failed");
            photoStatus = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsPhotosFailed, ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private Task GoogleFormSavedAsync(PhotoSaveResult result)
    {
        formPhotos.InsertRange(0, result.Saved);
        addedInForm.AddRange(result.Saved.Select(p => p.Id));
        photoStatus = result.Message(guessesMatter: false);
        return Task.CompletedTask;
    }

    private async Task RemoveFormPhoto(Photo photo)
    {
        formPhotos.Remove(photo);
        if (addedInForm.Remove(photo.Id))
            await Photos.DeleteAsync(photo.Id);
        else
            removedInForm.Add(photo.Id);
    }

    /// <summary>The Photo link on a row: the photos go straight onto that pot.</summary>
    private async Task AddRowPhotosAsync()
    {
        if (photoTarget is not { } pot)
            return;

        busy = true;
        try
        {
            var result = await Photos.SaveFromInputAsync(rowInput, SubjectType.Pot, pot.Id);
            photoStatus = result.Message(guessesMatter: false);
            if (draft?.Id == pot.Id)
                formPhotos.InsertRange(0, result.Saved);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding photos to a pot failed");
            photoStatus = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PotsPhotosFailed, ex.Message);
        }
        finally
        {
            busy = false;
            photoTarget = null;
        }
    }

    private async Task OpenPhotosAsync(Pot pot)
    {
        viewerPot = pot;
        viewerPhotos = await PotService.GetPhotosAsync(pot.Id);
        var shown = covers.GetValueOrDefault(pot.Id);
        viewerIndex = viewerPhotos.Count == 0 ? null : Math.Max(0, viewerPhotos.ToList().FindIndex(p => p.Id == shown?.Id));
    }

    /// <summary>The photo the pot's tile shows, so the viewer says "Cover photo" on the one people see.</summary>
    private Guid? ViewerCoverId => viewerPot is null ? null : covers.GetValueOrDefault(viewerPot.Id)?.Id;

    private async Task SetCoverAsync(Photo photo)
    {
        if (viewerPot is null)
            return;
        await PotService.SetCoverAsync(viewerPot, photo);
        if (draft?.Id == viewerPot.Id)
            draft.CoverPhotoId = photo.Id;
        covers = await PotService.GetCoversAsync();
    }

    private Task FrameAsync((Photo Photo, PhotoFrame? Frame) change) => Photos.SetFrameAsync(change.Photo, change.Frame);

    private async Task DeleteViewerPhotoAsync(Photo photo)
    {
        await Photos.DeleteAsync(photo.Id);
        viewerPhotos = viewerPhotos.Where(p => p.Id != photo.Id).ToList();
        viewerIndex = viewerPhotos.Count == 0 ? null : Math.Min(viewerIndex ?? 0, viewerPhotos.Count - 1);
        formPhotos.RemoveAll(p => p.Id == photo.Id);
        covers = await PotService.GetCoversAsync();
    }

    private void SetSelfWatering(bool on) => draft!.SelfWatering = on ? PotWatering.Wick : null;

    /// <summary>
    /// Saving with "again" keeps everything but the measurements, because registering a set of
    /// nursery pots is one full entry and then five sizes.
    /// </summary>
    private async Task SaveAsync(bool again)
    {
        if (draft is null)
            return;

        errors = draft.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            // The cover is chosen in the viewer, never in the form, so keep the one saved meanwhile
            if (editing is not null)
                draft.CoverPhotoId = (await Repository.GetAsync(draft.Id))?.CoverPhotoId;
            if (draft.CoverPhotoId is { } cover && removedInForm.Contains(cover))
                draft.CoverPhotoId = null;

            await Repository.SaveAsync(draft);
            foreach (var id in removedInForm)
                await Photos.DeleteAsync(id);
            addedInForm.Clear();
            removedInForm.Clear();
            await LoadAsync();

            // Show the list the pot went into, so it can be seen
            if (draft.Kind != kind)
                await ShowKindAsync(draft.Kind);

            if (again)
            {
                var next = draft.Copy();
                next.Id = Guid.NewGuid();
                next.CreatedAt = next.UpdatedAt = default;
                next.TopCm = next.BottomCm = next.HeightCm = null;
                next.CoverPhotoId = null;
                await StartNewAsync(next);
            }
            else
            {
                await CancelAsync();
            }
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>What deleting a pot does to the plants in it and to its photos, said before it happens.</summary>
    private string DeleteWarning(Pot pot)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        var deleted = photoCount == 0
            ? ""
            : " " + string.Format(culture, photoCount == 1 ? Strings.Supplies.PotsPhotosDeletedToo_One : Strings.Supplies.PotsPhotosDeletedToo_Other, photoCount);

        var gone = photoCount == 0
            ? string.Format(culture, Strings.Supplies.PotsDeleteConfirm, pot.DisplayName)
            : string.Format(culture, photoCount == 1 ? Strings.Supplies.PotsDeleteAndPhoto_One : Strings.Supplies.PotsDeleteAndPhoto_Other, pot.DisplayName, photoCount);

        if (pot.ForPropagation)
        {
            return inUse.Propagations == 0
                ? gone
                : Plural.Of(inUse.Propagations, Strings.Supplies.PotsContainerInUse_One, Strings.Supplies.PotsContainerInUse_Other) + deleted;
        }

        return inUse.Plants == 0
            ? gone
            : Plural.Of(inUse.Plants, Strings.Supplies.PotsPotInUse_One, Strings.Supplies.PotsPotInUse_Other) + deleted;
    }

    private async Task ConfirmAsync(Pot pot)
    {
        inUse = await PotService.InUseAsync(pot.Id);
        photoCount = (await PotService.GetPhotosAsync(pot.Id)).Count;
        confirming = pot.Id;
    }

    private async Task DeleteAsync(Pot pot)
    {
        busy = true;
        try
        {
            foreach (var id in await PotService.DeleteAsync(pot.Id))
                await Photos.RemoveBytesAsync(id);
            confirming = null;
            if (editing?.Id == pot.Id)
                await CancelAsync();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
