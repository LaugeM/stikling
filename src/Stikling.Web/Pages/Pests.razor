@page "/pests"
@layout WideLayout
@inject IPestCaseRepository Cases
@inject IPestTreatmentRepository Treatments
@inject IPlantRepository PlantRepository
@inject ProblemService ProblemService
@inject SettingsService SettingsService
@using Stikling.Core.Settings
@inject RoomService RoomService
@inject PutOffService PutOffService
@inject TimeProvider Time

<PageTitle>Pests and problems · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<div class="page-heading">
    <h1>Pests and problems</h1>
    <div class="d-flex align-items-baseline gap-2">
        @if (open.Count > 0)
        {
            <span class="text-body-secondary small">@Labels.Count(open.Count, "open case")</span>
        }
        @* Takes over from the round add button on a wide screen *@
        @if (views.Count > 0)
        {
            <a class="btn btn-primary btn-sm icon-btn heading-add" href="pests/new">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                Open a pest case
            </a>
        }
    </div>
</div>

@if (!loaded)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (views.Count == 0 && problems.Count == 0)
{
    <div class="empty-state">
        <p>
            Nothing wrong right now. When you find pests, open a case for the plants they're on.
            For anything else, like yellow leaves or rot, use Something's wrong on the plant's page.
        </p>
        <a class="btn btn-primary mt-3" href="pests/new">Open a case</a>
    </div>
}
else
{
    <div class="list-body">
        @if (due.Count > 0)
        {
            <section class="stage-group">
                <h2>Due now <span class="text-body-secondary">(@due.Count)</span></h2>
                <ul class="item-list list-grid">
                    @foreach (var view in due)
                    {
                        <li>@Card(view)</li>
                    }
                </ul>
            </section>
        }

        @if (waiting.Count > 0)
        {
            <section class="stage-group">
                <h2>Open <span class="text-body-secondary">(@waiting.Count)</span></h2>
                <ul class="item-list list-grid">
                    @foreach (var view in waiting)
                    {
                        <li>@Card(view)</li>
                    }
                </ul>
            </section>
        }

        @if (problems.Count > 0)
        {
            <section class="stage-group">
                <h2>Problems <span class="text-body-secondary">(@problems.Count)</span></h2>
                <ul class="item-list list-grid">
                    @foreach (var item in problems)
                    {
                        <li>
                            <a class="item-card" href="problems/@item.Problem.Id">
                                <SubjectThumb Subject="item.Plant" />
                                <div class="item-text">
                                    <div class="item-name">@item.Plant.DisplayName</div>
                                    <div class="item-meta">@ProblemMeta(item)</div>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (resolved.Count > 0)
        {
            <section class="stage-group">
                <h2>Resolved <span class="text-body-secondary">(@resolved.Count)</span></h2>
                <ul class="item-list list-grid">
                    @foreach (var view in resolved)
                    {
                        <li>@Card(view)</li>
                    }
                </ul>
            </section>
        }
    </div>
}

<a class="fab" href="pests/new" aria-label="Open a pest case" title="Open a pest case">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
</a>

@code {
    private IReadOnlyList<PestCaseView> views = [];
    private List<PestCaseView> open = [];
    private List<PestCaseView> due = [];
    private List<PestCaseView> waiting = [];
    private List<PestCaseView> resolved = [];
    private List<OpenProblem> problems = [];
    private bool loaded;

    private sealed record OpenProblem(Problem Problem, Plant Plant, ProblemTrend? Trend);

    private DateOnly Today => Time.Today();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var plants = await PlantRepository.GetAllAsync();
        var allUpdates = await ProblemService.AllUpdatesAsync();
        problems = (await ProblemService.AllAsync())
            .Where(p => p.IsOpen)
            .Select(p => (Problem: p, Plant: plants.FirstOrDefault(x => x.Id == p.SubjectId)))
            .Where(x => x.Plant is { InCollection: true })
            .OrderByDescending(x => x.Problem.StartedOn)
            .Select(x => new OpenProblem(x.Problem, x.Plant!, ProblemService.LatestTrend(allUpdates.Where(u => u.ProblemId == x.Problem.Id))))
            .ToList();

        views = PestService.Describe(
            await Cases.GetAllAsync(),
            plants,
            await Treatments.GetAllAsync(),
            await RoomService.GetPlacesAsync(),
            Today,
            (await SettingsService.GetAsync()).CleanWeeks ?? PestService.DefaultCleanWeeks,
            await PutOffService.GetAsync(Today));

        open = views.Where(v => v.Case.IsOpen).ToList();
        due = PestService.Due(open).ToList();
        waiting = open.Where(v => !v.IsDue).ToList();
        resolved = views.Where(v => !v.Case.IsOpen).ToList();
        loaded = true;
    }

    // "Yellow leaves · 9 days · worse": only what happened, never what to do
    private string ProblemMeta(OpenProblem item) =>
        $"{ProblemText.Signs(item.Problem.KnownSigns)} · {ProblemText.Duration(ProblemText.DaysLasted(item.Problem, Today))}"
        + (item.Trend is { } trend ? $" · {ProblemText.Trend(trend).ToLowerInvariant()}" : "");

    private RenderFragment Card(PestCaseView view) => @<a class="item-card" href="pests/@view.Case.Id">
        <div class="item-thumb @(view.Case.IsOpen ? "alert" : null)" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
        </div>
        <div class="item-text">
            <div class="item-name">@Labels.For(view.Case.Pest)</div>
            <div class="item-meta">
                @if (view.Case.IsOpen)
                {
                    <span class="badge stage-badge">@Labels.For(view.Case.Status)</span>
                }
                <span>@Labels.ScopeAndCount(view)</span>
                @if (view.CleanDays is { } cleanDays)
                {
                    <span>· clean @cleanDays of @view.CleanTarget days</span>
                }
            </div>
            <div class="item-meta">
                @if (view.DaysUntilDue is not null)
                {
                    <span class="pest-due @(view.IsDue ? "now" : null)">@Labels.Due(view)</span>
                    <span>· found @Labels.Date(view.Case.StartedOn)</span>
                }
                else if (view.PlanDoneOn is not null)
                {
                    <span>Plan done · found @Labels.Date(view.Case.StartedOn)</span>
                }
                else if (view.Case.ResolvedOn is { } on)
                {
                    <span>Resolved @Labels.Date(on)</span>
                }
                else
                {
                    <span>Found @Labels.Date(view.Case.StartedOn)</span>
                }
            </div>
        </div>
    </a>;
}
