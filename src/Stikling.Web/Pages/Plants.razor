@page "/plants"
@inject IPlantRepository Repository
@inject PlantService PlantService
@inject RoomService RoomService
@inject ICareLogRepository CareLogRepository
@inject IPestCaseRepository PestCaseRepository
@inject ITimelineRepository Entries
@inject TimeProvider Time

<PageTitle>Plants · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<div class="page-heading">
    <h1>Plants</h1>
    @if (all is { Count: > 0 })
    {
        <div class="d-flex align-items-baseline gap-2">
            <span class="text-body-secondary small">@visible.Count of @all.Count</span>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="ToggleSelectMode">
                @(selecting ? "Done" : "Select")
            </button>
        </div>
    }
</div>

@if (all is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (all.Count == 0)
{
    <div class="empty-state first-run">
        <svg viewBox="0 0 64 64" aria-hidden="true">
            <path class="pot" d="M18 36h28v6H18Z" /><path class="pot" d="M21 42h22l-3 16H24Z" />
            <path class="growth" d="M32 36V18" /><path class="growth" d="M32 28c0-8-6-13-14-13 0 8 6 13 14 13Z" /><path class="growth" d="M32 23c0-7 6-11 13-11 0 7-6 11-13 11Z" />
        </svg>
        <h2>No plants yet</h2>
        <p>Add the first one to start your collection. A name is enough, and the rest can wait.</p>
        <div class="first-run-actions">
            <a class="btn btn-primary" href="plants/new">Add a plant</a>
        </div>
        <a class="first-run-help" href="help#plants">More about plants in Help</a>
    </div>
}
else
{
    <div class="plant-filters">
        <input type="search" class="form-control" placeholder="Search by name, genus, species…"
               aria-label="Search plants" @bind="search" @bind:event="oninput" @bind:after="Refresh" />

        <div class="d-flex flex-wrap gap-2">
            <div class="btn-group flex-grow-1" role="radiogroup" aria-label="Status">
                @foreach (var (value, label) in statusOptions)
                {
                    var id = $"status-{value}";
                    <input type="radio" class="btn-check" name="status" id="@id"
                           checked="@(status == value)" @onchange="() => SetStatus(value)" />
                    <label class="btn btn-outline-primary btn-sm" for="@id">@label</label>
                }
            </div>

            @if (HasRoomChoice)
            {
                <select class="form-select form-select-sm w-auto" aria-label="Room"
                        @bind="room" @bind:after="RoomPicked">
                    <option value="">All rooms</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
            }

            <select class="form-select form-select-sm w-auto" aria-label="Sort by"
                    @bind="sort" @bind:after="Refresh">
                @foreach (var (value, label) in sortOptions)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>

        @if (PickedRoom is { Spots.Count: > 0 } picked)
        {
            <div class="spot-filters" role="group" aria-label="Spot in @picked.Name">
                <button type="button" class="room-chip @(spot is null ? "picked" : null)"
                        @onclick="() => PickSpot(null)">All of @picked.Name</button>
                @foreach (var s in picked.Spots)
                {
                    <button type="button" class="room-chip @(s.Id == spot ? "picked" : null)"
                            @onclick="() => PickSpot(s.Id)">@s.Name</button>
                }
            </div>
        }

        @if (TagChoices.Count > 0 || all.Any(p => p.InQuarantine) || all.Any(p => p.IsDormant))
        {
            <div class="tag-filters" role="group" aria-label="Tags">
                @if (all.Any(p => p.InQuarantine))
                {
                    <button type="button" class="chip @(quarantine ? "picked" : null)"
                            aria-pressed="@(quarantine ? "true" : "false")" @onclick="ToggleQuarantine">Quarantine</button>
                }
                @if (all.Any(p => p.IsDormant))
                {
                    <button type="button" class="chip @(dormant ? "picked" : null)"
                            aria-pressed="@(dormant ? "true" : "false")" @onclick="ToggleDormant">Dormant</button>
                }
                @foreach (var t in TagChoices)
                {
                    var on = pickedTags.Contains(t);
                    <button type="button" class="chip @(on ? "picked" : null)" aria-pressed="@(on ? "true" : "false")"
                            @onclick="() => ToggleTag(t)">@t</button>
                }
            </div>
        }
    </div>

    @if (selecting)
    {
        <div class="select-all">
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="SelectAllVisible">Select all shown</button>
            @if (selected.Count > 0)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => selected.Clear()">Clear</button>
            }
        </div>
    }

    @if (visible.Count == 0)
    {
        <div class="empty-state">
            @if (Narrowed)
            {
                <p>No plants match.</p>
                <button type="button" class="btn btn-outline-primary mt-3" @onclick="ClearFilters">Clear filters</button>
            }
            else if (status == StatusFilter.Active)
            {
                <p>None of your plants are in the collection now. The ones that died or left are under Gone.</p>
                <a class="btn btn-primary mt-3" href="plants/new">Add a plant</a>
            }
            else
            {
                <p>No plants here. A plant ends up under Gone when you mark it as died, given away or sold.</p>
            }
        </div>
    }
    else
    {
        <ul class="plant-list">
            @foreach (var plant in visible)
            {
                <li>
                    <PlantCard Plant="plant" Selectable="selecting" Selected="selected.Contains(plant.Id)"
                               OnToggle="Toggle" Moisture="@MoistureFor(plant)" Pests="@PestsFor(plant)"
                               Location="@places.NameOf(plant.PlaceId)" />
                </li>
            }
        </ul>
    }
}

@if (selecting)
{
    <div class="bulk-bar" role="region" aria-label="Actions for selected plants">
        @if (bulkCareOpen)
        {
            <CareSheet PlantIds="@selected.ToList()" OnLogged="AfterBulkCareAsync" OnCancel="() => bulkCareOpen = false" />
        }
        else if (bulkTagOpen)
        {
            <TagPicker @bind-Value="bulkTags" Suggestions="@PlantTags.Suggestions(all ?? [])" Label="Tags to add" />
            <div class="bulk-row">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || bulkTags.Count == 0)"
                        @onclick="AddBulkTagsAsync">Add to @Labels.Plants(selected.Count)</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => bulkTagOpen = false">Cancel</button>
            </div>
        }
        else if (bulkMoveOpen)
        {
            <RoomPicker @bind-Value="bulkPlace" Rooms="rooms" Label="Move to" />
            <div class="bulk-row">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(bulkPlace))"
                        @onclick="MoveBulkAsync">Move @Labels.Plants(selected.Count)</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => bulkMoveOpen = false">Cancel</button>
            </div>
        }
        else if (bulkNoteOpen)
        {
            <textarea class="form-control form-control-sm" rows="2" placeholder="Note for all selected plants, e.g. Sprayed for thrips"
                      aria-label="Note" @bind="bulkNote" @bind:event="oninput"></textarea>
            <div class="bulk-row">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(bulkNote))"
                        @onclick="AddBulkNoteAsync">Add to @Labels.Plants(selected.Count)</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => bulkNoteOpen = false">Cancel</button>
            </div>
        }
        else if (leaving is { } status)
        {
            <div class="bulk-row">
                <span class="bulk-count">@Labels.For(status): what went with @(selected.Count == 1 ? "it" : "them")?</span>
            </div>
            <div class="bulk-row">
                @foreach (var (value, label) in Labels.PotsTakenChoices(SelectedPlants))
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy"
                            @onclick="() => ApplyStatusAsync(status, value)">@label</button>
                }
                <button type="button" class="btn btn-link btn-sm" @onclick="() => leaving = null">Cancel</button>
            </div>
        }
        else
        {
            <div class="bulk-row">
                <span class="bulk-count">@selected.Count selected</span>
                <select class="form-select form-select-sm w-auto" aria-label="Set status" disabled="@(busy || selected.Count == 0)"
                        @bind="bulkStatus" @bind:after="SetBulkStatusAsync">
                    <option value="">Set status…</option>
                    @foreach (var s in Enum.GetValues<PlantStatus>())
                    {
                        <option value="@s">@Labels.For(s)</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || selected.Count == 0)"
                        @onclick="() => bulkCareOpen = true">Log care</button>
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || selected.Count == 0)"
                        @onclick="() => bulkNoteOpen = true">Add note</button>
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || selected.Count == 0)"
                        @onclick="OpenBulkTags">Tag</button>
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(busy || selected.Count == 0)"
                        @onclick="OpenBulkMove">Move</button>
            </div>
        }
        @if (bulkMessage is not null)
        {
            <p class="bulk-message" role="status">@bulkMessage</p>
        }
    </div>
}
else
{
    <a class="fab" href="plants/new" aria-label="Add a plant" title="Add a plant">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
}

@code {
    /// <summary>Starts the list on one tag, e.g. from a tag on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "tag")]
    public string? Tag { get; set; }

    private static readonly (StatusFilter Value, string Label)[] statusOptions =
    [
        (StatusFilter.Active, "In collection"),
        (StatusFilter.Gone, "Gone"),
        (StatusFilter.All, "All")
    ];

    private static readonly (PlantSort Value, string Label)[] sortOptions =
    [
        (PlantSort.Name, "A to Z"),
        (PlantSort.Newest, "Newest"),
        (PlantSort.Room, "By room"),
        (PlantSort.LastActivity, "Last activity")
    ];

    private IReadOnlyList<Plant>? all;
    private IReadOnlyList<Room> rooms = [];
    private Places places = Places.None;
    private List<Plant> visible = [];

    private string? search;
    private StatusFilter status = StatusFilter.Active;
    private string? room; // the picked room's id, as the dropdown gives it
    private Guid? spot;
    private IReadOnlyList<TagCount> tags = [];
    private readonly HashSet<string> pickedTags = new(StringComparer.OrdinalIgnoreCase);
    private bool quarantine;
    private bool dormant;
    private PlantSort sort = PlantSort.Name;
    private Dictionary<Guid, DateTimeOffset> lastActivity = [];

    private bool selecting;
    private readonly HashSet<Guid> selected = [];
    private string bulkStatus = ""; // the "Set status…" dropdown, reset after each use
    private PlantStatus? leaving; // given away or sold, waiting for which pots went too
    private bool bulkNoteOpen;
    private bool bulkCareOpen;
    private bool bulkTagOpen;
    private bool bulkMoveOpen;
    private string? bulkPlace; // as picked, "Living room / Windowsill"
    private List<string> bulkTags = [];
    private IReadOnlyList<CareLog> careLogs = [];
    private IReadOnlyList<PestCase> pestCases = [];
    private string? bulkNote;
    private string? bulkMessage;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (PlantTags.Clean(Tag) is { } tag)
        {
            pickedTags.Add(tag);
            status = StatusFilter.All; // a tag is asked for by name, so show every plant carrying it
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        places = await RoomService.GetPlacesAsync();
        rooms = Room.List(places, all, []);
        tags = PlantTags.InUse(all);
        careLogs = await CareLogRepository.GetAllAsync();
        pestCases = await PestCaseRepository.GetAllAsync();
        lastActivity = PlantActivity.Latest(await Entries.GetLatestPerSubjectAsync(), careLogs);
        Refresh();
    }

    private void SetStatus(StatusFilter value)
    {
        status = value;
        Refresh();
    }

    /// <summary>The room dropdown is worth showing once there's more than one place to choose.</summary>
    private bool HasRoomChoice => rooms.Count > 1 || rooms.Any(r => r.Spots.Count > 0);

    private Room? PickedRoom => rooms.FirstOrDefault(r => r.Id.ToString() == room);

    // Spots belong to the room above them, so picking another room starts over
    private void RoomPicked()
    {
        spot = null;
        Refresh();
    }

    private void PickSpot(Guid? id)
    {
        spot = id;
        Refresh();
    }

    // A picked tag stays on the row even if no plant has it any more, so it can be unpicked
    private IReadOnlyList<string> TagChoices => PlantTags.Normalize([.. tags.Select(t => t.Name), .. pickedTags]);

    private void ToggleTag(string tag)
    {
        if (!pickedTags.Remove(tag))
            pickedTags.Add(tag);
        Refresh();
    }

    private void ToggleQuarantine()
    {
        quarantine = !quarantine;
        Refresh();
    }

    private void ToggleDormant()
    {
        dormant = !dormant;
        Refresh();
    }

    /// <summary>Anything besides the status is narrowing the list.</summary>
    private bool Narrowed =>
        !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(room) || pickedTags.Count > 0 || quarantine || dormant;

    // Leaves the status alone, since its buttons are always in view
    private void ClearFilters()
    {
        search = null;
        room = null;
        spot = null;
        pickedTags.Clear();
        quarantine = false;
        dormant = false;
        Refresh();
    }

    private void Refresh() =>
        visible = new PlantFilter(search, status, PickedPlace is { } place ? places.IdsIn(place) : null,
                pickedTags.Count > 0 ? pickedTags : null, quarantine, dormant, sort, places.NameOf, lastActivity)
            .Apply(all ?? [])
            .ToList();

    private void ToggleSelectMode()
    {
        selecting = !selecting;
        selected.Clear();
        bulkNoteOpen = false;
        bulkCareOpen = false;
        bulkTagOpen = false;
        bulkMoveOpen = false;
        bulkMessage = null;
    }

    private void OpenBulkMove()
    {
        bulkPlace = null;
        bulkMoveOpen = true;
        bulkMessage = null;
    }

    private async Task MoveBulkAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkPlace))
            return;

        busy = true;
        var plants = SelectedPlants;
        var placeId = await RoomService.PlaceIdAsync(bulkPlace);
        var names = await RoomService.GetPlacesAsync();
        var moved = await PlantService.MoveAsync(plants, placeId, Labels.For, id => names.NameOf(id));
        bulkMessage = moved == plants.Count
            ? $"Moved {Labels.Plants(moved)} to {bulkPlace}."
            : $"Moved {Labels.Plants(moved)} to {bulkPlace}. {Labels.Plants(plants.Count - moved)} already there.";
        bulkMoveOpen = false;
        selected.Clear();
        await LoadAsync();
        busy = false;
    }

    private void OpenBulkTags()
    {
        bulkTags = [];
        bulkTagOpen = true;
        bulkMessage = null;
    }

    private void Toggle(Plant plant)
    {
        if (!selected.Remove(plant.Id))
            selected.Add(plant.Id);
        bulkMessage = null;
    }

    private void SelectAllVisible()
    {
        foreach (var plant in visible)
            selected.Add(plant.Id);
    }

    private IReadOnlyList<PestCase> PestsFor(Plant plant) => PestService.CasesFor(plant, pestCases, places);

    /// <summary>The spot when one is picked, otherwise the room.</summary>
    private Guid? PickedPlace => spot ?? PickedRoom?.Id;

    private MoistureReading? MoistureFor(Plant plant) =>
        CareSummary.LatestMoisture(careLogs, plant.Id, Time.Today());

    private async Task AfterBulkCareAsync()
    {
        var count = selected.Count;
        bulkMessage = $"Care logged for {Labels.Plants(count)}.";
        bulkCareOpen = false;
        selected.Clear();
        await LoadAsync();
    }

    private List<Plant> SelectedPlants => (all ?? []).Where(p => selected.Contains(p.Id)).ToList();

    private async Task SetBulkStatusAsync()
    {
        var value = bulkStatus;
        bulkStatus = "";
        if (!Enum.TryParse<PlantStatus>(value, out var newStatus))
            return;

        // Plants leaving with pots get asked which went too; everything else changes straight away
        if (newStatus is PlantStatus.GivenAway or PlantStatus.Sold && Labels.PotsTakenChoices(SelectedPlants).Count > 0)
        {
            leaving = newStatus;
            bulkMessage = null;
            return;
        }

        await ApplyStatusAsync(newStatus, PotsTaken.None);
    }

    private async Task ApplyStatusAsync(PlantStatus newStatus, PotsTaken potsTaken)
    {
        busy = true;
        leaving = null;
        var plants = SelectedPlants;
        await PlantService.SetStatusAsync(plants, newStatus, Labels.For, potsTaken);
        bulkMessage = $"{Labels.For(newStatus)}: {Labels.Plants(plants.Count)} updated.";
        selected.Clear();
        await LoadAsync();
        busy = false;
    }

    private async Task AddBulkTagsAsync()
    {
        busy = true;
        var plants = SelectedPlants;
        var changed = await PlantService.AddTagsAsync(plants, bulkTags);
        bulkMessage = changed == plants.Count
            ? $"Tagged {Labels.Plants(changed)}."
            : $"Tagged {Labels.Plants(changed)}. {Labels.Plants(plants.Count - changed)} already had {(bulkTags.Count == 1 ? "it" : "them")}.";
        bulkTagOpen = false;
        selected.Clear();
        await LoadAsync();
        busy = false;
    }

    private async Task AddBulkNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(bulkNote))
            return;

        busy = true;
        var plants = SelectedPlants;
        await PlantService.AddNoteAsync(plants, bulkNote);
        bulkMessage = $"Note added to {Labels.Plants(plants.Count)}.";
        bulkNote = null;
        bulkNoteOpen = false;
        selected.Clear();
        busy = false;
    }
}
