@page "/kinds-of-care"
@inject OwnCareKindService KindService
@inject ILogger<KindsOfCare> Logger

<PageTitle>@Strings.Care.KindsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="settings?section=care">@Strings.Care.BackToSettings</a>
<h1>@Strings.Care.KindsTitle</h1>

<p class="settings-hint">
    @Strings.Care.KindsHint
</p>

@if (message is not null)
{
    <div class="alert alert-success py-2 px-3" role="status">@message</div>
}

@if (loading)
{
    <p class="text-body-secondary">@Strings.Care.Loading</p>
}
else if (kinds.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Care.KindsEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Care.KindsEmptyText
        </p>
        <button type="button" class="btn btn-primary mt-2" @onclick="StartNew">@Strings.Care.KindsAdd</button>
    </div>
}
else
{
    <div class="form-actions mt-3 mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Care.KindsAddPlus</button>
    </div>

    <section class="settings-section">
        <h2>@Strings.Care.KindsYourKinds</h2>

        <ul class="kind-list">
            @foreach (var kind in kinds)
            {
                <li>
                    <button type="button" class="kind-row" @onclick="() => StartEdit(kind)">
                        <span class="kind-title">@kind.Name</span>
                        <span class="kind-use">@Use(kind)</span>
                    </button>
                </li>
            }
        </ul>
    </section>
}

<Sheet Title="@(editing is null ? Strings.Care.KindsSheetAdd : Strings.Care.KindsSheetEdit)" Open="sheetOpen" OpenChanged="SheetOpenChanged">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    @if (confirmingRemove && editing is not null)
    {
        <p>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.KindsRemoveConfirm, editing.Name))</p>
        <div class="care-actions">
            <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="RemoveAsync">@Strings.Common.Remove</button>
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => confirmingRemove = false">@Strings.Common.Cancel</button>
        </div>
    }
    else
    {
        <OwnKindFields Prefix="kind-edit" @bind-Name="name" @bind-CountsAs="countsAs" @bind-OnHistory="onHistory" />

        @if (editing is not null && countsAs != editing.CountsAs && entryCount > 0)
        {
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="kind-edit-entries" @bind="alsoChange" />
                <label class="form-check-label" for="kind-edit-entries">@Plural.Of(entryCount, Strings.Care.KindsAlsoChange_One, Strings.Care.KindsAlsoChange_Other)</label>
            </div>
        }

        <div class="care-actions">
            <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(name))" @onclick="SaveAsync">
                @(editing is null ? Strings.Common.Add : Strings.Common.Save)
            </button>
            @if (editing is not null)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => confirmingRemove = true">@Strings.Common.Remove</button>
            }
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="CloseSheet">@Strings.Common.Cancel</button>
        </div>
    }
</Sheet>

@code {
    private IReadOnlyList<OwnCareKind> kinds = [];
    private bool loading = true;
    private string? message;

    private bool sheetOpen;
    private OwnCareKind? editing;
    private string name = "";
    private CareKind? countsAs;
    private bool onHistory;
    private int entryCount;
    private bool alsoChange;
    private bool confirmingRemove;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        kinds = await KindService.GetAllAsync();
        loading = false;
    }

    private static string Use(OwnCareKind kind)
    {
        var counts = kind.CountsAs switch
        {
            CareKind.Watered => Strings.Care.KindsUseWatered,
            CareKind.Fertilised => Strings.Care.KindsUseFeed,
            _ => Strings.Care.KindsUseNeither
        };
        return kind.OnHistory ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.KindsUseOnHistory, counts) : counts;
    }

    private void StartNew()
    {
        editing = null;
        name = "";
        countsAs = null;
        onHistory = false;
        Open(0);
    }

    private async Task StartEdit(OwnCareKind kind)
    {
        editing = kind;
        name = kind.Name;
        countsAs = kind.CountsAs;
        onHistory = kind.OnHistory;
        Open(await KindService.EntryCountAsync(kind.Id));
    }

    private void Open(int entries)
    {
        entryCount = entries;
        alsoChange = false;
        confirmingRemove = false;
        error = null;
        message = null;
        sheetOpen = true;
    }

    private void SheetOpenChanged(bool open) => sheetOpen = open;

    private void CloseSheet() => sheetOpen = false;

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (editing is null)
            {
                var trimmed = name.Trim();
                if (kinds.FirstOrDefault(k => string.Equals(k.Name.Trim(), trimmed, StringComparison.CurrentCultureIgnoreCase)) is { } existing)
                {
                    error = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.KindsAlreadyHave, existing.Name);
                    return;
                }
                await KindService.AddAsync(name, countsAs, onHistory);
            }
            else
            {
                var countsChanged = countsAs != editing.CountsAs;
                await KindService.RenameAsync(editing.Id, name);
                await KindService.SetOnHistoryAsync(editing.Id, onHistory);
                var changed = await KindService.SetCountsAsAsync(editing.Id, countsAs, countsChanged && alsoChange);
                if (countsChanged && alsoChange && changed < entryCount)
                    message = string.Format(System.Globalization.CultureInfo.CurrentCulture, entryCount == 1 ? Strings.Care.KindsChanged_One : Strings.Care.KindsChanged_Other, changed, entryCount);
            }

            sheetOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving a kind of care failed");
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveAsync()
    {
        if (editing is null)
            return;

        busy = true;
        try
        {
            await KindService.RemoveAsync(editing.Id);
            sheetOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a kind of care failed");
            error = ex.Message;
            confirmingRemove = false;
        }
        finally
        {
            busy = false;
        }
    }
}
