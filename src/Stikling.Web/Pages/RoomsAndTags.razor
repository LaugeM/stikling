@page "/rooms-and-tags"
@inject RoomService RoomService
@inject ILogger<RoomsAndTags> Logger
@inject PlantService PlantService
@inject IPlantRepository Plants
@inject GrowLightService LightService

<PageTitle>@Strings.Shared.RoomsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadDataAsync" />

<a class="back-link" href="settings?section=data">@Strings.Layout.Settings</a>
<h1>@Strings.Shared.RoomsTitle</h1>

<section class="settings-section">
    <h2 class="section-label">@Strings.Shared.RoomsRooms</h2>
    <p class="settings-hint">@Strings.Shared.RoomsHint</p>

    @if (rooms.Count == 0)
    {
        <div class="empty-state mt-3">
            <p>@Strings.Shared.RoomsEmpty</p>
            <p class="text-body-secondary">@Strings.Shared.RoomsEmptyHint</p>
            @AddRoomControl
        </div>
    }
    else
    {
        <ul class="room-list">
            @foreach (var r in rooms)
            {
                <li>
                    @if (renaming == r.Id)
                    {
                        <RoomRenameRow Name="@r.Name" Busy="busy" OnSave="name => RenameAsync(r.Id, r.Name, name)" OnCancel="StopRenaming" />
                    }
                    else
                    {
                        <div class="room-row">
                            <span class="room-name">@r.Name</span>
                            <span class="room-count">@Held(r.AllPlants, r.AllPropagations)</span>
                            @if (r.Total > 0)
                            {
                                <a class="btn btn-link btn-sm link-action" href="round/@r.Id?from=rooms">@Strings.Shared.RoomsGoRound</a>
                            }
                            <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                    @onclick="() => renaming = r.Id">@Strings.Shared.RoomsRename</button>
                            @if (r.Total == 0)
                            {
                                <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                        @onclick="() => RemoveAsync(r.Id, r.Name)">@Strings.Common.Remove</button>
                            }
                        </div>
                        @LightSwitch(r.Id, r.Name)
                        @OutdoorsSwitch(r.Id, r.Name, false)
                    }

                    @foreach (var spot in r.Spots)
                    {
                        <div class="room-spot">
                            @if (renaming == spot.Id)
                            {
                                <RoomRenameRow Name="@spot.Name" Busy="busy"
                                               OnSave="name => RenameAsync(spot.Id, spot.Place, name)"
                                               OnCancel="StopRenaming" />
                            }
                            else
                            {
                                <div class="room-row">
                                    <span class="room-name">@spot.Name</span>
                                    <span class="room-count">@Held(spot.Plants, spot.Propagations)</span>
                                    <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                            @onclick="() => renaming = spot.Id">@Strings.Shared.RoomsRename</button>
                                    @if (spot.Total == 0)
                                    {
                                        <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                                @onclick="() => RemoveAsync(spot.Id, spot.Name)">@Strings.Common.Remove</button>
                                    }
                                </div>
                                @LightSwitch(spot.Id, spot.Name)
                                @OutdoorsSwitch(spot.Id, spot.Name, placeInfo.Find(r.Id)?.Outdoors == true)
                            }
                        </div>
                    }

                    <div class="room-spot">
                        @if (addingSpotIn == r.Id)
                        {
                            <RoomRenameRow Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsNewSpotIn, r.Name)" Busy="busy"
                                           OnSave="name => AddPlaceAsync(r.Id, name)" OnCancel="StopAddingRoom" />
                        }
                        else
                        {
                            <button type="button" class="btn btn-link btn-sm link-action add-spot" disabled="@busy"
                                    @onclick="() => StartAddingSpot(r.Id)">@Strings.Shared.RoomsAddSpot</button>
                        }
                    </div>
                </li>
            }
        </ul>

        <div class="mt-3">
            @AddRoomControl
        </div>
    }

    @if (roomMessage is not null)
    {
        <p class="settings-message" role="status">@roomMessage</p>
    }
</section>

<section class="settings-section">
    <h2 class="section-label">@Strings.Shared.RoomsTags</h2>
    <p class="settings-hint">@Strings.Shared.RoomsTagsHint</p>

    @if (tags.Count == 0)
    {
        <div class="empty-state mt-3">
            <p>@Strings.Shared.RoomsTagsEmpty</p>
            <p class="text-body-secondary">@Strings.Shared.RoomsTagsEmptyHint</p>
            @AddTagControl
        </div>
    }
    else
    {
        <ul class="room-list">
            @foreach (var t in tags)
            {
                <li>
                    @if (renamingTag == t.Name)
                    {
                        <RoomRenameRow Name="@t.Name" Busy="busy" OnSave="name => RenameTagAsync(t.Name, name)" OnCancel="StopRenamingTag" />
                    }
                    else
                    {
                        <div class="room-row">
                            <span class="room-name">@t.Name</span>
                            <span class="room-count">@Labels.Plants(t.Plants)</span>
                            <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                    @onclick="() => renamingTag = t.Name">@Strings.Shared.RoomsRename</button>
                        </div>
                    }
                </li>
            }
        </ul>

        <div class="mt-3">
            @AddTagControl
        </div>
    }

    @if (tagMessage is not null)
    {
        <p class="settings-message" role="status">@tagMessage</p>
    }
</section>

@code {
    private RenderFragment LightSwitch(Guid placeId, string name) => __builder =>
    {
        var id = $"light-{placeId}";
        <div class="form-check form-switch room-light">
            <input class="form-check-input" type="checkbox" role="switch" id="@id" disabled="@busy"
                   aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsGrowLightIn, name)"
                   checked="@lit.Contains(placeId)" @onchange="e => SetLitAsync(placeId, e.Value is true)" />
            <label class="form-check-label" for="@id">@Strings.Shared.RoomsGrowLight</label>
        </div>
    };

    private RenderFragment OutdoorsSwitch(Guid placeId, string name, bool roomIsOutdoors) => __builder =>
    {
        var id = $"outdoors-{placeId}";
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, roomIsOutdoors ? Strings.Shared.RoomsOutdoorsBecauseRoom : Strings.Shared.RoomsOutdoorsFor, name);
        <div class="form-check form-switch room-light">
            <input class="form-check-input" type="checkbox" role="switch" id="@id" disabled="@(busy || roomIsOutdoors)"
                   aria-label="@label"
                   checked="@(roomIsOutdoors || placeInfo.Find(placeId)?.Outdoors == true)" @onchange="e => SetOutdoorsAsync(placeId, e.Value is true)" />
            <label class="form-check-label" for="@id">@Strings.Shared.RoomsOutdoors</label>
        </div>
    };

    private Places placeInfo = Places.None;

    private async Task SetOutdoorsAsync(Guid placeId, bool on)
    {
        busy = true;
        try
        {
            await RoomService.SetOutdoorsAsync(placeId, on);
            placeInfo = await RoomService.GetPlacesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing whether a room or spot is outdoors failed");
            roomMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsSaveError, ex.Message);
        }

        busy = false;
    }

    private HashSet<Guid> lit = [];

    private async Task SetLitAsync(Guid placeId, bool on)
    {
        busy = true;
        try
        {
            await LightService.SetLitAsync(placeId, on);
            await LoadLightsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing whether a spot has a grow light failed");
            roomMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsLightError, ex.Message);
        }

        busy = false;
    }

    private async Task LoadLightsAsync() =>
        lit = (await LightService.GetAllAsync()).Where(l => !l.IsDeleted && l.PlaceId is not null)
            .Select(l => l.PlaceId!.Value).ToHashSet();

    private RenderFragment AddRoomControl => __builder =>
    {
        if (addingRoom)
        {
            <RoomRenameRow Label="@Strings.Shared.RoomsNewRoom" Busy="busy" OnSave="name => AddPlaceAsync(null, name)" OnCancel="StopAddingRoom" />
        }
        else
        {
            <button type="button" class="btn btn-outline-primary" disabled="@busy"
                    @onclick="StartAddingRoom">@Strings.Shared.RoomsAddRoom</button>
        }
    };

    private RenderFragment AddTagControl => __builder =>
    {
        if (addingTag)
        {
            var shown = ShownPlants;
            <div class="add-form">
                <label class="form-label" for="new-tag-name">@Strings.Shared.RoomsTagLabel</label>
                <input id="new-tag-name" class="form-control" autocomplete="off" placeholder="@Strings.Shared.RoomsTagPlaceholder"
                       value="@newTag" @oninput="TypeTag" />

                <div class="form-label mt-3" id="new-tag-plants">@Strings.Shared.RoomsPutItOn</div>
                @if (activePlants.Count == 0)
                {
                    <p class="text-body-secondary">@Strings.Shared.RoomsNoPlantsToTag</p>
                }
                else
                {
                    @if (activePlants.Count > 10)
                    {
                        <input type="search" class="form-control mb-2" autocomplete="off" aria-label="@Strings.Shared.RoomsSearchPlants"
                               placeholder="@Strings.Shared.RoomsSearchPlants" value="@tagSearch" @oninput="TypeSearch" />
                    }
                    <div class="tag-plants" role="group" aria-labelledby="new-tag-plants">
                        @foreach (var p in shown)
                        {
                            var id = p.Id;
                            <label class="form-check tag-plant">
                                <input type="checkbox" class="form-check-input" checked="@ticked.Contains(id)"
                                       @onchange="e => Toggle(id, (bool)e.Value!)" />
                                <span class="form-check-label">@p.DisplayName</span>
                            </label>
                        }
                        @if (shown.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@Strings.Shared.RoomsNoPlantMatches</p>
                        }
                    </div>
                }

                <div class="add-actions">
                    <button type="button" class="btn btn-primary"
                            disabled="@(busy || PlantTags.Clean(newTag) is null || ticked.Count == 0)"
                            @onclick="AddTagAsync">@Strings.Common.Save</button>
                    <button type="button" class="btn btn-link" disabled="@busy" @onclick="StopAddingTag">@Strings.Common.Cancel</button>
                </div>
            </div>
        }
        else
        {
            <button type="button" class="btn btn-outline-primary" disabled="@busy"
                    @onclick="StartAddingTag">@Strings.Shared.RoomsNewTag</button>
        }
    };

    private bool addingRoom;
    private Guid? addingSpotIn; // the room a spot is being added to
    private bool addingTag;
    private string newTag = "";
    private string tagSearch = "";
    private readonly HashSet<Guid> ticked = [];
    private IReadOnlyList<Plant> activePlants = [];

    private IReadOnlyList<Plant> ShownPlants =>
        string.IsNullOrWhiteSpace(tagSearch)
            ? activePlants
            : activePlants.Where(p => p.DisplayName.Contains(tagSearch.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    private void TypeTag(ChangeEventArgs e) => newTag = e.Value?.ToString() ?? "";

    private void TypeSearch(ChangeEventArgs e) => tagSearch = e.Value?.ToString() ?? "";

    private void Toggle(Guid id, bool on)
    {
        if (on)
            ticked.Add(id);
        else
            ticked.Remove(id);
    }

    private void StartAddingRoom()
    {
        addingRoom = true;
        addingSpotIn = null;
        roomMessage = null;
    }

    private void StartAddingSpot(Guid roomId)
    {
        addingSpotIn = roomId;
        addingRoom = false;
        roomMessage = null;
    }

    private void StopAddingRoom()
    {
        addingRoom = false;
        addingSpotIn = null;
    }

    private void StartAddingTag()
    {
        addingTag = true;
        tagMessage = null;
    }

    private void StopAddingTag()
    {
        addingTag = false;
        newTag = "";
        tagSearch = "";
        ticked.Clear();
    }

    /// <summary>Adds a room, or a spot in the room with this id.</summary>
    private async Task AddPlaceAsync(Guid? roomId, string? name)
    {
        busy = true;
        try
        {
            var (place, existed) = await RoomService.AddPlaceAsync(name, roomId);
            var written = (await RoomService.GetPlacesAsync()).NameOf(place.Id);
            rooms = await RoomService.GetAllAsync();
        placeInfo = await RoomService.GetPlacesAsync();
            roomMessage = existed ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsAlreadyThere, written) : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsAdded, written);
            StopAddingRoom();
        }
        catch (ArgumentException ex)
        {
            // The box stays open, so the name can be fixed
            roomMessage = ex.Message;
        }

        busy = false;
    }

    private async Task RemoveAsync(Guid id, string name)
    {
        busy = true;
        try
        {
            // A plant that another device moves in at the same time can end up pointing at a removed
            // place, which shows as no location. See RoomService.RemoveAsync.
            await RoomService.RemoveAsync(id);
            rooms = await RoomService.GetAllAsync();
        placeInfo = await RoomService.GetPlacesAsync();
            roomMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsRemoved, name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a room or spot failed");
            roomMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsRemoveError, ex.Message);
        }

        busy = false;
    }

    private async Task AddTagAsync()
    {
        busy = true;
        try
        {
            var name = PlantTags.Clean(newTag)!;
            var chosen = activePlants.Where(p => ticked.Contains(p.Id)).ToList();
            var changed = await PlantService.AddTagsAsync(chosen, [name]);
            tags = PlantTags.InUse(await Plants.GetAllAsync());
            tagMessage = changed == 0
                ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagAlready, Labels.Plants(chosen.Count), name)
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagged, Labels.Plants(changed));
            StopAddingTag();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding a tag failed");
            tagMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagError, ex.Message);
        }

        busy = false;
    }

    private IReadOnlyList<Room> rooms = [];
    private Guid? renaming; // the room or spot being renamed
    private string? roomMessage;
    private IReadOnlyList<TagCount> tags = [];
    private string? renamingTag;
    private string? tagMessage;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    /// <summary>What comes from the records, which sync can change while the page is open.</summary>
    private async Task LoadDataAsync()
    {
        rooms = await RoomService.GetAllAsync();
        placeInfo = await RoomService.GetPlacesAsync();
        await LoadLightsAsync();
        var all = await Plants.GetAllAsync();
        tags = PlantTags.InUse(all);
        activePlants = all.Where(p => !p.IsDeleted && p.InCollection)
            .OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    /// <summary>"3 plants, 1 propagation", for the line under a room.</summary>
    private static string Held(int plants, int propagations) => (plants, propagations) switch
    {
        (0, 0) => Strings.Shared.RoomsEmptyPlace,
        (_, 0) => Labels.Plants(plants),
        (0, _) => Plural.Of(propagations, Strings.Shared.RoomsPropagations_One, Strings.Shared.RoomsPropagations_Other),
        _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsPlantsAndPropagations, Labels.Plants(plants), Plural.Of(propagations, Strings.Shared.RoomsPropagations_One, Strings.Shared.RoomsPropagations_Other))
    };

    private void StopRenaming()
    {
        renaming = null;
        roomMessage = null;
    }

    private async Task RenameAsync(Guid id, string from, string? to)
    {
        busy = true;
        try
        {
            var result = await RoomService.RenameAsync(id, to);
            rooms = await RoomService.GetAllAsync();
        placeInfo = await RoomService.GetPlacesAsync();
            roomMessage = (result.Total, result.Merged) switch
            {
                (0, _) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsNothingToRename, from),
                (_, true) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsMovedInto, Held(result.Plants, result.Propagations), result.Name),
                _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsRenamedTo, result.Name, Held(result.Plants, result.Propagations))
            };
            renaming = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Renaming a room or spot failed");
            roomMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsRenameError, ex.Message);
        }

        busy = false;
    }

    private void StopRenamingTag()
    {
        renamingTag = null;
        tagMessage = null;
    }

    private async Task RenameTagAsync(string from, string? to)
    {
        busy = true;
        try
        {
            var name = PlantTags.Clean(to);
            var merged = name is not null && tags.Any(t => PlantTags.Same(t.Name, name) && !PlantTags.Same(t.Name, from));
            var changed = name is null ? 0 : await PlantService.RenameTagAsync(from, name);
            tags = PlantTags.InUse(await Plants.GetAllAsync());
            tagMessage = (changed, merged) switch
            {
                (0, _) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagNothingChanged, from),
                (_, true) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagMerged, Labels.Plants(changed), name),
                _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsTagRenamed, name, Labels.Plants(changed))
            };
            renamingTag = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Renaming a tag failed");
            tagMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.RoomsRenameError, ex.Message);
        }

        busy = false;
    }
}
