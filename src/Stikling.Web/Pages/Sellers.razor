@page "/sellers"
@layout WideLayout
@inject SellerService SellerService
@inject IPlantRepository PlantRepository
@inject IPropagationRepository PropagationRepository

<PageTitle>@Strings.Supplies.SellersPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="supplies">@Strings.Supplies.BackToSupplies</a>
<h1>@Strings.Supplies.SellersTitle</h1>

<p class="settings-hint">
    @Strings.Supplies.SellersIntro
</p>

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (rows.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Supplies.SellersEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Supplies.SellersEmptyHint
        </p>
    </div>
}
else
{
    <section class="settings-section">
        <h2>@Strings.Supplies.SellersYour</h2>

        <ul class="seller-list supply-grid">
            @foreach (var row in rows)
            {
                <li>
                    <a class="seller-row" href="sellers/@row.Seller.Id">
                        <span class="seller-title">@row.Seller.Name</span>
                        <span class="seller-use">@Labels.For(row.Seller.Kind) · @Used(row)</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    private sealed record Row(Seller Seller, int Plants, int Propagations);

    private IReadOnlyList<Row> rows = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var sellers = await SellerService.GetSellersAsync();
        var plants = (await PlantRepository.GetAllAsync()).Where(p => !p.IsDeleted).ToList();
        var propagations = (await PropagationRepository.GetAllAsync()).Where(p => !p.IsDeleted).ToList();

        // Two sellers can share a name after a merge on another device. Both are listed, and merging fixes it.
        rows = sellers.Live
            .Select(s => new Row(
                s,
                plants.Count(p => sellers.For(p.SellerId, p.Source)?.Id == s.Id),
                propagations.Count(p => sellers.For(p.SellerId, p.Source)?.Id == s.Id)))
            .OrderByDescending(r => r.Plants + r.Propagations)
            .ThenBy(r => r.Seller.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        loading = false;
    }

    private static string Used(Row row) => (row.Plants, row.Propagations) switch
    {
        (0, 0) => Strings.Supplies.SellersNothingYet,
        (var plants, 0) => Labels.Plants(plants),
        (0, var propagations) => Plural.Of(propagations, Strings.Supplies.Propagation_One, Strings.Supplies.Propagation_Other),
        var (plants, propagations) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.SellersPlantsAndPropagations,
            Labels.Plants(plants), Plural.Of(propagations, Strings.Supplies.Propagation_One, Strings.Supplies.Propagation_Other))
    };
}
