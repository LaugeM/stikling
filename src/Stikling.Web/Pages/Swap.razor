@page "/swap"
@layout WideLayout
@implements IAsyncDisposable
@inject IPhotoRepository PhotoRepository
@inject SwapCardService Cards
@inject ShareCardService ShareCard
@inject IPlantRepository PlantRepository
@inject IPropagationRepository PropagationRepository
@inject PlantService PlantService
@inject PlantNameService Names
@inject SitterSheetActions Sharer

<PageTitle>@Strings.Shared.SwapPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="propagations">@Strings.Shared.BackToPropagations</a>

<div class="page-heading">
    <h1>@Strings.Shared.SwapTitle</h1>
    @if (list is { IsEmpty: false })
    {
        <button type="button" class="btn btn-outline-primary swap-share" @onclick="OpenShare">@Strings.Shared.ShareButton</button>
    }
</div>

@if (list is null)
{
    <p class="text-body-secondary">@Strings.Shared.Loading</p>
}
else if (list.IsEmpty)
{
    @ConvertPanel
    <div class="empty-state">
        <p>@Strings.Shared.SwapEmptyNothing</p>
        <p>@Strings.Shared.SwapEmptyHow</p>
        <a class="btn btn-outline-primary mt-3" href="plants">@Strings.Shared.SwapGoToPlants</a>
    </div>
}
else
{
    @if (list.Cuttings.Count > 0)
    {
        <h2 class="section-label">@Strings.Shared.SwapCuttings</h2>
        <ul class="item-list list-grid swap-list">
            @foreach (var line in list.Cuttings)
            {
                var propagation = propagationsById[line.SubjectId!.Value];
                <li>
                    <a class="item-card" href="propagations/@propagation.Id">
                        <div class="item-thumb day-thumb" aria-hidden="true">
                            <b>@line.Count</b>
                            <small>@Strings.Shared.SwapToSwap</small>
                        </div>
                        <div class="item-text">
                            <div class="item-name">@propagation.ListName</div>
                            <div class="item-meta">
                                <span class="visually-hidden">@Plural.Of(line.Count, Strings.Common.Cutting_One, Strings.Common.Cutting_Other),</span>
                                <StageBadge Stage="propagation.Stage" Type="propagation.Type" />
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }

    @if (list.OnRequest.Count > 0)
    {
        <h2 class="section-label">@Strings.Shared.SwapOnRequest</h2>
        <ul class="item-list list-grid swap-list">
            @foreach (var line in list.OnRequest)
            {
                <li>@PlantRow(plantsById[line.SubjectId!.Value])</li>
            }
        </ul>
    }

    @if (list.Plants.Count > 0)
    {
        <h2 class="section-label">@Strings.Shared.SwapPlants</h2>
        <ul class="item-list list-grid swap-list">
            @foreach (var line in list.Plants)
            {
                <li>@PlantRow(plantsById[line.SubjectId!.Value])</li>
            }
        </ul>
    }

    @ConvertPanel
}

<Sheet Title="@Strings.Shared.SwapShareTitle" @bind-Open="shareOpen">
    <div class="btn-group segmented w-100 swap-tabs" role="radiogroup" aria-label="@Strings.Shared.SwapWhatToShare">
        @foreach (var (value, label) in new[] { ("picture", Strings.Shared.SwapTabPicture), ("text", Strings.Shared.SwapTabText) })
        {
            var id = $"swap-tab-{value}";
            <input type="radio" class="btn-check" name="swap-tab" id="@id"
                   checked="@(tab == value)" @onchange="() => SetTab(value)" />
            <label class="btn btn-outline-primary" for="@id">@label</label>
        }
    </div>
    <div class="swap-options">
        <div class="form-check form-switch">
            <input id="swap-nicknames" type="checkbox" class="form-check-input" role="switch" @bind="nicknames" @bind:after="NicknamesChangedAsync" />
            <label class="form-check-label" for="swap-nicknames">@Strings.Shared.SwapNicknames</label>
        </div>
        @if (tab == "text")
        {
            <div class="form-check form-switch">
                <input id="swap-footer" type="checkbox" class="form-check-input" role="switch" @bind="footer" />
                <label class="form-check-label" for="swap-footer">@Strings.Shared.SwapFooter</label>
            </div>
        }
    </div>
    @if (tab == "picture")
    {
        <div class="swap-label" id="swap-format-label">@Strings.Shared.SwapSize</div>
        <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="swap-format-label">
            @foreach (var (value, label) in ShareCardService.Formats)
            {
                var id = $"swap-format-{value}";
                <input type="radio" class="btn-check" name="swap-format" id="@id"
                       checked="@(format == value)" @onchange="() => SetFormatAsync(value)" />
                <label class="btn btn-outline-primary" for="@id">@label</label>
            }
        </div>
        <div class="swap-pictures" style="@AspectStyle">
            @for (var i = 0; i < specs.Count; i++)
            {
                var number = i + 1;
                var spec = specs[i];
                <div class="swap-picture" aria-busy="@(drawn.ContainsKey(spec.Id) ? null : "true")">
                    @if (drawn.TryGetValue(spec.Id, out var picture))
                    {
                        <img src="@picture.Url" alt="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.SwapPictureAlt, number, specs.Count)" />
                    }
                </div>
            }
        </div>
        @if (MissingPhotos > 0)
        {
            <p class="swap-note">@Plural.Of(MissingPhotos, Strings.Shared.SwapMissingPhotos_One, Strings.Shared.SwapMissingPhotos_Other)</p>
        }
        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(!AllDrawn)" @onclick="SharePicturesAsync">@Strings.Shared.ShareButton</button>
            <button type="button" class="btn btn-outline-primary" disabled="@(!AllDrawn)" @onclick="SavePicturesAsync">@Strings.Shared.SwapSave</button>
            @if (status.Length > 0)
            {
                <span class="swap-status" role="status">@status</span>
            }
        </div>
    }
    else
    {
        <pre class="swap-preview" aria-label="@Strings.Shared.SwapPreview">@ShareText</pre>
        <div class="form-actions">
            <button type="button" class="btn btn-primary" @onclick="ShareAsync">@Strings.Shared.ShareButton</button>
            @if (status.Length > 0)
            {
                <span class="swap-status" role="status">@status</span>
            }
        </div>
    }
</Sheet>

<canvas @ref="canvas" hidden aria-hidden="true"></canvas>

@code {
    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<Propagation> propagations = [];
    private Dictionary<Guid, Plant> plantsById = [];
    private Dictionary<Guid, Propagation> propagationsById = [];
    private IReadOnlyList<Plant> tagged = [];
    private EverydayNameBook? everyday;
    private SwapList? list;
    private bool nicknames;
    private bool footer = true;
    private bool shareOpen;
    private bool busy;
    private bool disposed;
    private string status = "";
    private IReadOnlyList<Photo> photos = [];
    private string tab = "picture";
    private string format = "square";
    private IReadOnlyList<SwapCardSpec> specs = [];
    private readonly Dictionary<string, SwapCardDrawn> drawn = [];
    private ElementReference canvas;
    private int drawRun;

    protected override async Task OnInitializedAsync()
    {
        format = await ShareCard.GetFormatAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        plants = await PlantRepository.GetAllAsync();
        propagations = await PropagationRepository.GetAllAsync();
        plantsById = plants.ToDictionary(p => p.Id);
        propagationsById = propagations.ToDictionary(p => p.Id);
        photos = [.. (await PhotoRepository.GetOfKindAsync(SubjectType.Plant)).Concat(await PhotoRepository.GetOfKindAsync(SubjectType.Propagation))];
        tagged = PlantService.TaggedForSwap(plants);
        list = SwapLists.Build(plants, propagations);

        // The sheet is open while changes arrive, so its pictures follow the list
        if (shareOpen && tab == "picture" && !disposed)
        {
            StateHasChanged();
            await DrawAsync();
        }
    }

    private async Task ConvertAsync(SpareMark mark)
    {
        busy = true;
        await PlantService.SetSpareAsync(tagged, mark);
        await LoadAsync();
        busy = false;
    }

    // Plants tagged For swap before marks existed. The tag is left on
    private RenderFragment ConvertPanel => @<text>
        @if (tagged.Count > 0)
        {
            <section class="swap-convert" aria-labelledby="swap-convert-title">
                <h2 id="swap-convert-title" class="swap-convert-title">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.SwapConvertTitle, Labels.Plants(tagged.Count))</h2>
                <p>@Plural.Of(tagged.Count, Strings.Shared.SwapConvertBody_One, Strings.Shared.SwapConvertBody_Other)</p>
                <div class="swap-convert-actions">
                    <button type="button" class="btn btn-primary swap-choice" disabled="@busy" @onclick="() => ConvertAsync(SpareMark.CuttingsToSpare)">@Strings.Shared.SwapConvertCuttings</button>
                    <button type="button" class="btn btn-outline-primary swap-choice" disabled="@busy" @onclick="() => ConvertAsync(SpareMark.UpForSwap)">@Plural.Of(tagged.Count, Strings.Shared.SwapConvertItself_One, Strings.Shared.SwapConvertItself_Other)</button>
                </div>
            </section>
        }
    </text>;

    private RenderFragment PlantRow(Plant plant) => @<a class="item-card" href="plants/@plant.Id">
        <SubjectThumb Subject="plant" />
        <div class="item-text">
            <div class="item-name">@plant.DisplayName</div>
            @if (!string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is { } botanical)
            {
                <div class="item-sub">@botanical</div>
            }
            else if (everyday?.For(plant.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(plant.Species, plant.NameQualifier), plant.Cultivar) is { } called)
            {
                <div class="item-sub everyday-name">@called</div>
            }
        </div>
    </a>;

    private string ShareText => SwapLists.WriteSwap(plants, propagations, (g, s, c) => everyday?.For(g, s, c), nicknames, footer);

    private string AspectStyle => format switch
    {
        "square" => "--aspect: 1 / 1;",
        "portrait" => "--aspect: 4 / 5;",
        _ => "--aspect: 9 / 16;",
    };

    private bool AllDrawn => specs.Count > 0 && specs.All(s => drawn.ContainsKey(s.Id));

    private int MissingPhotos => drawn.Values.Sum(d => d.Missing);

    private async Task OpenShare()
    {
        status = "";
        shareOpen = true;
        if (tab == "picture")
            await DrawAsync();
    }

    private async Task SetTab(string value)
    {
        tab = value;
        status = "";
        if (value == "picture")
            await DrawAsync();
    }

    private async Task SetFormatAsync(string value)
    {
        format = value;
        status = "";
        await ShareCard.SetFormatAsync(value);
        await DrawAsync();
    }

    private async Task NicknamesChangedAsync()
    {
        if (tab == "picture")
            await DrawAsync();
    }

    // Draws the pictures in turn on the one canvas. A newer call takes over, so an older one stops
    // where it is and never puts its picture in after the newer one's.
    private async Task DrawAsync()
    {
        var run = ++drawRun;
        var old = specs.Select(s => s.Id).ToList();
        specs = SwapCardService.SpecsFor(SwapTiles.For(plants, propagations, photos, nicknames), format);
        drawn.Clear();
        await Cards.ReleaseAsync(old);
        StateHasChanged();

        foreach (var spec in specs)
        {
            try
            {
                var result = await Cards.DrawAsync(canvas, spec);
                if (run != drawRun || disposed)
                    return;
                if (result is not null)
                {
                    drawn[spec.Id] = result;
                    StateHasChanged();
                }
            }
            catch (JSException)
            {
                // Share and Save stay off, so say why. Picking another size draws them again
                status = Strings.Shared.SwapDrawFailed;
                StateHasChanged();
                return;
            }
        }
    }

    private IReadOnlyList<string> PictureIds => [.. specs.Select(s => s.Id)];

    private IReadOnlyList<string> FileNames => [.. specs.Select((_, i) => SwapCardService.FileNameFor(i, specs.Count))];

    private async Task SharePicturesAsync() => await ShowStatusAsync(await Cards.ShareAllAsync(PictureIds, FileNames) switch
    {
        "saved" => Strings.Shared.SwapSaved,
        "failed" => Strings.Shared.ShareFailed,
        _ => ""
    });

    private async Task SavePicturesAsync() => await ShowStatusAsync(await Cards.SaveAllAsync(PictureIds, FileNames) switch
    {
        "saved" => Strings.Shared.SwapSaved,
        _ => Strings.Shared.ShareFailed
    });

    private async Task ShareAsync() => await ShowStatusAsync(await Sharer.ShareTextAsync(ShareText) switch
    {
        "copied" => Strings.Shared.ShareCopied,
        "failed" => Strings.Shared.ShareFailed,
        _ => ""
    });

    private async Task ShowStatusAsync(string text)
    {
        status = text;
        if (status.Length == 0)
            return;

        StateHasChanged();
        await Task.Delay(3000);
        if (!disposed && status == text)
        {
            status = "";
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        drawRun++;
        await Cards.ReleaseAsync(specs.Select(s => s.Id));
    }
}
