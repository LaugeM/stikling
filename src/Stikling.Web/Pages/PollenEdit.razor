@page "/pollen/new"
@page "/pollen/{Id:guid}/edit"
@attribute [NeedsAccess(AccessLevel.Edit)]
@inject PollenService Pollens
@inject IPlantRepository PlantRepository
@inject ILogger<PollenEdit> Logger
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@(IsNew ? Strings.Crosses.PollenEditNewTitle : Strings.Crosses.PollenEditTitle) · Stikling</PageTitle>

@* No ReloadOnSync: like other edit pages, nothing changes under someone filling in the form *@

<a class="back-link" href="@BackHref">@BackText</a>
<h1>@(IsNew ? Strings.Crosses.PollenEditNewTitle : Strings.Crosses.PollenEditTitle)</h1>

@if (pollen is null)
{
    <p class="text-body-secondary">@(notFound ? Strings.Crosses.PollenNotFound : Strings.Shared.Loading)</p>
}
else
{
    <EditForm Model="pollen" OnSubmit="SaveAsync" class="edit-form" novalidate>
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>@Strings.Crosses.PollenWhat</legend>
            <ParentPicker Id="pollen-from" Label="@Strings.Crosses.PollenFrom" Plants="plants"
                          PlantId="pollen.FromPlantId" PlantIdChanged="FromPlantChanged"
                          @bind-Name="pollen.FromName" />
            <div class="mb-3">
                <label class="form-label" for="pollen-genus">@Strings.Crosses.PollenGenus</label>
                <InputText id="pollen-genus" class="form-control" maxlength="60" @bind-Value="pollen.Genus" />
                <div class="form-text">@Strings.Crosses.PollenGenusHint</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="pollen-collected">@Strings.Crosses.PollenCollectedOn</label>
                <InputDate id="pollen-collected" class="form-control" @bind-Value="pollen.CollectedOn" max="@Time.Today().ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pollen-kept">@Strings.Crosses.PollenKeptIn</label>
                <select id="pollen-kept" class="form-select" value="@(pollen.KeptIn?.ToString() ?? "")" @onchange="e => SetKept(e.Value?.ToString())">
                    <option value="">@Strings.Crosses.NotSaid</option>
                    @foreach (var kept in Enum.GetValues<PollenStorage>())
                    {
                        <option value="@kept">@PollenService.Where(kept)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="pollen-amount">@Strings.Crosses.PollenAmount</label>
                <InputText id="pollen-amount" class="form-control" maxlength="80" @bind-Value="pollen.Amount" placeholder="@Strings.Crosses.PollenAmountPlaceholder" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pollen-used">@Strings.Crosses.LotUsedUpOn</label>
                <InputDate id="pollen-used" class="form-control" @bind-Value="pollen.UsedUpOn" />
                <div class="form-text">@Strings.Crosses.PollenUsedUpHint</div>
            </div>
            <div class="mb-1">
                <label class="form-label" for="pollen-note">@Strings.Crosses.Note</label>
                <InputTextArea id="pollen-note" class="form-control" rows="3" @bind-Value="pollen.Note" />
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@saving">@Strings.Common.Save</button>
            <a class="btn btn-link" href="@BackHref">@Strings.Common.Cancel</a>
        </div>
    </EditForm>

    @if (!IsNew)
    {
        <section class="danger-zone">
            @if (confirmDelete)
            {
                <p class="mb-2">@Strings.Crosses.PollenDeleteConfirm</p>
                <button class="btn btn-danger btn-sm" disabled="@saving" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
            }
            else
            {
                <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">@Strings.Common.Delete</button>
            }
        </section>
    }
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The plant to collect pollen from, for a new piece.</summary>
    [SupplyParameterFromQuery(Name = "plant")]
    public Guid? PlantId { get; set; }

    private Pollen? pollen;
    private IReadOnlyList<Plant> plants = [];
    private bool notFound;
    private bool saving;
    private bool confirmDelete;
    private List<string> errors = [];
    private (Guid?, Guid?) loadedFor;
    private bool loaded;

    private bool IsNew => Id is null;

    private string BackHref => IsNew && PlantId is { } plantId ? $"plants/{plantId}" : "pollen";

    private string BackText => IsNew && PlantId is not null ? Strings.Crosses.BackToPlant : Strings.Crosses.PollenTitle;

    protected override async Task OnParametersSetAsync()
    {
        var key = (Id, PlantId);
        if (loaded && loadedFor == key)
            return;

        loaded = true;
        loadedFor = key;
        notFound = false;
        errors = [];
        confirmDelete = false;
        pollen = null;
        plants = [.. (await PlantRepository.GetAllAsync()).OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase)];

        if (IsNew)
        {
            pollen = PlantId is { } id && plants.FirstOrDefault(p => p.Id == id) is { } plant
                ? PollenService.StartFrom(plant, Time.Today())
                : new Pollen { CollectedOn = Time.Today() };
            return;
        }

        pollen = (await Pollens.GetAsync(Id!.Value))?.Copy();
        notFound = pollen is null;
    }

    // Picking a plant fills in its genus and species, which stay on the pollen if the plant goes
    private void FromPlantChanged(Guid? id)
    {
        pollen!.FromPlantId = id;
        if (id is { } plantId && plants.FirstOrDefault(p => p.Id == plantId) is { } plant)
        {
            pollen.Genus = plant.Genus;
            pollen.Species = plant.KnownSpecies;
        }
    }

    private void SetKept(string? value) =>
        pollen!.KeptIn = Enum.TryParse<PollenStorage>(value, out var kept) ? kept : null;

    private async Task SaveAsync()
    {
        if (pollen is null)
            return;

        pollen.FromName = Clean(pollen.FromName);
        pollen.Genus = Clean(pollen.Genus);
        pollen.Species = Clean(pollen.Species);
        pollen.Amount = Clean(pollen.Amount);
        pollen.Note = Clean(pollen.Note);

        errors = [.. pollen.Validate(Time.Today())];
        if (errors.Count > 0)
            return;

        saving = true;
        try
        {
            await Pollens.SaveAsync(pollen);
            Navigation.NavigateTo("pollen");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the pollen failed");
            errors = [F(Strings.Crosses.SaveError, ex.Message)];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (pollen is null)
            return;

        saving = true;
        try
        {
            await Pollens.DeleteAsync(pollen.Id);
            Navigation.NavigateTo("pollen");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting the pollen failed");
            errors = [F(Strings.Crosses.DeleteError, ex.Message)];
            confirmDelete = false;
        }
        finally
        {
            saving = false;
        }
    }

    private static string? Clean(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
