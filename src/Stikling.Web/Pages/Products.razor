@using System.Globalization
@page "/products"
@inject IProductRepository Repository
@inject ProductService ProductService
@inject IJSRuntime JS

<PageTitle>Products · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="supplies">Supplies</a>
<h1>Products</h1>

<p class="settings-hint">
    Your fertilisers, stimulants, silica and anything else that goes in the water, each with the
    dose you usually use. Logging a feed fills the dose in, and you can change it for that one time.
    A care entry keeps the name and dose it was logged with, so editing a product here doesn't
    change what you've already logged.
</p>

@if (errors.Count > 0)
{
    <div id="form-errors" class="alert alert-danger" role="alert" tabindex="-1">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section">
        <h2>@(editing ? "Edit product" : "Add a product")</h2>

        <div class="mb-3">
            <label class="form-label" for="product-name">Name</label>
            <input id="product-name" class="form-control" placeholder="e.g. Hydro fertiliser" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">What it is</div>
            <div class="chip-row" role="group" aria-label="What it is">
                @foreach (var kind in Enum.GetValues<ProductKind>())
                {
                    <button type="button" class="chip @Picked(draft.Kind == kind)"
                            aria-pressed="@(draft.Kind == kind ? "true" : "false")"
                            @onclick="() => draft.Kind = kind">@Labels.For(kind)</button>
                }
            </div>
            <div class="form-text">A feed uses this to check that silica goes in first and pH last.</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="product-dose">Usual dose</label>
            <DoseInput Id="product-dose" Small="false" Unit="draft.Unit"
                       @bind-Amount="draft.DefaultDose" @bind-Per="draft.Per" @bind-PerUnit="draft.PerUnit" />
            <div class="chip-row mt-2" role="group" aria-label="What the product is measured in">
                @foreach (var unit in Enum.GetValues<DoseUnit>())
                {
                    <button type="button" class="chip @Picked(draft.Unit == unit)"
                            aria-pressed="@(draft.Unit == unit ? "true" : "false")"
                            @onclick="() => draft.Unit = unit">@Labels.For(unit)</button>
                }
            </div>
            <div class="form-text">
                The way the bottle puts it, e.g. 5 ml per 4 L. Leave the dose empty if you don't know it yet.
            </div>
        </div>

        <div class="mb-3">
            <div class="form-label">What's in it</div>
            @if (draft.Kind == ProductKind.Fertiliser)
            {
                <div class="nutrient-npk">
                    @foreach (var nutrient in Npk)
                    {
                        var id = $"product-{nutrient}";
                        <div>
                            <label class="form-label" for="@id">@NutrientInfo.Symbol(nutrient)</label>
                            <div class="input-group">
                                <input id="@id" class="form-control" type="text" inputmode="decimal" autocomplete="off"
                                       value="@TextOf(nutrient)" @oninput="e => SetNpk(nutrient, e.Value?.ToString())" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    }
                </div>
            }
            @foreach (var nutrient in Rows)
            {
                var id = $"product-{nutrient}";
                <div class="nutrient-row">
                    <label class="nutrient-name" for="@id">@Labels.For(nutrient)</label>
                    <div class="input-group">
                        <input id="@id" class="form-control" type="text" inputmode="decimal" autocomplete="off"
                               value="@TextOf(nutrient)" @oninput="e => texts[nutrient] = e.Value?.ToString() ?? string.Empty" />
                        <span class="input-group-text">%</span>
                    </div>
                    <button type="button" class="nutrient-remove" aria-label="Remove @Labels.For(nutrient)"
                            @onclick="() => RemoveNutrient(nutrient)"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                </div>
            }
            @if (adding)
            {
                <div class="chip-row mt-2" role="group" aria-label="Nutrients to add">
                    @foreach (var nutrient in Addable)
                    {
                        <button type="button" class="chip" @onclick="() => AddNutrient(nutrient)">
                            @Labels.For(nutrient)
                        </button>
                    }
                </div>
            }
            else if (Addable.Count > 0)
            {
                <button type="button" class="btn btn-link px-0" @onclick="() => adding = true">+ Add a nutrient</button>
            }
            <div class="form-text">As printed on the label, in %.</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="product-notes">Notes</label>
            <textarea id="product-notes" class="form-control" rows="2" @bind="draft.Notes"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">
                @(editing ? "Save changes" : "Add product")
            </button>
            <button type="button" class="btn btn-link" @onclick="Cancel">Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">+ Add a product</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>No products yet.</p>
        <p class="text-body-secondary">
            A product is anything you add to the water, like a fertiliser, silica or a rooting stimulant.
            Start with the fertiliser you use most. A name is enough; the dose can wait until you
            next have the bottle in your hand.
        </p>
    </div>
}
else
{
    <section class="settings-section">
        <h2>Your products</h2>

        <ul class="product-list">
            @foreach (var use in uses)
            {
                <li>
                    @if (confirming == use.Product.Id)
                    {
                        <div class="product-confirm">
                            <p>@DeleteWarning(use)</p>
                            <div class="care-actions">
                                <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                        @onclick="() => DeleteAsync(use.Product)">Delete</button>
                                <button type="button" class="btn btn-link btn-sm"
                                        @onclick="() => confirming = null">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="product-head">
                            <span class="product-title">@use.Product.Name</span>
                            <span class="product-dose-text">@(use.Product.DoseText ?? "no usual dose")</span>
                        </div>
                        <div class="product-use">@Labels.For(use.Product.Kind) · @Used(use)</div>
                        @if (use.Product.NutrientText is { } nutrientText)
                        {
                            <div class="product-use">@nutrientText</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(use.Product.Notes))
                        {
                            <div class="product-use">@use.Product.Notes</div>
                        }
                        <div class="care-actions">
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => StartEdit(use.Product)">Edit</button>
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => confirming = use.Product.Id">Delete</button>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    private IReadOnlyList<ProductUse> uses = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    /// <summary>Set when errors were just found, so the next render brings them into view above a long form.</summary>
    private bool showErrors;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showErrors)
            return;
        showErrors = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("showAlert", "form-errors");
    }

    private Product? draft;
    private bool editing;
    private Guid? confirming;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        uses = await ProductService.GetAllAsync();
        loading = false;
    }

    private static string? Picked(bool picked) => picked ? "picked" : null;

    private static readonly Nutrient[] Npk = [Nutrient.Nitrogen, Nutrient.Phosphorus, Nutrient.Potassium];

    // What was typed for each nutrient, and which nutrients have a box or a row, in the order added.
    private readonly Dictionary<Nutrient, string> texts = [];
    private readonly List<Nutrient> listed = [];
    private bool adding;

    private bool NpkBoxes => draft?.Kind == ProductKind.Fertiliser;

    /// <summary>The rows under the N, P and K boxes. For anything but a fertiliser, N, P and K are rows too.</summary>
    private IEnumerable<Nutrient> Rows => listed.Where(n => !(NpkBoxes && Npk.Contains(n)));

    private List<Nutrient> Addable => Enum.GetValues<Nutrient>()
        .Where(n => !listed.Contains(n) && !(NpkBoxes && Npk.Contains(n)))
        .ToList();

    private string TextOf(Nutrient nutrient) => texts.GetValueOrDefault(nutrient, "");

    private void SetNpk(Nutrient nutrient, string? text)
    {
        texts[nutrient] = text ?? "";
        if (string.IsNullOrWhiteSpace(text))
            listed.Remove(nutrient);
        else if (!listed.Contains(nutrient))
            listed.Add(nutrient);
    }

    private void AddNutrient(Nutrient nutrient)
    {
        if (!listed.Contains(nutrient))
            listed.Add(nutrient);
        texts.TryAdd(nutrient, "");
        adding = false;
    }

    private void RemoveNutrient(Nutrient nutrient)
    {
        listed.Remove(nutrient);
        texts.Remove(nutrient);
    }

    private void LoadNutrients(Product product)
    {
        texts.Clear();
        listed.Clear();
        adding = false;
        foreach (var amount in product.Nutrients)
        {
            listed.Add(amount.Nutrient);
            texts[amount.Nutrient] = Doses.Number(amount.Percent);
        }
    }

    /// <summary>Builds the list from what was typed. A box or row left empty is dropped.</summary>
    private bool TryReadNutrients(Product product)
    {
        var read = new List<NutrientAmount>();
        foreach (var nutrient in listed)
        {
            var text = TextOf(nutrient).Trim().Replace(',', '.');
            if (text.Length == 0)
                continue;
            if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var percent))
            {
                errors = [$"{Labels.For(nutrient)} has to be a number."];
                showErrors = true;
                return false;
            }
            read.Add(new NutrientAmount { Nutrient = nutrient, Percent = percent });
        }
        product.Nutrients = read;
        return true;
    }

    /// <summary>"used on 4 plants, last 12 Sep 2026".</summary>
    private static string Used(ProductUse use) => use.LastUsed is { } last
        ? $"used on {Labels.Plants(use.Plants)}, last {Labels.Date(last)}"
        : "not logged yet";

    private static string DeleteWarning(ProductUse use) => use.Plants == 0
        ? $"Delete {use.Product.Name}?"
        : $"Delete {use.Product.Name}? It's been logged on {Labels.Plants(use.Plants)}, and those entries keep its name and dose.";

    private void StartNew()
    {
        editing = false;
        errors = [];
        confirming = null;
        draft = new Product();
        LoadNutrients(draft);
    }

    private void StartEdit(Product product)
    {
        editing = true;
        errors = [];
        confirming = null;
        draft = product.Copy();
        LoadNutrients(draft);
    }

    private void Cancel()
    {
        draft = null;
        editing = false;
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (draft is null)
            return;

        draft.Name = draft.Name?.Trim();
        draft.Notes = string.IsNullOrWhiteSpace(draft.Notes) ? null : draft.Notes.Trim();

        if (!TryReadNutrients(draft))
            return;

        errors = draft.Validate().ToList();
        if (errors.Count > 0)
        {
            showErrors = true;
            return;
        }

        busy = true;
        try
        {
            await Repository.SaveAsync(draft);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
            showErrors = true;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(Product product)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(product.Id);
            confirming = null;
            if (draft?.Id == product.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
