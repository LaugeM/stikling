@page "/plants/new"
@page "/plants/{Id:guid}/edit"
@inject IPlantRepository Repository
@inject IPropagationRepository Propagations
@inject IPotRepository PotRepository
@inject ISoilMixRepository MixRepository
@inject PlantService PlantService
@inject RoomService RoomService
@inject PhotoService Photos
@inject NavigationManager Navigation
@inject TimeProvider Time
@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Add plant" : "Edit plant") · Stikling</PageTitle>

<a class="back-link" href="@(IsNew ? "plants" : $"plants/{Id}")">Back</a>
<h1>@(IsNew ? "Add plant" : "Edit plant")</h1>

@if (IsNew && CopyOfId is null && ParentId is null)
{
    <p class="form-text">Adding several? <a href="plants/quick-add">Quick add</a></p>
}

@if (plant is null)
{
    <p class="text-body-secondary">@(notFound ? "That plant doesn't exist." : "Loading…")</p>
}
else
{
    <EditForm Model="plant" OnSubmit="SaveAsync" class="edit-form">
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>Name</legend>
            <div class="mb-3">
                <label class="form-label" for="nickname">Nickname</label>
                <InputText id="nickname" class="form-control" @bind-Value="plant.Nickname" placeholder="e.g. Big Monstera" />
            </div>
            <PlantNameFields @bind-Genus="plant.Genus" @bind-Species="plant.Species" @bind-Cultivar="plant.Cultivar" />
            <div class="form-text">Give it a nickname, a genus, or both.</div>
            @if (IsNew && CopyOfId is null && ParentId is null && PlantMatches.SameName(plant, existing) is { Count: > 0 } same)
            {
                <p class="form-text already-have">
                    You already have
                    @for (var i = 0; i < same.Count; i++)
                    {
                        var match = same[i];
                        @(i == 0 ? "" : i == same.Count - 1 ? " and " : ", ")<a href="plants/@match.Id">@match.DisplayName</a>
                    }.
                    Adding it again makes another one.
                </p>
            }
        </fieldset>

        <fieldset>
            <legend>Where it came from</legend>
            <div class="mb-3">
                <label class="form-label" for="origin">How you got it</label>
                <InputSelect id="origin" class="form-select" @bind-Value="plant.Origin">
                    @foreach (var origin in Enum.GetValues<PlantOrigin>())
                    {
                        <option value="@origin">@Labels.For(origin)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <LooseDateInput @bind-Value="plant.AcquiredOn" Today="Today" Label="When you got it" />
                <div class="form-text">If you only remember the month or the year, pick that rather than guessing a day.</div>
                @if (copiedDate is { } sameDate && sameDate != LooseDate.Of(Today))
                {
                    @if (plant.AcquiredOn == sameDate)
                    {
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => plant.AcquiredOn = LooseDate.Of(Today)">Use today instead</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => plant.AcquiredOn = sameDate">Same date as @copiedFrom (@sameDate.Text())</button>
                    }
                }
            </div>

            @if (ShowParent)
            {
                <div class="mb-3">
                    <label class="form-label" for="parent">Parent plant</label>
                    <InputSelect id="parent" class="form-select" @bind-Value="plant.ParentPlantId">
                        <option value="">Not one of mine / unknown</option>
                        @foreach (var p in possibleParents)
                        {
                            <option value="@p.Id">@p.DisplayName</option>
                        }
                    </InputSelect>
                    @if (IsNew && plant.ParentPlantId is { } parentId)
                    {
                        <div class="form-text">
                            This is for a plant that already grows on its own. Still rooting?
                            <a href="propagations/new?parent=@parentId">Start a propagation instead</a>,
                            and pot it up when it's ready.
                        </div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="source">Source</label>
                <InputText id="source" class="form-control" @bind-Value="plant.Source" placeholder="Shop, friend, plant swap…" />
            </div>
        </fieldset>

        @if (IsNew)
        {
            <fieldset>
                <legend>Photo</legend>
                @if (photos.Count > 0)
                {
                    <div class="photo-picks">
                        @foreach (var photo in photos)
                        {
                            <div class="photo-pick">
                                <PhotoImage PhotoId="photo.Id" Alt="Photo of the new plant" />
                                <button type="button" class="photo-remove" @onclick="() => RemovePhotoAsync(photo)"
                                        aria-label="Remove photo" title="Remove photo">✕</button>
                            </div>
                        }
                    </div>
                }

                <div class="composer-row">
                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@cameraId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Camera
                    </label>
                    <input id="@cameraId" type="file" accept="image/*" capture="environment" class="visually-hidden"
                           @ref="cameraInput" @onchange="() => AddPhotosAsync(cameraInput, fromCamera: true)" disabled="@busy" />

                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@galleryId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-5 4 4 3-3 4 4" /></svg>
                        Gallery
                    </label>
                    <input id="@galleryId" type="file" accept="image/*" multiple class="visually-hidden"
                           @ref="galleryInput" @onchange="() => AddPhotosAsync(galleryInput, fromCamera: false)" disabled="@busy" />
                </div>

                <div class="form-text">The first photo becomes the cover. You can add more later on the plant's page.</div>
                @if (photoStatus is not null)
                {
                    <p class="composer-status" role="status">@photoStatus</p>
                }
            </fieldset>
        }

        <fieldset>
            <legend>Notes</legend>
            <InputTextArea class="form-control" rows="3" @bind-Value="plant.Notes" aria-label="Notes" />
        </fieldset>

        <h2 class="section-label">More details</h2>
        <div class="more-details mb-4">
            <FormSection Title="Where it lives" Summary="@LivesSummary" Open="openLives">
                <div class="mb-3">
                    <RoomPicker @bind-Value="location" Rooms="rooms" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="light">Light</label>
                    <InputSelect id="light" class="form-select" @bind-Value="plant.Light">
                        <option value="">Not set</option>
                        @foreach (var light in Enum.GetValues<LightLevel>())
                        {
                            <option value="@light">@Labels.For(light)</option>
                        }
                    </InputSelect>
                </div>
            </FormSection>

            <FormSection Title="Pot and soil" Summary="@PotSummary" Open="openPot">
                <div class="mb-3">
                    <label class="form-label" for="medium">Grows in</label>
                    <InputSelect id="medium" class="form-select" Value="plant.Medium" ValueChanged="(GrowingMedium m) => SetMedium(m)" ValueExpression="() => plant.Medium">
                        @foreach (var medium in Enum.GetValues<GrowingMedium>())
                        {
                            <option value="@medium">@Labels.For(medium)</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <MixPicker @bind-Value="plant.SoilMixId" Mixes="mixes" />
                </div>

                <div class="mb-3">
                    <PotPicker Value="plant.InnerPotId" ValueChanged="SetInnerPot" Pots="pots" Groups="InnerSlot" PotAdded="AddPot" />
                </div>

                <div class="mb-3">
                    <PotPicker Value="plant.OuterPotId" ValueChanged="SetOuterPot" Pots="pots" Groups="OuterSlot"
                               Label="Outer pot" NoneText="No outer pot" PotAdded="AddPot" />
                    @if (plant.OuterPotId is not null)
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="water-outer"
                                   checked="@plant.WaterInOuterPot"
                                   @onchange="e => plant.WaterInOuterPot = (bool?)e.Value == true" />
                            <label class="form-check-label" for="water-outer">Keep water in the outer pot</label>
                        </div>
                        <div class="form-text">For a plain outer pot you keep water in, with the medium wicking it up.</div>
                    }
                </div>
            </FormSection>

            <FormSection Title="Tags" Summary="@TagsSummary" Open="openTags">
                <div class="mb-3">
                    <TagPicker @bind-Value="plant.Tags" Suggestions="tagSuggestions" />
                </div>
            </FormSection>

            @* Only when adding. A plant already in the collection is put in quarantine from its page *@
            @if (IsNew)
            {
                <FormSection Title="Quarantine" Summary="@QuarantineSummary">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="quarantine"
                               checked="@plant.InQuarantine" @onchange="SetQuarantine" />
                        <label class="form-check-label" for="quarantine">In quarantine</label>
                    </div>
                    @if (plant.InQuarantine)
                    {
                        <div class="mt-2">
                            <label class="form-label" for="quarantined-since">Since</label>
                            <InputDate id="quarantined-since" class="form-control" @bind-Value="plant.QuarantinedSince"
                                       max="@Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mt-2">
                            <label class="form-label" for="quarantine-days">Length in days</label>
                            <InputNumber id="quarantine-days" class="form-control" @bind-Value="plant.QuarantineDays"
                                         min="1" max="365" />
                            <div class="form-text">Today says when it is time to check the plant and let it out.</div>
                        </div>
                    }
                    <div class="form-text mb-3">Kept apart from your other plants, e.g. while a new plant shows it has no pests.</div>
                </FormSection>
            }
        </div>

        <div class="form-actions form-bar">
            <button type="submit" class="btn btn-primary" disabled="@(saving || busy)">@(IsNew ? "Add plant" : "Save")</button>
            <button type="button" class="btn btn-link" @onclick="CancelAsync">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Pre-selects a parent, e.g. from the Family section on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentId { get; set; }

    /// <summary>Starts from a copy of another plant, from "Add another like this" on its page.</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    public Guid? CopyOfId { get; set; }

    private readonly string cameraId = $"camera-{Guid.NewGuid():N}";
    private readonly string galleryId = $"gallery-{Guid.NewGuid():N}";
    private ElementReference cameraInput;
    private ElementReference galleryInput;

    /// <summary>Photos taken while adding the plant. They're saved with the plant.</summary>
    private readonly List<Photo> photos = [];
    private string? photoStatus;
    private bool busy;

    private Plant? plant;
    private Plant? original; // the plant as it was before editing, to record what changed
    private LooseDate? copiedDate; // when the plant this one is copied from was got, to offer the same date
    private string? copiedFrom;
    private IReadOnlyList<Plant> existing = [];
    private bool notFound;
    private bool saving;
    private List<string> errors = [];
    private IReadOnlyList<Plant> possibleParents = [];
    private IReadOnlyList<Room> rooms = [];
    private string? location; // as picked, "Living room / Windowsill"; made into a room when saving
    private IReadOnlyList<Pot> pots = [];
    private IReadOnlyList<SoilMix> mixes = [];
    private IReadOnlyList<string> tagSuggestions = [];

    // Which sections start open, worked out when the plant loads. A section only reads this once
    private bool openLives;
    private bool openPot;
    private bool openTags;

    private static readonly PotGroup[] InnerSlot = [PotGroup.Inner, PotGroup.Standalone];
    private static readonly PotGroup[] OuterSlot = [PotGroup.Outer];

    private DateOnly Today => Time.Today();

    private string? PotName(Guid id) => pots.FirstOrDefault(p => p.Id == id)?.DisplayName;

    private string? MixName(Guid id) => mixes.FirstOrDefault(m => m.Id == id)?.Name;

    private static string? Joined(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));

    private string? LivesSummary => Joined(location, plant?.Light is { } light ? Labels.For(light) : null);

    private string? PotSummary => plant is null ? null : Joined(
        Labels.For(plant.Medium),
        plant.InnerPotId is { } inner ? PotName(inner) : null,
        plant.OuterPotId is { } outer ? PotName(outer) : null,
        plant.SoilMixId is { } mix ? MixName(mix) : null);

    private string? TagsSummary => plant is { Tags.Count: > 0 } ? string.Join(", ", plant.Tags) : null;

    private string QuarantineSummary => plant is { InQuarantine: true }
        ? $"In quarantine for {plant.QuarantineDays ?? Plant.DefaultQuarantineDays} days"
        : "Not in quarantine";

    private void AddPot(Pot pot) => pots = [.. pots, pot];

    // Ticking it again after unticking keeps the date it had, so a slip doesn't restart the count
    private void SetQuarantine(ChangeEventArgs e)
    {
        var on = (bool?)e.Value == true;
        plant!.QuarantinedSince = on ? original?.QuarantinedSince ?? Today : null;
        plant.QuarantineDays = on ? original?.QuarantineDays ?? Plant.DefaultQuarantineDays : null;
    }

    // A pot that suggests a medium sets it on a new plant, until the person has picked a medium themselves.
    // A saved plant's medium was already chosen, so a pot never changes it
    private bool mediumChosen => IsNew ? mediumPicked : true;
    private bool mediumPicked;

    private void SetMedium(GrowingMedium medium)
    {
        plant!.Medium = medium;
        mediumPicked = true;
    }

    private void SetInnerPot(Guid? id)
    {
        plant!.InnerPotId = id;
        var pot = pots.FirstOrDefault(p => p.Id == id);
        plant.Medium = PotKinds.MediumAfterPicking(pot, plant.Medium, mediumChosen);
    }

    // Clearing the outer pot clears what would be kept in it
    private void SetOuterPot(Guid? id)
    {
        plant!.OuterPotId = id;
        if (id is null)
            plant.WaterInOuterPot = false;
    }

    private bool IsNew => Id is null;

    private bool ShowParent =>
        plant is not null
        && (plant.Origin is PlantOrigin.Propagated or PlantOrigin.GrownFromSeed || plant.ParentPlantId is not null);

    protected override async Task OnParametersSetAsync()
    {
        var all = await Repository.GetAllAsync();
        var places = await RoomService.GetPlacesAsync();
        rooms = Room.List(places, all, await Propagations.GetAllAsync());
        pots = await PotRepository.GetAllAsync();
        mixes = await MixRepository.GetAllAsync();
        tagSuggestions = PlantTags.Suggestions(all);
        existing = all;

        if (IsNew)
        {
            // The draft keeps its id, so photos taken before saving stay with it
            if (plant is null && CopyOfId is { } copyOfId && all.FirstOrDefault(p => p.Id == copyOfId) is { } source)
            {
                plant = source.Duplicate();
                plant.AcquiredOn = LooseDate.Of(Today);
                copiedDate = source.AcquiredOn;
                copiedFrom = source.DisplayName;
            }
            plant ??= new Plant { AcquiredOn = LooseDate.Of(Today) };
            if (ParentId is { } parentId && all.FirstOrDefault(p => p.Id == parentId) is { } parent)
            {
                plant.Origin = PlantOrigin.Propagated;
                plant.ParentPlantId = parent.Id;
                plant.Genus = parent.Genus;
                plant.Species = parent.Species;
                plant.Cultivar = parent.Cultivar;
                plant.PlaceId = parent.PlaceId;
            }
        }
        else
        {
            plant = all.FirstOrDefault(p => p.Id == Id);
            original = plant?.Copy();
            notFound = plant is null;
        }

        if (plant is not null)
        {
            location = places.NameOf(plant.PlaceId);
            possibleParents = PlantLineage.PossibleParents(plant, all);

            // All closed when adding, even from a copy, where the summaries show what was copied
            openLives = !IsNew && (!string.IsNullOrWhiteSpace(location) || plant.Light is not null);
            openPot = !IsNew && (plant.SoilMixId is not null || plant.InnerPotId is not null || plant.OuterPotId is not null);
            openTags = !IsNew && plant.Tags.Count > 0;
        }
    }

    private async Task AddPhotosAsync(ElementReference input, bool fromCamera)
    {
        if (plant is null)
            return;

        busy = true;
        photoStatus = "Saving photos…";
        StateHasChanged();

        try
        {
            var result = await Photos.SaveFromInputAsync(input, SubjectType.Plant, plant.Id);
            photos.AddRange(result.Saved);
            photoStatus = result.Message(guessesMatter: !fromCamera);
        }
        catch (Exception ex)
        {
            photoStatus = $"Couldn't save the photos: {ex.Message}";
        }

        busy = false;
    }

    private async Task RemovePhotoAsync(Photo photo)
    {
        await Photos.DeleteAsync(photo.Id);
        photos.Remove(photo);
        photoStatus = null;
    }

    // Leaving without saving the plant: the photos would belong to nothing
    private async Task CancelAsync()
    {
        await DiscardPhotosAsync();
        Navigation.NavigateTo(IsNew ? "plants" : $"plants/{Id}");
    }

    private async Task DiscardPhotosAsync()
    {
        foreach (var photo in photos)
            await Photos.DeleteAsync(photo.Id);
        photos.Clear();
    }

    /// <summary>Also covers leaving by the back link or the phone's back button.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DiscardPhotosAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the photos go with it
        }
    }

    private async Task SaveAsync()
    {
        if (plant is null)
            return;

        errors = plant.Validate(Today).ToList();
        if (errors.Count > 0)
            return;

        saving = true;
        try
        {
            plant.PlaceId = await RoomService.PlaceIdAsync(location);
            if (IsNew)
            {
                await PlantService.CreateAsync(plant, photos);
                photos.Clear(); // they belong to the saved plant now
            }
            else
            {
                var places = await RoomService.GetPlacesAsync();
                await PlantService.UpdateAsync(original!, plant, Labels.For, PotName, MixName, id => places.NameOf(id));
            }
            Navigation.NavigateTo($"plants/{plant.Id}", replace: IsNew);
        }
        catch (Exception ex)
        {
            errors = [$"Couldn't save: {ex.Message}"];
        }
        finally
        {
            saving = false;
        }
    }
}
