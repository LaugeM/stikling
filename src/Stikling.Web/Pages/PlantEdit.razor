@page "/plants/new"
@page "/plants/{Id:guid}/edit"
@inject IPlantRepository Repository
@inject IPropagationRepository Propagations
@inject PlantService PlantService
@inject PhotoService Photos
@inject NavigationManager Navigation
@inject TimeProvider Time
@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Add plant" : "Edit plant") · Stikling</PageTitle>

<a class="back-link" href="@(IsNew ? "plants" : $"plants/{Id}")">‹ Back</a>
<h1>@(IsNew ? "Add plant" : "Edit plant")</h1>

@if (plant is null)
{
    <p class="text-body-secondary">@(notFound ? "That plant doesn't exist." : "Loading…")</p>
}
else
{
    <EditForm Model="plant" OnSubmit="SaveAsync" class="edit-form">
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>Name</legend>
            <div class="mb-3">
                <label class="form-label" for="nickname">Nickname</label>
                <InputText id="nickname" class="form-control" @bind-Value="plant.Nickname" placeholder="e.g. Big Monstera" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="genus">Genus</label>
                    <InputText id="genus" class="form-control" @bind-Value="plant.Genus" list="genus-list" placeholder="e.g. Monstera" autocomplete="off" />
                    <datalist id="genus-list">
                        @foreach (var genus in PlantNames.CommonGenera)
                        {
                            <option value="@genus"></option>
                        }
                    </datalist>
                </div>
                <div class="col-6">
                    <label class="form-label" for="species">Species</label>
                    <InputText id="species" class="form-control" @bind-Value="plant.Species" placeholder="e.g. deliciosa" autocomplete="off" />
                </div>
            </div>
            <div class="mb-1">
                <label class="form-label" for="cultivar">Cultivar / variety</label>
                <InputText id="cultivar" class="form-control" @bind-Value="plant.Cultivar" placeholder="e.g. Thai Constellation" autocomplete="off" />
            </div>
            <div class="form-text">Give it a nickname, a genus, or both.</div>
        </fieldset>

        <fieldset>
            <legend>Where it came from</legend>
            <div class="mb-3">
                <label class="form-label" for="origin">How you got it</label>
                <InputSelect id="origin" class="form-select" @bind-Value="plant.Origin">
                    @foreach (var origin in Enum.GetValues<PlantOrigin>())
                    {
                        <option value="@origin">@Labels.For(origin)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <LooseDateInput @bind-Value="plant.AcquiredOn" Today="Today" Label="When you got it" />
                <div class="form-text">If you only remember the month or the year, pick that rather than guessing a day.</div>
            </div>

            @if (ShowParent)
            {
                <div class="mb-3">
                    <label class="form-label" for="parent">Parent plant</label>
                    <InputSelect id="parent" class="form-select" @bind-Value="plant.ParentPlantId">
                        <option value="">Not one of mine / unknown</option>
                        @foreach (var p in possibleParents)
                        {
                            <option value="@p.Id">@p.DisplayName</option>
                        }
                    </InputSelect>
                    @if (IsNew && plant.ParentPlantId is { } parentId)
                    {
                        <div class="form-text">
                            This is for a plant that already grows on its own. Still rooting?
                            <a href="propagations/new?parent=@parentId">Start a propagation instead</a>,
                            and pot it up when it's ready.
                        </div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="source">Source</label>
                <InputText id="source" class="form-control" @bind-Value="plant.Source" placeholder="Shop, friend, plant swap…" />
            </div>
        </fieldset>

        <fieldset>
            <legend>Where it lives</legend>
            <div class="mb-3">
                <RoomPicker @bind-Value="plant.Location" Rooms="rooms" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="medium">Grows in</label>
                    <InputSelect id="medium" class="form-select" @bind-Value="plant.Medium">
                        @foreach (var medium in Enum.GetValues<GrowingMedium>())
                        {
                            <option value="@medium">@Labels.For(medium)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label" for="container">Pot</label>
                    <InputText id="container" class="form-control" @bind-Value="plant.Container" placeholder="e.g. Lechuza pot" />
                </div>
            </div>
            @if (!IsNew)
            {
                <div class="mb-3">
                    <label class="form-label" for="status">Status</label>
                    <InputSelect id="status" class="form-select" @bind-Value="plant.Status">
                        @foreach (var s in Enum.GetValues<PlantStatus>())
                        {
                            <option value="@s">@Labels.For(s)</option>
                        }
                    </InputSelect>
                </div>
            }
        </fieldset>

        @if (IsNew)
        {
            <fieldset>
                <legend>Photo</legend>
                @if (photos.Count > 0)
                {
                    <div class="photo-picks">
                        @foreach (var photo in photos)
                        {
                            <div class="photo-pick">
                                <PhotoImage PhotoId="photo.Id" Alt="Photo of the new plant" />
                                <button type="button" class="photo-remove" @onclick="() => RemovePhotoAsync(photo)"
                                        aria-label="Remove photo" title="Remove photo">✕</button>
                            </div>
                        }
                    </div>
                }

                <div class="composer-row">
                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@cameraId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Camera
                    </label>
                    <input id="@cameraId" type="file" accept="image/*" capture="environment" class="visually-hidden"
                           @ref="cameraInput" @onchange="() => AddPhotosAsync(cameraInput)" disabled="@busy" />

                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@galleryId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-5 4 4 3-3 4 4" /></svg>
                        Gallery
                    </label>
                    <input id="@galleryId" type="file" accept="image/*" multiple class="visually-hidden"
                           @ref="galleryInput" @onchange="() => AddPhotosAsync(galleryInput)" disabled="@busy" />
                </div>

                <div class="form-text">The first photo becomes the cover. You can add more later on the plant's page.</div>
                @if (photoStatus is not null)
                {
                    <p class="composer-status" role="status">@photoStatus</p>
                }
            </fieldset>
        }

        <fieldset>
            <legend>Notes</legend>
            <InputTextArea class="form-control" rows="3" @bind-Value="plant.Notes" aria-label="Notes" />
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@(saving || busy)">@(IsNew ? "Add plant" : "Save")</button>
            <button type="button" class="btn btn-link" @onclick="CancelAsync">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Pre-selects a parent, e.g. from the Family section on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentId { get; set; }

    private readonly string cameraId = $"camera-{Guid.NewGuid():N}";
    private readonly string galleryId = $"gallery-{Guid.NewGuid():N}";
    private ElementReference cameraInput;
    private ElementReference galleryInput;

    /// <summary>Photos taken while adding the plant. They're saved with the plant.</summary>
    private readonly List<Photo> photos = [];
    private string? photoStatus;
    private bool busy;

    private Plant? plant;
    private Plant? original; // the plant as it was before editing, to record what changed
    private bool notFound;
    private bool saving;
    private List<string> errors = [];
    private IReadOnlyList<Plant> possibleParents = [];
    private IReadOnlyList<Room> rooms = [];

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private bool IsNew => Id is null;

    private bool ShowParent =>
        plant is not null
        && (plant.Origin is PlantOrigin.Propagated or PlantOrigin.GrownFromSeed || plant.ParentPlantId is not null);

    protected override async Task OnParametersSetAsync()
    {
        var all = await Repository.GetAllAsync();
        rooms = Room.List(all, await Propagations.GetAllAsync());

        if (IsNew)
        {
            // The draft keeps its id, so photos taken before saving stay with it
            plant ??= new Plant { AcquiredOn = LooseDate.Of(Today) };
            if (ParentId is { } parentId && all.FirstOrDefault(p => p.Id == parentId) is { } parent)
            {
                plant.Origin = PlantOrigin.Propagated;
                plant.ParentPlantId = parent.Id;
                plant.Genus = parent.Genus;
                plant.Species = parent.Species;
                plant.Cultivar = parent.Cultivar;
                plant.Location = parent.Location;
            }
        }
        else
        {
            plant = all.FirstOrDefault(p => p.Id == Id);
            original = plant?.Copy();
            notFound = plant is null;
        }

        if (plant is not null)
            possibleParents = PlantLineage.PossibleParents(plant, all);
    }

    private async Task AddPhotosAsync(ElementReference input)
    {
        if (plant is null)
            return;

        busy = true;
        photoStatus = "Saving photos…";
        StateHasChanged();

        try
        {
            var result = await Photos.SaveFromInputAsync(input, SubjectType.Plant, plant.Id);
            photos.AddRange(result.Saved);
            photoStatus = result.Failed switch
            {
                0 => null,
                1 => "1 file couldn't be read as an image and was skipped.",
                var n => $"{n} files couldn't be read as images and were skipped."
            };
        }
        catch (Exception ex)
        {
            photoStatus = $"Couldn't save the photos: {ex.Message}";
        }

        busy = false;
    }

    private async Task RemovePhotoAsync(Photo photo)
    {
        await Photos.DeleteAsync(photo.Id);
        photos.Remove(photo);
        photoStatus = null;
    }

    // Leaving without saving the plant: the photos would belong to nothing
    private async Task CancelAsync()
    {
        await DiscardPhotosAsync();
        Navigation.NavigateTo(IsNew ? "plants" : $"plants/{Id}");
    }

    private async Task DiscardPhotosAsync()
    {
        foreach (var photo in photos)
            await Photos.DeleteAsync(photo.Id);
        photos.Clear();
    }

    /// <summary>Also covers leaving by the back link or the phone's back button.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DiscardPhotosAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the photos go with it
        }
    }

    private async Task SaveAsync()
    {
        if (plant is null)
            return;

        errors = plant.Validate(Today).ToList();
        if (errors.Count > 0)
            return;

        saving = true;
        try
        {
            if (IsNew)
            {
                await PlantService.CreateAsync(plant, photos);
                photos.Clear(); // they belong to the saved plant now
            }
            else
            {
                await PlantService.UpdateAsync(original!, plant, Labels.For);
            }
            Navigation.NavigateTo($"plants/{plant.Id}", replace: IsNew);
        }
        catch (Exception ex)
        {
            errors = [$"Couldn't save: {ex.Message}"];
        }
        finally
        {
            saving = false;
        }
    }
}
