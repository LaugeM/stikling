@page "/plants/new"
@page "/plants/{Id:guid}/edit"
@using Stikling.Core.Settings
@inject ILogger<PlantEdit> Logger
@inject PlantForms Forms
@inject PlantService PlantService
@inject PlantCareService CommonCare
@inject PhotoService Photos
@inject GooglePhotosService Google
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@F(Strings.PlantDetail.PageTitle, RouteNew ? Strings.PlantEdit.AddPlant : Strings.PlantEdit.EditPlant)</PageTitle>

<a class="back-link" href="@(RouteNew ? "plants" : $"plants/{Id}")">@Strings.Common.Back</a>
<h1>@(RouteNew ? Strings.PlantEdit.AddPlant : Strings.PlantEdit.EditPlant)</h1>

@if (IsNew && CopyOfId is null && ParentId is null && !FromPhotos)
{
    <p class="form-text">@Html(Strings.PlantEdit.AddingSeveral, Link("plants/quick-add", Strings.PlantEdit.QuickAddLink, "link-action"), Link("plants/import", Strings.PlantEdit.ImportLink, "link-action"))</p>
}

@if (plant is null || form is null)
{
    <p class="text-body-secondary">@(notFound ? Strings.PlantEdit.NotFound : Strings.Plants.Loading)</p>
}
else
{
    <EditForm Model="plant" OnSubmit="SaveAsync" class="edit-form" novalidate>
        @if (errors.Count > 0)
        {
            <div id="form-errors" class="alert alert-danger" role="alert" tabindex="-1">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        @* Starting from old photos, from the first screen: they come first, and the rest is the usual form *@
        @if (FromPhotos)
        {
            @PhotoSection
        }

        <fieldset>
            <legend>@Strings.PlantEdit.LegendName</legend>
            <PlantNameFields @bind-Genus="plant.Genus" @bind-Species="plant.Species" @bind-Cultivar="plant.Cultivar"
                             @bind-Qualifier="plant.NameQualifier" @bind-Note="plant.NameNote" />
            <div class="mt-3">
                <label class="form-label" for="nickname">@Strings.PlantEdit.Nickname</label>
                <InputText id="nickname" class="form-control" @bind-Value="plant.Nickname" placeholder="@Strings.PlantEdit.NicknamePlaceholder" />
            </div>
            <div class="form-text">@Strings.PlantEdit.NameHint</div>
            <div class="mt-3">
                <label class="form-label" for="collection-number">@Strings.PlantEdit.CollectionNumber</label>
                <input id="collection-number" class="form-control" autocomplete="off"
                           @bind="plant.CollectionNumber" @bind:event="oninput" placeholder="@Strings.PlantEdit.CollectionNumberPlaceholder"
                           aria-invalid="@(NumberInvalid ? "true" : null)" />
                @if (NumberInvalid)
                {
                    <div class="form-text text-danger">@CollectionNumbers.NotValidText</div>
                }
                else if (NumberCode is null)
                {
                    <div class="form-text">
                        @Strings.PlantEdit.NumberHint
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => plant.CollectionNumber = nextNumber.ToString()">@F(Strings.PlantEdit.UseNumber, nextNumber)</button>
                    </div>
                }
                else if (NumberClashes is { Count: > 0 } clashes)
                {
                    <div class="form-text">@CollectionNumbers.ClashNote(NumberCode, clashes)</div>
                }
            </div>
            @if (form.WishHere is { } onWishlist)
            {
                <div class="form-check mt-2">
                    <input type="checkbox" class="form-check-input" id="mark-wish-got" @bind="form.MarkWishGot" />
                    <label class="form-check-label" for="mark-wish-got">@Strings.PlantEdit.WishMarkGot</label>
                </div>
            }
            @if (IsNew && CopyOfId is null && ParentId is null && PlantMatches.DiedBefore(plant, form.Plants) is { Count: > 0 } diedBefore)
            {
                <p class="form-text">
                    @Html(diedBefore.Count == 1 ? Strings.PlantEdit.DiedBeforeOne : Strings.PlantEdit.DiedBeforeSome,
                        string.Join("; ", diedBefore.Select(match => Link($"plants/{match.Id}", match.DisplayName) + (string.IsNullOrWhiteSpace(match.CauseOfDeath) ? "" : ", " + H(match.CauseOfDeath.Trim())))))
                </p>
            }
            @if (IsNew && CopyOfId is null && ParentId is null && PlantMatches.SameName(plant, form.Plants) is { Count: > 0 } same)
            {
                <p class="form-text already-have">
                    @Html(Strings.PlantEdit.AlreadyHave, JoinAnd(same.Select(match => Link($"plants/{match.Id}", match.DisplayName))))
                    @Strings.PlantEdit.AddingAgain
                </p>
            }
        </fieldset>

        <fieldset>
            <legend>@Strings.PlantEdit.LegendCameFrom</legend>
            <div class="mb-3">
                <label class="form-label" for="origin">@Strings.PlantEdit.HowYouGotIt</label>
                <InputSelect id="origin" class="form-select" @bind-Value="plant.Origin" @bind-Value:after="form.OriginChanged">
                    @foreach (var origin in Enum.GetValues<PlantOrigin>())
                    {
                        <option value="@origin">@Labels.For(origin)</option>
                    }
                </InputSelect>
            </div>

            @* A value already chosen stays if the origin changes, it just isn't shown *@
            @if (plant.AsksHowRaised)
            {
                <div class="mb-3">
                    <label class="form-label" for="raised">@Strings.Plants.ListHowRaised</label>
                    <select id="raised" class="form-select" aria-describedby="raised-help"
                            @onchange="e => plant.RaisedAs = Enum.TryParse<RaisedAs>(e.Value?.ToString(), out var how) ? how : null">
                        <option value="" selected="@(plant.RaisedAs is null)">@Strings.Plants.ListNotSaid</option>
                        @foreach (var how in Enum.GetValues<RaisedAs>())
                        {
                            <option value="@how" selected="@(plant.RaisedAs == how)">@Labels.For(how)</option>
                        }
                    </select>
                    <div id="raised-help" class="form-text">@Strings.PlantEdit.RaisedHelp</div>
                </div>
            }

            <div class="mb-3">
                <LooseDateInput @bind-Value="plant.AcquiredOn" Today="Today" Label="@Strings.PlantEdit.WhenYouGotIt" />
                <div class="form-text">@Strings.PlantEdit.DateHint</div>
                @if (dateFromPhotos is { } fromPhotos && plant.AcquiredOn == fromPhotos)
                {
                    <div class="form-text">
                        @Strings.PlantEdit.DateFromPhotos
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="KeepToday">@Strings.PlantEdit.UseToday</button>
                    </div>
                }
                @if (form.CopiedDate is { } sameDate && sameDate != LooseDate.Of(Today))
                {
                    @if (plant.AcquiredOn == sameDate)
                    {
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => plant.AcquiredOn = LooseDate.Of(Today)">@Strings.PlantEdit.UseToday</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => plant.AcquiredOn = sameDate">@F(Strings.PlantEdit.SameDateAs, form.CopiedFrom, sameDate.Text())</button>
                    }
                }
            </div>

            @if (ShowParent)
            {
                <div class="mb-3">
                    <label class="form-label" for="parent">@Strings.PlantEdit.ParentPlant</label>
                    <InputSelect id="parent" class="form-select" @bind-Value="plant.ParentPlantId">
                        <option value="">@Strings.PlantEdit.ParentNone</option>
                        @foreach (var p in possibleParents)
                        {
                            <option value="@p.Id">@PlantLineage.ParentLabel(p)</option>
                        }
                    </InputSelect>
                    <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => addParentOpen = true">@Strings.PlantEdit.ParentNotMine</button>
                    @if (IsNew && plant.ParentPlantId is { } parentId)
                    {
                        <div class="form-text">
                            @Html(Strings.PlantEdit.ParentStillRooting, Link($"propagations/new?parent={parentId}", Strings.PlantEdit.ParentStillRootingLink))
                        </div>
                    }
                </div>
            }

            @if (!IsNew)
            {
                <div class="mb-3">
                    <div class="form-check">
                        <InputCheckbox id="lives-elsewhere" class="form-check-input" @bind-Value="plant.LivesElsewhere" />
                        <label class="form-check-label" for="lives-elsewhere">@Strings.PlantEdit.LivesElsewhere</label>
                    </div>
                    @if (plant.LivesElsewhere)
                    {
                        <div class="mt-2">
                            <label class="form-label" for="lives-with">@Strings.PlantEdit.WhoseIsIt</label>
                            <InputText id="lives-with" class="form-control" @bind-Value="plant.LivesWith" placeholder="@Strings.PlantEdit.WhosePlaceholder" />
                        </div>
                        <div class="form-text">@Strings.PlantEdit.LivesElsewhereNote</div>
                    }
                </div>
            }

            <div class="mb-3">
                <SellerPicker @bind-Value="form.SellerText" Names="sellerNames" />
            </div>

            @* A price already entered stays if the origin changes, it just isn't shown *@
            @if (plant.Origin == PlantOrigin.Purchased)
            {
                <div class="mb-3">
                    <label class="form-label" for="price-paid">@Strings.PlantEdit.PricePaid</label>
                    <InputNumber id="price-paid" class="form-control" @bind-Value="plant.PricePaid" min="0" step="any" inputmode="decimal" />
                </div>
            }
        </fieldset>

        @if (IsNew && !FromPhotos)
        {
            @PhotoSection
        }

        @if (!IsNew)
        {
            <fieldset>
                <legend>@Strings.PlantDetail.AboutIt</legend>
                @AboutField
            </fieldset>
        }

        <h2 class="section-label">@Strings.PlantEdit.MoreDetails</h2>
        <div class="more-details mb-4">
            @if (ShowArrival)
            {
                <FormSection Title="@Strings.PlantEdit.SectionArrival" Summary="@ArrivalFields.Summary(plant.ArrivedIn, plant.ArrivalProblems)" Open="openArrival">
                    <ArrivalFields @bind-Rating="plant.ArrivedIn" Problems="plant.ArrivalProblems" @bind-Note="plant.ArrivalNote" />
                </FormSection>
            }

            <FormSection Title="@Strings.PlantEdit.SectionLives" Summary="@LivesSummary" Open="openLives">
                <div class="mb-3">
                    <RoomPicker @bind-Value="form.Location" Rooms="rooms" />
                </div>
                @if (form.CameInside)
                {
                    <div class="back-from-outside mb-3" role="group" aria-labelledby="back-from-outside-title">
                        <b id="back-from-outside-title">@Strings.PlantEdit.BackFromOutside</b>
                        <p class="form-text mb-2">@Strings.PlantEdit.BackFromOutsideNote</p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="back-quarantine" @bind="form.BackQuarantine" />
                            <label class="form-check-label" for="back-quarantine">@Plural.Of(form.QuarantineLength, Strings.PlantEdit.BackQuarantine_One, Strings.PlantEdit.BackQuarantine_Other)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="back-checked" @bind="form.BackChecked" />
                            <label class="form-check-label" for="back-checked">@Strings.PlantEdit.BackChecked</label>
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label" for="light">@Strings.PlantEdit.LightWhereItStands</label>
                    <InputSelect id="light" class="form-select" @bind-Value="plant.Light">
                        <option value="">@Strings.Plants.ListNotSet</option>
                        @foreach (var light in Enum.GetValues<LightLevel>())
                        {
                            <option value="@light">@Labels.For(light)</option>
                        }
                    </InputSelect>
                </div>
            </FormSection>

            @if (CareFor is { } suggested && CareSuggestion.Fills(plant, suggested) is { Count: > 0 } suggestedFills)
            {
                <CareOffer Care="suggested" Fills="suggestedFills" Book="careBook" OnUse="() => UseCare(suggested)" />
            }

            <FormSection Title="@Strings.Plants.ListLikesLabel" Summary="@LikesSummary" Open="openLikes">
                <div class="mb-3">
                    <label class="form-label" for="likes-light">@Strings.PlantEdit.LightItLikes</label>
                    <InputSelect id="likes-light" class="form-select" @bind-Value="plant.LikesLight">
                        <option value="">@Strings.Plants.ListNotSet</option>
                        @foreach (var light in Enum.GetValues<LightLevel>())
                        {
                            <option value="@light">@Labels.For(light)</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="likes-water">@Strings.PlantEdit.Water</label>
                    <InputSelect id="likes-water" class="form-select" @bind-Value="plant.LikesWater">
                        <option value="">@Strings.Plants.ListNotSet</option>
                        <option value="@WaterNeed.DryOut">@Strings.PlantEdit.WaterDryOut</option>
                        <option value="@WaterNeed.DryPartly">@Strings.PlantEdit.WaterDryPartly</option>
                        <option value="@WaterNeed.EvenlyMoist">@Strings.PlantEdit.WaterEvenlyMoist</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="likes-humidity">@Strings.PlantEdit.Humidity</label>
                    <InputSelect id="likes-humidity" class="form-select" @bind-Value="plant.LikesHumidity" aria-describedby="likes-humidity-help">
                        <option value="">@Strings.Plants.ListNotSet</option>
                        <option value="@HumidityNeed.Low">@Strings.PlantEdit.HumidityLow</option>
                        <option value="@HumidityNeed.Medium">@Strings.PlantEdit.HumidityMedium</option>
                        <option value="@HumidityNeed.High">@Strings.PlantEdit.HumidityHigh</option>
                    </InputSelect>
                    <div id="likes-humidity-help" class="form-text">@Strings.PlantEdit.HumidityHelp</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="likes-season">@Strings.PlantEdit.GrowingSeason</label>
                    <InputSelect id="likes-season" class="form-select" @bind-Value="plant.GrowingSeason">
                        <option value="">@Strings.Plants.ListNotSet</option>
                        <option value="@GrowingSeason.NoRest">@Strings.PlantEdit.GrowsAllYear</option>
                        <option value="@GrowingSeason.Summer">@Strings.PlantEdit.GrowsSummer</option>
                        <option value="@GrowingSeason.Winter">@Strings.PlantEdit.GrowsWinter</option>
                    </InputSelect>
                </div>
                @if (plant.GrowingSeason is GrowingSeason.Summer or GrowingSeason.Winter)
                {
                    <div class="mb-3">
                        <label class="form-label" for="likes-rest">@Strings.PlantEdit.HowItRests</label>
                        <InputSelect id="likes-rest" class="form-select" @bind-Value="plant.RestHow">
                            <option value="">@Strings.Plants.ListNotSet</option>
                            <option value="@RestKind.Cooler">@Strings.PlantEdit.RestCooler</option>
                            <option value="@RestKind.Drier">@Strings.PlantEdit.RestDrier</option>
                            <option value="@RestKind.CoolerAndDrier">@Strings.PlantEdit.RestCoolerAndDrier</option>
                            <option value="@RestKind.DiesBack">@Strings.PlantEdit.RestDiesBack</option>
                        </InputSelect>
                    </div>
                }
            </FormSection>

            <FormSection Title="@Strings.PlantEdit.SectionPot" Summary="@PotSummary" Open="openPot">
                <div class="mb-3">
                    <label class="form-label" for="medium">@Strings.PlantDetail.GrowsIn</label>
                    <InputSelect id="medium" class="form-select" Value="plant.Medium" ValueChanged="(GrowingMedium m) => form.SetMedium(m)" ValueExpression="() => plant.Medium"
                                 aria-describedby="@(Labels.Explain(plant.Medium) is null ? null : "medium-help")">
                        @foreach (var medium in Enum.GetValues<GrowingMedium>())
                        {
                            <option value="@medium">@Labels.For(medium)</option>
                        }
                    </InputSelect>
                    @if (Labels.Explain(plant.Medium) is { } mediumHelp)
                    {
                        <div id="medium-help" class="form-text">@mediumHelp</div>
                    }
                    @if (form.OffersTransition)
                    {
                        <div class="form-check mt-2">
                            <input id="track-transition" class="form-check-input" type="checkbox" @bind="form.TrackTransition" />
                            <label class="form-check-label" for="track-transition">@Strings.PlantEdit.TrackTransition</label>
                            <div class="form-text">@Strings.PlantEdit.TrackTransitionNote</div>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <MixPicker @bind-Value="plant.SoilMixId" Mixes="form.Mixes" />
                </div>

                <div class="mb-3">
                    <PotPicker Value="plant.InnerPotId" ValueChanged="form.SetInnerPot" Pots="form.Pots" Groups="InnerSlot" PotAdded="form.AddPot" />
                    @if (form.InnerPotChange is { } sizeChange)
                    {
                        <div class="form-text">@sizeChange.Text</div>
                    }
                </div>

                <div class="mb-3">
                    <PotPicker Value="plant.OuterPotId" ValueChanged="form.SetOuterPot" Pots="form.Pots" Groups="OuterSlot"
                               Label="@Strings.PlantEdit.OuterPot" NoneText="@Strings.PlantEdit.NoOuterPot" PotAdded="form.AddPot" />
                    @if (plant.OuterPotId is not null)
                    {
                        <InfoButton Topic="@Strings.PlantEdit.OuterWaterTopic">
                            <Label>
                                <div class="form-check mt-2 mb-0">
                                    <input class="form-check-input" type="checkbox" id="water-outer"
                                           checked="@plant.WaterInOuterPot"
                                           @onchange="e => plant.WaterInOuterPot = (bool?)e.Value == true" />
                                    <label class="form-check-label" for="water-outer">@Strings.PlantEdit.OuterWater</label>
                                </div>
                            </Label>
                            <ChildContent>
                                @Strings.PlantEdit.OuterWaterInfo
                            </ChildContent>
                        </InfoButton>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label" for="how-many">@Strings.PlantEdit.HowManyInPot</label>
                    <InputNumber id="how-many" class="form-control" @bind-Value="plant.Count"
                                 min="1" step="1" placeholder="1" inputmode="numeric" aria-describedby="how-many-help" />
                    <div id="how-many-help" class="form-text">@Strings.PlantEdit.HowManyInPotHint</div>
                </div>
            </FormSection>

            <FormSection Title="@Strings.PlantEdit.SectionWatering" Summary="@WateringSummary" Open="openWatering">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="watering-reminder"
                           checked="@plant.WateringReminder"
                           @onchange="e => plant.WateringReminder = e.Value is true" />
                    <label class="form-check-label" for="watering-reminder">@Strings.PlantEdit.RemindToWater</label>
                </div>
                <div class="form-text mb-3">
                    @(form.Settings.WateringReminder ? Strings.PlantEdit.RemindNote : Strings.PlantEdit.RemindNoteOff)
                </div>

                @if (WateringForms.Of(plant, form.FindPot) == WateringForm.TopWatered)
                {
                    <div class="mb-3">
                        <label class="form-label" for="water-at">@Strings.PlantEdit.WaterAt</label>
                        <InputNumber id="water-at" class="form-control" @bind-Value="plant.WaterAt"
                                     min="1" max="10" placeholder="@Plant.DefaultWaterAt.ToString()" inputmode="numeric"
                                     aria-describedby="water-at-help" />
                        <div id="water-at-help" class="form-text">
                            @Strings.PlantEdit.WaterAtHelp
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-label" id="water-by-label">@Strings.PlantEdit.HowYouWater</div>
                        <div role="radiogroup" aria-labelledby="water-by-label" aria-describedby="water-by-help">
                            @foreach (var method in WaterByChoices)
                            {
                                var key = method?.ToString().ToLowerInvariant() ?? "none";
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="water-by" id="water-by-@key" aria-describedby="water-by-@key-hint"
                                           checked="@(plant.WaterBy == method)" @onchange="() => plant.WaterBy = method" />
                                    <label class="form-check-label" for="water-by-@key">@(method is { } named ? SitterSheetText.MethodName(named) : Strings.Plants.ListNotSaid)</label>
                                    <div id="water-by-@key-hint" class="form-text mt-0">@SitterSheetText.MethodHint(method)</div>
                                </div>
                            }
                        </div>
                        <div id="water-by-help" class="form-text mt-2">@Strings.PlantEdit.WaterByHelp</div>
                    </div>
                }

                <div class="mb-3">
                    @if (form.Feeds.Count == 0)
                    {
                        <div class="form-label">@Strings.PlantDetail.WateringFeed</div>
                        <div class="form-text">
                            @Strings.PlantEdit.FeedNone
                            @if (!IsNew)
                            {
                                <a href="feeds">@Strings.PlantEdit.FeedsLink</a>
                            }
                        </div>
                    }
                    else
                    {
                        <label class="form-label" for="watering-feed">@Strings.PlantDetail.WateringFeed</label>
                        <select id="watering-feed" class="form-select" aria-describedby="watering-feed-help"
                                @onchange="e => SetWateringFeed(e.Value?.ToString())">
                            <option value="" selected="@(form.FeedChoice is null)">@Strings.Common.Off</option>
                            @foreach (var feed in form.Feeds)
                            {
                                <option value="@feed.Id" selected="@(form.FeedChoice == feed.Id)">@feed.Name</option>
                            }
                        </select>
                        @if (form.FeedChoice is not null)
                        {
                            <label class="form-label mt-3" for="watering-feed-every">@Strings.PlantEdit.FeedHowOften</label>
                            <select id="watering-feed-every" class="form-select"
                                    @onchange="e => plant.WateringFeedEvery = int.TryParse(e.Value?.ToString(), out var n) ? n : 1">
                                <option value="1" selected="@((plant.WateringFeedEvery ?? 1) == 1)">@Strings.PlantEdit.FeedEvery</option>
                                <option value="2" selected="@(plant.WateringFeedEvery == 2)">@Strings.PlantEdit.FeedEverySecond</option>
                                <option value="3" selected="@(plant.WateringFeedEvery == 3)">@Strings.PlantEdit.FeedEveryThird</option>
                            </select>
                        }
                        <div id="watering-feed-help" class="form-text">@Strings.PlantEdit.FeedHelp</div>
                    }
                </div>
            </FormSection>

            @if (IsNew)
            {
                <FormSection Title="@Strings.PlantDetail.AboutIt" Summary="@AboutSummary">
                    @AboutField
                </FormSection>
            }

            <FormSection Title="@Strings.PlantEdit.SectionSitter" Summary="@SitterSummary" Open="openSitter">
                <div class="mb-3">
                    <label class="form-label" for="sitter-note">@Strings.PlantEdit.SitterNote</label>
                    <InputTextArea id="sitter-note" class="form-control" rows="3" @bind-Value="plant.SitterNote" aria-describedby="sitter-note-help" />
                    <div id="sitter-note-help" class="form-text">@Strings.PlantEdit.SitterNoteHelp</div>
                </div>
            </FormSection>

            <FormSection Title="@Strings.Plants.ListForSwap" Summary="@SwapSummary" Open="openSwap">
                <div class="mb-3">
                    <label class="form-label" for="spare">@Strings.PlantDetail.SwapOffered</label>
                    <select id="spare" class="form-select" aria-describedby="spare-help"
                            @onchange="e => plant.Spare = Enum.TryParse<SpareMark>(e.Value?.ToString(), out var mark) ? mark : null">
                        <option value="" selected="@(plant.Spare is null)">@Strings.PlantDetail.SwapNotOffered</option>
                        @foreach (var mark in Enum.GetValues<SpareMark>())
                        {
                            <option value="@mark" selected="@(plant.Spare == mark)">@SwapLists.MarkText(mark)</option>
                        }
                    </select>
                    <div id="spare-help" class="form-text">@Strings.PlantEdit.SpareHelp</div>
                </div>
            </FormSection>

            <FormSection Title="@Strings.Plants.ListTagsLabel" Summary="@TagsSummary" Open="openTags">
                <div class="mb-3">
                    <TagPicker @bind-Value="plant.Tags" Suggestions="tagSuggestions" />
                </div>
            </FormSection>

            @* Only when adding. A plant already in the collection is put in quarantine from its page *@
            @if (IsNew)
            {
                <FormSection Title="@Strings.Plants.ListQuarantine" Summary="@QuarantineSummary">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="quarantine"
                               checked="@plant.InQuarantine" @onchange="SetQuarantine" />
                        <label class="form-check-label" for="quarantine">@Strings.PlantEdit.InQuarantine</label>
                    </div>
                    @if (plant.InQuarantine)
                    {
                        <div class="mt-2">
                            <label class="form-label" for="quarantined-since">@Strings.PlantDetail.QuarantineSinceLabel</label>
                            <InputDate id="quarantined-since" class="form-control" @bind-Value="plant.QuarantinedSince"
                                       max="@Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mt-2">
                            <label class="form-label" for="quarantine-days">@Strings.PlantEdit.QuarantineLength</label>
                            <InputNumber id="quarantine-days" class="form-control" @bind-Value="plant.QuarantineDays"
                                         min="1" max="365" />
                            <div class="form-text">@Strings.PlantEdit.QuarantineNote</div>
                        </div>
                    }
                    <div class="form-text mb-3">@Strings.PlantEdit.QuarantineHelp</div>
                </FormSection>
            }

            <FormSection Title="@Strings.Plants.ListYourFields" Summary="@FieldsSummary" Open="openFields">
                @foreach (var field in form.OwnFields)
                {
                    <OwnFieldInput Field="field" Value="@form.FieldInput(field.Id)" ValueChanged="(string? value) => form.SetFieldInput(field.Id, value)" />
                }
                @if (addingField)
                {
                    <OwnFieldForm Prefix="plant-field-new" Added="FieldAddedAsync" Cancelled="() => addingField = false" />
                }
                else
                {
                    <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => addingField = true">@Strings.PlantEdit.AddOwnField</button>
                }
                <div class="form-text mb-3">@Strings.PlantEdit.OwnFieldsHelp</div>
            </FormSection>
        </div>

        <div class="form-actions form-bar">
            <button type="submit" class="btn btn-primary" disabled="@(saving || busy || googleBusy)">@(IsNew ? Strings.PlantEdit.AddPlant : Strings.Common.Save)</button>
            <button type="button" class="btn btn-link" @onclick="CancelAsync">@Strings.Common.Cancel</button>
        </div>
    </EditForm>

    <ParentNotMine @bind-Open="addParentOpen" Added="ParentAdded" />

    <Sheet Title="@OfferTitle" Open="offer.Count > 0" OpenChanged="OfferOpenChanged">
        <p>@OfferText</p>
        <ul class="small">
            @foreach (var other in offer)
            {
                <li>@other.DisplayName</li>
            }
        </ul>
        <div class="form-actions likes-offer">
            <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SetForAllAsync">@F(Strings.PlantEdit.SetForAll, offer.Count)</button>
            <button type="button" class="btn btn-link" @onclick="LeaveOffer">@Strings.PlantEdit.OnlyThisOne</button>
        </div>
    </Sheet>
}

@code {
    private static string F(string format, params object?[] args) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, format, args);

    // Picks the one or other form by count, then fills in the rest
    private static string F(int count, string one, string other, params object?[] args) => F(count == 1 ? one : other, args);

    private static string H(string text) => System.Net.WebUtility.HtmlEncode(text);

    private static string Link(string href, string text, string? cssClass = null) =>
        $"<a{(cssClass is null ? "" : $" class=\"{cssClass}\"")} href=\"{href}\">{H(text)}</a>";

    // Resource text with already encoded pieces (links, names) where {0}, {1} and so on are
    private static MarkupString Html(string format, params string[] encoded) => (MarkupString)F(format, encoded);

    /// <summary>"a", "a and b", "a, b and c", for pieces that are already encoded.</summary>
    private static string JoinAnd(IEnumerable<string> parts)
    {
        var list = parts.ToList();
        return list.Count <= 1 ? string.Concat(list) : F(Strings.PlantDetail.ListAnd, string.Join(", ", list.SkipLast(1)), list[^1]);
    }

    private static readonly WaterMethod?[] WaterByChoices = [null, .. Enum.GetValues<WaterMethod>().Cast<WaterMethod?>()];

    private bool showErrors;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showErrors)
            return;
        showErrors = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("showAlert", "form-errors");
    }

    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Pre-selects a parent, e.g. from the Family section on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentId { get; set; }

    /// <summary>Starts from a copy of another plant, from "Add another like this" on its page.</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    public Guid? CopyOfId { get; set; }

    /// <summary>Starts from a wish on the wishlist, from Got it. Once the plant is saved the wish moves to Got.</summary>
    [SupplyParameterFromQuery(Name = "wish")]
    public Guid? WishId { get; set; }

    private PlantForm? form;
    private (Guid? Id, Guid? CopyOfId, Guid? WishId, Guid? ParentId) formFor;

    /// <summary>"photos" starts from old photos, from the first screen, with the photos first.</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private bool FromPhotos => IsNew && From == "photos";

    private readonly string cameraId = $"camera-{Guid.NewGuid():N}";
    private readonly string galleryId = $"gallery-{Guid.NewGuid():N}";
    private ElementReference cameraInput;
    private ElementReference galleryInput;
    private GooglePhotosPick? googlePick;
    private bool googleBusy;

    private async Task StartGoogleAsync()
    {
        if (googlePick is not null)
            await googlePick.Start();
    }

    private bool googleOn;

    /// <summary>Photos taken while adding the plant. They're saved with the plant.</summary>
    private readonly List<Photo> photos = [];
    private string? photoStatus;
    private bool busy;
    private LooseDate? dateFromPhotos; // when the day it was got was moved back to the oldest photo
    private bool keepToday;

    private Plant? plant; // the form's draft
    private int nextNumber = 1;

    private string? NumberCode => CollectionNumbers.Normalize(plant?.CollectionNumber);
    private bool NumberInvalid => NumberCode is { } code && !CollectionNumbers.IsValid(code);
    private IReadOnlyList<CodeClash> NumberClashes =>
        NumberCode is { } code && !NumberInvalid && form is not null
            ? CollectionNumbers.Clashes(code, plant!.Id, form.Plants, form.Propagations)
            : [];
    private bool notFound;
    private bool saving;
    private List<string> errors = [];
    private IReadOnlyList<Plant> possibleParents = [];
    private bool addParentOpen;

    // A parent that lives with someone else was just saved: list it and pick it
    private void ParentAdded(Plant parent)
    {
        form!.AddKnownPlant(parent);
        possibleParents = PlantLineage.PossibleParents(plant!, form.Plants);
        plant!.ParentPlantId = parent.Id;
    }
    private IReadOnlyList<Room> rooms = [];
    private IReadOnlyList<string> tagSuggestions = [];

    // Which sections start open, worked out when the plant loads. A section only reads this once
    private bool openLives;
    private bool openArrival;

    private IReadOnlyList<string> sellerNames = [];

    private bool ShowArrival =>
        plant is not null
        && (SellerName.Clean(form?.SellerText) is not null || plant.Origin is PlantOrigin.Purchased or PlantOrigin.Gift or PlantOrigin.Swap);
    private bool openLikes;

    // What common plants usually like, offered above What it likes. Empty if it couldn't be read.
    private PlantCareBook careBook = PlantCareBook.Empty;

    private PlantCare? CareFor => plant is null ? null : careBook.Find(plant.Genus, plant.Species, plant.NameQualifier);

    // Nothing is saved until the form is
    private void UseCare(PlantCare care)
    {
        if (plant is not null)
            CareSuggestion.Apply(plant, care);
    }

    // The other plants of the same species offered the needs just saved, and which of them
    private IReadOnlyList<Plant> offer = [];
    private IReadOnlyList<LikesField> offerFields = [];

    private string OfferTitle => F(Strings.PlantEdit.OfferTitle, Stikling.Core.Models.PlantNames.Botanical(plant?.Genus, plant?.Species, null));

    private string OfferText
    {
        get
        {
            var values = string.Join(" · ", offerFields.Select(f => LikesValue(plant!, f)));
            var count = offer.Count;
            return F(count, Strings.PlantEdit.OfferText_One, Strings.PlantEdit.OfferText_Other, values, count);
        }
    }

    private static string LikesValue(Plant p, LikesField field) => field switch
    {
        LikesField.Light => p.LikesLight is { } light ? Labels.For(light) : Strings.PlantEdit.NoLightLikes,
        LikesField.Water => p.LikesWater is { } water ? Labels.For(water) : Strings.PlantEdit.NoWaterNeed,
        LikesField.Humidity => p.LikesHumidity is { } humidity ? Labels.For(humidity) : Strings.PlantEdit.NoHumidityNeed,
        LikesField.Season => p.GrowingSeason is { } season ? Labels.For(season) : Strings.PlantEdit.NoSeason,
        _ => p.RestHow is { } rest ? Labels.For(rest) : Strings.PlantEdit.NoRest
    };

    private string? LikesSummary => plant is null ? null : Joined(
        plant.LikesLight is { } light ? Labels.For(light) : null,
        plant.LikesWater is { } water ? Labels.For(water) : null,
        plant.LikesHumidity is { } humidity ? Labels.For(humidity) : null,
        plant.GrowingSeason is { } season ? Labels.For(season) : null);
    private bool openPot;
    private bool openTags;

    // Your own fields. The text is as typed and is tidied when the plant is saved, so a field added
    // here shows up with an empty input and nothing else on the form is lost.
    private bool addingField;
    private bool openFields;
    private bool openSitter;
    private bool openSwap;
    private bool openWatering;

    private static readonly PotGroup[] InnerSlot = [PotGroup.Inner, PotGroup.Standalone];
    private static readonly PotGroup[] OuterSlot = [PotGroup.Outer];

    private DateOnly Today => Time.Today();

    private void SetWateringFeed(string? value) =>
        form!.SetWateringFeed(Guid.TryParse(value, out var id) ? id : null);

    private static string? Joined(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));

    private string? LivesSummary => Joined(form?.Location, plant?.Light is { } light ? Labels.For(light) : null);

    private string? PotSummary => plant is null || form is null ? null : Joined(
        Labels.For(plant.Medium),
        plant.InnerPotId is { } inner ? form.PotName(inner) : null,
        plant.OuterPotId is { } outer ? form.PotName(outer) : null,
        plant.SoilMixId is { } mix ? form.MixName(mix) : null);

    private string? WateringSummary => plant is null || form is null ? null
        : !plant.WateringReminder ? Strings.PlantEdit.NoReminder
        : plant.WaterAt is { } at && WateringForms.Of(plant, form.FindPot) == WateringForm.TopWatered ? F(Strings.PlantEdit.WaterAtSummary, at)
        : null;

    private string? AboutSummary => string.IsNullOrWhiteSpace(plant?.Notes) ? null : Labels.Short(plant.Notes);

    private RenderFragment AboutField => @<div>
        <div id="about-help" class="form-text mt-0">@Strings.PlantEdit.AboutHelp</div>
        <InputTextArea class="form-control" rows="3" @bind-Value="plant!.Notes" aria-label="@Strings.PlantDetail.AboutIt" aria-describedby="about-help" />
    </div>;

    private string? SitterSummary => string.IsNullOrWhiteSpace(plant?.SitterNote) ? null : Labels.Short(plant.SitterNote);

    private string? SwapSummary => plant?.Spare is { } mark ? SwapLists.MarkText(mark) : null;

    private string FieldsSummary =>
        form is null || form.OwnFields.Count == 0
            ? Strings.PlantEdit.FieldsEmpty
            : form.OwnFields.Where(f => !string.IsNullOrWhiteSpace(form.FieldInput(f.Id))).Select(f => f.Name) is { } filled && filled.Any()
                ? string.Join(", ", filled)
                : Strings.PlantEdit.FieldsNoneFilled;

    private async Task FieldAddedAsync(OwnField field)
    {
        await form!.AddOwnFieldAsync(field);
        addingField = false;
    }

    private string? TagsSummary => plant is { Tags.Count: > 0 } ? string.Join(", ", plant.Tags) : null;

    private string QuarantineSummary => plant is { InQuarantine: true }
        ? F(plant.QuarantineDays ?? form!.QuarantineLength, Strings.PlantEdit.QuarantineSummary_One, Strings.PlantEdit.QuarantineSummary_Other, plant.QuarantineDays ?? form!.QuarantineLength)
        : Strings.PlantEdit.NotInQuarantine;

    private void SetQuarantine(ChangeEventArgs e) => form!.SetQuarantine((bool?)e.Value == true);

    // The form knows whether the plant has been created yet, the route only what the page was opened for
    // The layout follows the route, so a save that fails after the plant was added doesn't turn the
    // form into an edit form. Whether saving adds or updates is the form's own IsNew
    private bool IsNew => Id is null;

    private bool RouteNew => Id is null;

    private bool ShowParent =>
        plant is not null
        && (plant.Origin is PlantOrigin.Propagated or PlantOrigin.GrownFromSeed || plant.ParentPlantId is not null);

    protected override async Task OnParametersSetAsync()
    {
        googleOn = await Google.IsEnabledAsync();
        careBook = await CommonCare.GetBookAsync();

        // A new form only when the page was opened for something else, so a re-render never resets a draft
        var key = (Id, CopyOfId, WishId, ParentId);
        if (form is not null && formFor == key)
            return;

        formFor = key;
        form = Id is { } id ? await Forms.EditAsync(id, Labels.For) : await Forms.NewAsync(CopyOfId, WishId, ParentId, Labels.For);
        plant = form?.Plant;
        notFound = form is null;
        if (form is null || plant is null)
            return;

        var all = form.Plants;
        rooms = Room.List(form.Places, all, form.Propagations);
        nextNumber = CollectionNumbers.NextFree(all);
        tagSuggestions = PlantTags.Suggestions(all);
        var uses = SellerSummary.CountsBySeller(form.SellerList, all, form.Propagations);
        sellerNames = form.SellerList.Live.OrderByDescending(s => uses.GetValueOrDefault(s.Id)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => s.Name).ToList();
        possibleParents = PlantLineage.PossibleParents(plant, all);

        var isNew = form.IsNew;
        openArrival = !isNew && (plant.ArrivedIn is not null || plant.ArrivalProblems.Count > 0 || !string.IsNullOrWhiteSpace(plant.ArrivalNote));

        // All closed when adding, even from a copy, where the summaries show what was copied
        openLives = !isNew && (!string.IsNullOrWhiteSpace(form.Location) || plant.Light is not null);
        openLikes = !isNew && CareLikes.HasAny(plant);
        openPot = !isNew && (plant.SoilMixId is not null || plant.InnerPotId is not null || plant.OuterPotId is not null);
        openTags = !isNew && plant.Tags.Count > 0;
        openFields = !isNew && plant.OwnFields.Any(v => form.OwnFields.Any(f => f.Id == v.Key) && v.Value.Length > 0);
        openSwap = !isNew && plant.Spare is not null;
        openSitter = !isNew && !string.IsNullOrWhiteSpace(plant.SitterNote);
        openWatering = !isNew && (!plant.WateringReminder || plant.WaterAt is not null || plant.WaterBy is not null || plant.WateringFeedId is not null);
    }

    private async Task AddPhotosAsync(ElementReference input, bool fromCamera)
    {
        if (plant is null)
            return;

        busy = true;
        photoStatus = Strings.PlantEdit.SavingPhotos;
        StateHasChanged();

        try
        {
            var result = await Photos.SaveFromInputAsync(input, SubjectType.Plant, plant.Id);
            photos.AddRange(result.Saved);
            photoStatus = result.Message(guessesMatter: !fromCamera);
            FollowPhotoDates();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding photos to a plant failed");
            photoStatus = F(Strings.PlantEdit.PhotosFailed, ex.Message);
        }

        busy = false;
    }

    private Task GoogleSavedAsync(PhotoSaveResult result)
    {
        photos.AddRange(result.Saved);
        photoStatus = result.Message(guessesMatter: true);
        FollowPhotoDates();
        return Task.CompletedTask;
    }

    private async Task RemovePhotoAsync(Photo photo)
    {
        await Photos.DeleteAsync(photo.Id);
        photos.Remove(photo);
        photoStatus = null;
        FollowPhotoDates();
    }

    // Old photos would otherwise come before "Added to collection" in the history, so the day it
    // was got moves back to the oldest one. Only while it's still the day the form started with
    private void FollowPhotoDates()
    {
        if (plant is null || keepToday || (plant.AcquiredOn != LooseDate.Of(Today) && plant.AcquiredOn != dateFromPhotos))
            return;

        dateFromPhotos = PhotoEntries.OldestDay(photos, Time) is { } oldest && oldest < Today ? LooseDate.Of(oldest) : null;
        plant.AcquiredOn = dateFromPhotos ?? LooseDate.Of(Today);
    }

    private void KeepToday()
    {
        keepToday = true;
        plant!.AcquiredOn = LooseDate.Of(Today);
    }

    private RenderFragment PhotoSection => @<fieldset>
        <legend>@(FromPhotos ? Strings.PlantEdit.Photos : Strings.PlantEdit.Photo)</legend>
        @if (FromPhotos)
        {
            <p class="form-text mt-0">
                @Strings.PlantEdit.PhotosFromGallery
            </p>
        }
        @if (photos.Count > 0)
        {
            <div class="photo-picks">
                @foreach (var photo in photos)
                {
                    <div class="photo-pick">
                        <PhotoImage PhotoId="photo.Id" Alt="@Strings.PlantEdit.PhotoOfNew" />
                        <button type="button" class="photo-remove" @onclick="() => RemovePhotoAsync(photo)"
                                aria-label="@Strings.PlantEdit.RemovePhoto" title="@Strings.PlantEdit.RemovePhoto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                    </div>
                }
            </div>
        }

        <div class="composer-row">
            @if (!FromPhotos)
            {
                <label class="btn btn-outline-primary btn-sm icon-btn" for="@cameraId">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                    @Strings.PlantEdit.Camera
                </label>
                <input id="@cameraId" type="file" accept="image/*" capture="environment" class="visually-hidden"
                       @ref="cameraInput" @onchange="() => AddPhotosAsync(cameraInput, fromCamera: true)" disabled="@busy" />
            }

            <label class="btn btn-outline-primary icon-btn @(FromPhotos ? null : "btn-sm")" for="@galleryId">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-5 4 4 3-3 4 4" /></svg>
                @(!FromPhotos ? Strings.PlantEdit.Gallery : photos.Count > 0 ? Strings.PlantEdit.AddMore : Strings.PlantEdit.PickPhotos)
            </label>
            <input id="@galleryId" type="file" accept="image/*" multiple class="visually-hidden"
                   @ref="galleryInput" @onchange="() => AddPhotosAsync(galleryInput, fromCamera: false)" disabled="@busy" />
            @if (googleOn)
            {
                <button type="button" class="btn btn-outline-primary icon-btn @(FromPhotos ? null : "btn-sm")" @onclick="StartGoogleAsync"
                        disabled="@(busy || googleBusy)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                    @Strings.PlantEdit.GooglePhotos
                </button>
            }
        </div>
        @if (googleOn && plant is not null)
        {
            <GooglePhotosPick @ref="googlePick" SubjectType="SubjectType.Plant" SubjectId="plant.Id" OnSaved="GoogleSavedAsync" BusyChanged="busy => googleBusy = busy" />
        }

        @if (!FromPhotos)
        {
            <div class="form-text">@Strings.PlantEdit.PhotoCoverNote</div>
        }
        @if (photoStatus is not null)
        {
            <p class="composer-status" role="status">@photoStatus</p>
        }
    </fieldset>;

    // Leaving without saving the plant: the photos would belong to nothing
    private async Task CancelAsync()
    {
        await DiscardPhotosAsync();
        Navigation.NavigateTo(RouteNew ? "plants" : $"plants/{Id}");
    }

    private async Task DiscardPhotosAsync()
    {
        // A plant stored before its save failed owns the photos, so they stay
        if (form is { Stored: true })
        {
            photos.Clear();
            return;
        }
        foreach (var photo in photos)
            await Photos.DeleteAsync(photo.Id);
        photos.Clear();
    }

    /// <summary>Also covers leaving by the back link or the phone's back button.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DiscardPhotosAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the photos go with it
        }
    }

    private bool left;

    private void GoToPlant()
    {
        if (left || plant is null)
            return;
        left = true;
        Navigation.NavigateTo($"plants/{plant.Id}", replace: RouteNew);
    }

    private async Task SetForAllAsync()
    {
        if (plant is null || saving)
            return;
        saving = true;
        try
        {
            await PlantService.ApplyLikesAsync(plant, offerFields, offer);
            offer = [];
            GoToPlant();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Setting what it likes on the other plants failed");
            errors = [F(Strings.PlantDetail.CouldntSave, ex.Message)];
            showErrors = true;
            offer = [];
        }
        finally
        {
            saving = false;
        }
    }

    private void LeaveOffer()
    {
        offer = [];
        GoToPlant();
    }

    // Closing the sheet counts as Only this one
    private void OfferOpenChanged(bool open)
    {
        if (!open)
            LeaveOffer();
    }

    private async Task SaveAsync()
    {
        if (form is null)
            return;

        errors = [];
        saving = true;
        try
        {
            var result = await form.SaveAsync(photos);
            if (result.Errors.Count > 0)
            {
                errors = [.. result.Errors];
                showErrors = true;
                return;
            }

            if (result.Created)
                photos.Clear(); // they belong to the saved plant now
            // The plant is saved by now, so a wish that can't be moved or a history line that failed is logged, not a failed save
            if (result.LaterError is { } later)
                Logger.LogError(later, "A step after saving the plant failed");

            if (result.LikesOffer.Count > 0)
            {
                // Others of the same species that don't have what was just set are asked before leaving
                offerFields = result.LikesFields;
                offer = result.LikesOffer;
            }
            else
            {
                GoToPlant();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the plant failed");
            errors = [F(Strings.PlantDetail.CouldntSave, ex.Message)];
            showErrors = true;
        }
        finally
        {
            saving = false;
        }
    }
}
