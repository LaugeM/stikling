@page "/care-intervals"
@layout WideLayout
@inject ICareIntervalRepository Repository
@inject IPlantRepository PlantRepository
@inject IFeedRepository FeedRepository
@inject OwnCareKindService OwnKindService
@inject RoomService RoomService

<PageTitle>@Strings.Care.IntervalListPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="settings?section=care">@Strings.Care.BackToSettings</a>
<h1>@Strings.Care.IntervalListTitle</h1>

<p class="settings-hint">
    @Strings.Care.IntervalListHint
</p>

@if (loading)
{
    <p class="text-body-secondary">@Strings.Care.Loading</p>
}
else if (rows.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Care.IntervalListEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Care.IntervalListEmptyText
        </p>
        <a class="btn btn-primary" href="care-intervals/new">@Strings.Care.IntervalListAdd</a>
    </div>
}
else
{
    <div class="settings-rows interval-rows">
        @foreach (var row in rows)
        {
            <SettingsRow Href="@($"care-intervals/{row.Interval.Id}")" Title="@row.Title" Detail="@row.Detail" />
        }
    </div>

    <div class="form-actions mt-3">
        <a class="btn btn-primary" href="care-intervals/new">@Strings.Care.IntervalListAdd</a>
    </div>
}

@code {
    private sealed record Row(CareInterval Interval, string Title, string Detail);

    private IReadOnlyList<Row> rows = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var intervals = await Repository.GetAllAsync();
        var plants = await PlantRepository.GetAllAsync();
        var places = await RoomService.GetPlacesAsync();
        var feeds = (await FeedRepository.GetAllAsync()).ToDictionary(f => f.Id);
        var ownKinds = (await OwnKindService.GetAllAsync()).ToDictionary(k => k.Id);

        rows = [.. intervals.OrderBy(i => i.CreatedAt).Select(interval =>
        {
            var ownName = interval.OwnKindId is { } own ? (ownKinds.TryGetValue(own, out var kind) ? kind.Name : Strings.Care.IntervalRemovedKind) : null;
            var feed = interval.FeedId is { } feedId && feeds.TryGetValue(feedId, out var found) ? found.Name : null;
            var title = CareIntervals.Label(interval.Kind, ownName, feed);

            if (CareIntervals.CountsAsWatering(interval, CareLabels.Lookup(ownKinds.Values)))
                return new Row(interval, title, string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.IntervalOffCountsAsWatering, ownName));

            var every = CareIntervals.EveryText(interval);
            var parts = new List<string> { char.ToUpperInvariant(every[0]) + every[1..] };
            if (CareIntervals.MonthsText(interval) is { } months)
                parts.Add(months);
            parts.Add(Covers(interval, plants, places));
            return new Row(interval, title, string.Join(" · ", parts));
        })];
        loading = false;
    }

    // "Semi-hydro tag (14 plants)", "All plants (52)", "Living room (8)" or "3 plants"
    private static string Covers(CareInterval interval, IReadOnlyList<Plant> plants, Places places)
    {
        var count = CareIntervals.PlantsIn(interval, plants, places).Count;
        return interval.Scope switch
        {
            CareScope.Everywhere => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.IntervalCoversAll, count),
            CareScope.Room => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.IntervalCoversRoom, places.NameOf(interval.PlaceId) ?? Strings.Care.IntervalCoversARoom, count),
            CareScope.Tag => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.IntervalCoversTag, interval.Tag, Labels.Plants(count)),
            _ => Labels.Plants(count)
        };
    }
}
