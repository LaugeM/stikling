@page "/plants/{Id:guid}/family"
@layout WideLayout
@inject CoverPhotos Covers
@inject IPlantRepository Repository
@inject IPropagationRepository PropagationRepository

<PageTitle>@F(Strings.PlantDetail.PageTitle, plant is null ? Strings.Plants.FamilyTitle : F(Strings.Plants.FamilyTitleOf, plant.DisplayName))</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="plants/@Id">@(plant?.DisplayName ?? Strings.PlantDetail.PlantFallback)</a>

@if (plant is null || tree is null)
{
    <p class="text-body-secondary">@(loaded ? Strings.PlantDetail.NotFound : Strings.Plants.Loading)</p>
}
else
{
    @if (tree.Ancestors.Count > 0)
    {
        <section class="family-came-from" aria-label="@Strings.PlantEdit.LegendCameFrom">
            @if (tree.MoreAbove)
            {
                <a class="link-action family-earlier" href="plants/@tree.Ancestors[0].Id/family">@Strings.Plants.FamilyEarlier</a>
            }
            <ul class="family-chain">
                @foreach (var ancestor in tree.Ancestors)
                {
                    <li>
                        <a class="family-ancestor @(Left(ancestor) ? "faded" : null)" href="plants/@ancestor.Id/family">
                            <span class="family-ancestor-photo potted" aria-hidden="true">
                                @if (Covers.Shown(ancestor.CoverPhotoId) is { } coverId)
                                {
                                    <PhotoImage PhotoId="coverId" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
                                }
                            </span>
                            <span class="item-name">@ancestor.DisplayName</span>
                            @if (!ancestor.InCollection)
                            {
                                <span class="badge text-bg-secondary">@Labels.StatusOf(ancestor)</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="family-focus">
        <div class="family-focus-photo potted">
            @if (Covers.Shown(plant.CoverPhotoId) is { } focusCover)
            {
                <PhotoImage PhotoId="focusCover" Thumbnail="false" Alt="@F(Strings.PlantDetail.PhotoOf, plant.DisplayName)" />
            }
            else
            {
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
            }
        </div>
        <h1>
            @if (string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
            {
                <BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" Qualifier="@plant.NameQualifier" Note="@plant.NameNote" />
            }
            else
            {
                @plant.DisplayName
            }
        </h1>
        @if (!string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
        {
            <p class="detail-sub"><BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" Qualifier="@plant.NameQualifier" Note="@plant.NameNote" /></p>
        }
        @if (!plant.InCollection)
        {
            <p class="profile-facts">@Labels.StatusOf(plant)</p>
        }
        <a class="btn btn-outline-primary" href="plants/@plant.Id">@Strings.Plants.FamilyOpenPlant</a>
    </section>

    @if (tree.IsEmpty)
    {
        <div class="empty-state family-empty">
            <p>@F(Strings.Plants.FamilyEmpty, plant.DisplayName)</p>
            <div class="family-empty-actions">
                <a class="btn btn-primary" href="propagations/new?parent=@plant.Id">@Strings.Plants.FamilyStartPropagation</a>
                <a class="btn btn-outline-primary" href="plants/@plant.Id/edit">@Strings.Plants.FamilySetOrigin</a>
            </div>
        </div>
    }

    @if (tree.Siblings.Count > 0)
    {
        <section class="family-section">
            <h2 class="section-label">@F(Strings.Plants.FamilySiblings, tree.Siblings.Count)</h2>
            <ul class="plant-grid family-siblings">
                @foreach (var sibling in tree.Siblings)
                {
                    <li>
                        <PlantTile Plant="sibling" Href="@($"plants/{sibling.Id}/family")" Faded="Left(sibling)" />
                    </li>
                }
            </ul>
        </section>
    }

    @if (tree.Children.Count > 0)
    {
        <section class="family-section">
            <h2 class="section-label">@F(Strings.Plants.FamilyGrownFromIt, tree.Children.Count)</h2>
            <ul class="plant-grid">
                @foreach (var child in tree.Children)
                {
                    <li>
                        <PlantTile Plant="child.Plant" Href="@($"plants/{child.Plant.Id}/family")" Faded="Left(child.Plant)">
                            @if (child.Below > 0)
                            {
                                <text>@Plural.Of(child.Below, Strings.Plants.FamilyBelow_One, Strings.Plants.FamilyBelow_Other)</text>
                            }
                        </PlantTile>
                    </li>
                }
            </ul>
        </section>
    }

    @if (tree.Growing.Count > 0)
    {
        <section class="family-section">
            <h2 class="section-label">@F(Strings.Plants.FamilyOnTheWay, tree.Growing.Count)</h2>
            <ul class="item-list">
                @foreach (var propagation in tree.Growing)
                {
                    <li><PropagationCard Propagation="propagation" ShowStage="true" /></li>
                }
            </ul>
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private static string F(string format, params object?[] args) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, format, args);

    private Plant? plant;
    private FamilyTree? tree;
    private bool loaded;

    // Moving the tree is a navigation to this page with another id
    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        loaded = true;
    }

    private static bool Left(Plant p) => !p.InCollection;

    private async Task LoadAsync()
    {
        var all = await Repository.GetAllAsync();
        plant = all.FirstOrDefault(p => p.Id == Id);
        tree = plant is null
            ? null
            : PlantLineage.Tree(plant, all, await PropagationRepository.GetAllAsync());
    }
}
