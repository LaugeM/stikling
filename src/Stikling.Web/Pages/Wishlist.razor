@page "/wishlist"
@layout WideLayout
@inject WishService WishService
@inject IPlantRepository PlantRepository
@inject IPropagationRepository PropagationRepository
@inject PlantNameService Names
@inject SitterSheetActions Sharing
@implements IDisposable

<PageTitle>@Strings.Shared.WishlistPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="plants">@Strings.Shared.BackToPlants</a>

<div class="page-heading">
    <h1>@Strings.Shared.WishlistTitle</h1>
    <div class="d-flex align-items-baseline justify-content-end flex-wrap gap-2">
        @if (open.Count > 0)
        {
            <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => shareOpen = true">@Strings.Shared.WishlistShareAsText</button>
        }
        @* Takes over from the round add button on a wide screen *@
        <a class="btn btn-primary btn-sm icon-btn heading-add" href="wishlist/new">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            @Strings.Shared.WishlistAdd
        </a>
    </div>
</div>

@if (wishes is null)
{
    <p class="text-body-secondary">@Strings.Shared.Loading</p>
}
else
{
    @if (wishes.Count > 0 || plants.Count > 0 || propagations.Count > 0)
    {
        <div class="wish-search">
            <input type="search" class="form-control" placeholder="@Strings.Shared.WishlistSearchPlaceholder"
                   aria-label="@Strings.Shared.WishlistSearchLabel" @bind="search" @bind:event="oninput" @bind:after="Refresh" />
        </div>
    }

    @if (wishes.Count == 0)
    {
        <div class="empty-state">
            <p>@Strings.Shared.WishlistEmpty</p>
            <a class="btn btn-primary mt-3" href="wishlist/new">@Strings.Shared.WishlistAdd</a>
            <p class="mt-3"><a href="help#wishlist">@Strings.Shared.WishlistHelpLink</a></p>
        </div>
    }

    @if (wishes.Count > 0 && Searching && shownOpen.Count == 0 && shownGot.Count == 0)
    {
        <p class="text-body-secondary">@Strings.Shared.WishlistNoMatch</p>
    }
    else if (wishes.Count > 0 && !Searching && open.Count == 0)
    {
        <p class="text-body-secondary">@Strings.Shared.WishlistNoOpen</p>
    }

    @if (shownOpen.Count > 0)
    {
        <ul class="item-list list-grid">
            @foreach (var wish in shownOpen)
            {
                var have = WishMatches.Have(wish, plants, dictionary).Describe();
                <li><div class="wish-row">
                    <WishThumb Photos="photos" Wish="wish" />
                    <a class="wish-main" href="wishlist/@wish.Id/edit">
                        <div class="item-name">@Name(wish)</div>
                        @if (Sub(wish) is { } sub)
                        {
                            <div class="item-sub-plain">@sub</div>
                        }
                        @if (MetaFor(wish) is { Length: > 0 } meta)
                        {
                            <div class="item-meta wraps">@meta</div>
                        }
                        @if (have is not null)
                        {
                            <div class="item-meta wraps wish-have">@have</div>
                        }
                    </a>
                    @if (choosing == wish.Id)
                    {
                        <div class="wish-choice" role="group" aria-label="@Strings.Shared.WishlistGotItAs">
                            <span class="wish-choice-label">@Strings.Shared.WishlistGotItAs</span>
                            <a class="btn btn-primary btn-sm" href="plants/new?wish=@wish.Id">@Strings.Shared.WishlistAPlant</a>
                            <a class="btn btn-primary btn-sm" href="propagations/new?wish=@wish.Id">@Strings.Shared.WishlistACutting</a>
                            <button type="button" class="btn btn-link btn-sm" @onclick="() => choosing = null">@Strings.Common.Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="wish-actions">
                            <button type="button" class="btn btn-outline-primary btn-sm" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistGotItLabel, wish.DisplayName)" @onclick="() => choosing = wish.Id">@Strings.Shared.WishlistGotIt</button>
                        </div>
                    }
                </div></li>
            }
        </ul>
    }

    @if (shownGot.Count > 0)
    {
        <section class="wish-got" aria-labelledby="wish-got-title">
            <h2 id="wish-got-title">@Strings.Shared.WishlistGot <span class="text-body-secondary">(@shownGot.Count)</span></h2>
            <ul class="item-list list-grid">
                @foreach (var wish in shownGot)
                {
                    <li><div class="wish-row">
                        <WishThumb Photos="photos" Wish="wish" />
                        <a class="wish-main" href="wishlist/@wish.Id/edit">
                            <div class="item-name">@Name(wish)</div>
                            @if (Sub(wish) is { } sub)
                            {
                                <div class="item-sub-plain">@sub</div>
                            }
                            <div class="item-meta wraps">
                                @(wish.GotOn is { } gotOn ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistGotOn, Labels.Date(gotOn)) : "")
                            </div>
                        </a>
                        <div class="wish-actions">
                            @if (BecameLink(wish) is var (href, label, kind))
                            {
                                <a class="btn btn-outline-primary btn-sm" href="@href" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistSeeLabel, label)">@kind</a>
                            }
                            <button type="button" class="btn btn-link btn-sm" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistPutBackLabel, wish.DisplayName)" @onclick="() => PutBackAsync(wish)">@Strings.Shared.WishlistPutBack</button>
                        </div>
                    </div></li>
                }
            </ul>
        </section>
    }

    @if (Searching && (havePlants.Count > 0 || havePropagations.Count > 0))
    {
        <section class="wish-have-group" aria-labelledby="wish-have-title">
            <h2 id="wish-have-title">@Strings.Shared.WishlistAlreadyHave</h2>
            <ul class="item-list list-grid">
                @foreach (var plant in havePlants)
                {
                    <li>
                        <a class="item-card" href="plants/@plant.Id">
                            <div class="item-text">
                                <div class="item-name">@plant.DisplayName</div>
                                @if (plant.BotanicalName is { } botanical && plant.DisplayName != botanical)
                                {
                                    <div class="item-sub">@botanical</div>
                                }
                            </div>
                        </a>
                    </li>
                }
                @foreach (var propagation in havePropagations)
                {
                    <li>
                        <a class="item-card" href="propagations/@propagation.Id">
                            <div class="item-text">
                                <div class="item-name">@propagation.ListName</div>
                                <div class="item-meta">@Strings.Shared.WishlistInProgress</div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    <a class="fab" href="wishlist/new" aria-label="@Strings.Shared.WishlistAdd" title="@Strings.Shared.WishlistAdd">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
}

<Sheet Title="@Strings.Shared.WishlistShareAsText" @bind-Open="shareOpen">
    <p class="text-body-secondary small">@Strings.Shared.WishlistShareHint</p>
    <div class="form-check form-switch mb-2">
        <input type="checkbox" class="form-check-input" id="share-notes" role="switch" @bind="shareNotes" />
        <label class="form-check-label" for="share-notes">@Strings.Shared.WishlistShareNotes</label>
    </div>
    <div class="form-check form-switch mb-2">
        <input type="checkbox" class="form-check-input" id="share-price" role="switch" @bind="sharePrice" />
        <label class="form-check-label" for="share-price">@Strings.Shared.WishlistSharePrice</label>
    </div>
    <div class="form-check form-switch mb-3">
        <input type="checkbox" class="form-check-input" id="share-app" role="switch" @bind="shareApp" />
        <label class="form-check-label" for="share-app">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistShareApp, WishlistText.AppLine)</label>
    </div>
    <pre class="wish-preview" aria-label="@Strings.Shared.WishlistSharePreview">@ShareText</pre>
    <div class="d-flex align-items-center gap-3">
        <button type="button" class="btn btn-primary share-button" @onclick="ShareAsync">@Strings.Shared.ShareButton</button>
        @if (shareStatus.Length > 0)
        {
            <span role="status">@shareStatus</span>
        }
    </div>
</Sheet>

@code {
    private IReadOnlyList<Wish>? wishes;
    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<Propagation> propagations = [];
    private PlantDictionary? dictionary;
    private List<Wish> open = [];
    private List<Wish> got = [];
    private IReadOnlyList<Wish> shownOpen = [];
    private IReadOnlyList<Wish> shownGot = [];
    private IReadOnlyList<Plant> havePlants = [];
    private IReadOnlyList<Propagation> havePropagations = [];
    private string? search;
    private Guid? choosing;
    private bool shareOpen;
    private bool shareNotes;
    private bool sharePrice;
    private bool shareApp = true;
    private string shareStatus = "";
    private bool disposed;

    private bool Searching => !string.IsNullOrWhiteSpace(search);

    private string ShareText => WishlistText.Write(open, dictionary?.EverydayNames,
        new WishlistTextOptions(shareNotes, sharePrice, shareApp));

    // The newest photo of each wish that has one, by the wish's id
    private IReadOnlyDictionary<Guid, Photo> photos = new Dictionary<Guid, Photo>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        dictionary = await Names.GetDictionaryAsync();
        plants = await PlantRepository.GetAllAsync();
        propagations = await PropagationRepository.GetAllAsync();
        var all = await WishService.GetAllAsync();
        photos = await WishService.GetNewestPhotosAsync();
        open = [.. all.Where(w => !w.IsGot).OrderBy(w => w.CreatedAt)];
        got = [.. all.Where(w => w.IsGot).OrderByDescending(w => w.GotOn)];
        wishes = all;
        Refresh();
    }

    private void Refresh()
    {
        if (Searching)
        {
            var found = WishSearch.Wishes(wishes ?? [], search, dictionary).ToHashSet();
            shownOpen = open.Where(found.Contains).ToList();
            shownGot = got.Where(found.Contains).ToList();
            havePlants = WishSearch.Plants(plants, search, dictionary);
            havePropagations = WishSearch.Propagations(propagations, search, dictionary);
        }
        else
        {
            shownOpen = open;
            shownGot = got;
            havePlants = [];
            havePropagations = [];
        }
    }

    // The botanical name, or the name typed in when there isn't one
    private RenderFragment Name(Wish wish) => wish.BotanicalName is not null
        ? @<BotanicalName Genus="@wish.Genus" Species="@wish.Species" Cultivar="@wish.Cultivar" Qualifier="@wish.NameQualifier" Note="@wish.NameNote" />
        : @<text>@wish.DisplayName</text>;

    // The everyday name, or the name typed in next to a botanical one
    private string? Sub(Wish wish)
    {
        if (wish.BotanicalName is null)
            return null;
        var called = dictionary?.EverydayNames.For(wish.Genus, wish.Species, wish.Cultivar);
        return !string.IsNullOrWhiteSpace(called) ? called : string.IsNullOrWhiteSpace(wish.Name) ? null : wish.Name.Trim();
    }

    private static string MetaFor(Wish wish)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(wish.FoundAt))
            parts.Add(wish.FoundAt.Trim());
        if (wish.MostToPay is { } price)
            parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.WishlistUpTo, price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)));
        if (!string.IsNullOrWhiteSpace(wish.Notes))
            parts.Add(wish.Notes.Trim());
        return string.Join(" · ", parts);
    }

    // A got wish links to what it became. Nothing is shown when that record has been deleted.
    private (string Href, string Label, string Kind)? BecameLink(Wish wish)
    {
        if (wish.PlantId is { } plantId && plants.FirstOrDefault(p => p.Id == plantId) is { } plant)
            return ($"plants/{plant.Id}", plant.DisplayName, Strings.Shared.WishlistSeePlant);
        if (wish.PropagationId is { } propagationId && propagations.FirstOrDefault(p => p.Id == propagationId) is { } propagation)
            return ($"propagations/{propagation.Id}", propagation.ListName, Strings.Shared.WishlistSeeCutting);
        return null;
    }

    private async Task PutBackAsync(Wish wish)
    {
        await WishService.PutBackAsync(wish.Id);
        await LoadAsync();
    }

    private async Task ShareAsync()
    {
        shareStatus = await Sharing.ShareTextAsync(ShareText) switch
        {
            "copied" => Strings.Shared.ShareCopied,
            "failed" => Strings.Shared.ShareFailed,
            _ => ""
        };
        if (shareStatus.Length == 0)
            return;

        StateHasChanged();
        await Task.Delay(3000);
        if (!disposed)
        {
            shareStatus = "";
            StateHasChanged();
        }
    }

    public void Dispose() => disposed = true;
}
