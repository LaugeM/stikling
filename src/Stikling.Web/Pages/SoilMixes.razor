@page "/soil-mixes"
@attribute [NeedsAccess(AccessLevel.Edit)]
@layout WideLayout
@inject ISoilMixRepository Repository
@inject SoilMixService MixService
@inject TimeProvider Time
@inject SoilBatchService BatchService
@inject ISupplyRepository SupplyRepository
@inject StockService StockService

<PageTitle>@Strings.Supplies.MixesPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<ShowFound ElementId="@(Show is { } shown ? $"item-{shown}" : null)" />

<a class="back-link" href="supplies">@Strings.Supplies.BackToSupplies</a>
<h1>@Strings.Supplies.MixesTitle</h1>

<p class="settings-hint">
    @Strings.Supplies.MixesIntro
</p>
<div class="mt-2"><GuideLink Guide="@GuideBook.Mixing" From="soil-mixes" /></div>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section supply-form">
        <h2>@(editing is null ? Strings.Supplies.MixesAdd : Strings.Supplies.MixesEdit)</h2>

        <div class="mb-3">
            <label class="form-label" for="mix-name">@Strings.Supplies.Name</label>
            <input id="mix-name" class="form-control" placeholder="@Strings.Supplies.MixesNamePlaceholder" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.MixesAmounts</div>
            <div class="chip-row" role="group" aria-label="@Strings.Supplies.MixesHowCounted">
                @foreach (var unit in Enum.GetValues<MixUnit>())
                {
                    <button type="button" class="chip @Picked(draft.Unit == unit)"
                            @onclick="() => draft.Unit = unit">@Labels.For(unit)</button>
                }
            </div>
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.WhatsInIt</div>

            @if (draft.Ingredients.Count > 0)
            {
                <ol class="mix-rows">
                    @for (var i = 0; i < draft.Ingredients.Count; i++)
                    {
                        var index = i;
                        var ingredient = draft.Ingredients[index];
                        <li class="mix-row">
                            <input class="form-control mix-name" placeholder="@Strings.Supplies.MixesIngredientPlaceholder" autocomplete="off"
                                   aria-label="@F(Strings.Supplies.MixesIngredientN, index + 1)" value="@ingredient.Name"
                                   @oninput="e => ingredient.Name = e.Value?.ToString() ?? string.Empty" />
                            @if (draft.Unit != MixUnit.None)
                            {
                                <input class="form-control mix-amount" type="number" inputmode="decimal"
                                       min="0" step="any" aria-label="@F(Strings.Supplies.MixesHowMuch, Some(ingredient))"
                                       @bind="ingredient.Amount" />
                            }
                            <div class="mix-tools">
                                <button type="button" class="mix-tool" disabled="@(index == 0)"
                                        aria-label="@F(Strings.Supplies.MixesMoveUp, Some(ingredient))" title="@F(Strings.Supplies.MixesMoveUp, Some(ingredient))"
                                        @onclick="() => draft.MoveUp(index)">▲</button>
                                <button type="button" class="mix-tool" disabled="@(index == draft.Ingredients.Count - 1)"
                                        aria-label="@F(Strings.Supplies.MixesMoveDown, Some(ingredient))" title="@F(Strings.Supplies.MixesMoveDown, Some(ingredient))"
                                        @onclick="() => draft.MoveDown(index)">▼</button>
                                <button type="button" class="mix-tool remove" aria-label="@F(Strings.Supplies.MixesRemove, Some(ingredient))" title="@F(Strings.Supplies.MixesRemove, Some(ingredient))"
                                        @onclick="() => draft.Ingredients.RemoveAt(index)"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true">@Icons.Close</svg></button>
                            </div>
                        </li>
                    }
                </ol>

                @if (draft.Unit == MixUnit.Percent && !draft.PercentAddsUp)
                {
                    <p class="form-text">@Labels.PercentTotal(draft.Total)</p>
                }
                else
                {
                    <div class="form-text">@Strings.Supplies.MixesFirstIsMost</div>
                }
            }

            <div class="chip-row mt-2" role="group" aria-label="@Strings.Supplies.MixesIngredientsToAdd">
                @foreach (var name in Suggestions)
                {
                    <button type="button" class="chip" @onclick="() => Add(name)">@name</button>
                }
                <button type="button" class="chip new" @onclick="() => Add(null)">@Strings.Supplies.MixesSomethingElse</button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="mix-notes">@Strings.Supplies.Notes</label>
            <textarea id="mix-notes" class="form-control" rows="2" @bind="draft.Notes"></textarea>
        </div>

        @if (editing is not null && InMix > 0)
        {
            <div class="confirm-card">
                <p>@EditWarning</p>
                <p class="settings-hint">@CopyHint</p>
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => SaveAsync(asCopy: false)">
                @(editing is null ? Strings.Supplies.MixesSubmitAdd : Strings.Supplies.SaveChanges)
            </button>
            @if (editing is not null && InMix > 0)
            {
                <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="() => SaveAsync(asCopy: true)">
                    @Strings.Supplies.MixesSaveAsNew
                </button>
            }
            <button type="button" class="btn btn-link" @onclick="Cancel">@Strings.Common.Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Supplies.MixesAddButton</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Supplies.MixesEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Supplies.MixesEmptyHint
        </p>
        <GuideLink Guide="@GuideBook.Mixing" From="soil-mixes" />
    </div>
}
else
{
    @foreach (var group in uses.GroupBy(use => use.Mix.IsRetired))
    {
        <section class="settings-section">
            <h2>@(group.Key ? Strings.Supplies.MixesNoLongerMixed : Strings.Supplies.MixesYour)</h2>

            <ul class="mix-list supply-grid">
                @foreach (var use in group)
                {
                    <li id="item-@use.Mix.Id">
                        @if (confirming == use.Mix.Id)
                        {
                            <div class="mix-confirm">
                                <p>@DeleteWarning(use)</p>
                                <div class="care-actions">
                                    <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                            @onclick="() => DeleteAsync(use.Mix)">@Strings.Common.Delete</button>
                                    <button type="button" class="btn btn-link btn-sm"
                                            @onclick="() => confirming = null">@Strings.Common.Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mix-head">
                                <span class="mix-title">@use.Mix.Name</span>
                                @if (use.Plants == 0)
                                {
                                    <span class="mix-count">@PlantCount(use)</span>
                                }
                                else
                                {
                                    <button type="button" class="mix-count mix-count-button" aria-expanded="@(showing == use.Mix.Id)"
                                            @onclick="() => TogglePlantsAsync(use)">@PlantCount(use)</button>
                                }
                            </div>
                            <div class="mix-recipe">@use.Mix.Recipe</div>
                            @if (showing == use.Mix.Id)
                            {
                                @if (showingPlants.Count == 0)
                                {
                                    <p class="mix-recipe">@Strings.Supplies.MixesNoneInCollection</p>
                                }
                                else
                                {
                                    <ul class="mix-plants">
                                        @foreach (var plant in showingPlants)
                                        {
                                            <li><a href="plants/@plant.Id">@plant.DisplayName</a></li>
                                        }
                                    </ul>
                                }
                            }
                            @if (measuring == use.Mix.Id && use.Mix.Batch(litres ?? 0) is var shares)
                            {
                                var id = $"mix-batch-{use.Mix.Id}";
                                <div class="mix-batch">
                                    <label for="@id">@Strings.Supplies.MixesBatch</label>
                                    <WaterInput Id="@id" Placeholder="@Strings.Supplies.MixesBatchPlaceholder" @bind-Litres="litres" />
                                </div>
                                @if (shares is not null)
                                {
                                    <ol class="mix-shares">
                                        @foreach (var share in shares)
                                        {
                                            <li>
                                                <span>@share.Name</span>
                                                <span class="mix-measure">@SoilMix.Volume(share.Litres)</span>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                            @if (linking == use.Mix.Id)
                            {
                                <div class="mix-link">
                                    <p class="settings-hint">@Strings.Supplies.LinkHint</p>
                                    @if (supplies.Count == 0)
                                    {
                                        <p class="mix-recipe">@Strings.Supplies.LinkNoSupplies</p>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < use.Mix.Ingredients.Count; i++)
                                        {
                                            var index = i;
                                            var ingredient = use.Mix.Ingredients[index];
                                            var linkId = $"mix-link-{use.Mix.Id}-{index}";
                                            <div class="mix-link-row">
                                                <label for="@linkId">@ingredient.Name</label>
                                                <select id="@linkId" class="form-select form-select-sm" value="@(linkDraft[index]?.ToString() ?? "")"
                                                        @onchange="e => linkDraft[index] = Guid.TryParse(e.Value?.ToString(), out var picked) ? picked : null">
                                                    <option value="">@Strings.Supplies.LinkNone</option>
                                                    @foreach (var supply in supplies)
                                                    {
                                                        <option value="@supply.Id">@supply.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        <div class="care-actions">
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@busy"
                                                    @onclick="() => SaveLinksAsync(use.Mix)">@Strings.Supplies.LinkSave</button>
                                            <button type="button" class="btn btn-link btn-sm" @onclick="() => linking = null">@Strings.Common.Cancel</button>
                                        </div>
                                    }
                                </div>
                            }
                            @if (batching == use.Mix.Id || toppingUp is { } topped && BatchesOf(use.Mix).Any(b => b.Id == topped))
                            {
                                var topUp = toppingUp is not null;
                                var id = $"mix-batch-volume-{use.Mix.Id}";
                                var dayId = $"mix-batch-day-{use.Mix.Id}";
                                <div class="mix-batch-form">
                                    <div class="mix-batch-field">
                                        <label for="@id">@Strings.Supplies.BatchVolume</label>
                                        <WaterInput Id="@id" Placeholder="@Strings.Supplies.MixesBatchPlaceholder" @bind-Litres="batchLitres" />
                                    </div>
                                    <div class="mix-batch-field">
                                        <label for="@dayId">@Strings.Supplies.BatchDay</label>
                                        <input id="@dayId" type="date" class="form-control form-control-sm" @bind="batchDay" max="@Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="care-actions">
                                        <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || batchLitres is not > 0 || batchDay > Today)"
                                                @onclick="() => SaveBatchAsync(use.Mix)">@(topUp ? Strings.Supplies.BatchTopUpSave : Strings.Supplies.BatchSave)</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="CloseBatchForm">@Strings.Common.Cancel</button>
                                    </div>
                                </div>
                            }
                            @if (BatchesOf(use.Mix) is { Count: > 0 } mixBatches)
                            {
                                <div class="mix-batches">
                                    <div class="mix-batches-title">@Strings.Supplies.BatchesHeading</div>
                                    <ul class="mix-batch-list">
                                        @foreach (var option in mixBatches)
                                        {
                                            <li class="mix-batch-item @(option.Batch.IsUsedUp ? "used" : null)">
                                                @if (confirmingBatch == option.Id)
                                                {
                                                    <p>@F(Strings.Supplies.BatchDeleteConfirm, Labels.Date(option.Batch.MixedOn))</p>
                                                    <div class="care-actions">
                                                        <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                                                @onclick="() => DeleteBatchAsync(option)">@Strings.Common.Delete</button>
                                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => confirmingBatch = null">@Strings.Common.Cancel</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mix-batch-head">
                                                        <button type="button" class="mix-count mix-count-button" aria-expanded="@(openBatch == option.Id)"
                                                                @onclick="() => ToggleBatchAsync(option)">@F(Strings.Supplies.BatchLine, Labels.Date(option.Batch.MixedOn), SoilMix.Volume(option.Litres))</button>
                                                        @if (option.Batch.IsUsedUp)
                                                        {
                                                            <span class="mix-count">@Strings.Supplies.BatchUsedUpTag</span>
                                                        }
                                                    </div>
                                                    @if (openBatch == option.Id)
                                                    {
                                                        <ul class="mix-plants">
                                                            @foreach (var mixing in openMixings)
                                                            {
                                                                <li>
                                                                    <span>@Labels.Date(mixing.MixedOn)</span>
                                                                    <span class="mix-measure">@SoilMix.Volume(mixing.Litres)</span>
                                                                    <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                                                            @onclick="() => RemoveMixingAsync(option, mixing)">@Strings.Supplies.BatchRemoveMixing</button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                    <div class="care-actions">
                                                        <button type="button" class="btn btn-link btn-sm link-action"
                                                                @onclick="() => StartTopUp(option)">@Strings.Supplies.BatchTopUp</button>
                                                        <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                                                @onclick="() => SetUsedUpAsync(option)">@(option.Batch.IsUsedUp ? Strings.Supplies.BatchUseAgain : Strings.Supplies.BatchMarkUsedUp)</button>
                                                        <button type="button" class="btn btn-link btn-sm link-action"
                                                                @onclick="() => confirmingBatch = option.Id">@Strings.Common.Delete</button>
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (use.Mix.RetiredOn is { } retired)
                            {
                                <div class="mix-recipe">@F(Strings.Supplies.MixesLastMixed, Labels.Date(retired))</div>
                            }
                            <div class="care-actions">
                                @if (use.Mix.CanMeasureOut)
                                {
                                    <button type="button" class="btn btn-link btn-sm link-action" aria-expanded="@(measuring == use.Mix.Id)"
                                            @onclick="() => ToggleMeasuring(use.Mix)">@Strings.Supplies.MixesMeasureOut</button>
                                }
                                <button type="button" class="btn btn-link btn-sm link-action" aria-expanded="@(batching == use.Mix.Id)"
                                        @onclick="() => StartBatch(use.Mix)">@Strings.Supplies.BatchMix</button>
                                <button type="button" class="btn btn-link btn-sm link-action" aria-expanded="@(linking == use.Mix.Id)"
                                        @onclick="() => StartLinking(use.Mix)">@Strings.Supplies.LinkAction</button>
                                <button type="button" class="btn btn-link btn-sm link-action"
                                        @onclick="() => StartEditAsync(use)">@Strings.Common.Edit</button>
                                <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                        @onclick="() => RetireAsync(use.Mix)">
                                    @(use.Mix.IsRetired ? Strings.Supplies.MixesMixingAgain : Strings.Supplies.MixesNoLongerMixing)
                                </button>
                                <button type="button" class="btn btn-link btn-sm link-action"
                                        @onclick="() => ConfirmAsync(use)">@Strings.Common.Delete</button>
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

<Sheet Title="@Strings.Stock.TakeoffTitle" Open="takeoffOpen" OpenChanged="open => { takeoffOpen = open; }">
    @if (takeoffFor is not null)
    {
        <TakeoffSheet Lines="takeoffLines" OnConfirm="ConfirmTakeoffAsync" OnSkip="SkipTakeoff" />
    }
</Sheet>

@code {
    /// <summary>An item to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public Guid? Show { get; set; }

    private IReadOnlyList<MixUse> uses = [];
    private IReadOnlyList<SoilMix> all = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private SoilMix? draft;
    private SoilMix? editing;
    private int plantsInMix;
    private int cuttingsInMix;
    private Guid? confirming;
    private int confirmingPlants;
    private int confirmingCuttings;

    // The mix whose plants are showing, and the one being measured out for a batch. The size is
    // kept between mixes, since it's usually the same tub or bag.
    private Guid? showing;
    private IReadOnlyList<Plant> showingPlants = [];
    private Guid? measuring;
    private decimal? litres;

    private DateOnly Today => Time.Today();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        uses = await MixService.GetAllAsync();
        batches = await BatchService.GetOptionsAsync();
        supplies = [.. (await SupplyRepository.GetAllAsync()).Where(s => !string.IsNullOrWhiteSpace(s.Name)).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)];
        loading = false;
    }

    private IReadOnlyList<string> Suggestions => SoilMixIngredients.Suggestions(all);

    private static string? Picked(bool picked) => picked ? "picked" : null;

    /// <summary>The ingredient's name for a screen reader, before one has been typed.</summary>
    private static string Some(MixIngredient ingredient) =>
        string.IsNullOrWhiteSpace(ingredient.Name) ? Strings.Supplies.MixesThisIngredient : ingredient.Name.Trim();

    private static string PlantCount(MixUse use) =>
        use.Plants == 0
            ? Strings.Supplies.MixesNoPlantsInIt
            : F(Strings.Supplies.PlantCountInUse, Labels.Plants(use.Plants));

    /// <summary>Plants and cuttings both point at the mix, so both are changed by editing it.</summary>
    private int InMix => plantsInMix + cuttingsInMix;

    /// <summary>What saving does to the plants and cuttings already in the mix, said before it happens.</summary>
    private string EditWarning => cuttingsInMix > 0
        ? F(Strings.Supplies.MixesEditWarningWithCuttings, InMix)
        : Plural.Of(plantsInMix, Strings.Supplies.MixesEditWarning_One, Strings.Supplies.MixesEditWarning_Other);

    private string CopyHint => cuttingsInMix > 0
        ? Strings.Supplies.MixesCopyHint_Other
        : Plural.Of(plantsInMix, Strings.Supplies.MixesCopyHint_One, Strings.Supplies.MixesCopyHint_Other);

    private string DeleteWarning(MixUse use) => confirmingPlants + confirmingCuttings == 0
        ? F(Strings.Supplies.MixesDeleteConfirm, use.Mix.Name)
        : confirmingCuttings > 0
            ? F(Strings.Supplies.MixesDeleteInUseWithCuttings, confirmingPlants + confirmingCuttings)
            : Plural.Of(confirmingPlants, Strings.Supplies.MixesDeleteInUse_One, Strings.Supplies.MixesDeleteInUse_Other);

    private async Task TogglePlantsAsync(MixUse use)
    {
        if (showing == use.Mix.Id)
        {
            showing = null;
            return;
        }

        showingPlants = await MixService.PlantsListAsync(use.Mix.Id);
        showing = use.Mix.Id;
    }

    private void ToggleMeasuring(SoilMix mix) => measuring = measuring == mix.Id ? null : mix.Id;

    private void Add(string? name)
    {
        draft!.Ingredients.Add(new MixIngredient { Name = name ?? "" });
    }

    private void StartNew()
    {
        editing = null;
        plantsInMix = 0;
        cuttingsInMix = 0;
        errors = [];
        confirming = null;
        draft = new SoilMix();
    }

    private async Task StartEditAsync(MixUse use)
    {
        editing = use.Mix;
        plantsInMix = await MixService.PlantsInAsync(use.Mix.Id);
        cuttingsInMix = await MixService.CuttingsInAsync(use.Mix.Id);
        errors = [];
        confirming = null;
        draft = use.Mix.Copy();
    }

    private void Cancel()
    {
        draft = null;
        editing = null;
        errors = [];
    }

    /// <summary>
    /// Saving as a copy is the escape for a mix that's already in use: the plants stay on the mix
    /// as it was, and the copy is what gets used from now on.
    /// </summary>
    private async Task SaveAsync(bool asCopy)
    {
        if (draft is null)
            return;

        var mix = asCopy ? draft.CopyAsNew(NextName(draft.Name)) : draft;
        mix.Tidy();

        errors = mix.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            await Repository.SaveAsync(mix);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>"Chunky soil (Sep 2026)", so a second version says when it started.</summary>
    private string NextName(string? name) =>
        $"{name?.Trim()} ({Today.ToString("MMM yyyy", TextCulture.ForDates)})";

    private async Task RetireAsync(SoilMix mix)
    {
        busy = true;
        try
        {
            var saved = mix.Copy();
            saved.RetiredOn = mix.IsRetired ? null : Today;
            await Repository.SaveAsync(saved);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmAsync(MixUse use)
    {
        confirmingPlants = await MixService.PlantsInAsync(use.Mix.Id);
        confirmingCuttings = await MixService.CuttingsInAsync(use.Mix.Id);
        confirming = use.Mix.Id;
    }

    private async Task DeleteAsync(SoilMix mix)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(mix.Id);
            confirming = null;
            if (editing?.Id == mix.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // Batches of soil. Each mixing and top-up is a record of its own, and the stock only changes when
    // the check sheet is confirmed.
    private IReadOnlyList<BatchOption> batches = [];
    private IReadOnlyList<Supply> supplies = [];
    private Guid? batching;
    private Guid? toppingUp;
    private decimal? batchLitres;
    private DateOnly batchDay;
    private Guid? openBatch;
    private IReadOnlyList<BatchMixing> openMixings = [];
    private Guid? confirmingBatch;

    // Which supply each ingredient of a mix comes out of
    private Guid? linking;
    private List<Guid?> linkDraft = [];

    private bool takeoffOpen;
    private BatchMixing? takeoffFor;
    private IReadOnlyList<TakeoffLine> takeoffLines = [];

    private IReadOnlyList<BatchOption> BatchesOf(SoilMix mix) => SoilBatches.Of(mix.Id, batches);

    private void StartBatch(SoilMix mix)
    {
        if (batching == mix.Id)
        {
            CloseBatchForm();
            return;
        }

        CloseBatchForm();
        linking = null;
        batching = mix.Id;
        batchDay = Today;
    }

    private void StartTopUp(BatchOption option)
    {
        CloseBatchForm();
        linking = null;
        toppingUp = option.Id;
        batchDay = Today;
    }

    private void CloseBatchForm()
    {
        batchLitres = null;
        batching = null;
        toppingUp = null;
    }

    private async Task SaveBatchAsync(SoilMix mix)
    {
        if (batchLitres is not > 0)
            return;

        busy = true;
        try
        {
            var litres = batchLitres.Value;
            var mixing = toppingUp is { } batchId
                ? await BatchService.TopUpAsync(batchId, litres, batchDay)
                : await BatchService.MixAsync(mix, litres, batchDay);
            CloseBatchForm();
            await LoadAsync();

            takeoffLines = await BatchService.TakeoffAsync(mix, litres);
            if (takeoffLines.Count > 0)
            {
                takeoffFor = mixing;
                takeoffOpen = true;
            }
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmTakeoffAsync(IReadOnlyList<TakeoffLine> lines)
    {
        if (takeoffFor is { } mixing)
            await StockService.TakeOffAsync(mixing.Id, lines);
        SkipTakeoff();
    }

    private void SkipTakeoff()
    {
        takeoffOpen = false;
        takeoffFor = null;
    }

    private async Task ToggleBatchAsync(BatchOption option)
    {
        if (openBatch == option.Id)
        {
            openBatch = null;
            return;
        }

        openMixings = await BatchService.GetMixingsAsync(option.Id);
        openBatch = option.Id;
    }

    private async Task RemoveMixingAsync(BatchOption option, BatchMixing mixing)
    {
        busy = true;
        try
        {
            await BatchService.DeleteMixingAsync(mixing.Id);
            openMixings = await BatchService.GetMixingsAsync(option.Id);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetUsedUpAsync(BatchOption option)
    {
        busy = true;
        try
        {
            await BatchService.SetUsedUpAsync(option.Batch, !option.Batch.IsUsedUp);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteBatchAsync(BatchOption option)
    {
        busy = true;
        try
        {
            await BatchService.DeleteBatchAsync(option.Id);
            confirmingBatch = null;
            if (openBatch == option.Id)
                openBatch = null;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Opens the links of a mix. An ingredient that isn't linked yet starts on the supply with the same name,
    /// if there is one. That is only a suggestion until the links are saved.
    /// </summary>
    private void StartLinking(SoilMix mix)
    {
        if (linking == mix.Id)
        {
            linking = null;
            return;
        }

        CloseBatchForm();
        linkDraft =
        [
            .. mix.Ingredients.Select(i =>
                i.SupplyId is { } id && supplies.Any(s => s.Id == id) ? id : Takeoff.Suggest(i.Name, supplies)?.Id)
        ];
        linking = mix.Id;
    }

    /// <summary>Linking a supply doesn't change the recipe, so it never asks about the plants in the mix.</summary>
    private async Task SaveLinksAsync(SoilMix mix)
    {
        busy = true;
        try
        {
            await BatchService.LinkSuppliesAsync(mix, linkDraft);
            linking = null;
            await LoadAsync();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }
}
