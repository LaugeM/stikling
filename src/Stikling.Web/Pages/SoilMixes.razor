@page "/soil-mixes"
@layout WideLayout
@inject ISoilMixRepository Repository
@inject SoilMixService MixService
@inject TimeProvider Time

<PageTitle>@Strings.Supplies.MixesPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<ShowFound ElementId="@(Show is { } shown ? $"item-{shown}" : null)" />

<a class="back-link" href="supplies">@Strings.Supplies.BackToSupplies</a>
<h1>@Strings.Supplies.MixesTitle</h1>

<p class="settings-hint">
    @Strings.Supplies.MixesIntro
</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section supply-form">
        <h2>@(editing is null ? Strings.Supplies.MixesAdd : Strings.Supplies.MixesEdit)</h2>

        <div class="mb-3">
            <label class="form-label" for="mix-name">@Strings.Supplies.Name</label>
            <input id="mix-name" class="form-control" placeholder="@Strings.Supplies.MixesNamePlaceholder" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.MixesAmounts</div>
            <div class="chip-row" role="group" aria-label="@Strings.Supplies.MixesHowCounted">
                @foreach (var unit in Enum.GetValues<MixUnit>())
                {
                    <button type="button" class="chip @Picked(draft.Unit == unit)"
                            @onclick="() => draft.Unit = unit">@Labels.For(unit)</button>
                }
            </div>
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.WhatsInIt</div>

            @if (draft.Ingredients.Count > 0)
            {
                <ol class="mix-rows">
                    @for (var i = 0; i < draft.Ingredients.Count; i++)
                    {
                        var index = i;
                        var ingredient = draft.Ingredients[index];
                        <li class="mix-row">
                            <input class="form-control mix-name" placeholder="@Strings.Supplies.MixesIngredientPlaceholder" autocomplete="off"
                                   aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesIngredientN, index + 1)" value="@ingredient.Name"
                                   @oninput="e => ingredient.Name = e.Value?.ToString() ?? string.Empty" />
                            @if (draft.Unit != MixUnit.None)
                            {
                                <input class="form-control mix-amount" type="number" inputmode="decimal"
                                       min="0" step="any" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesHowMuch, Some(ingredient))"
                                       @bind="ingredient.Amount" />
                            }
                            <div class="mix-tools">
                                <button type="button" class="mix-tool" disabled="@(index == 0)"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesMoveUp, Some(ingredient))"
                                        @onclick="() => draft.MoveUp(index)">▲</button>
                                <button type="button" class="mix-tool" disabled="@(index == draft.Ingredients.Count - 1)"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesMoveDown, Some(ingredient))"
                                        @onclick="() => draft.MoveDown(index)">▼</button>
                                <button type="button" class="mix-tool remove" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesRemove, Some(ingredient))"
                                        @onclick="() => draft.Ingredients.RemoveAt(index)"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                            </div>
                        </li>
                    }
                </ol>

                @if (draft.Unit == MixUnit.Percent && !draft.PercentAddsUp)
                {
                    <p class="form-text">@Labels.PercentTotal(draft.Total)</p>
                }
                else
                {
                    <div class="form-text">@Strings.Supplies.MixesFirstIsMost</div>
                }
            }

            <div class="chip-row mt-2" role="group" aria-label="@Strings.Supplies.MixesIngredientsToAdd">
                @foreach (var name in Suggestions)
                {
                    <button type="button" class="chip" @onclick="() => Add(name)">@name</button>
                }
                <button type="button" class="chip new" @onclick="() => Add(null)">@Strings.Supplies.MixesSomethingElse</button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="mix-notes">@Strings.Supplies.Notes</label>
            <textarea id="mix-notes" class="form-control" rows="2" @bind="draft.Notes"></textarea>
        </div>

        @if (editing is not null && plantsInMix > 0)
        {
            <div class="confirm-card">
                <p>@EditWarning</p>
                <p class="settings-hint">@CopyHint</p>
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => SaveAsync(asCopy: false)">
                @(editing is null ? Strings.Supplies.MixesSubmitAdd : Strings.Supplies.SaveChanges)
            </button>
            @if (editing is not null && plantsInMix > 0)
            {
                <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="() => SaveAsync(asCopy: true)">
                    @Strings.Supplies.MixesSaveAsNew
                </button>
            }
            <button type="button" class="btn btn-link" @onclick="Cancel">@Strings.Common.Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Supplies.MixesAddButton</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Supplies.MixesEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Supplies.MixesEmptyHint
        </p>
    </div>
}
else
{
    @foreach (var group in uses.GroupBy(use => use.Mix.IsRetired))
    {
        <section class="settings-section">
            <h2>@(group.Key ? Strings.Supplies.MixesNoLongerMixed : Strings.Supplies.MixesYour)</h2>

            <ul class="mix-list supply-grid">
                @foreach (var use in group)
                {
                    <li id="item-@use.Mix.Id">
                        @if (confirming == use.Mix.Id)
                        {
                            <div class="mix-confirm">
                                <p>@DeleteWarning(use)</p>
                                <div class="care-actions">
                                    <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                            @onclick="() => DeleteAsync(use.Mix)">@Strings.Common.Delete</button>
                                    <button type="button" class="btn btn-link btn-sm"
                                            @onclick="() => confirming = null">@Strings.Common.Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mix-head">
                                <span class="mix-title">@use.Mix.Name</span>
                                @if (use.Plants == 0)
                                {
                                    <span class="mix-count">@PlantCount(use)</span>
                                }
                                else
                                {
                                    <button type="button" class="mix-count mix-count-button" aria-expanded="@(showing == use.Mix.Id)"
                                            @onclick="() => TogglePlantsAsync(use)">@PlantCount(use)</button>
                                }
                            </div>
                            <div class="mix-recipe">@use.Mix.Recipe</div>
                            @if (showing == use.Mix.Id)
                            {
                                @if (showingPlants.Count == 0)
                                {
                                    <p class="mix-recipe">@Strings.Supplies.MixesNoneInCollection</p>
                                }
                                else
                                {
                                    <ul class="mix-plants">
                                        @foreach (var plant in showingPlants)
                                        {
                                            <li><a href="plants/@plant.Id">@plant.DisplayName</a></li>
                                        }
                                    </ul>
                                }
                            }
                            @if (measuring == use.Mix.Id && use.Mix.Batch(litres ?? 0) is var shares)
                            {
                                var id = $"mix-batch-{use.Mix.Id}";
                                <div class="mix-batch">
                                    <label for="@id">@Strings.Supplies.MixesBatch</label>
                                    <WaterInput Id="@id" Placeholder="@Strings.Supplies.MixesBatchPlaceholder" @bind-Litres="litres" />
                                </div>
                                @if (shares is not null)
                                {
                                    <ol class="mix-shares">
                                        @foreach (var share in shares)
                                        {
                                            <li>
                                                <span>@share.Name</span>
                                                <span class="mix-measure">@SoilMix.Volume(share.Litres)</span>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                            @if (use.Mix.RetiredOn is { } retired)
                            {
                                <div class="mix-recipe">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesLastMixed, Labels.Date(retired))</div>
                            }
                            <div class="care-actions">
                                @if (use.Mix.CanMeasureOut)
                                {
                                    <button type="button" class="btn btn-link btn-sm link-action" aria-expanded="@(measuring == use.Mix.Id)"
                                            @onclick="() => ToggleMeasuring(use.Mix)">@Strings.Supplies.MixesMeasureOut</button>
                                }
                                <button type="button" class="btn btn-link btn-sm link-action"
                                        @onclick="() => StartEditAsync(use)">@Strings.Common.Edit</button>
                                <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy"
                                        @onclick="() => RetireAsync(use.Mix)">
                                    @(use.Mix.IsRetired ? Strings.Supplies.MixesMixingAgain : Strings.Supplies.MixesNoLongerMixing)
                                </button>
                                <button type="button" class="btn btn-link btn-sm link-action"
                                        @onclick="() => ConfirmAsync(use)">@Strings.Common.Delete</button>
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    /// <summary>An item to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public Guid? Show { get; set; }

    private IReadOnlyList<MixUse> uses = [];
    private IReadOnlyList<SoilMix> all = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private SoilMix? draft;
    private SoilMix? editing;
    private int plantsInMix;
    private Guid? confirming;
    private int confirmingPlants;

    // The mix whose plants are showing, and the one being measured out for a batch. The size is
    // kept between mixes, since it's usually the same tub or bag.
    private Guid? showing;
    private IReadOnlyList<Plant> showingPlants = [];
    private Guid? measuring;
    private decimal? litres;

    private DateOnly Today => Time.Today();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        uses = await MixService.GetAllAsync();
        loading = false;
    }

    private IReadOnlyList<string> Suggestions => SoilMixIngredients.Suggestions(all);

    private static string? Picked(bool picked) => picked ? "picked" : null;

    /// <summary>The ingredient's name for a screen reader, before one has been typed.</summary>
    private static string Some(MixIngredient ingredient) =>
        string.IsNullOrWhiteSpace(ingredient.Name) ? Strings.Supplies.MixesThisIngredient : ingredient.Name.Trim();

    private static string PlantCount(MixUse use) =>
        use.Plants == 0
            ? Strings.Supplies.MixesNoPlantsInIt
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.PlantCountInUse, Labels.Plants(use.Plants));

    /// <summary>What saving does to the plants already in the mix, said before it happens.</summary>
    private string EditWarning => Plural.Of(plantsInMix, Strings.Supplies.MixesEditWarning_One, Strings.Supplies.MixesEditWarning_Other);

    private string CopyHint => Plural.Of(plantsInMix, Strings.Supplies.MixesCopyHint_One, Strings.Supplies.MixesCopyHint_Other);

    private string DeleteWarning(MixUse use) => confirmingPlants == 0
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.MixesDeleteConfirm, use.Mix.Name)
        : Plural.Of(confirmingPlants, Strings.Supplies.MixesDeleteInUse_One, Strings.Supplies.MixesDeleteInUse_Other);

    private async Task TogglePlantsAsync(MixUse use)
    {
        if (showing == use.Mix.Id)
        {
            showing = null;
            return;
        }

        showingPlants = await MixService.PlantsListAsync(use.Mix.Id);
        showing = use.Mix.Id;
    }

    private void ToggleMeasuring(SoilMix mix) => measuring = measuring == mix.Id ? null : mix.Id;

    private void Add(string? name)
    {
        draft!.Ingredients.Add(new MixIngredient { Name = name ?? "" });
    }

    private void StartNew()
    {
        editing = null;
        plantsInMix = 0;
        errors = [];
        confirming = null;
        draft = new SoilMix();
    }

    private async Task StartEditAsync(MixUse use)
    {
        editing = use.Mix;
        plantsInMix = await MixService.PlantsInAsync(use.Mix.Id);
        errors = [];
        confirming = null;
        draft = use.Mix.Copy();
    }

    private void Cancel()
    {
        draft = null;
        editing = null;
        errors = [];
    }

    /// <summary>
    /// Saving as a copy is the escape for a mix that's already in use: the plants stay on the mix
    /// as it was, and the copy is what gets used from now on.
    /// </summary>
    private async Task SaveAsync(bool asCopy)
    {
        if (draft is null)
            return;

        var mix = asCopy ? draft.CopyAsNew(NextName(draft.Name)) : draft;
        mix.Tidy();

        errors = mix.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            await Repository.SaveAsync(mix);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>"Chunky soil (Sep 2026)", so a second version says when it started.</summary>
    private string NextName(string? name) =>
        $"{name?.Trim()} ({Today.ToString("MMM yyyy", TextCulture.ForDates)})";

    private async Task RetireAsync(SoilMix mix)
    {
        busy = true;
        try
        {
            var saved = mix.Copy();
            saved.RetiredOn = mix.IsRetired ? null : Today;
            await Repository.SaveAsync(saved);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmAsync(MixUse use)
    {
        confirmingPlants = await MixService.PlantsInAsync(use.Mix.Id);
        confirming = use.Mix.Id;
    }

    private async Task DeleteAsync(SoilMix mix)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(mix.Id);
            confirming = null;
            if (editing?.Id == mix.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
