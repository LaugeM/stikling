        if (pottingInto is not { } id || await Repository.GetAsync(id) is not { } into)
            throw new InvalidOperationException(Strings.PlantDetail.PlantGone);
        await PlantService.PotTogetherAsync(plant!, into, since, Labels.For,
            potId => pots.FirstOrDefault(p => p.Id == potId)?.DisplayName,
            mixId => mixes.FirstOrDefault(m => m.Id == mixId)?.Name,
