    private static MarkupString Html(string format, params string[] encoded) => (MarkupString)F(format, encoded);

    private RenderFragment StandingIn(string outer)
    {
        RenderFragment inner = @<text>@PotPhotoFor(plant!.OuterPotId)@outer</text>;
        return Around(plant!.WaterInOuterPot ? Strings.PlantDetail.StandingInWithWater : Strings.PlantDetail.StandingIn, inner);
    }

    // A sentence with an element inside it: the element goes where {0} is
    private static RenderFragment Around(string format, RenderFragment inner) => builder =>
    {
        var at = format.IndexOf("{0}", StringComparison.Ordinal);
        builder.AddContent(0, format[..at]);
        builder.AddContent(1, inner);
        builder.AddContent(2, format[(at + 3)..]);
    };

