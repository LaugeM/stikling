    // These change other plants too, so the page is read again after
    private async Task SaveChangeAsync(Func<Task> change)
    {
        await ChangeAsync(async () =>
        {
            try
            {
                await change();
            }
            catch (InvalidOperationException ex)
            {
                actionNote = $"Couldn't save: {ex.Message}";
                return;
            }
            actionNote = null;
        });
        await LoadAsync();
    }

    private Task PotTogetherAsync() => SaveChangeAsync(async () =>
    {
        // Read again, so a change that arrived since the page loaded isn't saved over
        if (pottingInto is not { } id || await Repository.GetAsync(id) is not { } into)
            throw new InvalidOperationException("That plant doesn't exist any more.");
        await PlantService.PotTogetherAsync(plant!, into, since, Labels.For,
            potId => pots.FirstOrDefault(p => p.Id == potId)?.DisplayName,
            mixId => mixes.FirstOrDefault(m => m.Id == mixId)?.Name,
            placeId => places.NameOf(placeId));
    });

    private Task TakeOutAsync() => SaveChangeAsync(() =>
        PlantService.TakeOutAsync(plant!, since, takeOutPot, Labels.For, potId => pots.FirstOrDefault(p => p.Id == potId)?.DisplayName));

    private async Task SaveSomeAsync()
    {
        IReadOnlyList<Plant> made = [];
        await SaveChangeAsync(async () =>
        {
            switch (someKind)
            {
                case SomeKind.Died:
                    await PlantService.SomeDiedAsync(plant!, someCount, since);
                    break;
                case SomeKind.GaveAway:
                    await PlantService.GaveSomeAwayAsync(plant!, someCount, someWho, since);
                    break;
                default:
                    made = await PlantService.SplitOffAsync(plant!, someCount, someNickname, since);
                    break;
            }
        });
        if (made.Count == 1)
            Navigation.NavigateTo($"plants/{made[0].Id}");
    }

