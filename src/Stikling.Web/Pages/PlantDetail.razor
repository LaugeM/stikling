        await SaveChangeAsync(async () =>
        {
            switch (someKind)
            {
                case SomeKind.Died:
                    await PlantService.SomeDiedAsync(plant!, someCount, since);
                    break;
                case SomeKind.GaveAway:
                    await PlantService.GaveSomeAwayAsync(plant!, someCount, someWho, since);
