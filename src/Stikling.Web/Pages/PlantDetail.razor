    private async Task SavePestCheckAsync()
    {
        var entry = PestService.StartPlantCheck(plant!, since);
        entry.Notes = string.IsNullOrWhiteSpace(checkNotes) ? null : checkNotes.Trim();
        if (entry.Validate(Today).Count > 0)
            return;

        busy = true;
        try
        {
            await PestTreatmentRepository.SaveAsync(entry);
            more = More.None;
            actionNote = Strings.PlantDetail.CheckedNoSigns;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenStatus(PlantStatus to)
    {
        status = to;
        causeOfDeath = plant!.CauseOfDeath;
        leftTo = plant.LeftTo;
        leftFor = plant.LeftFor;
        potsTaken = plant.PotsTaken;
        more = More.Status;
    }

    private async Task SetCoverAsync(Guid? photoId)
    {
        if (plant is null || plant.CoverPhotoId == photoId)
            return;
        plant.CoverPhotoId = photoId;
        await Repository.SaveAsync(plant);
    }

    private static readonly (SpareMark? Value, string Label)[] SwapChoices =
    [
        (null, Strings.PlantDetail.SwapNotOffered),
        (SpareMark.CuttingsToSpare, Strings.PlantDetail.SwapCuttings),
        (SpareMark.UpForSwap, Strings.PlantDetail.SwapThePlant)
    ];

    private async Task SetSpareAsync(SpareMark? mark)
    {
        if (plant is null)
            return;
        busy = true;
        try
        {
            await PlantService.SetSpareAsync([plant], mark);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleFavouriteAsync()
    {
        if (plant is null)
            return;
        await PlantService.SetFavouriteAsync(plant, !plant.Favourite);
    }

    private string TagLink(string tag) => $"plants?tag={Uri.EscapeDataString(tag)}";

    private DateOnly? nextRoundDay;

    private async Task SetAttentionAsync((string? Reason, LooseDate? From) change)
    {
        if (plant is null)
            return;
        await PlantService.SetAttentionAsync(plant, change.Reason, change.From);
    }

    // Each change goes on the history, like it does from the edit form
    private async Task ChangeAsync(Func<Task> change)
    {
        busy = true;
        try
        {
            await change();
            more = More.None;
            historyVersion++;
        }
        finally
        {
            busy = false;
        }
    }

    private Task EndQuarantineAsync() =>
        ChangeAsync(() => PlantService.SetQuarantineAsync(plant!, null, Labels.For));

    private Task EndDormancyAsync() =>
        ChangeAsync(() => PlantService.SetDormantAsync(plant!, null, Labels.For));

    private Task SetDormantAsync() =>
        ChangeAsync(() => PlantService.SetDormantAsync(plant!, since, Labels.For));

    private Task StartTransitionAsync() =>
        ChangeAsync(() => PlantService.StartTransitionAsync(plant!, since, transitionTo, transitionWeeks, Labels.For));

    // An unticked step is ticked for today; a ticked one opens the sheet to change its day or untick it
    private Task TapTransitionStepAsync(TransitionStep step, string name, DateOnly? doneOn)
    {
        if (doneOn is { } day)
        {
            OpenTransitionStep(step, name, day);
            return Task.CompletedTask;
        }
        return ChangeAsync(() => PlantService.SetTransitionStepAsync(plant!, step, Today, Labels.For));
    }

    private void OpenTransitionStep(TransitionStep step, string name, DateOnly day)
    {
        editingStep = step;
        stepName = name;
        stepDay = day;
        stepErrors = [];
        more = More.TransitionStep;
    }

    private async Task SaveTransitionStepAsync()
    {
        var test = plant!.Copy();
        SetStepDay(test, stepDay);
        stepErrors = [.. test.Validate(Today).Where(Plant.IsStepError)];
        if (stepErrors.Count > 0)
            return;
        await ChangeAsync(() => PlantService.SetTransitionStepAsync(plant!, editingStep, stepDay, Labels.For));
    }

    private Task UntickTransitionStepAsync() =>
        ChangeAsync(() => PlantService.SetTransitionStepAsync(plant!, editingStep, null, Labels.For));

    private void SetStepDay(Plant target, DateOnly day)
    {
        switch (editingStep)
        {
            case TransitionStep.RootsWashed: target.RootsWashedOn = day; break;
            case TransitionStep.FirstWaterRoot: target.FirstWaterRootOn = day; break;
            case TransitionStep.FirstNewLeaf: target.FirstNewLeafOn = day; break;
        }
    }

    private async Task StopTransitionAsync()
    {
        confirmStopTransition = false;
        await ChangeAsync(() => PlantService.StopTransitionAsync(plant!, Labels.For));
    }

    private static IEnumerable<(TransitionStep Step, string Name, DateOnly? Done)> TransitionSteps(Plant plant) =>
    [
        (TransitionStep.RootsWashed, Strings.PlantDetail.StepRootsWashed, plant.RootsWashedOn),
        (TransitionStep.FirstWaterRoot, Strings.PlantDetail.StepFirstWaterRoot, plant.FirstWaterRootOn),
        (TransitionStep.FirstNewLeaf, Strings.PlantDetail.StepFirstNewLeaf, plant.FirstNewLeafOn)
    ];

    private Task SetQuarantineAsync() => ChangeAsync(async () =>
    {
        plant!.QuarantineDays = quarantineDays;
        await PlantService.SetQuarantineAsync(plant, since, Labels.For);
    });

    private void OpenShare()
    {
        shareOnLink = false;
        shareOpen = true;
    }

    // From the offer to send its history: the Share sheet opens on the link, to change what the page shows
    private void ChangePassOnPage()
    {
        more = More.None;
        shareOnLink = true;
        shareOpen = true;
    }

    // Giving it away or selling it offers to send its history right away, where links are available
    private async Task SaveStatusAsync()
    {
        await SaveStatusChangesAsync();
        if (plant is { HasLeft: true } && Account.IsAvailable)
            more = More.PassOn;
    }

    private Task SaveStatusChangesAsync() => ChangeAsync(async () =>
    {
        var before = plant!.Copy();
        plant.Status = status;
        plant.CauseOfDeath = causeOfDeath;
        plant.LeftTo = leftTo;
        plant.LeftFor = leftFor;
        plant.PotsTaken = potsTaken;
        await PlantService.UpdateAsync(before, plant, Labels.For);
        await PlantService.CarryStatusToPottedWithAsync(plant, before.Status, Labels.For);
    });

    private Task BackInCollectionAsync() => ChangeAsync(async () =>
    {
        var before = plant!.Copy();
        plant.Status = PlantStatus.Active;
        await PlantService.UpdateAsync(before, plant, Labels.For);
        await PlantService.CarryStatusToPottedWithAsync(plant, before.Status, Labels.For);
    });

    private async Task DeleteAsync()
    {
        await PlantService.DeleteAsync(plant!, Labels.For);
        Navigation.NavigateTo("plants", replace: true);
    }
}
