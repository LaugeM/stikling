@page "/plants/{Id:guid}"
@layout WideLayout
@using Stikling.Core.Settings
@inject IPlantRepository Repository
@inject CoverPhotos Covers
@inject IPropagationRepository PropagationRepository
@inject ICareLogRepository CareLogRepository
@inject IOwnCareKindRepository OwnKindRepository
@inject ICareIntervalRepository CareIntervalRepository
@inject IPestCaseRepository PestCaseRepository
@inject IPestTreatmentRepository PestTreatmentRepository
@inject FloweringService FloweringService
@inject ProblemService ProblemService
@inject IPotRepository PotRepository
@inject PotService PotService
@inject ISoilMixRepository MixRepository
@inject IFeedRepository FeedRepository
@inject PlantService PlantService
@inject RoomService RoomService
@inject SellerService SellerService
@inject OwnFieldService OwnFieldBook
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@inject PlantNameService Names
@inject PlantCareService CommonCare
@inject ITimelineRepository TimelineRepository
@inject GrowLightService LightService
@inject AwayService AwayService
@inject SettingsService SettingsService
@inject GooglePhotosService Google
@inject AccountService Account

<PageTitle>@F(Strings.PlantDetail.PageTitle, plant?.DisplayName ?? Strings.PlantDetail.PlantFallback)</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="plants">@Strings.Plants.ListTitle</a>

@if (plant is null)
{
    <p class="text-body-secondary">@(loaded ? Strings.PlantDetail.NotFound : Strings.Plants.Loading)</p>
}
else
{
    @* On a wide screen these are two columns: who it is on the left, its history on the right *@
    <div class="profile-layout">
        <div class="profile-side">
            @if (ShownCover is { } coverId)
            {
                <div class="detail-hero">
                    <button type="button" class="detail-hero-open" aria-label="@Strings.PlantDetail.OpenCover" @onclick="() => timeline?.OpenPhoto(coverId)">
                        <PhotoImage PhotoId="coverId" Thumbnail="false" Alt="@F(Strings.PlantDetail.PhotoOf, plant.DisplayName)" />
                    </button>
                </div>
            }

            <header class="detail-header">
                @if (ShownCover is null)
                {
                    <div class="detail-icon potted" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
                    </div>
                }
                <div class="min-w-0">
                    @if (CollectionNumbers.Normalize(plant.CollectionNumber) is { } number)
                    {
                        <div class="detail-number">#@number</div>
                    }
                    <div class="title-row">
                        <h1>
                            @if (string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
                            {
                                <BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" Qualifier="@plant.NameQualifier" Note="@plant.NameNote" />
                            }
                            else
                            {
                                @plant.DisplayName
                            }
                        </h1>
                        <button type="button" class="favourite-toggle @(plant.Favourite ? "on" : null)" aria-pressed="@(plant.Favourite ? "true" : "false")"
                                aria-label="@Strings.PlantDetail.Favourite" @onclick="ToggleFavouriteAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8Z" /></svg>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
                    {
                        <p class="detail-sub"><BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" Qualifier="@plant.NameQualifier" Note="@plant.NameNote" /></p>
                    }
                    else if (everyday?.For(plant.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(plant.Species, plant.NameQualifier), plant.Cultivar) is { } called)
                    {
                        <p class="detail-sub everyday-name">@called</p>
                    }
                    @if (plant.LivesElsewhere)
                    {
                        <p class="detail-sub">@(plant.LivesWithName is { } owner ? F(Strings.PlantDetail.LivesWithNotMine, owner) : Strings.PlantDetail.NotInCollection)</p>
                    }
                    <NumberClashNote Code="@plant.CollectionNumber" Clashes="numberClashes" />
                    <div class="profile-badges">
                        @if (!plant.InCollection && !plant.LivesElsewhere)
                        {
                            <span class="badge text-bg-secondary">@Labels.StatusOf(plant, pottedWithPlant?.DisplayName)</span>
                        }
                        @if (plant.InQuarantine)
                        {
                            <span class="badge quarantine-badge">@Strings.Plants.ListQuarantine</span>
                        }
                        @if (plant.IsDormant)
                        {
                            <span class="badge dormant-badge">@Strings.Plants.ListDormant</span>
                        }
                        @if (floweringNow is { Stale: false } && plant.InCollection)
                        {
                            <span class="badge flowering-badge">@FloweringText.Badge(floweringNow.Stage)</span>
                        }
                        @if (plant.IsOffered && plant.Spare is { } spare)
                        {
                            <a class="badge swap-badge" href="swap">@SwapLists.MarkText(spare)</a>
                        }
                        @foreach (var item in pests)
                        {
                            <a class="badge pest-badge" href="pests/@item.Id">@Labels.For(item.Pest)</a>
                        }
                        @if (openProblems.Count > 0)
                        {
                            <a class="badge problem-badge" href="problems/@openProblems[0].Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true">@ProblemIcons.WiltingLeaf</svg>
                                @Strings.Plants.ListProblem
                            </a>
                        }
                    </div>
                    @if (plant.HowMany > 1)
                    {
                        <p class="profile-facts">@F(Strings.PlantDetail.HowManyInPot, plant.HowMany)</p>
                    }
                    @if (pottedInHere.Count > 0)
                    {
                        <p class="profile-facts">
                            @Strings.PlantDetail.AlsoInPot
                            @for (var i = 0; i < pottedInHere.Count; i++)
                            {
                                var other = pottedInHere[i];
                                <a href="plants/@other.Id">@other.DisplayName</a>@(i < pottedInHere.Count - 1 ? ", " : null)
                            }
                        </p>
                    }
                    @if (actionNote is not null)
                    {
                        <p class="profile-facts" role="status">@actionNote</p>
                    }
                    @if (recentChanges.Count > 0)
                    {
                        <p class="profile-facts">@RecentChangesText</p>
                    }
                </div>
            </header>

                @if (floweringNow is { Stale: true } stale && plant.InCollection)
                {
                    <div class="still-card">
                        <p>@F(stale.Stage == FloweringStage.Buds ? Strings.PlantDetail.StillInBud : Strings.PlantDetail.StillInFlower, Labels.Date(stale.Period.LastMarked))</p>
                        <div class="still-actions">
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="StillFloweringAsync">@Strings.Common.Yes</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="OpenFlowering">@Strings.Common.Done</button>
                        </div>
                    </div>
                }

            @foreach (var problem in openProblems)
            {
                var own = UpdatesOf(problem);
                var again = ProblemService.LookAgainOn(problem, own);
                <section class="problem-card" aria-label="@ProblemText.Signs(problem.KnownSigns)">
                    <p class="problem-card-name">@ProblemText.Signs(problem.KnownSigns)</p>
                    <p class="problem-card-meta">
                        @F(Strings.PlantDetail.ProblemSince, ProblemText.ShortDay(problem.StartedOn)) · @ProblemText.Duration(ProblemText.DaysLasted(problem, Today))
                        @if (ProblemService.LatestTrend(own) is { } latest)
                        {
                            <text> · </text><TrendMark Trend="latest" Word="true" />
                        }
                        @if (again is { } lookAgain)
                        {
                            <text> · </text>
                            @if (lookAgain <= Today)
                            {
                                <span class="look-due">@Strings.PlantDetail.LookAgainToday</span>
                            }
                            else
                            {
                                <text>@F(Strings.PlantDetail.LookAgainOn, ProblemText.ShortDay(lookAgain))</text>
                            }
                        }
                    </p>
                    <div class="problem-card-actions">
                        @if (plant.InCollection)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="() => OpenProblemUpdate(problem)">@Strings.PlantDetail.HowDoesItLook</button>
                        }
                        <a class="btn btn-link link-action" href="problems/@problem.Id">@Strings.PlantDetail.Open</a>
                    </div>
                </section>
            }

            @if (plant.ShowsTransitionCard(Today) && plant.TransitionSince is { } movingSince)
            {
                var movingTo = plant.TransitionTo is { } to ? Labels.For(to) : Strings.PlantDetail.SemiHydro;
                var settled = plant.TransitionSettledOn is not null;
                var title = F(settled ? Strings.PlantDetail.TransitionSettledTitle : Strings.PlantDetail.TransitionMovingTitle, movingTo);
                <section class="transition-card" aria-label="@title">
                    <p class="transition-card-name">@title</p>
                    @if (plant.TransitionSettledOn is { } settledDay)
                    {
                        <p class="transition-card-meta">@Plural.Of(Math.Max(1, (settledDay.DayNumber - movingSince.DayNumber) / 7), Strings.PlantDetail.TransitionAfter_One, Strings.PlantDetail.TransitionAfter_Other) · @Labels.Date(settledDay)</p>
                    }
                    else
                    {
                        <p class="transition-card-meta">@F(Strings.PlantDetail.TransitionSinceWeek, ProblemText.ShortDay(movingSince), Math.Max(0, Today.DayNumber - movingSince.DayNumber) / 7 + 1)</p>
                    }
                    <ul class="transition-steps">
                        @foreach (var (step, name, done) in TransitionSteps(plant))
                        {
                            <li class="transition-row">
                                <button type="button" class="transition-step @(done is null ? null : "is-done")" aria-pressed="@(done is not null ? "true" : "false")"
                                        disabled="@busy" @onclick="() => TapTransitionStepAsync(step, name, done)">
                                    <span class="transition-box" aria-hidden="true">
                                        @if (done is not null)
                                        {
                                            <svg viewBox="0 0 24 24"><path d="m5 12.500 4.500 4.500L19 7.500" /></svg>
                                        }
                                    </span>
                                    <span class="transition-step-name">@name</span>
                                </button>
                                @if (done is { } doneOn)
                                {
                                    <button type="button" class="transition-step-date" aria-label="@F(Strings.PlantDetail.TransitionChangeDay, name)" disabled="@busy"
                                            @onclick="() => OpenTransitionStep(step, name, doneOn)">@Labels.Date(doneOn)</button>
                                }
                            </li>
                        }
                    </ul>
                    @if (settled)
                    {
                        // Nothing to stop once it has settled
                    }
                    else if (confirmStopTransition)
                    {
                        <p class="mb-2">@Strings.PlantDetail.TransitionStopAsk</p>
                        <button type="button" class="btn btn-outline-primary btn-sm transition-confirm" disabled="@busy" @onclick="StopTransitionAsync">@Strings.PlantDetail.StopTracking</button>
                        <button type="button" class="btn btn-link btn-sm transition-confirm" @onclick="() => confirmStopTransition = false">@Strings.Common.Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link link-action transition-stop" @onclick="() => confirmStopTransition = true">@Strings.PlantDetail.StopTracking</button>
                    }
                </section>
            }

            @if (plant.Status == PlantStatus.Died && !string.IsNullOrWhiteSpace(plant.CauseOfDeath))
            {
                <p class="profile-facts">@plant.CauseOfDeath</p>
            }
            @if (plant.DescribeDeparture() is { } departure)
            {
                <p class="profile-facts">@departure</p>
            }
            @if (plant.PottedWithPlantId is not null)
            {
                <p class="profile-facts">
                    @if (pottedWithPlant is not null)
                    {
                        @(plant.PottedWithSince is { } pottedSince
                            ? Html(Strings.PlantDetail.PottedWithSince, Link($"plants/{pottedWithPlant.Id}", pottedWithPlant.DisplayName), H(Labels.Date(pottedSince)))
                            : Html(Strings.PlantDetail.PottedWith, Link($"plants/{pottedWithPlant.Id}", pottedWithPlant.DisplayName)))
                    }
                    else
                    {
                        <text>@Strings.PlantDetail.PottedWithDeleted</text>
                    }
                </p>
            }
            @if (plant.HasLeft && Account.IsAvailable)
            {
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => OpenMore(More.PassOn)">@Strings.PlantDetail.SendHistory</button>
            }

            <AttentionPanel Current="plant.Attention" Later="plant.AttentionLater" NextRoundDay="nextRoundDay" Editing="false" EditingChanged="_ => OpenMore(More.Flag)"
                            Suggestions="AttentionPanel.PlantReasons" OnSave="SetAttentionAsync" />

            <p class="profile-facts">@string.Join(" · ", Facts)</p>
            @if (wateringLine is not null)
            {
                <p class="profile-facts">@wateringLine</p>
            }

            @if (!given.IsEmpty)
            {
                <p class="profile-facts">@string.Join(" · ", GivenParts)</p>
            }

            @if (HasFamily)
            {
                <p class="profile-facts">
                    @if (ancestors.Count > 0 && fromPropagation is not null)
                    {
                        @(Html(Strings.PlantDetail.FamilyFromTypeOf, Link($"propagations/{fromPropagation.Id}", TypeWithArticle(fromPropagation.Type), "link-action"), Link($"plants/{ancestors[0].Id}", ancestors[0].DisplayName, "link-action"), H(ParentNote(ancestors[0]))))
                    }
                    else if (ancestors.Count > 0)
                    {
                        @(Html(Strings.PlantDetail.FamilyFromPlant, Link($"plants/{ancestors[0].Id}", ancestors[0].DisplayName, "link-action"), H(ParentNote(ancestors[0]))))
                    }
                    else if (fromPropagation is not null)
                    {
                        @(Html(Strings.PlantDetail.FamilyFromType, Link($"propagations/{fromPropagation.Id}", TypeWithArticle(fromPropagation.Type), "link-action")))
                    }
                    @if (propagations.Count > 0)
                    {
                        @(ancestors.Count > 0 || fromPropagation is not null ? " · " : "")<a class="link-action" href="plants/@plant.Id?tab=props" @onclick="ShowCuttings" @onclick:preventDefault>@Plural.Of(propagations.Count, Strings.PlantDetail.PropagationCount_One, Strings.PlantDetail.PropagationCount_Other)</a>
                    }
                    @if (offspring.Count > 0)
                    {
                        @(ancestors.Count > 0 || fromPropagation is not null || propagations.Count > 0 ? " · " : "")<a class="link-action" href="plants/@plant.Id?tab=props" @onclick="ShowCuttings" @onclick:preventDefault>@Plural.Of(offspring.Count, Strings.PlantDetail.OffspringCount_One, Strings.PlantDetail.OffspringCount_Other)</a>
                    }
                    · <a class="link-action" href="plants/@plant.Id/family">@Strings.PlantDetail.FamilyTreeLink</a>
                </p>
            }

            <div class="profile-links">
                <button type="button" class="btn btn-link btn-sm link-action details-toggle" aria-expanded="@(detailsOpen ? "true" : "false")"
                        aria-controls="plant-details" @onclick="() => detailsOpen = !detailsOpen">
                    @Strings.PlantDetail.Details
                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </button>
                <a class="btn btn-link btn-sm link-action" href="plants/@plant.Id/edit">@Strings.Common.Edit</a>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenShare">@Strings.Plants.ListShare</button>
            </div>

            <div id="plant-details" class="profile-details @(detailsOpen ? "open" : null)">
                <section class="detail-card">
                    <dl class="detail-list">
                        <dt>@Strings.PlantDetail.GotIt</dt>
                        <dd>
                            @Labels.For(plant.Origin)
                            @if (plant.AsksHowRaised && plant.RaisedAs is { } raised)
                            {
                                <text> · @Labels.For(raised)</text>
                            }
                            @if (plant.AcquiredOn is { } date)
                            {
                                <text> · @Labels.Date(date)</text>
                            }
                            @if (sellers.For(plant.SellerId, plant.Source) is { } seller)
                            {
                                <text> · </text>
                                @if (plant.PaidText is { } paid)
                                {
                                    <text>@Html(Strings.PlantDetail.BoughtFromFor, Link($"sellers/{seller.Id}", seller.Name), H(paid))</text>
                                }
                                else
                                {
                                    <a href="sellers/@seller.Id">@seller.Name</a>
                                }
                            }
                            else if (plant.DescribePurchase() is { } purchase)
                            {
                                <text> · @purchase</text>
                            }
                            else if (!string.IsNullOrWhiteSpace(plant.Source))
                            {
                                <text> · @plant.Source</text>
                            }
                            @if (Arrival.PoorText(plant.ArrivedIn, plant.ArrivalProblems) is { } poor)
                            {
                                <text> · @poor</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(plant.ArrivalNote))
                            {
                                <text>@(plant.ArrivedIn == ArrivalRating.Poor ? ". " : " · ")@plant.ArrivalNote.Trim()</text>
                            }
                        </dd>

                        <dt>@Strings.PlantDetail.Location</dt>
                        <dd>@(places.NameOf(plant.PlaceId) ?? Strings.Plants.ListNotSet)</dd>

                        @if (plant.Light is { } light)
                        {
                            <dt>@Strings.PlantDetail.Light</dt>
                            <dd>@Labels.For(light)</dd>
                        }

                        @if (CareLikes.HasAny(plant))
                        {
                            var likesLine = string.Join(" · ", new[]
                            {
                                plant.LikesLight is { } wantsLight ? Labels.For(wantsLight) : null,
                                plant.LikesWater is { } wantsWater ? Labels.For(wantsWater) : null,
                                plant.LikesHumidity is { } wantsHumidity ? Labels.For(wantsHumidity) : null
                            }.Where(t => t is not null));
                            <dt>@Strings.PlantDetail.Likes</dt>
                            <dd>
                                @likesLine
                                @if (plant.GrowingSeason is { } season)
                                {
                                    <div class="@(likesLine.Length > 0 ? "detail-sub" : null)">@Labels.For(season)@(plant.RestHow is { } rest ? $", {Labels.For(rest)}" : "")</div>
                                }
                                @if (CareLikes.Fit(plant) is { } fit and not LightFit.Fits)
                                {
                                    <div class="detail-sub">@(fit == LightFit.Darker ? Strings.PlantDetail.LikesDarker : Strings.PlantDetail.LikesBrighter)</div>
                                }
                            </dd>
                        }
                        else if (careFor is not null && CareSuggestion.Fills(plant, careFor) is { Count: > 0 } offered)
                        {
                            <dt>@Strings.PlantDetail.Likes</dt>
                            <dd><CareOffer Care="careFor" Fills="offered" Book="careBook" Inline="true" OnUse="UseCareAsync" /></dd>
                        }

                        @if (careBook.IsEmpty is false && !string.IsNullOrWhiteSpace(plant.Genus))
                        {
                            <dt>@Strings.PlantDetail.Pets</dt>
                            <dd>
                                @ToxicityText.Pets(careFor)@if (careFor?.PetsFrom is { } petsUrl)
                                {
                                    <text> · <a href="@petsUrl" target="_blank" rel="noopener">@careBook.SourceName(petsUrl)</a></text>
                                }
                                @if (ToxicityText.People(careFor) is { } peopleText)
                                {
                                    <div class="detail-sub">@peopleText@if (careFor?.PeopleFrom is { } peopleUrl)
                                    {
                                        <text> · <a href="@peopleUrl" target="_blank" rel="noopener">@careBook.SourceName(peopleUrl)</a></text>
                                    }</div>
                                }
                            </dd>
                        }

                        <dt>@Strings.PlantDetail.GrowsIn</dt>
                        <dd>
                            @Labels.For(plant.Medium)
                            @if (PotName(plant.InnerPotId) is { } inner)
                            {
                                <text> · </text>@PotPhotoFor(plant.InnerPotId)@inner
                            }

                            @if (PotName(plant.OuterPotId) is { } outer)
                            {
                                <div class="detail-sub">
                                    @StandingIn(outer)
                                </div>
                            }

                            @if (Mix is { } mix)
                            {
                                <div class="detail-sub">@F(mix.IsRetired ? Strings.PlantDetail.MixInRetired : Strings.PlantDetail.MixIn, mix.Name)</div>
                                @if (!string.IsNullOrWhiteSpace(mix.Recipe))
                                {
                                    <div class="detail-sub">@mix.Recipe</div>
                                }
                            }
                        </dd>

                        @if (WateringFeed is { } wateringFeed)
                        {
                            <dt>@Strings.PlantDetail.WateringFeed</dt>
                            <dd>@F(plant.WateringFeedEvery switch { 2 => Strings.PlantDetail.FeedEverySecond, 3 => Strings.PlantDetail.FeedEveryThird, _ => Strings.PlantDetail.FeedEveryWatering }, wateringFeed.Name)</dd>
                        }

                        @if (plant.QuarantinedSince is { } quarantinedSince)
                        {
                            <dt>@Strings.Plants.ListQuarantine</dt>
                            <dd>@(quarantinedSince == Today ? F(Strings.PlantDetail.QuarantineSinceToday, plant.DaysInQuarantine(Today) ?? 0, plant.QuarantineDays ?? Plant.DefaultQuarantineDays) : F(Strings.PlantDetail.QuarantineSince, Labels.Date(quarantinedSince), plant.DaysInQuarantine(Today) ?? 0, plant.QuarantineDays ?? Plant.DefaultQuarantineDays))</dd>
                        }

                        @if (lastChecked is { } checkedOn)
                        {
                            <dt>@Strings.PlantDetail.CheckedForPests</dt>
                            <dd>@Checked(checkedOn)</dd>
                        }

                        @if (plant.DormantSince is { } dormantSince)
                        {
                            <dt>@Strings.Plants.ListDormant</dt>
                            <dd>@(dormantSince == Today ? Strings.PlantDetail.DormantSinceToday : F(plant.DaysDormant(Today) ?? 0, Strings.PlantDetail.DormantSince_One, Strings.PlantDetail.DormantSince_Other, Labels.Date(dormantSince), plant.DaysDormant(Today) ?? 0))</dd>
                        }

                        @if (plant.TransitionSettled && plant.TransitionSince is { } movedSince && plant.TransitionSettledOn is { } settledOn)
                        {
                            var settledWeeks = Math.Max(1, (settledOn.DayNumber - movedSince.DayNumber) / 7);
                            <dt>@Strings.PlantDetail.MovedToSemiHydro</dt>
                            <dd>@F(settledWeeks, Strings.PlantDetail.SettledAfter_One, Strings.PlantDetail.SettledAfter_Other, plant.TransitionTo is { } movedTo ? Labels.For(movedTo) : Strings.PlantDetail.SemiHydro, settledWeeks, Labels.Date(settledOn))</dd>
                        }

                        @if (plant.Tags.Count > 0)
                        {
                            <dt>@Strings.Plants.ListTagsLabel</dt>
                            <dd class="detail-tags">
                                @foreach (var tag in plant.Tags)
                                {
                                    <a class="tag-label" href="@TagLink(tag)">@tag</a>
                                }
                            </dd>
                        }

                        @foreach (var field in ownFields)
                        {
                            if (plant.OwnFields.TryGetValue(field.Id, out var fieldValue) && fieldValue.Length > 0)
                            {
                                <dt>@field.Name</dt>
                                <dd>@OwnFieldValues.Display(field.Kind, fieldValue)</dd>
                            }
                        }

                        <PublicPageRow SubjectId="plant.Id" />
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(plant.Notes))
                    {
                        <h2>@Strings.PlantDetail.AboutIt</h2>
                        <p class="detail-notes">@plant.Notes</p>
                    }

                    <ReferencePhotoAdd SubjectType="SubjectType.Plant" SubjectId="plant.Id" OnAdded="() => historyVersion++" />
                </section>

                @if (pests.Count > 0)
                {
                    <section class="detail-card">
                        <h2>@Strings.PlantDetail.PestsHeading</h2>
                        <ul class="family-list">
                            @foreach (var item in pests)
                            {
                                <li>
                                    <a href="pests/@item.Id">@Labels.For(item.Pest)</a>
                                    <span class="text-body-secondary small">
                                        · @F(Strings.PlantDetail.PestSince, Labels.For(item.Status).ToLower(System.Globalization.CultureInfo.CurrentCulture), Labels.Date(item.StartedOn))
                                    </span>
                                </li>
                            }
                        </ul>
                        <p class="family-hint">@Strings.PlantDetail.PestsHint</p>
                    </section>
                }

                @if (flowerings.Count > 0)
                {
                    <section class="detail-card">
                        <h2>@Strings.Plants.ListFlowering</h2>
                        @if (usualStart is { } usual)
                        {
                            <p class="flowering-usually">
                                @F(usual.LateThisYear ? Strings.PlantDetail.FloweringUsuallyLate : Strings.PlantDetail.FloweringUsually, FloweringText.MonthName(usual.Month))
                                <span class="text-body-secondary small">@Plural.Of(usual.Years, Strings.PlantDetail.LearnedFrom_One, Strings.PlantDetail.LearnedFrom_Other)</span>
                            </p>
                        }
                        <ul class="flowering-rows">
                            @foreach (var period in flowerings.Reverse())
                            {
                                var shown = period;
                                <li>
                                    <button type="button" class="flowering-row" @onclick="() => OpenPeriod(shown)">
                                        <b>@shown.Start.Year</b>
                                        <span>@FloweringText.Describe(shown)</span>
                                    </button>
                                </li>
                            }
                        </ul>
                        <p class="family-hint">
                            <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenPastFlowering">@Strings.PlantDetail.AddPastFlowering</button>
                            <a class="btn btn-link btn-sm link-action" href="plants/flowering">@Strings.PlantDetail.SeeFloweringCalendar</a>
                        </p>
                    </section>
                }

                @if (closedProblems.Count > 0)
                {
                    <section class="detail-card">
                        <h2>@Strings.PlantDetail.ProblemsHeading</h2>
                        <ul class="problem-rows">
                            @foreach (var problem in (showAllProblems ? closedProblems : closedProblems.Take(5)))
                            {
                                <li>
                                    <a href="problems/@problem.Id">
                                        <b>@ProblemText.Signs(problem.KnownSigns)</b>
                                        <span>@ProblemText.PastLine(problem)</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (closedProblems.Count > 5 && !showAllProblems)
                        {
                            <p class="family-hint">
                                <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => showAllProblems = true">@F(Strings.PlantDetail.ShowAll, closedProblems.Count)</button>
                            </p>
                        }
                    </section>
                }

                <section class="detail-card" id="plant-family">
                    <h2>@Strings.PlantDetail.FamilyHeading</h2>
                    @if (HasFamily)
                    {
                        <p class="family-tree-link"><a class="link-action" href="plants/@plant.Id/family">@Strings.PlantDetail.SeeFamilyTree</a></p>
                    }
                    @if (ancestors.Count > 0 || fromPropagation is not null)
                    {
                        <h3>@Strings.PlantDetail.CameFrom</h3>
                        <ul class="family-list">
                            @if (fromPropagation is not null)
                            {
                                <li>
                                    <a href="propagations/@fromPropagation.Id">@Labels.For(fromPropagation.Type)</a>
                                    <span class="text-body-secondary small"> · @F(Strings.PlantDetail.FamilyStarted, Labels.Date(fromPropagation.StartedOn))</span>
                                </li>
                            }
                            @foreach (var ancestor in ancestors)
                            {
                                <li>
                                    <a href="plants/@ancestor.Id">@ancestor.DisplayName</a>
                                    @if (ancestor.LivesElsewhere)
                                    {
                                        <span class="text-body-secondary small"> · @(ancestor.LivesWithName is { } owner ? F(Strings.PlantDetail.FamilyLivesWith, owner) : Strings.PlantDetail.FamilyNotYours)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (propagations.Count > 0)
                    {
                        <h3>@F(Strings.PlantDetail.PropagationsHeading, propagations.Count)</h3>
                        <ul class="item-list">
                            @foreach (var propagation in propagations)
                            {
                                <li><PropagationCard Propagation="propagation" ShowStage="true" /></li>
                            }
                        </ul>
                    }
                    @if (offspring.Count > 0)
                    {
                        <h3>@F(Strings.PlantDetail.OffspringHeading, offspring.Count)</h3>
                        <ul class="family-list">
                            @foreach (var child in offspring)
                            {
                                <li>
                                    <a href="plants/@child.Id">@child.DisplayName</a>
                                    @if (!child.InCollection)
                                    {
                                        <span class="text-body-secondary small"> · @Labels.StatusOf(child)</span>
                                    }
                                    @if (child.HasLeft && !string.IsNullOrWhiteSpace(child.LeftTo))
                                    {
                                        <span class="text-body-secondary small"> · @F(child.Status == PlantStatus.Sold ? Strings.PlantDetail.SoldTo : Strings.PlantDetail.GivenTo, child.LeftTo)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    <p class="family-hint">
                        @Html(Strings.PlantDetail.FamilyHintCutting, Link($"propagations/new?parent={plant.Id}", Strings.PlantDetail.FamilyHintCuttingLink))
                        @Html(Strings.PlantDetail.FamilyHintRooted, Link($"plants/new?parent={plant.Id}", Strings.PlantDetail.FamilyHintRootedLink))
                    </p>
                </section>

                <p class="family-hint">
                    @Html(Strings.PlantDetail.CopyHint, Link($"plants/new?copy={plant.Id}", Strings.PlantDetail.CopyHintLink))
                </p>

                <section class="danger-zone">
                    @if (confirmDelete)
                    {
                        <p class="mb-2">@Html(Strings.PlantDetail.DeleteAsk, H(plant.DisplayName))</p>
                        @if (pottedInHere.Count > 0)
                        {
                            <p class="mb-2">@F(Strings.PlantDetail.DeletePottedIn, string.Join(", ", pottedInHere.Select(p => p.DisplayName)))</p>
                        }
                        <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                        <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">@Strings.PlantDetail.DeletePlant</button>
                    }
                </section>
            </div>
        </div>

        <div class="profile-history">
            <div class="page-dock" role="group" aria-label="@F(Strings.PlantDetail.DockLabel, plant.DisplayName)" data-tour="dock">
                @if (googleOn)
                {
                    <button type="button" class="btn btn-primary icon-btn" @onclick="() => photoChoice = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        @Strings.PlantDetail.DockPhoto
                    </button>
                }
                else
                {
                    <label class="btn btn-primary icon-btn" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        @Strings.PlantDetail.DockPhoto
                    </label>
                }
                <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => composer?.OpenNote()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                    @Strings.PlantDetail.DockNote
                </button>
                @if (plant.InCollection)
                {
                    <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => careOpen = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10Z" /></svg>
                        @Strings.PlantDetail.DockCare
                    </button>
                }
                <button type="button" class="btn btn-outline-primary dock-more" aria-label="@Strings.PlantDetail.DockMore" @onclick="() => OpenMore(More.Menu)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg>
                </button>
            </div>

            @if (Arrived)
            {
                <ArrivedNote SubjectId="plant.Id" />
            }

            <Timeline @key="historyVersion" @ref="timeline" SubjectType="SubjectType.Plant" SubjectId="plant.Id"
                      CoverPhotoId="ShownCover" OnCoverChanged="SetCoverAsync" PhotoAge="day => PhotoDayCount.PlantAge(plant, day)"
                      EarlierPropagationId="@(earlierUntil is null ? null : fromPropagation?.Id)" EarlierUntil="earlierUntil"
                      EmptyText="@Strings.PlantDetail.TimelineEmpty" />
        </div>
    </div>

    <EntryComposer @key="plant.Id" @ref="composer" SubjectType="SubjectType.Plant" SubjectId="plant.Id" PhotoInputId="@photoInputId" OnPicked="() => { photoChoice = false; more = More.None; }"
                   CoverPhotoId="ShownCover" OnCoverChanged="SetCoverAsync" OnAdded="() => historyVersion++" />

    @if (googleOn)
    {
        <Sheet Title="@Strings.PlantDetail.AddPhoto" Open="photoChoice" OpenChanged="open => photoChoice = open">
            <ul class="sheet-actions">
                <li>
                    <label class="sheet-action" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        <span class="sheet-action-text"><b>@Strings.PlantDetail.FromDevice</b><small>@Strings.PlantDetail.CameraOrGallery</small></span>
                    </label>
                </li>
                <li>
                    <button type="button" class="sheet-action" @onclick="PickFromGoogleAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                        <span class="sheet-action-text"><b>@Strings.PlantDetail.FromGoogle</b><small>@Strings.PlantDetail.FromGoogleHint</small></span>
                    </button>
                </li>
            </ul>
        </Sheet>
    }

    <ShowFound ElementId="@(Entry is { } found ? $"entry-{found}" : null)" Ready="@(loaded && (Tab != "care" || careOpen))" />

    <Sheet Title="@Strings.PlantDetail.DockCare" Open="careOpen" OpenChanged="open => { careOpen = open; if (!open) careEditing = null; }">
      @if (careEditing is not null)
      {
        <div class="sheet-section">
            <CareEntryEditor @key="careEditing.Id" Entry="careEditing" OwnKinds="ownKindLookup"
                             OnDone="CareFixedAsync" OnBack="() => careEditing = null" />
        </div>
      }
      else
      {
        <div class="sheet-section">
            @if (care.Count == 0)
            {
                <p class="text-body-secondary mb-0">@Strings.PlantDetail.CareNothing</p>
            }
            else
            {
                <dl class="detail-list">
                    @foreach (var (kind, last) in headline)
                    {
                        <dt>@(kind == CareKind.ToppedUp && WaterForm == WateringForm.Reservoir ? WateringText.DoneLabel(WaterForm) : Labels.For(kind))</dt>
                        <dd>@(last is null ? Strings.PlantDetail.Never : $"{Labels.DaysAgo(last.DaysAgo)} · {Labels.Date(last.On)}")</dd>
                    }
                </dl>
            }
            @if (moisture is { } reading)
            {
                <p class="care-moisture mb-0">@F(Strings.PlantDetail.Moisture, reading.Value, Labels.DaysAgo(reading.DaysAgo))</p>
            }
        </div>

        @if (plant.InCollection)
        {
            <div class="sheet-section">
                @if (comesBack.Count > 0)
                {
                    <h3 class="section-label">@Strings.PlantDetail.ComesBack</h3>
                    <ul class="comes-back">
                        @foreach (var line in comesBack)
                        {
                            <li><a href="care-intervals/@line.IntervalId?plant=@plant.Id">@line.Label · @line.Next · @line.Every</a></li>
                        }
                    </ul>
                    <a class="comes-back-add" href="care-intervals/new?plant=@plant.Id">@Strings.Common.Add</a>
                }
                else
                {
                    <a class="comes-back-add" href="care-intervals/new?plant=@plant.Id">@Strings.PlantDetail.SetCareToComeBack</a>
                }
            </div>
        }

        <div class="sheet-section">
            <CareSheet PlantIds="@(new[] { plant.Id })" Form="WateringForms.Of(plant, id => pots.FirstOrDefault(p => p.Id == id))" OnLogged="CareLoggedAsync" />
        </div>

        @if (careCalendar is { IsEmpty: false })
        {
            <div class="sheet-section">
                <h3 class="section-label">@Strings.PlantDetail.LastYear</h3>
                <CareYear Calendar="careCalendar" />
            </div>
        }

        @if (care.Count > 0)
        {
            <div class="sheet-section">
                <h3 class="section-label">@Strings.PlantDetail.History</h3>
                <ul class="care-list">
                    @foreach (var entry in care)
                    {
                        <li id="entry-@entry.Id">
                            <button type="button" class="care-entry care-editable" @onclick="() => careEditing = entry"
                                    aria-label="@F(Strings.PlantDetail.FixOrDelete, CareService.Describe(entry, Labels.For, ownKindLookup), Labels.Date(entry.OccurredOn))">
                                <span class="care-what">@CareService.Describe(entry, Labels.For, ownKindLookup)</span>
                                <span class="care-when">@Labels.Date(entry.OccurredOn)</span>
                                <svg class="care-edit-hint" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
      }
    </Sheet>

    <ShareSheet Open="shareOpen" OpenChanged="open => shareOpen = open" Tone="plant" SubjectId="plant.Id"
                Plant="plant" FromPropagation="fromPropagation" StartOnLink="shareOnLink"
                CoverPhotoId="ShownCover" PhotoAge="day => PhotoDayCount.PlantAge(plant, day)" Text="ShareCardText.ForPlant(plant, ancestors.FirstOrDefault(), fromPropagation, propagations, Today)" />

    <Sheet Title="@MoreTitle" Open="more != More.None" OpenChanged="open => { if (!open) more = More.None; }">
        @switch (more)
        {
            case More.Menu:
                <ul class="sheet-actions">
                    @if (plant.InCollection)
                    {
                        <li>
                            <a class="sheet-action" href="propagations/new?parent=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.5" /><circle cx="6" cy="17.5" r="2.5" /><path d="M8.2 7.8 19 17M8.2 16.2 19 7" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.MenuPropagate</b><small>@Strings.PlantDetail.MenuPropagateHint</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => more = More.Flag">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4" /><path d="M5 4h12l-2.5 4.5L17 13H5" /></svg>
                                <span class="sheet-action-text"><b>@(plant.Attention is null ? Strings.PlantDetail.FlagIt : Strings.PlantDetail.ChangeFlag)</b><small>@Strings.PlantDetail.FlagHint</small></span>
                            </button>
                        </li>
                        <li>
                            @if (plant.IsDormant)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndDormancyAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.PlantDetail.WokenUp</b><small>@F(Strings.PlantDetail.DormantFor, DaysLabel(plant.DaysDormant(Today)))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenDormant">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.Plants.ListDormant</b><small>@Strings.PlantDetail.DormantHint</small></span>
                                </button>
                            }
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => more = More.Swap">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h11l-3-3M17 17H6l3 3" /></svg>
                                <span class="sheet-action-text"><b>@Strings.Plants.ListForSwap</b><small>@(plant.Spare is { } offered ? SwapLists.MarkText(offered) : Strings.PlantDetail.OfferSwapHint)</small></span>
                            </button>
                        </li>
                        <li>
                            <a class="sheet-action" href="labels?plants=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9Z" /><circle cx="8" cy="8" r="1.4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.PrintLabel</b><small>@Strings.PlantDetail.PrintLabelHint</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenFlowering">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.2" /><path d="M12 9.800C10.600 7.500 10.600 5 12 3.500c1.400 1.500 1.400 4 0 6.300Z" /><path d="M12 14.200c1.400 2.300 1.400 4.800 0 6.300-1.400-1.500-1.400-4 0-6.300Z" /><path d="M9.800 12C7.500 10.600 5 10.600 3.500 12c1.500 1.400 4 1.400 6.300 0Z" /><path d="M14.200 12c2.300 1.400 4.800 1.400 6.300 0-1.500-1.400-4-1.400-6.300 0Z" /></svg>
                                <span class="sheet-action-text"><b>@Strings.Plants.ListFlowering</b><small>@FloweringText.MenuHint(floweringNow, Today.Year)</small></span>
                            </button>
                        </li>
                        <li>
                            @if (plant.InQuarantine)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndQuarantineAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.PlantDetail.EndQuarantine</b><small>@F(Strings.PlantDetail.InQuarantineFor, DaysLabel(plant.DaysInQuarantine(Today)))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenQuarantine">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" stroke-dasharray="3 2.5" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.Plants.ListQuarantine</b><small>@Strings.PlantDetail.QuarantineHint</small></span>
                                </button>
                            }
                        </li>
                        @if (!plant.InTransition)
                        {
                            <li>
                                <button type="button" class="sheet-action" @onclick="OpenTransition">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14l-1.500 8.500a1.500 1.500 0 0 1-1.500 1.200H8a1.500 1.500 0 0 1-1.500-1.200Z" /><circle cx="9" cy="7.500" r="1.800" /><circle cx="14.500" cy="7" r="1.800" /><circle cx="12" cy="3.800" r="1.200" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.PlantDetail.MovingToSemiHydro</b><small>@Strings.PlantDetail.MovingToSemiHydroHint</small></span>
                                </button>
                            </li>
                        }
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenPestCheck">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 5 5" /><path d="m8 10.5 2 2 3.5-4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.CheckForPests</b><small>@Strings.PlantDetail.CheckForPestsHint</small></span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenProblem">
                                <svg viewBox="0 0 24 24" aria-hidden="true">@ProblemIcons.WiltingLeaf</svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.SomethingWrong</b><small>@Strings.PlantDetail.SomethingWrongHint</small></span>
                            </button>
                        </li>
                        <li>
                            <a class="sheet-action" href="pests/new?plant=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.FoundPests</b><small>@Strings.PlantDetail.FoundPestsHint</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenPotTogether">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16l-1.5 9h-13Z" /><path d="M9 11V8M15 11V8" /><path d="M9 8c0-2 1.5-3 3-4M15 8c0-2-1.5-3-3-4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.PotTogether</b><small>@Strings.PlantDetail.PotTogetherHint</small></span>
                            </button>
                        </li>
                        @if (plant.HowMany > 1)
                        {
                            <li>
                                <button type="button" class="sheet-action" @onclick="() => more = More.Some">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="2.5" /><circle cx="16" cy="9" r="2.5" /><path d="M4 20h16" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.PlantDetail.SomeOfThem</b><small>@Strings.PlantDetail.SomeOfThemHint</small></span>
                                </button>
                            </li>
                        }
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => OpenStatus(PlantStatus.GivenAway)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h12M12 7l5 5-5 5" /><path d="M20 5v14" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.GaveOrSold</b><small>@Strings.PlantDetail.GaveOrSoldHint</small></span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="sheet-action danger" @onclick="() => OpenStatus(PlantStatus.Died)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-7" /><path d="M12 14c-1-4-4-6-8-6 0 4 3 7 8 6Z" /><path d="M12 14c2-3 4.5-4 8-3.5-.5 3.5-3.5 5-8 3.5Z" /><path d="M4 21h16" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.ItDied</b><small>@Strings.PlantDetail.ItDiedHint</small></span>
                            </button>
                        </li>
                    }
                    else if (plant.LivesElsewhere)
                    {
                        <li>
                            <a class="sheet-action" href="plants/@plant.Id/edit">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.ItsMineNow</b><small>@Strings.PlantDetail.ItsMineNowHint</small></span>
                            </a>
                        </li>
                    }
                    else if (plant.Status == PlantStatus.Active)
                    {
                        <li>
                            <a class="sheet-action" href="labels?plants=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9Z" /><circle cx="8" cy="8" r="1.4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.PrintLabel</b><small>@Strings.PlantDetail.PrintLabelHint</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenTakeOut">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H8M12 7l-5 5 5 5" /><path d="M4 5v14" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.TakeOutAgain</b><small>@Strings.PlantDetail.TakeOutAgainHint</small></span>
                            </button>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="sheet-action" href="labels?plants=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9Z" /><circle cx="8" cy="8" r="1.4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.PrintLabel</b><small>@Strings.PlantDetail.PrintLabelHint</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => OpenStatus(plant.Status)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.ChangeWhatHappened</b><small>@Labels.For(plant.Status)</small></span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" disabled="@busy" @onclick="BackInCollectionAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H8M12 7l-5 5 5 5" /><path d="M4 5v14" /></svg>
                                <span class="sheet-action-text"><b>@Strings.PlantDetail.BackInCollection</b><small>@Strings.PlantDetail.BackInCollectionHint</small></span>
                            </button>
                        </li>
                    }
                </ul>
                break;

            case More.PotTogether:
                if (PotTogetherChoices == 0)
                {
                    <p class="mb-3">@Strings.PlantDetail.NoOtherPlants</p>
                    <div class="form-actions">
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                    </div>
                }
                else
                {
                    <InfoButton Topic="@Strings.PlantDetail.PotTogetherTopic">
                        <Label><span class="form-label mb-0">@Strings.PlantDetail.IntoOtherPot</span></Label>
                        <ChildContent>
                            @Strings.PlantDetail.PotTogetherInfo
                        </ChildContent>
                    </InfoButton>
                    <div class="mb-3">
                        <PlantSelect Plants="allPlants" Genus="@plant.Genus" Except="plant.Id" Value="pottingInto" ValueChanged="id => pottingInto = id" />
                        <div class="form-text">@Strings.PlantDetail.PotTogetherNote</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="potted-on">@Strings.PlantDetail.Date</label>
                        <input id="potted-on" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@(busy || pottingInto is null || since > Today)" @onclick="PotTogetherAsync">@Strings.PlantDetail.PotTogether</button>
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                    </div>
                }
                break;

            case More.Some:
                <ul class="sheet-actions">
                    <li>
                        <button type="button" class="sheet-action" @onclick="() => OpenSome(SomeKind.Died)">
                            <span class="sheet-action-text"><b>@Strings.PlantDetail.SomeDied</b></span>
                        </button>
                    </li>
                    <li>
                        <button type="button" class="sheet-action" @onclick="() => OpenSome(SomeKind.GaveAway)">
                            <span class="sheet-action-text"><b>@Strings.PlantDetail.GaveSomeAway</b></span>
                        </button>
                    </li>
                    <li>
                        <button type="button" class="sheet-action" @onclick="() => OpenSome(SomeKind.PottedUp)">
                            <span class="sheet-action-text"><b>@Strings.PlantDetail.PottedSomeUp</b></span>
                        </button>
                    </li>
                </ul>
                <div class="form-actions">
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.SomeForm:
                @if (someKind == SomeKind.PottedUp)
                {
                    <InfoButton Topic="@Strings.PlantDetail.OnTheirOwnTopic">
                        <Label><span class="form-label mb-0">@Strings.PlantDetail.OnTheirOwn</span></Label>
                        <ChildContent>
                            @Strings.PlantDetail.OnTheirOwnInfo
                        </ChildContent>
                    </InfoButton>
                }
                <div class="mb-3">
                    <label class="form-label" for="some-count">@F(Strings.PlantDetail.HowManyOf, plant.HowMany)</label>
                    <input id="some-count" type="number" class="form-control" min="1" max="@(plant.HowMany - 1)"
                           inputmode="numeric" @bind="someCount" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="some-date">@Strings.PlantDetail.Date</label>
                    <input id="some-date" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                @if (someKind == SomeKind.GaveAway)
                {
                    <div class="mb-3">
                        <label class="form-label" for="some-who">@Strings.PlantDetail.WhoTo <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                        <input id="some-who" class="form-control" @bind="someWho" />
                    </div>
                }
                @if (someKind == SomeKind.PottedUp)
                {
                    <div class="mb-3">
                        <label class="form-label" for="some-name">@Strings.PlantDetail.Nickname <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                        <input id="some-name" class="form-control" @bind="someNickname" @bind:event="oninput" />
                        @if (someCount > 1)
                        {
                            <div class="form-text">@F(Strings.PlantDetail.NicknameNumbered, string.IsNullOrWhiteSpace(someNickname) ? "Coleus" : someNickname.Trim())</div>
                        }
                    </div>
                }
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || someCount < 1 || someCount >= plant.HowMany || since > Today)" @onclick="SaveSomeAsync">@Strings.Common.Save</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Some">@Strings.Common.Back</button>
                </div>
                break;

            case More.TakeOut:
                <div class="mb-3">
                    <PotPicker Value="takeOutPot" ValueChanged="id => takeOutPot = id" Pots="pots" Groups="InnerSlot" PotAdded="AddPot" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="taken-out-on">@Strings.PlantDetail.Date</label>
                    <input id="taken-out-on" type="date" class="form-control" @bind="since"
                           min="@((plant.PottedWithSince ?? since).ToString("yyyy-MM-dd"))" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || since > Today)" @onclick="TakeOutAsync">@Strings.PlantDetail.TakeItOut</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.Swap:
                <div class="mb-3">
                    <div class="btn-group segmented w-100 swap-choices" role="radiogroup" aria-label="@Strings.PlantDetail.SwapOffered">
                        @foreach (var (value, label) in SwapChoices)
                        {
                            var id = $"swap-{value?.ToString() ?? "none"}";
                            <input type="radio" class="btn-check" name="swap-mark" id="@id"
                                   checked="@(plant.Spare == value)" disabled="@busy" @onchange="() => SetSpareAsync(value)" />
                            <label class="btn btn-outline-primary" for="@id">@label</label>
                        }
                    </div>
                    <div class="form-text">@Html(Strings.PlantDetail.SwapHint, Link("swap", Strings.PlantDetail.SwapHintLink))</div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.PassOn:
                <PassOnPanel SubjectType="SubjectType.Plant" SubjectId="plant.Id" Name="@plant.DisplayName"
                             OnDone="() => more = More.None" OnChangePage="ChangePassOnPage" />
                break;

            case More.Flag:
                <AttentionPanel Current="plant.Attention" Later="plant.AttentionLater" NextRoundDay="nextRoundDay" Editing="true" EditingChanged="_ => more = More.None"
                                Suggestions="AttentionPanel.PlantReasons" OnSave="SetAttentionAsync" />
                break;

            case More.Dormant:
                <div class="mb-3">
                    <label class="form-label" for="dormant-since">@Strings.PlantDetail.DormantSinceLabel</label>
                    <input id="dormant-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    <div class="form-text">@Strings.PlantDetail.DormantNote</div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetDormantAsync">@Strings.PlantDetail.MarkDormant</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.Flowering when floweringSaved is not null:
                <p class="mb-3" role="status">@floweringSaved</p>
                <div class="form-actions">
                    @if (googleOn)
                    {
                        <button type="button" class="btn btn-primary" @onclick="AddFloweringPhoto">@Strings.PlantDetail.AddPhoto</button>
                    }
                    else
                    {
                        <label class="btn btn-primary" for="@photoInputId">@Strings.PlantDetail.AddPhoto</label>
                    }
                    <button type="button" class="btn btn-outline-primary" @onclick="() => more = More.None">@Strings.Common.Close</button>
                </div>
                break;

            case More.Flowering when floweringPast:
                @if (PastErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                        @foreach (var error in PastErrors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }
                <div class="mb-3"><LooseDateInput @bind-Value="pastFlower" Today="Today" Label="@Strings.PlantDetail.InFlowerFrom" /></div>
                <div class="mb-3"><LooseDateInput @bind-Value="pastUntil" Today="Today" Label="@Strings.PlantDetail.UntilOptional" /></div>
                <div class="mb-1"><LooseDateInput @bind-Value="pastBuds" Today="Today" Label="@Strings.PlantDetail.BudsFromOptional" /></div>
                <div class="form-text mb-3">@Strings.PlantDetail.PastFlowerHint</div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || pastFlower is null || PastErrors.Count > 0)" @onclick="SavePastFloweringAsync">@Strings.Common.Add</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.Flowering:
                <div class="mb-3">
                    <label class="form-label" for="flowering-on">@Strings.PlantDetail.When</label>
                    <input id="flowering-on" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-actions mb-2">
                    @foreach (var (stage, index) in NextStages.Select((stage, index) => (stage, index)))
                    {
                        var chosen = stage;
                        <button type="button" class="btn @(index == 0 ? "btn-primary" : "btn-outline-primary")" disabled="@(busy || since > Today || since == default)"
                                @onclick="() => MarkFloweringAsync(chosen)">@FloweringText.StageLabel(stage)</button>
                    }
                </div>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="ShowPastForm">@Strings.PlantDetail.AddPastFlowering</button>
                break;

            case More.ThisFlowering when viewing is not null:
                <ul class="flowering-marks">
                    @foreach (var mark in viewing.Marks.OrderBy(m => m.On.Start).ThenBy(m => m.CreatedAt))
                    {
                        var removing = mark;
                        <li>
                            <span>@FloweringText.StageLabel(mark.Stage!.Value) · @mark.On.Text()</span>
                            <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy" @onclick="() => RemoveMarkAsync(removing)">@Strings.Common.Remove</button>
                        </li>
                    }
                </ul>
                <div class="form-actions mt-2">
                    <button type="button" class="btn btn-outline-primary" @onclick="() => more = More.None">@Strings.Common.Close</button>
                </div>
                break;

            case More.Problem:
                <ProblemSheet Plant="plant" Mode="ProblemSheetMode.Open" BackLabel="@Strings.Common.Back" OnBack="() => more = More.Menu" OnSaved="ProblemSavedAsync" />
                break;

            case More.ProblemUpdate when updating is not null:
                <ProblemSheet @key="updating.Id" Plant="plant" Mode="ProblemSheetMode.Update" Problem="updating" OnSaved="ProblemSavedAsync" />
                break;

            case More.Quarantine:
                <div class="row g-2 mb-1">
                    <div class="col-7">
                        <label class="form-label" for="quarantine-since">@Strings.PlantDetail.QuarantineSinceLabel</label>
                        <input id="quarantine-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-5">
                        <label class="form-label" for="quarantine-days">@Strings.PlantDetail.QuarantineDaysLabel</label>
                        <input id="quarantine-days" type="number" class="form-control" min="1" max="365" inputmode="numeric" @bind="quarantineDays" />
                    </div>
                </div>
                <div class="form-text mb-3">@Strings.PlantDetail.QuarantineNote</div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || quarantineDays is < 1 or > 365)" @onclick="SetQuarantineAsync">@Strings.Plants.ListPutInQuarantine</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.Transition:
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label" for="transition-since">@Strings.PlantDetail.QuarantineSinceLabel</label>
                        <input id="transition-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="transition-to">@Strings.PlantDetail.TransitionInto</label>
                        <select id="transition-to" class="form-select" @bind="transitionTo">
                            <option value="@GrowingMedium.Leca">@Labels.For(GrowingMedium.Leca)</option>
                            <option value="@GrowingMedium.Pon">@Labels.For(GrowingMedium.Pon)</option>
                        </select>
                    </div>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="transition-weeks">@Strings.PlantDetail.TransitionWeeksLabel</label>
                    <input id="transition-weeks" type="number" class="form-control" min="1" max="52" inputmode="numeric" @bind="transitionWeeks" />
                </div>
                <div class="form-text mb-3">@Strings.PlantDetail.TransitionWeeksNote</div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || transitionWeeks is < 1 or > 52)" @onclick="StartTransitionAsync">@Strings.PlantDetail.StartTracking</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.TransitionStep:
                <div class="mb-3">
                    <label class="form-label" for="transition-step-day">@stepName</label>
                    <input id="transition-step-day" type="date" class="form-control" @bind="stepDay"
                           min="@plant.TransitionSince?.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    @foreach (var error in stepErrors)
                    {
                        <div class="text-danger small mt-1" role="alert">@error</div>
                    }
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveTransitionStepAsync">@Strings.Common.Save</button>
                    <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="UntickTransitionStepAsync">@Strings.PlantDetail.Untick</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.None">@Strings.Common.Back</button>
                </div>
                break;

            case More.PestCheck:
                <div class="mb-3">
                    <label class="form-label" for="pest-check-on">@Strings.PlantDetail.CheckedOn</label>
                    <input id="pest-check-on" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pest-check-notes">@Strings.PlantDetail.Notes <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                    <textarea id="pest-check-notes" class="form-control" rows="2" @bind="checkNotes"></textarea>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || since > Today)" @onclick="SavePestCheckAsync">@Strings.PlantDetail.NoSigns</button>
                    <a class="btn btn-link link-action" href="pests/new?plant=@plant.Id">@Strings.PlantDetail.FoundSome</a>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;

            case More.Status:
                @if (status != PlantStatus.Died)
                {
                    <div class="btn-group segmented mb-3" role="radiogroup" aria-label="@Strings.PlantDetail.WhatHappenedGroup">
                        @foreach (var choice in new[] { PlantStatus.GivenAway, PlantStatus.Sold })
                        {
                            var id = $"left-{choice}";
                            <input type="radio" class="btn-check" name="left-how" id="@id" checked="@(status == choice)" @onchange="() => status = choice" />
                            <label class="btn btn-outline-primary" for="@id">@Labels.For(choice)</label>
                        }
                    </div>
                }
                @if (status == PlantStatus.Died)
                {
                    <div class="mb-3">
                        <label class="form-label" for="cause-of-death">@Strings.PlantDetail.WhatHappenedQ <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                        <input id="cause-of-death" class="form-control" @bind="causeOfDeath" placeholder="@Strings.PlantDetail.CausePlaceholder" />
                    </div>
                }
                else
                {
                    var sold = status == PlantStatus.Sold;
                    <div class="mb-3">
                        <label class="form-label" for="left-to">@(sold ? Strings.PlantDetail.WhoBought : Strings.PlantDetail.WhoGotIt) <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                        <input id="left-to" class="form-control" @bind="leftTo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="left-for">@(sold ? Strings.PlantDetail.SoldFor : Strings.PlantDetail.SwappedFor) <span class="text-body-secondary">@Strings.PlantDetail.Optional</span></label>
                        <input id="left-for" class="form-control" @bind="leftFor" placeholder="@(sold ? Strings.PlantDetail.SoldPlaceholder : Strings.PlantDetail.SwappedPlaceholder)" />
                    </div>
                    @if (Labels.PotsTakenChoices([plant]) is { Count: > 0 } choices)
                    {
                        <div class="mb-3">
                            <span class="form-label d-block" id="pots-taken">@Strings.PlantDetail.WhatWentWith</span>
                            <div class="btn-group segmented" role="radiogroup" aria-labelledby="pots-taken">
                                @foreach (var (value, label) in choices)
                                {
                                    var id = $"taken-{value}";
                                    <input type="radio" class="btn-check" name="pots-taken" id="@id"
                                           checked="@(plant.Fit(potsTaken) == value)" @onchange="() => potsTaken = value" />
                                    <label class="btn btn-outline-primary" for="@id">@label</label>
                                }
                            </div>
                            <div class="form-text">@Strings.PlantDetail.PotsTakenNote</div>
                        </div>
                    }
                }
                <div class="form-actions">
                    <button type="button" class="btn @(status == PlantStatus.Died ? "btn-danger" : "btn-primary")" disabled="@busy" @onclick="SaveStatusAsync">@StatusButtonText</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                </div>
                break;
        }
    </Sheet>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Set by the page that keeps a received history, so the first visit says where it went.</summary>
    [SupplyParameterFromQuery(Name = "arrived")]
    public bool Arrived { get; set; }

    /// <summary>
    /// Older links name a tab: "props" opens the details at its propagations and "care" opens
    /// the care sheet. The history is the page itself now.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    /// <summary>A history entry, or with tab=care a care entry, to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "entry")]
    public Guid? Entry { get; set; }

    private enum More { None, Menu, Swap, Flag, Dormant, Quarantine, Transition, TransitionStep, PestCheck, Status, PassOn, Flowering, ThisFlowering, Problem, ProblemUpdate, PotTogether, Some, SomeForm, TakeOut }
    private bool shareOpen;
    private bool shareOnLink;

    private Plant? plant;
    private bool loaded;
    private bool confirmDelete;
    private bool confirmStopTransition;
    private TransitionStep editingStep;
    private string stepName = "";
    private DateOnly stepDay;
    private List<string> stepErrors = [];
    private GrowingMedium transitionTo = GrowingMedium.Leca;
    private int? transitionWeeks = Plant.DefaultTransitionCheckWeeks;
    private bool detailsOpen;
    private bool careOpen;
    private bool busy;

    private IReadOnlyList<Plant> allPlants = [];
    private Plant? pottedWithPlant;
    private IReadOnlyList<Plant> pottedInHere = [];
    private Guid? pottingInto;
    private enum SomeKind { Died, GaveAway, PottedUp }
    private SomeKind someKind;
    private int someCount = 1;
    private string? someWho;
    private string? someNickname;
    private Guid? takeOutPot;
    private static readonly PotGroup[] InnerSlot = [PotGroup.Inner, PotGroup.Standalone];

    private int PotTogetherChoices => allPlants.Count(p => !p.IsDeleted && p.InCollection && p.Id != plant?.Id);

    private void AddPot(Pot pot) => pots = [.. pots, pot];
    private bool scrollToFamily;
    private More more;
    private int historyVersion;

    // A cover that is a reference photo shows as no cover. The plant itself isn't changed.
    private Guid? ShownCover => Covers.Shown(plant?.CoverPhotoId);
    private EntryComposer? composer;
    private bool googleOn;
    private bool photoChoice;
    private Timeline? timeline;
    private readonly string photoInputId = $"plant-photo-{Guid.NewGuid():N}";

    // The small forms in the More sheet
    private DateOnly since;
    private int? quarantineDays;
    private PlantStatus status;
    private string? causeOfDeath;
    private string? leftTo;
    private string? leftFor;
    private PotsTaken potsTaken;

    private IReadOnlyList<CodeClash> numberClashes = [];
    private IReadOnlyList<Plant> ancestors = [];

    // A parent that lives with someone else says so, as "(lives with Grandma)" or "(not yours)"
    private static string ParentNote(Plant parent) =>
        !parent.LivesElsewhere ? "" : parent.LivesWithName is { } owner ? F(Strings.PlantDetail.ParentLivesWith, owner) : Strings.PlantDetail.ParentNotYours;
    private IReadOnlyList<Plant> offspring = [];
    private PlantGiven given = new([], 0, 0, 0, 0);
    private IReadOnlyList<Propagation> propagations = [];
    private Propagation? fromPropagation;
    // The day it was potted up: the cutting's photos up to then show on the history
    private DateOnly? earlierUntil;
    private IReadOnlyList<CareLog> care = [];
    private IReadOnlyList<(CareKind Kind, LastCare? Last)> headline = [];
    private LastCare? lastWater;
    private IReadOnlyDictionary<Guid, OwnCareKind> ownKindLookup = new Dictionary<Guid, OwnCareKind>();
    private MoistureReading? moisture;
    private CareCalendar? careCalendar;
    private IReadOnlyList<PestCase> pests = [];
    private DateOnly? lastChecked;
    private string? checkNotes;
    private string? actionNote;
    private Places places = Places.None;
    private SellerList sellers = SellerList.None;
    private IReadOnlyList<Pot> pots = [];

    // Problems
    private IReadOnlyList<Problem> openProblems = [];
    private IReadOnlyList<Problem> closedProblems = [];
    private ILookup<Guid, ProblemUpdate> problemUpdates = Enumerable.Empty<ProblemUpdate>().ToLookup(u => u.ProblemId);
    private Problem? updating;
    private bool showAllProblems;

    // Flowering
    private IReadOnlyList<FloweringPeriod> flowerings = [];
    private FloweringNow? floweringNow;
    private UsualStart? usualStart;
    private string? floweringSaved;
    private bool floweringPast;
    private LooseDate? pastBuds;
    private LooseDate? pastFlower;
    private LooseDate? pastUntil;
    private FloweringPeriod? viewing;

    private IReadOnlyList<string> PastErrors =>
