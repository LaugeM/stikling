@page "/plants/{Id:guid}"
@layout WideLayout
@using Stikling.Core.Settings
@inject IPlantRepository Repository
@inject IPropagationRepository PropagationRepository
@inject ICareLogRepository CareLogRepository
@inject IPestCaseRepository PestCaseRepository
@inject IPestTreatmentRepository PestTreatmentRepository
@inject FloweringService FloweringService
@inject IPotRepository PotRepository
@inject PotService PotService
@inject ISoilMixRepository MixRepository
@inject IFeedRepository FeedRepository
@inject PlantService PlantService
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@inject PlantNameService Names
@inject ITimelineRepository TimelineRepository
@inject GrowLightService LightService
@inject AwayService AwayService
@inject SettingsService SettingsService
@inject GooglePhotosService Google
@inject AccountService Account

<PageTitle>@(plant?.DisplayName ?? "Plant") · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="plants">Plants</a>

@if (plant is null)
{
    <p class="text-body-secondary">@(loaded ? "That plant doesn't exist or was deleted." : "Loading…")</p>
}
else
{
    @* On a wide screen these are two columns: who it is on the left, its history on the right *@
    <div class="profile-layout">
        <div class="profile-side">
            @if (plant.CoverPhotoId is { } coverId)
            {
                <div class="detail-hero">
                    <button type="button" class="detail-hero-open" aria-label="Open the cover photo" @onclick="() => timeline?.OpenPhoto(coverId)">
                        <PhotoImage PhotoId="coverId" Thumbnail="false" Alt="@($"Photo of {plant.DisplayName}")" />
                    </button>
                </div>
            }

            <header class="detail-header">
                @if (plant.CoverPhotoId is null)
                {
                    <div class="detail-icon potted" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
                    </div>
                }
                <div class="min-w-0">
                    <div class="title-row">
                        <h1>
                            @if (string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
                            {
                                <BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" />
                            }
                            else
                            {
                                @plant.DisplayName
                            }
                        </h1>
                        <button type="button" class="favourite-toggle @(plant.Favourite ? "on" : null)" aria-pressed="@(plant.Favourite ? "true" : "false")"
                                aria-label="Favourite" @onclick="ToggleFavouriteAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8Z" /></svg>
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(plant.Nickname) && plant.BotanicalName is not null)
                    {
                        <p class="detail-sub"><BotanicalName Genus="@plant.Genus" Species="@plant.Species" Cultivar="@plant.Cultivar" /></p>
                    }
                    else if (everyday?.For(plant.Genus, plant.Species, plant.Cultivar) is { } called)
                    {
                        <p class="detail-sub everyday-name">@called</p>
                    }
                    <div class="profile-badges">
                        @if (plant.Status != PlantStatus.Active)
                        {
                            <span class="badge text-bg-secondary">@Labels.For(plant.Status)</span>
                        }
                        @if (plant.InQuarantine)
                        {
                            <span class="badge quarantine-badge">Quarantine</span>
                        }
                        @if (plant.IsDormant)
                        {
                            <span class="badge dormant-badge">Dormant</span>
                        }
                        @if (floweringNow is { Stale: false } && plant.Status == PlantStatus.Active)
                        {
                            <span class="badge flowering-badge">@FloweringText.Badge(floweringNow.Stage)</span>
                        }
                        @foreach (var item in pests)
                        {
                            <a class="badge pest-badge" href="pests/@item.Id">@Labels.For(item.Pest)</a>
                        }
                    </div>
                    @if (floweringNow is { Stale: true } stale && plant.Status == PlantStatus.Active)
                    {
                        <div class="still-card">
                            <p>Still @(stale.Stage == FloweringStage.Buds ? "in bud" : "in flower")? Last marked on @Labels.Date(stale.Period.LastMarked).</p>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="OpenFlowering">Done</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="StillFloweringAsync">Yes</button>
                        </div>
                    }
                    @if (actionNote is not null)
                    {
                        <p class="profile-facts" role="status">@actionNote</p>
                    }
                    @if (recentChanges.Count > 0)
                    {
                        <p class="profile-facts">@RecentChangesText</p>
                    }
                </div>
            </header>

            @if (plant.Status == PlantStatus.Died && !string.IsNullOrWhiteSpace(plant.CauseOfDeath))
            {
                <p class="profile-facts">@plant.CauseOfDeath</p>
            }
            @if (plant.DescribeDeparture() is { } departure)
            {
                <p class="profile-facts">@departure</p>
            }
            @if (plant.HasLeft && Account.IsAvailable)
            {
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => OpenMore(More.PassOn)">Send them its history</button>
            }

            <AttentionPanel Current="plant.Attention" Later="plant.AttentionLater" NextRoundDay="nextRoundDay" Editing="false" EditingChanged="_ => OpenMore(More.Flag)"
                            Suggestions="AttentionPanel.PlantReasons" OnSave="SetAttentionAsync" />

            <p class="profile-facts">@string.Join(" · ", Facts)</p>
            @if (wateringLine is not null)
            {
                <p class="profile-facts">@wateringLine</p>
            }

            @if (!given.IsEmpty)
            {
                <p class="profile-facts">@string.Join(" · ", GivenParts)</p>
            }

            @if (HasFamily)
            {
                <p class="profile-facts">
                    @if (ancestors.Count > 0 && fromPropagation is not null)
                    {
                        <text>from <a class="link-action" href="propagations/@fromPropagation.Id">@TypeWithArticle(fromPropagation.Type)</a> of <a class="link-action" href="plants/@ancestors[0].Id">@ancestors[0].DisplayName</a></text>
                    }
                    else if (ancestors.Count > 0)
                    {
                        <text>from <a class="link-action" href="plants/@ancestors[0].Id">@ancestors[0].DisplayName</a></text>
                    }
                    else if (fromPropagation is not null)
                    {
                        <text>from <a class="link-action" href="propagations/@fromPropagation.Id">@TypeWithArticle(fromPropagation.Type)</a></text>
                    }
                    @if (propagations.Count > 0)
                    {
                        @(ancestors.Count > 0 || fromPropagation is not null ? " · " : "")<a class="link-action" href="plants/@plant.Id?tab=props" @onclick="ShowCuttings" @onclick:preventDefault>@Labels.Count(propagations.Count, "propagation")</a>
                    }
                    @if (offspring.Count > 0)
                    {
                        @(ancestors.Count > 0 || fromPropagation is not null || propagations.Count > 0 ? " · " : "")<a class="link-action" href="plants/@plant.Id?tab=props" @onclick="ShowCuttings" @onclick:preventDefault>@Labels.Count(offspring.Count, "plant") grown from it</a>
                    }
                    · <a class="link-action" href="plants/@plant.Id/family">family tree</a>
                </p>
            }

            <div class="profile-links">
                <button type="button" class="btn btn-link btn-sm link-action details-toggle" aria-expanded="@(detailsOpen ? "true" : "false")"
                        aria-controls="plant-details" @onclick="() => detailsOpen = !detailsOpen">
                    Details
                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </button>
                <a class="btn btn-link btn-sm link-action" href="plants/@plant.Id/edit">Edit</a>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenShare">Share</button>
            </div>

            <div id="plant-details" class="profile-details @(detailsOpen ? "open" : null)">
                <section class="detail-card">
                    <dl class="detail-list">
                        <dt>Got it</dt>
                        <dd>
                            @Labels.For(plant.Origin)
                            @if (plant.AcquiredOn is { } date)
                            {
                                <text> · @Labels.Date(date)</text>
                            }
                            @if (plant.DescribePurchase() is { } purchase)
                            {
                                <text> · @purchase</text>
                            }
                            else if (!string.IsNullOrWhiteSpace(plant.Source))
                            {
                                <text> · @plant.Source</text>
                            }
                        </dd>

                        <dt>Location</dt>
                        <dd>@(places.NameOf(plant.PlaceId) ?? "Not set")</dd>

                        @if (plant.Light is { } light)
                        {
                            <dt>Light</dt>
                            <dd>@Labels.For(light)</dd>
                        }

                        <dt>Grows in</dt>
                        <dd>
                            @Labels.For(plant.Medium)
                            @if (PotName(plant.InnerPotId) is { } inner)
                            {
                                <text> · </text>@PotPhotoFor(plant.InnerPotId)@inner
                            }

                            @if (PotName(plant.OuterPotId) is { } outer)
                            {
                                <div class="detail-sub">
                                    Standing in @PotPhotoFor(plant.OuterPotId)@outer@(plant.WaterInOuterPot ? ", with water kept in it" : "")
                                </div>
                            }

                            @if (Mix is { } mix)
                            {
                                <div class="detail-sub">In @mix.Name@(mix.IsRetired ? " (no longer mixed)" : "")</div>
                                @if (!string.IsNullOrWhiteSpace(mix.Recipe))
                                {
                                    <div class="detail-sub">@mix.Recipe</div>
                                }
                            }
                        </dd>

                        @if (WateringFeed is { } wateringFeed)
                        {
                            <dt>Feed with the watering</dt>
                            <dd>@wateringFeed.Name, @(plant.WateringFeedEvery switch { 2 => "every second watering", 3 => "every third watering", _ => "every watering" })</dd>
                        }

                        @if (plant.QuarantinedSince is { } quarantinedSince)
                        {
                            <dt>Quarantine</dt>
                            <dd>@(quarantinedSince == Today ? "Since today" : $"Since {Labels.Date(quarantinedSince)}") · day @(plant.DaysInQuarantine(Today) ?? 0) of @(plant.QuarantineDays ?? Plant.DefaultQuarantineDays)</dd>
                        }

                        @if (lastChecked is { } checkedOn)
                        {
                            <dt>Checked for pests</dt>
                            <dd>@Checked(checkedOn)</dd>
                        }

                        @if (plant.DormantSince is { } dormantSince)
                        {
                            <dt>Dormant</dt>
                            <dd>@(dormantSince == Today ? "Since today" : $"Since {Labels.Date(dormantSince)} · {Labels.Count(plant.DaysDormant(Today) ?? 0, "day")}")</dd>
                        }

                        @if (plant.Tags.Count > 0)
                        {
                            <dt>Tags</dt>
                            <dd class="detail-tags">
                                @foreach (var tag in plant.Tags)
                                {
                                    <a class="tag-label" href="@TagLink(tag)">@tag</a>
                                }
                            </dd>
                        }

                        <PublicPageRow SubjectId="plant.Id" />
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(plant.Notes))
                    {
                        <h2>About it</h2>
                        <p class="detail-notes">@plant.Notes</p>
                    }
                </section>

                @if (pests.Count > 0)
                {
                    <section class="detail-card">
                        <h2>Pests</h2>
                        <ul class="family-list">
                            @foreach (var item in pests)
                            {
                                <li>
                                    <a href="pests/@item.Id">@Labels.For(item.Pest)</a>
                                    <span class="text-body-secondary small">
                                        · @Labels.For(item.Status).ToLowerInvariant() since @Labels.Date(item.StartedOn)
                                    </span>
                                </li>
                            }
                        </ul>
                        <p class="family-hint">Treatments are logged on the case, because a case is treated as a whole.</p>
                    </section>
                }

                @if (flowerings.Count > 0)
                {
                    <section class="detail-card">
                        <h2>Flowering</h2>
                        @if (usualStart is { } usual)
                        {
                            <p class="flowering-usually">
                                Usually starts by @(FloweringText.MonthName(usual.Month)).@(usual.LateThisYear ? " Nothing yet this year." : "")
                                <span class="text-body-secondary small">From @Labels.Count(usual.Years, "year")</span>
                            </p>
                        }
                        <ul class="flowering-rows">
                            @foreach (var period in flowerings.Reverse())
                            {
                                var shown = period;
                                <li>
                                    <button type="button" class="flowering-row" @onclick="() => OpenPeriod(shown)">
                                        <b>@shown.Start.Year</b>
                                        <span>@FloweringText.Describe(shown)</span>
                                    </button>
                                </li>
                            }
                        </ul>
                        <p class="family-hint">
                            <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenPastFlowering">Add a past flowering</button>
                            <a class="btn btn-link btn-sm link-action" href="plants/flowering">See the flowering calendar</a>
                        </p>
                    </section>
                }

                <section class="detail-card" id="plant-family">
                    <h2>Family</h2>
                    @if (HasFamily)
                    {
                        <p class="family-tree-link"><a class="link-action" href="plants/@plant.Id/family">See the family tree</a></p>
                    }
                    @if (ancestors.Count > 0 || fromPropagation is not null)
                    {
                        <h3>Came from</h3>
                        <ul class="family-list">
                            @if (fromPropagation is not null)
                            {
                                <li>
                                    <a href="propagations/@fromPropagation.Id">@Labels.For(fromPropagation.Type)</a>
                                    <span class="text-body-secondary small"> · started @Labels.Date(fromPropagation.StartedOn)</span>
                                </li>
                            }
                            @foreach (var ancestor in ancestors)
                            {
                                <li><a href="plants/@ancestor.Id">@ancestor.DisplayName</a></li>
                            }
                        </ul>
                    }
                    @if (propagations.Count > 0)
                    {
                        <h3>Propagations (@propagations.Count)</h3>
                        <ul class="item-list">
                            @foreach (var propagation in propagations)
                            {
                                <li><PropagationCard Propagation="propagation" ShowStage="true" /></li>
                            }
                        </ul>
                    }
                    @if (offspring.Count > 0)
                    {
                        <h3>Plants grown from it (@offspring.Count)</h3>
                        <ul class="family-list">
                            @foreach (var child in offspring)
                            {
                                <li>
                                    <a href="plants/@child.Id">@child.DisplayName</a>
                                    @if (child.Status != PlantStatus.Active)
                                    {
                                        <span class="text-body-secondary small"> · @Labels.For(child.Status)</span>
                                    }
                                    @if (child.HasLeft && !string.IsNullOrWhiteSpace(child.LeftTo))
                                    {
                                        <span class="text-body-secondary small"> · @(child.Status == PlantStatus.Sold ? "sold to" : "given to") @child.LeftTo</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    <p class="family-hint">
                        Took a cutting? <a href="propagations/new?parent=@plant.Id">Start a propagation</a> and follow it until it has rooted.
                        Already rooted and potted on its own? <a href="plants/new?parent=@plant.Id">Add it straight away as a plant</a>.
                    </p>
                </section>

                <p class="family-hint">
                    Got another one just like it?
                    <a href="plants/new?copy=@plant.Id">Add another like this</a>, with the same names, room and growing setup.
                </p>

                <section class="danger-zone">
                    @if (confirmDelete)
                    {
                        <p class="mb-2">Delete <strong>@plant.DisplayName</strong>? If it died or you gave it away, use the three dots next to Photo and Note to say so instead, so its history is kept.</p>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">Delete</button>
                        <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">Delete plant</button>
                    }
                </section>
            </div>
        </div>

        <div class="profile-history">
            <div class="page-dock" role="group" aria-label="Add to @plant.DisplayName">
                @if (googleOn)
                {
                    <button type="button" class="btn btn-primary icon-btn" @onclick="() => photoChoice = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Photo
                    </button>
                }
                else
                {
                    <label class="btn btn-primary icon-btn" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Photo
                    </label>
                }
                <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => composer?.OpenNote()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                    Note
                </button>
                @if (plant.Status == PlantStatus.Active)
                {
                    <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => careOpen = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10Z" /></svg>
                        Care
                    </button>
                }
                <button type="button" class="btn btn-outline-primary dock-more" aria-label="More for this plant" @onclick="() => OpenMore(More.Menu)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg>
                </button>
            </div>

            @if (Arrived)
            {
                <ArrivedNote SubjectId="plant.Id" />
            }

            <Timeline @key="historyVersion" @ref="timeline" SubjectType="SubjectType.Plant" SubjectId="plant.Id"
                      CoverPhotoId="plant.CoverPhotoId" OnCoverChanged="SetCoverAsync" PhotoAge="day => PhotoDayCount.PlantAge(plant, day)"
                      EmptyText="No photos or notes yet. Add the first one with Photo or Note." />
        </div>
    </div>

    <EntryComposer @key="plant.Id" @ref="composer" SubjectType="SubjectType.Plant" SubjectId="plant.Id" PhotoInputId="@photoInputId"
                   CoverPhotoId="plant.CoverPhotoId" OnCoverChanged="SetCoverAsync" OnAdded="() => historyVersion++" />

    @if (googleOn)
    {
        <Sheet Title="Add a photo" Open="photoChoice" OpenChanged="open => photoChoice = open">
            <ul class="sheet-actions">
                <li>
                    <label class="sheet-action" for="@photoInputId" @onclick="() => photoChoice = false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        <span class="sheet-action-text"><b>From this phone</b><small>Camera or gallery</small></span>
                    </label>
                </li>
                <li>
                    <button type="button" class="sheet-action" @onclick="PickFromGoogleAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                        <span class="sheet-action-text"><b>From Google Photos</b><small>Including photos only in the cloud</small></span>
                    </button>
                </li>
            </ul>
        </Sheet>
    }

    <Sheet Title="Care" @bind-Open="careOpen">
        <div class="sheet-section">
            @if (care.Count == 0)
            {
                <p class="text-body-secondary mb-0">Nothing logged yet. Log the first watering or feed below.</p>
            }
            else
            {
                <dl class="detail-list">
                    @foreach (var (kind, last) in headline)
                    {
                        <dt>@Labels.For(kind)</dt>
                        <dd>@(last is null ? "Never" : $"{Labels.DaysAgo(last.DaysAgo)} · {Labels.Date(last.On)}")</dd>
                    }
                </dl>
            }
            @if (moisture is { } reading)
            {
                <p class="care-moisture mb-0">Moisture @reading.Value/10, @Labels.DaysAgo(reading.DaysAgo)</p>
            }
        </div>

        <div class="sheet-section">
            <CareSheet PlantIds="@(new[] { plant.Id })" OnLogged="CareLoggedAsync" />
        </div>

        @if (careCalendar is { IsEmpty: false })
        {
            <div class="sheet-section">
                <h3 class="section-label">The last year</h3>
                <CareYear Calendar="careCalendar" />
            </div>
        }

        @if (care.Count > 0)
        {
            <div class="sheet-section">
                <h3 class="section-label">History</h3>
                <ul class="care-list">
                    @foreach (var entry in care)
                    {
                        <li>
                            <div class="care-entry">
                                <span class="care-what">@CareService.Describe(entry, Labels.For)</span>
                                <span class="care-when">@Labels.Date(entry.OccurredOn)</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </Sheet>

    <ShareSheet Open="shareOpen" OpenChanged="open => shareOpen = open" Tone="plant" SubjectId="plant.Id"
                Plant="plant" FromPropagation="fromPropagation" StartOnLink="shareOnLink"
                CoverPhotoId="plant.CoverPhotoId" PhotoAge="day => PhotoDayCount.PlantAge(plant, day)" Text="ShareCardText.ForPlant(plant, ancestors.FirstOrDefault(), fromPropagation, propagations, Today)" />

    <Sheet Title="@MoreTitle" Open="more != More.None" OpenChanged="open => { if (!open) more = More.None; }">
        @switch (more)
        {
            case More.Menu:
                <ul class="sheet-actions">
                    @if (plant.Status == PlantStatus.Active)
                    {
                        <li>
                            <a class="sheet-action" href="propagations/new?parent=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6.5" r="2.5" /><circle cx="6" cy="17.5" r="2.5" /><path d="M8.2 7.8 19 17M8.2 16.2 19 7" /></svg>
                                <span class="sheet-action-text"><b>Propagate</b><small>Took a cutting, a pup or a leaf</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => more = More.Flag">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4" /><path d="M5 4h12l-2.5 4.5L17 13H5" /></svg>
                                <span class="sheet-action-text"><b>@(plant.Attention is null ? "Flag it" : "Change the flag")</b><small>Keeps it on Today until it's done</small></span>
                            </button>
                        </li>
                        <li>
                            @if (plant.IsDormant)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndDormancyAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
                                    <span class="sheet-action-text"><b>It's woken up</b><small>Dormant @DaysLabel(plant.DaysDormant(Today))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenDormant">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
                                    <span class="sheet-action-text"><b>Dormant</b><small>Resting, like an alocasia that dropped its leaves</small></span>
                                </button>
                            }
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenFlowering">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.2" /><path d="M12 9.800C10.600 7.500 10.600 5 12 3.500c1.400 1.500 1.400 4 0 6.300Z" /><path d="M12 14.200c1.400 2.300 1.400 4.800 0 6.300-1.400-1.500-1.400-4 0-6.300Z" /><path d="M9.800 12C7.500 10.600 5 10.600 3.500 12c1.500 1.400 4 1.400 6.300 0Z" /><path d="M14.200 12c2.300 1.400 4.800 1.400 6.300 0-1.500-1.400-4-1.400-6.300 0Z" /></svg>
                                <span class="sheet-action-text"><b>Flowering</b><small>@FloweringText.MenuHint(floweringNow, Today.Year)</small></span>
                            </button>
                        </li>
                        <li>
                            @if (plant.InQuarantine)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndQuarantineAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
                                    <span class="sheet-action-text"><b>End quarantine</b><small>In quarantine @DaysLabel(plant.DaysInQuarantine(Today))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenQuarantine">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" stroke-dasharray="3 2.5" /></svg>
                                    <span class="sheet-action-text"><b>Quarantine</b><small>Kept apart while you check it for pests</small></span>
                                </button>
                            }
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="OpenPestCheck">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 5 5" /><path d="m8 10.5 2 2 3.5-4" /></svg>
                                <span class="sheet-action-text"><b>Check for pests</b><small>Log that you looked it over</small></span>
                            </button>
                        </li>
                        <li>
                            <a class="sheet-action" href="pests/new?plant=@plant.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                                <span class="sheet-action-text"><b>Found pests</b><small>Open a case to keep track of the treatments</small></span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => OpenStatus(PlantStatus.GivenAway)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h12M12 7l5 5-5 5" /><path d="M20 5v14" /></svg>
                                <span class="sheet-action-text"><b>Gave it away or sold it</b><small>It leaves your collection, its history stays</small></span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="sheet-action danger" @onclick="() => OpenStatus(PlantStatus.Died)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-7" /><path d="M12 14c-1-4-4-6-8-6 0 4 3 7 8 6Z" /><path d="M12 14c2-3 4.5-4 8-3.5-.5 3.5-3.5 5-8 3.5Z" /><path d="M4 21h16" /></svg>
                                <span class="sheet-action-text"><b>It died</b><small>Its history stays, so you can see what happened</small></span>
                            </button>
                        </li>
                    }
                    else
                    {
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => OpenStatus(plant.Status)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                                <span class="sheet-action-text"><b>Change what happened</b><small>@Labels.For(plant.Status)</small></span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="sheet-action" disabled="@busy" @onclick="BackInCollectionAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H8M12 7l-5 5 5 5" /><path d="M4 5v14" /></svg>
                                <span class="sheet-action-text"><b>Back in the collection</b><small>It's yours again, or it wasn't gone after all</small></span>
                            </button>
                        </li>
                    }
                </ul>
                break;

            case More.PassOn:
                <PassOnPanel SubjectType="SubjectType.Plant" SubjectId="plant.Id" Name="@plant.DisplayName"
                             OnDone="() => more = More.None" OnChangePage="ChangePassOnPage" />
                break;

            case More.Flag:
                <AttentionPanel Current="plant.Attention" Later="plant.AttentionLater" NextRoundDay="nextRoundDay" Editing="true" EditingChanged="_ => more = More.None"
                                Suggestions="AttentionPanel.PlantReasons" OnSave="SetAttentionAsync" />
                break;

            case More.Dormant:
                <div class="mb-3">
                    <label class="form-label" for="dormant-since">Dormant since</label>
                    <input id="dormant-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    <div class="form-text">Resting rather than dead. It won't come up on Today to be checked until it wakes up.</div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetDormantAsync">Mark as dormant</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                </div>
                break;

            case More.Flowering when floweringSaved is not null:
                <p class="mb-3" role="status">@floweringSaved</p>
                <div class="form-actions">
                    @if (googleOn)
                    {
                        <button type="button" class="btn btn-primary" @onclick="AddFloweringPhoto">Add a photo</button>
                    }
                    else
                    {
                        <label class="btn btn-primary" for="@photoInputId" @onclick="() => more = More.None">Add a photo</label>
                    }
                    <button type="button" class="btn btn-outline-primary" @onclick="() => more = More.None">Close</button>
                </div>
                break;

            case More.Flowering when floweringPast:
                @if (PastErrors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                        @foreach (var error in PastErrors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }
                <div class="mb-3"><LooseDateInput @bind-Value="pastFlower" Today="Today" Label="In flower from" /></div>
                <div class="mb-3"><LooseDateInput @bind-Value="pastUntil" Today="Today" Label="Until (optional)" /></div>
                <div class="mb-1"><LooseDateInput @bind-Value="pastBuds" Today="Today" Label="Spike or buds from (optional)" /></div>
                <div class="form-text mb-3">A month is enough. Leave out what you don't remember.</div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || pastFlower is null || PastErrors.Count > 0)" @onclick="SavePastFloweringAsync">Add</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                </div>
                break;

            case More.Flowering:
                <div class="mb-3">
                    <label class="form-label" for="flowering-on">When</label>
                    <input id="flowering-on" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-actions mb-2">
                    @foreach (var (stage, index) in NextStages.Select((stage, index) => (stage, index)))
                    {
                        var chosen = stage;
                        <button type="button" class="btn @(index == 0 ? "btn-primary" : "btn-outline-primary")" disabled="@(busy || since > Today || since == default)"
                                @onclick="() => MarkFloweringAsync(chosen)">@FloweringText.StageLabel(stage)</button>
                    }
                </div>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="ShowPastForm">Add a past flowering</button>
                break;

            case More.ThisFlowering when viewing is not null:
                <ul class="flowering-marks">
                    @foreach (var mark in viewing.Marks.OrderBy(m => m.On.Start).ThenBy(m => m.CreatedAt))
                    {
                        var removing = mark;
                        <li>
                            <span>@FloweringText.StageLabel(mark.Stage!.Value) · @mark.On.Text()</span>
                            <button type="button" class="btn btn-link btn-sm link-action" disabled="@busy" @onclick="() => RemoveMarkAsync(removing)">Remove</button>
                        </li>
                    }
                </ul>
                <div class="form-actions mt-2">
                    <button type="button" class="btn btn-outline-primary" @onclick="() => more = More.None">Close</button>
                </div>
                break;

            case More.Quarantine:
                <div class="row g-2 mb-1">
                    <div class="col-7">
                        <label class="form-label" for="quarantine-since">Since</label>
                        <input id="quarantine-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-5">
                        <label class="form-label" for="quarantine-days">For how many days</label>
                        <input id="quarantine-days" type="number" class="form-control" min="1" max="365" inputmode="numeric" @bind="quarantineDays" />
                    </div>
                </div>
                <div class="form-text mb-3">Today says when it's time to check the plant and let it out.</div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || quarantineDays is < 1 or > 365)" @onclick="SetQuarantineAsync">Put in quarantine</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                </div>
                break;

            case More.PestCheck:
                <div class="mb-3">
                    <label class="form-label" for="pest-check-on">Checked on</label>
                    <input id="pest-check-on" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pest-check-notes">Notes <span class="text-body-secondary">(optional)</span></label>
                    <textarea id="pest-check-notes" class="form-control" rows="2" @bind="checkNotes"></textarea>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@(busy || since > Today)" @onclick="SavePestCheckAsync">No signs</button>
                    <a class="btn btn-link link-action" href="pests/new?plant=@plant.Id">Found some</a>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                </div>
                break;

            case More.Status:
                @if (status != PlantStatus.Died)
                {
                    <div class="btn-group segmented mb-3" role="radiogroup" aria-label="What happened">
                        @foreach (var choice in new[] { PlantStatus.GivenAway, PlantStatus.Sold })
                        {
                            var id = $"left-{choice}";
                            <input type="radio" class="btn-check" name="left-how" id="@id" checked="@(status == choice)" @onchange="() => status = choice" />
                            <label class="btn btn-outline-primary" for="@id">@Labels.For(choice)</label>
                        }
                    </div>
                }
                @if (status == PlantStatus.Died)
                {
                    <div class="mb-3">
                        <label class="form-label" for="cause-of-death">What happened? <span class="text-body-secondary">(optional)</span></label>
                        <input id="cause-of-death" class="form-control" @bind="causeOfDeath" placeholder="e.g. root rot after repotting" />
                    </div>
                }
                else
                {
                    var sold = status == PlantStatus.Sold;
                    <div class="mb-3">
                        <label class="form-label" for="left-to">@(sold ? "Who bought it?" : "Who got it?") <span class="text-body-secondary">(optional)</span></label>
                        <input id="left-to" class="form-control" @bind="leftTo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="left-for">@(sold ? "Sold for" : "Swapped for?") <span class="text-body-secondary">(optional)</span></label>
                        <input id="left-for" class="form-control" @bind="leftFor" placeholder="@(sold ? "e.g. 150 kr" : "e.g. a Hoya carnosa")" />
                    </div>
                    @if (Labels.PotsTakenChoices([plant]) is { Count: > 0 } choices)
                    {
                        <div class="mb-3">
                            <span class="form-label d-block" id="pots-taken">What went with it</span>
                            <div class="btn-group segmented" role="radiogroup" aria-labelledby="pots-taken">
                                @foreach (var (value, label) in choices)
                                {
                                    var id = $"taken-{value}";
                                    <input type="radio" class="btn-check" name="pots-taken" id="@id"
                                           checked="@(plant.Fit(potsTaken) == value)" @onchange="() => potsTaken = value" />
                                    <label class="btn btn-outline-primary" for="@id">@label</label>
                                }
                            </div>
                            <div class="form-text">A pot that went with it no longer counts as yours. One left here is free again.</div>
                        </div>
                    }
                }
                <div class="form-actions">
                    <button type="button" class="btn @(status == PlantStatus.Died ? "btn-danger" : "btn-primary")" disabled="@busy" @onclick="SaveStatusAsync">@StatusButtonText</button>
                    <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                </div>
                break;
        }
    </Sheet>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Set by the page that keeps a received history, so the first visit says where it went.</summary>
    [SupplyParameterFromQuery(Name = "arrived")]
    public bool Arrived { get; set; }

    /// <summary>
    /// Older links name a tab: "props" opens the details at its propagations and "care" opens
    /// the care sheet. The history is the page itself now.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private enum More { None, Menu, Flag, Dormant, Quarantine, PestCheck, Status, PassOn, Flowering, ThisFlowering }
    private bool shareOpen;
    private bool shareOnLink;

    private Plant? plant;
    private bool loaded;
    private bool confirmDelete;
    private bool detailsOpen;
    private bool careOpen;
    private bool busy;
    private bool scrollToFamily;
    private More more;
    private int historyVersion;
    private EntryComposer? composer;
    private bool googleOn;
    private bool photoChoice;
    private Timeline? timeline;
    private readonly string photoInputId = $"plant-photo-{Guid.NewGuid():N}";

    // The small forms in the More sheet
    private DateOnly since;
    private int? quarantineDays;
    private PlantStatus status;
    private string? causeOfDeath;
    private string? leftTo;
    private string? leftFor;
    private PotsTaken potsTaken;

    private IReadOnlyList<Plant> ancestors = [];
    private IReadOnlyList<Plant> offspring = [];
    private PlantGiven given = new([], 0, 0, 0, 0);
    private IReadOnlyList<Propagation> propagations = [];
    private Propagation? fromPropagation;
    private IReadOnlyList<CareLog> care = [];
    private IReadOnlyList<(CareKind Kind, LastCare? Last)> headline = [];
    private MoistureReading? moisture;
    private CareCalendar? careCalendar;
    private IReadOnlyList<PestCase> pests = [];
    private DateOnly? lastChecked;
    private string? checkNotes;
    private string? actionNote;
    private Places places = Places.None;
    private IReadOnlyList<Pot> pots = [];

    // Flowering
    private IReadOnlyList<FloweringPeriod> flowerings = [];
    private FloweringNow? floweringNow;
    private UsualStart? usualStart;
    private string? floweringSaved;
    private bool floweringPast;
    private LooseDate? pastBuds;
    private LooseDate? pastFlower;
    private LooseDate? pastUntil;
    private FloweringPeriod? viewing;

    private IReadOnlyList<string> PastErrors =>
        pastFlower is null ? [] : FloweringService.PastErrors(pastBuds, pastFlower, pastUntil);

    private IReadOnlyList<FloweringStage> NextStages => floweringNow?.Stage switch
    {
        FloweringStage.Buds => [FloweringStage.InFlower, FloweringStage.Done],
        FloweringStage.InFlower => [FloweringStage.Done],
        _ => [FloweringStage.Buds, FloweringStage.InFlower]
    };
    private IReadOnlyDictionary<Guid, Photo> potCovers = new Dictionary<Guid, Photo>();
    private IReadOnlyList<SoilMix> mixes = [];

    private string? wateringLine;

    private IReadOnlyList<Feed> feeds = [];

    /// <summary>The feed given with the water, or null when it is off or the feed is gone.</summary>
    private Feed? WateringFeed => plant?.WateringFeedId is { } id ? feeds.FirstOrDefault(f => f.Id == id) : null;

    private SoilMix? Mix => plant?.SoilMixId is { } id ? mixes.FirstOrDefault(m => m.Id == id) : null;

    private string? PotName(Guid? id) =>
        id is { } potId ? pots.FirstOrDefault(p => p.Id == potId)?.DisplayName : null;

    /// <summary>The pot's photo before its name, when it has one.</summary>
    private RenderFragment? PotPhotoFor(Guid? id) =>
        id is { } potId && pots.FirstOrDefault(p => p.Id == potId) is { } pot && potCovers.GetValueOrDefault(potId) is { } cover
            ? @<PotPhoto Pot="pot" Cover="cover" />
            : null;

    private DateOnly Today => Time.Today();

    private bool HasFamily => ancestors.Count > 0 || fromPropagation is not null || propagations.Count > 0 || offspring.Count > 0;

    // The one line under the name: where it is, what it grows in, and when it was last watered
    private IEnumerable<string> Facts
    {
        get
        {
            if (places.NameOf(plant!.PlaceId) is { } place)
                yield return place;
            yield return PotName(plant.InnerPotId) is { } pot ? $"{Labels.For(plant.Medium)} in {pot}" : $"in {MediumWord(plant.Medium)}";
            if (plant.Status == PlantStatus.Active && headline.FirstOrDefault(h => h.Kind == CareKind.Watered).Last is { } watered)
                yield return $"watered {Labels.DaysAgo(watered.DaysAgo)}";
        }
    }

    // "soil" in the middle of a line, but LECA and PON stay in capitals
    private static string MediumWord(GrowingMedium medium) => Labels.MediumWord(medium);

    // "a cutting", but "an offset / pup" and "an air layer"
    private static string TypeWithArticle(PropagationType type) =>
        Labels.For(type).ToLowerInvariant() is var word && "aeiou".Contains(word[0]) ? $"an {word}" : $"a {word}";

    private string StatusButtonText => status switch
    {
        PlantStatus.Died => "Mark as died",
        PlantStatus.Sold => "Mark as sold",
        _ => "Mark as given away",
    };

    private string MoreTitle => more switch
    {
        More.Flag => plant?.Attention is null ? "Flag it" : "Change the flag",
        More.Dormant => "Dormant",
        More.Flowering when floweringPast && floweringSaved is null => "Add a past flowering",
        More.Flowering => "Flowering",
        More.ThisFlowering => "This flowering",
        More.Quarantine => "Quarantine",
        More.PestCheck => "Check for pests",
        More.Status when status == PlantStatus.Died => "It died",
        More.Status => "It left",
        More.PassOn => "Send its history",
        _ => plant?.DisplayName ?? "",
    };

    private async Task PickFromGoogleAsync()
    {
        photoChoice = false;
        if (composer is not null)
            await composer.PickFromGooglePhotos();
    }

    protected override async Task OnParametersSetAsync()
    {
        googleOn = await Google.IsEnabledAsync();
        if (plant?.Id != Id)
        {
            confirmDelete = false;
            more = More.None;
            careOpen = false;
            detailsOpen = false;
        }
        detailsOpen |= Tab == "props";
        scrollToFamily |= Tab == "props";
        careOpen |= Tab == "care";
        await LoadAsync();
        loaded = true;
    }

    private EverydayNameBook? everyday;

    private IReadOnlyList<RecentChange> recentChanges = [];

    // "Repotted 6 days ago, moved to Hall 3 days ago": only what happened, never what it means
    private string RecentChangesText =>
        string.Join(", ", recentChanges.Select((change, i) =>
        {
            var when = Labels.DaysAgo(Today.DayNumber - change.Day.DayNumber);
            var text = change.Kind switch
            {
                RecentChangeKind.Arrived => $"arrived {when}",
                RecentChangeKind.Repotted => $"repotted {when}",
                _ => places.NameOf(plant!.PlaceId) is { } place ? $"moved to {place} {when}" : $"moved {when}"
            };
            return i == 0 ? char.ToUpperInvariant(text[0]) + text[1..] : text;
        }));

    // "6 cuttings and 2 leaves taken, 5 rooted · 2 given away and 1 sold"
    private IEnumerable<string> GivenParts
    {
        get
        {
            if (given.Taken > 0)
                yield return $"{TakenText()} taken, {given.Rooted} rooted";
            if (given.GivenAway + given.Sold > 0)
                yield return PassedOnText();
            if (given.FromThoseInTurn > 0)
                yield return $"{Labels.Count(given.FromThoseInTurn, "plant")} grown from those in turn";
        }
    }

    private string TakenText() => JoinAnd(given.TakenByType.Select(t => t.Key switch
    {
        PropagationType.Offset => Labels.Count(t.Value, "pup"),
        PropagationType.Leaf => Labels.Count(t.Value, "leaf", "leaves"),
        PropagationType.AirLayer => Labels.Count(t.Value, "air layer"),
        PropagationType.Other => Labels.Count(t.Value, "other", "others"),
        _ => Labels.Count(t.Value, Labels.For(t.Key).ToLowerInvariant())
    }));

    private string PassedOnText() => JoinAnd(new[]
    {
        given.GivenAway > 0 ? $"{given.GivenAway} given away" : null,
        given.Sold > 0 ? $"{given.Sold} sold" : null
    }.OfType<string>());

    /// <summary>"a", "a and b", "a, b and c".</summary>
    private static string JoinAnd(IEnumerable<string> parts)
    {
        var list = parts.ToList();
        return list.Count <= 1 ? string.Concat(list) : $"{string.Join(", ", list.SkipLast(1))} and {list[^1]}";
    }

    private async Task LoadAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        var all = await Repository.GetAllAsync();
        plant = all.FirstOrDefault(p => p.Id == Id);
        if (plant is not null)
        {
            ancestors = PlantLineage.Ancestors(plant, all);
            offspring = PlantLineage.Offspring(plant, all);

            var allPropagations = await PropagationRepository.GetAllAsync();
            given = PlantLineage.Given(plant, all, allPropagations);
            propagations = new PropagationFilter(Progress: ProgressFilter.All)
                .Apply(allPropagations.Where(p => p.ParentPlantId == plant.Id))
                .ToList();
            fromPropagation = allPropagations.FirstOrDefault(p => p.Id == plant.FromPropagationId);

            places = await RoomService.GetPlacesAsync();
            var allCases = await PestCaseRepository.GetAllAsync();
            pests = PestService.CasesFor(plant, allCases, places);
            lastChecked = PestService.LastChecked(plant, allCases, await PestTreatmentRepository.GetAllAsync(), places);
            pots = await PotRepository.GetAllAsync();
            potCovers = await PotService.GetCoversAsync();
            mixes = await MixRepository.GetAllAsync();
            feeds = await FeedRepository.GetAllAsync();

            await ReloadCareAsync();
            await ReloadFloweringAsync();
        }
    }

    private async Task ReloadFloweringAsync()
    {
        if (plant is null)
            return;

        var marks = await FloweringService.ForPlantAsync(plant.Id);
        flowerings = Flowerings.Of(marks, plant.Id, Today);
        floweringNow = FloweringNow.Of(flowerings, Today);
        usualStart = UsualStart.Of(flowerings, Today);

        // The sheet listing one flowering's marks follows it as marks are removed
        if (viewing is not null)
        {
            var ids = viewing.Marks.Select(m => m.Id).ToHashSet();
            viewing = flowerings.FirstOrDefault(f => f.Marks.Any(m => ids.Contains(m.Id)));
            if (viewing is null && more == More.ThisFlowering)
                more = More.None;
        }
    }

    private void OpenFlowering()
    {
        since = Today;
        floweringSaved = null;
        floweringPast = false;
        more = More.Flowering;
    }

    private void OpenPastFlowering()
    {
        OpenFlowering();
        ShowPastForm();
    }

    private void ShowPastForm()
    {
        pastBuds = pastFlower = pastUntil = null;
        floweringPast = true;
        more = More.Flowering;
    }

    private void OpenPeriod(FloweringPeriod period)
    {
        viewing = period;
        more = More.ThisFlowering;
    }

    private async Task MarkFloweringAsync(FloweringStage stage)
    {
        busy = true;
        try
        {
            await FloweringService.MarkAsync(plant!, stage, since);
            floweringSaved = FloweringText.Marked(stage);
            historyVersion++;
            await ReloadFloweringAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePastFloweringAsync()
    {
        if (pastFlower is null || PastErrors.Count > 0)
            return;

        busy = true;
        try
        {
            await FloweringService.AddPastAsync(plant!, pastBuds, pastFlower, pastUntil);
            more = More.None;
            floweringPast = false;
            await ReloadFloweringAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task StillFloweringAsync()
    {
        if (floweringNow is null)
            return;

        busy = true;
        try
        {
            await FloweringService.StillAsync(plant!, floweringNow.Stage);
            await ReloadFloweringAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // A removed mark can be marked again, so there is nothing to confirm
    private async Task RemoveMarkAsync(FloweringMark mark)
    {
        busy = true;
        try
        {
            await FloweringService.RemoveAsync(mark);
            historyVersion++;
            await ReloadFloweringAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void AddFloweringPhoto()
    {
        more = More.None;
        photoChoice = true;
    }

    private async Task ReloadCareAsync()
    {
        if (plant is null)
            return;

        var all = await CareLogRepository.GetAllAsync();
        care = CareSummary.For(all, plant.Id);
        // Always show the headline kinds, even the ones never done, so "never flushed" is visible
        headline = CareSummary.Headline
            .Select(kind => (kind, CareSummary.Latest(all, plant.Id, kind, Today)))
            .ToList();
        moisture = CareSummary.LatestMoisture(all, plant.Id, Today);
        careCalendar = CareCalendar.Build(all, plant.Id, Today);
        await ReloadWateringLineAsync(all);
        recentChanges = RecentChanges.Of(
            plant, all, await TimelineRepository.GetPlantChangesAsync(), Today,
            RecentChanges.DaysOf((await SettingsService.GetAsync()).RecentChangesDays), Time.LocalDay);
        nextRoundDay = RoundSchedule.Next((await SettingsService.GetAsync()).RoundDays, Today);
    }

    // Only said when the reminder is on for the collection and for this plant
    private async Task ReloadWateringLineAsync(IReadOnlyList<CareLog> allCare)
    {
        wateringLine = null;
        if (plant is not { Status: PlantStatus.Active, WateringReminder: true }
            || !(await SettingsService.GetAsync()).WateringReminder)
            return;

        var guess = WateringRound.GuessFor(
            plant, await Repository.GetAllAsync(), allCare, await TimelineRepository.GetPlantChangesAsync(),
            id => pots.FirstOrDefault(p => p.Id == id), await LightService.GetAllAsync(), places,
            await AwayService.GetAllAsync(), Seasons.HemisphereOf(TimeZoneInfo.Local), Time);
        wateringLine = WateringText.Summary(guess);
    }

    private async Task CareLoggedAsync()
    {
        await ReloadCareAsync();
        careOpen = false;
    }

    private void ShowCuttings()
    {
        detailsOpen = true;
        scrollToFamily = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToFamily || plant is null)
            return;
        scrollToFamily = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("scrollToId", "plant-family");
    }

    private static string DaysLabel(int? days) => days is null or 0 ? "since today" : $"for {Labels.Count(days.Value, "day")}";

    private void OpenMore(More what) => more = what;

    private void OpenDormant()
    {
        since = Today;
        more = More.Dormant;
    }

    private async Task OpenQuarantine()
    {
        since = Today;
        quarantineDays = plant?.QuarantineDays
            ?? (await SettingsService.GetAsync()).QuarantineDays ?? Plant.DefaultQuarantineDays;
        more = More.Quarantine;
    }

    private void OpenPestCheck()
    {
        since = Today;
        checkNotes = null;
        more = More.PestCheck;
    }

    private string Checked(DateOnly day)
    {
        var ago = Math.Max(0, Today.DayNumber - day.DayNumber);
        return ago <= 1 ? char.ToUpperInvariant(Labels.DaysAgo(ago)[0]) + Labels.DaysAgo(ago)[1..] : $"{Labels.Date(day)} · {Labels.DaysAgo(ago)}";
    }

    private async Task SavePestCheckAsync()
    {
        var entry = PestService.StartPlantCheck(plant!, since);
        entry.Notes = string.IsNullOrWhiteSpace(checkNotes) ? null : checkNotes.Trim();
        if (entry.Validate(Today).Count > 0)
            return;

        busy = true;
        try
        {
            await PestTreatmentRepository.SaveAsync(entry);
            more = More.None;
            actionNote = "Checked for pests, no signs.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenStatus(PlantStatus to)
    {
        status = to;
        causeOfDeath = plant!.CauseOfDeath;
        leftTo = plant.LeftTo;
        leftFor = plant.LeftFor;
        potsTaken = plant.PotsTaken;
        more = More.Status;
    }

    private async Task SetCoverAsync(Guid? photoId)
    {
        if (plant is null || plant.CoverPhotoId == photoId)
            return;
        plant.CoverPhotoId = photoId;
        await Repository.SaveAsync(plant);
    }

    private async Task ToggleFavouriteAsync()
    {
        if (plant is null)
            return;
        await PlantService.SetFavouriteAsync(plant, !plant.Favourite);
    }

    private string TagLink(string tag) => $"plants?tag={Uri.EscapeDataString(tag)}";

    private DateOnly? nextRoundDay;

    private async Task SetAttentionAsync((string? Reason, LooseDate? From) change)
    {
        if (plant is null)
            return;
        await PlantService.SetAttentionAsync(plant, change.Reason, change.From);
    }

    // Each change goes on the history, like it does from the edit form
    private async Task ChangeAsync(Func<Task> change)
    {
        busy = true;
        try
        {
            await change();
            more = More.None;
            historyVersion++;
        }
        finally
        {
            busy = false;
        }
    }

    private Task EndQuarantineAsync() =>
        ChangeAsync(() => PlantService.SetQuarantineAsync(plant!, null, Labels.For));

    private Task EndDormancyAsync() =>
        ChangeAsync(() => PlantService.SetDormantAsync(plant!, null, Labels.For));

    private Task SetDormantAsync() =>
        ChangeAsync(() => PlantService.SetDormantAsync(plant!, since, Labels.For));

    private Task SetQuarantineAsync() => ChangeAsync(async () =>
    {
        plant!.QuarantineDays = quarantineDays;
        await PlantService.SetQuarantineAsync(plant, since, Labels.For);
    });

    private void OpenShare()
    {
        shareOnLink = false;
        shareOpen = true;
    }

    // From the offer to send its history: the Share sheet opens on the link, to change what the page shows
    private void ChangePassOnPage()
    {
        more = More.None;
        shareOnLink = true;
        shareOpen = true;
    }

    // Giving it away or selling it offers to send its history right away, where links are available
    private async Task SaveStatusAsync()
    {
        await SaveStatusChangesAsync();
        if (plant is { HasLeft: true } && Account.IsAvailable)
            more = More.PassOn;
    }

    private Task SaveStatusChangesAsync() => ChangeAsync(async () =>
    {
        var before = plant!.Copy();
        plant.Status = status;
        plant.CauseOfDeath = causeOfDeath;
        plant.LeftTo = leftTo;
        plant.LeftFor = leftFor;
        plant.PotsTaken = potsTaken;
        await PlantService.UpdateAsync(before, plant, Labels.For);
    });

    private Task BackInCollectionAsync() => ChangeAsync(async () =>
    {
        var before = plant!.Copy();
        plant.Status = PlantStatus.Active;
        await PlantService.UpdateAsync(before, plant, Labels.For);
    });

    private async Task DeleteAsync()
    {
        await Repository.DeleteAsync(Id);
        Navigation.NavigateTo("plants", replace: true);
    }
}
