    // These change other plants too, so the page is read again after
    private async Task SaveChangeAsync(Func<Task> change)
    {
        await ChangeAsync(async () =>
        {
            try
            {
                await change();
            }
            catch (InvalidOperationException ex)
            {
                actionNote = F(Strings.PlantDetail.CouldntSave, ex.Message);
                return;
            }
            actionNote = null;
        });
        await LoadAsync();
    }

    private Task PotTogetherAsync() => SaveChangeAsync(async () =>
