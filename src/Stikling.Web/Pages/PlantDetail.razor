    private async Task LoadAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        careBook = await CommonCare.GetBookAsync();
        await Covers.EnsureLoadedAsync();
        var all = await Repository.GetAllAsync();
        plant = all.FirstOrDefault(p => p.Id == Id);
        if (plant is not null)
        {
            allPlants = all;
            // One step only: a merge can leave two plants potted with each other
            pottedWithPlant = plant.PottedWithPlantId is { } withId && withId != plant.Id ? all.FirstOrDefault(p => p.Id == withId) : null;
            pottedInHere = [.. all.Where(p => p.PottedWithPlantId == plant.Id && p.Id != plant.Id)
                                  .OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase)];
            ancestors = PlantLineage.Ancestors(plant, all);
            offspring = PlantLineage.Offspring(plant, all);

            var allPropagations = await PropagationRepository.GetAllAsync();
            given = PlantLineage.Given(plant, all, allPropagations);
            numberClashes = CollectionNumbers.Clashes(plant.CollectionNumber, plant.Id, all, allPropagations);
            propagations = new PropagationFilter(Progress: ProgressFilter.All)
                .Apply(allPropagations.Where(p => p.ParentPlantId == plant.Id))
                .ToList();
            fromPropagation = allPropagations.FirstOrDefault(p => p.Id == plant.FromPropagationId);
            earlierUntil = fromPropagation is null ? null : CarriedPhotos.PotUpDay(plant, await TimelineRepository.GetForAsync(plant.Id), Time);

            careFor = careBook.Find(plant.Genus, plant.Species, plant.NameQualifier);
            places = await RoomService.GetPlacesAsync();
            sellers = await SellerService.GetSellersAsync();
            ownFields = await OwnFieldBook.GetAllAsync();
            var allCases = await PestCaseRepository.GetAllAsync();
            pests = PestService.CasesFor(plant, allCases, places);
            lastChecked = PestService.LastChecked(plant, allCases, await PestTreatmentRepository.GetAllAsync(), places);
            pots = await PotRepository.GetAllAsync();
            potCovers = await PotService.GetCoversAsync();
            mixes = await MixRepository.GetAllAsync();
            feeds = await FeedRepository.GetAllAsync();

            await ReloadCareAsync();
            await ReloadFloweringAsync();
            await ReloadProblemsAsync();
        }
    }

    private IEnumerable<ProblemUpdate> UpdatesOf(Problem problem) => problemUpdates[problem.Id];

    private async Task ReloadProblemsAsync()
    {
        if (plant is null)
            return;

        var mine = await ProblemService.ForPlantAsync(plant.Id);
        var ids = mine.Select(p => p.Id).ToHashSet();
        problemUpdates = (await ProblemService.AllUpdatesAsync()).Where(u => ids.Contains(u.ProblemId)).ToLookup(u => u.ProblemId);
        openProblems = mine.Where(p => p.IsOpen).ToList();
        closedProblems = mine.Where(p => !p.IsOpen).OrderByDescending(p => p.ClosedOn).ThenByDescending(p => p.StartedOn).ToList();

        // The sheet for an update follows the problem, and goes if it is closed or gone
        if (updating is not null)
        {
            updating = openProblems.FirstOrDefault(p => p.Id == updating.Id);
            if (updating is null && more == More.ProblemUpdate)
                more = More.None;
        }
    }

