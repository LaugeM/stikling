    private async Task PotUpAsync()
    {
        if (propagation is null || potUp is not { CanSave: true } form)
            return;

        busy = true;
        try
        {
            var result = await form.SaveAsync();
            stageView = StageView.None;
            await LoadAsync();
            madePlants = result.Plants;
            if (result.LaterError is { } later)
            {
                Logger.LogError(later, "A step after potting up the propagation failed");
                // The plants were saved before the step that failed, so they are found by their ids
                madePlants = [.. allPlants.Where(p => form.PlantIds.Contains(p.Id))];
            }
            message = madePlants.Count == 1 ? Strings.Propagations.DetPottedUpOne : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPottedUpMany, madePlants.Count);
            historyVersion++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Potting up the propagation failed");
            madePlants = [];
            message = string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPotUpFailed, ex.Message);
            stageView = StageView.None;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task MarkFailedAsync()
    {
        if (propagation is null || failed is not { CountIsValid: true } form)
            return;

        busy = true;
        try
        {
            var result = await form.SaveAsync();
            // The counts were recorded on the copy the sheet saved, which a sync may have replaced on the page
            await LoadAsync();
            if (result.LaterError is { } later)
                Logger.LogError(later, "A step after marking units as failed failed");
            message = form.Count == 1 ? Strings.Propagations.DetMarkedFailedOne : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkedFailedMany, form.Count);
            historyVersion++;
            madePlants = [];
            stageView = StageView.None;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Marking units as failed failed");
            madePlants = [];
            message = string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkFailedFailed, ex.Message);
            stageView = StageView.None;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task GiveAwayAsync()
    {
        if (propagation is null || gave is not { CountIsValid: true } form)
            return;

        busy = true;
        try
        {
            var result = await form.SaveAsync();
            // The counts were recorded on the copy the sheet saved, which a sync may have replaced on the page
            await LoadAsync();
            if (result.LaterError is { } later)
                Logger.LogError(later, "A step after marking units as given away failed");
            message = form.Count == 1 ? Strings.Propagations.DetMarkedGivenOne : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkedGivenMany, form.Count);
            historyVersion++;
            madePlants = [];
            // Offers to send whoever got it the story, where links are available
            stageView = Account.IsAvailable ? StageView.PassOn : StageView.None;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Marking units as given away failed");
            madePlants = [];
            message = string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkGivenFailed, ex.Message);
            stageView = StageView.None;
        }
        finally
        {
            busy = false;
        }
    }

