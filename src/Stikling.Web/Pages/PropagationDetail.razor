@page "/propagations/{Id:guid}"
@layout WideLayout
@inject IPropagationRepository Repository
@inject PropagationCareService CareService
@inject ILogger<PropagationDetail> Logger
@inject IPlantRepository PlantRepository
@inject IPotRepository PotRepository
@inject ISoilMixRepository MixRepository
@inject PropagationService PropagationService
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@inject PlantNameService Names
@inject PlantCareService CommonCare
@inject GooglePhotosService Google
@inject AccountService Account
@inject SettingsService SettingsService
@using Stikling.Core.Propagations
@using Stikling.Core.Settings

<PageTitle>@(propagation?.DisplayName ?? "Propagation") · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="propagations">Propagations</a>

@if (propagation is null)
{
    <p class="text-body-secondary">@(loaded ? "That propagation doesn't exist or was deleted." : "Loading…")</p>
}
else
{
    @* On a wide screen these are two columns: who it is on the left, its history on the right *@
    <div class="profile-layout">
        <div class="profile-side">
            @if (propagation.CoverPhotoId is { } coverId)
            {
                <div class="detail-hero">
                    <button type="button" class="detail-hero-open" aria-label="Open the cover photo" @onclick="() => timeline?.OpenPhoto(coverId)">
                        <PhotoImage PhotoId="coverId" Thumbnail="false" Alt="@($"Photo of {propagation.DisplayName}")" />
                    </button>
                </div>
            }

            <header class="detail-header">
                @if (propagation.CoverPhotoId is null && propagation.IsActive)
                {
                    // With no photo to show, the tile shows how long it has been going instead
                    var days = propagation.DaysSinceStart(Today);
                    <div class="detail-icon day-tile">
                        <b>@days</b>
                        <small>@(days == 1 ? "day" : "days")</small>
                    </div>
                }
                else if (propagation.CoverPhotoId is null)
                {
                    <div class="detail-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M8 3h8l-1 6v9a3 3 0 0 1-6 0V9Z" /><path d="M12 12v4M12 16l-2 2M12 16l2 2" /></svg>
                    </div>
                }
                <div class="min-w-0">
                    @if (CollectionNumbers.Normalize(propagation.CollectionNumber) is { } number)
                    {
                        <div class="detail-number">#@number</div>
                    }
                    <h1>
                        @if (string.IsNullOrWhiteSpace(propagation.Nickname) && propagation.BotanicalName is not null)
                        {
                            <BotanicalName Genus="@propagation.Genus" Species="@propagation.Species" Cultivar="@propagation.Cultivar" Qualifier="@propagation.NameQualifier" Note="@propagation.NameNote" />
                        }
                        else
                        {
                            @propagation.DisplayName
                        }
                    </h1>
                    @if (!string.IsNullOrWhiteSpace(propagation.Nickname) && propagation.BotanicalName is not null)
                    {
                        <p class="detail-sub"><BotanicalName Genus="@propagation.Genus" Species="@propagation.Species" Cultivar="@propagation.Cultivar" Qualifier="@propagation.NameQualifier" Note="@propagation.NameNote" /></p>
                    }
                    else if (everyday?.For(propagation.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(propagation.Species, propagation.NameQualifier), propagation.Cultivar) is { } called)
                    {
                        <p class="detail-sub everyday-name">@called</p>
                    }
                    <NumberClashNote Code="@propagation.CollectionNumber" Clashes="numberClashes" />
                    <div class="profile-badges">
                        @if (propagation.IsDormant)
                        {
                            <span class="badge dormant-badge">Dormant</span>
                        }
                        @if (propagation.SpareAvailable > 0)
                        {
                            <a class="badge swap-badge" href="swap">@propagation.SpareAvailable to swap</a>
                        }
                        @if (!propagation.IsActive)
                        {
                            <span class="badge @(propagation.Stage == PropagationStage.Failed ? "text-bg-secondary" : "stage-badge")">@Labels.Stage(propagation.Stage)</span>
                        }
                    </div>
                </div>
            </header>

            @if (outcome is { } result)
            {
                <section class="outcome" aria-labelledby="outcome-title">
                    <h2 id="outcome-title" class="outcome-title">How it turned out</h2>
                    <dl class="outcome-figures">
                        @if (result.DaysRan is { } ran)
                        {
                            <div>
                                <dt>Ran for</dt>
                                <dd><b>@ran</b> @(ran == 1 ? "day" : "days")</dd>
                            </div>
                        }
                        @if (result.DaysToRoot is { } toRoot)
                        {
                            <div>
                                <dt>@(propagation.Type == PropagationType.Seed ? "First seedling" : "First root")</dt>
                                <dd>day <b>@toRoot</b></dd>
                            </div>
                        }
                        <div>
                            <dt>Potted up</dt>
                            <dd><b>@result.PottedUp</b> of @result.Started</dd>
                        </div>
                    </dl>
                    @if (result.GivenAway > 0)
                    {
                        <p class="outcome-given">@result.GivenAway given away.</p>
                    }
                    @if (result.Failed > 0)
                    {
                        <p class="outcome-failed">@result.Failed didn't make it.</p>
                    }
                    @if (result.Plants.Count > 0)
                    {
                        <ul class="outcome-plants">
                            @foreach (var made in result.Plants)
                            {
                                <li>
                                    <a href="plants/@made.Plant.Id">@made.Plant.DisplayName</a>
                                    <span class="text-body-secondary small">
                                        @(made.StillHere ? (made.Room ?? "In the collection") : Labels.For(made.Plant.Status))
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
            else if (propagation.IsActive)
            {
                <AttentionPanel Current="propagation.Attention" Later="propagation.AttentionLater" NextRoundDay="nextRoundDay" Editing="false" EditingChanged="_ => more = More.Flag"
                                Suggestions="AttentionPanel.PropagationReasons" OnSave="SetAttentionAsync" />
            }

            <p class="profile-facts">
                @Labels.Summary(propagation)
                @if (propagation.IsActive && !(TileShowsDays && propagation.DaysSinceStart(Today) > 0))
                {
                    <text> · @Labels.Age(propagation, Today)</text>
                }
                @if (places.NameOf(propagation.PlaceId) is { } place)
                {
                    <text> · @place</text>
                }
                @if (propagation.IsActive && LastCare is { } lastCare)
                {
                    <text> · @lastCare</text>
                }
                @if (parent is not null)
                {
                    <text> · from <a class="link-action" href="plants/@parent.Id">@parent.DisplayName</a></text>
                }
                else if (!string.IsNullOrWhiteSpace(propagation.Source))
                {
                    <text> · @propagation.Source</text>
                }
                @if (Pace is { IsSlow: true })
                {
                    <text> · </text><span class="pace-slow">slower than usual</span>
                }
            </p>

            @if (propagation.GivenAwayCount > 0 && Account.IsAvailable)
            {
                <button type="button" class="btn btn-link btn-sm link-action ps-0" @onclick="OpenPassOn">Send them its history</button>
            }

            @if (propagation.IsActive && offspring.Count > 0)
            {
                <p class="profile-facts">
                    <a class="link-action" href="propagations/@propagation.Id" @onclick="ShowPlants" @onclick:preventDefault>@Labels.Count(offspring.Count, "plant") potted up from it</a>
                </p>
            }

            @if (message is not null)
            {
                <p class="action-message" role="status">
                    @message
                    @foreach (var plant in madePlants)
                    {
                        <a class="ms-1" href="plants/@plant.Id">@plant.DisplayName</a>
                    }
                    @if (madePlants.Count > 0)
                    {
                        <span class="ms-2">· <a href="labels?plants=@string.Join(',', madePlants.Select(p => p.Id))">Print @(madePlants.Count == 1 ? "a label" : "labels")</a></span>
                    }
                </p>
            }

            <div class="profile-links">
                <button type="button" class="btn btn-link btn-sm link-action details-toggle" aria-expanded="@(detailsOpen ? "true" : "false")"
                        aria-controls="propagation-details" @onclick="() => detailsOpen = !detailsOpen">
                    Details
                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </button>
                <a class="btn btn-link btn-sm link-action" href="propagations/@propagation.Id/edit">Edit</a>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenShare">Share</button>
            </div>

            <div id="propagation-details" class="profile-details @(detailsOpen ? "open" : null)">
                <section class="detail-card">
                    <dl class="detail-list">
                        <dt>@(parent is null ? "Came from" : "Taken from")</dt>
                        <dd>
                            @if (parent is not null)
                            {
                                <a href="plants/@parent.Id">@parent.DisplayName</a>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(propagation.Source) ? "No parent plant" : propagation.Source)
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(propagation.Experiment))
                        {
                            <dt>Experiment</dt>
                            <dd><a href="propagations/results">@propagation.Experiment</a></dd>
                        }

                        <dt>Started</dt>
                        <dd>@Labels.Date(propagation.StartedOn)@(propagation.IsActive ? $" · {Labels.Age(propagation, Today)}" : "")</dd>

                        @if (Pace is { } pace)
                        {
                            <dt>Timing</dt>
                            <dd>
                                <span class="@(pace.IsSlow ? "pace-slow" : "pace-on-time")">@(pace.IsSlow ? "Slower than usual" : "On time")</span>
                                <div class="text-body-secondary small">
                                    @Labels.Count(pace.Compared, "earlier batch", "earlier batches") of @Labels.For(propagation.Type).ToLowerInvariant()
                                    in @Labels.For(propagation.Medium) @Labels.Stage(PropagationStage.Rooted, propagation.Type).ToLowerInvariant()
                                    in @Labels.Count(pace.UsualDays, "day") on average.
                                </div>
                            </dd>
                        }

                        @if (propagation.Type != PropagationType.Seed)
                        {
                            @MilestoneRow("First root", propagation.FirstRootOn, propagation.DaysToFirstRoot)
                        }
                        @MilestoneRow("First leaf", propagation.FirstLeafOn, propagation.DaysToFirstLeaf)

                        @if (propagation.Type == PropagationType.Corm && propagation.CormSizeMm is { } cormSize)
                        {
                            <dt>Corm size</dt>
                            <dd>@cormSize.ToString("0.##") mm</dd>
                        }

                        @if (propagation.Type == PropagationType.Seed && propagation.SeedsGerminated is { } up)
                        {
                            <dt>Seeds</dt>
                            <dd>
                                @up of @propagation.InitialCount came up@(propagation.GerminationRate is { } rate ? $" ({Math.Round(rate * 100):0}%)" : "")
                                @if (propagation.FirstGerminatedOn is { } first)
                                {
                                    <text> · first on @Labels.Date(first)</text>
                                }
                            </dd>
                        }

                        <dt>Count</dt>
                        <dd>@CountText</dd>

                        <dt>Grows in</dt>
                        <dd>
                            @Labels.For(propagation.Medium)
                            @if (!string.IsNullOrWhiteSpace(propagation.Container))
                            {
                                <text> · @propagation.Container</text>
                            }
                            @if (Mix is { } mix)
                            {
                                <div class="detail-sub">In @mix.Name@(mix.IsRetired ? " (no longer mixed)" : "")</div>
                                @if (!string.IsNullOrWhiteSpace(mix.Recipe))
                                {
                                    <div class="detail-sub">@mix.Recipe</div>
                                }
                            }
                        </dd>

                        @if (careBook.IsEmpty is false && !string.IsNullOrWhiteSpace(propagation.Genus))
                        {
                            var careFor = careBook.Find(propagation.Genus, propagation.Species, propagation.NameQualifier);
                            <dt>Pets</dt>
                            <dd>
                                @ToxicityText.Pets(careFor)@if (careFor?.PetsFrom is { } petsUrl)
                                {
                                    <text> · <a href="@petsUrl" target="_blank" rel="noopener">@careBook.SourceName(petsUrl)</a></text>
                                }
                                @if (ToxicityText.People(careFor) is { } peopleText)
                                {
                                    <div class="detail-sub">@peopleText@if (careFor?.PeopleFrom is { } peopleUrl)
                                    {
                                        <text> · <a href="@peopleUrl" target="_blank" rel="noopener">@careBook.SourceName(peopleUrl)</a></text>
                                    }</div>
                                }
                            </dd>
                        }

                        @if (lastWatered is { } watered)
                        {
                            <dt>Last watered</dt>
                            <dd>@Labels.Date(watered.Day)</dd>
                        }
                        @if (lastWaterChange is { } changed)
                        {
                            <dt>Water changed</dt>
                            <dd>@Labels.Date(changed.Day)</dd>
                        }

                        @if (propagation.RootingAids.Count > 0)
                        {
                            <dt>Rooting aids</dt>
                            <dd>@string.Join(", ", propagation.RootingAids.Order().Select(Labels.For))</dd>
                        }
                        @if (propagation.DriedForHours is { } dried)
                        {
                            <dt>Cut end dried</dt>
                            <dd>@Drying.Text(dried)</dd>
                        }

                        <dt>Location</dt>
                        <dd>@(places.NameOf(propagation.PlaceId) ?? "Not set")</dd>

                        @if (propagation.DormantSince is { } dormantSince)
                        {
                            <dt>Dormant</dt>
                            <dd>@(dormantSince == Today ? "Since today" : $"Since {Labels.Date(dormantSince)} · {Labels.Count(propagation.DaysDormant(Today) ?? 0, "day")}")</dd>
                        }

                        <PublicPageRow SubjectId="propagation.Id" />
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(propagation.Notes))
                    {
                        <h2>About it</h2>
                        <p class="detail-notes">@propagation.Notes</p>
                    }
                </section>

                @if (offspring.Count > 0 && propagation.IsActive)
                {
                    <section class="detail-card" id="propagation-plants">
                        <h2>Plants from it</h2>
                        <ul class="family-list">
                            @foreach (var plant in offspring)
                            {
                                <li>
                                    <a href="plants/@plant.Id">@plant.DisplayName</a>
                                    @if (plant.Status != PlantStatus.Active)
                                    {
                                        <span class="text-body-secondary small"> · @Labels.For(plant.Status)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }

                <section class="danger-zone">
                    @if (confirmDelete)
                    {
                        <p class="mb-2">
                            Delete <strong>@propagation.DisplayName</strong>? Plants potted up from it are kept.
                            If it didn't make it, <em>Mark failed</em> under the stage button keeps its history instead.
                        </p>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">Delete</button>
                        <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">Delete propagation</button>
                    }
                </section>
            </div>
        </div>

        <div class="profile-history">
            <div class="page-dock" role="group" aria-label="Add to @propagation.DisplayName">
                @if (googleOn)
                {
                    <button type="button" class="btn btn-primary icon-btn" @onclick="() => photoChoice = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Photo
                    </button>
                }
                else
                {
                    <label class="btn btn-primary icon-btn" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Photo
                    </label>
                }
                <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => composer?.OpenNote()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                    Note
                </button>
                @if (propagation.IsActive)
                {
                    <button type="button" class="btn btn-outline-primary icon-btn dock-care" aria-label="Care" @onclick="() => careOpen = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10Z" /></svg>
                        <span class="dock-label">Care</span>
                    </button>
                    <button type="button" class="btn btn-outline-primary icon-btn dock-stage" aria-label="Stage: @Labels.Stage(propagation.Stage, propagation.Type). Change stage" @onclick="OpenStage">
                        <span class="stage-steps" data-step="@StageStep" aria-hidden="true"><i></i><i></i><i></i></span>
                        @Labels.Stage(propagation.Stage, propagation.Type)
                    </button>
                    <button type="button" class="btn btn-outline-primary dock-more" aria-label="More for this propagation" @onclick="() => more = More.Menu">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg>
                    </button>
                }
            </div>

            @if (Arrived)
            {
                <ArrivedNote SubjectId="propagation.Id" />
            }

            @if (Made)
            {
                <MadeNote PropagationId="propagation.Id" />
            }

            @* The key reloads the history after stage changes and potting up *@
            <Timeline @key="historyVersion" @ref="timeline" SubjectType="SubjectType.Propagation" SubjectId="propagation.Id"
                      CoverPhotoId="propagation.CoverPhotoId" OnCoverChanged="SetCoverAsync" PhotoAge="day => PhotoDayCount.DayLabel(PhotoDayCount.StartOf(propagation), day)"
                      EmptyText="No photos or notes yet. Add the first one with Photo or Note." />
        </div>
    </div>

    <ShareSheet Open="shareOpen" OpenChanged="open => shareOpen = open" Tone="propagation" SubjectId="propagation.Id" StartOnLink="shareOnLink"
                CoverPhotoId="propagation.CoverPhotoId" PhotoAge="day => PhotoDayCount.DayLabel(PhotoDayCount.StartOf(propagation), day)" Text="ShareCardText.ForPropagation(propagation, parent, Today)" />

    <EntryComposer @key="propagation.Id" @ref="composer" SubjectType="SubjectType.Propagation" SubjectId="propagation.Id" PhotoInputId="@photoInputId"
                   CoverPhotoId="propagation.CoverPhotoId" OnCoverChanged="SetCoverAsync" OnAdded="() => historyVersion++" />

    @if (googleOn)
    {
        <Sheet Title="Add a photo" Open="photoChoice" OpenChanged="open => photoChoice = open">
            <ul class="sheet-actions">
                <li>
                    <label class="sheet-action" for="@photoInputId" @onclick="() => photoChoice = false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        <span class="sheet-action-text"><b>From this phone</b><small>Camera or gallery</small></span>
                    </label>
                </li>
                <li>
                    <button type="button" class="sheet-action" @onclick="PickFromGoogleAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                        <span class="sheet-action-text"><b>From Google Photos</b><small>Including photos only in the cloud</small></span>
                    </button>
                </li>
            </ul>
        </Sheet>
    }

    <ShowFound ElementId="@(Entry is { } found ? $"entry-{found}" : null)" Ready="@loaded" />

    @if (propagation.IsActive)
    {
        <Sheet Title="Care" Open="careOpen" OpenChanged="open => careOpen = open">
            <PropagationCareSheet Propagation="propagation" Logs="careLogs" OnLogged="CareLoggedAsync" OnRemoved="LoadAsync" />
        </Sheet>

        <Sheet Title="@StageTitle" Open="stageView != StageView.None" OpenChanged="open => { if (!open) stageView = StageView.None; }">
            @switch (stageView)
            {
                case StageView.Stage:
                    <div class="btn-group segmented stage-track mb-3" role="radiogroup" aria-label="Stage">
                        @foreach (var stage in ManualStages)
                        {
                            var id = $"stage-{stage}";
                            <input type="radio" class="btn-check" name="stage" id="@id" disabled="@busy"
                                   checked="@(propagation.Stage == stage)" @onchange="() => SetStageAsync(stage)" />
                            <label class="btn btn-outline-primary @(stage < propagation.Stage ? "passed" : null)" for="@id">@Labels.Stage(stage, propagation.Type)</label>
                        }
                    </div>

                    <dl class="detail-list mb-2">
                        <dt>Started</dt>
                        <dd>@Labels.Date(propagation.StartedOn) · day @propagation.DaysSinceStart(Today)</dd>

                        @if (propagation.Type == PropagationType.Seed)
                        {
                            <dt>First seedling up</dt>
                            <dd>
                                @if (propagation.FirstGerminatedOn is { } germinated)
                                {
                                    @($"{Labels.Date(germinated)} · day {Math.Max(0, germinated.DayNumber - propagation.StartedOn.DayNumber)}")
                                }
                                else
                                {
                                    <span class="text-body-secondary">Not yet</span>
                                }
                            </dd>
                        }
                        else
                        {
                            <dt>First root</dt>
                            <dd>
                                @if (propagation.FirstRootOn is { } root)
                                {
                                    @($"{Labels.Date(root)} · day {propagation.DaysToFirstRoot}")
                                }
                                else
                                {
                                    <span class="text-body-secondary">Not yet</span>
                                }
                            </dd>
                        }

                        <dt>First leaf</dt>
                        <dd>
                            @if (propagation.FirstLeafOn is { } leaf)
                            {
                                @($"{Labels.Date(leaf)} · day {propagation.DaysToFirstLeaf}")
                            }
                            else
                            {
                                <span class="text-body-secondary">Not yet</span>
                                <button type="button" class="btn btn-link btn-sm link-action ms-2 align-baseline" disabled="@busy"
                                        @onclick="RecordFirstLeafAsync">Saw a new leaf today</button>
                            }
                        </dd>

                        @if (propagation.RootedOn is { } rootedOn)
                        {
                            <dt>Rooted on</dt>
                            <dd>@Labels.Date(rootedOn)</dd>
                        }
                    </dl>
                    <p class="form-text mb-3">Wrong date? Change it under <a href="propagations/@propagation.Id/edit">Edit</a>.</p>

                    <div class="sheet-section">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary flex-fill" @onclick="OpenPotUp">@PotUpWord</button>
                            <button type="button" class="btn btn-outline-danger flex-fill" @onclick="OpenFailed">Mark failed</button>
                        </div>
                        <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="OpenGaveAway">
                            @(propagation.RemainingCount == 1 ? "Gave it away" : "Gave some away")
                        </button>
                    </div>
                    break;

                case StageView.PotUp:
                    @if (InPlantMedium)
                    {
                        <p class="form-text mb-3">
                            @(propagation.RemainingCount > 1
                                ? $"Each one becomes a plant of its own, in the {Labels.MediumWord(propagation.Medium)} they're in now."
                                : $"It becomes a plant of its own, in the {Labels.MediumWord(propagation.Medium)} it's in now.")
                            This propagation keeps its history.
                        </p>
                    }
                    else
                    {
                        <p class="form-text mb-3">
                            @(propagation.RemainingCount > 1 ? "Each one you pot up becomes a plant of its own." : "It becomes a plant of its own.")
                            This propagation keeps its history.
                        </p>
                    }
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="potup-count">How many (@propagation.RemainingCount left)</label>
                            <input id="potup-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" @bind="potUp.Count" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="potup-name">Nickname</label>
                        <input id="potup-name" class="form-control" @bind="potUp.Nickname" @bind:event="oninput" placeholder="@(propagation.BotanicalName ?? "")" />
                        @if (potUp.Count > 1 || propagation.PottedUpCount > 0)
                        {
                            <div class="form-text">Numbered when there are several, e.g. "@(string.IsNullOrWhiteSpace(potUp.Nickname) ? "Coleus" : potUp.Nickname.Trim()) @(propagation.PottedUpCount + 1)".</div>
                        }
                    </div>
                    @if (InPlantMedium && !potUp.ChangeMedium)
                    {
                        <button type="button" class="btn btn-link btn-sm link-action p-0 mb-2" @onclick="() => potUp.ChangeMedium = true">Moved it to something else?</button>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label" for="potup-medium">Grows in</label>
                            <select id="potup-medium" class="form-select" value="@potUp.Medium" @onchange="SetPotUpMedium">
                                @foreach (var medium in Enum.GetValues<GrowingMedium>())
                                {
                                    <option value="@medium">@Labels.For(medium)</option>
                                }
                            </select>
                        </div>
                        @if (potUp.Medium == GrowingMedium.Soil)
                        {
                            <div class="mb-2">
                                <MixPicker @bind-Value="potUp.SoilMixId" Mixes="mixes" />
                            </div>
                        }
                    }
                    <div class="mb-2">
                        <PotPicker Value="potUp.PotId" ValueChanged="SetPotUpPot" Pots="pots" Groups="InnerSlot" PotAdded="AddPot" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="potup-date">Date</label>
                        <input id="potup-date" type="date" class="form-control" @bind="potUp.Date" min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <RoomPicker @bind-Value="potUp.Location" Rooms="rooms" Label="Where it goes" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@(busy || !CountIsValid(potUp.Count))" @onclick="PotUpAsync">
                            @(InPlantMedium
                                ? (potUp.Count == 1 ? "It's a plant now" : $"Make {potUp.Count} plants")
                                : (potUp.Count == 1 ? "Pot up" : $"Pot up {potUp.Count}"))
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">Back</button>
                    </div>
                    break;

                case StageView.Failed:
                    <p class="form-text mb-3">
                        It stays in the history and in the results. If it was a mistake, correct the count under Edit.
                        @if (failedCount >= propagation.RemainingCount)
                        {
                            <text> This finishes the propagation.</text>
                        }
                    </p>
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="failed-count">How many (@propagation.RemainingCount left)</label>
                            <input id="failed-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" @bind="failedCount" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <span class="form-label d-block" id="failed-why-label">Why? <span class="text-body-secondary">(optional)</span></span>
                        <div class="chip-row" role="group" aria-labelledby="failed-why-label">
                            @foreach (var why in Enum.GetValues<FailReason>())
                            {
                                var picked = failedReason == why;
                                <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                        @onclick="() => failedReason = picked ? null : why">@FailReasons.Chip(why)</button>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="failed-note">Note <span class="text-body-secondary">(optional)</span></label>
                        <input id="failed-note" class="form-control" @bind="failedNote" @bind:event="oninput" placeholder="e.g. left too wet" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="failed-date">Date</label>
                        <input id="failed-date" type="date" class="form-control" @bind="failedDate"
                               min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-danger" disabled="@(busy || !CountIsValid(failedCount))" @onclick="MarkFailedAsync">
                            @(failedCount == 1 ? "Mark as failed" : $"Mark {failedCount} as failed")
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">Back</button>
                    </div>
                    break;

                case StageView.GaveAway:
                    <p class="form-text mb-3">
                        It stays in the history and in the results.
                        @if (gaveCount >= propagation.RemainingCount)
                        {
                            <text> This finishes the propagation.</text>
                        }
                    </p>
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="gave-count">How many (@propagation.RemainingCount left)</label>
                            <input id="gave-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" @bind="gaveCount" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="gave-to">Who got it? <span class="text-body-secondary">(optional)</span></label>
                        <input id="gave-to" class="form-control" @bind="gaveTo" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="gave-date">Date</label>
                        <input id="gave-date" type="date" class="form-control" @bind="gaveDate"
                               min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@(busy || !CountIsValid(gaveCount))" @onclick="GiveAwayAsync">
                            @(gaveCount == 1 ? "Mark as given away" : $"Mark {gaveCount} as given away")
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">Back</button>
                    </div>
                    break;

                case StageView.PassOn:
                    <PassOnPanel SubjectType="SubjectType.Propagation" SubjectId="propagation.Id" Name="@propagation.DisplayName"
                                 OnDone="() => stageView = StageView.None" OnChangePage="ChangePassOnPage" />
                    break;
            }
        </Sheet>

        <Sheet Title="@MoreTitle" Open="more != More.None" OpenChanged="open => { if (!open) more = More.None; }">
            @switch (more)
            {
                case More.Menu:
                    <ul class="sheet-actions">
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => more = More.Flag">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4" /><path d="M5 4h12l-2.5 4.5L17 13H5" /></svg>
                                <span class="sheet-action-text"><b>@(propagation.Attention is null ? "Flag it" : "Change the flag")</b><small>Keeps it on Today until it's done</small></span>
                            </button>
                        </li>
                        @if (propagation.IsActive)
                        {
                            <li>
                                <button type="button" class="sheet-action" @onclick="OpenSwap">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h11l-3-3M17 17H6l3 3" /></svg>
                                    <span class="sheet-action-text"><b>For swap</b><small>@(propagation.SpareAvailable > 0 ? $"{propagation.SpareAvailable} offered" : "Offer some of them")</small></span>
                                </button>
                            </li>
                        }
                        <li>
                            <a class="sheet-action" href="labels?cuttings=@propagation.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9Z" /><circle cx="8" cy="8" r="1.4" /></svg>
                                <span class="sheet-action-text"><b>Print a label</b><small>For its jar or pot</small></span>
                            </a>
                        </li>
                        <li>
                            @if (propagation.IsDormant)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndDormancyAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
                                    <span class="sheet-action-text"><b>It's woken up</b><small>Dormant @DaysLabel(propagation.DaysDormant(Today))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenDormant">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
                                    <span class="sheet-action-text"><b>Dormant</b><small>Resting, like a corm waiting out the winter</small></span>
                                </button>
                            }
                        </li>
                    </ul>
                    break;

                case More.Swap:
                    <div class="mb-3">
                        <label class="form-label" for="spare-count">Cuttings available for swap</label>
                        <input id="spare-count" type="number" class="form-control" inputmode="numeric" min="0" max="@propagation.RemainingCount"
                               @bind="swapCount" />
                        <div class="form-text">Up to @propagation.RemainingCount, what is left. It shows on <a href="swap">Available for swap</a>, and giving some away takes them off first.</div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetSpareAsync">Save</button>
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                    </div>
                    break;

                case More.Flag:
                    <AttentionPanel Current="propagation.Attention" Later="propagation.AttentionLater" NextRoundDay="nextRoundDay" Editing="true" EditingChanged="_ => more = More.None"
                                    Suggestions="AttentionPanel.PropagationReasons" OnSave="SetAttentionAsync" />
                    break;

                case More.Dormant:
                    <div class="mb-3">
                        <label class="form-label" for="dormant-since">Since</label>
                        <input id="dormant-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Resting rather than stuck, e.g. a corm waiting out the winter. It won't come up on Today until it wakes up.</div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetDormantAsync">Mark as dormant</button>
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">Back</button>
                    </div>
                    break;
            }
        </Sheet>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Set by the page that keeps a received history, so the first visit says where it went.</summary>
    [SupplyParameterFromQuery(Name = "arrived")]
    public bool Arrived { get; set; }

    /// <summary>Set when the propagation was just started, so the first visit offers a label for the jar.</summary>
    [SupplyParameterFromQuery(Name = "made")]
    public bool Made { get; set; }

    /// <summary>A history or care entry to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "entry")]
    public Guid? Entry { get; set; }

    private enum StageView { None, Stage, PotUp, Failed, GaveAway, PassOn }

    private enum More { None, Menu, Flag, Dormant, Swap }
    private bool shareOpen;
    private bool shareOnLink;

    private sealed class PotUpForm
    {
        public int Count { get; set; } = 1;
        public string? Nickname { get; set; }
        public DateOnly Date { get; set; }
        public string? Location { get; set; }
        public GrowingMedium Medium { get; set; }
        public Guid? PotId { get; set; }
        public Guid? SoilMixId { get; set; }

        /// <summary>Shows Grows in and the mix for a propagation already in a plant medium, which hides them.</summary>
        public bool ChangeMedium { get; set; }
    }

    private static readonly PotGroup[] InnerSlot = [PotGroup.Inner, PotGroup.Standalone];

    private static readonly PropagationStage[] ManualStages =
        [PropagationStage.Started, PropagationStage.Rooting, PropagationStage.Rooted];

    private Propagation? propagation;
    private IReadOnlyList<Propagation> allPropagations = [];
    private Plant? parent;
    private IReadOnlyList<Plant> offspring = [];
    private IReadOnlyList<CodeClash> numberClashes = [];
    private IReadOnlyList<Room> rooms = [];
    private Places places = Places.None;
    private PropagationOutcome? outcome;
    private IReadOnlyList<Pot> pots = [];
    private IReadOnlyList<SoilMix> mixes = [];

    private SoilMix? Mix => propagation?.SoilMixId is { } id ? mixes.FirstOrDefault(m => m.Id == id && !m.IsDeleted) : null;

    private void AddPot(Pot pot) => pots = [.. pots, pot];
    private bool loaded;
    private bool busy;
    private bool confirmDelete;
    private bool detailsOpen;
    private bool scrollToPlants;
    private int historyVersion;
    private EntryComposer? composer;
    private bool googleOn;
    private bool photoChoice;
    private Timeline? timeline;
    private readonly string photoInputId = $"propagation-photo-{Guid.NewGuid():N}";

    private bool careOpen;
    private IReadOnlyList<PropagationCareLog> careLogs = [];
    private PropagationCareLatest? lastWatered;
    private PropagationCareLatest? lastWaterChange;

    private StageView stageView;
    private More more;
    private DateOnly since;
    private PotUpForm potUp = new();
    private int failedCount = 1;
    private FailReason? failedReason;
    private string? failedNote;
    private int gaveCount = 1;
    private string? gaveTo;
    private DateOnly gaveDate;
    private DateOnly failedDate;
    private string? message;
    private IReadOnlyList<Plant> madePlants = [];

    private DateOnly Today => Time.Today();

    // With no photo, the tile at the top shows the days, so the line under the name needn't
    private bool TileShowsDays => propagation is { CoverPhotoId: null, IsActive: true };

    private RootingPace? Pace => propagation is null ? null : RootingPace.For(propagation, allPropagations, Today);

    // The same count as the ticks on the stage badge
    private int StageStep => propagation?.Stage switch
    {
        PropagationStage.Started => 1,
        PropagationStage.Rooting => 2,
        PropagationStage.Failed => 0,
        _ => 3
    };

    private string StageTitle => stageView switch
    {
        StageView.PotUp => PotUpWord,
        StageView.Failed => "Mark as failed",
        StageView.GaveAway => "Gave some away",
        StageView.PassOn => "Send its history",
        _ => "How far along",
    };

    // A propagation already in soil, bark, LECA or PON is a plant in all but name, so there is nothing to pot up
    private bool InPlantMedium => propagation?.InPlantMedium == true;

    private string PotUpWord => InPlantMedium ? "It's a plant now" : "Pot up";

    private string MoreTitle => more switch
    {
        More.Flag => propagation?.Attention is null ? "Flag it" : "Change the flag",
        More.Dormant => "Dormant",
        More.Swap => "For swap",
        _ => propagation?.DisplayName ?? "",
    };

    private static string DaysLabel(int? days) => days is null or 0 ? "since today" : $"for {Labels.Count(days.Value, "day")}";

    // Only the date, or "Not yet". Recording a milestone happens in the stage sheet.
    private RenderFragment MilestoneRow(string name, DateOnly? date, int? days) => __builder =>
    {
        if (date is null && !propagation!.IsActive)
            return;
        <dt>@name</dt>
        <dd>
            @if (date is { } on)
            {
                @($"{Labels.Date(on)} · day {days}")
            }
            else
            {
                <span class="text-body-secondary">Not yet</span>
            }
        </dd>
    };

    private string CountText
    {
        get
        {
            var p = propagation!;
            var parts = new List<string> { $"{p.InitialCount} started" };
            if (p.PottedUpCount > 0) parts.Add($"{p.PottedUpCount} potted up");
            if (p.GivenAwayCount > 0) parts.Add($"{p.GivenAwayCount} given away");
            if (p.FailedCount > 0) parts.Add($"{p.FailedCount} failed");
            if (p.IsActive && p.RemainingCount != p.InitialCount) parts.Add($"{p.RemainingCount} left");
            return string.Join(" · ", parts);
        }
    }

    private async Task PickFromGoogleAsync()
    {
        photoChoice = false;
        if (composer is not null)
            await composer.PickFromGooglePhotos();
    }

    protected override async Task OnParametersSetAsync()
    {
        googleOn = await Google.IsEnabledAsync();
        if (propagation?.Id != Id)
        {
            confirmDelete = false;
            detailsOpen = false;
            stageView = StageView.None;
            more = More.None;
            message = null;
        }
        await LoadAsync();
        // A care entry lives in the care sheet, so that opens to show it
        if (Entry is { } entryId && propagation?.IsActive == true && careLogs.Any(l => l.Id == entryId))
            careOpen = true;
        loaded = true;
    }

    private EverydayNameBook? everyday;

    // What common plants usually like, here only for the Pets row. Empty if it couldn't be read.
    private PlantCareBook careBook = PlantCareBook.Empty;

    private async Task LoadAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        careBook = await CommonCare.GetBookAsync();
        propagation = await Repository.GetAsync(Id);
        var plants = await PlantRepository.GetAllAsync();
        var propagations = allPropagations = await Repository.GetAllAsync();
        parent = propagation?.ParentPlantId is { } parentId ? plants.FirstOrDefault(p => p.Id == parentId) : null;
        offspring = plants.Where(p => p.FromPropagationId == Id)
                          .OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                          .ToList();
        numberClashes = propagation is null ? [] : CollectionNumbers.Clashes(propagation.CollectionNumber, propagation.Id, plants, propagations);
        places = await RoomService.GetPlacesAsync();
        rooms = Room.List(places, plants, propagations);
        outcome = propagation is null ? null : PropagationOutcome.For(propagation, plants, places);
        pots = await PotRepository.GetAllAsync();
        mixes = await MixRepository.GetAllAsync();
        careLogs = PropagationCareService.For(await CareService.GetAllAsync(), Id);
        lastWatered = PropagationCareService.Latest(careLogs, Id, PropagationCareKind.Watered, Today);
        lastWaterChange = PropagationCareService.Latest(careLogs, Id, PropagationCareKind.ChangedWater, Today);
        nextRoundDay = RoundSchedule.Next((await SettingsService.GetAsync()).RoundDays, Today);
    }

    // "watered 2 days ago" or "water changed yesterday", whichever happened last
    private string? LastCare => (lastWatered, lastWaterChange) switch
    {
        (null, null) => null,
        ({ } w, null) => $"watered {Labels.DaysAgo(w.DaysAgo)}",
        (null, { } c) => $"water changed {Labels.DaysAgo(c.DaysAgo)}",
        ({ } w, { } c) => c.DaysAgo < w.DaysAgo
            ? $"water changed {Labels.DaysAgo(c.DaysAgo)}"
            : $"watered {Labels.DaysAgo(w.DaysAgo)}"
    };

    private async Task CareLoggedAsync()
    {
        careOpen = false;
        await LoadAsync();
    }

    private void ShowPlants()
    {
        detailsOpen = true;
        scrollToPlants = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToPlants || propagation is null)
            return;
        scrollToPlants = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("scrollToId", "propagation-plants");
    }

    private bool CountIsValid(int count) => propagation is not null && count >= 1 && count <= propagation.RemainingCount;

    private void OpenStage()
    {
        message = null;
        stageView = StageView.Stage;
    }

    private async Task SetStageAsync(PropagationStage stage)
    {
        if (propagation is null)
            return;
        busy = true;
        try
        {
            await PropagationService.SetStageAsync(propagation, stage, Labels.For(propagation), seenToday: true);
            message = null;
            historyVersion++;
            stageView = StageView.None;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RecordFirstLeafAsync()
    {
        if (propagation is null)
            return;
        busy = true;
        try
        {
            await PropagationService.RecordMilestoneAsync(propagation, Milestone.FirstLeaf, Labels.For(propagation));
            message = null;
            historyVersion++;
            stageView = StageView.None;
        }
        finally
        {
            busy = false;
        }
    }

    private DateOnly? nextRoundDay;

    private async Task SetAttentionAsync((string? Reason, LooseDate? From) change)
    {
        if (propagation is null)
            return;
        await PropagationService.SetAttentionAsync(propagation, change.Reason, change.From);
    }

    private int swapCount;

    private void OpenSwap()
    {
        swapCount = propagation?.SpareAvailable ?? 0;
        more = More.Swap;
    }

    private async Task SetSpareAsync()
    {
        if (propagation is null)
            return;
        busy = true;
        try
        {
            await PropagationService.SetSpareAsync(propagation, swapCount);
            more = More.None;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenDormant()
    {
        since = Today;
        more = More.Dormant;
    }

    private async Task ChangeDormancyAsync(DateOnly? on)
    {
        if (propagation is null)
            return;
        busy = true;
        try
        {
            await PropagationService.SetDormantAsync(propagation, on, Labels.For(propagation));
            more = More.None;
            historyVersion++;
        }
        finally
        {
            busy = false;
        }
    }

    private Task EndDormancyAsync() => ChangeDormancyAsync(null);

    private Task SetDormantAsync() => ChangeDormancyAsync(since);

    // A pot that suggests a medium sets it, until the person has picked a medium in this form
    private bool potUpMediumChosen;

    private void SetPotUpMedium(ChangeEventArgs e)
    {
        potUp.Medium = Enum.Parse<GrowingMedium>(e.Value?.ToString() ?? nameof(GrowingMedium.Soil));
        potUpMediumChosen = true;
    }

    private void SetPotUpPot(Guid? id)
    {
        potUp.PotId = id;
        var pot = pots.FirstOrDefault(p => p.Id == id);
        potUp.Medium = PotKinds.MediumAfterPicking(pot, potUp.Medium, potUpMediumChosen);
    }

    private void OpenPotUp()
    {
        var p = propagation!;
        // Already in a plant medium, it stays there whatever pot is picked, unless the person says otherwise
        potUpMediumChosen = p.InPlantMedium;
        potUp = new PotUpForm
        {
            // A propagation named only by nickname passes it on, since a plant needs a name
            Nickname = string.IsNullOrWhiteSpace(p.Genus) ? p.Nickname : null,
            Date = Today,
            Location = places.NameOf(p.PlaceId),
            // Soil is the usual place for a potted up plant. Only a default, it's a select.
            Medium = p.InPlantMedium ? p.Medium : GrowingMedium.Soil,
            SoilMixId = p.Medium == GrowingMedium.Soil ? p.SoilMixId : null,
        };
        message = null;
        stageView = StageView.PotUp;
    }

    private void OpenFailed()
    {
        failedCount = 1;
        failedReason = null;
        failedNote = null;
        failedDate = Today;
        message = null;
        stageView = StageView.Failed;
    }

    private void OpenGaveAway()
    {
        gaveCount = 1;
        gaveTo = null;
        gaveDate = Today;
        message = null;
        stageView = StageView.GaveAway;
    }

    private void OpenPassOn() => stageView = StageView.PassOn;

    private void OpenShare()
    {
        shareOnLink = false;
        shareOpen = true;
    }

    // From the offer to send its history: the Share sheet opens on the link, to change what the page shows
    private void ChangePassOnPage()
    {
        stageView = StageView.None;
        shareOnLink = true;
        shareOpen = true;
    }

    private async Task PotUpAsync()
    {
        if (propagation is null || !CountIsValid(potUp.Count))
            return;

        busy = true;
        try
        {
            var placeId = await RoomService.PlaceIdAsync(potUp.Location);
            madePlants = await PropagationService.PotUpAsync(propagation, new PotUpRequest(
                potUp.Count, potUp.Date, potUp.Nickname, placeId, potUp.Medium, potUp.PotId, potUp.Medium == GrowingMedium.Soil ? potUp.SoilMixId : null));
            message = madePlants.Count == 1 ? "Potted up:" : $"Potted up {madePlants.Count}:";
            stageView = StageView.None;
            await LoadAsync();
            historyVersion++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Potting up the propagation failed");
            madePlants = [];
            message = $"Couldn't pot up: {ex.Message}";
            stageView = StageView.None;
        }
        busy = false;
    }

    private async Task MarkFailedAsync()
    {
        if (propagation is null || !CountIsValid(failedCount))
            return;

        busy = true;
        try
        {
            await PropagationService.MarkFailedAsync(propagation, failedCount, failedReason, failedNote, failedDate);
            message = failedCount == 1 ? "Marked 1 as failed." : $"Marked {failedCount} as failed.";
            historyVersion++;
        }
        catch (InvalidOperationException ex)
        {
            message = $"Couldn't mark as failed: {ex.Message}";
        }
        madePlants = [];
        stageView = StageView.None;
        busy = false;
    }

    private async Task GiveAwayAsync()
    {
        if (propagation is null || !CountIsValid(gaveCount))
            return;

        busy = true;
        try
        {
            await PropagationService.GiveAwayAsync(propagation, gaveCount, gaveTo, gaveDate);
            message = gaveCount == 1 ? "Marked 1 as given away." : $"Marked {gaveCount} as given away.";
            historyVersion++;
            madePlants = [];
            // Offers to send whoever got it the story, where links are available
            stageView = Account.IsAvailable ? StageView.PassOn : StageView.None;
        }
        catch (InvalidOperationException ex)
        {
            message = $"Couldn't mark as given away: {ex.Message}";
            madePlants = [];
            stageView = StageView.None;
        }
        busy = false;
    }

    private async Task SetCoverAsync(Guid? photoId)
    {
        if (propagation is null || propagation.CoverPhotoId == photoId)
            return;
        propagation.CoverPhotoId = photoId;
        await Repository.SaveAsync(propagation);
    }

    private async Task DeleteAsync()
    {
        await PropagationService.DeleteAsync(Id);
        Navigation.NavigateTo("propagations", replace: true);
    }
}
