@page "/propagations/{Id:guid}"
@layout WideLayout
@inject IPropagationRepository Repository
@inject CoverPhotos Covers
@inject PropagationCareService CareService
@inject ILogger<PropagationDetail> Logger
@inject IPlantRepository PlantRepository
@inject IPotRepository PotRepository
@inject ISoilMixRepository MixRepository
@inject PropagationService PropagationService
@inject UnitForms Units
@inject RoomService RoomService
@inject SellerService SellerService
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IJSRuntime JS
@inject PlantNameService Names
@inject PlantCareService CommonCare
@inject GooglePhotosService Google
@inject AccountService Account
@inject SettingsService SettingsService
@using System.Globalization
@using Stikling.Core.Propagations
@using Stikling.Core.Settings

<PageTitle>@(propagation?.DisplayName ?? Strings.Propagations.DetFallbackTitle) · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="propagations">@Strings.Propagations.ListTitle</a>

@if (propagation is null)
{
    <p class="text-body-secondary">@(loaded ? Strings.Propagations.DetNotFound : Strings.Propagations.ListLoading)</p>
}
else
{
    @* On a wide screen these are two columns: who it is on the left, its history on the right *@
    <div class="profile-layout">
        <div class="profile-side">
            @if (ShownCover is { } coverId)
            {
                <div class="detail-hero">
                    <button type="button" class="detail-hero-open" aria-label="@Strings.Propagations.DetOpenCover" @onclick="() => timeline?.OpenPhoto(coverId)">
                        <PhotoImage PhotoId="coverId" Thumbnail="false" Alt="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPhotoOf, propagation.DisplayName)" />
                    </button>
                </div>
            }

            <header class="detail-header">
                @if (ShownCover is null && propagation.IsActive)
                {
                    // With no photo to show, the tile shows how long it has been going instead
                    var days = propagation.DaysSinceStart(Today);
                    <div class="detail-icon day-tile">
                        <b>@days</b>
                        <small>@Plural.Of(days, Strings.Propagations.ThumbDay_One, Strings.Propagations.ThumbDay_Other)</small>
                    </div>
                }
                else if (ShownCover is null)
                {
                    <div class="detail-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M8 3h8l-1 6v9a3 3 0 0 1-6 0V9Z" /><path d="M12 12v4M12 16l-2 2M12 16l2 2" /></svg>
                    </div>
                }
                <div class="min-w-0">
                    @if (CollectionNumbers.Normalize(propagation.CollectionNumber) is { } number)
                    {
                        <div class="detail-number">#@number</div>
                    }
                    <h1>
                        @if (string.IsNullOrWhiteSpace(propagation.Nickname) && propagation.BotanicalName is not null)
                        {
                            <BotanicalName Genus="@propagation.Genus" Species="@propagation.Species" Cultivar="@propagation.Cultivar" Qualifier="@propagation.NameQualifier" Note="@propagation.NameNote" />
                        }
                        else
                        {
                            @propagation.DisplayName
                        }
                    </h1>
                    @if (!string.IsNullOrWhiteSpace(propagation.Nickname) && propagation.BotanicalName is not null)
                    {
                        <p class="detail-sub"><BotanicalName Genus="@propagation.Genus" Species="@propagation.Species" Cultivar="@propagation.Cultivar" Qualifier="@propagation.NameQualifier" Note="@propagation.NameNote" /></p>
                    }
                    else if (everyday?.For(propagation.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(propagation.Species, propagation.NameQualifier), propagation.Cultivar) is { } called)
                    {
                        <p class="detail-sub everyday-name">@called</p>
                    }
                    <NumberClashNote Code="@propagation.CollectionNumber" Clashes="numberClashes" />
                    <div class="profile-badges">
                        @if (propagation.IsDormant)
                        {
                            <span class="badge dormant-badge">@Strings.Propagations.CardDormant</span>
                        }
                        @if (propagation.SpareAvailable > 0)
                        {
                            <a class="badge swap-badge" href="swap">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.CardToSwap, propagation.SpareAvailable)</a>
                        }
                        @if (!propagation.IsActive)
                        {
                            <span class="badge @(propagation.Stage == PropagationStage.Failed ? "text-bg-secondary" : "stage-badge")">@Labels.Stage(propagation.Stage)</span>
                        }
                    </div>
                </div>
            </header>

            @if (outcome is { } result)
            {
                <section class="outcome" aria-labelledby="outcome-title">
                    <h2 id="outcome-title" class="outcome-title">@Strings.Propagations.DetOutcomeTitle</h2>
                    <dl class="outcome-figures">
                        @if (result.DaysRan is { } ran)
                        {
                            <div>
                                <dt>@Strings.Propagations.DetRanFor</dt>
                                <dd><b>@ran</b> @Plural.Of(ran, Strings.Propagations.ThumbDay_One, Strings.Propagations.ThumbDay_Other)</dd>
                            </div>
                        }
                        @if (result.DaysToRoot is { } toRoot)
                        {
                            <div>
                                <dt>@(propagation.Type == PropagationType.Seed ? Strings.Propagations.DetFirstSeedling : Strings.Propagations.EditFirstRoot)</dt>
                                <dd>@((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDayBold, toRoot))</dd>
                            </div>
                        }
                        <div>
                            <dt>@Strings.Propagations.EditPottedUp</dt>
                            <dd>@((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPottedOfBold, result.PottedUp, result.Started))</dd>
                        </div>
                    </dl>
                    @if (result.GivenAway > 0)
                    {
                        <p class="outcome-given">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetOutcomeGiven, result.GivenAway)</p>
                    }
                    @if (result.Failed > 0)
                    {
                        <p class="outcome-failed">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetOutcomeFailed, result.Failed)</p>
                    }
                    @if (result.Plants.Count > 0)
                    {
                        <ul class="outcome-plants">
                            @foreach (var made in result.Plants)
                            {
                                <li>
                                    <a href="plants/@made.Plant.Id">@made.Plant.DisplayName</a>
                                    <span class="text-body-secondary small">
                                        @(made.StillHere ? (made.Room ?? Strings.Propagations.DetInCollection) : Labels.For(made.Plant.Status))
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
            else if (propagation.IsActive)
            {
                <AttentionPanel Current="propagation.Attention" Later="propagation.AttentionLater" NextRoundDay="nextRoundDay" Editing="false" EditingChanged="_ => more = More.Flag"
                                Suggestions="AttentionPanel.PropagationReasons" OnSave="SetAttentionAsync" />
            }

            <p class="profile-facts">
                @Labels.Summary(propagation)
                @if (propagation.IsActive && !(TileShowsDays && propagation.DaysSinceStart(Today) > 0))
                {
                    <text> · @Labels.Age(propagation, Today)</text>
                }
                @if (places.NameOf(propagation.PlaceId) is { } place)
                {
                    <text> · @place</text>
                }
                @if (propagation.IsActive && LastCare is { } lastCare)
                {
                    <text> · @lastCare</text>
                }
                @if (parent is not null)
                {
                    <text> · @((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetFromParent, $"<a class=\"link-action\" href=\"plants/{parent.Id}\">{System.Net.WebUtility.HtmlEncode(parent.DisplayName)}</a>"))</text>
                }
                else if (sellers.For(propagation.SellerId, propagation.Source) is { } headerSeller)
                {
                    <text> · <a class="link-action" href="sellers/@headerSeller.Id">@headerSeller.Name</a></text>
                }
                else if (!string.IsNullOrWhiteSpace(propagation.Source))
                {
                    <text> · @propagation.Source</text>
                }
                @if (Pace is { IsSlow: true })
                {
                    <text> · </text><span class="pace-slow">@Strings.Propagations.CardSlow</span>
                }
            </p>

            @if (propagation.GivenAwayCount > 0 && Account.IsAvailable)
            {
                <button type="button" class="btn btn-link btn-sm link-action ps-0" @onclick="OpenPassOn">@Strings.Propagations.PassOnSend</button>
            }

            @if (propagation.IsActive && offspring.Count > 0)
            {
                <p class="profile-facts">
                    <a class="link-action" href="propagations/@propagation.Id" @onclick="ShowPlants" @onclick:preventDefault>@Plural.Of(offspring.Count, Strings.Propagations.DetPlantsFrom_One, Strings.Propagations.DetPlantsFrom_Other)</a>
                </p>
            }

            @if (message is not null)
            {
                <p class="action-message" role="status">
                    @message
                    @foreach (var plant in madePlants)
                    {
                        <a class="ms-1" href="plants/@plant.Id">@plant.DisplayName</a>
                    }
                    @if (madePlants.Count > 0)
                    {
                        <span class="ms-2">· <a href="labels?plants=@string.Join(',', madePlants.Select(p => p.Id))">@(madePlants.Count == 1 ? Strings.Propagations.DetPrintLabel : Strings.Propagations.DetPrintLabels)</a></span>
                    }
                </p>
            }

            <div class="profile-links">
                <button type="button" class="btn btn-link btn-sm link-action details-toggle" aria-expanded="@(detailsOpen ? "true" : "false")"
                        aria-controls="propagation-details" @onclick="() => detailsOpen = !detailsOpen">
                    @Strings.Propagations.DetDetails
                    <svg class="link-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </button>
                <a class="btn btn-link btn-sm link-action" href="propagations/@propagation.Id/edit">@Strings.Common.Edit</a>
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="OpenShare">@Strings.Propagations.DetShare</button>
            </div>

            <div id="propagation-details" class="profile-details @(detailsOpen ? "open" : null)">
                <section class="detail-card">
                    <dl class="detail-list">
                        <dt>@(parent is null ? Strings.Propagations.DetCameFrom : Strings.Propagations.EditTakenFrom)</dt>
                        <dd>
                            @if (parent is not null)
                            {
                                <a href="plants/@parent.Id">@parent.DisplayName</a>
                            }
                            else if (sellers.For(propagation.SellerId, propagation.Source) is { } seller)
                            {
                                <a href="sellers/@seller.Id">@seller.Name</a>
                                @if (Arrival.PoorText(propagation.ArrivedIn, propagation.ArrivalProblems) is { } poor)
                                {
                                    <text> · @poor</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(propagation.ArrivalNote))
                                {
                                    <text>@(propagation.ArrivedIn == ArrivalRating.Poor ? ". " : " · ")@propagation.ArrivalNote.Trim()</text>
                                }
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(propagation.Source) ? Strings.Propagations.DetNoParent : propagation.Source)
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(propagation.Experiment))
                        {
                            <dt>@Strings.Propagations.EditExperiment</dt>
                            <dd><a href="propagations/results">@propagation.Experiment</a></dd>
                        }

                        <dt>@Strings.Propagations.DetStarted</dt>
                        <dd>@Labels.Date(propagation.StartedOn)@(propagation.IsActive ? $" · {Labels.Age(propagation, Today)}" : "")</dd>

                        @if (Pace is { } pace)
                        {
                            <dt>@Strings.Propagations.DetTiming</dt>
                            <dd>
                                <span class="@(pace.IsSlow ? "pace-slow" : "pace-on-time")">@(pace.IsSlow ? Strings.Propagations.DetSlower : Strings.Propagations.DetOnTime)</span>
                                <div class="text-body-secondary small">
                                    @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPace,
                                        pace.Compared, Labels.For(propagation.Type).ToLowerInvariant(), Labels.For(propagation.Medium),
                                        Labels.Stage(PropagationStage.Rooted, propagation.Type).ToLowerInvariant(),
                                        Plural.Of(pace.UsualDays, Strings.Propagations.Days_One, Strings.Propagations.Days_Other))
                                </div>
                            </dd>
                        }

                        @if (propagation.Type != PropagationType.Seed)
                        {
                            @MilestoneRow(Strings.Propagations.EditFirstRoot, propagation.FirstRootOn, propagation.DaysToFirstRoot)
                        }
                        @MilestoneRow(Strings.Propagations.EditFirstLeaf, propagation.FirstLeafOn, propagation.DaysToFirstLeaf)

                        @if (propagation.Type == PropagationType.Corm && propagation.CormSizeMm is { } cormSize)
                        {
                            <dt>@Strings.Propagations.DetCormSize</dt>
                            <dd>@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMm, cormSize.ToString("0.##", CultureInfo.CurrentCulture))</dd>
                        }

                        @if (propagation.Type == PropagationType.Seed && propagation.SeedsGerminated is { } up)
                        {
                            <dt>@Strings.Propagations.DetSeeds</dt>
                            <dd>
                                @(propagation.GerminationRate is { } rate
                                    ? string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetSeedsUpRate, up, propagation.InitialCount, Math.Round(rate * 100).ToString("0", CultureInfo.CurrentCulture))
                                    : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetSeedsUp, up, propagation.InitialCount))
                                @if (propagation.FirstGerminatedOn is { } first)
                                {
                                    <text> · @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetFirstOn, Labels.Date(first))</text>
                                }
                            </dd>
                        }

                        <dt>@Strings.Propagations.DetCount</dt>
                        <dd>@CountText</dd>

                        <dt>@Strings.Propagations.EditGrowsIn</dt>
                        <dd>
                            @Labels.For(propagation.Medium)
                            @if (ContainerName is { } container)
                            {
                                <text> · @container</text>
                            }
                            @if (Mix is { } mix)
                            {
                                <div class="detail-sub">@string.Format(CultureInfo.CurrentCulture, mix.IsRetired ? Strings.Propagations.DetInMixRetired : Strings.Propagations.DetInMix, mix.Name)</div>
                                @if (!string.IsNullOrWhiteSpace(mix.Recipe))
                                {
                                    <div class="detail-sub">@mix.Recipe</div>
                                }
                            }
                        </dd>

                        @if (careBook.IsEmpty is false && !string.IsNullOrWhiteSpace(propagation.Genus))
                        {
                            var careFor = careBook.Find(propagation.Genus, propagation.Species, propagation.NameQualifier);
                            <dt>@Strings.Propagations.DetPets</dt>
                            <dd>
                                @ToxicityText.Pets(careFor)@if (careFor?.PetsFrom is { } petsUrl)
                                {
                                    <text> · <a href="@petsUrl" target="_blank" rel="noopener">@careBook.SourceName(petsUrl)</a></text>
                                }
                                @if (ToxicityText.People(careFor) is { } peopleText)
                                {
                                    <div class="detail-sub">@peopleText@if (careFor?.PeopleFrom is { } peopleUrl)
                                    {
                                        <text> · <a href="@peopleUrl" target="_blank" rel="noopener">@careBook.SourceName(peopleUrl)</a></text>
                                    }</div>
                                }
                            </dd>
                        }

                        @if (lastWatered is { } watered)
                        {
                            <dt>@Strings.Propagations.DetLastWatered</dt>
                            <dd>@Labels.Date(watered.Day)</dd>
                        }
                        @if (lastWaterChange is { } changed)
                        {
                            <dt>@Strings.Propagations.DetWaterChanged</dt>
                            <dd>@Labels.Date(changed.Day)</dd>
                        }

                        @if (propagation.RootingAids.Count > 0)
                        {
                            <dt>@Strings.Propagations.EditAids</dt>
                            <dd>@string.Join(", ", propagation.RootingAids.Order().Select(Labels.For))</dd>
                        }
                        @if (propagation.DriedForHours is { } dried)
                        {
                            <dt>@Strings.Propagations.DetCutEndDried</dt>
                            <dd>@Drying.Shown(dried)</dd>
                        }

                        <dt>@Strings.Propagations.DetLocation</dt>
                        <dd>@(places.NameOf(propagation.PlaceId) ?? Strings.Propagations.DetNotSet)</dd>

                        @if (propagation.DormantSince is { } dormantSince)
                        {
                            <dt>@Strings.Propagations.CardDormant</dt>
                            <dd>@(dormantSince == Today ? Strings.Propagations.DetSinceToday : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetSinceDate, Labels.Date(dormantSince), Plural.Of(propagation.DaysDormant(Today) ?? 0, Strings.Propagations.Days_One, Strings.Propagations.Days_Other)))</dd>
                        }

                        <PublicPageRow SubjectId="propagation.Id" />
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(propagation.Notes))
                    {
                        <h2>@Strings.Propagations.EditAbout</h2>
                        <p class="detail-notes">@propagation.Notes</p>
                    }

                    <ReferencePhotoAdd SubjectType="SubjectType.Propagation" SubjectId="propagation.Id" OnAdded="() => historyVersion++" />
                </section>

                @if (offspring.Count > 0 && propagation.IsActive)
                {
                    <section class="detail-card" id="propagation-plants">
                        <h2>@Strings.Propagations.DetPlantsFromHeading</h2>
                        <ul class="family-list">
                            @foreach (var plant in offspring)
                            {
                                <li>
                                    <a href="plants/@plant.Id">@plant.DisplayName</a>
                                    @if (!plant.InCollection)
                                    {
                                        <span class="text-body-secondary small"> · @Labels.StatusOf(plant)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }

                <section class="danger-zone">
                    @if (confirmDelete)
                    {
                        <p class="mb-2">
                            @((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetConfirmDelete, System.Net.WebUtility.HtmlEncode(propagation.DisplayName)))
                        </p>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                        <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">@Strings.Propagations.DetDelete</button>
                    }
                </section>
            </div>
        </div>

        <div class="profile-history">
            <div class="page-dock" role="group" aria-label="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetAddTo, propagation.DisplayName)">
                @if (googleOn)
                {
                    <button type="button" class="btn btn-primary icon-btn" @onclick="() => photoChoice = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        @Strings.Propagations.TlKindPhoto
                    </button>
                }
                else
                {
                    <label class="btn btn-primary icon-btn" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        @Strings.Propagations.TlKindPhoto
                    </label>
                }
                <button type="button" class="btn btn-outline-primary icon-btn" @onclick="() => composer?.OpenNote()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17Z" /></svg>
                    @Strings.Propagations.TlKindNote
                </button>
                @if (propagation.IsActive)
                {
                    <button type="button" class="btn btn-outline-primary icon-btn dock-care" aria-label="@Strings.Propagations.DetCare" @onclick="() => careOpen = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c3 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2.5-6 5.5-10Z" /></svg>
                        <span class="dock-label">@Strings.Propagations.DetCare</span>
                    </button>
                    <button type="button" class="btn btn-outline-primary icon-btn dock-stage" data-tour="stage" aria-label="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetStageButtonLabel, Labels.Stage(propagation.Stage, propagation.Type))" @onclick="OpenStage">
                        <span class="stage-steps" data-step="@StageStep" aria-hidden="true"><i></i><i></i><i></i></span>
                        @Labels.Stage(propagation.Stage, propagation.Type)
                    </button>
                    <button type="button" class="btn btn-outline-primary dock-more" aria-label="@Strings.Propagations.DetMoreLabel" @onclick="() => more = More.Menu">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg>
                    </button>
                }
            </div>

            @if (Arrived)
            {
                <ArrivedNote SubjectId="propagation.Id" />
            }

            @if (Made)
            {
                <MadeNote PropagationId="propagation.Id" />
            }

            @* The key reloads the history after stage changes and potting up *@
            <Timeline @key="historyVersion" @ref="timeline" SubjectType="SubjectType.Propagation" SubjectId="propagation.Id"
                      CoverPhotoId="ShownCover" OnCoverChanged="SetCoverAsync" PhotoAge="day => PhotoDayCount.DayLabel(PhotoDayCount.StartOf(propagation), day)"
                      EmptyText="@Strings.Propagations.DetEmptyTimeline" />
        </div>
    </div>

    <ShareSheet Open="shareOpen" OpenChanged="open => shareOpen = open" Tone="propagation" SubjectId="propagation.Id" StartOnLink="shareOnLink"
                CoverPhotoId="ShownCover" PhotoAge="day => PhotoDayCount.DayLabel(PhotoDayCount.StartOf(propagation), day)" Text="ShareCardText.ForPropagation(propagation, parent, Today)" />

    <EntryComposer @key="propagation.Id" @ref="composer" SubjectType="SubjectType.Propagation" SubjectId="propagation.Id" PhotoInputId="@photoInputId" OnPicked="() => photoChoice = false"
                   CoverPhotoId="ShownCover" OnCoverChanged="SetCoverAsync" OnAdded="() => historyVersion++" />

    @if (googleOn)
    {
        <Sheet Title="@Strings.Propagations.ComposerTitlePhoto" Open="photoChoice" OpenChanged="open => photoChoice = open">
            <ul class="sheet-actions">
                <li>
                    <label class="sheet-action" for="@photoInputId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        <span class="sheet-action-text"><b>@Strings.Propagations.DetFromDevice</b><small>@Strings.Propagations.DetFromDeviceHint</small></span>
                    </label>
                </li>
                <li>
                    <button type="button" class="sheet-action" @onclick="PickFromGoogleAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                        <span class="sheet-action-text"><b>@Strings.Propagations.DetFromGoogle</b><small>@Strings.Propagations.DetFromGoogleHint</small></span>
                    </button>
                </li>
            </ul>
        </Sheet>
    }

    <ShowFound ElementId="@(Entry is { } found ? $"entry-{found}" : null)" Ready="@loaded" />

    @if (propagation.IsActive)
    {
        <Sheet Title="@Strings.Propagations.DetCare" Open="careOpen" OpenChanged="open => careOpen = open">
            <PropagationCareSheet Propagation="propagation" Logs="careLogs" OnLogged="CareLoggedAsync" OnRemoved="LoadAsync" />
        </Sheet>

        <Sheet Title="@StageTitle" Open="stageView != StageView.None" OpenChanged="open => { if (!open) stageView = StageView.None; }">
            @switch (stageView)
            {
                case StageView.Stage:
                    <InfoButton Topic="@Strings.Propagations.DetTopicStage">
                        <Label><span class="form-label mb-0">@Strings.Propagations.DetStage</span></Label>
                        <ChildContent>
                            @if (propagation.Type == PropagationType.Seed)
                            {
                                <text>@Strings.Propagations.DetStageHelpSeed</text>
                            }
                            else
                            {
                                <text>@Strings.Propagations.DetStageHelp</text>
                            }
                        </ChildContent>
                    </InfoButton>
                    <div class="btn-group segmented stage-track mb-3" role="radiogroup" aria-label="@Strings.Propagations.DetStage">
                        @foreach (var stage in ManualStages)
                        {
                            var id = $"stage-{stage}";
                            <input type="radio" class="btn-check" name="stage" id="@id" disabled="@busy"
                                   checked="@(propagation.Stage == stage)" @onchange="() => SetStageAsync(stage)" />
                            <label class="btn btn-outline-primary @(stage < propagation.Stage ? "passed" : null)" for="@id">@Labels.Stage(stage, propagation.Type)</label>
                        }
                    </div>

                    <dl class="detail-list mb-2">
                        <dt>@Strings.Propagations.DetStarted</dt>
                        <dd>@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDateDay, Labels.Date(propagation.StartedOn), propagation.DaysSinceStart(Today))</dd>

                        @if (propagation.Type == PropagationType.Seed)
                        {
                            <dt>@Strings.Propagations.DetFirstSeedlingUp</dt>
                            <dd>
                                @if (propagation.FirstGerminatedOn is { } germinated)
                                {
                                    @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDateDay, Labels.Date(germinated), Math.Max(0, germinated.DayNumber - propagation.StartedOn.DayNumber))
                                }
                                else
                                {
                                    <span class="text-body-secondary">@Strings.Propagations.DetNotYet</span>
                                }
                            </dd>
                        }
                        else
                        {
                            <dt>@Strings.Propagations.EditFirstRoot</dt>
                            <dd>
                                @if (propagation.FirstRootOn is { } root)
                                {
                                    @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDateDay, Labels.Date(root), propagation.DaysToFirstRoot)
                                }
                                else
                                {
                                    <span class="text-body-secondary">@Strings.Propagations.DetNotYet</span>
                                }
                            </dd>
                        }

                        <dt>@Strings.Propagations.EditFirstLeaf</dt>
                        <dd>
                            @if (propagation.FirstLeafOn is { } leaf)
                            {
                                @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDateDay, Labels.Date(leaf), propagation.DaysToFirstLeaf)
                            }
                            else
                            {
                                <span class="text-body-secondary">@Strings.Propagations.DetNotYet</span>
                                <button type="button" class="btn btn-link btn-sm link-action ms-2 align-baseline" disabled="@busy"
                                        @onclick="RecordFirstLeafAsync">@Strings.Propagations.DetSawLeaf</button>
                            }
                        </dd>

                        @if (propagation.RootedOn is { } rootedOn)
                        {
                            <dt>@Strings.Propagations.EditRootedOn</dt>
                            <dd>@Labels.Date(rootedOn)</dd>
                        }
                    </dl>
                    <p class="form-text mb-3">@((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetWrongDate, $"<a href=\"propagations/{propagation.Id}/edit\">{System.Net.WebUtility.HtmlEncode(Strings.Common.Edit)}</a>"))</p>

                    <div class="sheet-section">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary flex-fill" @onclick="OpenPotUp">@PotUpWord</button>
                            <button type="button" class="btn btn-outline-danger flex-fill" @onclick="OpenFailed">@Strings.Propagations.DetMarkFailed</button>
                        </div>
                        <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="OpenGaveAway">
                            @(propagation.RemainingCount == 1 ? Strings.Propagations.DetGaveIt : Strings.Propagations.DetGaveSome)
                        </button>
                    </div>
                    break;

                case StageView.PotUp:
                    var up = potUp!;
                    @if (InPlantMedium)
                    {
                        <p class="form-text mb-3">
                            @string.Format(CultureInfo.CurrentCulture, propagation.RemainingCount > 1 ? Strings.Propagations.DetPotUpEachMedium : Strings.Propagations.DetPotUpOneMedium, Labels.MediumWord(propagation.Medium))
                            @Strings.Propagations.DetKeepsHistory
                        </p>
                    }
                    else
                    {
                        <p class="form-text mb-3">
                            @(propagation.RemainingCount > 1 ? Strings.Propagations.DetPotUpEach : Strings.Propagations.DetPotUpOne)
                            @Strings.Propagations.DetKeepsHistory
                        </p>
                    }
                    <InfoButton Topic="@Strings.Propagations.DetTopicPotUp">
                        <Label><span class="form-label mb-0">@Strings.Propagations.DetHowPotted</span></Label>
                        <ChildContent>
                            @Strings.Propagations.DetPotUpHelp
                        </ChildContent>
                    </InfoButton>
                    <div class="mb-3" role="radiogroup" aria-label="@Strings.Propagations.DetHowPotted">
                        @if (propagation.RemainingCount > 1)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="potup-mode" disabled="@up.Retrying" id="potup-each" checked="@(up.EffectiveMode == PotUpKind.Each)" @onchange="() => up.Mode = PotUpKind.Each" />
                                <label class="form-check-label" for="potup-each">@Strings.Propagations.DetEachOwnPot</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="potup-mode" disabled="@up.Retrying" id="potup-one" checked="@(up.EffectiveMode == PotUpKind.OnePot)" @onchange="() => up.Mode = PotUpKind.OnePot" />
                                <label class="form-check-label" for="potup-one">@Strings.Propagations.DetAllOnePot</label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="potup-mode" disabled="@up.Retrying" id="potup-each" checked="@(up.EffectiveMode == PotUpKind.Each)" @onchange="() => up.Mode = PotUpKind.Each" />
                                <label class="form-check-label" for="potup-each">@Strings.Propagations.DetOwnPot</label>
                            </div>
                        }
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="potup-mode" disabled="@up.Retrying" id="potup-into" checked="@(up.EffectiveMode == PotUpKind.Into)" @onchange="() => up.Mode = PotUpKind.Into" />
                            <label class="form-check-label" for="potup-into">@Strings.Propagations.DetInto</label>
                        </div>
                    </div>
                    @if (up.EffectiveMode == PotUpKind.Into)
                    {
                        <div class="mb-2">
                            <PlantSelect Id="potup-into-plant" Plants="allPlants" Genus="@(string.IsNullOrWhiteSpace(propagation.Genus) ? parent?.Genus : propagation.Genus)" Value="up.IntoPlantId" ValueChanged="id => up.IntoPlantId = id" />
                            @if (!allPlants.Any(p => p.InCollection))
                            {
                                <div class="form-text">@Strings.Propagations.DetNoPlantsToPotWith</div>
                            }
                            else
                            {
                                <div class="form-text">@Strings.Propagations.DetIntoHint</div>
                            }
                        </div>
                    }
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="potup-count">@HowManyLeft</label>
                            <input id="potup-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" disabled="@up.Retrying" @bind="up.Count" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="potup-name">@Strings.Propagations.EditNickname</label>
                        <input id="potup-name" class="form-control" @bind="up.Nickname" @bind:event="oninput" placeholder="@(propagation.BotanicalName ?? "")" />
                        @if (up.EffectiveMode == PotUpKind.Each && (up.Count > 1 || propagation.PottedUpCount > 0))
                        {
                            <div class="form-text">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetNumbered, string.IsNullOrWhiteSpace(up.Nickname) ? "Coleus" : up.Nickname.Trim(), propagation.PottedUpCount + 1)</div>
                        }
                    </div>
                    @if (up.EffectiveMode != PotUpKind.Into)
                    {
                        @if (InPlantMedium && !up.ChangeMedium)
                        {
                            <button type="button" class="btn btn-link btn-sm link-action p-0 mb-2" @onclick="() => up.ChangeMedium = true">@Strings.Propagations.DetMoved</button>
                        }
                        else
                        {
                            <div class="mb-2">
                                <label class="form-label" for="potup-medium">@Strings.Propagations.EditGrowsIn</label>
                                <select id="potup-medium" class="form-select" value="@up.Medium" @onchange="e => up.PickMedium(Enum.Parse<GrowingMedium>(e.Value?.ToString() ?? nameof(GrowingMedium.Soil)))">
                                    @foreach (var medium in Enum.GetValues<GrowingMedium>())
                                    {
                                        <option value="@medium">@Labels.For(medium)</option>
                                    }
                                </select>
                            </div>
                            @if (up.Medium == GrowingMedium.Soil)
                            {
                                <div class="mb-2">
                                    <MixPicker @bind-Value="up.SoilMixId" Mixes="mixes" />
                                </div>
                            }
                        }
                        <div class="mb-2">
                            <PotPicker Value="up.PotId" ValueChanged="id => up.PickPot(id, pots.FirstOrDefault(p => p.Id == id))" Pots="pots" Groups="InnerSlot" PotAdded="AddPot" />
                            @if (PotSizeChange.Between(new ContainerList(pots).For(propagation.ContainerPotId, propagation.Container), pots.FirstOrDefault(p => p.Id == up.PotId), potUpWarnCm) is { } sizeChange)
                            {
                                <div class="form-text">@sizeChange.Text</div>
                            }
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="potup-date">@Strings.Propagations.DetDate</label>
                        <input id="potup-date" type="date" class="form-control" @bind="up.Date" min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    @if (up.EffectiveMode != PotUpKind.Into)
                    {
                        <div class="mb-3">
                            <RoomPicker @bind-Value="up.Location" Rooms="rooms" Label="@Strings.Propagations.DetWhereGoes" />
                        </div>
                    }
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@(busy || !up.CanSave)" @onclick="PotUpAsync">
                            @(InPlantMedium
                                ? (up.Count == 1 ? PotUpWord : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMakePlants, up.Count))
                                : (up.Count == 1 ? PotUpWord : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetPotUpN, up.Count)))
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">@Strings.Common.Back</button>
                    </div>
                    break;

                case StageView.Failed:
                    var fail = failed!;
                    <p class="form-text mb-3">
                        @Strings.Propagations.DetFailedHint
                        @if (fail.Finishes)
                        {
                            <text> @Strings.Propagations.DetFinishes</text>
                        }
                    </p>
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="failed-count">@HowManyLeft</label>
                            <input id="failed-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" @bind="fail.Count" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <span class="form-label d-block" id="failed-why-label">@Strings.Propagations.DetWhy <span class="text-body-secondary">@Strings.Propagations.DetOptional</span></span>
                        <div class="chip-row" role="group" aria-labelledby="failed-why-label">
                            @foreach (var why in Enum.GetValues<FailReason>())
                            {
                                var picked = fail.Reason == why;
                                <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                        @onclick="() => fail.Reason = picked ? null : why">@FailReasons.Chip(why)</button>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="failed-note">@Strings.Propagations.TlKindNote <span class="text-body-secondary">@Strings.Propagations.DetOptional</span></label>
                        <input id="failed-note" class="form-control" @bind="fail.Note" @bind:event="oninput" placeholder="@Strings.Propagations.DetFailedNotePlaceholder" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="failed-date">@Strings.Propagations.DetDate</label>
                        <input id="failed-date" type="date" class="form-control" @bind="fail.Date"
                               min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-danger" disabled="@(busy || !fail.CountIsValid)" @onclick="MarkFailedAsync">
                            @(fail.Count == 1 ? Strings.Propagations.DetMarkAsFailed : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkNFailed, fail.Count))
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">@Strings.Common.Back</button>
                    </div>
                    break;

                case StageView.GaveAway:
                    var giving = this.gave!;
                    <p class="form-text mb-3">
                        @Strings.Propagations.DetGaveHint
                        @if (giving.Finishes)
                        {
                            <text> @Strings.Propagations.DetFinishes</text>
                        }
                    </p>
                    @if (propagation.RemainingCount > 1)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="gave-count">@HowManyLeft</label>
                            <input id="gave-count" type="number" class="form-control" min="1" max="@propagation.RemainingCount"
                                   inputmode="numeric" @bind="giving.Count" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="gave-to">@Strings.Propagations.DetWhoGot <span class="text-body-secondary">@Strings.Propagations.DetOptional</span></label>
                        <input id="gave-to" class="form-control" @bind="giving.To" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="gave-date">@Strings.Propagations.DetDate</label>
                        <input id="gave-date" type="date" class="form-control" @bind="giving.Date"
                               min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@(busy || !giving.CountIsValid)" @onclick="GiveAwayAsync">
                            @(giving.Count == 1 ? Strings.Propagations.DetMarkAsGiven : string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetMarkNGiven, giving.Count))
                        </button>
                        <button type="button" class="btn btn-link" @onclick="() => stageView = StageView.Stage">@Strings.Common.Back</button>
                    </div>
                    break;

                case StageView.PassOn:
                    <PassOnPanel SubjectType="SubjectType.Propagation" SubjectId="propagation.Id" Name="@propagation.DisplayName"
                                 OnDone="() => stageView = StageView.None" OnChangePage="ChangePassOnPage" />
                    break;
            }
        </Sheet>

        <Sheet Title="@MoreTitle" Open="more != More.None" OpenChanged="open => { if (!open) more = More.None; }">
            @switch (more)
            {
                case More.Menu:
                    <ul class="sheet-actions">
                        <li>
                            <button type="button" class="sheet-action" @onclick="() => more = More.Flag">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4" /><path d="M5 4h12l-2.5 4.5L17 13H5" /></svg>
                                <span class="sheet-action-text"><b>@(propagation.Attention is null ? Strings.Propagations.AttentionFlagIt : Strings.Propagations.DetChangeFlag)</b><small>@Strings.Propagations.DetFlagHint</small></span>
                            </button>
                        </li>
                        @if (propagation.IsActive)
                        {
                            <li>
                                <button type="button" class="sheet-action" @onclick="OpenSwap">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h11l-3-3M17 17H6l3 3" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.Propagations.EditSwap</b><small>@(propagation.SpareAvailable > 0 ? string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetOffered, propagation.SpareAvailable) : Strings.Propagations.DetOfferSome)</small></span>
                                </button>
                            </li>
                        }
                        <li>
                            <a class="sheet-action" href="labels?cuttings=@propagation.Id">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9Z" /><circle cx="8" cy="8" r="1.4" /></svg>
                                <span class="sheet-action-text"><b>@Strings.Propagations.DetPrintLabelMenu</b><small>@Strings.Propagations.DetPrintLabelHint</small></span>
                            </a>
                        </li>
                        <li>
                            @if (propagation.IsDormant)
                            {
                                <button type="button" class="sheet-action" disabled="@busy" @onclick="EndDormancyAsync">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.Propagations.DetWokenUp</b><small>@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDormantFor, DaysLabel(propagation.DaysDormant(Today)))</small></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="sheet-action" @onclick="OpenDormant">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
                                    <span class="sheet-action-text"><b>@Strings.Propagations.CardDormant</b><small>@Strings.Propagations.DetDormantHint</small></span>
                                </button>
                            }
                        </li>
                    </ul>
                    break;

                case More.Swap:
                    <div class="mb-3">
                        <label class="form-label" for="spare-count">@Strings.Propagations.EditSpare</label>
                        <input id="spare-count" type="number" class="form-control" inputmode="numeric" min="0" max="@propagation.RemainingCount"
                               @bind="swapCount" />
                        <div class="form-text">@((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetSwapHint, propagation.RemainingCount, $"<a href=\"swap\">{System.Net.WebUtility.HtmlEncode(Strings.Propagations.ListSwapLink)}</a>"))</div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetSpareAsync">@Strings.Common.Save</button>
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                    </div>
                    break;

                case More.Flag:
                    <AttentionPanel Current="propagation.Attention" Later="propagation.AttentionLater" NextRoundDay="nextRoundDay" Editing="true" EditingChanged="_ => more = More.None"
                                    Suggestions="AttentionPanel.PropagationReasons" OnSave="SetAttentionAsync" />
                    break;

                case More.Dormant:
                    <div class="mb-3">
                        <label class="form-label" for="dormant-since">@Strings.Propagations.DetSince</label>
                        <input id="dormant-since" type="date" class="form-control" @bind="since" max="@Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text">@Strings.Propagations.DetDormantHelp</div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SetDormantAsync">@Strings.Propagations.DetMarkDormant</button>
                        <button type="button" class="btn btn-link" @onclick="() => more = More.Menu">@Strings.Common.Back</button>
                    </div>
                    break;
            }
        </Sheet>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Set by the page that keeps a received history, so the first visit says where it went.</summary>
    [SupplyParameterFromQuery(Name = "arrived")]
    public bool Arrived { get; set; }

    /// <summary>Set when the propagation was just started, so the first visit offers a label for the jar.</summary>
    [SupplyParameterFromQuery(Name = "made")]
    public bool Made { get; set; }

    /// <summary>A history or care entry to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "entry")]
    public Guid? Entry { get; set; }

    private enum StageView { None, Stage, PotUp, Failed, GaveAway, PassOn }

    private enum More { None, Menu, Flag, Dormant, Swap }
    private bool shareOpen;
    private bool shareOnLink;

    private IReadOnlyList<Plant> allPlants = [];

    private static readonly PotGroup[] InnerSlot = [PotGroup.Inner, PotGroup.Standalone];

    private static readonly PropagationStage[] ManualStages =
        [PropagationStage.Started, PropagationStage.Rooting, PropagationStage.Rooted];

    private Propagation? propagation;
    private IReadOnlyList<Propagation> allPropagations = [];
    private Plant? parent;
    private IReadOnlyList<Plant> offspring = [];
    private IReadOnlyList<CodeClash> numberClashes = [];
    private IReadOnlyList<Room> rooms = [];
    private Places places = Places.None;
    private SellerList sellers = SellerList.None;
    private PropagationOutcome? outcome;
    private IReadOnlyList<Pot> pots = [];
    private IReadOnlyList<SoilMix> mixes = [];

    private SoilMix? Mix => propagation?.SoilMixId is { } id ? mixes.FirstOrDefault(m => m.Id == id && !m.IsDeleted) : null;

    private void AddPot(Pot pot) => pots = [.. pots, pot];

    // The container's name as it is in the pot library now, so a rename there shows here. The text is
    // kept for a container that was deleted or never linked
    private string? ContainerName =>
        propagation is null ? null
        : new ContainerList(pots).For(propagation.ContainerPotId, propagation.Container)?.Name
          ?? (string.IsNullOrWhiteSpace(propagation.Container) ? null : propagation.Container);
    private bool loaded;
    private bool busy;
    private bool confirmDelete;
    private bool detailsOpen;
    private bool scrollToPlants;
    private int historyVersion;

    // A cover that is a reference photo shows as no cover. The propagation itself isn't changed.
    private Guid? ShownCover => Covers.Shown(propagation?.CoverPhotoId);
    private EntryComposer? composer;
    private bool googleOn;
    private bool photoChoice;
    private Timeline? timeline;
    private readonly string photoInputId = $"propagation-photo-{Guid.NewGuid():N}";

    private bool careOpen;
    private IReadOnlyList<PropagationCareLog> careLogs = [];
    private PropagationCareLatest? lastWatered;
    private PropagationCareLatest? lastWaterChange;

    private StageView stageView;
    private More more;
    private DateOnly since;
    private PotUpForm? potUp;
    private FailedForm? failed;
    private GiveAwayForm? gave;
    private string? message;
    private IReadOnlyList<Plant> madePlants = [];

    private DateOnly Today => Time.Today();

    // With no photo, the tile at the top shows the days, so the line under the name needn't
    private bool TileShowsDays => propagation is { IsActive: true } && ShownCover is null;

    private RootingPace? Pace => propagation is null ? null : RootingPace.For(propagation, allPropagations, Today);

    // The same count as the ticks on the stage badge
    private int StageStep => propagation?.Stage switch
    {
        PropagationStage.Started => 1,
        PropagationStage.Rooting => 2,
        PropagationStage.Failed => 0,
        _ => 3
    };

    private string StageTitle => stageView switch
    {
        StageView.PotUp => PotUpWord,
        StageView.Failed => Strings.Propagations.DetMarkAsFailed,
        StageView.GaveAway => Strings.Propagations.DetGaveSome,
        StageView.PassOn => Strings.Propagations.DetSendHistory,
        _ => Strings.Propagations.EditHowFar,
    };

    // A propagation already in soil, bark, LECA or PON is a plant in all but name, so there is nothing to pot up
    private bool InPlantMedium => propagation?.InPlantMedium == true;

    private string PotUpWord => InPlantMedium ? Strings.Propagations.DetPlantNow : Strings.Propagations.DetPotUp;

    private string MoreTitle => more switch
    {
        More.Flag => propagation?.Attention is null ? Strings.Propagations.AttentionFlagIt : Strings.Propagations.DetChangeFlag,
        More.Dormant => Strings.Propagations.CardDormant,
        More.Swap => Strings.Propagations.EditSwap,
        _ => propagation?.DisplayName ?? "",
    };

    private static string DaysLabel(int? days) => days is null or 0 ? Strings.Propagations.DetSinceTodayLower : Plural.Of(days.Value, Strings.Propagations.DetForDays_One, Strings.Propagations.DetForDays_Other);

    private string HowManyLeft => string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetHowManyLeft, propagation!.RemainingCount);

    // Only the date, or "Not yet". Recording a milestone happens in the stage sheet.
    private RenderFragment MilestoneRow(string name, DateOnly? date, int? days) => __builder =>
    {
        if (date is null && !propagation!.IsActive)
            return;
        <dt>@name</dt>
        <dd>
            @if (date is { } on)
            {
                @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetDateDay, Labels.Date(on), days)
            }
            else
            {
                <span class="text-body-secondary">@Strings.Propagations.DetNotYet</span>
            }
        </dd>
    };

    private string CountText
    {
        get
        {
            var p = propagation!;
            var parts = new List<string> { string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetCountStarted, p.InitialCount) };
            if (p.PottedUpCount > 0) parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetCountPotted, p.PottedUpCount));
            if (p.GivenAwayCount > 0) parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetCountGiven, p.GivenAwayCount));
            if (p.FailedCount > 0) parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.DetCountFailed, p.FailedCount));
            if (p.IsActive && p.RemainingCount != p.InitialCount) parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.CardLeft, p.RemainingCount));
            return string.Join(" · ", parts);
        }
    }

