@page "/dictionary/cultivar/{Genus}/{Name}"
@layout WideLayout
@inject DictionaryService Dictionary

<PageTitle>@F(Strings.PlantDetail.PageTitle, entry is null ? Strings.Dictionary.Title : $"{entry.Name} · {entry.Genus}")</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

@if (browser is null)
{
    <a class="back-link" href="@DictionaryLinks.Index">@Strings.Dictionary.Title</a>
    <h1>@Strings.Dictionary.Title</h1>
    <p class="text-body-secondary">@Strings.Plants.Loading</p>
}
else if (ReferenceEquals(browser, DictionaryBrowser.Empty))
{
    <a class="back-link" href="@DictionaryLinks.Index">@Strings.Dictionary.Title</a>
    <h1>@Strings.Dictionary.Title</h1>
    <div class="empty-state mt-3">
        <p>@Strings.Dictionary.CouldNotLoad</p>
    </div>
}
else if (entry is null)
{
    <a class="back-link" href="@DictionaryLinks.Index">@Strings.Dictionary.Title</a>
    <h1>@Strings.Dictionary.Title</h1>
    <div class="empty-state mt-3">
        <p>@Strings.Dictionary.NotFound</p>
        @if (browser.Genus(Genus ?? "") is { } genusEntry)
        {
            <a class="btn btn-outline-primary mt-3" href="@DictionaryLinks.Genus(genusEntry.Name)"><i>@genusEntry.Name</i></a>
        }
        else
        {
            <a class="btn btn-outline-primary mt-3" href="@DictionaryLinks.Index">@Strings.Dictionary.BackToDictionary</a>
        }
    </div>
}
else
{
    var latin = entry.Species is null ? entry.Genus : $"{entry.Genus} {entry.Species}";
    var up = entry.Species is not null && browser.Species(entry.Genus, entry.Species) is not null
        ? DictionaryLinks.Species(entry.Genus, entry.Species)
        : DictionaryLinks.Genus(entry.Genus);
    <a class="back-link" href="@up"><i>@latin</i></a>

    <DictionaryEntry Name="@($"'{entry.Name}' {latin}")" Genus="@entry.Genus" Species="@entry.Species" Cultivar="@entry.Name" Yours="yours">
        <Title><BotanicalName Cultivar="@entry.Name" /></Title>
        <Subtitle>
            <p class="detail-sub"><a href="@up"><i>@latin</i></a></p>
            @if (entry.Everyday is { } called)
            {
                <p class="detail-sub everyday-name">@called</p>
            }
        </Subtitle>
        <Facts>
            @if (entry.Family is { } family)
            {
                <dt>@Strings.Dictionary.FactFamily</dt>
                <dd><a href="@DictionaryLinks.Family(family)">@family</a></dd>
            }
            <dt>@Strings.Dictionary.FactGroup</dt>
            <dd><a href="@DictionaryLinks.Group(entry.Group)">@DictionaryLinks.Label(entry.Group)</a></dd>
        </Facts>
    </DictionaryEntry>
}

@code {
    [Parameter]
    public string? Genus { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [SupplyParameterFromQuery(Name = "species")]
    public string? SpeciesName { get; set; }

    private DictionaryBrowser? browser;
    private CultivarEntry? entry;
    private Yours? yours;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        browser = await Dictionary.GetBrowserAsync();
        entry = browser.Cultivar(Genus ?? "", Name ?? "", SpeciesName);
        yours = entry is null ? null : await Dictionary.GetYoursAsync(entry.Genus, entry.Species, entry.Name);
    }
}
