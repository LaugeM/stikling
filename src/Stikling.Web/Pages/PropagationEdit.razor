@page "/propagations/new"
@page "/propagations/{Id:guid}/edit"
@inject PropagationForms Forms
@inject ILogger<PropagationEdit> Logger
@inject PropagationService PropagationService
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject PhotoService Photos
@inject GooglePhotosService Google
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(IsNew ? "Start propagation" : "Edit propagation") · Stikling</PageTitle>

<a class="back-link" href="@BackUrl">Back</a>
<h1>@(IsNew ? "Start propagation" : "Edit propagation")</h1>

@if (propagation is null)
{
    <p class="text-body-secondary">@(notFound ? "That propagation doesn't exist." : "Loading…")</p>
}
else
{
    <EditForm Model="propagation" OnSubmit="SaveAsync" class="edit-form" novalidate>
        @if (errors.Count > 0)
        {
            <div id="form-errors" class="alert alert-danger" role="alert" tabindex="-1">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        @if (IsNew)
        {
            <p class="form-text">A cutting, corm, seeds or anything else you're growing into a new plant.</p>
        }

        <fieldset>
            <legend>What you're propagating</legend>
            <div class="mb-3">
                <label class="form-label" for="parent">Taken from</label>
                <InputSelect id="parent" class="form-select" @bind-Value="propagation.ParentPlantId" @bind-Value:after="form!.ParentChanged">
                    <option value="">No parent plant (e.g. bought seeds)</option>
                    @foreach (var p in form!.Plants)
                    {
                        <option value="@p.Id">@p.DisplayName</option>
                    }
                </InputSelect>
            </div>
            @if (propagation.ParentPlantId is null)
            {
                <div class="mb-3">
                    <SellerPicker @bind-Value="form!.SellerText" Names="sellerNames" Placeholder="e.g. Seed shop, a friend" />
                </div>
            }
            <div class="mb-1">
                <label class="form-label" for="collection-number">Collection number</label>
                <input id="collection-number" class="form-control" autocomplete="off"
                           @bind="propagation.CollectionNumber" @bind:event="oninput" placeholder="e.g. 117a"
                           aria-invalid="@(NumberInvalid ? "true" : null)" />
                @if (NumberInvalid)
                {
                    <div class="form-text text-danger">@CollectionNumbers.NotValidText</div>
                }
                else if (NumberClashes is { Count: > 0 } clashes)
                {
                    <div class="form-text">@CollectionNumbers.ClashNote(NumberCode!, clashes)</div>
                }
                else
                {
                    <div class="form-text">The number on its label, like 117a for a cutting from plant 117. Optional.</div>
                }
            </div>
        </fieldset>

        <fieldset>
            <legend>Name</legend>
            @if (NameCollapsed)
            {
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <span>Named <b>@propagation.DisplayName</b></span>
                    <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => nameExpanded = true">Change name</button>
                </div>
            }
            else
            {
                <PlantNameFields @bind-Genus="propagation.Genus" @bind-Species="propagation.Species" @bind-Cultivar="propagation.Cultivar"
                                 @bind-Qualifier="propagation.NameQualifier" @bind-Note="propagation.NameNote"
                                 GenusPlaceholder="e.g. Alocasia" SpeciesPlaceholder="e.g. zebrina" CultivarPlaceholder="" />
                <div class="mt-3">
                    <label class="form-label" for="nickname">Nickname</label>
                    <InputText id="nickname" class="form-control" @bind-Value="propagation.Nickname" placeholder="e.g. Corm test: perlite" />
                </div>
                <div class="form-text">
                    @(propagation.ParentPlantId is null ? "" : "Filled in from the parent plant. ")Give it a genus, a nickname, or both.
                </div>
                @if (form!.WishHere is not null)
                {
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="mark-wish-got" @bind="form!.MarkWishGot" />
                        <label class="form-check-label" for="mark-wish-got">On your wishlist: mark it got</label>
                    </div>
                }
            }
        </fieldset>

        @if (form!.LastTimeMatch is { } lastTime)
        {
            <div class="last-time d-flex align-items-center justify-content-between gap-2 mb-3">
                <span>Like last time: @LastTimeText(lastTime)</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => form.UseLastTime(lastTime)">Use</button>
            </div>
        }

        <fieldset>
            <legend>How you started it</legend>
            <div class="row g-2 mb-3">
                <div class="col-7">
                    <label class="form-label" for="type">Type</label>
                    <InputSelect id="type" class="form-select" @bind-Value="propagation.Type"
                                 aria-describedby="@(Labels.Explain(propagation.Type) is null ? null : "type-help")">
                        @foreach (var type in Enum.GetValues<PropagationType>())
                        {
                            <option value="@type">@Labels.For(type)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-5">
                    <label class="form-label" for="count">How many</label>
                    <InputNumber id="count" class="form-control" @bind-Value="propagation.InitialCount" min="@form!.MinCount" inputmode="numeric" />
                </div>
                @if (Labels.Explain(propagation.Type) is { } typeHelp)
                {
                    <div id="type-help" class="form-text">@typeHelp</div>
                }
                @if (IsNew && propagation.Type is PropagationType.Offset or PropagationType.Division)
                {
                    <div class="form-text">
                        Has it got its own roots already? Then it's a plant.
                        <a href="@(propagation.ParentPlantId is { } parent ? $"plants/new?parent={parent}" : "plants/new")">Add it as a plant</a> instead.
                    </div>
                }
            </div>
            <div class="mb-1">
                <label class="form-label" for="started">Started on</label>
                <InputDate id="started" class="form-control" @bind-Value="propagation.StartedOn" max="@Today.ToString("yyyy-MM-dd")" />
                @if (dateFromPhotos is { } fromPhotos && propagation.StartedOn == fromPhotos)
                {
                    <div class="form-text">
                        Set to the day of the oldest photo, so the photos come after it in the history.
                        <button type="button" class="btn btn-link btn-sm link-action" @onclick="KeepToday">Use today instead</button>
                    </div>
                }
            </div>
        </fieldset>

        @if (IsNew)
        {
            <fieldset>
                <legend>Photo</legend>
                @if (photos.Count > 0)
                {
                    <div class="photo-picks">
                        @foreach (var photo in photos)
                        {
                            <div class="photo-pick">
                                <PhotoImage PhotoId="photo.Id" Alt="Photo of the new propagation" />
                                <button type="button" class="photo-remove" @onclick="() => RemovePhotoAsync(photo)"
                                        aria-label="Remove photo" title="Remove photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                            </div>
                        }
                    </div>
                }

                <div class="composer-row">
                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@cameraId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        Camera
                    </label>
                    <input id="@cameraId" type="file" accept="image/*" capture="environment" class="visually-hidden"
                           @ref="cameraInput" @onchange="() => AddPhotosAsync(cameraInput, fromCamera: true)" disabled="@busy" />

                    <label class="btn btn-outline-primary btn-sm icon-btn" for="@galleryId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-5 4 4 3-3 4 4" /></svg>
                        Gallery
                    </label>
                    <input id="@galleryId" type="file" accept="image/*" multiple class="visually-hidden"
                           @ref="galleryInput" @onchange="() => AddPhotosAsync(galleryInput, fromCamera: false)" disabled="@busy" />
                    @if (googleOn)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm icon-btn" @onclick="StartGoogleAsync"
                                disabled="@(busy || googleBusy)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a4 4 0 0 1-.7-7.9A5.5 5.5 0 0 1 17 9.5 4.3 4.3 0 0 1 17 18Z" /></svg>
                            Google Photos
                        </button>
                    }
                </div>
                @if (googleOn)
                {
                    <GooglePhotosPick @ref="googlePick" SubjectType="SubjectType.Propagation" SubjectId="propagation!.Id" OnSaved="GoogleSavedAsync" BusyChanged="busy => googleBusy = busy" />
                }

                <div class="form-text">The newest photo becomes the cover. You can add more later on its page.</div>
                @if (photoStatus is not null)
                {
                    <p class="composer-status" role="status">@photoStatus</p>
                }
            </fieldset>
        }

        @if (!IsNew)
        {
            <fieldset>
                <legend>About it</legend>
                @AboutField
            </fieldset>
        }

        <h2 class="section-label">More details</h2>
        <div class="more-details mb-4">
            <FormSection Title="Where it is" Summary="@form!.Location" Open="openWhere">
                <div class="mb-3">
                    <RoomPicker @bind-Value="form!.Location" Rooms="rooms" SpotPlaceholder="e.g. Kitchen window" />
                </div>
            </FormSection>

            @if (ShowArrival)
            {
                <FormSection Title="How it arrived" Summary="@ArrivalFields.Summary(propagation.ArrivedIn, propagation.ArrivalProblems)" Open="openArrival">
                    <ArrivalFields Id="arrival" @bind-Rating="propagation.ArrivedIn" Problems="propagation.ArrivalProblems" @bind-Note="propagation.ArrivalNote" />
                </FormSection>
            }

            <FormSection Title="Setup" Summary="@SetupSummary" Open="openSetup">
                <div class="mb-3">
                    <label class="form-label" for="medium">Grows in</label>
                    <InputSelect id="medium" class="form-select" @bind-Value="propagation.Medium"
                                 aria-describedby="@(Labels.Explain(propagation.Medium) is null ? null : "medium-help")">
                        @foreach (var medium in Enum.GetValues<GrowingMedium>())
                        {
                            <option value="@medium">@Labels.For(medium)</option>
                        }
                    </InputSelect>
                    @if (Labels.Explain(propagation.Medium) is { } mediumHelp)
                    {
                        <div id="medium-help" class="form-text">@mediumHelp</div>
                    }
                </div>
                @if (propagation.Medium == GrowingMedium.Soil)
                {
                    <div class="mb-3">
                        <MixPicker @bind-Value="propagation.SoilMixId" Mixes="form!.Mixes" />
                    </div>
                }
                <div class="mb-3">
                    <ContainerPicker @bind-Value="form!.ContainerText" Containers="containerUses" />
                </div>
                <div class="mb-3">
                    <span class="form-label d-block" id="aids-label">Rooting aids</span>
                    <div class="chip-row" role="group" aria-labelledby="aids-label">
                        @foreach (var aid in Enum.GetValues<RootingAid>())
                        {
                            var picked = propagation.RootingAids.Contains(aid);
                            <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                    @onclick="() => ToggleAid(aid)">@Labels.For(aid)</button>
                        }
                    </div>
                    <div class="form-text">Optional. Pick what you used and the results page compares batches with and without it.</div>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="dry-first" checked="@form!.DryFirst" @onchange="DryFirstChanged" />
                        <label class="form-check-label" for="dry-first">Let the cut end dry first</label>
                    </div>
                    @if (form!.DryFirst)
                    {
                        <div class="row g-2 mt-1" role="group" aria-label="How long it dried">
                            <div class="col-5">
                                <input id="dry-amount" type="number" class="form-control" min="1" max="@Drying.MaxAmount" inputmode="numeric" aria-label="How long"
                                       aria-invalid="@(form.DryInvalid ? "true" : null)" value="@form.DryAmount" @onchange="DryAmountChanged" />
                            </div>
                            <div class="col-7">
                                <select id="dry-unit" class="form-select" aria-label="Unit" @onchange="DryUnitChanged">
                                    <option value="hours" selected="@(!form.DryInDays)">hours</option>
                                    <option value="days" selected="@form.DryInDays">days</option>
                                </select>
                            </div>
                            @if (form.DryInvalid)
                            {
                                <div class="form-text text-danger">@PropagationForm.DryMessage</div>
                            }
                        </div>
                    }
                </div>
                @if (propagation.Type == PropagationType.Corm)
                {
                    <div class="mb-3">
                        <label class="form-label" for="corm-size">Corm size (mm)</label>
                        <InputNumber id="corm-size" class="form-control" @bind-Value="propagation.CormSizeMm" min="0" max="200" step="any" inputmode="decimal" />
                        <div class="form-text">Measured across when you started it. Handy for comparing bigger and smaller corms in an experiment.</div>
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label" for="experiment">Experiment</label>
                    <InputText id="experiment" class="form-control" @bind-Value="propagation.Experiment" list="experiment-list"
                               placeholder="e.g. Alocasia corm test" autocomplete="off" />
                    <datalist id="experiment-list">
                        @foreach (var name in experiments)
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                    <div class="form-text">Give batches you started together the same name and they're compared side by side.</div>
                </div>
            </FormSection>

            @if (IsNew)
            {
                <FormSection Title="About it" Summary="@AboutSummary">
                    @AboutField
                </FormSection>
            }

            <FormSection Title="For a plant-sitter" Summary="@SitterSummary" Open="openSitter">
                <div class="mb-3">
                    <label class="form-label" for="sitter-note">Note for a plant-sitter</label>
                    <InputTextArea id="sitter-note" class="form-control" rows="3" @bind-Value="propagation.SitterNote" aria-describedby="sitter-note-help" />
                    <div id="sitter-note-help" class="form-text">Goes on the sheet for whoever looks after your plants while you're away.</div>
                </div>
            </FormSection>

            <FormSection Title="For swap" Summary="@SwapSummary" Open="openSwap">
                <div class="mb-3">
                    <label class="form-label" for="spare-count">Cuttings available for swap</label>
                    <InputNumber id="spare-count" class="form-control" @bind-Value="propagation.SpareCount" min="0" inputmode="numeric" aria-describedby="spare-help" />
                    <div id="spare-help" class="form-text">How many you can spare. It shows on the Available for swap page, never more than what is left, and giving some away takes them off first.</div>
                </div>
            </FormSection>

            <FormSection Title="Progress" Summary="@ProgressSummary" Open="openProgress">
                <div class="mb-3">
                    <label class="form-label" for="stage">How far along</label>
                    <InputSelect id="stage" class="form-select" @bind-Value="propagation.Stage" disabled="@(!propagation.IsActive)">
                        @foreach (var stage in ManualStages)
                        {
                            <option value="@stage">@Labels.Stage(stage, propagation.Type)</option>
                        }
                        @* Done and Failed follow from the counts, so they are only shown, never picked *@
                        @if (!propagation.IsActive)
                        {
                            <option value="@propagation.Stage">@Labels.Stage(propagation.Stage, propagation.Type)</option>
                        }
                    </InputSelect>
                    <div class="form-text">
                        @(propagation.IsActive
                            ? "Already rooting when you write it down? Pick how far along it is."
                            : "It's finished, since none are left.")
                    </div>
                </div>
                @* Only once something has been potted up, given away or failed, so there is a count to correct *@
                @if (form!.Original is { PottedUpCount: > 0 } or { FailedCount: > 0 } or { GivenAwayCount: > 0 })
                {
                    <div class="row g-2 mb-3">
                        <div class="@(ShowGivenAway ? "col-4" : "col-6")">
                            <label class="form-label" for="potted-up">Potted up</label>
                            <InputNumber id="potted-up" class="form-control" @bind-Value="propagation.PottedUpCount" min="@form!.PlantsFromIt" inputmode="numeric" />
                        </div>
                        @if (ShowGivenAway)
                        {
                            <div class="col-4">
                                <label class="form-label" for="given-away">Given away</label>
                                <InputNumber id="given-away" class="form-control" @bind-Value="propagation.GivenAwayCount" min="0" inputmode="numeric" />
                            </div>
                        }
                        <div class="@(ShowGivenAway ? "col-4" : "col-6")">
                            <label class="form-label" for="failed">Failed</label>
                            <InputNumber id="failed" class="form-control" @bind-Value="propagation.FailedCount" min="0" inputmode="numeric" />
                        </div>
                        <div class="form-text">
                            Correct these if one was potted up, given away or marked failed by mistake. Any left over go back to growing.
                            @if (form!.PlantsFromIt > 0)
                            {
                                <text> Plants potted up from it stay in your collection.</text>
                            }
                        </div>
                    </div>
                }
                @if (propagation.Stage == PropagationStage.Rooted || propagation.RootedOn is not null)
                {
                    <div class="mb-3">
                        <label class="form-label" for="rooted">Rooted on</label>
                        <InputDate id="rooted" class="form-control" @bind-Value="propagation.RootedOn"
                                   min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Filled in by itself when you move it to rooted. Change it if it rooted earlier.</div>
                    </div>
                }
                @if (propagation.Type == PropagationType.Seed)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="seeds-up">Came up</label>
                            <InputNumber id="seeds-up" class="form-control" @bind-Value="propagation.SeedsGerminated" min="0" max="@propagation.InitialCount" inputmode="numeric" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="first-up">First on</label>
                            <InputDate id="first-up" class="form-control" @bind-Value="propagation.FirstGerminatedOn"
                                       min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-text">How many seeds have come up so far, out of the number sown. Leave empty until the first one does.</div>
                    </div>
                }
                @* Not when starting one, since nothing has shown yet *@
                @if (!IsNew)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="first-root">First root</label>
                            <InputDate id="first-root" class="form-control" @bind-Value="propagation.FirstRootOn"
                                       min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="first-leaf">First leaf</label>
                            <InputDate id="first-leaf" class="form-control" @bind-Value="propagation.FirstLeafOn"
                                       min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-text">The day you first saw a root or a new leaf. Leave them empty until it happens.</div>
                    </div>
                }
            </FormSection>
        </div>

        <div class="form-actions form-bar">
            <button type="submit" class="btn btn-primary" disabled="@(saving || busy || googleBusy)">@(IsNew ? "Start propagation" : "Save")</button>
            @if (IsNew)
            {
                <button type="button" class="btn btn-link" @onclick="CancelAsync">Cancel</button>
            }
            else
            {
                <a class="btn btn-link" href="@BackUrl">Cancel</a>
            }
        </div>
    </EditForm>
}

@code {
    private bool showErrors;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showErrors)
            return;
        showErrors = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("showAlert", "form-errors");
    }

    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The plant it's taken from, e.g. from "Propagate" on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentId { get; set; }

    /// <summary>Starts from a wish on the wishlist, from Got it. Once the cutting is saved the wish moves to Got.</summary>
    [SupplyParameterFromQuery(Name = "wish")]
    public Guid? WishId { get; set; }

    private static readonly PropagationStage[] ManualStages =
        [PropagationStage.Started, PropagationStage.Rooting, PropagationStage.Rooted];

    private readonly string cameraId = $"camera-{Guid.NewGuid():N}";
    private readonly string galleryId = $"gallery-{Guid.NewGuid():N}";
    private ElementReference cameraInput;
    private ElementReference galleryInput;

    /// <summary>Photos taken while starting the propagation. They're saved with it.</summary>
    private readonly List<Photo> photos = [];
    private string? photoStatus;
    private GooglePhotosPick? googlePick;
    private bool googleBusy;

    private async Task StartGoogleAsync()
    {
        if (googlePick is not null)
            await googlePick.Start();
    }

    private bool googleOn;
    private bool busy;
    private DateOnly? dateFromPhotos; // when the start day was moved back to the oldest photo
    private bool keepToday;

    private PropagationForm? form;
    private (Guid? Id, Guid? ParentId, Guid? WishId) formFor;
    private Propagation? propagation;
    private bool notFound;
    private bool saving;
    private List<string> errors = [];

    private string? NumberCode => CollectionNumbers.Normalize(propagation?.CollectionNumber);
    private bool NumberInvalid => NumberCode is { } code && !CollectionNumbers.IsValid(code);
    private IReadOnlyList<CodeClash> NumberClashes =>
        NumberCode is { } code && !NumberInvalid
            ? CollectionNumbers.Clashes(code, propagation!.Id, form!.Plants, form.Propagations)
            : [];

    private IReadOnlyList<Room> rooms = [];
    private IReadOnlyList<string> experiments = [];
    private IReadOnlyList<PotUse> containerUses = [];

    // Which sections start open, worked out when the propagation loads. A section only reads this once
    private bool openWhere;
    private bool openSetup;
    private bool openProgress;
    private bool openSitter;
    private bool openSwap;

    // Set by "Change name", or by a name error, and kept for the rest of the visit
    private bool nameExpanded;

    private bool IsNew => Id is null;

    private DateOnly Today => Time.Today();

    // Only shown once something was given away, so it stays out of the way for everyone else
    private bool ShowGivenAway => form?.Original is { GivenAwayCount: > 0 };

    private string BackUrl =>
        !IsNew ? $"propagations/{Id}"
        : ParentId is { } parentId ? $"plants/{parentId}"
        : "propagations";

    // With a parent the name comes from it, so one line is enough until the person wants to change it
    private bool NameCollapsed =>
        !nameExpanded
        && propagation?.ParentPlantId is { } parentId
        && form!.Plants.FirstOrDefault(p => p.Id == parentId) is { } parent
        && NameMatches(propagation, PropagationService.StartFrom(parent));

    private static bool NameMatches(Propagation a, Propagation b) =>
        Same(a.Nickname, b.Nickname) && Same(a.Genus, b.Genus) && Same(a.Species, b.Species) && Same(a.Cultivar, b.Cultivar);

    private static bool Same(string? a, string? b) => string.Equals(a?.Trim() ?? "", b?.Trim() ?? "", StringComparison.Ordinal);

    private static string? Joined(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));

    private string? SetupSummary => propagation is null ? null : Joined(
        Labels.For(propagation.Medium),
        form!.ContainerText,
        propagation.Medium == GrowingMedium.Soil && propagation.SoilMixId is { } mix ? form!.Mixes.FirstOrDefault(m => m.Id == mix)?.Name : null,
        propagation.RootingAids.Count > 0 ? string.Join(", ", propagation.RootingAids.Select(Labels.For)) : null,
        propagation.DriedForHours is { } dried ? $"dried {Drying.Text(dried)}" : null,
        propagation.Experiment);

    private string? AboutSummary => string.IsNullOrWhiteSpace(propagation?.Notes) ? null : Labels.Short(propagation.Notes);

    private RenderFragment AboutField => @<div>
        <div id="about-help" class="form-text mt-0">For what stays true about it. Dated notes go on its history.</div>
        <InputTextArea class="form-control" rows="3" @bind-Value="propagation!.Notes" aria-label="About it" aria-describedby="about-help" />
    </div>;

    private string? SwapSummary => propagation is { SpareAvailable: > 0 } ? $"{propagation.SpareAvailable} to swap" : null;

    private string? SitterSummary => string.IsNullOrWhiteSpace(propagation?.SitterNote) ? null : Labels.Short(propagation.SitterNote);

    private string? ProgressSummary => propagation is null ? null : Joined(
        Labels.Stage(propagation.Stage, propagation.Type),
        propagation.FirstRootOn is { } root ? $"first root {Labels.Date(root)}" : null,
        propagation.FirstLeafOn is { } leaf ? $"first leaf {Labels.Date(leaf)}" : null,
        propagation.PottedUpCount + propagation.FailedCount + propagation.GivenAwayCount > 0 ? PropagationService.Outcome(propagation) : null);

    private static bool HasSetup(Propagation p) =>
        !string.IsNullOrWhiteSpace(p.Container) || p.SoilMixId is not null || p.RootingAids.Count > 0
        || p.DriedForHours is not null || !string.IsNullOrWhiteSpace(p.Experiment) || p.CormSizeMm is not null;

    private static bool HasProgress(Propagation p) =>
        p.Stage != PropagationStage.Started || p.RootedOn is not null || p.FirstRootOn is not null
        || p.FirstLeafOn is not null || p.SeedsGerminated is not null || p.FirstGerminatedOn is not null;

    private bool openArrival;

    private IReadOnlyList<string> sellerNames = [];

    private bool ShowArrival =>
        propagation is not null && propagation.ParentPlantId is null && SellerName.Clean(form!.SellerText) is not null;

    protected override async Task OnParametersSetAsync()
    {
        googleOn = await Google.IsEnabledAsync();

        // A new form only when the page was opened for something else, so a re-render never resets a draft
        var key = (Id, ParentId, WishId);
        if (form is not null && formFor == key)
            return;

        formFor = key;
        form = Id is { } id ? await Forms.EditAsync(id, Labels.For) : await Forms.NewAsync(ParentId, WishId, Labels.For);
        propagation = form?.Propagation;
        notFound = form is null;
        if (form is null || propagation is null)
            return;

        var all = form.Plants;
        rooms = Room.List(form.Places, all, form.Propagations);
        experiments = Experiments.Names(form.Propagations);
        containerUses = PotUse.RecentContainers(form.PotUses, form.Propagations);
        var uses = SellerSummary.CountsBySeller(form.SellerList, all, form.Propagations);
        sellerNames = form.SellerList.Live.OrderByDescending(s => uses.GetValueOrDefault(s.Id)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => s.Name).ToList();

        var isNew = form.IsNew;
        openArrival = !isNew && (propagation.ArrivedIn is not null || propagation.ArrivalProblems.Count > 0 || !string.IsNullOrWhiteSpace(propagation.ArrivalNote));
        openWhere = !isNew && !string.IsNullOrWhiteSpace(form.Location);
        openSetup = isNew || HasSetup(propagation);
        openProgress = !isNew && HasProgress(propagation);
        openSitter = !isNew && !string.IsNullOrWhiteSpace(propagation.SitterNote);
        openSwap = !isNew && propagation.SpareCount is > 0;
    }

    private async Task AddPhotosAsync(ElementReference input, bool fromCamera)
    {
        if (propagation is null)
            return;

        busy = true;
        photoStatus = "Saving photos…";
        StateHasChanged();

        try
        {
            var result = await Photos.SaveFromInputAsync(input, SubjectType.Propagation, propagation.Id);
            photos.AddRange(result.Saved);
            photoStatus = result.Message(guessesMatter: !fromCamera);
            FollowPhotoDates();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding photos to a propagation failed");
            photoStatus = $"Couldn't save the photos: {ex.Message}";
        }

        busy = false;
    }

    private Task GoogleSavedAsync(PhotoSaveResult result)
    {
        photos.AddRange(result.Saved);
        photoStatus = result.Message(guessesMatter: true);
        FollowPhotoDates();
        return Task.CompletedTask;
    }

    private async Task RemovePhotoAsync(Photo photo)
    {
        await Photos.DeleteAsync(photo.Id);
        photos.Remove(photo);
        photoStatus = null;
        FollowPhotoDates();
    }

    // Old photos would otherwise come before "Started" in the history, so the start day moves
    // back to the oldest one. Only while it's still the day the form started with
    private void FollowPhotoDates()
    {
        if (propagation is null || keepToday || (propagation.StartedOn != Today && propagation.StartedOn != dateFromPhotos))
            return;

        dateFromPhotos = PhotoEntries.OldestDay(photos, Time) is { } oldest && oldest < Today ? oldest : null;
        propagation.StartedOn = dateFromPhotos ?? Today;
    }

    private void KeepToday()
    {
        keepToday = true;
        propagation!.StartedOn = Today;
    }

    // Leaving without saving: the photos would belong to nothing
    private async Task CancelAsync()
    {
        await DiscardPhotosAsync();
        Navigation.NavigateTo(BackUrl);
    }

    private async Task DiscardPhotosAsync()
    {
        foreach (var photo in photos)
            await Photos.DeleteAsync(photo.Id);
        photos.Clear();
    }

    /// <summary>Also covers leaving by the back link or the phone's back button.</summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await DiscardPhotosAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the photos go with it
        }
    }

    private void DryFirstChanged(ChangeEventArgs e) => form!.DryFirst = e.Value is true;

    private void DryAmountChanged(ChangeEventArgs e) =>
        form!.DryAmount = int.TryParse(e.Value?.ToString(), out var amount) ? amount : null;

    private void DryUnitChanged(ChangeEventArgs e) => form!.DryInDays = e.Value?.ToString() == "days";

    private static string LastTimeText(Propagation p) => string.Join(", ", new[]
    {
        $"{Lower(Labels.For(p.Type))} in {Lower(Labels.For(p.Medium))}",
        string.IsNullOrWhiteSpace(p.Container) ? null : p.Container.Trim(),
        p.RootingAids.Count > 0 ? string.Join(", ", p.RootingAids.Order().Select(a => Lower(Labels.For(a)))) : null,
        p.DriedForHours is { } hours ? $"dried {Drying.Text(hours)}" : null
    }.OfType<string>());

    // Mid-sentence, but not LECA or PON
    private static string Lower(string text) =>
        text.Any(char.IsLower) ? char.ToLowerInvariant(text[0]) + text[1..] : text;

    private void ToggleAid(RootingAid aid)
    {
        if (!propagation!.RootingAids.Remove(aid))
            propagation.RootingAids.Add(aid);
    }

    private async Task SaveAsync()
    {
        if (form is null)
            return;

        errors = [];
        saving = true;
        try
        {
            var wasNew = form.IsNew;
            var result = await form.SaveAsync(photos);
            if (result.Errors.Count > 0)
            {
                // A name error has to be visible where it can be fixed
                errors = [.. result.Errors];
                nameExpanded = true;
                showErrors = true;
                return;
            }

            if (result.Created)
                photos.Clear(); // they belong to the saved propagation now
            // The cutting is saved by now, so a wish that can't be moved is logged and left, not reported as a failed save
            if (result.WishError is { } wishError)
                Logger.LogError(wishError, "Moving the wish to Got failed");

            var id = form.Propagation.Id;
            Navigation.NavigateTo(wasNew ? $"propagations/{id}?made=true" : $"propagations/{id}", replace: wasNew);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the propagation failed");
            errors = [$"Couldn't save: {ex.Message}"];
            showErrors = true;
        }
        finally
        {
            saving = false;
        }
    }
}
