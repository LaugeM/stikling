@page "/propagations/new"
@page "/propagations/{Id:guid}/edit"
@inject IPropagationRepository Repository
@inject IPlantRepository PlantRepository
@inject PropagationService PropagationService
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@(IsNew ? "Start propagation" : "Edit propagation") · Stikling</PageTitle>

<a class="back-link" href="@BackUrl">Back</a>
<h1>@(IsNew ? "Start propagation" : "Edit propagation")</h1>

@if (propagation is null)
{
    <p class="text-body-secondary">@(notFound ? "That propagation doesn't exist." : "Loading…")</p>
}
else
{
    <EditForm Model="propagation" OnSubmit="SaveAsync" class="edit-form">
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>What you're propagating</legend>
            <div class="mb-3">
                <label class="form-label" for="parent">Taken from</label>
                <InputSelect id="parent" class="form-select" @bind-Value="propagation.ParentPlantId" @bind-Value:after="ParentChanged">
                    <option value="">No parent plant (e.g. bought seeds)</option>
                    @foreach (var p in plants)
                    {
                        <option value="@p.Id">@p.DisplayName</option>
                    }
                </InputSelect>
            </div>
            @if (propagation.ParentPlantId is null)
            {
                <div class="mb-3">
                    <label class="form-label" for="source">Source</label>
                    <InputText id="source" class="form-control" @bind-Value="propagation.Source" placeholder="e.g. Seed shop, a friend's plant" />
                </div>
            }
            <div class="row g-2 mb-3">
                <div class="col-7">
                    <label class="form-label" for="type">Type</label>
                    <InputSelect id="type" class="form-select" @bind-Value="propagation.Type">
                        @foreach (var type in Enum.GetValues<PropagationType>())
                        {
                            <option value="@type">@Labels.For(type)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-5">
                    <label class="form-label" for="count">How many</label>
                    <InputNumber id="count" class="form-control" @bind-Value="propagation.InitialCount" min="@MinCount" inputmode="numeric" />
                </div>
            </div>
            <div class="row g-2 mb-1">
                <div class="col-6">
                    <label class="form-label" for="started">Started on</label>
                    <InputDate id="started" class="form-control" @bind-Value="propagation.StartedOn" max="@Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="stage">How far along</label>
                    <InputSelect id="stage" class="form-select" @bind-Value="propagation.Stage" disabled="@(!propagation.IsActive)">
                        @foreach (var stage in ManualStages)
                        {
                            <option value="@stage">@Labels.Stage(stage, propagation.Type)</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="form-text">Already rooting when you write it down? Say so here, the stage can be changed later.</div>
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="from-seed" checked="@fromSeed" @onchange="SetFromSeed" />
                <label class="form-check-label" for="from-seed">Grown from seed</label>
            </div>
            @if (fromSeed)
            {
                <div class="row g-2 mt-1">
                    <div class="col-4">
                        <label class="form-label" for="seeds-sown">Sown</label>
                        <InputNumber id="seeds-sown" class="form-control" @bind-Value="propagation.SeedsSown" min="0" inputmode="numeric" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="seeds-up">Came up</label>
                        <InputNumber id="seeds-up" class="form-control" @bind-Value="propagation.SeedsGerminated" min="0" inputmode="numeric" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="first-up">First on</label>
                        <InputDate id="first-up" class="form-control" @bind-Value="propagation.FirstGerminatedOn"
                                   min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="form-text">Sown is counted from the started date. Update the rest as seeds come up.</div>
            }
            @if (propagation.Stage == PropagationStage.Rooted || propagation.RootedOn is not null)
            {
                <div class="mt-3">
                    <label class="form-label" for="rooted">Rooted on</label>
                    <InputDate id="rooted" class="form-control" @bind-Value="propagation.RootedOn"
                               min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    <div class="form-text">Filled in by itself when you move it to rooted. Change it if it rooted earlier.</div>
                </div>
            }
        </fieldset>

        <fieldset>
            <legend>Name</legend>
            <div class="mb-3">
                <label class="form-label" for="nickname">Nickname</label>
                <InputText id="nickname" class="form-control" @bind-Value="propagation.Nickname" placeholder="e.g. Corm test: perlite" />
            </div>
            <PlantNameFields @bind-Genus="propagation.Genus" @bind-Species="propagation.Species" @bind-Cultivar="propagation.Cultivar"
                             GenusPlaceholder="e.g. Alocasia" SpeciesPlaceholder="e.g. zebrina" CultivarPlaceholder="" />
            <div class="form-text">
                @(propagation.ParentPlantId is null ? "" : "Filled in from the parent plant. ")Give it a nickname, a genus, or both.
            </div>
        </fieldset>

        <fieldset>
            <legend>Setup</legend>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label" for="medium">Grows in</label>
                    <InputSelect id="medium" class="form-select" @bind-Value="propagation.Medium">
                        @foreach (var medium in Enum.GetValues<GrowingMedium>())
                        {
                            <option value="@medium">@Labels.For(medium)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label" for="container">Container</label>
                    <InputText id="container" class="form-control" @bind-Value="propagation.Container" placeholder="e.g. Humidity box" />
                </div>
            </div>
            <div class="mb-3">
                <span class="form-label d-block" id="aids-label">Rooting aids</span>
                <div class="chip-row" role="group" aria-labelledby="aids-label">
                    @foreach (var aid in Enum.GetValues<RootingAid>())
                    {
                        var picked = propagation.RootingAids.Contains(aid);
                        <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                @onclick="() => ToggleAid(aid)">@Labels.For(aid)</button>
                    }
                </div>
                <div class="form-text">Optional. Pick what you used and the results page compares batches with and without it.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="experiment">Experiment</label>
                <InputText id="experiment" class="form-control" @bind-Value="propagation.Experiment" list="experiment-list"
                           placeholder="e.g. Alocasia corm test" autocomplete="off" />
                <datalist id="experiment-list">
                    @foreach (var name in experiments)
                    {
                        <option value="@name"></option>
                    }
                </datalist>
                <div class="form-text">Give batches you started together the same name and they're compared side by side.</div>
            </div>
            <div class="mb-1">
                <RoomPicker @bind-Value="location" Rooms="rooms" SpotPlaceholder="e.g. Kitchen window" />
            </div>
        </fieldset>

        @* Not when starting one, since nothing has shown yet *@
        @if (!IsNew)
        {
            <fieldset>
                <legend>Milestones</legend>
                <div class="row g-2 mb-1">
                    <div class="col-6">
                        <label class="form-label" for="first-root">First root</label>
                        <InputDate id="first-root" class="form-control" @bind-Value="propagation.FirstRootOn"
                                   min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="first-leaf">First leaf</label>
                        <InputDate id="first-leaf" class="form-control" @bind-Value="propagation.FirstLeafOn"
                                   min="@propagation.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="form-text">The day you first saw a root or a new leaf. Leave them empty until it happens.</div>
            </fieldset>
        }

        @* Only on one already going, to keep starting a propagation short *@
        @if (!IsNew && propagation.IsActive)
        {
            <fieldset>
                <legend>Dormancy</legend>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dormant"
                           checked="@propagation.IsDormant" @onchange="SetDormant" />
                    <label class="form-check-label" for="dormant">Dormant</label>
                </div>
                @if (propagation.IsDormant)
                {
                    <div class="mt-2">
                        <label class="form-label" for="dormant-since">Since</label>
                        <InputDate id="dormant-since" class="form-control" @bind-Value="propagation.DormantSince"
                                   max="@Today.ToString("yyyy-MM-dd")" />
                    </div>
                }
                <div class="form-text">Resting rather than stuck, e.g. a corm waiting out the winter. It won't come up on Today to be checked on until it wakes up.</div>
            </fieldset>
        }

        <fieldset>
            <legend>Notes</legend>
            <InputTextArea class="form-control" rows="3" @bind-Value="propagation.Notes" aria-label="Notes" />
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@saving">@(IsNew ? "Start propagation" : "Save")</button>
            <a class="btn btn-link" href="@BackUrl">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The plant it's taken from, e.g. from "Propagate" on a plant's page.</summary>
    [SupplyParameterFromQuery(Name = "parent")]
    public Guid? ParentId { get; set; }

    private static readonly PropagationStage[] ManualStages =
        [PropagationStage.Started, PropagationStage.Rooting, PropagationStage.Rooted];

    private Propagation? propagation;
    private Propagation? original; // as it was before editing, to record what changed
    private bool notFound;
    private bool saving;
    private List<string> errors = [];
    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<Room> rooms = [];
    private Places places = Places.None;
    private string? location; // as picked, "Kitchen / Window"; made into a room when saving
    private IReadOnlyList<string> experiments = [];

    private bool fromSeed;

    private bool IsNew => Id is null;

    private DateOnly Today => Time.Today();

    // Units already potted up or failed can't be counted away
    private int MinCount => Math.Max(1, (propagation?.PottedUpCount ?? 0) + (propagation?.FailedCount ?? 0));

    private string BackUrl =>
        !IsNew ? $"propagations/{Id}"
        : ParentId is { } parentId ? $"plants/{parentId}?tab=props"
        : "propagations";

    protected override async Task OnParametersSetAsync()
    {
        var allPlants = await PlantRepository.GetAllAsync();
        var allPropagations = await Repository.GetAllAsync();
        plants = allPlants.OrderBy(p => p.DisplayName, StringComparer.CurrentCultureIgnoreCase).ToList();
        places = await RoomService.GetPlacesAsync();
        rooms = Room.List(places, allPlants, allPropagations);
        experiments = Experiments.Names(allPropagations);

        if (IsNew)
        {
            propagation = ParentId is { } parentId && allPlants.FirstOrDefault(p => p.Id == parentId) is { } parent
                ? PropagationService.StartFrom(parent)
                : new Propagation { StartedOn = Today };
        }
        else
        {
            propagation = allPropagations.FirstOrDefault(p => p.Id == Id);
            original = propagation?.Copy();
            notFound = propagation is null;
        }

        fromSeed = propagation?.SeedsSown is not null;
        location = places.NameOf(propagation?.PlaceId);
    }

    private void ToggleAid(RootingAid aid)
    {
        if (!propagation!.RootingAids.Remove(aid))
            propagation.RootingAids.Add(aid);
    }

    private void SetFromSeed(ChangeEventArgs e)
    {
        fromSeed = (bool?)e.Value == true;
        if (fromSeed && propagation!.Type == PropagationType.Seed && propagation.SeedsSown is null)
            propagation.SeedsSown = propagation.InitialCount;
    }

    private void SetDormant(ChangeEventArgs e) =>
        propagation!.DormantSince = (bool?)e.Value == true ? original?.DormantSince ?? Today : null;

    // Picking a parent fills in empty name fields from it
    private void ParentChanged()
    {
        if (propagation?.ParentPlantId is not { } parentId || plants.FirstOrDefault(p => p.Id == parentId) is not { } parent)
            return;
        if (string.IsNullOrWhiteSpace(propagation.Nickname) && string.IsNullOrWhiteSpace(propagation.Genus))
        {
            var filled = PropagationService.StartFrom(parent);
            propagation.Nickname = filled.Nickname;
            propagation.Genus = filled.Genus;
            propagation.Species = filled.Species;
            propagation.Cultivar = filled.Cultivar;
        }
        if (string.IsNullOrWhiteSpace(location))
            location = places.NameOf(parent.PlaceId);
    }

    private async Task SaveAsync()
    {
        if (propagation is null)
            return;

        if (!fromSeed)
        {
            propagation.SeedsSown = null;
            propagation.SeedsGerminated = null;
            propagation.FirstGerminatedOn = null;
        }

        errors = propagation.Validate(Today).ToList();
        if (errors.Count > 0)
            return;

        saving = true;
        try
        {
            if (propagation.ParentPlantId is not null)
                propagation.Source = null;

            propagation.PlaceId = await RoomService.PlaceIdAsync(location);
            if (IsNew)
            {
                await PropagationService.CreateAsync(propagation, Labels.For(propagation));
            }
            else
            {
                var named = await RoomService.GetPlacesAsync();
                await PropagationService.UpdateAsync(original!, propagation, Labels.For(propagation), id => named.NameOf(id));
            }
            Navigation.NavigateTo($"propagations/{propagation.Id}", replace: IsNew);
        }
        catch (Exception ex)
        {
            errors = [$"Couldn't save: {ex.Message}"];
        }
        finally
        {
            saving = false;
        }
    }
}
