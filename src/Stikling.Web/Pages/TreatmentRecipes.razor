@page "/treatment-recipes"
@inject ITreatmentRecipeRepository Repository
@inject IPestTreatmentRepository Treatments

<PageTitle>Treatment recipes · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="supplies">Supplies</a>
<h1>Treatment recipes</h1>

<p class="settings-hint">
    The sprays and drenches you make up yourself, saved under a name. Logging a treatment with one
    copies what's in it onto the treatment, so editing a recipe here doesn't change what you've
    already logged.
</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section">
        <h2>@(editing ? "Edit recipe" : "Add a recipe")</h2>

        <div class="mb-3">
            <label class="form-label" for="recipe-name">Name</label>
            <input id="recipe-name" class="form-control" placeholder="e.g. Alcohol spray" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">What's in it</div>

            @if (draft.Ingredients.Count > 0)
            {
                <ol class="recipe-rows">
                    @for (var i = 0; i < draft.Ingredients.Count; i++)
                    {
                        var index = i;
                        var ingredient = draft.Ingredients[index];
                        <li class="recipe-row">
                            <input class="form-control recipe-ingredient" autocomplete="off"
                                   aria-label="Ingredient @(index + 1)" value="@ingredient.Name"
                                   @oninput="e => ingredient.Name = e.Value?.ToString() ?? string.Empty" />
                            <div class="recipe-tools">
                                <button type="button" class="recipe-tool" disabled="@(index == 0)"
                                        aria-label="Move @Some(ingredient) up"
                                        @onclick="() => draft.MoveUp(index)">▲</button>
                                <button type="button" class="recipe-tool" disabled="@(index == draft.Ingredients.Count - 1)"
                                        aria-label="Move @Some(ingredient) down"
                                        @onclick="() => draft.MoveDown(index)">▼</button>
                                <button type="button" class="recipe-tool remove" aria-label="Remove @Some(ingredient)"
                                        @onclick="() => draft.Ingredients.RemoveAt(index)">✕</button>
                            </div>
                            <DoseInput Label="@Some(ingredient)"
                                       @bind-Amount="ingredient.Amount" @bind-Unit="ingredient.Unit"
                                       @bind-Per="ingredient.Per" @bind-PerUnit="ingredient.PerUnit" />
                        </li>
                    }
                </ol>
                <div class="form-text">
                    Each amount is for that much of the finished mix, and the rest is water. Leave it
                    empty for something you don't measure.
                </div>
            }

            <div class="chip-row mt-2" role="group" aria-label="Ingredients to add">
                @foreach (var name in Addable)
                {
                    <button type="button" class="chip" @onclick="() => Add(name)">@name</button>
                }
                <button type="button" class="chip new" @onclick="() => Add(null)">+ Something else</button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="recipe-method">How to use it</label>
            <textarea id="recipe-method" class="form-control" rows="2"
                      placeholder="e.g. Both sides of the leaves, then the top of the soil" @bind="draft.Method"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">
                @(editing ? "Save changes" : "Add recipe")
            </button>
            <button type="button" class="btn btn-link" @onclick="Cancel">Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">+ Add a recipe</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>No recipes yet.</p>
        <p class="text-body-secondary">
            Start with the spray you use most. Amounts are optional, so a recipe you mix by eye is
            still worth saving.
        </p>
    </div>
}
else
{
    <section class="settings-section">
        <h2>Your recipes</h2>

        <ul class="recipe-list">
            @foreach (var use in uses)
            {
                <li>
                    @if (confirming == use.Recipe.Id)
                    {
                        <div class="recipe-confirm">
                            <p>@DeleteWarning(use)</p>
                            <div class="care-actions">
                                <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                        @onclick="() => DeleteAsync(use.Recipe)">Delete</button>
                                <button type="button" class="btn btn-link btn-sm"
                                        @onclick="() => confirming = null">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        var measuring = mixing == use.Recipe.Id;
                        <div class="recipe-title">@use.Recipe.Name</div>
                        <div class="recipe-use">@Used(use)</div>

                        @if (measuring)
                        {
                            var id = $"recipe-bottle-{use.Recipe.Id}";
                            <div class="recipe-bottle">
                                <label for="@id">Bottle</label>
                                <WaterInput Id="@id" Placeholder="e.g. 0.5" @bind-Litres="litres" />
                            </div>
                        }

                        @if (use.Recipe.Ingredients.Count > 0)
                        {
                            <ol class="recipe-contents">
                                @foreach (var ingredient in use.Recipe.Ingredients)
                                {
                                    <li>
                                        <span>@ingredient.Name</span>
                                        @if (ingredient.Amount is { } amount)
                                        {
                                            <span class="recipe-dose">@Doses.Text(amount, ingredient.Unit, ingredient.Per, ingredient.PerUnit)</span>
                                        }
                                        @if (measuring && litres > 0 && ingredient.For(litres.Value) is { } measure)
                                        {
                                            <span class="recipe-measure">@Doses.Measured(measure, ingredient.Unit)</span>
                                        }
                                    </li>
                                }
                            </ol>
                            @if (measuring && litres > 0)
                            {
                                <div class="recipe-fill">Then fill up to @Doses.Water(litres.Value).</div>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(use.Recipe.Method))
                        {
                            <div class="recipe-method">@use.Recipe.Method</div>
                        }

                        <div class="care-actions">
                            @if (use.Recipe.Ingredients.Any(i => i.Amount is not null))
                            {
                                <button type="button" class="btn btn-link btn-sm p-0"
                                        @onclick="() => ToggleMixing(use.Recipe)">@(measuring ? "Done" : "Mix a batch")</button>
                            }
                            <button type="button" class="btn btn-link btn-sm p-0"
                                    @onclick="() => StartEdit(use.Recipe)">Edit</button>
                            <button type="button" class="btn btn-link btn-sm p-0"
                                    @onclick="() => { confirming = use.Recipe.Id; mixing = null; }">Delete</button>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    private IReadOnlyList<RecipeUse> uses = [];
    private IReadOnlyList<TreatmentRecipe> all = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private TreatmentRecipe? draft;
    private bool editing;
    private Guid? confirming;

    // The recipe being measured out, and for how big a bottle. The size is kept between
    // recipes, since it's usually the same spray bottle.
    private Guid? mixing;
    private decimal? litres;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        uses = RecipeUse.List(all, await Treatments.GetAllAsync());
        loading = false;
    }

    /// <summary>The suggestions not in the draft yet, so the same one isn't added twice by accident.</summary>
    private IEnumerable<string> Addable =>
        RecipeIngredients.Suggestions(all).Where(name =>
            draft?.Ingredients.Any(i => string.Equals(i.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)) != true);

    /// <summary>The ingredient's name for a screen reader, before one has been typed.</summary>
    private static string Some(RecipeIngredient ingredient) =>
        string.IsNullOrWhiteSpace(ingredient.Name) ? "this ingredient" : ingredient.Name.Trim();

    /// <summary>"Used 3 times, last 12 Sep 2026".</summary>
    private static string Used(RecipeUse use) => use.LastUsed is { } last
        ? $"Used {Labels.Count(use.Times, "time")}, last {Labels.Date(last)}"
        : "Not used yet";

    private static string DeleteWarning(RecipeUse use) => use.Times == 0
        ? $"Delete {use.Recipe.Name}?"
        : $"Delete {use.Recipe.Name}? It's been used {Labels.Count(use.Times, "time")}, and those treatments keep what was in it.";

    private void Add(string? name) => draft!.Ingredients.Add(new RecipeIngredient { Name = name ?? "" });

    private void ToggleMixing(TreatmentRecipe recipe)
    {
        mixing = mixing == recipe.Id ? null : recipe.Id;
        confirming = null;
    }

    private void StartNew()
    {
        editing = false;
        errors = [];
        confirming = null;
        draft = new TreatmentRecipe();
    }

    private void StartEdit(TreatmentRecipe recipe)
    {
        editing = true;
        errors = [];
        confirming = null;
        draft = recipe.Copy();
    }

    private void Cancel()
    {
        draft = null;
        editing = false;
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (draft is null)
            return;

        draft.Name = draft.Name?.Trim();
        draft.Method = string.IsNullOrWhiteSpace(draft.Method) ? null : draft.Method.Trim();
        foreach (var ingredient in draft.Ingredients)
            ingredient.Name = ingredient.Name.Trim();
        // A row added and never filled in is dropped rather than refused
        draft.Ingredients.RemoveAll(i => i.Name.Length == 0 && i.Amount is null);

        errors = draft.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            await Repository.SaveAsync(draft);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(TreatmentRecipe recipe)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(recipe.Id);
            confirming = null;
            if (draft?.Id == recipe.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
