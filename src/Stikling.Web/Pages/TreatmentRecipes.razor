@page "/treatment-recipes"
@layout WideLayout
@inject ITreatmentRecipeRepository Repository
@inject IPestTreatmentRepository Treatments

<PageTitle>@Strings.Pests.RecipesPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<ShowFound ElementId="@(Show is { } shown ? $"item-{shown}" : null)" />

<a class="back-link" href="supplies">@Strings.Pests.PlansBackToSupplies</a>
<h1>@Strings.Pests.TreatRecipesLink</h1>

<p class="settings-hint">@Strings.Pests.RecipesIntro</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section supply-form">
        <h2>@(editing ? Strings.Pests.RecipesEdit : Strings.Pests.RecipesAdd)</h2>

        <div class="mb-3">
            <label class="form-label" for="recipe-name">@Strings.Pests.PlansName</label>
            <input id="recipe-name" class="form-control" placeholder="@Strings.Pests.RecipesNamePlaceholder" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Pests.RecipesWhatsInIt</div>

            @if (draft.Ingredients.Count > 0)
            {
                <ol class="recipe-rows">
                    @for (var i = 0; i < draft.Ingredients.Count; i++)
                    {
                        var index = i;
                        var ingredient = draft.Ingredients[index];
                        <li class="recipe-row">
                            <input class="form-control recipe-ingredient" autocomplete="off"
                                   aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesIngredientN, index + 1))" value="@ingredient.Name"
                                   @oninput="e => ingredient.Name = e.Value?.ToString() ?? string.Empty" />
                            <div class="recipe-tools">
                                <button type="button" class="recipe-tool" disabled="@(index == 0)"
                                        aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesMoveUp, Some(ingredient)))"
                                        @onclick="() => draft.MoveUp(index)">▲</button>
                                <button type="button" class="recipe-tool" disabled="@(index == draft.Ingredients.Count - 1)"
                                        aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesMoveDown, Some(ingredient)))"
                                        @onclick="() => draft.MoveDown(index)">▼</button>
                                <button type="button" class="recipe-tool remove" aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesRemove, Some(ingredient)))"
                                        @onclick="() => draft.Ingredients.RemoveAt(index)"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                            </div>
                            <DoseInput Label="@Some(ingredient)"
                                       @bind-Amount="ingredient.Amount" @bind-Unit="ingredient.Unit"
                                       @bind-Per="ingredient.Per" @bind-PerUnit="ingredient.PerUnit" />
                        </li>
                    }
                </ol>
                <div class="form-text">@Strings.Pests.RecipesAmountHint</div>
            }

            <div class="chip-row mt-2" role="group" aria-label="@Strings.Pests.RecipesIngredientsToAdd">
                @foreach (var name in Addable)
                {
                    <button type="button" class="chip" @onclick="() => Add(name)">@name</button>
                }
                <button type="button" class="chip new" @onclick="() => Add(null)">+ @Strings.Pests.TreatSomethingElse</button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="recipe-method">@Strings.Pests.RecipesHowToUse</label>
            <textarea id="recipe-method" class="form-control" rows="2"
                      placeholder="@Strings.Pests.RecipesHowToUsePlaceholder" @bind="draft.Method"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">
                @(editing ? Strings.Pests.PlansSaveChanges : Strings.Pests.RecipesAddButton)
            </button>
            <button type="button" class="btn btn-link" @onclick="Cancel">@Strings.Common.Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">+ @Strings.Pests.RecipesAdd</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">@Strings.Pests.Loading</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Pests.RecipesNone</p>
        <p class="text-body-secondary">@Strings.Pests.RecipesNoneHint</p>
    </div>
}
else
{
    <section class="settings-section">
        <h2>@Strings.Pests.RecipesYours</h2>

        <ul class="recipe-list supply-grid">
            @foreach (var use in uses)
            {
                <li id="item-@use.Recipe.Id">
                    @if (confirming == use.Recipe.Id)
                    {
                        <div class="recipe-confirm">
                            <p>@DeleteWarning(use)</p>
                            <div class="care-actions">
                                <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                        @onclick="() => DeleteAsync(use.Recipe)">@Strings.Common.Delete</button>
                                <button type="button" class="btn btn-link btn-sm"
                                        @onclick="() => confirming = null">@Strings.Common.Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        var measuring = mixing == use.Recipe.Id;
                        <div class="recipe-title">@use.Recipe.Name</div>
                        <div class="recipe-use">@Used(use)</div>

                        @if (measuring)
                        {
                            var id = $"recipe-bottle-{use.Recipe.Id}";
                            <div class="recipe-bottle">
                                <label for="@id">@Strings.Pests.RecipesBottle</label>
                                <WaterInput Id="@id" Placeholder="@Strings.Pests.RecipesBottlePlaceholder" @bind-Litres="litres" />
                            </div>
                        }

                        @if (use.Recipe.Ingredients.Count > 0)
                        {
                            <ol class="recipe-contents">
                                @foreach (var ingredient in use.Recipe.Ingredients)
                                {
                                    <li>
                                        <span>@ingredient.Name</span>
                                        @if (ingredient.Amount is { } amount)
                                        {
                                            <span class="recipe-dose">@Doses.Text(amount, ingredient.Unit, ingredient.Per, ingredient.PerUnit)</span>
                                        }
                                        @if (measuring && litres > 0 && ingredient.For(litres.Value) is { } measure)
                                        {
                                            <span class="recipe-measure">@Doses.Measured(measure, ingredient.Unit)</span>
                                        }
                                    </li>
                                }
                            </ol>
                            @if (measuring && litres > 0)
                            {
                                <div class="recipe-fill">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesFillUp, Doses.Water(litres.Value))</div>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(use.Recipe.Method))
                        {
                            <div class="recipe-method">@use.Recipe.Method</div>
                        }

                        <div class="care-actions">
                            @if (use.Recipe.Ingredients.Any(i => i.Amount is not null))
                            {
                                <button type="button" class="btn btn-link btn-sm link-action"
                                        @onclick="() => ToggleMixing(use.Recipe)">@(measuring ? Strings.Common.Done : Strings.Pests.RecipesMixBatch)</button>
                            }
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => StartEdit(use.Recipe)">@Strings.Common.Edit</button>
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => { confirming = use.Recipe.Id; mixing = null; }">@Strings.Common.Delete</button>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    /// <summary>An item to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public Guid? Show { get; set; }

    private IReadOnlyList<RecipeUse> uses = [];
    private IReadOnlyList<TreatmentRecipe> all = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private TreatmentRecipe? draft;
    private bool editing;
    private Guid? confirming;

    // The recipe being measured out, and for how big a bottle. The size is kept between
    // recipes, since it's usually the same spray bottle.
    private Guid? mixing;
    private decimal? litres;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        uses = RecipeUse.List(all, await Treatments.GetAllAsync());
        loading = false;
    }

    /// <summary>The suggestions not in the draft yet, so the same one isn't added twice by accident.</summary>
    private IEnumerable<string> Addable =>
        RecipeIngredients.Suggestions(all).Where(name =>
            draft?.Ingredients.Any(i => string.Equals(i.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)) != true);

    /// <summary>The ingredient's name for a screen reader, before one has been typed.</summary>
    private static string Some(RecipeIngredient ingredient) =>
        string.IsNullOrWhiteSpace(ingredient.Name) ? Strings.Pests.RecipesThisIngredient : ingredient.Name.Trim();

    /// <summary>"Used 3 times, last 12 Sep 2026".</summary>
    private static string Used(RecipeUse use) => use.LastUsed is { } last
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesUsed, Plural.Of(use.Times, Strings.Pests.RecipesTime_One, Strings.Pests.RecipesTime_Other), Labels.Date(last))
        : Strings.Pests.RecipesNotUsed;

    private static string DeleteWarning(RecipeUse use) => use.Times == 0
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesDelete, use.Recipe.Name)
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.RecipesDeleteUsed, use.Recipe.Name, Plural.Of(use.Times, Strings.Pests.RecipesTime_One, Strings.Pests.RecipesTime_Other));

    private void Add(string? name) => draft!.Ingredients.Add(new RecipeIngredient { Name = name ?? "" });

    private void ToggleMixing(TreatmentRecipe recipe)
    {
        mixing = mixing == recipe.Id ? null : recipe.Id;
        confirming = null;
    }

    private void StartNew()
    {
        editing = false;
        errors = [];
        confirming = null;
        draft = new TreatmentRecipe();
    }

    private void StartEdit(TreatmentRecipe recipe)
    {
        editing = true;
        errors = [];
        confirming = null;
        draft = recipe.Copy();
    }

    private void Cancel()
    {
        draft = null;
        editing = false;
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (draft is null)
            return;

        draft.Name = draft.Name?.Trim();
        draft.Method = string.IsNullOrWhiteSpace(draft.Method) ? null : draft.Method.Trim();
        foreach (var ingredient in draft.Ingredients)
            ingredient.Name = ingredient.Name.Trim();
        // A row added and never filled in is dropped rather than refused
        draft.Ingredients.RemoveAll(i => i.Name.Length == 0 && i.Amount is null);

        errors = draft.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            await Repository.SaveAsync(draft);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(TreatmentRecipe recipe)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(recipe.Id);
            confirming = null;
            if (draft?.Id == recipe.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
