@page "/propagations/results"
@inject IPropagationRepository Repository
@inject ITimelineRepository Timeline
@inject TimeProvider Time

<PageTitle>Results · Stikling</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="propagations">Propagations</a>
<h1>Results</h1>

<p class="results-hint">How each medium and each type has done.</p>
<a class="year-link" href="year">Your year with your plants</a>

<details class="results-how">
    <summary>How this is counted</summary>
    <p>
        The success rate counts units, so a batch of 5 corms where 4 made it counts as 4 of 5. A unit
        has made it once it's potted up or its batch has rooted, and units still on their way aren't
        counted either way. Below @SmallSample units the count is shown instead of a percentage,
        since 2 of 2 says more than 100%. Days to root only uses batches that were marked as rooted,
        so one that went straight to potted up isn't in it.
    </p>
</details>

@if (all is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (overall is null)
{
    <div class="empty-state">
        <p>No propagations yet.</p>
        <p class="text-body-secondary">
            Once you've started some, this page shows how well each medium and each type does: how many
            made it, and how long they took to root.
        </p>
        <a class="btn btn-primary mt-3" href="propagations/new">Start a propagation</a>
    </div>
}
else
{
    <section class="results-section">
        <h2>All propagations</h2>
        <ul class="results-list">
            <li>@Row("All", overall, "Rooted", overallLost)</li>
        </ul>
    </section>

    <section class="results-section">
        <h2>By medium</h2>
        <ul class="results-list">
            @foreach (var result in byMedium)
            {
                <li>@Row(Labels.For(result.Key), result, "Rooted", lostByMedium.GetValueOrDefault(result.Key))</li>
            }
        </ul>
    </section>

    <section class="results-section">
        <h2>By type</h2>
        <ul class="results-list">
            @foreach (var result in byType)
            {
                <li>@Row(Labels.For(result.Key), result, Labels.Stage(PropagationStage.Rooted, result.Key))</li>
            }
        </ul>
    </section>

    <section class="results-section">
        <h2>Rooting aids</h2>
        @if (byAid.Count == 0)
        {
            <p class="aid-note">Pick the rooting aids you used when editing a propagation, and each one is compared here with the batches that went without it.</p>
        }
        else
        {
            <p class="aid-note">Each aid next to every batch that went without it, whatever the type or medium.</p>
            <ul class="results-list">
                @foreach (var result in byAid)
                {
                    <li>
                        <div class="aid-name">@Labels.For(result.Aid)</div>
                        @Row("With", result.With, "Rooted")
                        @if (result.Without.Batches == 0)
                        {
                            <div class="result-row result-line text-body-secondary">Every batch used it, so there's nothing to compare with yet.</div>
                        }
                        else
                        {
                            @Row("Without", result.Without, "Rooted")
                        }
                    </li>
                }
            </ul>
        }
    </section>

    @if (byDrying.Count > 0)
    {
        <section class="results-section">
            <h2>Drying the cut end</h2>
            <p class="aid-note">Batches grouped by how long the cut end dried before it went in, whatever the type or medium.</p>
            <ul class="results-list">
                @foreach (var group in byDrying)
                {
                    <li>@Row(group.Name, group.Result, "Rooted")</li>
                }
            </ul>
        </section>
    }
}

@code {
    private IReadOnlyList<Propagation>? all;
    private PropagationResult<string>? overall;
    private IReadOnlyList<PropagationResult<GrowingMedium>> byMedium = [];
    private IReadOnlyList<PropagationResult<PropagationType>> byType = [];
    private IReadOnlyList<RootingAidResult> byAid = [];
    private IReadOnlyList<DryingResult> byDrying = [];
    private IReadOnlyDictionary<GrowingMedium, FailureSummary> lostByMedium = new Dictionary<GrowingMedium, FailureSummary>();
    private FailureSummary? overallLost;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        overall = PropagationResults.Overall(all);
        byMedium = PropagationResults.ByMedium(all);
        byType = PropagationResults.ByType(all);
        byAid = PropagationResults.ByRootingAid(all);
        byDrying = PropagationResults.ByDrying(all);

        var entries = new Dictionary<Guid, IReadOnlyList<TimelineEntry>>();
        foreach (var p in all.Where(p => !p.IsDeleted && p.FailedCount > 0))
            entries[p.Id] = await Timeline.GetForAsync(p.Id);
        lostByMedium = FailureResults.ByMedium(all, entries, Time);
        overallLost = FailureResults.Overall(all, entries, Time);
    }

    private static RenderFragment Row<TKey>(string name, PropagationResult<TKey> result, string rooted, FailureSummary? lost = null) => __builder =>
    {
        <div class="result-row">
            <div class="result-head">
                <span class="result-name">@name</span>
                <span class="result-batches">@Labels.Count(result.Batches, "batch", "batches")</span>
            </div>

            @if (result.SuccessRate is { } rate)
            {
                @* A full bar for 2 of 2 says the same thing a percentage would *@
                @if (result.Decided >= SmallSample)
                {
                    <div class="result-bar" role="img" aria-label="@Percent(rate) made it">
                        <span style="width: @(Percent(rate))"></span>
                    </div>
                }
                <div class="result-line">
                    @if (result.Decided < SmallSample)
                    {
                        <strong>@result.Succeeded of @result.Decided</strong> <text>made it</text>
                    }
                    else
                    {
                        <strong>@Percent(rate)</strong> <text>made it · @result.Succeeded of @result.Decided</text>
                    }
                    @if (result.Growing > 0)
                    {
                        <span class="text-body-secondary"> · @result.Growing still going</span>
                    }
                </div>
            }
            else
            {
                <div class="result-line text-body-secondary">
                    Nothing has made it or failed yet · @result.Growing still going
                </div>
            }

            <div class="result-line">
                @if (result.AverageDaysToRoot is { } average)
                {
                    @if (result.DaysToRoot.Count == 1)
                    {
                        <span>@rooted in @Labels.Count(result.FastestDaysToRoot!.Value, "day")</span>
                    }
                    else
                    {
                        <span>@rooted in @Labels.Count(Days(average), "day") on average</span>
                        <span class="text-body-secondary">
                            · @result.FastestDaysToRoot to @result.SlowestDaysToRoot days over @Labels.Count(result.DaysToRoot.Count, "batch", "batches")
                        </span>
                    }
                }
                else
                {
                    <span class="text-body-secondary">No @rooted.ToLowerInvariant() dates yet</span>
                }
            </div>

            @if (lost is not null)
            {
                <div class="result-line text-body-secondary">@LostText(lost)</div>
            }
        </div>
    };

    private static string LostText(FailureSummary lost)
    {
        var reasons = string.Join(", ", lost.Reasons.Select(r =>
            $"{(r.Reason is { } reason ? FailReasons.LostTo(reason) : "not recorded")} {r.Units}"));
        var stage = lost.MostlyAt switch
        {
            FailureStage.BeforeRooting => " · mostly before rooting",
            FailureStage.WhileRooting => " · mostly while rooting",
            FailureStage.AfterRooting => " · mostly after rooting",
            _ => ""
        };
        return $"Lost to: {reasons}{stage}";
    }

    // Below this many units a percentage looks more certain than it is
    private const int SmallSample = 5;

    private static string Percent(double rate) =>
        $"{Math.Round(rate * 100, MidpointRounding.AwayFromZero):0}%";

    private static int Days(double average) => (int)Math.Round(average, MidpointRounding.AwayFromZero);
}
