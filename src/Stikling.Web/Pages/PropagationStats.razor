@page "/propagations/results"
@using System.Globalization
@inject IPropagationRepository Repository
@inject ITimelineRepository Timeline
@inject TimeProvider Time

<PageTitle>@Strings.Propagations.StatsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="propagations">@Strings.Propagations.ListTitle</a>
<h1>@Strings.Propagations.StatsTitle</h1>

<p class="results-hint">@Strings.Propagations.StatsHint</p>
<a class="year-link" href="year">@Strings.Propagations.StatsYearLink</a>

<details class="results-how">
    <summary>@Strings.Propagations.StatsHowTitle</summary>
    <p>
        @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsHow, SmallSample)
    </p>
</details>

@if (all is null)
{
    <p class="text-body-secondary">@Strings.Propagations.ListLoading</p>
}
else if (overall is null)
{
    <div class="empty-state">
        <p>@Strings.Propagations.StatsEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Propagations.StatsEmptyHow
        </p>
        <a class="btn btn-primary mt-3" href="propagations/new">@Strings.Propagations.ListStart</a>
    </div>
}
else
{
    <section class="results-section">
        <h2>@Strings.Propagations.StatsAllHeading</h2>
        <ul class="results-list">
            <li>@Row(Strings.Propagations.StatsAll, overall, false, overallLost)</li>
        </ul>
    </section>

    <section class="results-section">
        <h2>@Strings.Propagations.StatsByMedium</h2>
        <ul class="results-list">
            @foreach (var result in byMedium)
            {
                <li>@Row(Labels.For(result.Key), result, false, lostByMedium.GetValueOrDefault(result.Key))</li>
            }
        </ul>
    </section>

    <section class="results-section">
        <h2>@Strings.Propagations.StatsByType</h2>
        <ul class="results-list">
            @foreach (var result in byType)
            {
                <li>@Row(Labels.For(result.Key), result, result.Key == PropagationType.Seed)</li>
            }
        </ul>
    </section>

    <section class="results-section">
        <h2>@Strings.Propagations.StatsAidsHeading</h2>
        @if (byAid.Count == 0)
        {
            <p class="aid-note">@Strings.Propagations.StatsAidsNone</p>
        }
        else
        {
            <p class="aid-note">@Strings.Propagations.StatsAidsHow</p>
            <ul class="results-list">
                @foreach (var result in byAid)
                {
                    <li>
                        <div class="aid-name">@Labels.For(result.Aid)</div>
                        @Row(Strings.Propagations.StatsWith, result.With, false)
                        @if (result.Without.Batches == 0)
                        {
                            <div class="result-row result-line text-body-secondary">@Strings.Propagations.StatsAidsAllUsed</div>
                        }
                        else
                        {
                            @Row(Strings.Propagations.StatsWithout, result.Without, false)
                        }
                    </li>
                }
            </ul>
        }
    </section>

    @if (byDrying.Count > 0)
    {
        <section class="results-section">
            <h2>@Strings.Propagations.StatsDryingHeading</h2>
            <p class="aid-note">@Strings.Propagations.StatsDryingHow</p>
            <ul class="results-list">
                @foreach (var group in byDrying)
                {
                    <li>@Row(group.Name, group.Result, false)</li>
                }
            </ul>
        </section>
    }
}

@code {
    private IReadOnlyList<Propagation>? all;
    private PropagationResult<string>? overall;
    private IReadOnlyList<PropagationResult<GrowingMedium>> byMedium = [];
    private IReadOnlyList<PropagationResult<PropagationType>> byType = [];
    private IReadOnlyList<RootingAidResult> byAid = [];
    private IReadOnlyList<DryingResult> byDrying = [];
    private IReadOnlyDictionary<GrowingMedium, FailureSummary> lostByMedium = new Dictionary<GrowingMedium, FailureSummary>();
    private FailureSummary? overallLost;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        all = await Repository.GetAllAsync();
        overall = PropagationResults.Overall(all);
        byMedium = PropagationResults.ByMedium(all);
        byType = PropagationResults.ByType(all);
        byAid = PropagationResults.ByRootingAid(all);
        byDrying = PropagationResults.ByDrying(all);

        var entries = new Dictionary<Guid, IReadOnlyList<TimelineEntry>>();
        foreach (var p in all.Where(p => !p.IsDeleted && p.FailedCount > 0))
            entries[p.Id] = await Timeline.GetForAsync(p.Id);
        lostByMedium = FailureResults.ByMedium(all, entries, Time);
        overallLost = FailureResults.Overall(all, entries, Time);
    }

    // Seeds come up and sprout where the rest root, so their rows use other words
    private static RenderFragment Row<TKey>(string name, PropagationResult<TKey> result, bool seeds, FailureSummary? lost = null) => __builder =>
    {
        <div class="result-row">
            <div class="result-head">
                <span class="result-name">@name</span>
                <span class="result-batches">@Plural.Of(result.Batches, Strings.Propagations.ListBatches_One, Strings.Propagations.ListBatches_Other)</span>
            </div>

            @if (result.SuccessRate is { } rate)
            {
                @* A full bar for 2 of 2 says the same thing a percentage would *@
                @if (result.Decided >= SmallSample)
                {
                    <div class="result-bar" role="img" aria-label="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsBarLabel, Percent(rate))">
                        <span style="width: @(Percent(rate))"></span>
                    </div>
                }
                <div class="result-line">
                    @if (result.Decided < SmallSample)
                    {
                        @((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsMadeItSmall, result.Succeeded, result.Decided))
                    }
                    else
                    {
                        @((MarkupString)string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsMadeItPercent, Percent(rate), result.Succeeded, result.Decided))
                    }
                    @if (result.Growing > 0)
                    {
                        <span class="text-body-secondary"> · @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsStillGoing, result.Growing)</span>
                    }
                </div>
            }
            else
            {
                <div class="result-line text-body-secondary">
                    @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsNothingYet, result.Growing)
                </div>
            }

            <div class="result-line">
                @if (result.AverageDaysToRoot is { } average)
                {
                    @if (result.DaysToRoot.Count == 1)
                    {
                        <span>@(seeds ? Plural.Of(result.FastestDaysToRoot!.Value, Strings.Propagations.StatsSprouted_One, Strings.Propagations.StatsSprouted_Other) : Plural.Of(result.FastestDaysToRoot!.Value, Strings.Propagations.StatsRooted_One, Strings.Propagations.StatsRooted_Other))</span>
                    }
                    else
                    {
                        <span>@(seeds ? Plural.Of(Days(average), Strings.Propagations.StatsSproutedAvg_One, Strings.Propagations.StatsSproutedAvg_Other) : Plural.Of(Days(average), Strings.Propagations.StatsRootedAvg_One, Strings.Propagations.StatsRootedAvg_Other))</span>
                        <span class="text-body-secondary">
                            · @string.Format(CultureInfo.CurrentCulture, Strings.Propagations.StatsRange, result.FastestDaysToRoot, result.SlowestDaysToRoot, result.DaysToRoot.Count)
                        </span>
                    }
                }
                else
                {
                    <span class="text-body-secondary">@(seeds ? Strings.Propagations.StatsNoSproutDates : Strings.Propagations.StatsNoRootDates)</span>
                }
            </div>

            @if (lost is not null)
            {
                <div class="result-line text-body-secondary">@LostText(lost)</div>
            }
        </div>
    };

    private static string LostText(FailureSummary lost)
    {
        var reasons = string.Join(", ", lost.Reasons.Select(r =>
            $"{(r.Reason is { } reason ? FailReasons.LostTo(reason) : Strings.Propagations.StatsNotRecorded)} {r.Units}"));
        var format = lost.MostlyAt switch
        {
            FailureStage.BeforeRooting => Strings.Propagations.StatsLostBefore,
            FailureStage.WhileRooting => Strings.Propagations.StatsLostWhile,
            FailureStage.AfterRooting => Strings.Propagations.StatsLostAfter,
            _ => Strings.Propagations.StatsLost
        };
        return string.Format(CultureInfo.CurrentCulture, format, reasons);
    }

    // Below this many units a percentage looks more certain than it is
    private const int SmallSample = 5;

    private static string Percent(double rate) =>
        $"{Math.Round(rate * 100, MidpointRounding.AwayFromZero):0}%";

    private static int Days(double average) => (int)Math.Round(average, MidpointRounding.AwayFromZero);
}
