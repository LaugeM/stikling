@page "/propagations"
@inject IPropagationRepository Repository
@inject IPlantRepository PlantRepository
@inject TimeProvider Time

<PageTitle>Propagations · Stikling</PageTitle>

<div class="page-heading">
    <h1>Propagations</h1>
    @if (all is { Count: > 0 })
    {
        <span class="text-body-secondary small">@visible.Count of @all.Count</span>
    }
</div>

@if (all is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (all.Count == 0)
{
    <div class="empty-state">
        <p>No propagations yet. Open a plant and tap <em>Propagate</em>, or start one without a parent plant, e.g. seeds.</p>
        <a class="btn btn-primary mt-3" href="propagations/new">Start a propagation</a>
    </div>
}
else
{
    <div class="list-filters">
        <input type="search" class="form-control" placeholder="Search by name…"
               aria-label="Search propagations" @bind="search" @bind:event="oninput" @bind:after="Refresh" />

        <div class="btn-group segmented" role="radiogroup" aria-label="Progress">
            @foreach (var (value, label) in progressOptions)
            {
                var id = $"progress-{value}";
                <input type="radio" class="btn-check" name="progress" id="@id"
                       checked="@(progress == value)" @onchange="() => SetProgress(value)" />
                <label class="btn btn-outline-primary btn-sm" for="@id">@label</label>
            }
        </div>
    </div>

    <div class="list-body">
    @if (visible.Count == 0)
    {
        <div class="empty-state"><p>No propagations match.</p></div>
    }

    @foreach (var experiment in experiments)
    {
        <section class="stage-group">
            <h2>@experiment.Name <span class="text-body-secondary">(@Labels.Count(experiment.Entries.Count, "batch", "batches"))</span></h2>
            <ul class="item-list experiment-list">
                @foreach (var entry in experiment.Entries)
                {
                    <li>
                        <a class="experiment-row" href="propagations/@entry.Propagation.Id"
                           aria-label="@entry.Propagation.DisplayName in @Labels.For(entry.Propagation.Medium)">
                            <span class="experiment-medium">@Labels.For(entry.Propagation.Medium)</span>
                            @if (entry.DaysToRoot is { } days)
                            {
                                <span class="experiment-result rooted">Rooted in @Labels.Count(days, "day")</span>
                            }
                            else
                            {
                                <span class="experiment-result">@(Labels.Stage(entry.Propagation.Stage, entry.Propagation.Type)) · day @entry.DaysRunning</span>
                            }
                            @if (entry.Propagation.PottedUpCount > 0 || entry.Propagation.FailedCount > 0)
                            {
                                <span class="experiment-outcome">@PropagationService.Outcome(entry.Propagation)</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (ungrouped.Count > 0 && progress == ProgressFilter.Active)
    {
        @foreach (var (stage, items) in PropagationFilter.ByStage(ungrouped))
        {
            <section class="stage-group">
                <h2>@Labels.Stage(stage) <span class="text-body-secondary">(@items.Count)</span></h2>
                <ul class="item-list">
                    @foreach (var propagation in items)
                    {
                        <li><PropagationCard Propagation="propagation" ParentName="@ParentName(propagation)" /></li>
                    }
                </ul>
            </section>
        }
    }
    else if (ungrouped.Count > 0)
    {
        <ul class="item-list">
            @foreach (var propagation in ungrouped)
            {
                <li><PropagationCard Propagation="propagation" ParentName="@ParentName(propagation)" ShowStage="true" /></li>
            }
        </ul>
    }
    </div>
}

<a class="fab" href="propagations/new" aria-label="Start a propagation" title="Start a propagation">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
</a>

@code {
    private static readonly (ProgressFilter Value, string Label)[] progressOptions =
    [
        (ProgressFilter.Active, "In progress"),
        (ProgressFilter.Finished, "Finished"),
        (ProgressFilter.All, "All")
    ];

    private IReadOnlyList<Propagation>? all;
    private List<Propagation> visible = [];

    // Batches in an experiment are shown under it instead of in the stage groups, so nothing appears twice
    private IReadOnlyList<ExperimentGroup> experiments = [];
    private List<Propagation> ungrouped = [];

    private Dictionary<Guid, Plant> plants = [];

    private string? search;
    private ProgressFilter progress = ProgressFilter.Active;

    protected override async Task OnInitializedAsync()
    {
        plants = (await PlantRepository.GetAllAsync()).ToDictionary(p => p.Id);
        all = await Repository.GetAllAsync();
        Refresh();
    }

    private void SetProgress(ProgressFilter value)
    {
        progress = value;
        Refresh();
    }

    private void Refresh()
    {
        visible = new PropagationFilter(search, progress).Apply(all ?? []).ToList();
        experiments = Experiments.Group(visible, DateOnly.FromDateTime(Time.GetLocalNow().DateTime));

        var grouped = experiments.SelectMany(e => e.Entries).Select(e => e.Propagation.Id).ToHashSet();
        ungrouped = visible.Where(p => !grouped.Contains(p.Id)).ToList();
    }

    private string? ParentName(Propagation propagation) =>
        propagation.ParentPlantId is { } id && plants.TryGetValue(id, out var parent) ? parent.DisplayName : null;
}
