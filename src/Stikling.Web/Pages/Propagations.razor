@page "/propagations"
@layout WideLayout
@using System.Globalization
@using Stikling.Core.Selection
@inject IPropagationRepository Repository
@inject RoomService RoomService
@inject IPlantRepository PlantRepository
@inject TimeProvider Time
@inject PlantNameService Names
@inject NavigationManager Navigation
@inject IPhotoRepository PhotoRepository
@inject ExperimentCardService Cards
@inject ShareCardService ShareCard
@implements IAsyncDisposable

<PageTitle>@Strings.Propagations.ListPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<RowPhotoDrop />

<div class="page-heading page-full">
    <h1>@Strings.Propagations.ListTitle</h1>
    @if (all is { Count: > 0 })
    {
        <div class="d-flex align-items-baseline gap-2">
            <span class="text-body-secondary small">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListShownOf, visible.Count, all.Count)</span>
            <a class="btn btn-link btn-sm link-action phone-link" href="swap">@Strings.Propagations.ListSwapLink</a>
            <button type="button" class="btn btn-link btn-sm link-action phone-link" @onclick="ToggleSelectMode">
                @(selecting ? Strings.Common.Done : Strings.Propagations.ListSelect)
            </button>
            @* Takes over from the round add button on a wide screen *@
            <a class="btn btn-primary btn-sm icon-btn heading-add" href="propagations/new">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                @Strings.Propagations.ListStart
            </a>
        </div>
    }
</div>

@if (all is { Count: > 0 })
{
    <a class="results-link phone-link" href="propagations/results">@Strings.Propagations.ListResultsLink</a>
}

@if (all is null)
{
    <p class="text-body-secondary">@Strings.Propagations.ListLoading</p>
}
else if (all.Count == 0)
{
    <div class="empty-state first-run">
        <svg viewBox="0 0 64 64" aria-hidden="true">
            <path class="glass" d="M21 26h22v26a6 6 0 0 1-6 6H27a6 6 0 0 1-6-6Z" /><path class="glass" d="M21 37h22" opacity="0.45" />
            <path class="growth" d="M32 53V14" /><path class="growth" d="M32 25c0-7-5-11-12-11 0 7 5 11 12 11Z" /><path class="growth" d="M32 20c0-6 5-10 12-10 0 6-5 10-12 10Z" />
            <path class="growth" d="M32 53c-2 0-5-1-6-3M32 53c2 0 5-1 6-3M32 49c-2 0-4-1-5-2M32 49c2 0 4-1 5-2" />
        </svg>
        <h2>@Strings.Propagations.ListEmptyTitle</h2>
        <p>@Strings.Propagations.ListEmptyWhat</p>
        <p>@((MarkupString)Strings.Propagations.ListEmptyHow)</p>
        <div class="first-run-actions">
            <a class="btn btn-primary" href="propagations/new">@Strings.Propagations.ListStart</a>
        </div>
        <a class="first-run-help" href="help#propagations">@Strings.Propagations.ListHelpLink</a>
    </div>
}
else
{
    <div class="list-layout">
    <div class="list-side">
        @* The page's links: a row under the title from 64rem, quiet rows at the top of the filter column from 80rem. A phone has them in the heading above. *@
        <div class="list-side-links">
            <a class="btn btn-link btn-sm link-action list-side-link" href="swap">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h14M14 4l4 4-4 4M20 16H6M10 12l-4 4 4 4" /></svg>
                @Strings.Propagations.ListSwapLink
            </a>
            <a class="btn btn-link btn-sm link-action list-side-link" href="propagations/results">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V12M12 20V5M19 20v-9" /></svg>
                @Strings.Propagations.ListResultsLink
            </a>
            <button type="button" class="btn btn-link btn-sm link-action list-side-link" @onclick="ToggleSelectMode">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8.5 12.2 2.4 2.4 4.6-5" /></svg>
                @(selecting ? Strings.Common.Done : Strings.Propagations.ListSelect)
            </button>
        </div>

    <div class="list-filters">
        <input type="search" class="form-control" placeholder="@Strings.Propagations.ListSearchPlaceholder"
               aria-label="@Strings.Propagations.ListSearchLabel" @bind="search" @bind:event="oninput" @bind:after="Refresh" />

        <div class="btn-group segmented" role="radiogroup" aria-label="@Strings.Propagations.ListProgressLabel">
            @foreach (var (value, label) in progressOptions)
            {
                var id = $"progress-{value}";
                <input type="radio" class="btn-check" name="progress" id="@id"
                       checked="@(progress == value)" @onchange="() => SetProgress(value)" />
                <label class="btn btn-outline-primary" for="@id">@label</label>
            }
        </div>
    </div>

    @if (Narrowed)
    {
        <button type="button" class="btn btn-link btn-sm link-action list-side-clear" @onclick="ClearFilters">@Strings.Propagations.ListClearFilters</button>
    }
    </div>

    <div class="list-main">
    @if (selecting)
    {
        <div class="select-all">
            <button type="button" class="btn btn-link btn-sm link-action" @onclick="SelectAllShown">@Strings.Propagations.ListSelectAll</button>
            @if (selected.Count > 0)
            {
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => selected.Clear()">@Strings.Propagations.ListClearSelection</button>
            }
        </div>
    }

    <div class="list-body">
    @if (visible.Count == 0)
    {
        <div class="empty-state">
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <p>@Strings.Propagations.ListNoMatch</p>
                <button type="button" class="btn btn-outline-primary mt-3" @onclick="ClearSearch">@Strings.Propagations.ListClearSearch</button>
            }
            else if (progress == ProgressFilter.Active)
            {
                <p>@Strings.Propagations.ListNothingInProgress</p>
                <a class="btn btn-primary mt-3" href="propagations/new">@Strings.Propagations.ListStart</a>
            }
            else
            {
                <p>@Strings.Propagations.ListNoneFinished</p>
            }
        </div>
    }

    @* The batches of an experiment are plain cards while picking, so each can be ticked *@
    @foreach (var experiment in experiments.Where(_ => !selecting))
    {
        var longest = Math.Max(1, experiment.Entries.Max(e => BarDays(e) ?? 0));
        <section class="stage-group">
            <div class="experiment-heading">
                <h2>@experiment.Name <span class="text-body-secondary">(@Plural.Of(experiment.Entries.Count, Strings.Propagations.ListBatches_One, Strings.Propagations.ListBatches_Other))</span></h2>
                @if (ExperimentCardService.CanShare(experiment))
                {
                    var name = experiment.Name;
                    <button type="button" class="btn btn-link btn-sm link-action experiment-share"
                            aria-label="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ExpShareLabel, name)"
                            @onclick="() => OpenShareAsync(name)">@Strings.Shared.ShareButton</button>
                }
            </div>
            @if (FairComparison.InExperiment(experiment, places) is var differing && FairComparison.IsMoreThanOne(differing))
            {
                <p class="experiment-note">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListExperimentNotFair, Labels.List(differing))</p>
            }
            <ul class="item-list experiment-list">
                @foreach (var entry in experiment.Entries)
                {
                    <li>
                        <a class="experiment-row" href="propagations/@entry.Propagation.Id"
                           aria-label="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListRowLabel, entry.Propagation.DisplayName, Labels.For(entry.Propagation.Medium))">
                            <span class="experiment-medium">@Labels.For(entry.Propagation.Medium)</span>
                            @if (entry.DaysToRoot is { } days)
                            {
                                <span class="experiment-result rooted">@Plural.Of(days, Strings.Propagations.ListRootedIn_One, Strings.Propagations.ListRootedIn_Other)</span>
                            }
                            else
                            {
                                <span class="experiment-result">
                                    @(Labels.Stage(entry.Propagation.Stage, entry.Propagation.Type)) · @string.Format(CultureInfo.CurrentCulture, Strings.Labels.AgeDay, entry.DaysRunning)
                                    @if (Pace(entry.Propagation) is { IsSlow: true })
                                    {
                                        <span class="pace-slow"> · @Strings.Propagations.ListSlow</span>
                                    }
                                </span>
                            }
                            @if (BarDays(entry) is { } barDays)
                            {
                                var share = (barDays / (double)longest).ToString("0.###", CultureInfo.InvariantCulture);
                                <span class="experiment-bar @(entry.DaysToRoot is null ? "running" : null)" aria-hidden="true">
                                    <span style="--share: @share"></span>
                                </span>
                            }
                            @if (Milestones(entry.Propagation) is { } milestones)
                            {
                                <span class="experiment-milestones">@milestones</span>
                            }
                            @if (entry.Propagation.PottedUpCount > 0 || entry.Propagation.FailedCount > 0 || entry.Propagation.GivenAwayCount > 0)
                            {
                                <span class="experiment-outcome">@PropagationService.Outcome(entry.Propagation)</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (selecting && experiments.Count > 0)
    {
        <ul class="item-list list-grid">
            @foreach (var propagation in experiments.SelectMany(e => e.Entries).Select(e => e.Propagation))
            {
                <li>
                    <PropagationCard Propagation="propagation" ParentName="@ParentName(propagation)" ShowStage="true" Pace="@Pace(propagation)"
                                     Selectable="true" Selected="selected.Contains(propagation.Id)" OnToggle="Toggle" />
                </li>
            }
        </ul>
    }

    @if (ungrouped.Count > 0 && progress == ProgressFilter.Active)
    {
        @foreach (var (stage, items) in PropagationFilter.ByStage(ungrouped))
        {
            <section class="stage-group">
                <h2>@Labels.Stage(stage) <span class="text-body-secondary">(@items.Count)</span></h2>
                <ul class="item-list list-grid">
                    @foreach (var propagation in items)
                    {
                        <li>
                            <PropagationCard Propagation="propagation" ParentName="@ParentName(propagation)" Pace="@Pace(propagation)"
                                             Selectable="selecting" Selected="selected.Contains(propagation.Id)" OnToggle="Toggle" />
                        </li>
                    }
                </ul>
            </section>
        }
    }
    else if (ungrouped.Count > 0)
    {
        <ul class="item-list list-grid">
            @foreach (var propagation in ungrouped)
            {
                <li>
                    <PropagationCard Propagation="propagation" ParentName="@ParentName(propagation)" ShowStage="true" Pace="@Pace(propagation)"
                                     Selectable="selecting" Selected="selected.Contains(propagation.Id)" OnToggle="Toggle" />
                </li>
            }
        </ul>
    }
    </div>
    </div>
    </div>
}

@if (selecting)
{
    <div class="bulk-bar" role="region" aria-label="@Strings.Propagations.ListBulkLabel">
        <div class="bulk-row">
            <span class="bulk-count">@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListSelectedCount, selected.Count)</span>
            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(selected.Count == 0)"
                    @onclick="OpenLabels">@Strings.Propagations.ListLabels</button>
        </div>
    </div>
}
else
{
    <a class="fab" href="propagations/new" aria-label="@Strings.Propagations.ListStart" title="@Strings.Propagations.ListStart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
}

<Sheet Title="@Strings.Shared.SwapShareTitle" Open="shareOpen" OpenChanged="ShareOpenChangedAsync">
    <div class="experiment-label" id="experiment-format-label">@Strings.Shared.SwapSize</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="experiment-format-label">
        @foreach (var (value, label) in ShareCardService.Formats)
        {
            var id = $"experiment-format-{value}";
            <input type="radio" class="btn-check" name="experiment-format" id="@id"
                   checked="@(format == value)" @onchange="() => SetFormatAsync(value)" />
            <label class="btn btn-outline-primary" for="@id">@label</label>
        }
    </div>
    <div class="experiment-picture" style="@AspectStyle" aria-busy="@(drawn is null ? "true" : null)">
        @if (drawn is not null)
        {
            <img src="@drawn.Url" alt="@string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ExpCardAlt, shareName)" />
        }
    </div>
    @if (drawn is { Missing: > 0 })
    {
        <p class="experiment-note">@Plural.Of(drawn.Missing, Strings.Shared.SwapMissingPhotos_One, Strings.Shared.SwapMissingPhotos_Other)</p>
    }
    <div class="form-actions">
        <button type="button" class="btn btn-primary" disabled="@(drawn is null)" @onclick="SharePictureAsync">@Strings.Shared.ShareButton</button>
        <button type="button" class="btn btn-outline-primary" disabled="@(drawn is null)" @onclick="SavePictureAsync">@Strings.Shared.SwapSave</button>
        @if (status.Length > 0)
        {
            <span class="experiment-status" role="status">@status</span>
        }
    </div>
</Sheet>

<canvas @ref="canvas" hidden aria-hidden="true"></canvas>

@code {
    private static readonly (ProgressFilter Value, string Label)[] progressOptions =
    [
        (ProgressFilter.Active, Strings.Propagations.ListProgressActive),
        (ProgressFilter.Finished, Strings.Propagations.ListProgressFinished),
        (ProgressFilter.All, Strings.Propagations.ListProgressAll)
    ];

    private IReadOnlyList<Propagation>? all;
    private List<Propagation> visible = [];

    // Batches in an experiment are shown under it instead of in the stage groups, so nothing appears twice
    private IReadOnlyList<ExperimentGroup> experiments = [];
    private Places places = new([]);
    private List<Propagation> ungrouped = [];

    private Dictionary<Guid, Plant> plants = [];

    private bool selecting;
    private readonly HashSet<Guid> selected = [];
    private Guid? selectAnchor;

    private string? search;
    private ProgressFilter progress = ProgressFilter.Active;

    protected override Task OnInitializedAsync() => LoadAsync();

    private EverydayNameBook? everyday;

    private async Task LoadAsync()
    {
        everyday = await Names.GetEverydayNamesAsync();
        plants = (await PlantRepository.GetAllAsync()).ToDictionary(p => p.Id);
        all = await Repository.GetAllAsync();
        places = await RoomService.GetPlacesAsync();
        Refresh();
    }

    private void ToggleSelectMode()
    {
        selecting = !selecting;
        selected.Clear();
        selectAnchor = null;
    }

    // A click in Select mode; shift picks every row between the last one clicked and this one, as shown
    private void Toggle(SelectClick click)
    {
        var shown = experiments.SelectMany(e => e.Entries).Select(e => e.Propagation)
            .Concat(progress == ProgressFilter.Active
                ? PropagationFilter.ByStage(ungrouped).SelectMany(g => g.Item2)
                : ungrouped)
            .Select(p => p.Id).ToList();
        selectAnchor = SelectionRange.Apply(shown, selected, selectAnchor, click.Id, click.Shift);
    }

    private void SelectAllShown()
    {
        foreach (var propagation in visible)
            selected.Add(propagation.Id);
    }

    // The selected cuttings, in the order of the list, on the page that makes their labels
    private void OpenLabels() =>
        Navigation.NavigateTo($"labels?cuttings={string.Join(',', visible.Where(p => selected.Contains(p.Id)).Select(p => p.Id))}");

    private void SetProgress(ProgressFilter value)
    {
        progress = value;
        Refresh();
    }

    private void ClearSearch()
    {
        search = null;
        Refresh();
    }

    // True while the list shows less than the page opens with: a search, or Finished or All picked
    private bool Narrowed => !string.IsNullOrWhiteSpace(search) || progress != ProgressFilter.Active;

    private void ClearFilters()
    {
        search = null;
        progress = ProgressFilter.Active;
        Refresh();
    }

    private void Refresh()
    {
        visible = new PropagationFilter(search, progress, p => everyday?.For(p.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(p.Species, p.NameQualifier), p.Cultivar)).Apply(all ?? []).ToList();
        experiments = Experiments.Group(visible, Time.Today());

        var grouped = experiments.SelectMany(e => e.Entries).Select(e => e.Propagation.Id).ToHashSet();
        ungrouped = visible.Where(p => !grouped.Contains(p.Id)).ToList();
    }

    // Days to root, or days so far for a batch still going. A batch that finished without
    // rooting gets no bar, since its count of days stopped meaning anything.
    private static int? BarDays(ExperimentEntry entry) =>
        entry.DaysToRoot ?? (entry.Propagation.IsActive ? entry.DaysRunning : null);

    // Compared with every propagation, not only the ones the filter shows
    private RootingPace? Pace(Propagation propagation) => RootingPace.For(propagation, all ?? [], Time.Today());

    // "Corm 8 mm · first root day 8 · first leaf day 20", so the batches in an experiment compare on more than rooting
    private static string? Milestones(Propagation propagation)
    {
        var parts = new List<string>(3);
        if (propagation.Type == PropagationType.Corm && propagation.CormSizeMm is { } size)
            parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListMilestoneCorm, Lengths.Mm(size)));
        if (propagation.DaysToFirstRoot is { } root)
            parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListMilestoneRoot, root));
        if (propagation.DaysToFirstLeaf is { } leaf)
            parts.Add(string.Format(CultureInfo.CurrentCulture, Strings.Propagations.ListMilestoneLeaf, leaf));
        if (parts.Count == 0)
            return null;
        var text = string.Join(" · ", parts);
        return char.ToUpperInvariant(text[0]) + text[1..];
    }

    // ---- An experiment's result as a picture ----

    private bool shareOpen;
    private bool disposed;
    private string shareName = "";
    private string format = "square";
    private string status = "";
    private SwapCardDrawn? drawn;
    private ElementReference canvas;
    private int drawRun;

    private string AspectStyle => format switch
    {
        "square" => "--aspect: 1 / 1;",
        "portrait" => "--aspect: 4 / 5;",
        _ => "--aspect: 9 / 16;",
    };

    private async Task OpenShareAsync(string name)
    {
        shareName = name;
        status = "";
        drawn = null;
        shareOpen = true;
        format = await ShareCard.GetFormatAsync();
        await DrawAsync();
    }

    private async Task ShareOpenChangedAsync(bool open)
    {
        shareOpen = open;
        if (!open)
        {
            drawRun++;
            drawn = null;
            await Cards.ReleaseAsync();
        }
    }

    private async Task SetFormatAsync(string value)
    {
        format = value;
        status = "";
        await ShareCard.SetFormatAsync(value);
        await DrawAsync();
    }

    // The result is worked out from every batch with that name, whatever the list's filters show
    private async Task DrawAsync()
    {
        var run = ++drawRun;
        drawn = null;
        await Cards.ReleaseAsync();
        StateHasChanged();

        var group = Experiments.Group(all ?? [], Time.Today())
            .FirstOrDefault(g => string.Equals(g.Name, shareName, StringComparison.OrdinalIgnoreCase));
        if (group is null)
        {
            // Its last batch was deleted or renamed on another device while the sheet was open
            status = Strings.Shared.SwapDrawFailed;
            StateHasChanged();
            return;
        }

        try
        {
            var photos = await PhotoRepository.GetOfKindAsync(SubjectType.Propagation);
            var spec = ExperimentCardService.SpecFor(group, Experiments.Result(group, photos), format);
            var result = await Cards.DrawAsync(canvas, spec);
            if (run != drawRun || disposed)
            {
                // The sheet closed while it was drawing, so let go of the picture it just made.
                // A newer draw on the canvas makes this one come back null, and there is nothing to let go of.
                if (result is not null)
                    await Cards.ReleaseAsync();
                return;
            }
            drawn = result;
        }
        catch (JSException)
        {
            // Share and Save stay off, so say why. Picking another size draws it again
            status = Strings.Shared.SwapDrawFailed;
        }
        StateHasChanged();
    }

    private string FileName => ExperimentCardService.FileNameFor(shareName);

    private async Task SharePictureAsync() => await ShowStatusAsync(await Cards.ShareAsync(FileName) switch
    {
        "saved" => Strings.Shared.SwapSaved,
        "failed" => Strings.Shared.ShareFailed,
        _ => ""
    });

    private async Task SavePictureAsync() => await ShowStatusAsync(await Cards.SaveAsync(FileName) switch
    {
        "saved" => Strings.Shared.SwapSaved,
        _ => Strings.Shared.ShareFailed
    });

    private async Task ShowStatusAsync(string text)
    {
        status = text;
        if (status.Length == 0)
            return;

        StateHasChanged();
        await Task.Delay(3000);
        if (!disposed && status == text)
        {
            status = "";
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        drawRun++;
        await Cards.ReleaseAsync();
    }

    private string? ParentName(Propagation propagation) =>
        propagation.ParentPlantId is { } id && plants.TryGetValue(id, out var parent) ? parent.DisplayName : null;
}
