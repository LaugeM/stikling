@page "/sign-in"
@* Clerk's sign-in, which also creates an account for someone new. It comes back to Settings once done. *@
@implements IAsyncDisposable
@inject AccountService Account
@inject StiklingApi Api
@inject NavigationManager Nav

<PageTitle>Sign in · Stikling</PageTitle>

<a class="back-link" href="settings">Settings</a>
<h1>Sign in</h1>

@if (!Account.IsAvailable)
{
    <p class="account-note">Signing in isn't available in this version of Stikling.</p>
}
else if (unavailable)
{
    <p class="account-note">
        The sign-in service can't be reached. Check that you're online and try again. Everything else in
        the app works without it.
    </p>
    <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Try again</button>
}
else
{
    <p class="account-note">
        Use an account you already have with Google, Facebook or Discord, or your email. With email you
        get a code to type in, so there's no password to remember. If you're new, this creates your
        Stikling account. The <a href="privacy">privacy page</a> says what is kept and where.
    </p>
    @if (loading)
    {
        <p class="account-note" role="status">Loading…</p>
    }
}

@if (Account.IsTestSignInAvailable)
{
    @* Development only, so signed-in screens and syncs can be tried without Clerk *@
    <form class="test-sign-in" @onsubmit="SignInAsTestPersonAsync">
        <label class="form-label" for="test-person">Test person</label>
        <input id="test-person" class="form-control" autocomplete="off" @bind="testName" />
        <p class="settings-hint">
            Only while developing. The local API takes this person in place of Clerk. The same name is
            the same person on every device, and a new name is a new person.
        </p>
        <div class="settings-actions">
            <button type="submit" class="btn btn-outline-primary" disabled="@signingInAsTest">Sign in as a test person</button>
        </div>
    </form>
}

@* Clerk draws into this, so Blazor never renders anything inside it *@
<div class="account-sign-in" @ref="signIn" hidden="@(!Account.IsAvailable || unavailable)"></div>

@code {
    private ElementReference signIn;
    private bool loading = true;
    private bool unavailable;
    private bool mounted;
    private string testName = "person";
    private bool signingInAsTest;

    private string SettingsUrl => Nav.ToAbsoluteUri("settings").ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Account.IsAvailable)
        {
            // The API starts while Clerk loads and the person signs in, so the first sync is quicker
            Api.Wake();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        unavailable = false;
        loading = true;
        StateHasChanged();

        try
        {
            var state = await Account.LoadAsync();
            if (state.SignedIn)
            {
                Nav.NavigateTo(SettingsUrl, replace: true);
                return;
            }

            await Account.MountSignInAsync(signIn, SettingsUrl);
            mounted = true;
        }
        catch (AccountUnavailableException)
        {
            unavailable = true;
        }

        loading = false;
        StateHasChanged();
    }

    private async Task SignInAsTestPersonAsync()
    {
        // The name goes into the token, so it keeps to letters, digits and dashes
        var name = new string(testName.Trim().ToLowerInvariant().Where(c => char.IsAsciiLetterOrDigit(c) || c == '-').ToArray());
        signingInAsTest = true;
        await UnmountAsync();
        await Account.SignInAsTestPersonAsync(name.Length > 0 ? name : "person");
        Nav.NavigateTo(SettingsUrl, replace: true);
    }

    private async Task UnmountAsync()
    {
        if (!mounted)
            return;

        mounted = false;
        try
        {
            await Account.UnmountSignInAsync(signIn);
        }
        catch (JSException)
        {
            // Clerk's sign-in is going away either way
        }
    }

    public ValueTask DisposeAsync() => new(UnmountAsync());
}
