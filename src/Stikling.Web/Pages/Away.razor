@page "/away"
@using System.Globalization
@using Stikling.Core.Settings
@inject AwayService AwayService
@inject SettingsService SettingsService
@inject TimeProvider Time

<PageTitle>@Strings.Care.AwayPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="settings?section=care">@Strings.Care.BackToSettings</a>

<div class="page-heading">
    <h1>@Strings.Care.AwayTitle</h1>
    @* Takes over from the round add button on a wide screen *@
    <a class="btn btn-primary btn-sm icon-btn heading-add" href="away/new">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        @Strings.Common.Add
    </a>
</div>

<p class="text-body-secondary">
    @Strings.Care.AwayHint
</p>

@if (stretches is null)
{
    <p class="text-body-secondary">@Strings.Care.Loading</p>
}
else
{
    <ul class="item-list mb-3">
        <li>
            <a class="item-card" href="sitter-sheet">
                <div class="item-thumb" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7Z" /><path d="M15 3v4h4M10 12h6M10 16h6" /></svg>
                </div>
                <div class="item-text">
                    <div class="item-name">@Strings.Care.AwaySitterSheet</div>
                    <div class="item-meta"><span>@Strings.Care.AwaySitterSheetMeta</span></div>
                </div>
            </a>
        </li>
    </ul>

    @if (stretches.Count == 0)
    {
        <div class="empty-state">
            <p>@Strings.Care.AwayEmpty</p>
        </div>
    }
    else
    {
        <ul class="item-list">
            @foreach (var stretch in stretches)
            {
                <li>
                    <a class="item-card" href="away/@stretch.Id">
                        <div class="item-thumb" aria-hidden="true">
                            @if (stretch.Kind == AwayKind.Away)
                            {
                                <svg viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="11" rx="2" /><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M5 13h14" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24"><path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z" /></svg>
                            }
                        </div>
                        <div class="item-text">
                            <div class="item-name">@(stretch.Kind == AwayKind.Away ? Strings.Care.AwayKindAway : Strings.Care.AwayKindQuiet)</div>
                            <div class="item-meta">
                                <span>@string.Format(CultureInfo.CurrentCulture, Strings.Care.AwayRange, Stikling.Core.Away.SitterSheetText.Day(stretch.From), stretch.Until.ToString(Strings.Care.DayMonthYearLongFormat, Stikling.Core.Text.TextCulture.ForDates))</span>
                                @if (stretch.IsOn(Today))
                                {
                                    <span>@Strings.Care.AwayOnNow</span>
                                }
                                else if (stretch.From > Today)
                                {
                                    <span>@Strings.Care.AwayComingUp</span>
                                }
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }

    <section class="settings-group mt-4">
        <h2>@Strings.Care.AwayAfterBreak</h2>
        <div class="theme-label" id="back-length-label">@Strings.Care.AwayLookFirst</div>
        <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="back-length-label">
            @foreach (var (length, label) in lengthOptions)
            {
                var id = $"back-length-{length}";
                <input type="radio" class="btn-check" name="back-length" id="@id"
                       checked="@(backLength == length)" @onchange="() => SetBackLengthAsync(length)" />
                <label class="btn btn-outline-primary" for="@id">@label</label>
            }
        </div>
        <p class="settings-hint">
            @Strings.Care.AwayAfterBreakHint
        </p>
    </section>

    <a class="fab" href="away/new" aria-label="@Strings.Care.AwayAddLabel" title="@Strings.Care.AwayAddLabel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
}

@code {
    private static (int Length, string Label)[] lengthOptions =>
    [
        (3, "3"),
        (5, "5"),
        (10, "10"),
        (0, Strings.Care.AwayAll)
    ];

    private IReadOnlyList<AwayStretch>? stretches;
    private int backLength = BackList.DefaultLength;

    private DateOnly Today => Time.Today();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        stretches = [.. (await AwayService.GetAllAsync()).OrderByDescending(s => s.From).ThenByDescending(s => s.Until)];
        backLength = (await SettingsService.GetAsync()).BackListLength ?? BackList.DefaultLength;
    }

    private async Task SetBackLengthAsync(int length)
    {
        backLength = length;
        await SettingsService.SetBackListLengthAsync(length);
    }
}
