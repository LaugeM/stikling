@page "/round/{PlaceId:guid}"
@page "/round/due"
@page "/round/next"
@page "/round/back"
@attribute [NeedsAccess(AccessLevel.Log)]
@using GoingRoundLogic = Stikling.Core.Today.GoingRound
@using Stikling.Core.Settings
@implements IAsyncDisposable
@inject ScreenAwake Awake
@inject Announcer Announcer
@inject CoverPhotos Covers
@inject IPlantRepository Plants
@inject ILogger<GoingRound> Logger
@inject IPropagationRepository Propagations
@inject ICareLogRepository CareLogs
@inject ITimelineRepository Entries
@inject IPotRepository PotRepository
@inject IPestCaseRepository PestCases
@inject NavigationManager Navigation
@inject GrowLightService LightService
@inject AwayService AwayService
@inject RoomService RoomService
@inject SettingsService SettingsService
@inject PutOffService PutOffService
@inject WateringAnswers Answers
@inject CareService Care
@inject TimelineService TimelineService
@inject SubjectPhotos SubjectPhotos
@inject CameraService Camera
@inject IPhotoRepository PhotoRepository
@inject DeviceFiles Files
@inject TimeProvider Time

<PageTitle>@(F(Strings.Care.RoundPageTitle, Title))</PageTitle>

@* No ReloadOnSync: like an edit page, the cards stay put while someone is going round *@

<a class="back-link" href="@BackHref">@BackLabel</a>

@if (!loaded)
{
    <p class="text-body-secondary">@Strings.Care.Loading</p>
}
else if (placeMissing)
{
    <h1>@Strings.Care.RoundGoingRound</h1>
    <div class="empty-state">
        <p>@Strings.Care.RoundRoomGone</p>
        <a class="btn btn-primary mt-3" href="">@Strings.Care.RoundBackToTodayButton</a>
    </div>
}
else if (cards.Count == 0)
{
    <h1>@Title</h1>
    <div class="empty-state">
        @if (IsBack)
        {
            <p>@Strings.Care.RoundNothingBack</p>
            <a class="btn btn-primary mt-3" href="">@Strings.Care.RoundBackToTodayButton</a>
        }
        else if (IsNext)
        {
            <p>@Strings.Care.RoundNothingNext</p>
            <a class="btn btn-primary mt-3" href="">@Strings.Care.RoundBackToTodayButton</a>
        }
        else if (IsDue)
        {
            <p>@Strings.Care.RoundNothingDue</p>
            <a class="btn btn-primary mt-3" href="">@Strings.Care.RoundBackToTodayButton</a>
        }
        else
        {
            <p>@(F(Strings.Care.RoundNothingInRoom, Title))</p>
            <a class="btn btn-primary mt-3" href="plants">@Strings.Care.RoundGoToPlants</a>
        }
    </div>
}
else if (pos >= queue.Count)
{
    var summary = GoingRoundLogic.Summarise(days);
    <div class="round-end">
        <h1>@(IsDue || IsNext || IsBack ? Strings.Care.RoundAllDone : F(Strings.Care.RoundRoomDone, Title))</h1>
        <div class="round-tiles">
            @if (summary.Watered > 0)
            {
                <div class="round-tile"><span class="round-count">@summary.Watered</span><span>@Strings.Care.WateringDoneWatered</span></div>
            }
            @if (summary.LookedOver > 0)
            {
                <div class="round-tile"><span class="round-count">@summary.LookedOver</span><span>@Strings.Care.RoundTileLookedOver</span></div>
            }
            <div class="round-tile"><span class="round-count">@summary.Skipped</span><span>@Strings.Care.RoundTileSkipped</span></div>
        </div>
        @if (summary.Readings > 0 || summary.Photos > 0)
        {
            <p class="round-meta">@EndMeta(summary)</p>
        }
        @if (queue.Count == 0)
        {
            <p class="round-meta">@Strings.Care.RoundEveryoneNeedsHand</p>
            @RoundStart
        }
        <div class="round-end-actions">
            <a class="btn btn-primary" href="">@Strings.Care.RoundBackToTodayButton</a>
            @if (summary.Skipped > 0)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="GoThroughSkipped">
                    @(F(Strings.Care.RoundGoThroughSkipped, summary.Skipped))
                </button>
            }
        </div>
    </div>
}
else
{
    var index = queue[pos];
    var card = cards[index];
    var day = days[index];
    var plant = card.Subject as Plant;
    var form = card.Form;
    // What the card says, as one sentence for a screen reader
    var lastWatered = form is { } watering && CareSummary.Latest(careLogs, card.Subject.Id, WateringForms.DoneKind(watering), Today) is { } lastLog
        ? (int?)lastLog.DaysAgo : null;
    (int, int)? lastReading = day.Reading is null && form is not null && CareSummary.LatestMoisture(careLogs, card.Subject.Id, Today) is { } latestReading
        ? (latestReading.Value, latestReading.DaysAgo) : null;
    var handLine = plant is not null && NeedsAHand.Line(plant) is { } hand ? F(Strings.Plants.NeedsAHandLine, hand) : null;
    var dueLine = card.DueNow && card.Guess is { } dueGuess && plant is not null && day.WateredId is null
        ? WateringText.Row(new WateringDue(plant, dueGuess, (dueGuess.CheckOn ?? Today) <= Today, Today, false), Today) : null;
    <div class="round" tabindex="-1" @ref="wrapper" @onkeydown="OnKeyAsync">
        <div class="round-head">
            <h1>@Title</h1>
            <div class="round-counter">
                <span class="round-position">@(F(Strings.Care.RoundPosition, pos + 1, queue.Count))</span>
                <button type="button" class="round-back" disabled="@(pos == 0 || busy)" @onclick="Back">
                    <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronLeft</svg>
                    @Strings.Common.Back
                </button>
            </div>
            <progress class="round-progress" max="@queue.Count" value="@pos" aria-label="@Strings.Care.RoundProgress"></progress>
        </div>

        @if (pos == 0)
        {
            @RoundStart
        }

        @if (card.Heading is { } heading && (pos == 0 || index == 0 || cards[index - 1].Heading != heading))
        {
            <h2 class="section-label round-heading">@heading</h2>
        }

        <RoundCardFrame @key="pos" @ref="frame" Class="@($"round-card {MoveClass}")" Name="@card.Name" Place="@card.Heading" Form="form"
                        LastWateredDaysAgo="lastWatered" ReadingToday="day.Reading?.Value" LastReading="lastReading" DueLine="@dueLine"
                        HandLine="@handLine" Dormant="card.Dormant" LookedOverToday="day.LookedOverId is not null" PhotoToday="day.Photo">
            <div class="round-photo">
                @if (CoverOf(card.Subject) is { } coverId)
                {
                    <PhotoImage PhotoId="coverId" Thumbnail="false" Alt="@(F(Strings.Care.RoundPhotoOf, card.Name))" />
                }
                else
                {
                    <div class="round-photo-empty @(plant is null ? "propagation" : null)" aria-hidden="true">
                        @if (plant is null)
                        {
                            <svg viewBox="0 0 24 24">@Icons.Feed</svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">@Icons.Sprout</svg>
                        }
                    </div>
                }
            </div>

            <div class="round-body">
                <div class="round-facts">
                    <h2 class="round-name">@card.Name</h2>
                    @if (SpeciesOf(card.Subject) is { } species)
                    {
                        <div class="round-species"><BotanicalName Genus="@species.Genus" Species="@species.Species" Cultivar="@species.Cultivar" /></div>
                    }
                    @if (handLine is not null)
                    {
                        <p class="round-meta">@handLine</p>
                    }
                    @if (MetaOf(card, day) is { Length: > 0 } meta)
                    {
                        <p class="round-meta">@meta</p>
                    }
                    @if (dueLine is not null)
                    {
                        <p class="round-meta">@dueLine</p>
                    }
                    @if (card.Dormant)
                    {
                        <span class="stage-badge badge">@Strings.Care.RoundDormant</span>
                    }
                </div>

                <div class="round-controls">
                    @if (form == WateringForm.TopWatered)
                    {
                        <div class="round-readings" role="group" aria-label="@Strings.Care.RoundMeterReading">
                            <span class="section-label">@Strings.Care.RoundMeterReading</span>
                            <div class="answer-grid">
                                @for (var n = 0; n <= 10; n++)
                                {
                                    var reading = n;
                                    var picked = day.Reading?.Value == n;
                                    <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                            disabled="@busy" @onclick="() => ReadingAsync(reading)">@n</button>
                                }
                            </div>
                        </div>
                    }

                    <div class="round-actions">
                        @if (form is { } waterForm)
                        {
                            <button type="button" class="btn btn-primary round-action" aria-pressed="@(day.WateredId is null ? "false" : "true")"
                                    disabled="@busy" @onclick="WaterAsync">
                                @if (day.WateredId is not null)
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Check</svg>
                                }
                                @WateringText.DoneLabel(waterForm)
                            </button>
                        }
                        @* "Looked over" is a line on the history, which a helper can't send *@
                        <IfCan Edit>
                        <button type="button" class="btn btn-outline-primary round-action" aria-pressed="@(day.LookedOverId is null ? "false" : "true")"
                                disabled="@busy" @onclick="LookedOverAsync">
                            @if (day.LookedOverId is not null)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Check</svg>
                            }
                            @Strings.Care.RoundTileLookedOver
                        </button>
                        </IfCan>
                    </div>

                    <div class="round-more">
                        <label class="round-text-btn @(busy ? "disabled" : null)" for="round-photo-input">
                            @if (day.Photo)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Check</svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.Camera</svg>
                            }
                            @Strings.Care.RoundPhoto
                            @if (day.Photo)
                            {
                                <span class="visually-hidden">@Strings.Care.RoundPhotoAdded</span>
                            }
                        </label>
                        <input id="round-photo-input" type="file" accept="image/*" capture="environment" class="visually-hidden"
                               @ref="photoInput" @onchange="PhotoAsync" disabled="@busy" />
                        @if (cameraAvailable && hasPhoto.Contains(card.Subject.Id))
                        {
                            <button type="button" class="round-text-btn round-same-angle" disabled="@busy" @onclick="() => cameraOpen = true">
                                <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.EmptyPhoto</svg>
                                @Strings.Camera.SameAngle
                            </button>
                        }
                        <button type="button" class="round-text-btn" disabled="@busy" @onclick="Skip">
                            @Strings.Care.RoundSkip
                            <svg viewBox="0 0 24 24" aria-hidden="true">@Icons.ChevronRightSmall</svg>
                        </button>
                    </div>

                    @if (status is not null)
                    {
                        <p class="today-row-status">@status</p>
                    }
                </div>
            </div>
        </RoundCardFrame>

        <p class="round-keys">@Strings.Care.RoundKeys</p>
    </div>

    @* Outside the round, so its keys don't act on the camera's *@
    <GhostCamera SubjectType="card.Subject is Plant ? SubjectType.Plant : SubjectType.Propagation" SubjectId="card.Subject.Id" Open="cameraOpen"
                 PickerInputId="round-photo-input" OnClosed="() => cameraOpen = false" OnTaken="CameraTakenAsync" />
}

@code {
    // Keeps the screen on while the page is open
    private AwakeKeeper? keeper;

    [Parameter]
    public Guid PlaceId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "daily")]
    public bool Daily { get; set; }

    // The two rounds that aren't a room have no place id
    private bool IsBack => PlaceId == Guid.Empty
        && Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("round/back", StringComparison.OrdinalIgnoreCase);

    private bool IsNext => PlaceId == Guid.Empty
        && Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("round/next", StringComparison.OrdinalIgnoreCase);

    private bool IsDue => PlaceId == Guid.Empty && !IsBack && !IsNext;

    // From the page of a room it goes back there, with the name of the room as the link
    private bool FromRoom => From == "room" && PlaceId != Guid.Empty && places.Find(PlaceId) is not null;

    private string BackHref => FromRoom ? $"rooms/{PlaceId}" : From switch { "plants" => "plants", "rooms" => "rooms-and-tags", _ => "" };

    private string BackLabel => FromRoom ? places.NameOf(PlaceId)! : From switch { "plants" => Strings.Care.RoundBackPlants, "rooms" => Strings.Care.RoundBackRooms, _ => Strings.Care.RoundBackToday };

    private string Title => IsBack ? Strings.Care.AwayLookFirst : IsNext ? Strings.Care.RoundTitleNext : IsDue ? Strings.Care.RoundTitleDue : places.NameOf(PlaceId) ?? Strings.Care.RoundGoingRound;

    private DateOnly Today => Time.Today();

    private bool loaded;
    private bool placeMissing;
    private bool busy;
    private bool endHandled;
    private bool roundPutOff;
    private bool moveForward = true;
    private bool focusNext;
    private string? status;
    private Places places = Places.None;
    private IReadOnlyList<RoundCard> cards = [];
    private IReadOnlyList<RoundDay> days = [];
    private IReadOnlyList<CareLog> careLogs = [];
    private IReadOnlyList<TimelineEntry> todayEntries = [];
    private List<int> queue = [];
    private int pos;
    private ElementReference wrapper;
    private RoundCardFrame? frame;
    private ElementReference photoInput;
    private bool cameraAvailable;
    private bool cameraOpen;

    // The plants and cuttings that have a photo of their own to line up with
    private HashSet<Guid> hasPhoto = [];

    // Where a round begins: a way out for a day with little energy, and a switch for plants that need a hand
    private RenderFragment RoundStart => __builder =>
    {
        <div class="round-start">
            <a class="round-text-btn" href="today/one-plant">@Strings.Care.TodayOnePlant</a>
            @if (anyNeedsHand)
            {
                <div class="form-check form-switch round-hand-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="round-leave-out-hand" checked="@leaveOutHand"
                           disabled="@busy" @onchange="e => LeaveOutHandAsync(e.Value is true)" />
                    <label class="form-check-label" for="round-leave-out-hand">@Strings.Care.RoundLeaveOutHand</label>
                </div>
            }
        </div>
    };

    // Kept on the device for the day it was turned on, so it ends by itself. It is not a setting.
    private const string LeaveOutHandKey = "round-leave-out-hand";
    private bool leaveOutHand;
    private bool anyNeedsHand;

    private bool Hidden(int index) => leaveOutHand && cards[index].Subject is Plant { NeedsAHand.Count: > 0 };

    // The round's order, without what is left out. It starts at the first card of the order with nothing logged.
    private void BuildQueue(int startAt)
    {
        queue = [.. Enumerable.Range(0, cards.Count).Where(i => !Hidden(i))];
        var start = queue.FindIndex(i => i >= startAt);
        pos = start < 0 ? queue.Count : start;
    }

    private async Task LeaveOutHandAsync(bool on)
    {
        leaveOutHand = on;
        BuildQueue(GoingRoundLogic.StartAt(cards, days));
        // Turned off from an empty round that had been put off for the day: it is still to do
        if (roundPutOff && queue.Count > 0)
        {
            roundPutOff = false;
            endHandled = false;
            await PutOffService.PutOffAsync(PutOffs.DailyRound, Today);
        }
        await Files.SetAsync(LeaveOutHandKey, on ? Today.ToString("yyyy-MM-dd") : null);
        BuildQueue(GoingRoundLogic.StartAt(cards, days));
        moveForward = true;
        focusNext = true;
    }

    private string MoveClass => moveForward ? "from-right" : "from-left";

    protected override async Task OnInitializedAsync()
    {
        places = await RoomService.GetPlacesAsync();
        cameraAvailable = await Camera.IsAvailableAsync();
        hasPhoto = [.. (await PhotoRepository.GetNewestPerSubjectAsync()).Keys];
        if (PlaceId != Guid.Empty && places.Find(PlaceId) is null)
        {
            placeMissing = true;
            loaded = true;
            return;
        }

        var plants = await Plants.GetAllAsync();
        var propagations = await Propagations.GetAllAsync();
        careLogs = await CareLogs.GetAllAsync();
        var plantChanges = await Entries.GetPlantChangesAsync();
        var lights = await LightService.GetAllAsync();
        var stretches = await AwayService.GetAllAsync();
        var pots = (await PotRepository.GetAllAsync()).ToDictionary(p => p.Id);
        var userSettings = await SettingsService.GetAsync();
        var wateringOn = userSettings.WateringReminder;
        var roundDays = userSettings.RoundDays;
        todayEntries = await Entries.GetSinceAsync(StartOfToday);
        var hemisphere = Seasons.HemisphereOf(TimeZoneInfo.Local);

        if (IsBack)
        {
            var putOffs = await PutOffService.GetAsync(Today);
            var settings = await SettingsService.GetAsync();
            var backDay = AwayTime.BackDay(stretches, Today);
            var rows = backDay is { } day
                ? BackList.Of(day, plants, propagations, careLogs, await BackTimeline.LoadAsync(Entries, day, Time), await PestCases.GetAllAsync(),
                    id => pots.GetValueOrDefault(id), lights, places, stretches, hemisphere, Time, settings.BackListLength)
                : [];
            cards = GoingRoundLogic.ForBack(rows, plants, careLogs, plantChanges, id => pots.GetValueOrDefault(id), lights, places,
                stretches, hemisphere, Time, wateringOn, putOffs);
        }
        else if (IsNext)
        {
            var putOffs = await PutOffService.GetAsync(Today);
            cards = wateringOn
                ? GoingRoundLogic.ForNext(plants, careLogs, plantChanges, id => pots.GetValueOrDefault(id), lights, places, stretches, hemisphere, Time, putOffs, roundDays)
                : [];
        }
        else if (IsDue)
        {
            var putOffs = await PutOffService.GetAsync(Today);
            cards = wateringOn
                ? GoingRoundLogic.ForDue(plants, careLogs, plantChanges, id => pots.GetValueOrDefault(id), lights, places, stretches, hemisphere, Time, putOffs, roundDays)
                : [];
        }
        else
        {
            cards = GoingRoundLogic.ForPlace(
                PlaceId, plants, propagations, careLogs, plantChanges, id => pots.GetValueOrDefault(id), lights, places,
                stretches, hemisphere, Time, wateringOn, await PutOffService.GetAsync(Today));
        }

        days = GoingRoundLogic.Days(cards, careLogs, todayEntries, Time);
        anyNeedsHand = cards.Any(c => c.Subject is Plant { NeedsAHand.Count: > 0 });
        leaveOutHand = anyNeedsHand && await Files.GetAsync(LeaveOutHandKey) == Today.ToString("yyyy-MM-dd");
        BuildQueue(GoingRoundLogic.StartAt(cards, days));
        loaded = true;
        focusNext = true;
        await CheckEndAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        keeper ??= Awake.Keeper();
        await keeper.SetAsync(true);

        if (focusNext && loaded && pos < queue.Count)
        {
            focusNext = false;
            // The card takes focus, so its sentence is read out. Without a card it is the round itself.
            if (frame is not null)
                await frame.FocusAsync();
            else
                try { await wrapper.FocusAsync(preventScroll: true); } catch { }
        }
    }

    private DateTimeOffset StartOfToday => Time.MomentAt(Today.ToDateTime(TimeOnly.MinValue));

    private Guid? CoverOf(Entity subject) => subject switch
    {
        Plant plant => Covers.Shown(plant.CoverPhotoId),
        Propagation propagation => Covers.Shown(propagation.CoverPhotoId),
        _ => null
    };

    private static (string? Genus, string? Species, string? Cultivar)? SpeciesOf(Entity subject) => subject switch
    {
        Plant { Nickname: { Length: > 0 } nickname } plant when !string.IsNullOrWhiteSpace(nickname) && plant.BotanicalName is not null
            => (plant.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(plant.Species, plant.NameQualifier), plant.Cultivar),
        Propagation { Nickname: { Length: > 0 } nickname } propagation when !string.IsNullOrWhiteSpace(nickname) && propagation.BotanicalName is not null
            => (propagation.Genus, Stikling.Core.Models.PlantNames.SpeciesToLookUp(propagation.Species, propagation.NameQualifier), propagation.Cultivar),
        _ => null
    };

    // "watered 9 days ago · reads 4", or the newest reading when none is logged today
    private string? MetaOf(RoundCard card, RoundDay day)
    {
        if (card.Form is not { } form)
            return null;

        var parts = new List<string>();
        var kind = WateringForms.DoneKind(form);
        var done = form switch
        {
            WateringForm.TopWatered => Strings.Care.RoundLastWatered,
            WateringForm.Reservoir => Strings.Care.RoundLastRefilled,
            _ => Strings.Care.RoundLastToppedUp
        };
        var notYet = form switch
        {
            WateringForm.TopWatered => Strings.Care.RoundNotWatered,
            WateringForm.Reservoir => Strings.Care.RoundNotRefilled,
            _ => Strings.Care.RoundNotToppedUp
        };
        parts.Add(CareSummary.Latest(careLogs, card.Subject.Id, kind, Today) is { } last
            ? F(done, Labels.DaysAgo(last.DaysAgo))
            : notYet);

        if (day.Reading is { } reading)
            parts.Add(F(Strings.Care.RoundReads, reading.Value));
        else if (CareSummary.LatestMoisture(careLogs, card.Subject.Id, Today) is { } latest)
            parts.Add(F(Strings.Care.RoundLastReading, latest.Value, Labels.DaysAgo(latest.DaysAgo)));

        return string.Join(" · ", parts);
    }

    private static string EndMeta(RoundSummary summary)
    {
        var parts = new List<string>();
        if (summary.Readings > 0)
            parts.Add(Plural.Of(summary.Readings, Strings.Care.RoundReadings_One, Strings.Care.RoundReadings_Other));
        if (summary.Photos > 0)
            parts.Add(Plural.Of(summary.Photos, Strings.Care.RoundPhotos_One, Strings.Care.RoundPhotos_Other));
        return string.Join(" · ", parts);
    }

    // After an action, the day of the card is worked out again from what is saved
    private async Task RefreshAsync()
    {
        careLogs = await CareLogs.GetAllAsync();
        todayEntries = await Entries.GetSinceAsync(StartOfToday);
        days = GoingRoundLogic.Days(cards, careLogs, todayEntries, Time);
    }

    private async Task RunAsync(Func<Task> action, bool advance, string? announce = null)
    {
        if (busy)
            return;
        busy = true;
        status = null;
        try
        {
            await action();
            await RefreshAsync();
            Announcer.Say(announce);
            if (advance)
                await MoveAsync(1);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "A step in the daily round failed");
            status = F(Strings.Care.RoundSaveFailed, ex.Message);
            Announcer.Say(status);
        }
        busy = false;
    }

    private (RoundCard Card, RoundDay Day) Current => (cards[queue[pos]], days[queue[pos]]);

    private Task ReadingAsync(int reading)
    {
        var (card, day) = Current;
        if (day.Reading?.Value == reading)
            return Task.CompletedTask;
        return RunAsync(() => Answers.ReadingAsync(card.Subject.Id, reading, day.Reading?.Id, Labels.For), advance: false,
            announce: F(Strings.Care.WaterReads, card.Name, reading));
    }

    private Task WaterAsync()
    {
        var (card, day) = Current;
        if (card.Form is not { } form)
            return Task.CompletedTask;
        if (day.WateredId is { } watered)
            return RunAsync(() => Care.DeleteAsync(watered), advance: false, announce: F(Strings.Care.WaterUndone, card.Name));
        return RunAsync(() => Answers.WaterAsync(card.Subject.Id, form, Labels.For), advance: true,
            announce: F(Strings.Care.WaterWateredAnnounce, card.Name, WateringText.DoneLabel(form).ToLowerInvariant()));
    }

    // The reminder waits started by Looked over in this visit, by the entry's id, so taking one back can end its wait
    private readonly Dictionary<Guid, string> lookedOverWaits = [];

    private Task LookedOverAsync()
    {
        var (card, day) = Current;
        if (day.LookedOverId is { } looked)
        {
            return RunAsync(async () =>
            {
                await TimelineService.RemoveAsync(looked);
                // Taking it back also takes back the wait it started, so the plant is due on Today again
                if (lookedOverWaits.Remove(looked, out var key))
                    await PutOffService.PutOffAsync(key, Today);
            }, advance: false, announce: F(Strings.Care.WaterUndone, card.Name));
        }

        return RunAsync(async () =>
        {
            var type = card.Subject is Plant ? SubjectType.Plant : SubjectType.Propagation;
            var entry = await TimelineService.LookedOverAsync(type, card.Subject.Id);
            // A plant that is due and looked at but not watered isn't ready yet, so the reminder waits
            if (card.Subject is Plant plant && card.DueNow && card.Guess is { } guess && day.WateredId is null
                && await Answers.NotYetAsync(plant, guess, day.Reading?.Value, logReading: false, Labels.For) is { } wait)
                lookedOverWaits[entry.Id] = wait.Key;
        }, advance: true, announce: F(Strings.Care.RoundLookedOverAnnounce, card.Name));
    }

    private async Task PhotoAsync()
    {
        if (busy)
            return;
        busy = true;
        status = Strings.Care.PhotoRowSaving;
        try
        {
            var (message, saved) = await SubjectPhotos.TakeAsync(photoInput, Current.Card.Subject);
            status = message;
            Announcer.Say(message);
            if (saved)
                await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding a photo in the daily round failed");
            status = F(Strings.Care.PhotoRowFailed, ex.Message);
            Announcer.Say(status);
        }
        busy = false;
    }

    // The camera has stored the photo already, so it only goes onto the history
    private async Task CameraTakenAsync(PhotoSaveResult shot)
    {
        cameraOpen = false;
        // The shot is stored already, so it is never dropped: it waits for what is running
        while (busy)
            await Task.Delay(50);
        busy = true;
        status = Strings.Care.PhotoRowSaving;
        try
        {
            var (message, saved) = await SubjectPhotos.FinishAsync(Current.Card.Subject, shot);
            status = message;
            Announcer.Say(message);
            if (saved)
            {
                hasPhoto.Add(Current.Card.Subject.Id);
                await RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding a photo in the daily round failed");
            status = F(Strings.Care.PhotoRowFailed, ex.Message);
            Announcer.Say(status);
        }
        busy = false;
    }

    private void Skip()
    {
        if (!busy)
            _ = MoveAsync(1);
    }

    private void Back()
    {
        if (!busy && pos > 0)
            _ = MoveAsync(-1);
    }

    private async Task MoveAsync(int step)
    {
        moveForward = step > 0;
        pos = Math.Clamp(pos + step, 0, queue.Count);
        status = null;
        focusNext = true;
        await CheckEndAsync();
    }

    // Reaching the end of the daily round finishes it for the day
    private async Task CheckEndAsync()
    {
        // A round with nothing shown, like one where every plant needs a hand, isn't finished and isn't put off
        if (pos < queue.Count || endHandled || queue.Count == 0)
            return;
        endHandled = true;
        if (Daily)
        {
            roundPutOff = true;
            await PutOffService.PutOffAsync(PutOffs.DailyRound, Today.AddDays(1));
        }
    }

    private void GoThroughSkipped()
    {
        queue = [.. Enumerable.Range(0, cards.Count).Where(i => !days[i].Any && !Hidden(i))];
        pos = 0;
        moveForward = true;
        focusNext = true;
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (busy || !loaded || pos >= queue.Count)
            return;

        if (e.CtrlKey || e.MetaKey || e.AltKey)
            return;

        switch (e.Key)
        {
            case "0" or "1" or "2" or "3" or "4" or "5" or "6" or "7" or "8" or "9":
                if (Current.Card.Form == WateringForm.TopWatered)
                    await ReadingAsync(e.Key == "0" ? 10 : int.Parse(e.Key));
                break;
            case "w" or "W":
                await WaterAsync();
                break;
            case "l" or "L":
                await LookedOverAsync();
                break;
            case "s" or "S":
            case "ArrowRight":
                Skip();
                break;
            case "ArrowLeft":
                Back();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (keeper is not null)
            await keeper.DisposeAsync();
    }
}
