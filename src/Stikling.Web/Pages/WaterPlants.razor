@page "/water"
@inject IPlantRepository Plants
@inject ICareLogRepository CareLogs
@inject IPotRepository PotRepository
@inject IFeedRepository FeedRepository
@inject RoomService RoomService
@inject WateringAnswers Answers
@inject CareService Care
@inject DeviceFiles Device
@inject TimeProvider Time
@inject ILogger<WaterPlants> Logger

<PageTitle>Water plants · Stikling</PageTitle>

@* Reads what is logged and the plants again, and keeps the rooms picked, the step and the ticks and feeds someone changed *@
<ReloadOnSync Reload="ReloadAsync" />

<a class="back-link" href="">Today</a>

<h1>Water plants</h1>

@if (!loaded)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (rooms.Count == 0)
{
    <div class="empty-state">
        <p>No plants yet. Add one on the Plants page.</p>
        <a class="btn btn-primary mt-3" href="plants">Go to Plants</a>
    </div>
}
else if (stage == Stage.Rooms)
{
    <p class="pass-lead">Pick the rooms in the order you walk them. You read every plant first, then tick the ones you watered.</p>

    <div class="chip-row" role="group" aria-label="Rooms">
        @foreach (var room in rooms)
        {
            var at = picked.IndexOf(room.Id);
            <button type="button" class="chip pass-room @(at >= 0 ? "picked" : null)" aria-pressed="@(at >= 0 ? "true" : "false")"
                    @onclick="() => TogglePicked(room.Id)">
                @if (at >= 0)
                {
                    <span class="pass-order" aria-label="@($"number {at + 1}")">@(at + 1)</span>
                }
                @room.Name
            </button>
        }
        @if (rooms.Count > 1)
        {
            var all = picked.Count == rooms.Count;
            <button type="button" class="chip pass-room @(all ? "picked" : null)" aria-pressed="@(all ? "true" : "false")" @onclick="PickAll">All</button>
        }
    </div>

    <div class="pass-actions">
        <button type="button" class="btn btn-primary" disabled="@(picked.Count == 0 || busy)" @onclick="StartAsync">Start</button>
    </div>
}
else if (stage == Stage.Readings)
{
    <div class="pass-bar">
        <button type="button" class="btn btn-link btn-sm link-action" @onclick="ChangeRooms">Change rooms</button>
    </div>

    <p class="pass-lead">Tap the meter reading for each plant. Tap another number to correct it.</p>

    @foreach (var group in groups)
    {
        <section class="pass-group">
            <h2 class="section-label">@group.Name</h2>
            @if (group.Rows.Count == 0)
            {
                <p class="pass-none">No plants here.</p>
            }
            else
            {
                <ul class="item-list">
                    @foreach (var row in group.Rows)
                    {
                        var latest = row.Reading is null && row.Form == WateringForm.TopWatered
                            ? CareSummary.LatestMoisture(careLogs, row.Plant.Id, Today)
                            : null;
                        <li class="pass-item">
                            <a class="pass-name" href="@($"plants/{row.Plant.Id}")">@row.Plant.DisplayName</a>
                            @if (row.Form != WateringForm.TopWatered)
                            {
                                <span class="pass-meta">@(row.Form == WateringForm.InWater ? "Check the water" : "Check the reservoir")</span>
                            }
                            else
                            {
                                @if (latest is not null)
                                {
                                    <span class="pass-meta">last reading @latest.Value, @Labels.DaysAgo(latest.DaysAgo)</span>
                                }
                                <div class="answer-grid" role="group" aria-label="@($"Meter reading for {row.Plant.DisplayName}")">
                                    @for (var n = 0; n <= 10; n++)
                                    {
                                        var value = n;
                                        var isPicked = row.Reading?.Value == n;
                                        <button type="button" class="chip @(isPicked ? "picked" : null)" aria-pressed="@(isPicked ? "true" : "false")"
                                                disabled="@busy" @onclick="() => ReadingAsync(row, value)">@n</button>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }

    @if (status is not null)
    {
        <div class="alert alert-danger" role="alert">@status</div>
    }

    <div class="pass-actions">
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="GoToWatered">Next: what was watered</button>
    </div>
}
else if (stage == Stage.Watered)
{
    var count = TickedRows().Count();

    <div class="pass-bar">
        <button type="button" class="btn btn-link btn-sm link-action" @onclick="BackToReadings">Back to readings</button>
        <button type="button" class="btn btn-link btn-sm link-action" @onclick="ChangeRooms">Change rooms</button>
    </div>

    <h2 class="pass-title">Tick what you watered</h2>

    @foreach (var group in groups)
    {
        var top = group.Rows.Where(r => r.Form == WateringForm.TopWatered).ToList();
        var topUp = group.Rows.Where(r => r.Form != WateringForm.TopWatered).ToList();
        <section class="pass-group">
            <h2 class="section-label">@group.Name</h2>
            @if (group.Rows.Count == 0)
            {
                <p class="pass-none">No plants here.</p>
            }
            @if (top.Count > 0)
            {
                <ul class="item-list">
                    @foreach (var row in top)
                    {
                        @RowTemplate(row)
                    }
                </ul>
            }
            @if (topUp.Count > 0)
            {
                <h3 class="pass-sub">Top up</h3>
                <ul class="item-list">
                    @foreach (var row in topUp)
                    {
                        @RowTemplate(row)
                    }
                </ul>
            }
        </section>
    }

    @if (status is not null)
    {
        <div class="alert alert-danger" role="alert">@status</div>
    }

    <div class="pass-actions">
        <button type="button" class="btn btn-primary" disabled="@(count == 0 || busy)" @onclick="LogAsync">
            Log @(count == 0 ? "" : Labels.Plants(count))
        </button>
    </div>
}
else
{
    <div class="empty-state pass-done" role="status">
        <p>Logged @Labels.Plants(savedCount).</p>
        <div class="pass-done-actions">
            <a class="btn btn-primary" href="">Back to Today</a>
            <a class="btn btn-outline-primary" href="plants">Plants</a>
        </div>
    </div>
}

@code {
    private enum Stage { Rooms, Readings, Watered, Done }

    private const string RoomsKey = "water-rooms";

    private bool loaded;
    private bool busy;
    private string? status;
    private Stage stage = Stage.Rooms;
    private int savedCount;

    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<CareLog> careLogs = [];
    private IReadOnlyList<Feed> feeds = [];
    private IReadOnlyList<Feed> feedOptions = [];
    private Dictionary<Guid, Pot> pots = [];
    private Places places = Places.None;
    private IReadOnlyList<PassRoom> rooms = [];
    private List<Guid> picked = [];
    private IReadOnlyList<PassGroup> groups = [];

    // What was changed by hand on the last step, by plant. The rest follows the readings.
    private readonly Dictionary<Guid, bool> ticks = [];
    private readonly Dictionary<Guid, Guid?> feedPicks = [];

    private DateOnly Today => Time.Today();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        picked = Remembered(await Device.GetAsync(RoomsKey));
        loaded = true;
    }

    private async Task LoadAsync()
    {
        places = await RoomService.GetPlacesAsync();
        plants = await Plants.GetAllAsync();
        careLogs = await CareLogs.GetAllAsync();
        feeds = await FeedRepository.GetAllAsync();
        feedOptions = [.. feeds
            .Where(f => !f.IsDeleted && f.Products.Count > 0)
            .OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase)];
        pots = (await PotRepository.GetAllAsync()).ToDictionary(p => p.Id);
        rooms = WateringPass.Rooms(plants, places);
        Compute();
    }

    // Sync brought changes in: the data is read again, and the person's own choices stay
    private async Task ReloadAsync()
    {
        await LoadAsync();
        picked = [.. picked.Where(id => rooms.Any(r => r.Id == id))];
        if (picked.Count == 0 && stage is Stage.Readings or Stage.Watered)
            stage = Stage.Rooms;
        Compute();
    }

    private void Compute() =>
        groups = WateringPass.Rows(picked, plants, careLogs, feeds, id => pots.GetValueOrDefault(id), places, Time);

    // The remembered rooms, in the order they were picked, leaving out the ones that are gone
    private List<Guid> Remembered(string? value) =>
    [
        .. (value ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out var id) ? (Guid?)id : null)
            .OfType<Guid>()
            .Distinct()
            .Where(id => rooms.Any(r => r.Id == id))
    ];

    private void TogglePicked(Guid id)
    {
        if (!picked.Remove(id))
            picked.Add(id);
    }

    // Every room in the order of the list, or none when every room is already picked
    private void PickAll() =>
        picked = picked.Count == rooms.Count ? [] : [.. rooms.Select(r => r.Id)];

    private async Task StartAsync()
    {
        if (picked.Count == 0 || busy)
            return;
        busy = true;
        try
        {
            await Device.SetAsync(RoomsKey, string.Join(',', picked));
        }
        catch (Exception ex)
        {
            // Not remembering the rooms is no reason to stop
            Logger.LogWarning(ex, "Couldn't remember the rooms picked for watering");
        }
        ticks.Clear();
        feedPicks.Clear();
        status = null;
        Compute();
        stage = Stage.Readings;
        busy = false;
    }

    private void ChangeRooms()
    {
        status = null;
        stage = Stage.Rooms;
    }

    private void GoToWatered()
    {
        status = null;
        Compute();
        stage = Stage.Watered;
    }

    private void BackToReadings()
    {
        status = null;
        stage = Stage.Readings;
    }

    private async Task ReadingAsync(PassRow row, int value)
    {
        if (busy || row.Reading?.Value == value)
            return;
        busy = true;
        status = null;
        try
        {
            await Answers.ReadingAsync(row.Plant.Id, value, row.Reading?.Id, Labels.For);
            careLogs = await CareLogs.GetAllAsync();
            Compute();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving a meter reading failed");
            status = $"Couldn't save that: {ex.Message}";
        }
        busy = false;
    }

    // Ticked by hand, or by the reading when it wasn't touched. A plant done today can't be ticked.
    private bool IsTicked(PassRow row) =>
        row.DoneTodayId is null && (ticks.TryGetValue(row.Plant.Id, out var by) ? by : row.Ticked);

    private IEnumerable<PassRow> TickedRows() => groups.SelectMany(g => g.Rows).Where(IsTicked);

    // The feed picked for the plant, or the one it gets with its watering when it is due
    private Feed? FeedOf(PassRow row)
    {
        var id = feedPicks.TryGetValue(row.Plant.Id, out var pick) ? pick : row.DefaultFeed?.Id;
        return feedOptions.FirstOrDefault(f => f.Id == id);
    }

    private void Tick(PassRow row, bool ticked) => ticks[row.Plant.Id] = ticked;

    private void PickFeed(PassRow row, string? value) =>
        feedPicks[row.Plant.Id] = Guid.TryParse(value, out var id) ? id : null;

    private static string ReadingText(PassRow row) => row switch
    {
        { Reading: null } => "no reading today",
        { Dry: true } => $"reads {row.Reading!.Value}, dry by your reading ({row.WaterAt})",
        _ => $"reads {row.Reading!.Value}"
    };

    private async Task LogAsync()
    {
        if (busy)
            return;
        var items = TickedRows()
            .Select(r => new PassWatering(r.Plant.Id, WateringForms.DoneKind(r.Form), FeedOf(r)))
            .ToList();
        if (items.Count == 0)
            return;

        busy = true;
        status = null;
        try
        {
            savedCount = await Care.LogWateringsAsync(items, Labels.For);
            stage = Stage.Done;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Logging the watering failed");
            status = $"Couldn't save that: {ex.Message}";
        }
        busy = false;
    }

    private RenderFragment RowTemplate(PassRow row) => __builder =>
    {
        var done = row.DoneTodayId is not null;
        var ticked = IsTicked(row);
        var id = $"water-{row.Plant.Id}";
        <li class="pass-item @(ticked ? "ticked" : null)">
            <label class="pass-check" for="@id">
                <input type="checkbox" id="@id" class="form-check-input pass-box" checked="@(done || ticked)" disabled="@(done || busy)"
                       @onchange="e => Tick(row, (bool)(e.Value ?? false))" />
                <span class="pass-text">
                    <span class="pass-name">@row.Plant.DisplayName</span>
                    <span class="pass-meta">
                        @if (done)
                        {
                            @(row.Form == WateringForm.TopWatered ? "Watered today" : "Topped up today")
                        }
                        else if (row.Form == WateringForm.TopWatered)
                        {
                            @ReadingText(row)
                        }
                        else
                        {
                            @(row.Form == WateringForm.InWater ? "Sits in water" : "Reservoir")
                        }
                    </span>
                </span>
            </label>
            @if (ticked && feedOptions.Count > 0)
            {
                var chosen = FeedOf(row);
                <div class="pass-feed">
                    <label class="pass-feed-label" for="@($"{id}-feed")">Feed</label>
                    <select id="@($"{id}-feed")" class="form-select form-select-sm" value="@(chosen?.Id.ToString() ?? "")"
                            @onchange="e => PickFeed(row, e.Value?.ToString())">
                        <option value="">No feed</option>
                        @foreach (var feed in feedOptions)
                        {
                            <option value="@feed.Id">@feed.Name</option>
                        }
                    </select>
                </div>
            }
        </li>
    };
}
