@page "/backup"
@implements IDisposable
@inject BackupService Backup
@inject ILogger<BackupAndStorage> Logger
@inject DeviceFiles Files
@inject IPlantRepository Plants
@inject IPropagationRepository PropagationRepository
@inject RoomService RoomService
@inject OwnFieldService OwnFieldBook
@inject ThemeService Theme
@inject LanguageService Language
@inject ErrorReports ErrorReports
@inject PlantNameService Names
@inject IndexedDb Db
@inject TimeProvider Time
@inject AccountService Account

<PageTitle>@Strings.Account.BackupPageTitle</PageTitle>

<a class="back-link" href="settings?section=data">@Strings.Account.BackToSettings</a>
<h1>@Strings.Account.BackupTitle</h1>

<section class="settings-section">
    <h2 class="section-label">@Strings.Account.BackupSection</h2>
    <p class="settings-hint">
        @(signedIn ? Strings.Account.BackupIntroSignedIn : Strings.Account.BackupIntroLocal)
    </p>

    <div class="settings-actions">
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ExportAsync">@Strings.Account.BackupSave</button>
        <label class="btn btn-outline-primary @(busy ? "disabled" : null)" for="restore-file">@Strings.Account.BackupRestore</label>
        <InputFile id="restore-file" class="visually-hidden" accept=".zip" OnChange="ChooseFileAsync" disabled="@busy" />
    </div>

    <p class="settings-hint">
        @if (lastBackup is { } date)
        {
            <text>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupLastTaken, Labels.Date(date), Labels.DaysAgo(TodayDate.DayNumber - date.DayNumber))</text>
        }
        else
        {
            <text>@Strings.Account.BackupNoneYet</text>
        }
    </p>

    @if (pending is { } file)
    {
        <div class="confirm-card">
            <p>
                <strong>@file.Name</strong><br />
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupMade, Labels.Date(DateOnly.FromDateTime(file.Data.ExportedAt.LocalDateTime)),
                    Labels.Plants(file.Data.Counts.Plants),
                    Plural.Of(file.Data.Counts.Propagations, Strings.Account.Propagation_One, Strings.Account.Propagation_Other),
                    Plural.Of(file.Data.Counts.Photos, Strings.Account.Photo_One, Strings.Account.Photo_Other))
            </p>
            <p class="settings-hint">
                @(hasData ? Strings.Account.BackupRestoreExplainSaved : Strings.Account.BackupRestoreExplain)
            </p>
            <div class="settings-actions">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => RestoreAsync(saveFirst: true)">@Strings.Account.BackupRestoreButton</button>
                <button type="button" class="btn btn-link" disabled="@busy" @onclick="() => pending = null">@Strings.Common.Cancel</button>
                @if (saveFailed)
                {
                    <button type="button" class="btn btn-outline-primary" @ref="fallbackButton" disabled="@busy" @onclick="() => RestoreAsync(saveFirst: false)">@Strings.Account.BackupRestoreWithoutSaving</button>
                }
            </div>
            @if (saveFailed)
            {
                <p class="settings-hint">@Strings.Account.BackupWithoutThat</p>
            }
        </div>
    }

    @if (message is not null)
    {
        <p class="settings-message" role="status">@message</p>
    }
</section>

<section class="settings-section">
    <h2 class="section-label">@Strings.Account.BackupPhotosSection</h2>
    <p class="settings-hint">
        @Strings.Account.BackupPhotosIntro
    </p>
    @if (photoCount == 0)
    {
        <p class="settings-hint">@Strings.Account.BackupNoPhotos</p>
    }
    <label class="form-check">
        <input type="checkbox" class="form-check-input" @bind="includeGone" disabled="@(busy || photoCount == 0)" />
        <span class="form-check-label">@Strings.Account.BackupIncludeGone</span>
    </label>
    <label class="form-check">
        <input type="checkbox" class="form-check-input" @bind="includeReferences" disabled="@(busy || photoCount == 0)" />
        <span class="form-check-label">@Strings.Account.BackupIncludeReferences</span>
    </label>
    <div class="settings-actions">
        <button type="button" class="btn btn-outline-primary" disabled="@(busy || photoCount == 0)" @onclick="DownloadPhotosAsync">
            @(gathering is { } g ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupGathering, g.Done, g.Total) : Strings.Account.BackupDownloadPhotos)
        </button>
    </div>
    @if (photoMessage is not null)
    {
        <p class="settings-message" role="status">@photoMessage</p>
    }
</section>

<section class="settings-section" data-tour="spreadsheet">
    <h2 class="section-label">@Strings.Account.BackupSpreadsheetSection</h2>
    <p class="settings-hint">@Strings.Account.BackupSpreadsheetIntro</p>
    <div class="settings-actions">
        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="ExportPlantsCsvAsync">@Strings.Account.BackupPlantsCsv</button>
        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="ExportPropagationsCsvAsync">@Strings.Account.BackupPropagationsCsv</button>
        <a class="btn btn-outline-primary btn-sm" href="plants/import">@Strings.Account.BackupImportPlants</a>
    </div>
</section>

<section class="settings-section">
    <h2 class="section-label">@Strings.Account.BackupStorageSection</h2>
    @if (storage is { } estimate)
    {
        <p class="settings-hint">
            @string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupUsing, Labels.Bytes(estimate.Usage))
        </p>
        @if (estimate.Persisted)
        {
            <p class="settings-hint">@Strings.Account.BackupPersisted</p>
        }
        else
        {
            <p class="settings-hint">
                @Strings.Account.BackupNotPersisted
            </p>
            <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="RequestPersistenceAsync">@Strings.Account.BackupAskToKeep</button>
        }
    }
    else
    {
        <p class="settings-hint">@Strings.Account.BackupNoEstimate</p>
    }
</section>

@code {
    /// <summary>A chosen file, read and described, waiting for the restore to be confirmed.</summary>
    private sealed record PendingRestore(string Name, BackupData Data, MemoryStream Zip);

    private DateOnly? lastBackup;
    private StorageEstimate? storage;
    private PendingRestore? pending;
    private string? message;
    private bool busy;
    private bool signedIn;
    private bool saveFailed;
    private ElementReference fallbackButton;
    private bool focusFallback;
    private bool hasData; // whether a restore saves a backup of this device first

    private int photoCount;
    private bool includeGone = true;
    private bool includeReferences = true;
    private (int Done, int Total)? gathering;
    private string? photoMessage;

    private DateOnly TodayDate => Time.Today();

    protected override async Task OnInitializedAsync()
    {
        lastBackup = await Files.GetLastBackupAsync();
        storage = await Db.EstimateAsync();
        photoCount = (await Db.GetAllAsync<Photo>(Stores.Photos)).Count(p => !p.IsDeleted);
        // Only for the wording of the hint, and read without loading Clerk
        signedIn = Account.IsAvailable && await Account.WasSignedInAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The button appears after a failure, so move focus to it
        if (focusFallback && saveFailed)
        {
            focusFallback = false;
            await fallbackButton.FocusAsync();
        }
    }

    private async Task ExportPlantsCsvAsync()
    {
        var csv = CsvExport.Plants(await Plants.GetAllAsync(), await RoomService.GetPlacesAsync(), await OwnFieldBook.GetAllAsync());
        await Files.DownloadAsync($"stikling-plants-{TodayDate:yyyy-MM-dd}.csv", CsvExport.Encode(csv));
    }

    private async Task ExportPropagationsCsvAsync()
    {
        var csv = CsvExport.Propagations(
            await PropagationRepository.GetAllAsync(), await Plants.GetAllAsync(), await RoomService.GetPlacesAsync());
        await Files.DownloadAsync($"stikling-propagations-{TodayDate:yyyy-MM-dd}.csv", CsvExport.Encode(csv));
    }

    private async Task ExportAsync()
    {
        busy = true;
        message = Strings.Account.BackupPacking;
        StateHasChanged();

        try
        {
            var counts = await Backup.ExportAsync();
            lastBackup = TodayDate;
            message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupSaved, Labels.Plants(counts.Plants),
                Plural.Of(counts.Propagations, Strings.Account.Propagation_One, Strings.Account.Propagation_Other),
                Plural.Of(counts.Photos, Strings.Account.Photo_One, Strings.Account.Photo_Other));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the backup failed");
            message = Strings.Account.BackupSaveFailed;
        }

        storage = await Db.EstimateAsync();
        busy = false;
    }

    private async Task DownloadPhotosAsync()
    {
        busy = true;
        photoMessage = null;
        gathering = (0, 0);
        StateHasChanged();

        try
        {
            var progress = new Progress<(int Done, int Total)>(p =>
            {
                // A report can arrive after the download has finished, and must not bring the progress back
                if (!busy) return;
                gathering = p;
                StateHasChanged();
            });
            var summary = await Backup.DownloadPhotoFoldersAsync(new PhotoFolderOptions(includeGone, includeReferences), progress);
            photoMessage = summary.Added + summary.Skipped == 0
                ? (includeGone && includeReferences ? Strings.Account.BackupNoPhotosToInclude : Strings.Account.BackupNoPhotosTick)
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupPhotosSaved, Plural.Of(summary.Added, Strings.Account.Photo_One, Strings.Account.Photo_Other))
                + (summary.Skipped > 0
                    ? " " + Plural.Of(summary.Skipped, Strings.Account.BackupPhotosMissing_One, Strings.Account.BackupPhotosMissing_Other)
                    : "");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Downloading the photos failed");
            photoMessage = Strings.Account.BackupPhotosFailed;
        }

        busy = false;
        gathering = null;
    }

    private async Task ChooseFileAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        message = Strings.Account.BackupReading;
        pending = null;
        saveFailed = false;
        StateHasChanged();

        try
        {
            var file = e.File;
            var zip = new MemoryStream();
            // 512 MB is far more than a phone-sized collection needs
            await using (var stream = file.OpenReadStream(512L * 1024 * 1024))
                await stream.CopyToAsync(zip);

            zip.Position = 0;
            pending = new PendingRestore(file.Name, await BackupService.ReadAsync(zip), zip);
            hasData = await Backup.HasAnythingToSaveAsync();
            message = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reading the backup file failed");
            message = Strings.Account.BackupReadFailed;
        }

        busy = false;
    }

    private async Task RestoreAsync(bool saveFirst)
    {
        if (pending is not { } file)
            return;

        busy = true;
        string? savedAs = null;

        if (saveFirst)
        {
            message = Strings.Account.BackupSavingFirst;
            StateHasChanged();

            try
            {
                if (await Backup.HasAnythingToSaveAsync())
                {
                    await Backup.ExportAsync("stikling-before-restore");
                    lastBackup = TodayDate;
                    savedAs = $"stikling-before-restore-{TodayDate:yyyy-MM-dd}.zip";
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Saving a backup before restoring failed");
                message = Strings.Account.BackupSaveFirstFailed;
                saveFailed = true;
                focusFallback = true;
                busy = false;
                return;
            }
        }

        message = Strings.Account.BackupRestoring;
        StateHasChanged();

        try
        {
            file.Zip.Position = 0;
            var summary = await Backup.ImportAsync(file.Zip);
            await Theme.ApplySavedAsync();
            await Language.ApplySavedAsync();
            await ErrorReports.ApplySavedAsync();
            Names.SettingsChanged();
            message = summary switch
            {
                { ChangedRecords: true } =>
                    string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupRestored,
                        Plural.Of(summary.Added, Strings.Account.NewItem_One, Strings.Account.NewItem_Other), summary.Updated,
                        Plural.Of(summary.Photos, Strings.Account.Photo_One, Strings.Account.Photo_Other))
                    + (summary.BroughtBack > 0 ? " " + Plural.Of(summary.BroughtBack, Strings.Account.BackupBroughtBack_One, Strings.Account.BackupBroughtBack_Other) : "")
                    + (summary.Kept > 0 ? " " + Plural.Of(summary.Kept, Strings.Account.BackupUpToDate_One, Strings.Account.BackupUpToDate_Other) : ""),
                { Photos: > 0 } => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupPicturesBack, Plural.Of(summary.Photos, Strings.Account.Photo_One, Strings.Account.Photo_Other)),
                _ => Strings.Account.BackupAlreadyHere
            };
            if (savedAs is not null)
                message += " " + string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.BackupSavedAs, savedAs);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restoring the backup failed");
            message = Strings.Account.BackupRestoreFailed;
        }

        await file.Zip.DisposeAsync();
        pending = null;
        saveFailed = false;
        storage = await Db.EstimateAsync();
        busy = false;
    }

    private async Task RequestPersistenceAsync()
    {
        busy = true;
        var granted = await Db.RequestPersistenceAsync();
        message = granted
            ? Strings.Account.BackupPersistGranted
            : Strings.Account.BackupPersistDenied;
        storage = await Db.EstimateAsync();
        busy = false;
    }

    public void Dispose() => pending?.Zip.Dispose();
}
