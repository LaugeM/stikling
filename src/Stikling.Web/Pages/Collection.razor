@page "/plants/collection"
@layout WideLayout
@using System.Globalization
@inject IPlantRepository PlantRepository
@inject IPropagationRepository PropagationRepository
@inject RoomService RoomService
@inject TimeProvider Time

<PageTitle>@string.Format(CultureInfo.CurrentCulture, Strings.PlantDetail.PageTitle, Strings.Plants.CollectionTitle)</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="plants">@Strings.Plants.ListTitle</a>

<div class="page-heading">
    <h1>@Strings.Plants.CollectionTitle</h1>
</div>

@if (summary is null)
{
    <p class="text-body-secondary">@Strings.Plants.Loading</p>
}
else if (summary.Plants == 0)
{
    <div class="empty-state">
        <p>@Strings.Plants.CollectionEmpty</p>
        <a class="btn btn-primary mt-3" href="plants/new">@Strings.Plants.AddAPlant</a>
        <p class="mt-3"><a href="plants/import">@Strings.Plants.CollectionImport</a></p>
    </div>
}
else
{
    <div class="collection">
        <div class="collection-top">
            <section class="numbers" aria-label="@Strings.Plants.CollectionTotals">
                <a class="number plants" href="plants">
                    <span class="figure">@summary.Plants</span>
                    <span class="word">@Plural.Of(summary.Plants, Strings.Plants.CollectionPlant_One, Strings.Plants.CollectionPlant_Other)</span>
                </a>
                <div class="number">
                    <span class="figure">@summary.Species</span>
                    <span class="word">@Plural.Of(summary.Species, Strings.Plants.CollectionSpecies_One, Strings.Plants.CollectionSpecies_Other)</span>
                </div>
                <div class="number">
                    <span class="figure">@summary.Genera</span>
                    <span class="word">@Plural.Of(summary.Genera, Strings.Plants.CollectionGenus_One, Strings.Plants.CollectionGenus_Other)</span>
                </div>
            </section>

            @if (summary.Longest is { } longest)
            {
                <section aria-labelledby="longest-title">
                    <h2 class="section-label" id="longest-title">@Strings.Plants.CollectionLongest</h2>
                    <ul class="plant-list">
                        <li>
                            <PlantCard Plant="longest.Plant" Location="@places.NameOf(longest.Plant.PlaceId)" />
                        </li>
                    </ul>
                    <p class="since">@longest.Text(today)</p>
                </section>
            }
        </div>

        <div class="collection-bottom">
            <section aria-labelledby="genus-title">
                <h2 class="section-label" id="genus-title">@Strings.Plants.ListSortGenus</h2>
                <ul class="count-list">
                    @foreach (var row in Shown(summary.ByGenus, showAllGenera))
                    {
                        <li>
                            <a class="count-row" href="@GenusHref(row)">
                                <span class="name @(row.Name is null ? "none" : "genus")">@(row.Name ?? Strings.Plants.ListNoGenus)</span>
                                <span class="bar" aria-hidden="true"><span class="fill" style="width: @Share(row, summary.ByGenus)%"></span></span>
                                <span class="count">@row.Count</span>
                            </a>
                        </li>
                    }
                </ul>
                @if (!showAllGenera && summary.ByGenus.Count > Preview)
                {
                    <button type="button" class="btn btn-link show-all" @onclick="() => showAllGenera = true">@string.Format(CultureInfo.CurrentCulture, Strings.PlantDetail.ShowAll, summary.ByGenus.Count)</button>
                }
            </section>

            @if (HasRooms || summary.AnyPropagations)
            {
                <div class="collection-side">
                    @if (HasRooms)
                    {
                        <section aria-labelledby="room-title">
                            <h2 class="section-label" id="room-title">@Strings.Plants.ListSortRoom</h2>
                            <ul class="count-list">
                                @foreach (var row in Shown(summary.ByRoom, showAllRooms))
                                {
                                    <li>
                                        @if (row.Id is { } roomId)
                                        {
                                            <a class="count-row" href="plants?room=@roomId">
                                                <span class="name">@row.Name</span>
                                                <span class="bar" aria-hidden="true"><span class="fill" style="width: @Share(row, summary.ByRoom)%"></span></span>
                                                <span class="count">@row.Count</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="count-row">
                                                <span class="name none">@Strings.Plants.ListNoRoom</span>
                                                <span class="bar" aria-hidden="true"><span class="fill" style="width: @Share(row, summary.ByRoom)%"></span></span>
                                                <span class="count">@row.Count</span>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (!showAllRooms && summary.ByRoom.Count > Preview)
                            {
                                <button type="button" class="btn btn-link show-all" @onclick="() => showAllRooms = true">@string.Format(CultureInfo.CurrentCulture, Strings.PlantDetail.ShowAll, summary.ByRoom.Count)</button>
                            }
                        </section>
                    }

                    @if (summary.AnyPropagations)
                    {
                        <section aria-labelledby="propagations-title">
                            <h2 class="section-label" id="propagations-title">@Strings.Plants.CollectionPropagations</h2>
                            <div class="numbers boxed">
                                <a class="number" href="propagations">
                                    <span class="figure">@summary.RootingNow</span>
                                    <span class="word">@Strings.Plants.CollectionRootingNow</span>
                                </a>
                                <a class="number" href="propagations">
                                    <span class="figure">@summary.RootedThisYear</span>
                                    <span class="word">@Strings.Plants.CollectionRootedThisYear</span>
                                </a>
                            </div>
                        </section>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private const int Preview = 10;

    private CollectionSummary? summary;
    private Places places = Places.None;
    private DateOnly today;
    private bool showAllGenera; // page state only, not stored
    private bool showAllRooms;

    // A room is worth a section once there is a room to name. Plants with no room alone aren't.
    private bool HasRooms => summary?.ByRoom.Any(r => r.Name is not null) == true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        places = await RoomService.GetPlacesAsync();
        today = Time.Today();
        summary = CollectionSummary.From(await PlantRepository.GetAllAsync(), await PropagationRepository.GetAllAsync(), places, today);
    }

    private static IEnumerable<CountRow> Shown(IReadOnlyList<CountRow> rows, bool all) =>
        all ? rows : rows.Take(Preview);

    private static string GenusHref(CountRow row) =>
        row.Name is null ? "plants?genus=none" : $"plants?genus={Uri.EscapeDataString(row.Name)}";

    // The longest bar fills the track, the others are as long as their share of it
    private static string Share(CountRow row, IReadOnlyList<CountRow> rows)
    {
        var most = rows.Max(r => r.Count);
        return (most == 0 ? 0 : row.Count * 100.0 / most).ToString("0.##", CultureInfo.InvariantCulture);
    }
}
