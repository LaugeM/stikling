@page "/join/{Token}"
@* What an invite link opens: who invited the person, to what, and what they can do there. Signed out, it shows the
   same and sends them to sign in, and comes back to this page. *@
@using Stikling.Core.People
@inject AccountService Account
@inject StiklingApi Api
@inject CollectionsService Collections
@inject IPlantRepository Plants
@inject NavigationManager Nav

<PageTitle>@Heading</PageTitle>

<h1>@Heading</h1>

@if (state == JoinState.Loading)
{
    <p class="settings-hint" role="status">@Strings.Account.Loading</p>
}
else if (state == JoinState.Problem)
{
    <p class="settings-message" role="alert">@problem</p>
    <p class="settings-hint">@Strings.People.JoinAboutStikling</p>
    <div class="settings-actions">
        <a class="btn btn-outline-primary" href="./">@Strings.People.JoinLookAround</a>
    </div>
}
else if (preview is { } invite)
{
    <section class="join-card">
        @if (state == JoinState.AlreadyMember)
        {
            <h2>@F(Strings.People.AlreadyMember, invite.DisplayName)</h2>
        }
        else
        {
            <h2>@(string.IsNullOrWhiteSpace(invite.InvitedByName)
                ? F(Strings.People.JoinInvitesNoName, invite.DisplayName)
                : F(Strings.People.JoinInvites, invite.InvitedByName, invite.DisplayName))</h2>
            @if (CountsLine(invite) is { } counts)
            {
                <p class="join-counts">@counts</p>
            }
            <p class="join-role">@RoleText.JoinMeaning(invite.Choice)</p>
            <a class="first-run-help join-roles-help" href="help#collection-roles">@Strings.People.JoinRolesHelp</a>
            @if (state != JoinState.SignedOut || deviceHasPlants)
            {
                <p class="settings-hint">@Strings.People.JoinOwnStay</p>
            }
        }
    </section>

    @if (state == JoinState.SignedOut)
    {
        <p class="settings-hint">@Strings.People.JoinAboutStikling</p>
        @if (Account.IsAvailable)
        {
            <div class="settings-actions">
                <a class="btn btn-primary" href="@SignInUrl">@Strings.People.JoinSignInButton</a>
                <button type="button" class="btn btn-link" @onclick="NotNow">@Strings.People.NotNow</button>
            </div>
            <p class="settings-hint">@Strings.People.JoinSignIn</p>
        }
        else
        {
            <p class="settings-hint">@Strings.Account.SignInNotSetUp</p>
        }
    }
    else if (state == JoinState.AlreadyMember)
    {
        <div class="settings-actions">
            @if (preview?.CollectionId == Collections.Current?.Id)
            {
                <a class="btn btn-primary" href="./">@Strings.People.JoinGoToday</a>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="OpenAsync">@Strings.People.OpenIt</button>
            }
        </div>
    }
    else if (state == JoinState.NeedsName)
    {
        <NameDialog Name="@name" OnSaved="NameSavedAsync" OnCancel="NotNow" />
    }
    else
    {
        <div class="settings-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="JoinAsync">@Strings.People.JoinButton</button>
            <button type="button" class="btn btn-link" disabled="@busy" @onclick="NotNow">@Strings.People.NotNow</button>
        </div>
        @if (problem is not null)
        {
            <p class="settings-message" role="alert">@problem</p>
        }
    }
}

@code {
    private enum JoinState { Loading, SignedOut, Problem, NeedsName, Ready, AlreadyMember }

    [Parameter]
    public string Token { get; set; } = "";

    private JoinState state = JoinState.Loading;
    private InvitePreviewInfo? preview;
    private string? name;
    private string? problem;
    private bool busy;
    private bool deviceHasPlants;

    // The collection's name once the person is in it, so the page says which one this is
    private string Heading => state == JoinState.AlreadyMember && preview is { } known ? known.DisplayName : Strings.People.JoinTitle;

    // "24 plants · 6 cuttings", leaving out a part that is none and the whole line when both are
    private static string? CountsLine(InvitePreviewInfo invite)
    {
        var plants = invite.Plants > 0
            ? Plural.Of(invite.Plants, Strings.People.JoinCountPlants_One, Strings.People.JoinCountPlants_Other)
            : null;
        var cuttings = invite.Cuttings > 0
            ? Plural.Of(invite.Cuttings, Strings.People.JoinCountCuttings_One, Strings.People.JoinCountCuttings_Other)
            : null;
        return plants is not null && cuttings is not null ? F(Strings.People.JoinCounts, plants, cuttings) : plants ?? cuttings;
    }

    // Back to this page once signed in
    private string SignInUrl => $"sign-in?return={Uri.EscapeDataString($"join/{Token}")}";

    protected override async Task OnParametersSetAsync()
    {
        state = JoinState.Loading;
        preview = null;
        problem = null;

        // The account has to be loaded before the page asks. Opened cold, Clerk may have no session yet, and the app then
        // answers signed out without sending the request, so it is asked once more after loading again
        var signedIn = await LoadSignedInAsync();
        var result = await Api.PreviewInviteAsync(Token, signedIn);
        if (signedIn && result.Failure == PeopleFailure.SignedOut)
        {
            signedIn = await LoadSignedInAsync();
            result = await Api.PreviewInviteAsync(Token, signedIn);
            if (result.Failure == PeopleFailure.SignedOut)
            {
                // Still no session, so the person sees the invite signed out
                signedIn = false;
                result = await Api.PreviewInviteAsync(Token, signedIn);
            }
        }

        if (!result.Ok)
        {
            ShowProblem(result.Failure!.Value, result.Field);
            return;
        }

        preview = result.Value;
        if (!signedIn)
        {
            // Someone signed out who has plants here is told they stay as they are. The example doesn't count
            try
            {
                deviceHasPlants = (await Plants.GetAllAsync()).Any(p => !ExampleFamily.PlantIds.Contains(p.Id));
            }
            catch (JSException)
            {
                deviceHasPlants = false;
            }

            state = JoinState.SignedOut;
            return;
        }

        if (preview!.AlreadyMember)
        {
            state = JoinState.AlreadyMember;
            return;
        }

        // The server won't take someone in without a name, so it is asked for first. Also puts the list of collections up to date
        var needsName = false;
        try
        {
            if (await Collections.RefreshAsync() is { } me)
            {
                name = me.Name;
                needsName = string.IsNullOrWhiteSpace(me.Name);
            }
        }
        catch (Exception e) when (e is HttpRequestException or AccountUnavailableException or JSException or TaskCanceledException)
        {
            // Accepting says so if the server has no name
        }

        state = needsName ? JoinState.NeedsName : JoinState.Ready;
    }

    private async Task<bool> LoadSignedInAsync()
    {
        try
        {
            return Account.IsAvailable && await Account.WasSignedInAsync() && (await Account.LoadAsync()).SignedIn;
        }
        catch (Exception e) when (e is AccountUnavailableException or JSException)
        {
            return false;
        }
    }

    private void ShowProblem(PeopleFailure failure, string? field)
    {
        problem = failure switch
        {
            PeopleFailure.NotFound => Strings.People.JoinNotFound,
            PeopleFailure.Gone => Strings.People.JoinGone,
            PeopleFailure.Full => F(Strings.People.JoinFull, preview?.DisplayName ?? "", PeopleLimits.MaxMembers),
            _ => PeopleText.Problem(failure, field),
        };
        state = failure == PeopleFailure.SignedOut && preview is not null ? JoinState.SignedOut : JoinState.Problem;
    }

    private void NameSavedAsync() => state = JoinState.Ready;

    private void NotNow() => Nav.NavigateTo("./");

    private async Task OpenAsync()
    {
        if (preview is null)
            return;

        busy = true;
        try
        {
            await RefreshQuietlyAsync();
            await Collections.SwitchToAsync(preview.CollectionId);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task JoinAsync()
    {
        busy = true;
        problem = null;
        try
        {
            var result = await Api.AcceptInviteAsync(Token);
            if (result is { Failure: PeopleFailure.Invalid, Field: "name" })
            {
                state = JoinState.NeedsName;
                return;
            }

            if (!result.Ok)
            {
                var failure = result.Failure!.Value;
                ShowProblem(failure, result.Field);

                // The page stays on the invite for a problem that may pass, like being offline
                if (failure is PeopleFailure.Offline or PeopleFailure.Other)
                    state = JoinState.Ready;
                return;
            }

            await RefreshQuietlyAsync();
            await Collections.SwitchToAsync(result.Value!.Id);
        }
        finally
        {
            busy = false;
        }
    }

    // So the collection is in the list before it is opened. Sync does the same if this can't reach the server
    private async Task RefreshQuietlyAsync()
    {
        try
        {
            await Collections.RefreshAsync();
        }
        catch (Exception e) when (e is HttpRequestException or AccountUnavailableException or JSException or TaskCanceledException)
        {
            // The first sync in the opened collection adds it to the list
        }
    }
}
