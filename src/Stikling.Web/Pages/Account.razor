@page "/account"
@implements IDisposable
@using Stikling.Core.Sync
@inject AccountService Accounts
@inject SyncRunner Sync
@inject TimeProvider Time
@inject NavigationManager Nav

<PageTitle>@Strings.Account.AccountPageTitle</PageTitle>

<a class="back-link" href="settings?section=account">@Strings.Account.BackToSettings</a>
<h1>@Strings.Account.AccountTitle</h1>

@if (!accountHintRead)
{
    @* Nothing until it's known whether to check, so a signed-in device never shows "Not signed in" *@
}
else if (account is { SignedIn: true })
{
    <p class="account-email">@account.Email</p>
    <p class="settings-hint account-status" role="status">@SyncLine</p>
    <div class="settings-actions">
        <button type="button" class="btn btn-outline-primary" @onclick="Sync.SyncNowAsync"
                disabled="@(Sync.Running || accountBusy)">
            @Strings.Account.AccountSyncNow
        </button>
        <button type="button" class="btn btn-outline-primary" @onclick="AskSignOutAsync"
                disabled="@(accountBusy || signOut is not null || deleting)">
            @Strings.Account.AccountSignOut
        </button>
    </div>
    <p class="settings-hint">
        @Strings.Account.AccountKeptSame
    </p>
    @if (photoUsage is { } usage && usage.UsedBytes >= 0.8 * usage.LimitBytes)
    {
        <p class="settings-hint">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.AccountPhotoUsage, Labels.Bytes(usage.UsedBytes), Labels.Bytes(usage.LimitBytes))</p>
    }
    @if (SyncProblem is { } problem)
    {
        <p class="settings-message" role="alert">@problem</p>
    }

    @if (signOut is { } unsent)
    {
        <div class="confirm-card">
            <p>
                <strong>@Strings.Account.AccountSignOutHeading</strong><br />
                @Strings.Account.AccountSignOutExplain
            </p>
            @if (unsent.Checking)
            {
                <p class="settings-hint" role="status">@Strings.Account.AccountSendingLatest</p>
            }
            else
            {
                @if (unsent.Photos > 0)
                {
                    <p class="settings-hint">
                        @Plural.Of(unsent.Photos, Strings.Account.AccountUnsentPhotos_One, Strings.Account.AccountUnsentPhotos_Other)
                    </p>
                }
                @if (unsent.Pending > 0)
                {
                    <p class="settings-hint">
                        @Plural.Of(unsent.Pending, Strings.Account.AccountUnsentChanges_One, Strings.Account.AccountUnsentChanges_Other)
                    </p>
                }
            }
            <div class="settings-actions">
                <button type="button" class="btn btn-primary" disabled="@(accountBusy || unsent.Checking)"
                        @onclick="() => SignOutAsync(keepData: true)">@Strings.Account.AccountKeepAndSignOut</button>
                <button type="button" class="btn btn-danger" disabled="@(accountBusy || unsent.Checking)"
                        @onclick="() => SignOutAsync(keepData: false)">@Strings.Account.AccountRemoveAndSignOut</button>
                <button type="button" class="btn btn-link" disabled="@accountBusy"
                        @onclick="() => signOut = null">@Strings.Common.Cancel</button>
            </div>
        </div>
    }

    @if (signOut is null && !deleting)
    {
        <div class="settings-actions">
            <button type="button" class="btn btn-outline-primary" @onclick="DownloadDataAsync"
                    disabled="@(accountBusy || downloading)">
                @Strings.Account.AccountDownload
            </button>
        </div>
        <p class="settings-hint" role="status">
            @(downloading ? Strings.Account.AccountDownloadPreparing : Strings.Account.AccountDownloadHint)
        </p>
    }

    <hr class="account-divider" />
    @if (deleting)
    {
        <div class="confirm-card confirm-card-danger">
            <p>
                <strong>@Strings.Account.AccountDeleteHeading</strong><br />
                @Strings.Account.AccountDeleteExplain
            </p>
            <div class="form-check mt-2">
                <input type="checkbox" class="form-check-input" id="delete-here-too" @bind="removeHereToo"
                       disabled="@accountBusy" />
                <label class="form-check-label" for="delete-here-too">@Strings.Account.AccountRemoveHereToo</label>
            </div>
            <p class="settings-hint">
                @(removeHereToo ? Strings.Account.AccountEmptyAfter : Strings.Account.AccountKeepsWhatItHas)
            </p>
            <div class="settings-actions">
                <button type="button" class="btn btn-danger" disabled="@accountBusy"
                        @onclick="DeleteAccountAsync">@Strings.Account.AccountDeleteButton</button>
                <button type="button" class="btn btn-link" disabled="@accountBusy"
                        @onclick="() => deleting = false">@Strings.Common.Cancel</button>
            </div>
        </div>
    }
    else if (signOut is null)
    {
        <button type="button" class="btn btn-link text-danger px-0" disabled="@accountBusy"
                @onclick="AskDeleteAccount">@Strings.Account.AccountDeleteButton</button>
    }

    @if (accountMessage is not null)
    {
        <p class="settings-message" role="alert">@accountMessage</p>
    }
}
else if (accountChecking)
{
    <p class="settings-hint" role="status">@Strings.Account.AccountChecking</p>
}
else if (accountUnreachable)
{
    <p class="settings-hint" role="status">
        @Strings.Account.AccountUnreachable
    </p>
}
else
{
    <div class="room-row">
        <span class="room-name">@Strings.Account.AccountNotSignedIn</span>
        <a class="btn btn-link btn-sm link-action" href="sign-in">@Strings.Account.AccountSignIn</a>
    </div>
    <p class="settings-hint">@Strings.Account.AccountOptional</p>
    @if (accountMessage is not null)
    {
        <p class="settings-message" role="status">@accountMessage</p>
    }
}

@code {
    /// <summary>What removing the data at sign-out would lose, once a last sync has had its go.</summary>
    private sealed record SignOutCheck(bool Checking, int Pending = 0, int Photos = 0);

    private AccountState? account;
    private bool accountChecking;
    private bool accountLoadStarted;
    private bool accountUnreachable;
    private bool accountBusy;
    private bool accountHintRead;
    private string? accountMessage;
    private SignOutCheck? signOut;
    private bool deleting; // the question about deleting the account is open
    private bool removeHereToo;
    private bool downloading;
    private PhotoUsage? photoUsage;

    protected override async Task OnInitializedAsync()
    {
        if (!Accounts.IsAvailable)
        {
            Nav.NavigateTo("settings?section=account", replace: true);
            return;
        }

        Accounts.Changed += OnAccountChanged;
        Sync.StatusChanged += OnSyncChanged;
        // Clerk is only loaded on a device where someone signed in, so it stays out of the way otherwise
        accountChecking = await Accounts.WasSignedInAsync();
        accountHintRead = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once the page is up, so a slow connection doesn't hold the page back
        if (!accountChecking || accountLoadStarted)
            return;

        accountLoadStarted = true;
        try
        {
            account = await Accounts.LoadAsync();
        }
        catch (AccountUnavailableException)
        {
            accountUnreachable = true;
        }

        accountChecking = false;
        StateHasChanged();

        if (account is { SignedIn: true })
        {
            photoUsage = await Sync.GetPhotoUsageAsync();
            StateHasChanged();
        }
    }

    /// <summary>"Synced at 14:32", for the line under the email.</summary>
    private string SyncLine => (Sync.Running, Sync.LastSynced) switch
    {
        (true, _) => Strings.Account.AccountSyncing,
        (_, { } at) when at.ToLocalTime().Date == Time.GetLocalNow().Date => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.AccountSyncedAt, Labels.Time(at)),
        (_, { } at) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Account.AccountSyncedOn, Labels.Date(DateOnly.FromDateTime(at.ToLocalTime().DateTime))),
        _ => Strings.Account.AccountNotSynced
    };

    private string? SyncProblem
    {
        get
        {
            if (Sync.Running)
                return null;
            if (Sync.Problem is { } problem)
                return Sync.Pending > 0
                    ? $"{problem} {Plural.Of(Sync.Pending, Strings.Account.AccountChangesWaiting_One, Strings.Account.AccountChangesWaiting_Other)}"
                    : problem;
            if (Sync.Refused > 0)
                return Plural.Of(Sync.Refused, Strings.Account.AccountRefused_One, Strings.Account.AccountRefused_Other);
            if (Sync.PhotosFull)
                return Strings.Account.AccountPhotosFull;
            return null;
        }
    }

    private void OnSyncChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        if (!Sync.Running)
        {
            photoUsage = await Sync.GetPhotoUsageAsync();
            StateHasChanged();
        }
    });

    private async void OnAccountChanged(AccountState state)
    {
        // Clerk also reports each renewed token, which changes nothing shown here
        if (state == account)
            return;

        account = state;
        accountUnreachable = false;
        accountMessage = null;
        signOut = null;
        deleting = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadDataAsync()
    {
        downloading = true;
        accountMessage = null;
        try
        {
            await Sync.DownloadMyDataAsync();
        }
        catch (Exception e) when (e is HttpRequestException or JSException or TaskCanceledException)
        {
            accountMessage = Strings.Account.AccountDownloadFailed;
        }
        finally
        {
            downloading = false;
        }
    }

    private void AskDeleteAccount()
    {
        accountMessage = null;
        removeHereToo = false;
        deleting = true;
    }

    private async Task DeleteAccountAsync()
    {
        accountBusy = true;
        accountMessage = null;
        try
        {
            await Sync.DeleteAccountAsync(keepData: !removeHereToo);
            if (removeHereToo)
            {
                // Starts the app afresh, so no page still holds what was removed
                Nav.NavigateTo("", forceLoad: true);
                return;
            }

            account = new AccountState(false, null);
            deleting = false;
            accountMessage = Strings.Account.AccountDeleted;
        }
        catch (Exception e) when (e is HttpRequestException or JSException or TaskCanceledException)
        {
            accountMessage = Strings.Account.AccountDeleteFailed;
        }
        finally
        {
            accountBusy = false;
        }
    }

    /// <summary>Opens the question, after one last sync so as little as possible is left unsent.</summary>
    private async Task AskSignOutAsync()
    {
        accountMessage = null;
        signOut = new SignOutCheck(Checking: true);
        StateHasChanged();

        await Sync.SyncNowAsync();
        var (pending, photos) = await Sync.CountUnsentAsync();
        if (signOut is not null)
            signOut = new SignOutCheck(Checking: false, pending, photos);
    }

    private async Task SignOutAsync(bool keepData)
    {
        accountBusy = true;
        accountMessage = null;
        try
        {
            await Sync.SignOutAsync(keepData, Nav.Uri);
            if (!keepData)
            {
                // Starts the app afresh, so no page still holds what was removed
                Nav.NavigateTo("", forceLoad: true);
                return;
            }

            account = new AccountState(false, null);
            signOut = null;
        }
        catch (JSException)
        {
            accountMessage = Strings.Account.AccountSignOutFailed;
        }
        finally
        {
            accountBusy = false;
        }
    }

    public void Dispose()
    {
        Accounts.Changed -= OnAccountChanged;
        Sync.StatusChanged -= OnSyncChanged;
    }
}
