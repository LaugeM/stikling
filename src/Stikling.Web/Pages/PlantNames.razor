@page "/plant-names"
@inject PlantNameService Names

<PageTitle>@Strings.Shared.PlantNamesPageTitle</PageTitle>

<a class="back-link" href="settings?section=about">@Strings.Layout.Settings</a>
<h1>@Strings.Shared.PlantNamesTitle</h1>

<section class="settings-section">
    <p class="settings-hint">@Strings.Shared.PlantNamesHint</p>
    @if (nameSources.Count > 0)
    {
        <ul class="settings-hint">
            @foreach (var source in nameSources)
            {
                <li>
                    <a href="@source.Url" target="_blank" rel="noopener">@source.Name</a>@(source.Version is null ? "" : $" ({source.Version})"):
                    @source.Covers. @source.Licence.
                </li>
            }
        </ul>
    }
</section>

@code {
    private IReadOnlyList<NameSource> nameSources = [];

    protected override async Task OnInitializedAsync() =>
        nameSources = (await Names.GetDictionaryAsync()).Sources;
}
