@page "/plant-names"
@inject PlantNameService Names

<PageTitle>Plant names · Stikling</PageTitle>

<a class="back-link" href="settings">Settings</a>
<h1>Plant names</h1>

<section class="settings-section">
    <p class="settings-hint">
        The names suggested while you type come with the app, so they work offline. They cover the aroids, prayer plants,
        begonias, carnivorous plants and the genera of most other common houseplants in full. From big genera like Ficus
        and Euphorbia they have the species with an everyday name. Everyday names come in English, and in Danish on a
        device set to Danish, along with lists of cultivars, trade names and everyday names kept by hand.
    </p>
    @if (nameSources.Count > 0)
    {
        <ul class="settings-hint">
            @foreach (var source in nameSources)
            {
                <li>
                    <a href="@source.Url" target="_blank" rel="noopener">@source.Name</a>@(source.Version is null ? "" : $" ({source.Version})"):
                    @source.Covers. @source.Licence.
                </li>
            }
        </ul>
    }
</section>

@code {
    private IReadOnlyList<NameSource> nameSources = [];

    protected override async Task OnInitializedAsync() =>
        nameSources = (await Names.GetDictionaryAsync()).Sources;
}
