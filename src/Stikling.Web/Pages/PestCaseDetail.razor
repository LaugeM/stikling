@page "/pests/{Id:guid}"
@layout WideLayout
@inject IPestCaseRepository Repository
@inject IPestTreatmentRepository Treatments
@inject IPlantRepository PlantRepository
@inject IPestCaseRepository CaseRepository
@inject SettingsService SettingsService
@using Stikling.Core.Settings
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject ITreatmentPlanRepository PlanRepository
@inject PutOffService PutOffService
@inject TimeProvider Time

<PageTitle>@(view is null ? Strings.Pests.CasePageTitle : Labels.For(view.Case.Pest)) · Stikling</PageTitle>
<ReloadOnSync Reload="ReloadAsync" />
<ShowFound ElementId="@(Entry is { } entryId ? $"entry-{entryId}" : null)" Ready="@(view is not null)" />

<a class="back-link" href="pests">@Strings.Pests.CaseBackToPests</a>

@if (view is null)
{
    <p class="text-body-secondary">@(loaded ? Strings.Pests.CaseGone : Strings.Pests.Loading)</p>
}
else
{
    <div class="case-layout">
    <header class="detail-header">
        <div class="detail-icon @(view.Case.IsOpen ? "alert" : null)" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
        </div>
        <div class="min-w-0">
            <h1>@Labels.For(view.Case.Pest)</h1>
            <p class="detail-sub">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseScopeFound, Labels.Scope(view), Labels.Date(view.Case.StartedOn))</p>
            @if (view.Case.IsOpen)
            {
                <span class="badge stage-badge">@Labels.For(view.Case.Status)</span>
            }
            else
            {
                <span class="badge text-bg-secondary">@Labels.For(view.Case.Status)</span>
            }
            @if (view.CleanDays is { } cleanDays)
            {
                <p class="detail-sub mt-2 mb-0">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCleanDays, cleanDays, view.CleanTarget)</p>
            }
        </div>
    </header>

    <div class="detail-actions">
        @if (view.Case.IsOpen)
        {
            <button type="button" class="btn btn-primary" @onclick="ToggleLogging">
                @(logging ? Strings.Common.Close : view.IsCheck ? Strings.Pests.CaseLogCheck : Strings.Pests.CaseLogTreatment)
            </button>
        }
        @if (view.IsCheck)
        {
            @* Pests seen again: back to treating, with the treatment sheet ready *@
            <button type="button" class="btn btn-outline-primary" @onclick="FoundSomeAsync">@Strings.Pests.CaseFoundSome</button>
        }
        @if (view.Case.Status == PestCaseStatus.Active && !view.Case.PlanRunning)
        {
            @if (plans.Count > 0)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="ToggleFollowing">
                    @(following ? Strings.Common.Close : Strings.Pests.CaseFollowPlan)
                </button>
            }
            else
            {
                <a class="btn btn-outline-primary" href="treatment-plans">@Strings.Pests.CaseMakePlan</a>
            }
        }
        <a class="btn btn-outline-primary" href="pests/@view.Case.Id/edit">@Strings.Common.Edit</a>
    </div>

    @if (message is not null)
    {
        <p class="action-message" role="status">@message</p>
    }

    @if (view.Case.IsOpen && view.CleanDays >= view.CleanTarget)
    {
        <section class="detail-card">
            @if (view.ReadyToResolve)
            {
                <p>@Plural.Of(view.CleanWeeks, Strings.Pests.CaseCleanReady_One, Strings.Pests.CaseCleanReady_Other)</p>
                <button type="button" class="btn btn-primary" disabled="@resolving" @onclick="ResolveAsync">@Strings.Pests.CaseResolve</button>
            }
            else
            {
                <p class="mb-0">@Plural.Of(view.CleanWeeks, Strings.Pests.CaseCleanCheck_One, Strings.Pests.CaseCleanCheck_Other)</p>
            }
        </section>
    }

    @if (following && plans.Count > 0 && view.Case.Status == PestCaseStatus.Active && !view.Case.PlanRunning)
    {
        <section class="detail-card">
            <h2>@Strings.Pests.CaseFollowPlan</h2>
            <div class="chip-row mb-2" role="group" aria-label="@Strings.Pests.CaseEditPlans">
                @foreach (var plan in plans)
                {
                    <button type="button" class="chip @(pickedPlan == plan.Id ? "picked" : null)"
                            aria-pressed="@(pickedPlan == plan.Id ? "true" : "false")"
                            @onclick="() => pickedPlan = plan.Id">@plan.Name</button>
                }
            </div>
            @if (plans.FirstOrDefault(p => p.Id == pickedPlan) is { } chosen)
            {
                <div class="form-text mb-2">@chosen.Summary()</div>
            }
            <div class="mb-2">
                <label class="form-label" for="plan-start">@Strings.Pests.CaseStartOn</label>
                <input type="date" id="plan-start" class="form-control form-control-sm plan-date"
                       min="@view.Case.StartedOn.ToString("yyyy-MM-dd")" max="@Today.ToString("yyyy-MM-dd")"
                       value="@planStart.ToString("yyyy-MM-dd")" @onchange="PlanStartChanged" />
            </div>
            <div class="care-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || pickedPlan is null)" @onclick="StartPlanAsync">@Strings.Pests.CaseStartPlan</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => following = false">@Strings.Common.Cancel</button>
            </div>
        </section>
    }

    @if (logging && view.Case.IsOpen)
    {
        <section class="detail-card">
            <h2>@(view.IsCheck ? Strings.Pests.CaseLogCheck : Strings.Pests.CaseLogTreatment)</h2>
            <TreatmentSheet @key="@((view.Case.Status, view.Step?.Id))" Case="view.Case" Existing="treatments" Check="view.IsCheck"
                            Step="@(view.Case.PlanRunning ? view.Step : null)"
                            OnLogged="LoggedAsync" OnCancel="() => logging = false" />
        </section>
    }

    @if (view.Case.PlanStartedOn is not null && view.Case.PlanSteps.Count > 0)
    {
        <section class="detail-card">
            <h2>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CasePlanHeading, view.Case.PlanName)</h2>
            <ol class="plan-progress">
                @for (var i = 0; i < view.Case.PlanSteps.Count; i++)
                {
                    var step = view.Case.PlanSteps[i];
                    var current = view.Step?.Id == step.Id;
                    var done = PlanProgress.ForStep(view.Case, treatments, step.Id);
                    <li class="plan-progress-step @(current ? "current" : null)">
                        <div class="plan-progress-line">
                            <span class="plan-progress-what">@StepName(step)</span>
                            <span class="plan-progress-when">@StepWhen(step, i, current, done)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(step.Notes))
                        {
                            <div class="plan-progress-note">@step.Notes</div>
                        }
                        @if (current)
                        {
                            @if (movingStep == step.Id)
                            {
                                <div class="plan-move">
                                    <label class="form-label" for="plan-move-day">@Strings.Pests.CaseMoveTo</label>
                                    <input type="date" id="plan-move-day" class="form-control form-control-sm plan-date"
                                           min="@Today.ToString("yyyy-MM-dd")" value="@moveTo.ToString("yyyy-MM-dd")"
                                           @onchange="MoveToChanged" />
                                </div>
                                <div class="care-actions">
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => MoveStepAsync(step)">@Strings.Pests.CaseMove</button>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => movingStep = null">@Strings.Common.Cancel</button>
                                </div>
                            }
                            else
                            {
                                <div class="care-actions">
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick="StartLogStep">@Strings.Pests.CaseLogStep</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => SkipStepAsync(step)">@Strings.Pests.CaseSkip</button>
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => StartMove(step)">@Strings.Pests.CaseMove</button>
                                </div>
                            }
                        }
                    </li>
                }
            </ol>

            @if (view.PlanDoneOn is { } doneOn)
            {
                <p class="plan-progress-note">@(view.PlanDone ? Strings.Pests.CaseLastStepToday : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseLastStepFrom, Labels.Date(doneOn)))</p>
            }
            else if (view.Case.PlanStoppedOn is { } stopped)
            {
                <p class="plan-progress-note">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CasePlanStopped, Labels.Date(stopped))</p>
            }

            @if (view.Case.PlanRunning)
            {
                @if (confirmStop)
                {
                    <p class="mb-2">@Plural.Of(view.Case.IntervalDays, Strings.Pests.CaseStopConfirm_One, Strings.Pests.CaseStopConfirm_Other)</p>
                    <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="StopPlanAsync">@Strings.Pests.CaseStopPlan</button>
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => confirmStop = false">@Strings.Common.Cancel</button>
                }
                else
                {
                    <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => confirmStop = true">@Strings.Pests.CaseStopPlan</button>
                }
            }
        </section>
    }

    <section class="detail-card">
        <dl class="detail-list">
            <dt>@Strings.Pests.CaseCovers</dt>
            <dd>@Labels.ScopeAndCount(view)</dd>

            @if (view.IsCheck)
            {
                <dt>@Strings.Pests.CaseChecking</dt>
                <dd>@Plural.Of(PestService.CheckEveryDays, Strings.Pests.CaseEvery_One, Strings.Pests.CaseEvery_Other)</dd>
            }
            else if (view.Case.PlanRunning)
            {
                <dt>@Strings.Pests.CaseTreating</dt>
                <dd>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseFollowing, view.Case.PlanName)</dd>
            }
            else
            {
                <dt>@Strings.Pests.CaseTreating</dt>
                <dd>@Plural.Of(view.Case.IntervalDays, Strings.Pests.CaseEvery_One, Strings.Pests.CaseEvery_Other)</dd>
            }

            @* Before the first treatment there's no rhythm yet, so a date for the next would only confuse.
               A case being watched still shows when its weekly check is due. *@
            @if (!view.Untreated || view.Step is not null || view.PlanDoneOn is not null)
            {
                <dt>@Strings.Pests.CaseNext</dt>
                <dd>
                    @if (view.NextDue is { } due && view.DaysUntilDue is { } days)
                    {
                        <span class="pest-due @(view.IsDue ? "now" : null)">@Labels.Due(days, view.IsCheck)</span>
                        <text> · @Labels.Date(due)</text>
                    }
                    else if (view.PlanDoneOn is not null)
                    {
                        <text>@Strings.Pests.CasePlanDone</text>
                    }
                    else
                    {
                        <text>@Strings.Pests.CaseNothingDue</text>
                    }
                </dd>
            }

            <dt>@Strings.Pests.CaseLast</dt>
            <dd>@(view.Last is { } last ? $"{Labels.Date(last.OccurredOn)} · {What(last)}" : Strings.Pests.CaseNoTreatments)</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(view.Case.Notes))
        {
            <h2>@Strings.Pests.CaseEditNotes</h2>
            <p class="detail-notes">@view.Case.Notes</p>
        }

        @if (view.Case.IsOpen && !ShowTrap)
        {
            @* Mites and mealybugs rarely end up on a trap, but someone may have one up anyway *@
            <p class="trap-offer">
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="StartCounting">@Strings.Pests.CaseCountStickyTrap</button>
            </p>
        }
    </section>

    @* Its own card rather than a button in the row above, so it's there to come back to *@
    @if (ShowTrap)
    {
        <section class="detail-card">
            <div class="trap-head">
                <h2>@Strings.Pests.CaseStickyTrap</h2>
                @if (view.Case.IsOpen && !counting)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="StartCounting">@Strings.Pests.CaseCountTrap</button>
                }
            </div>

            @if (counting)
            {
                <TrapCountSheet Case="view.Case" OnLogged="CountedAsync" OnCancel="() => counting = false" />
            }
            else if (!Trapped)
            {
                <p class="text-body-secondary mb-0">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseTrapIntro, Labels.For(view.Case.Pest))</p>
            }
            else
            {
                @if (catches.LastOrDefault() is { } latest)
                {
                    <p class="mb-0">@Caught(latest)</p>
                }
                else
                {
                    <p class="text-body-secondary mb-0">@Strings.Pests.CaseNewTrapUp</p>
                }

                @if (askTreatAgain && view.IsCheck)
                {
                    @* New ones on the trap while the case is only watched: offer to go back to treating *@
                    <div class="trap-ask">
                        <p>@(catches[^1].Caught == 1 ? Strings.Pests.CaseTreatAgainOne : Strings.Pests.CaseTreatAgainMany)</p>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="FoundSomeAsync">@Strings.Pests.CaseTreatAgain</button>
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => askTreatAgain = false">@Strings.Pests.CaseNotNow</button>
                    </div>
                }

                @if (catches.Count(c => c.PerWeek is not null) > 1)
                {
                    <TrapChart Catches="catches" />
                }
            }
        </section>
    }

    <section class="detail-card case-side">
        <h2>@(treatments.Any(t => t.Kind != PestTreatmentKind.Treated) ? Strings.Pests.CaseTreatmentsAndChecks : Strings.Pests.CaseTreatments)</h2>
        @if (treatments.Count == 0)
        {
            <p class="text-body-secondary mb-0">
                @Strings.Pests.CaseNothingLogged
            </p>
        }
        else
        {
            <ul class="care-list">
                @foreach (var treatment in treatments)
                {
                    <li id="entry-@treatment.Id">
                        <div class="care-entry">
                            <span class="care-what">
                                @What(treatment)
                                @if (!string.IsNullOrWhiteSpace(treatment.Notes))
                                {
                                    <span class="text-body-secondary"> · @treatment.Notes</span>
                                }
                            </span>
                            <span class="care-when">@Labels.Date(treatment.OccurredOn)</span>
                        </div>
                        @if (treatment.Ingredients.Count > 0)
                        {
                            @* The recipe as it was that day, not as it is now *@
                            <div class="treatment-recipe">@string.Join(" · ", treatment.Ingredients)</div>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="detail-card">
        <h2>@Strings.Pests.CasePlants</h2>
        @if (view.Plants.Count == 0)
        {
            <p class="text-body-secondary mb-0">
                @(view.Case.Scope == PestScope.Room
                    ? Strings.Pests.CaseNothingInRoom
                    : Strings.Pests.CaseNoPlants)
            </p>
        }
        else
        {
            <ul class="family-list">
                @foreach (var plant in view.Plants)
                {
                    <li>
                        <a href="plants/@plant.Id">@plant.DisplayName</a>
                        @if (places.NameOf(plant.PlaceId) is { } location)
                        {
                            <span class="text-body-secondary small"> · @location</span>
                        }
                    </li>
                }
            </ul>
            @if (view.Case.Scope != PestScope.PickedPlants)
            {
                <p class="family-hint">@Strings.Pests.CasePlantsHint</p>
            }
        }
    </section>

    @if (neighbours.Count > 0)
    {
        <section class="detail-card">
            <h2>@Strings.Pests.CaseNeighbours</h2>
            <p class="text-body-secondary">@Strings.Pests.CaseNeighboursHint</p>
            <ul class="neighbour-list">
                @foreach (var neighbour in neighbours)
                {
                    <li @key="neighbour.Plant.Id">
                        <div class="neighbour-text">
                            <a href="plants/@neighbour.Plant.Id">@neighbour.Plant.DisplayName</a>
                            <div class="text-body-secondary small">@(neighbour.LastChecked is { } day ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseChecked, Labels.DaysAgo(Math.Max(0, Today.DayNumber - day.DayNumber))) : Strings.Pests.CaseNeverChecked)</div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => CleanAsync(neighbour.Plant)">@Strings.Pests.CaseClean</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => AddToCaseAsync(neighbour.Plant)">@Strings.Pests.CaseAddToCase</button>
                    </li>
                }
            </ul>
        </section>
    }

    </div>

    <section class="danger-zone">
        @if (confirmDelete)
        {
            <p class="mb-2">@Strings.Pests.CaseDeleteConfirm</p>
            <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">@Strings.Common.Delete</button>
            <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
        }
        else
        {
            <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">@Strings.Pests.CaseDelete</button>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>A treatment to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "entry")]
    public Guid? Entry { get; set; }

    private PestCaseView? view;
    private Places places = Places.None;
    private IReadOnlyList<PestTreatment> treatments = [];
    private IReadOnlyList<TrapCatch> catches = [];
    private bool loaded;
    private bool logging;
    private bool counting;
    private bool askTreatAgain;
    private bool confirmDelete;
    private string? message;
    private bool busy;
    private bool resolving;
    private IReadOnlyList<TreatmentPlan> plans = [];
    private bool following;
    private Guid? pickedPlan;
    private DateOnly planStart;
    private Guid? movingStep;
    private DateOnly moveTo;
    private bool confirmStop;
    private IReadOnlyList<Neighbour> neighbours = [];
    private PutOffs putOffs = PutOffs.Empty();

    private DateOnly Today => Time.Today();

    protected override async Task OnParametersSetAsync()
    {
        confirmDelete = false;
        logging = false;
        counting = false;
        askTreatAgain = false;
        following = false;
        movingStep = null;
        confirmStop = false;
        message = null;
        await ReloadAsync();
        loaded = true;
    }

    private async Task ReloadAsync()
    {
        if (await Repository.GetAsync(Id) is not { } item)
        {
            view = null;
            return;
        }

        var all = await Treatments.GetAllAsync();
        treatments = PestService.TreatmentsFor(all, item.Id);
        catches = PestService.Catches(item, all);
        places = await RoomService.GetPlacesAsync();
        var plants = await PlantRepository.GetAllAsync();
        var settings = await SettingsService.GetAsync();
        putOffs = await PutOffService.GetAsync(Today);
        plans = (await PlanRepository.GetAllAsync())
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        view = PestService.Describe(item, plants, all, places, Today, settings.CleanWeeks ?? PestService.DefaultCleanWeeks, putOffs);
        neighbours = PestService.Neighbours(item, plants, await CaseRepository.GetAllAsync(), all, places);
    }

    private async Task CleanAsync(Plant plant)
    {
        busy = true;
        try
        {
            await Treatments.SaveAsync(PestService.StartPlantCheck(plant, Today));
            await ReloadAsync();
            message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseNeighbourChecked, plant.DisplayName);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddToCaseAsync(Plant plant)
    {
        if (view is null)
            return;

        busy = true;
        try
        {
            if (!view.Case.PlantIds.Contains(plant.Id))
                view.Case.PlantIds.Add(plant.Id);
            await Repository.SaveAsync(view.Case);
            await ReloadAsync();
            message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseNeighbourAdded, plant.DisplayName);
        }
        finally
        {
            busy = false;
        }
    }

    // Never done on its own: only when someone taps Resolve
    private async Task ResolveAsync()
    {
        if (view is null)
            return;

        resolving = true;
        try
        {
            view.Case.Status = PestCaseStatus.Resolved;
            view.Case.ResolvedOn = Today;
            await Repository.SaveAsync(view.Case);
            await ReloadAsync();
            message = Strings.Pests.CaseResolved;
        }
        finally
        {
            resolving = false;
        }
    }

    private bool Trapped => treatments.Any(t => t.Kind == PestTreatmentKind.TrapCount);

    // A pest that flies into traps gets the card from the start. Any other gets it once a trap
    // is counted, or while the link below the details has the count open.
    private bool ShowTrap =>
        view is not null && (Trapped || counting || (view.Case.IsOpen && view.Case.Pest.CaughtOnTrap()));

    // One sheet open at a time, so the page doesn't grow two forms
    private void ToggleLogging()
    {
        logging = !logging;
        counting = false;
        following = false;
        message = null;
    }

    private void StartCounting()
    {
        counting = true;
        logging = false;
        askTreatAgain = false;
        message = null;
    }

    private async Task LoggedAsync()
    {
        var check = view?.IsCheck == true;
        logging = false;
        await ReloadAsync();
        message = check ? Strings.Pests.CheckLogged : Strings.Pests.TreatmentLogged;
    }

    private async Task CountedAsync()
    {
        counting = false;
        message = null;
        var before = catches.Count;
        await ReloadAsync();

        // Only a count that added a catch can have found anything
        askTreatAgain = catches.Count > before && catches[^1].Caught > 0;
    }

    private static string Caught(TrapCatch latest)
    {
        var text = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCaught, Plural.Of(latest.Caught, Strings.Pests.CaseNew_One, Strings.Pests.CaseNew_Other), Plural.Of(latest.Days, Strings.Pests.CaseDay_One, Strings.Pests.CaseDay_Other));
        return latest.PerWeek is { } perWeek
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCaughtAbout, text, Math.Round(perWeek).ToString("0", System.Globalization.CultureInfo.CurrentCulture))
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCaughtPlain, text);
    }

    private string What(PestTreatment treatment) => treatment switch
    {
        { Skipped: true } => view?.Case.PlanSteps.FirstOrDefault(s => s.Id == treatment.PlanStepId) is { } skipped
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseSkippedStep, StepName(skipped))
            : Strings.Pests.CaseSkippedAStep,
        { Kind: PestTreatmentKind.Checked } => Strings.Pests.CaseWhatChecked,
        { Kind: PestTreatmentKind.TrapCount, OnTrap: { } onTrap } =>
            treatment.NewTrap ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCountedTrapThenNew, onTrap) : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseCountedTrap, onTrap),
        { Kind: PestTreatmentKind.TrapCount } => Strings.Pests.CasePutUpTrap,
        { What: { } what } when !string.IsNullOrWhiteSpace(what) => what,
        _ => Strings.Pests.CaseWhatTreated
    };

    private async Task FoundSomeAsync()
    {
        if (view is null)
            return;

        var from = view.Case.Status;
        view.Case.Status = PestCaseStatus.Active;
        PestService.StatusChanged(view.Case, from, Today, treatments);
        await Repository.SaveAsync(view.Case);
        await ReloadAsync();
        askTreatAgain = false;
        counting = false;
        logging = true;
        message = null;
    }

    private static string StepName(PlanStep step) =>
        string.IsNullOrWhiteSpace(step.What) ? Strings.Pests.CaseStep : step.What.Trim();

    // A done step shows its day or that it was skipped, the current one when it's due, later ones how long after
    private string StepWhen(PlanStep step, int index, bool current, IReadOnlyList<PestTreatment> done)
    {
        if (done.Count > 0)
            return done[0].Skipped ? Strings.Pests.CaseStepSkipped : Labels.Date(done[0].OccurredOn);

        if (current && view?.NextDue is { } due && view.DaysUntilDue is { } days)
            return $"{Labels.Due(days)} · {Labels.Date(due)}";

        if (!(view?.Case.PlanRunning ?? false))
            return Strings.Pests.CaseStepNotDone;

        return index == 0 ? Strings.Pests.CaseStepStartDay : Plural.Of(step.DaysAfter, Strings.Pests.CaseStepAfter_One, Strings.Pests.CaseStepAfter_Other);
    }

    private void ToggleFollowing()
    {
        following = !following;
        logging = false;
        counting = false;
        message = null;
        planStart = Today;
        pickedPlan ??= plans.Count == 1 ? plans[0].Id : null;
    }

    private void PlanStartChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var picked))
            planStart = picked;
    }

    private async Task StartPlanAsync()
    {
        if (view is null || plans.FirstOrDefault(p => p.Id == pickedPlan) is not { } plan)
            return;

        if (planStart > Today || planStart < view.Case.StartedOn)
        {
            message = planStart > Today ? Strings.Pests.CasePlanFuture : Strings.Pests.CasePlanBeforeCase;
            return;
        }

        busy = true;
        try
        {
            view.Case.StartPlan(plan, planStart);
            await Repository.SaveAsync(view.Case);
            following = false;
            await ReloadAsync();
            message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseFollowingMessage, plan.Name);
        }
        finally
        {
            busy = false;
        }
    }

    private void StartLogStep()
    {
        logging = true;
        counting = false;
        following = false;
        message = null;
    }

    private async Task SkipStepAsync(PlanStep step)
    {
        if (view is null)
            return;

        busy = true;
        try
        {
            await Treatments.SaveAsync(PlanProgress.Skip(view.Case, step, Today));
            await ReloadAsync();
            message = Strings.Pests.CaseStepSkippedMessage;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartMove(PlanStep step)
    {
        movingStep = step.Id;
        moveTo = view?.NextDue is { } due && due > Today ? due : Today;
    }

    private void MoveToChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var picked))
            moveTo = picked;
    }

    // Later steps follow on their own, since each counts from the day the one before was done
    private async Task MoveStepAsync(PlanStep step)
    {
        if (view is null)
            return;

        if (moveTo < Today)
        {
            message = Strings.Pests.CaseMoveTooEarly;
            return;
        }

        busy = true;
        try
        {
            await PutOffService.PutOffAsync(PutOffs.PlanStep(view.Case.Id, step.Id), moveTo);
            movingStep = null;
            await ReloadAsync();
            message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Pests.CaseStepMoved, Labels.Date(moveTo));
        }
        finally
        {
            busy = false;
        }
    }

    private async Task StopPlanAsync()
    {
        if (view is null)
            return;

        busy = true;
        try
        {
            view.Case.PlanStoppedOn = Today;
            await Repository.SaveAsync(view.Case);
            confirmStop = false;
            await ReloadAsync();
            message = Strings.Pests.CasePlanStoppedMessage;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        foreach (var treatment in treatments)
            await Treatments.DeleteAsync(treatment.Id);

        await Repository.DeleteAsync(Id);
        Navigation.NavigateTo("pests", replace: true);
    }
}
