@page "/pests/{Id:guid}"
@inject IPestCaseRepository Repository
@inject IPestTreatmentRepository Treatments
@inject IPlantRepository PlantRepository
@inject RoomService RoomService
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@(view is null ? "Pest case" : Labels.For(view.Case.Pest)) · Stikling</PageTitle>
<ReloadOnSync Reload="ReloadAsync" />

<a class="back-link" href="pests">Pests</a>

@if (view is null)
{
    <p class="text-body-secondary">@(loaded ? "That case doesn't exist or was deleted." : "Loading…")</p>
}
else
{
    <header class="detail-header">
        <div class="detail-icon @(view.Case.IsOpen ? "alert" : null)" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
        </div>
        <div class="min-w-0">
            <h1>@Labels.For(view.Case.Pest)</h1>
            <p class="detail-sub">@Labels.Scope(view) · found @Labels.Date(view.Case.StartedOn)</p>
            @if (view.Case.IsOpen)
            {
                <span class="badge stage-badge">@Labels.For(view.Case.Status)</span>
            }
            else
            {
                <span class="badge text-bg-secondary">@Labels.For(view.Case.Status)</span>
            }
        </div>
    </header>

    <div class="detail-actions">
        @if (view.Case.IsOpen)
        {
            <button type="button" class="btn btn-primary" @onclick="ToggleLogging">
                @(logging ? "Close" : view.IsCheck ? "Log check" : "Log treatment")
            </button>
        }
        @if (view.IsCheck)
        {
            @* Pests seen again: back to treating, with the treatment sheet ready *@
            <button type="button" class="btn btn-outline-primary" @onclick="FoundSomeAsync">Found some</button>
        }
        <a class="btn btn-outline-primary" href="pests/@view.Case.Id/edit">Edit</a>
    </div>

    @if (logging && view.Case.IsOpen)
    {
        <section class="detail-card">
            <h2>@(view.IsCheck ? "Log check" : "Log treatment")</h2>
            <TreatmentSheet @key="view.Case.Status" Case="view.Case" Existing="treatments" Check="view.IsCheck"
                            OnLogged="ReloadAsync" OnCancel="() => logging = false" />
        </section>
    }

    <section class="detail-card">
        <dl class="detail-list">
            <dt>Covers</dt>
            <dd>@Labels.ScopeAndCount(view)</dd>

            @if (view.IsCheck)
            {
                <dt>Checking</dt>
                <dd>Every @Labels.Count(PestService.CheckEveryDays, "day")</dd>
            }
            else
            {
                <dt>Treating</dt>
                <dd>Every @Labels.Count(view.Case.IntervalDays, "day")</dd>
            }

            <dt>Next one</dt>
            <dd>
                @if (view.NextDue is { } due && view.DaysUntilDue is { } days)
                {
                    <span class="pest-due @(view.IsDue ? "now" : null)">@Labels.Due(days, view.IsCheck)</span>
                    <text> · @Labels.Date(due)</text>
                }
                else
                {
                    <text>Nothing due, the case is closed.</text>
                }
            </dd>

            <dt>Last one</dt>
            <dd>@(view.Last is { } last ? $"{Labels.Date(last.OccurredOn)} · {What(last)}" : "No treatments yet.")</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(view.Case.Notes))
        {
            <h2>Notes</h2>
            <p class="detail-notes">@view.Case.Notes</p>
        }
    </section>

    @* Its own card rather than a button in the row above, since not every pest ends up on a trap *@
    @if (view.Case.IsOpen || Trapped)
    {
        <section class="detail-card">
            <div class="trap-head">
                <h2>Sticky trap</h2>
                @if (view.Case.IsOpen && !counting)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="StartCounting">Count trap</button>
                }
            </div>

            @if (counting)
            {
                <TrapCountSheet Case="view.Case" OnLogged="CountedAsync" OnCancel="() => counting = false" />
            }
            else if (!Trapped)
            {
                <p class="text-body-secondary mb-0">
                    Thrips, fungus gnats and whitefly end up on a yellow or blue sticky trap. Count it
                    now and then to see whether the treatment is working.
                </p>
            }
            else
            {
                @if (catches.LastOrDefault() is { } latest)
                {
                    <p class="mb-0">@Caught(latest)</p>
                }
                else
                {
                    <p class="text-body-secondary mb-0">A new trap is up. Count it next time you look.</p>
                }

                @if (askTreatAgain && view.IsCheck)
                {
                    @* New ones on the trap while the case is only watched: offer to go back to treating *@
                    <div class="trap-ask">
                        <p>@(catches[^1].Caught == 1 ? "There's a new one" : "There are new ones") on the trap. Start treating again?</p>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="FoundSomeAsync">Treat again</button>
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => askTreatAgain = false">Not now</button>
                    </div>
                }

                @if (catches.Count(c => c.PerWeek is not null) > 1)
                {
                    <TrapChart Catches="catches" />
                }
            }
        </section>
    }

    <section class="detail-card">
        <h2>@(treatments.Any(t => t.Kind != PestTreatmentKind.Treated) ? "Treatments and checks" : "Treatments")</h2>
        @if (treatments.Count == 0)
        {
            <p class="text-body-secondary mb-0">
                Nothing logged yet. Each treatment you log moves the next one along by the interval.
            </p>
        }
        else
        {
            <ul class="care-list">
                @foreach (var treatment in treatments)
                {
                    <li>
                        <div class="care-entry">
                            <span class="care-what">
                                @What(treatment)
                                @if (!string.IsNullOrWhiteSpace(treatment.Notes))
                                {
                                    <span class="text-body-secondary"> · @treatment.Notes</span>
                                }
                            </span>
                            <span class="care-when">@Labels.Date(treatment.OccurredOn)</span>
                        </div>
                        @if (treatment.Ingredients.Count > 0)
                        {
                            @* The recipe as it was that day, not as it is now *@
                            <div class="treatment-recipe">@string.Join(" · ", treatment.Ingredients)</div>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="detail-card">
        <h2>Plants</h2>
        @if (view.Plants.Count == 0)
        {
            <p class="text-body-secondary mb-0">
                @(view.Case.Scope == PestScope.Room
                    ? "Nothing is in that room at the moment."
                    : "No plants are covered at the moment.")
            </p>
        }
        else
        {
            <ul class="family-list">
                @foreach (var plant in view.Plants)
                {
                    <li>
                        <a href="plants/@plant.Id">@plant.DisplayName</a>
                        @if (places.NameOf(plant.PlaceId) is { } location)
                        {
                            <span class="text-body-secondary small"> · @location</span>
                        }
                    </li>
                }
            </ul>
            @if (view.Case.Scope != PestScope.PickedPlants)
            {
                <p class="family-hint">
                    Worked out from where the plants are now, so anything moved in while the case is
                    open is covered too.
                </p>
            }
        }
    </section>

    <section class="danger-zone">
        @if (confirmDelete)
        {
            <p class="mb-2">Delete this case and its treatments? If it is over, mark it resolved instead so what you did is kept.</p>
            <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">Delete</button>
            <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">Cancel</button>
        }
        else
        {
            <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => confirmDelete = true">Delete case</button>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PestCaseView? view;
    private Places places = Places.None;
    private IReadOnlyList<PestTreatment> treatments = [];
    private IReadOnlyList<TrapCatch> catches = [];
    private bool loaded;
    private bool logging;
    private bool counting;
    private bool askTreatAgain;
    private bool confirmDelete;

    private DateOnly Today => Time.Today();

    protected override async Task OnParametersSetAsync()
    {
        confirmDelete = false;
        logging = false;
        counting = false;
        askTreatAgain = false;
        await ReloadAsync();
        loaded = true;
    }

    private async Task ReloadAsync()
    {
        if (await Repository.GetAsync(Id) is not { } item)
        {
            view = null;
            return;
        }

        var all = await Treatments.GetAllAsync();
        treatments = PestService.TreatmentsFor(all, item.Id);
        catches = PestService.Catches(item, all);
        places = await RoomService.GetPlacesAsync();
        view = PestService.Describe(item, await PlantRepository.GetAllAsync(), all, places, Today);
    }

    private bool Trapped => treatments.Any(t => t.Kind == PestTreatmentKind.TrapCount);

    // One sheet open at a time, so the page doesn't grow two forms
    private void ToggleLogging()
    {
        logging = !logging;
        counting = false;
    }

    private void StartCounting()
    {
        counting = true;
        logging = false;
        askTreatAgain = false;
    }

    private async Task CountedAsync()
    {
        counting = false;
        var before = catches.Count;
        await ReloadAsync();

        // Only a count that added a catch can have found anything
        askTreatAgain = catches.Count > before && catches[^1].Caught > 0;
    }

    private static string Caught(TrapCatch latest)
    {
        var text = $"{Labels.Count(latest.Caught, "new one", "new ones")} on the trap in {Labels.Count(latest.Days, "day")}";
        return latest.PerWeek is { } perWeek ? $"{text}, about {Math.Round(perWeek):0} a week." : $"{text}.";
    }

    private static string What(PestTreatment treatment) => treatment switch
    {
        { Kind: PestTreatmentKind.Checked } => "Checked",
        { Kind: PestTreatmentKind.TrapCount, OnTrap: { } onTrap } =>
            $"Counted the trap: {onTrap} on it" + (treatment.NewTrap ? ", then put up a new one" : ""),
        { Kind: PestTreatmentKind.TrapCount } => "Put up a new trap",
        { What: { } what } when !string.IsNullOrWhiteSpace(what) => what,
        _ => "Treated"
    };

    private async Task FoundSomeAsync()
    {
        if (view is null)
            return;

        view.Case.Status = PestCaseStatus.Active;
        await Repository.SaveAsync(view.Case);
        await ReloadAsync();
        askTreatAgain = false;
        counting = false;
        logging = true;
    }

    private async Task DeleteAsync()
    {
        foreach (var treatment in treatments)
            await Treatments.DeleteAsync(treatment.Id);

        await Repository.DeleteAsync(Id);
        Navigation.NavigateTo("pests", replace: true);
    }
}
