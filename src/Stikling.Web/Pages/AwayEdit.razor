@page "/away/new"
@page "/away/{Id:guid}"
@using System.Globalization
@inject AwayService AwayService
@inject ILogger<AwayEdit> Logger
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@(IsNew ? Strings.Care.AwayEditPageTitleNew : Strings.Care.AwayEditPageTitle)</PageTitle>

@* No ReloadOnSync: like other edit pages, nothing changes under someone filling in the form *@

<a class="back-link" href="away">@Strings.Care.AwayTitle</a>
<h1>@(IsNew ? Strings.Care.AwayEditTitleNew : Strings.Care.AwayEditTitle)</h1>

@if (!loaded)
{
    <p class="text-body-secondary">@(notFound ? Strings.Care.AwayEditNotFound : Strings.Care.Loading)</p>
}
else
{
    <EditForm Model="this" OnSubmit="SaveAsync" class="edit-form">
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <fieldset>
            <legend>@Strings.Care.AwayEditWhatItIs</legend>
            <div class="btn-group segmented w-100 mb-3" role="radiogroup" aria-label="@Strings.Care.AwayEditKind">
                @foreach (var (value, label) in kindOptions)
                {
                    var id = $"kind-{value}";
                    <input type="radio" class="btn-check" name="kind" id="@id"
                           checked="@(kind == value)" @onchange="() => kind = value" />
                    <label class="btn btn-outline-primary" for="@id">@label</label>
                }
            </div>

            @if (kind == AwayKind.Away)
            {
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label" for="from">@Strings.Care.AwayEditLeaving</label>
                        <InputDate id="from" class="form-control" @bind-Value="from" @bind-Value:after="FromChanged" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="until">@Strings.Care.AwayEditBackOn</label>
                        <InputDate id="until" class="form-control" @bind-Value="until" @bind-Value:after="UntilChanged" aria-describedby="until-help" />
                    </div>
                </div>
                <div class="form-text" id="until-help">@Strings.Care.AwayEditAsksAgainFrom</div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label" for="from">@Strings.Care.AwayEditFrom</label>
                    <InputDate id="from" class="form-control" @bind-Value="from" />
                </div>
                <div class="form-label" id="for-label">@Strings.Care.AwayEditFor</div>
                <div class="chip-row" role="radiogroup" aria-labelledby="for-label">
                    @foreach (var (value, label) in lengthOptions)
                    {
                        <button type="button" role="radio" class="chip @(length == value ? "picked" : null)"
                                aria-checked="@(length == value ? "true" : "false")" @onclick="() => length = value">@label</button>
                    }
                </div>
                @if (length == QuietLength.Date)
                {
                    <div class="mt-3">
                        <label class="form-label" for="until">@Strings.Care.AwayEditUntil</label>
                        <InputDate id="until" class="form-control" @bind-Value="until" aria-describedby="until-help" />
                    </div>
                }
                <div class="form-text" id="until-help">@string.Format(CultureInfo.CurrentCulture, Strings.Care.AwayEditAsksAgainOn, Stikling.Core.Away.SitterSheetText.LongDay(End))</div>
            }
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@saving">@Strings.Common.Save</button>
            <a class="btn btn-link" href="away">@Strings.Common.Cancel</a>
        </div>
    </EditForm>

    @if (!IsNew)
    {
        <section class="danger-zone">
            @if (confirmDelete)
            {
                <p class="mb-2">@Strings.Care.AwayEditDeleteConfirm</p>
                <button class="btn btn-danger btn-sm" disabled="@saving" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                <button class="btn btn-link btn-sm" @onclick="() => confirmDelete = false">@Strings.Common.Cancel</button>
            }
            else
            {
                <button class="btn btn-link btn-sm text-danger link-action" @onclick="() => confirmDelete = true">@Strings.Common.Delete</button>
            }
        </section>
    }
}

@code {
    private enum QuietLength
    {
        Week,
        TwoWeeks,
        Month,
        Date
    }

    [Parameter]
    public Guid? Id { get; set; }

    private static (AwayKind Value, string Label)[] kindOptions =>
    [
        (AwayKind.Away, Strings.Care.AwayKindAway),
        (AwayKind.Quiet, Strings.Care.AwayKindQuiet)
    ];

    private static (QuietLength Value, string Label)[] lengthOptions =>
    [
        (QuietLength.Week, Strings.Care.AwayEditWeek),
        (QuietLength.TwoWeeks, Strings.Care.AwayEditTwoWeeks),
        (QuietLength.Month, Strings.Care.AwayEditMonth),
        (QuietLength.Date, Strings.Care.AwayEditPickDate)
    ];

    private AwayStretch? stretch;
    private bool loaded;
    private bool notFound;
    private bool saving;
    private bool confirmDelete;
    private bool untilTouched;
    private List<string> errors = [];

    private AwayKind kind = AwayKind.Away;
    private DateOnly from;
    private DateOnly until;
    private QuietLength length = QuietLength.Week;

    private bool IsNew => Id is null;

    private DateOnly Today => Time.Today();

    // The day back: picked for Away, and for Quiet time worked out from the length unless a date is picked
    private DateOnly End => kind == AwayKind.Away || length == QuietLength.Date
        ? until
        : length switch
        {
            QuietLength.Week => from.AddDays(7),
            QuietLength.TwoWeeks => from.AddDays(14),
            _ => from.AddMonths(1)
        };

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        notFound = false;
        if (IsNew)
        {
            stretch = null;
            from = Today;
            until = from.AddDays(7);
            untilTouched = false;
        }
        else
        {
            stretch = (await AwayService.GetAllAsync()).FirstOrDefault(s => s.Id == Id);
            if (stretch is null)
            {
                notFound = true;
                return;
            }

            kind = stretch.Kind;
            from = stretch.From;
            until = stretch.Until;
            untilTouched = true;
            length = stretch.Until == from.AddDays(7) ? QuietLength.Week
                : stretch.Until == from.AddDays(14) ? QuietLength.TwoWeeks
                : stretch.Until == from.AddMonths(1) ? QuietLength.Month
                : QuietLength.Date;
        }

        loaded = true;
    }

    // Back on follows the day of leaving, a week on, until someone has picked it themselves
    private void FromChanged()
    {
        if (IsNew && !untilTouched)
            until = from.AddDays(7);
    }

    private void UntilChanged() => untilTouched = true;

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var end = End;
            if (end <= from)
            {
                errors = [kind == AwayKind.Away ? Strings.Care.AwayEditBackAfterLeave : Strings.Care.AwayEditEndAfterStart];
                return;
            }

            var item = stretch ?? new AwayStretch();
            item.Kind = kind;
            item.From = from;
            item.Until = end;
            await AwayService.SaveAsync(item);
            Navigation.NavigateTo("away");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the away time failed");
            errors = [string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.AwayEditSaveFailed, ex.Message)];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (stretch is null)
            return;

        saving = true;
        try
        {
            await AwayService.DeleteAsync(stretch.Id);
            Navigation.NavigateTo("away");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deleting the away time failed");
            errors = [string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.AwayEditDeleteFailed, ex.Message)];
            confirmDelete = false;
        }
        finally
        {
            saving = false;
        }
    }
}
