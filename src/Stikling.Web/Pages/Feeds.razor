@page "/feeds"
@layout WideLayout
@inject IFeedRepository Repository
@inject FeedService FeedService
@inject IProductRepository ProductRepository

<PageTitle>@Strings.Supplies.FeedsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />
<ShowFound ElementId="@(Show is { } shown ? $"item-{shown}" : null)" />

<a class="back-link" href="supplies">@Strings.Supplies.BackToSupplies</a>
<h1>@Strings.Supplies.FeedsTitle</h1>

<p class="settings-hint">
    @Strings.Supplies.FeedsIntro
</p>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (draft is not null)
{
    <section class="settings-section supply-form">
        <h2>@(editing ? Strings.Supplies.FeedsEdit : Strings.Supplies.FeedsAdd)</h2>

        <div class="mb-3">
            <label class="form-label" for="feed-name">@Strings.Supplies.Name</label>
            <input id="feed-name" class="form-control" placeholder="@Strings.Supplies.FeedsNamePlaceholder" autocomplete="off"
                   value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString()" />
        </div>

        <div class="mb-3">
            <div class="form-label">@Strings.Supplies.FeedsWhatGoesIn</div>

            @if (draft.Products.Count > 0)
            {
                <ol class="feed-rows">
                    @for (var i = 0; i < draft.Products.Count; i++)
                    {
                        var index = i;
                        var dose = draft.Products[index];
                        var id = $"feed-dose-{index}";
                        <li class="feed-row">
                            <label class="feed-product" for="@id">
                                <span class="feed-step">@(index + 1)</span>
                                @NameOf(dose)
                            </label>
                            <div class="feed-tools">
                                <button type="button" class="feed-tool" disabled="@(index == 0)"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsMoveUp, NameOf(dose))"
                                        @onclick="() => draft.MoveUp(index)">▲</button>
                                <button type="button" class="feed-tool" disabled="@(index == draft.Products.Count - 1)"
                                        aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsMoveDown, NameOf(dose))"
                                        @onclick="() => draft.MoveDown(index)">▼</button>
                                <button type="button" class="feed-tool remove" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsRemove, NameOf(dose))"
                                        @onclick="() => draft.Products.RemoveAt(index)"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
                            </div>
                            <DoseInput Id="@id" Unit="dose.Unit"
                                       @bind-Amount="dose.Amount" @bind-Per="dose.Per" @bind-PerUnit="dose.PerUnit" />
                        </li>
                    }
                </ol>

                @if (draft.OrderNote(products) is { } note)
                {
                    <p class="form-text">@note</p>
                }
                else
                {
                    <div class="form-text">@Strings.Supplies.FeedsInOrder</div>
                }
            }

            @if (products.Count == 0)
            {
                <p class="form-text">
                    @((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsNoProducts, ProductsLink))
                </p>
            }
            else if (Addable.Count > 0)
            {
                <div class="chip-row mt-2" role="group" aria-label="@Strings.Supplies.FeedsProductsToAdd">
                    @foreach (var product in Addable)
                    {
                        <button type="button" class="chip" @onclick="() => draft.Products.Add(ProductDose.From(product))">
                            + @product.Name
                            @if (product.NpkText is { } npk)
                            {
                                <span class="chip-note">@npk</span>
                            }
                        </button>
                    }
                </div>
                <div class="form-text">@((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsSomethingMissing, ProductsLink))</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label" for="feed-notes">@Strings.Supplies.Notes</label>
            <textarea id="feed-notes" class="form-control" rows="2" placeholder="@Strings.Supplies.FeedsNotesPlaceholder"
                      @bind="draft.Notes"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">
                @(editing ? Strings.Supplies.SaveChanges : Strings.Supplies.FeedsSubmitAdd)
            </button>
            <button type="button" class="btn btn-link" @onclick="Cancel">@Strings.Common.Cancel</button>
        </div>
    </section>
}
else
{
    <div class="form-actions mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Supplies.FeedsAddButton</button>
    </div>
}

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (uses.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Supplies.FeedsEmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Supplies.FeedsEmptyHint
        </p>
        @if (products.Count == 0)
        {
            <a class="btn btn-outline-primary mt-3" href="products">@Strings.Supplies.FeedsAddProductsFirst</a>
        }
    </div>
}
else
{
    <section class="settings-section">
        <h2>@Strings.Supplies.FeedsYour</h2>

        <ul class="feed-list supply-grid">
            @foreach (var use in uses)
            {
                <li id="item-@use.Feed.Id">
                    @if (confirming == use.Feed.Id)
                    {
                        <div class="feed-confirm">
                            <p>@DeleteWarning(use)</p>
                            <div class="care-actions">
                                <button type="button" class="btn btn-danger btn-sm" disabled="@busy"
                                        @onclick="() => DeleteAsync(use.Feed)">@Strings.Common.Delete</button>
                                <button type="button" class="btn btn-link btn-sm"
                                        @onclick="() => confirming = null">@Strings.Common.Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        var measuring = mixing == use.Feed.Id;
                        <div class="feed-title">@use.Feed.Name</div>
                        <div class="feed-use">
                            @if (use.Plants > 0)
                            {
                                <button type="button" class="btn btn-link btn-sm link-action" aria-expanded="@(showing == use.Feed.Id)"
                                        @onclick="() => TogglePlantsAsync(use.Feed)">@Given(use)</button>
                            }
                            else
                            {
                                @Given(use)
                            }
                        </div>

                        @if (showing == use.Feed.Id)
                        {
                            <ul class="feed-plants">
                                @foreach (var fed in fedPlants)
                                {
                                    <li>
                                        <a href="plants/@fed.Plant.Id">@fed.Plant.DisplayName</a>
                                        @if (!fed.Plant.InCollection)
                                        {
                                            <span class="feed-plant-status">@Labels.StatusOf(fed.Plant)</span>
                                        }
                                        <span class="feed-plant-dates">· @DatesText(fed)</span>
                                    </li>
                                }
                            </ul>
                        }

                        @if (measuring)
                        {
                            var id = $"feed-water-{use.Feed.Id}";
                            <div class="feed-water">
                                <label for="@id">@Strings.Supplies.FeedsWater</label>
                                <WaterInput Id="@id" Placeholder="@Strings.Supplies.FeedsWaterPlaceholder" @bind-Litres="litres" />
                            </div>
                        }

                        <ol class="feed-recipe">
                            @foreach (var dose in use.Feed.Doses(products))
                            {
                                <li>
                                    <span class="feed-recipe-name">@dose.Name</span>
                                    <span class="feed-recipe-dose">@DoseText(dose)</span>
                                    @if (measuring && litres > 0 && dose.For(litres.Value) is { } amount)
                                    {
                                        <span class="feed-measure">@Doses.Measured(amount, dose.Unit)</span>
                                    }
                                </li>
                            }
                        </ol>

                        @if (!string.IsNullOrWhiteSpace(use.Feed.Notes))
                        {
                            <div class="feed-notes">@use.Feed.Notes</div>
                        }

                        <div class="care-actions">
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => ToggleMixing(use.Feed)">@(measuring ? Strings.Common.Done : Strings.Supplies.FeedsMixBatch)</button>
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => StartEdit(use.Feed)">@Strings.Common.Edit</button>
                            <button type="button" class="btn btn-link btn-sm link-action"
                                    @onclick="() => { confirming = use.Feed.Id; mixing = null; }">@Strings.Common.Delete</button>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    /// <summary>An item to scroll to and mark. Set by Search.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public Guid? Show { get; set; }

    private static string ProductsLink => $"<a href=\"products\">{Strings.Supplies.ProductsLink}</a>";

    private IReadOnlyList<FeedUse> uses = [];
    private IReadOnlyList<Product> products = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];

    private Feed? draft;
    private bool editing;
    private Guid? confirming;

    // The feed whose plants are open, and the plants that got it
    private Guid? showing;
    private IReadOnlyList<FeedPlant> fedPlants = [];

    // The feed being measured out, and for how much water. The water is kept between feeds,
    // since it's usually the same watering can.
    private Guid? mixing;
    private decimal? litres;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        products = (await ProductRepository.GetAllAsync())
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        uses = await FeedService.GetAllAsync();
        loading = false;
    }

    /// <summary>The products not in the draft yet, so the same one can't go in twice.</summary>
    private List<Product> Addable =>
        [.. products.Where(p => draft?.Products.Any(d => d.ProductId == p.Id) != true)];

    /// <summary>The product's name as it is now, or the one saved on the feed if it's been deleted.</summary>
    private string NameOf(ProductDose dose) =>
        products.FirstOrDefault(p => p.Id == dose.ProductId)?.Name ?? dose.Name;

    private static string DoseText(ProductDose dose) =>
        dose.Amount is { } amount ? Doses.Text(amount, dose.Unit, dose.Per, dose.PerUnit) : Strings.Supplies.FeedsNoDose;

    /// <summary>"Given to 4 plants, last 12 Sep 2026".</summary>
    private static string Given(FeedUse use) => use.LastUsed is { } last
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsGiven, Labels.Plants(use.Plants), Labels.Date(last))
        : Strings.Supplies.FeedsNotGiven;

    private async Task TogglePlantsAsync(Feed feed)
    {
        if (showing == feed.Id)
        {
            showing = null;
            return;
        }

        fedPlants = await FeedService.GetPlantsAsync(feed.Id);
        showing = feed.Id;
    }

    private static string DatesText(FeedPlant fed)
    {
        var text = string.Join(", ", fed.Dates.Select(Labels.Date));
        return fed.More > 0 ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsDatesMore, text, fed.More) : text;
    }

    private static string DeleteWarning(FeedUse use) => use.Plants == 0
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsDeleteConfirm, use.Feed.Name)
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.FeedsDeleteGiven, use.Feed.Name, Labels.Plants(use.Plants));

    private void ToggleMixing(Feed feed)
    {
        mixing = mixing == feed.Id ? null : feed.Id;
        confirming = null;
    }

    private void StartNew()
    {
        editing = false;
        errors = [];
        confirming = null;
        draft = new Feed();
    }

    private void StartEdit(Feed feed)
    {
        editing = true;
        errors = [];
        confirming = null;
        draft = feed.Copy();
    }

    private void Cancel()
    {
        draft = null;
        editing = false;
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (draft is null)
            return;

        draft.Name = draft.Name?.Trim();
        draft.Notes = string.IsNullOrWhiteSpace(draft.Notes) ? null : draft.Notes.Trim();
        // Saved with the names as they are now, so a feed read on its own still makes sense
        draft.Products = draft.Doses(products);

        errors = draft.Validate().ToList();
        if (errors.Count > 0)
            return;

        busy = true;
        try
        {
            await Repository.SaveAsync(draft);
            await LoadAsync();
            Cancel();
        }
        catch (InvalidOperationException e)
        {
            errors = [e.Message];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(Feed feed)
    {
        busy = true;
        try
        {
            await Repository.DeleteAsync(feed.Id);
            confirming = null;
            if (draft?.Id == feed.Id)
                Cancel();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
