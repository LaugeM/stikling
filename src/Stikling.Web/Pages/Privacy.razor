@page "/privacy"
@* The privacy policy for the live site. Google's, Facebook's and Discord's sign-in and the Help page link here, so it has to
   describe the app and the hosting as they are. Change the date at the top when the content changes. The deploy renders it
   to plain HTML (tools/static-pages/render.cs), so it can be read without running the app. *@
@inject IJSRuntime JS

<PageTitle>@Strings.Account.PrivacyPageTitle</PageTitle>

<a class="back-link" href="settings?section=about">@Strings.Account.PrivacyBack</a>
<h1>@Strings.Account.PrivacyTitle</h1>

<p class="privacy-updated">@Strings.Account.PrivacyUpdated</p>

<p>
        @((MarkupString)Strings.Account.PrivacyIntro)
    </p>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyWithoutHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyWithoutText)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyWithHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyWithOptional)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyWithSignIn)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyWithData)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyWithNotifications)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyGoogleHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyGoogle1)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyGoogle2)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyGoogle3)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyPublicHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyPublic1)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyPublic2)
    </p>
</section>

<section class="privacy-section" id="error-reports">
    <h2>@Strings.Account.PrivacyErrorsHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyErrors1)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyErrors2)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyDoesntHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyDoesntText)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyKeptHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyKept1)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyKept2)
    </p>
    <p>
        @((MarkupString)Strings.Account.PrivacyKept3)
    </p>
</section>

<section class="privacy-section">
    <h2>@Strings.Account.PrivacyRightsHeading</h2>
    <p>
        @((MarkupString)Strings.Account.PrivacyRights)
    </p>
</section>

@code {
    // Settings and Help link to a section, like privacy#error-reports
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
        await module.InvokeVoidAsync("scrollToFragment");
    }
}
