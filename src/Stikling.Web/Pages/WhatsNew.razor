@page "/settings/whats-new"
@* What has changed in the app, written by hand for the people using it, newest first. Add a line to the top of the
   current month when a change is worth telling someone about, and start a new month heading when the month changes.
   Leave out what nobody would notice. No version or pull request numbers. *@

<PageTitle>What's new · Stikling</PageTitle>

<a class="back-link" href="settings">Settings</a>
<h1>What's new</h1>

<p class="whats-new-version">
    @if (AppVersion.Date is { } date)
    {
        <text>You're on version @date.</text>
        @if (AppVersion.Commit is { } commit)
        {
            <text> </text><a class="whats-new-commit" href="https://github.com/LaugeM/stikling/commit/@commit" target="_blank" rel="noopener">(@AppVersion.ShortCommit)</a>
        }
    }
    else
    {
        <text>This is a development build, so it has no version.</text>
    }
</p>

@foreach (var month in Months)
{
    <section class="whats-new-month">
        <h2>@month.Name</h2>
        <ul>
            @foreach (var entry in month.Entries)
            {
                <li>@entry</li>
            }
        </ul>
    </section>
}

