@page "/plants/quick-add"
@inject IPlantRepository Repository
@inject ILogger<QuickAdd> Logger
@inject PlantService PlantService
@inject PlantNameService Names
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@F(Strings.PlantDetail.PageTitle, Strings.Plants.QuickAddTitle)</PageTitle>

<a class="back-link" href="plants/new">@Strings.Common.Back</a>
<h1>@Strings.Plants.QuickAddTitle</h1>

<div class="mb-3">
    <label class="form-label" for="names">@Strings.Plants.QuickAddNames</label>
    <textarea id="names" class="form-control" rows="5" value="@text" @oninput="Typed"
              placeholder="@Strings.Plants.QuickAddPlaceholder"
              autocapitalize="sentences" spellcheck="false"></textarea>
    <div class="form-text">@Strings.Plants.QuickAddHint</div>
</div>

@if (errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in errors)
        {
            <div>@error</div>
        }
    </div>
}

@if (drafts.Count > 0)
{
    <ul class="list-group mb-3">
        @foreach (var draft in drafts)
        {
            var current = draft;
            <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div>@current.DisplayName</div>
                    @if (string.IsNullOrWhiteSpace(current.Nickname) && dictionary.EverydayNames.For(current.Genus, current.Species, current.Cultivar) is { } called)
                    {
                        <div class="form-text mt-0">@called</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(current.Notes))
                    {
                        <div class="form-text mt-0">@current.Notes</div>
                    }
                    @if (PlantMatches.SameName(current, existing).Count > 0)
                    {
                        <div class="form-text mt-0 already-have">@Strings.Plants.QuickAddHaveThis</div>
                    }
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Remove(current)"
                        aria-label="@F(Strings.Plants.QuickAddRemove, current.DisplayName)" title="@Strings.Common.Remove"><svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
            </li>
        }
    </ul>

    <div class="form-actions">
        <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">
            @Plural.Of(drafts.Count, Strings.Plants.QuickAddAdd_One, Strings.Plants.QuickAddAdd_Other)
        </button>
        <a class="btn btn-link" href="plants">@Strings.Common.Cancel</a>
    </div>
}

@code {
    private static string F(string format, params object?[] args) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, format, args);

    private string text = "";
    private PlantDictionary dictionary = PlantDictionary.Empty;
    private IReadOnlyList<Plant> existing = [];
    private List<Plant> drafts = [];
    private List<string> errors = [];
    private bool saving;

    private DateOnly Today => Time.Today();

    protected override async Task OnInitializedAsync()
    {
        dictionary = await Names.GetDictionaryAsync();
        existing = await Repository.GetAllAsync();
    }

    private void Typed(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? "";
        errors = [];
        drafts = Stikling.Core.Plants.QuickAdd.Parse(text, dictionary, LooseDate.Of(Today)).ToList();
    }

    private void Remove(Plant draft) => drafts.Remove(draft);

    private async Task SaveAsync()
    {
        saving = true;
        errors = [];
        try
        {
            foreach (var draft in drafts.ToList())
            {
                await PlantService.CreateAsync(draft);
                drafts.Remove(draft); // so a retry after a failure doesn't add it twice
            }
            Navigation.NavigateTo("plants");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the quick add failed");
            errors = [F(Strings.PlantDetail.CouldntSave, ex.Message)];
        }
        finally
        {
            saving = false;
        }
    }
}
