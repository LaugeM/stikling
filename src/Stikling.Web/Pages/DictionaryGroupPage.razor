@page "/dictionary/group/{Group}"
@layout WideLayout
@using System.Globalization
@inject DictionaryService Dictionary

<PageTitle>@string.Format(CultureInfo.CurrentCulture, Strings.PlantDetail.PageTitle, found is { } shown ? DictionaryLinks.Label(shown) : Strings.Dictionary.Title)</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="@DictionaryLinks.Index">@Strings.Dictionary.Title</a>

@if (browser is null)
{
    <h1>@Strings.Dictionary.Title</h1>
    <p class="text-body-secondary">@Strings.Plants.Loading</p>
}
else if (ReferenceEquals(browser, DictionaryBrowser.Empty))
{
    <h1>@Strings.Dictionary.Title</h1>
    <div class="empty-state mt-3">
        <p>@Strings.Dictionary.CouldNotLoad</p>
    </div>
}
else if (found is not { } group)
{
    <h1>@Strings.Dictionary.Title</h1>
    <div class="empty-state mt-3">
        <p>@Strings.Dictionary.NotFound</p>
        <a class="btn btn-outline-primary mt-3" href="@DictionaryLinks.Index">@Strings.Dictionary.BackToDictionary</a>
    </div>
}
else
{
    var summary = browser.Groups.First(g => g.Group == group);
    var genera = browser.GeneraIn(group);
    var have = genera.Sum(g => owned.Genus(g.Name));
    <h1>@DictionaryLinks.Label(group)</h1>
    <p class="settings-hint mb-3">
        @DictionaryLinks.CountsLine(summary.Genera, summary.Species)@if (have > 0)
        {
            <text> · @string.Format(CultureInfo.CurrentCulture, Strings.Dictionary.YouHaveShort, have)</text>
        }
    </p>

    @if (genera.Count == 0)
    {
        <div class="empty-state">
            <p>@Strings.Dictionary.GroupEmpty</p>
        </div>
    }
    else
    {
        <DictionaryGenusList Genera="genera" Owned="owned" />
    }
}

@code {
    [Parameter]
    public string? Group { get; set; }

    private DictionaryBrowser? browser;
    private OwnedCounts owned = new();
    private DictionaryGroup? found;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        found = Enum.TryParse<DictionaryGroup>(Group, ignoreCase: true, out var group) && Enum.IsDefined(group) ? group : null;
        browser = await Dictionary.GetBrowserAsync();
        owned = await Dictionary.GetOwnedCountsAsync();
    }
}
