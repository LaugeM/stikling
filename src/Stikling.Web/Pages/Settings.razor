@page "/settings"
@layout WideLayout
@implements IDisposable
@using Stikling.Core.Settings
@using Stikling.Core.Sync
@inject ThemeService Theme
@inject LanguageService Language
@inject ErrorReports ErrorReports
@inject RoomService RoomService
@inject IPlantRepository Plants
@inject DeviceFiles Files
@inject SettingsService SettingsService
@inject GooglePhotosService Google
@inject TimeProvider Time
@inject AccountService Account
@inject SyncRunner Sync
@inject NotificationService Notifications
@inject PlantNameService Names
@inject CollectionNumberService Numbering
@inject ExampleService Example
@inject TourService Tour
@inject OwnCareKindService OwnCareKinds
@inject OwnFieldService OwnFieldBook
@inject ICareIntervalRepository CareIntervalRepository
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Strings.Settings.PageTitle</PageTitle>
<ReloadOnSync Reload="LoadDataAsync" />

<h1>@Strings.Settings.Title</h1>

<div class="settings-layout">
    <nav class="settings-nav" aria-label="@Strings.Settings.SectionsNav">
        @foreach (var (id, title) in Sections)
        {
            <a class="settings-nav-link" href="settings?section=@id" aria-current="@(id == OpenSection ? "page" : null)"
               @onclick="() => Open(id)" @onclick:preventDefault>
                <span>@title</span>
                @if (id == "account" && Sync.HasProblem)
                {
                    <span class="settings-nav-dot" aria-hidden="true"></span>
                }
            </a>
        }
    </nav>
    <div class="settings-panes">
        @if (Account.IsAvailable && accountHintRead)
        {
            <section class="settings-group @Closed("account")" id="account">
                <h2>@Strings.Settings.SectionAccount</h2>
                <div class="settings-rows">
                    @if (account is { SignedIn: true })
                    {
                        <SettingsRow Href="account" Title="@account.Email" Detail="@(Sync.HasProblem ? Strings.Settings.SyncNeedsLook : SyncLine)" Alert="@Sync.HasProblem" />
                    }
                    else if (accountChecking)
                    {
                        <SettingsRow Href="account" Title="@Strings.Settings.SectionAccount" Detail="@Strings.Settings.CheckingAccount" />
                    }
                    else if (accountUnreachable)
                    {
                        <SettingsRow Href="account" Title="@Strings.Settings.SectionAccount" Detail="@Strings.Settings.AccountUnreachable" />
                    }
                    else
                    {
                        <SettingsRow Href="sign-in" Title="@Strings.Settings.SignIn" Detail="@Strings.Settings.SignInDetail" />
                    }
                </div>
            </section>
        }

        <section class="settings-group @Closed("look")" id="look">
            <h2>@Strings.Settings.SectionLook</h2>
            @if (Language.Offered.Count > 1)
            {
                <label class="theme-label" for="language">@Strings.Settings.Language</label>
                <select id="language" class="form-select w-auto" @onchange="SetLanguageAsync">
                    @foreach (var language in Language.Offered)
                    {
                        <option value="@language.Code" selected="@(language.Code == Language.Current)">@language.NativeName</option>
                    }
                </select>
                <p class="settings-hint">
                    @Strings.Settings.LanguageRestartHint
                    <a href="https://github.com/LaugeM/stikling/blob/main/docs/dev/translating.md" target="_blank" rel="noopener">@Strings.Settings.HelpTranslate</a>
                </p>
                @if (Translators is { } translators)
                {
                    <p class="settings-hint">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.TranslatedBy, translators)</p>
                }
            }
            <div class="theme-label @(Language.Offered.Count > 1 ? "mt-4" : null)" id="theme-label">@Strings.Settings.Theme</div>
            <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="theme-label">
                @foreach (var option in options)
                {
                    var id = $"theme-{option.Mode.ToString().ToLowerInvariant()}";
                    <input type="radio" class="btn-check" name="theme" id="@id"
                           checked="@(mode == option.Mode)" @onchange="() => SetModeAsync(option.Mode)" />
                    <label class="btn btn-outline-primary" for="@id">@option.Label</label>
                }
            </div>
        </section>

        <section class="settings-group @Closed("care")" id="care">
            <h2>@Strings.Settings.SectionCare</h2>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="photo-reminder"
                       checked="@photoReminder" @onchange="SetPhotoReminderAsync" />
                <label class="form-check-label" for="photo-reminder">@Strings.Settings.PhotoReminder</label>
            </div>
            <p class="settings-hint">
                @Strings.Settings.PhotoReminderHint
            </p>
            <div class="form-check form-switch mt-4">
                <input class="form-check-input" type="checkbox" role="switch" id="watering-reminder"
                       checked="@wateringReminder" @onchange="SetWateringReminderAsync" />
                <label class="form-check-label" for="watering-reminder">@Strings.Settings.WateringReminder</label>
            </div>
            <p class="settings-hint">
                @Strings.Settings.WateringReminderHint
            </p>
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="empty-outer-pot"
                       checked="@(emptyOuterPotMinutes > 0)" @onchange="SetEmptyOuterPotOnAsync" />
                <label class="form-check-label" for="empty-outer-pot">@Strings.Settings.EmptyOuterPot</label>
            </div>
            @if (emptyOuterPotMinutes > 0)
            {
                <div class="input-group mt-2">
                    <span class="input-group-text" id="empty-outer-pot-after">@Strings.Settings.EmptyOuterPotAfter</span>
                    <select id="empty-outer-pot-wait" class="form-select" aria-labelledby="empty-outer-pot-after" @onchange="SetEmptyOuterPotWaitAsync">
                        @foreach (var (minutes, label) in emptyOuterPotWaits)
                        {
                            <option value="@minutes" selected="@(minutes == emptyOuterPotMinutes)">@label</option>
                        }
                    </select>
                </div>
            }
            <p class="settings-hint">
                @Strings.Settings.EmptyOuterPotHint
            </p>
            <div class="settings-rows mt-4">
                <SettingsRow Href="kinds-of-care" Title="@Strings.Settings.KindsOfCare" Detail="@KindsOfCareLine" />
                <SettingsRow Href="care-intervals" Title="@Strings.Settings.CareIntervals" Detail="@CareIntervalsLine" />
                <SettingsRow Href="away" Title="@Strings.Settings.Away" Detail="@Strings.Settings.AwayDetail" />
            </div>
            <div class="form-check form-switch mt-4">
                <input class="form-check-input" type="checkbox" role="switch" id="daily-round"
                       checked="@dailyRound" @onchange="SetDailyRoundAsync" />
                <label class="form-check-label" for="daily-round">@Strings.Settings.DailyRound</label>
            </div>
            <p class="settings-hint">
                @Strings.Settings.DailyRoundHint
            </p>
            <div class="theme-label mt-4" id="round-days-label">@Strings.Settings.RoundDays</div>
            <div class="chip-row" role="group" aria-labelledby="round-days-label">
                @foreach (var day in weekdays)
                {
                    var picked = roundDays.Contains(day);
                    <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                            @onclick="() => ToggleRoundDayAsync(day)">@Labels.DayShort(day)</button>
                }
            </div>
            <p class="settings-hint">
                @Strings.Settings.RoundDaysHint
            </p>
        </section>

        <section class="settings-group @Closed("plants")" id="plants">
            <h2>@Strings.Settings.SectionPlants</h2>
            <div class="theme-label" id="everyday-label">@Strings.Settings.EverydayNames</div>
            <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="everyday-label">
                @foreach (var option in everydayOptions)
                {
                    var id = $"everyday-{option.Language.ToString().ToLowerInvariant()}";
                    <input type="radio" class="btn-check" name="everyday" id="@id"
                           checked="@(everydayLanguage == option.Language)" @onchange="() => SetEverydayLanguageAsync(option.Language)" />
                    <label class="btn btn-outline-primary" for="@id">@option.Label</label>
                }
            </div>
            <p class="settings-hint">
                @((MarkupString)EverydayHint)
            </p>
            @if (Google.IsConfigured)
            {
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="google-photos"
                           checked="@googlePhotos" @onchange="SetGooglePhotosAsync" />
                    <label class="form-check-label" for="google-photos">@Strings.Settings.GooglePhotos</label>
                </div>
                <p class="settings-hint">
                    @Strings.Settings.GooglePhotosHint
                </p>
            }
            <div class="settings-rows mt-4">
                <SettingsRow Href="fields" Title="@Strings.Settings.YourFields" Detail="@OwnFieldsLine" />
            </div>
            <div class="theme-label mt-4" id="recent-changes-label">@Strings.Settings.RecentChanges</div>
            <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="recent-changes-label">
                @foreach (var option in recentChangesOptions)
                {
                    var id = $"recent-changes-{option.Days}";
                    <input type="radio" class="btn-check" name="recent-changes" id="@id"
                           checked="@(recentChangesDays == option.Days)" @onchange="() => SetRecentChangesDaysAsync(option.Days)" />
                    <label class="btn btn-outline-primary" for="@id">@option.Label</label>
                }
            </div>
            <p class="settings-hint">
                @Strings.Settings.RecentChangesHint
            </p>
            <label class="theme-label mt-4" for="pot-up-warn">@Strings.Settings.PotUpWarn</label>
            <div class="input-group">
                <span class="input-group-text">@Strings.Settings.PotUpWarnBefore</span>
                <input id="pot-up-warn" type="number" class="form-control" inputmode="decimal" min="1" max="20" step="0.5"
                       value="@Pot.Size(potUpWarnCm)" @onchange="SetPotUpWarnCmAsync" />
                <span class="input-group-text">@Strings.Settings.PotUpWarnAfter</span>
            </div>
            <p class="settings-hint">
                @Strings.Settings.PotUpWarnHint
            </p>
        </section>

        <section class="settings-group @Closed("notifications")" id="notifications">
            <h2>@Strings.Settings.SectionNotifications</h2>
            @if (!Account.IsAvailable || (accountHintRead && !accountChecking && account is not { SignedIn: true }))
            {
                <p class="settings-hint mt-0">@Strings.Settings.NotifyNeedsAccount</p>
            }
            else if (accountChecking || notifySupport is null)
            {
                <p class="settings-hint mt-0">@Strings.Settings.CheckingAccount</p>
            }
            else if (notifySupport == "needs-home-screen")
            {
                <p class="settings-hint mt-0">@Strings.Settings.NotifyHomeScreen</p>
            }
            else if (notifySupport != "ok")
            {
                <p class="settings-hint mt-0">@Strings.Settings.NotifyUnsupported</p>
            }
            else if (!notifyOn)
            {
                @if (notifyServer == ServerCheck.NotSetUp)
                {
                    <p class="settings-hint mt-0">@Strings.Settings.NotifyNotYet</p>
                }
                else
                {
                    <p class="settings-hint mt-0">@Strings.Settings.NotifyIntro</p>
                    <button type="button" class="btn btn-primary" disabled="@notifyBusy" @onclick="TurnOnNotificationsAsync">@Strings.Settings.NotifyTurnOn</button>
                    @if (notifyMessage is not null)
                    {
                        <p class="settings-hint" role="status">@notifyMessage</p>
                    }
                }
            }
            else
            {
                @if (notifyPermission == "denied")
                {
                    <p class="settings-hint mt-0" role="status">@Strings.Settings.NotifyBlockedAlready</p>
                }
                <label class="theme-label" for="notify-at">@Strings.Settings.NotifyTime</label>
                <select id="notify-at" class="form-select w-auto" @onchange="SetNotifyAtAsync">
                    @foreach (var time in notifyTimes)
                    {
                        <option value="@time.ToString("HH:mm")" selected="@(time == notifyAt)">@time.ToString("HH:mm")</option>
                    }
                </select>
                <div class="theme-label mt-4" id="notify-days-label">@Strings.Settings.NotifyDays</div>
                <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="notify-days-label">
                    @foreach (var option in notifyDayOptions)
                    {
                        if (option.Days == NotifyDays.RoundDays && roundDays.Count == 0 && notifyDaysChoice != NotifyDays.RoundDays)
                        {
                            continue;
                        }

                        var id = $"notify-days-{option.Days.ToString().ToLowerInvariant()}";
                        <input type="radio" class="btn-check" name="notify-days" id="@id"
                               checked="@(notifyDaysChoice == option.Days)" @onchange="() => SetNotifyDaysAsync(option.Days)" />
                        <label class="btn btn-outline-primary" for="@id">@option.Label</label>
                    }
                </div>
                @if (notifyDaysChoice == NotifyDays.Picked)
                {
                    <div class="chip-row mt-3" role="group" aria-label="@Strings.Settings.NotifyDaysGroup">
                        @foreach (var day in weekdays)
                        {
                            var picked = notifyWeekdays.Contains(day);
                            <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                                    @onclick="() => ToggleNotifyWeekdayAsync(day)">@Labels.DayShort(day)</button>
                        }
                    </div>
                    @if (notifyWeekdays.Count == 0)
                    {
                        <p class="settings-hint">@Strings.Settings.NotifyNoDayPicked</p>
                    }
                }
                else if (notifyDaysChoice == NotifyDays.RoundDays)
                {
                    <p class="settings-hint">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.NotifyYourRoundDays, string.Join(", ", roundDays.Select(Labels.DayShort)))</p>
                }
                <p class="settings-hint">
                    @Strings.Settings.NotifyOnHint
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary" disabled="@notifyBusy" @onclick="SendTestNotificationAsync">@Strings.Settings.NotifySendTest</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@notifyBusy" @onclick="TurnOffNotificationsAsync">@Strings.Settings.NotifyTurnOff</button>
                </div>
                @if (notifyMessage is not null)
                {
                    <p class="settings-hint" role="status">@notifyMessage</p>
                }
            }
        </section>

        <section class="settings-group @Closed("pests")" id="pests">
            <h2>@Strings.Settings.SectionPests</h2>
            <div class="theme-label" id="clean-weeks-label">@Strings.Settings.CleanWeeks</div>
            <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="clean-weeks-label">
                @foreach (var weeks in cleanWeeksOptions)
                {
                    var id = $"clean-weeks-{weeks}";
                    <input type="radio" class="btn-check" name="clean-weeks" id="@id"
                           checked="@(cleanWeeks == weeks)" @onchange="() => SetCleanWeeksAsync(weeks)" />
                    <label class="btn btn-outline-primary" for="@id">@Weeks(weeks)</label>
                }
            </div>
            <p class="settings-hint">
                @Strings.Settings.CleanWeeksHint
            </p>
            <div class="theme-label mt-4" id="quarantine-days-label">@Strings.Settings.QuarantineLength</div>
            <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="quarantine-days-label">
                @foreach (var weeks in quarantineWeeksOptions)
                {
                    var id = $"quarantine-days-{weeks}";
                    <input type="radio" class="btn-check" name="quarantine-days" id="@id"
                           checked="@(quarantineDays == weeks * 7)" @onchange="() => SetQuarantineDaysAsync(weeks * 7)" />
                    <label class="btn btn-outline-primary" for="@id">@Weeks(weeks)</label>
                }
            </div>
            <p class="settings-hint">
                @Strings.Settings.QuarantineLengthHint
            </p>
            <div class="form-check form-switch mt-4">
                <input class="form-check-input" type="checkbox" role="switch" id="quarantine-new-plants"
                       checked="@quarantineNewPlants" @onchange="SetQuarantineNewPlantsAsync" />
                <label class="form-check-label" for="quarantine-new-plants">@Strings.Settings.QuarantineNew</label>
            </div>
            <p class="settings-hint">
                @Strings.Settings.QuarantineNewHint
            </p>
        </section>

        <section class="settings-group @Closed("data")" id="data">
            <h2>@Strings.Settings.SectionData</h2>
            <div class="settings-rows">
                <SettingsRow Href="rooms-and-tags" Title="@Strings.Settings.RoomsAndTags" Detail="@RoomsAndTagsLine" />
                <SettingsRow Href="#" Title="@Strings.Settings.CollectionNumbers" Detail="@Strings.Settings.CollectionNumbersDetail" OnClick="OpenNumberingAsync" />
                <SettingsRow Href="backup" Title="@Strings.Settings.BackupAndStorage" Detail="@BackupLine" />
            </div>
            @if (numberingMessage is not null)
            {
                <p class="settings-hint" role="status">@numberingMessage</p>
            }
            <div class="form-check form-switch mt-4">
                <input class="form-check-input" type="checkbox" role="switch" id="error-reports"
                       checked="@(!errorReportsOff)" @onchange="SetErrorReportsAsync" />
                <label class="form-check-label" for="error-reports">@Strings.Settings.ErrorReports</label>
            </div>
            <p class="settings-hint">
                @Strings.Settings.ErrorReportsHint <a href="privacy#error-reports">@Strings.Settings.ErrorReportsLink</a>
            </p>
        </section>

        <section class="settings-group @Closed("about")" id="about">
            <h2>@Strings.Settings.SectionAbout</h2>
            <div class="settings-rows">
                <SettingsRow Href="#" Title="@Strings.Settings.ShowMeAround" Detail="@Strings.Settings.ShowMeAroundDetail" OnClick="StartTourAsync" />
                <SettingsRow Href="help" Title="@Strings.Settings.Help" Detail="@Strings.Settings.HelpDetail" />
                <SettingsRow Href="privacy" Title="@Strings.Settings.Privacy" Detail="@Strings.Settings.PrivacyDetail" />
                <SettingsRow Href="settings/whats-new" Title="@Strings.Settings.WhatsNew" Detail="@AppVersion.Label" />
                <SettingsRow Href="plant-names" Title="@Strings.Settings.PlantNames" Detail="@Strings.Settings.PlantNamesDetail" />
                <SettingsRow Href="https://github.com/LaugeM/stikling" Title="@Strings.Settings.SourceCode" Detail="@Strings.Settings.SourceCodeDetail" External="true" />
            </div>
            @if (tourFailed)
            {
                <p class="text-danger" role="alert">@Strings.Settings.TourFailed</p>
            }
        </section>
    </div>
</div>

<Sheet Title="@Strings.Settings.CollectionNumbers" @bind-Open="numberingOpen">
    @if (numberingPlan is { } plan)
    {
        <p>@plan.Summary</p>
        @if (!plan.IsEmpty)
        {
            <ul class="number-plan">
                @foreach (var item in plan.Plants)
                {
                    <li><span class="number-plan-code">#@item.Code</span> @item.Plant.DisplayName</li>
                }
                @foreach (var item in plan.Cuttings)
                {
                    <li><span class="number-plan-code">#@item.Code</span> @item.Propagation.DisplayName</li>
                }
            </ul>
            <p class="form-text">@Strings.Settings.NumberingHint</p>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-primary" disabled="@numberingBusy" @onclick="NumberThemAsync">@Strings.Settings.NumberThem</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@numberingBusy" @onclick="() => numberingOpen = false">@Strings.Common.Cancel</button>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => numberingOpen = false">@Strings.Common.Close</button>
            </div>
        }
    }
</Sheet>

@code {
    /// <summary>
    /// The names of the people who translated the language the app is in, or null when the translation
    /// still has the placeholder from the English file, or the app is in English.
    /// </summary>
    private static string? Translators =>
        Strings.Settings.Translators is { } names && !string.IsNullOrWhiteSpace(names)
            && names != Strings.Settings.ResourceManager.GetString(nameof(Strings.Settings.Translators), System.Globalization.CultureInfo.InvariantCulture)
            ? names : null;
    private bool numberingOpen;
    private bool numberingBusy;
    private NumberAllPlan? numberingPlan;
    private string? numberingMessage;

    private bool tourFailed;

    // Loads the example if it was removed, then starts the tour on Today
    private async Task StartTourAsync()
    {
        tourFailed = false;
        try
        {
            if (!await Example.IsLoadedAsync())
                await Example.LoadAsync();
        }
        catch
        {
            tourFailed = true;
            return;
        }

        await Tour.StartAsync();
    }

    private async Task OpenNumberingAsync()
    {
        numberingMessage = null;
        numberingPlan = await Numbering.PlanAsync();
        numberingOpen = true;
    }

    private async Task NumberThemAsync()
    {
        if (numberingPlan is null)
            return;
        numberingBusy = true;
        try
        {
            // Planned again from what is stored now, since a sync may have changed the plants while the sheet was open
            var plan = await Numbering.PlanAsync();
            await Numbering.ApplyAsync(plan);
            numberingMessage = (plan.Plants.Count, plan.Cuttings.Count) switch
            {
                (> 0, > 0) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.NumberedBoth,
                    Labels.Plants(plan.Plants.Count), CuttingCount(plan.Cuttings.Count)),
                (> 0, _) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.NumberedPlants, Labels.Plants(plan.Plants.Count)),
                (_, > 0) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.NumberedCuttings, CuttingCount(plan.Cuttings.Count)),
                _ => null
            };
            numberingOpen = false;
        }
        finally
        {
            numberingBusy = false;
        }
    }

    private static string CuttingCount(int count) => Plural.Of(count, Strings.Common.Cutting_One, Strings.Common.Cutting_Other);

    private static string Weeks(int weeks) => Plural.Of(weeks, Strings.Settings.Week_One, Strings.Settings.Week_Other);

    // Read when the page is made, so they follow the language
    private static (ThemeMode Mode, string Label)[] options =>
    [
        (ThemeMode.System, Strings.Settings.ThemeSystem),
        (ThemeMode.Light, Strings.Settings.ThemeLight),
        (ThemeMode.Dark, Strings.Settings.ThemeDark)
    ];

    private static (EverydayNameLanguage Language, string Label)[] everydayOptions =>
    [
        (EverydayNameLanguage.English, Strings.Settings.EverydayEnglish),
        (EverydayNameLanguage.Danish, Strings.Settings.EverydayDanish)
    ];

    private static (int Days, string Label)[] recentChangesOptions =>
    [
        (0, Strings.Common.Off),
        (7, Weeks(1)),
        (14, Weeks(2)),
        (28, Weeks(4))
    ];

    private string EverydayHint => string.Format(System.Globalization.CultureInfo.CurrentCulture, System.Net.WebUtility.HtmlEncode(Strings.Settings.EverydayHint),
        System.Net.WebUtility.HtmlEncode(everydayLanguage == EverydayNameLanguage.Danish ? "Svigermors tunge" : "Snake plant"),
        "<i>Dracaena trifasciata</i>");

    private int recentChangesDays;
    private static readonly int[] cleanWeeksOptions = [2, 4, 6, 8];
    private int cleanWeeks = PestService.DefaultCleanWeeks;
    private static readonly int[] quarantineWeeksOptions = [1, 2, 3, 4];
    private int quarantineDays = Plant.DefaultQuarantineDays;
    private decimal potUpWarnCm = PotSizeChange.DefaultWarnCm;
    private bool quarantineNewPlants;
    private ThemeMode mode;
    private EverydayNameLanguage everydayLanguage;
    private int roomCount;
    private int tagCount;
    private DateOnly? lastBackup;
    private bool photoReminder;
    private bool wateringReminder;
    private int emptyOuterPotMinutes;

    private static (int Minutes, string Label)[] emptyOuterPotWaits =>
        [(15, Strings.Settings.Minutes15), (30, Strings.Settings.Minutes30), (60, Strings.Settings.Hours1), (120, Strings.Settings.Hours2), (180, Strings.Settings.Hours3)];
    private bool dailyRound;
    private AccountState? account;
    private bool accountChecking;
    private bool accountLoadStarted;
    private bool googlePhotos;
    private bool errorReportsOff;
    private bool accountUnreachable;
    private bool accountHintRead;

    protected override async Task OnInitializedAsync()
    {
        Account.Changed += OnAccountChanged;
        Sync.StatusChanged += OnSyncChanged;
        // Clerk is only loaded on a device where someone signed in, so it stays out of the way otherwise
        accountChecking = Account.IsAvailable && await Account.WasSignedInAsync();
        accountHintRead = true;
        lastBackup = await Files.GetLastBackupAsync();
        await LoadDataAsync();
    }

    /// <summary>What comes from the records, which sync can change while the page is open.</summary>
    private async Task LoadDataAsync()
    {
        mode = await Theme.GetModeAsync();
        var settings = await SettingsService.GetAsync();
        photoReminder = settings.PhotoReminder;
        googlePhotos = settings.GooglePhotos;
        errorReportsOff = settings.ErrorReportsOff;
        wateringReminder = settings.WateringReminder;
        emptyOuterPotMinutes = OuterPotReminders.WaitMinutes(settings);
        dailyRound = settings.DailyRound;
        roundDays = [.. settings.RoundDays ?? []];
        notifyAt = settings.NotifyAt ?? new TimeOnly(8, 0);
        notifyDaysChoice = settings.NotifyOn;
        notifyWeekdays = [.. settings.NotifyWeekdays ?? []];
        recentChangesDays = RecentChanges.DaysOf(settings.RecentChangesDays);
