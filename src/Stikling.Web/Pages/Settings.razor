    /// <summary>Which section is open on a wide screen, like notifications. A phone shows them all.</summary>
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private string? scrolledFor;

    /// <summary>The sections that are shown, in order. Account is only there when it can be used.</summary>
    private IEnumerable<(string Id, string Title)> Sections
    {
        get
        {
            if (Account.IsAvailable && accountHintRead)
                yield return ("account", Strings.Settings.SectionAccount);
            yield return ("look", Strings.Settings.SectionLook);
            yield return ("care", Strings.Settings.SectionCare);
            yield return ("plants", Strings.Settings.SectionPlants);
            yield return ("notifications", Strings.Settings.SectionNotifications);
            yield return ("pests", Strings.Settings.SectionPests);
            yield return ("data", Strings.Settings.SectionData);
            yield return ("about", Strings.Settings.SectionAbout);
        }
    }

    // A missing or unknown name opens the first section shown. A link to Account waits for the account check
    // instead of showing Look for a moment first.
    private string OpenSection =>
        Sections.Any(s => s.Id == Section) ? Section!
        : Section == "account" && Account.IsAvailable && !accountHintRead ? "account"
        : Sections.First().Id;

    private string? Closed(string id) => id == OpenSection ? null : "settings-closed";

    private void Open(string id) => Navigation.NavigateTo($"settings?section={id}", replace: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A phone shows every section, so a link to one scrolls to it
        if (accountHintRead && !string.IsNullOrEmpty(Section) && scrolledFor != Section)
        {
            scrolledFor = Section;
            try
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/page.js");
                await module.InvokeVoidAsync("scrollToSectionOnPhone", Section);
            }
            catch (JSException)
            {
                // Not scrolling only leaves the page at the top
            }
        }

        // Once the page is up, so a slow connection doesn't hold the rest of Settings back
        if (!accountChecking || accountLoadStarted)
        {
            // Signed in already (Clerk reported it while this page was open)
            if (!notifyLoadStarted && account is { SignedIn: true })
            {
                await LoadNotificationsAsync();
                StateHasChanged();
            }
            return;
        }

        accountLoadStarted = true;
        try
        {
            account = await Account.LoadAsync();
        }
        catch (AccountUnavailableException)
        {
            accountUnreachable = true;
        }

        accountChecking = false;
        if (account is { SignedIn: true })
            await LoadNotificationsAsync();
        StateHasChanged();
    }

    /// <summary>"Synced at 14:32", for the line under the email.</summary>
    private string SyncLine => (Sync.Running, Sync.LastSynced) switch
    {
        (true, _) => Strings.Settings.Syncing,
        (_, { } at) when at.ToLocalTime().Date == Time.GetLocalNow().Date =>
            string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.SyncedAt, Labels.Time(at)),
        (_, { } at) => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Settings.SyncedOn,
            Labels.Date(DateOnly.FromDateTime(at.ToLocalTime().DateTime))),
        _ => Strings.Settings.NotSynced
    };

    private void OnSyncChanged() => _ = InvokeAsync(StateHasChanged);

    private async void OnAccountChanged(AccountState state)
    {
        // Clerk also reports each renewed token, which changes nothing shown here
        if (state == account)
            return;

        account = state;
        accountUnreachable = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Account.Changed -= OnAccountChanged;
        Sync.StatusChanged -= OnSyncChanged;
    }
