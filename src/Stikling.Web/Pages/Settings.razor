@page "/settings"
@implements IDisposable
@inject ThemeService Theme
@inject RoomService RoomService
@inject PotService PotService
@inject SoilMixService MixService
@inject ProductService ProductService
@inject IFeedRepository FeedRepository
@inject BackupService Backup
@inject DeviceFiles Files
@inject IndexedDb Db
@inject TimeProvider Time

<PageTitle>Settings · Stikling</PageTitle>

<h1>Settings</h1>

<section class="settings-section">
    <h2>Appearance</h2>
    <div class="btn-group w-100" role="radiogroup" aria-label="Theme">
        @foreach (var option in options)
        {
            var id = $"theme-{option.Mode.ToString().ToLowerInvariant()}";
            <input type="radio" class="btn-check" name="theme" id="@id"
                   checked="@(mode == option.Mode)" @onchange="() => SetModeAsync(option.Mode)" />
            <label class="btn btn-outline-primary" for="@id">@option.Label</label>
        }
    </div>
    <p class="settings-hint">"Match system" follows your phone or computer's light/dark setting.</p>
</section>

<section class="settings-section">
    <h2>Rooms</h2>
    <p class="settings-hint">
        Rooms come from where your plants and propagations are. Renaming one here changes it everywhere,
        and renaming it to a name you already use merges the two.
    </p>

    @if (rooms.Count == 0)
    {
        <p class="settings-hint">No rooms yet. They appear as you place plants.</p>
    }
    else
    {
        <ul class="room-list">
            @foreach (var r in rooms)
            {
                <li>
                    @if (renaming == r.Name)
                    {
                        <RoomRenameRow Name="@r.Name" Busy="busy" OnSave="name => RenameAsync(r.Name, name)" OnCancel="StopRenaming" />
                    }
                    else
                    {
                        <div class="room-row">
                            <span class="room-name">@r.Name</span>
                            <span class="room-count">@Held(r.AllPlants, r.AllPropagations)</span>
                            <button type="button" class="btn btn-link btn-sm p-0" disabled="@busy"
                                    @onclick="() => renaming = r.Name">Rename</button>
                        </div>
                    }

                    @foreach (var spot in r.Spots)
                    {
                        <div class="room-spot">
                            @if (renaming == spot.Place)
                            {
                                <RoomRenameRow Name="@spot.Name" Busy="busy"
                                               OnSave="name => RenameAsync(spot.Place, RoomName.Combine(r.Name, name))"
                                               OnCancel="StopRenaming" />
                            }
                            else
                            {
                                <div class="room-row">
                                    <span class="room-name">@spot.Name</span>
                                    <span class="room-count">@Held(spot.Plants, spot.Propagations)</span>
                                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@busy"
                                            @onclick="() => renaming = spot.Place">Rename</button>
                                </div>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @if (roomMessage is not null)
    {
        <p class="settings-message" role="status">@roomMessage</p>
    }
</section>

<section class="settings-section">
    <h2>Pots</h2>
    <p class="settings-hint">
        The pots you own, so a plant can point at one instead of you typing it again. Nursery pots,
        outer pots, and the ones that stand on their own.
    </p>

    <div class="room-row">
        <span class="room-name">@PotSummary</span>
        <a class="btn btn-link btn-sm p-0" href="pots">Manage pots</a>
    </div>
</section>

<section class="settings-section">
    <h2>Soil mixes</h2>
    <p class="settings-hint">
        The mixes you make yourself, saved under a name, so a plant can say what it is actually
        potted in. Amounts are optional.
    </p>

    <div class="room-row">
        <span class="room-name">@MixSummary</span>
        <a class="btn btn-link btn-sm p-0" href="soil-mixes">Manage mixes</a>
    </div>
</section>

<section class="settings-section">
    <h2>Products</h2>
    <p class="settings-hint">
        Your fertilisers, stimulants, silica and the rest, each with the dose you usually use, so
        logging a feed says what went in the water without typing it.
    </p>

    <div class="room-row">
        <span class="room-name">@ProductSummary</span>
        <a class="btn btn-link btn-sm p-0" href="products">Manage products</a>
    </div>
</section>

<section class="settings-section">
    <h2>Feeds</h2>
    <p class="settings-hint">
        The feeds you mix from your products, in the order they go in the water, so logging one is a
        tap and a batch can be measured out for any amount of water.
    </p>

    <div class="room-row">
        <span class="room-name">@FeedSummary</span>
        <a class="btn btn-link btn-sm p-0" href="feeds">Manage feeds</a>
    </div>
</section>


<section class="settings-section">
    <h2>Backup</h2>
    <p class="settings-hint">
        Everything you add stays on this device. A backup is a ZIP file with your plants and photos in it,
        which you can keep in cloud storage or move to another phone.
    </p>

    <div class="settings-actions">
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ExportAsync">Save a backup</button>
        <label class="btn btn-outline-primary @(busy ? "disabled" : null)" for="restore-file">Restore a backup</label>
        <InputFile id="restore-file" class="visually-hidden" accept=".zip" OnChange="ChooseFileAsync" disabled="@busy" />
    </div>

    <p class="settings-hint">
        @if (lastBackup is { } date)
        {
            <text>Last backup: @Labels.Date(date) (@Labels.DaysAgo(TodayDate.DayNumber - date.DayNumber)).</text>
        }
        else
        {
            <text>No backup taken on this device yet.</text>
        }
    </p>

    @if (pending is { } file)
    {
        <div class="confirm-card">
            <p>
                <strong>@file.Name</strong><br />
                Made @Labels.Date(DateOnly.FromDateTime(file.Data.ExportedAt.LocalDateTime)), holding
                @Labels.Plants(file.Data.Counts.Plants), @Labels.Count(file.Data.Counts.Propagations, "propagation"),
                @Labels.Count(file.Data.Counts.Entries, "history entry", "history entries"),
                @Labels.Count(file.Data.Counts.Photos, "photo"),
                @Labels.Count(file.Data.Counts.CareEntries, "care entry", "care entries"),
                @Labels.Count(file.Data.Counts.PestCases, "pest case"),
                @Labels.Count(file.Data.Counts.Pots, "pot"),
                @Labels.Count(file.Data.Counts.SoilMixes, "soil mix", "soil mixes"),
                @Labels.Count(file.Data.Counts.Products, "product") and
                @Labels.Count(file.Data.Counts.Feeds, "feed").
            </p>
            <p class="settings-hint">
                Restoring adds what's missing here and brings back anything you've deleted since.
                Changes you've made on this device are kept.
            </p>
            <div class="settings-actions">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="RestoreAsync">Restore</button>
                <button type="button" class="btn btn-link" @onclick="() => pending = null">Cancel</button>
            </div>
        </div>
    }

    @if (message is not null)
    {
        <p class="settings-message" role="status">@message</p>
    }
</section>

<section class="settings-section">
    <h2>Storage</h2>
    @if (storage is { } estimate)
    {
        <p class="settings-hint">
            Stikling is using @Labels.Bytes(estimate.Usage)@(estimate.Quota > 0 ? $" of the roughly {Labels.Bytes(estimate.Quota)} this browser offers" : "").
        </p>
        @if (estimate.Persisted)
        {
            <p class="settings-hint">The browser has been asked to keep your data and agreed. It won't be cleared when space runs low.</p>
        }
        else
        {
            <p class="settings-hint">
                The browser may clear your data if the device runs low on space. Installing Stikling to the home screen usually
                settles this, and you can ask directly:
            </p>
            <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="RequestPersistenceAsync">Ask to keep my data</button>
        }
    }
    else
    {
        <p class="settings-hint">This browser doesn't say how much space is in use.</p>
    }
</section>

@code {
    private static readonly (ThemeMode Mode, string Label)[] options =
    [
        (ThemeMode.System, "Match system"),
        (ThemeMode.Light, "Light"),
        (ThemeMode.Dark, "Dark")
    ];

    /// <summary>A chosen file, read and described, waiting for the restore to be confirmed.</summary>
    private sealed record PendingRestore(string Name, BackupData Data, MemoryStream Zip);

    private ThemeMode mode;
    private IReadOnlyList<Room> rooms = [];
    private IReadOnlyList<PotUse> pots = [];
    private IReadOnlyList<MixUse> mixes = [];
    private IReadOnlyList<ProductUse> products = [];
    private int feeds;
    private string? renaming; // the whole place being renamed, e.g. "Living room / On top of the PC"
    private string? roomMessage;
    private DateOnly? lastBackup;
    private StorageEstimate? storage;
    private PendingRestore? pending;
    private string? message;
    private bool busy;

    private DateOnly TodayDate => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;
        mode = await Theme.GetModeAsync();
        lastBackup = await Files.GetLastBackupAsync();
        storage = await Db.EstimateAsync();
        rooms = await RoomService.GetAllAsync();
        pots = await PotService.GetAllAsync();
        mixes = await MixService.GetAllAsync();
        products = await ProductService.GetAllAsync();
        feeds = (await FeedRepository.GetAllAsync()).Count;
    }

    /// <summary>"6 pots, 2 free", for the line linking to the pot library.</summary>
    private string PotSummary =>
        pots.Count == 0
            ? "No pots registered yet"
            : $"{Labels.Count(pots.Sum(p => p.Owned), "pot")}, {pots.Sum(p => p.Free)} free";

    /// <summary>"3 mixes, 1 no longer made", for the line linking to the soil mixes.</summary>
    private string MixSummary => mixes.Count switch
    {
        0 => "No mixes saved yet",
        _ when mixes.Any(m => m.Mix.IsRetired) =>
            $"{Labels.Count(mixes.Count, "mix", "mixes")}, {mixes.Count(m => m.Mix.IsRetired)} no longer mixed",
        var count => Labels.Count(count, "mix", "mixes")
    };

    /// <summary>"2 products", for the line linking to the products.</summary>
    private string ProductSummary =>
        products.Count == 0 ? "No products saved yet" : Labels.Count(products.Count, "product");

    /// <summary>"2 feeds", for the line linking to the feeds.</summary>
    private string FeedSummary => feeds == 0 ? "No feeds saved yet" : Labels.Count(feeds, "feed");

    /// <summary>"3 plants, 1 propagation", for the line under a room.</summary>
    private static string Held(int plants, int propagations) => (plants, propagations) switch
    {
        (0, 0) => "empty",
        (_, 0) => Labels.Plants(plants),
        (0, _) => Labels.Count(propagations, "propagation"),
        _ => $"{Labels.Plants(plants)}, {Labels.Count(propagations, "propagation")}"
    };

    private void StopRenaming()
    {
        renaming = null;
        roomMessage = null;
    }

    private async Task RenameAsync(string from, string? to)
    {
        busy = true;
        try
        {
            var result = await RoomService.RenameAsync(from, to);
            rooms = await RoomService.GetAllAsync();
            roomMessage = (result.Total, result.Merged) switch
            {
                (0, _) => $"Nothing was in {from}, so there was nothing to rename.",
                (_, true) => $"{Held(result.Plants, result.Propagations)} moved into {result.Name}, which you were already using.",
                _ => $"Renamed to {result.Name}, with {Held(result.Plants, result.Propagations)} in it."
            };
            renaming = null;
        }
        catch (Exception ex)
        {
            roomMessage = $"Couldn't rename: {ex.Message}";
        }

        busy = false;
    }

    private async Task SetModeAsync(ThemeMode newMode)
    {
        mode = newMode;
        await Theme.SetModeAsync(newMode);
    }

    // Keeps the selection in sync when the header toggle is used
    private async void OnThemeChanged()
    {
        mode = await Theme.GetModeAsync();
        StateHasChanged();
    }

    private async Task ExportAsync()
    {
        busy = true;
        message = "Packing your plants and photos…";
        StateHasChanged();

        try
        {
            var counts = await Backup.ExportAsync();
            lastBackup = TodayDate;
            message = $"Saved a backup with {Labels.Plants(counts.Plants)}, {Labels.Count(counts.Propagations, "propagation")} "
                + $"and {Labels.Count(counts.Photos, "photo")}. Check your downloads.";
        }
        catch (Exception ex)
        {
            message = $"Couldn't save the backup: {ex.Message}";
        }

        storage = await Db.EstimateAsync();
        busy = false;
    }

    private async Task ChooseFileAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        message = "Reading the backup…";
        pending = null;
        StateHasChanged();

        try
        {
            var file = e.File;
            var zip = new MemoryStream();
            // 512 MB is far more than a phone-sized collection needs
            await using (var stream = file.OpenReadStream(512L * 1024 * 1024))
                await stream.CopyToAsync(zip);

            zip.Position = 0;
            pending = new PendingRestore(file.Name, await BackupService.ReadAsync(zip), zip);
            message = null;
        }
        catch (Exception ex)
        {
            message = $"Couldn't read that file: {ex.Message}";
        }

        busy = false;
    }

    private async Task RestoreAsync()
    {
        if (pending is not { } file)
            return;

        busy = true;
        message = "Restoring…";
        StateHasChanged();

        try
        {
            file.Zip.Position = 0;
            var summary = await Backup.ImportAsync(file.Zip);
            message = summary.ChangedAnything
                ? $"Restored {Labels.Count(summary.Added, "new item")} and {summary.Updated} updated, including {Labels.Count(summary.Photos, "photo")}."
                    + (summary.BroughtBack > 0 ? $" {Labels.Count(summary.BroughtBack, "item")} deleted here came back." : "")
                    + (summary.Kept > 0 ? $" {Labels.Count(summary.Kept, "item")} here {(summary.Kept == 1 ? "was" : "were")} already up to date." : "")
                : "Everything in that backup was already here.";
        }
        catch (Exception ex)
        {
            message = $"Couldn't restore: {ex.Message}";
        }

        await file.Zip.DisposeAsync();
        pending = null;
        storage = await Db.EstimateAsync();
        busy = false;
    }

    private async Task RequestPersistenceAsync()
    {
        busy = true;
        var granted = await Db.RequestPersistenceAsync();
        message = granted
            ? "The browser agreed to keep your data."
            : "The browser said no for now. Installing Stikling to the home screen usually changes that.";
        storage = await Db.EstimateAsync();
        busy = false;
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        pending?.Zip.Dispose();
    }
}
