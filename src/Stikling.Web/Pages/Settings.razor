@page "/settings"
@implements IDisposable
@using Stikling.Core.Settings
@using Stikling.Core.Sync
@inject ThemeService Theme
@inject ErrorReports ErrorReports
@inject RoomService RoomService
@inject IPlantRepository Plants
@inject DeviceFiles Files
@inject SettingsService SettingsService
@inject GooglePhotosService Google
@inject TimeProvider Time
@inject AccountService Account
@inject SyncRunner Sync
@inject NotificationService Notifications
@inject PlantNameService Names
@inject CollectionNumberService Numbering
@inject OwnCareKindService OwnCareKinds
@inject OwnFieldService OwnFieldBook
@inject ICareIntervalRepository CareIntervalRepository

<PageTitle>Settings · Stikling</PageTitle>
<ReloadOnSync Reload="LoadDataAsync" />

<h1>Settings</h1>

@if (Account.IsAvailable && accountHintRead)
{
    <section class="settings-group">
        <h2>Account</h2>
        <div class="settings-rows">
            @if (account is { SignedIn: true })
            {
                <SettingsRow Href="account" Title="@account.Email" Detail="@(Sync.HasProblem ? "Sync needs a look. Tap to see why." : SyncLine)" Alert="@Sync.HasProblem" />
            }
            else if (accountChecking)
            {
                <SettingsRow Href="account" Title="Account" Detail="Checking your account…" />
            }
            else if (accountUnreachable)
            {
                <SettingsRow Href="account" Title="Account" Detail="Can't reach the sign-in service right now" />
            }
            else
            {
                <SettingsRow Href="sign-in" Title="Sign in" Detail="Keep your plants the same on all your devices" />
            }
        </div>
    </section>
}

<section class="settings-group">
    <h2>App</h2>
    <div class="theme-label" id="theme-label">Theme</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="theme-label">
        @foreach (var option in options)
        {
            var id = $"theme-{option.Mode.ToString().ToLowerInvariant()}";
            <input type="radio" class="btn-check" name="theme" id="@id"
                   checked="@(mode == option.Mode)" @onchange="() => SetModeAsync(option.Mode)" />
            <label class="btn btn-outline-primary" for="@id">@option.Label</label>
        }
    </div>
    <div class="theme-label mt-4" id="everyday-label">Everyday names</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="everyday-label">
        @foreach (var option in everydayOptions)
        {
            var id = $"everyday-{option.Language.ToString().ToLowerInvariant()}";
            <input type="radio" class="btn-check" name="everyday" id="@id"
                   checked="@(everydayLanguage == option.Language)" @onchange="() => SetEverydayLanguageAsync(option.Language)" />
            <label class="btn btn-outline-primary" for="@id">@option.Label</label>
        }
    </div>
    <p class="settings-hint">
        A plant with no nickname shows what it's called under its botanical name, like @(everydayLanguage == EverydayNameLanguage.Danish ? "Svigermors tunge" : "Snake plant") for <i>Dracaena trifasciata</i>.
    </p>
    <div class="form-check form-switch mt-4">
        <input class="form-check-input" type="checkbox" role="switch" id="photo-reminder"
               checked="@photoReminder" @onchange="SetPhotoReminderAsync" />
        <label class="form-check-label" for="photo-reminder">Monthly photo reminder</label>
    </div>
    <p class="settings-hint">
        Once a month, Today lists what hasn't had a photo yet that month.
    </p>
    @if (Google.IsConfigured)
    {
        <div class="form-check form-switch mt-4">
            <input class="form-check-input" type="checkbox" role="switch" id="google-photos"
                   checked="@googlePhotos" @onchange="SetGooglePhotosAsync" />
            <label class="form-check-label" for="google-photos">Pick from Google Photos</label>
        </div>
        <p class="settings-hint">
            Adds a Google Photos choice next to the phone's gallery, for photos that are only in the cloud. Google asks you to allow it the first time, and again after an hour.
        </p>
    }
    <div class="form-check form-switch mt-4">
        <input class="form-check-input" type="checkbox" role="switch" id="watering-reminder"
               checked="@wateringReminder" @onchange="SetWateringReminderAsync" />
        <label class="form-check-label" for="watering-reminder">Watering reminder</label>
    </div>
    <p class="settings-hint">
        Learns how often each plant gets water and asks you to check it when it's probably dry. It says nothing about a plant until it has seen a few waterings.
    </p>
    <div class="settings-rows mt-4">
        <SettingsRow Href="kinds-of-care" Title="Kinds of care" Detail="@KindsOfCareLine" />
        <SettingsRow Href="fields" Title="Your fields" Detail="@OwnFieldsLine" />
        <SettingsRow Href="care-intervals" Title="Care intervals" Detail="@CareIntervalsLine" />
        <SettingsRow Href="away" Title="Away and quiet time" Detail="Today stops asking while you're away or taking a break" />
    </div>
    <div class="form-check form-switch mt-4">
        <input class="form-check-input" type="checkbox" role="switch" id="daily-round"
               checked="@dailyRound" @onchange="SetDailyRoundAsync" />
        <label class="form-check-label" for="daily-round">Daily round</label>
    </div>
    <p class="settings-hint">
        Today suggests one room a day to go round.
    </p>
    <div class="theme-label mt-4" id="round-days-label">Round days</div>
    <div class="chip-row" role="group" aria-labelledby="round-days-label">
        @foreach (var day in weekdays)
        {
            var picked = roundDays.Contains(day);
            <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                    @onclick="() => ToggleRoundDayAsync(day)">@day.ToString()[..3]</button>
        }
    </div>
    <p class="settings-hint">
        Plants due for a check come up on your round day before, instead of each on its own day. A plant that dries out faster than the time between round days keeps its own days.
    </p>
    <div class="theme-label mt-4" id="recent-changes-label">Recent changes on a plant</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="recent-changes-label">
        @foreach (var option in recentChangesOptions)
        {
            var id = $"recent-changes-{option.Days}";
            <input type="radio" class="btn-check" name="recent-changes" id="@id"
                   checked="@(recentChangesDays == option.Days)" @onchange="() => SetRecentChangesDaysAsync(option.Days)" />
            <label class="btn btn-outline-primary" for="@id">@option.Label</label>
        }
    </div>
    <p class="settings-hint">
        Under a plant's name, what happened lately: when it arrived, was repotted or moved.
    </p>
    <label class="theme-label mt-4" for="pot-up-warn">Say when a new pot is much bigger</label>
    <div class="input-group">
        <span class="input-group-text">more than</span>
        <input id="pot-up-warn" type="number" class="form-control" inputmode="decimal" min="1" max="20" step="0.5"
               value="@Pot.Size(potUpWarnCm)" @onchange="SetPotUpWarnCmAsync" />
        <span class="input-group-text">cm wider</span>
    </div>
    <p class="settings-hint">
        When you pick a new pot for a plant or a cutting, a note says if it is this much wider across the top than the old one. A wide pot keeps the soil wet longer.
    </p>
</section>

<section class="settings-group">
    <h2>Notifications</h2>
    @if (!Account.IsAvailable || (accountHintRead && !accountChecking && account is not { SignedIn: true }))
    {
        <p class="settings-hint mt-0">A daily list of what Today asks for. It needs an account, since the server sends it.</p>
    }
    else if (accountChecking || notifySupport is null)
    {
        <p class="settings-hint mt-0">Checking your account…</p>
    }
    else if (notifySupport == "needs-home-screen")
    {
        <p class="settings-hint mt-0">On iPhone and iPad, add Stikling to your home screen first: tap Share, then Add to Home Screen. Open it from there and turn notifications on here.</p>
    }
    else if (notifySupport != "ok")
    {
        <p class="settings-hint mt-0">This browser can't show notifications from websites.</p>
    }
    else if (!notifyOn)
    {
        @if (notifyServer == ServerCheck.NotSetUp)
        {
            <p class="settings-hint mt-0">Notifications aren't available yet.</p>
        }
        else
        {
            <p class="settings-hint mt-0">One notification a day with what Today asks for, never a reminder to water. Each device is turned on by itself.</p>
            <button type="button" class="btn btn-primary" disabled="@notifyBusy" @onclick="TurnOnNotificationsAsync">Turn on</button>
            @if (notifyMessage is not null)
            {
                <p class="settings-hint" role="status">@notifyMessage</p>
            }
        }
    }
    else
    {
        @if (notifyPermission == "denied")
        {
            <p class="settings-hint mt-0" role="status">Notifications are blocked for stikling.app in this browser. Allow them in the site settings (the icon next to the address), then turn them off and on again here.</p>
        }
        <label class="theme-label" for="notify-at">Time</label>
        <select id="notify-at" class="form-select w-auto" @onchange="SetNotifyAtAsync">
            @foreach (var time in notifyTimes)
            {
                <option value="@time.ToString("HH:mm")" selected="@(time == notifyAt)">@time.ToString("HH:mm")</option>
            }
        </select>
        <div class="theme-label mt-4" id="notify-days-label">Days</div>
        <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="notify-days-label">
            @foreach (var option in notifyDayOptions)
            {
                if (option.Days == NotifyDays.RoundDays && roundDays.Count == 0 && notifyDaysChoice != NotifyDays.RoundDays)
                {
                    continue;
                }

                var id = $"notify-days-{option.Days.ToString().ToLowerInvariant()}";
                <input type="radio" class="btn-check" name="notify-days" id="@id"
                       checked="@(notifyDaysChoice == option.Days)" @onchange="() => SetNotifyDaysAsync(option.Days)" />
                <label class="btn btn-outline-primary" for="@id">@option.Label</label>
            }
        </div>
        @if (notifyDaysChoice == NotifyDays.Picked)
        {
            <div class="chip-row mt-3" role="group" aria-label="Days to get a notification">
                @foreach (var day in weekdays)
                {
                    var picked = notifyWeekdays.Contains(day);
                    <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                            @onclick="() => ToggleNotifyWeekdayAsync(day)">@day.ToString()[..3]</button>
                }
            </div>
            @if (notifyWeekdays.Count == 0)
            {
                <p class="settings-hint">With no day picked, nothing is sent.</p>
            }
        }
        else if (notifyDaysChoice == NotifyDays.RoundDays)
        {
            <p class="settings-hint">Your round days: @string.Join(", ", roundDays.Select(d => d.ToString()[..3])).</p>
        }
        <p class="settings-hint">
            One notification a day with what Today asks for, never a reminder to water. The time and days are yours on every device. This device is on.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" disabled="@notifyBusy" @onclick="SendTestNotificationAsync">Send a test</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@notifyBusy" @onclick="TurnOffNotificationsAsync">Turn off</button>
        </div>
        @if (notifyMessage is not null)
        {
            <p class="settings-hint" role="status">@notifyMessage</p>
        }
    }
</section>

<section class="settings-group">
    <h2>Pests</h2>
    <div class="theme-label" id="clean-weeks-label">Clean before a case can be resolved</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="clean-weeks-label">
        @foreach (var weeks in cleanWeeksOptions)
        {
            var id = $"clean-weeks-{weeks}";
            <input type="radio" class="btn-check" name="clean-weeks" id="@id"
                   checked="@(cleanWeeks == weeks)" @onchange="() => SetCleanWeeksAsync(weeks)" />
            <label class="btn btn-outline-primary" for="@id">@Labels.Count(weeks, "week")</label>
        }
    </div>
    <p class="settings-hint">
        A case being watched counts the days since its last treatment. Finding pests again starts the count over.
    </p>
    <div class="theme-label mt-4" id="quarantine-days-label">Quarantine length</div>
    <div class="btn-group segmented w-100" role="radiogroup" aria-labelledby="quarantine-days-label">
        @foreach (var weeks in quarantineWeeksOptions)
        {
            var id = $"quarantine-days-{weeks}";
            <input type="radio" class="btn-check" name="quarantine-days" id="@id"
                   checked="@(quarantineDays == weeks * 7)" @onchange="() => SetQuarantineDaysAsync(weeks * 7)" />
            <label class="btn btn-outline-primary" for="@id">@Labels.Count(weeks, "week")</label>
        }
    </div>
    <p class="settings-hint">
        How long a plant is kept apart when it goes into quarantine. You can change it for each plant.
    </p>
    <div class="form-check form-switch mt-4">
        <input class="form-check-input" type="checkbox" role="switch" id="quarantine-new-plants"
               checked="@quarantineNewPlants" @onchange="SetQuarantineNewPlantsAsync" />
        <label class="form-check-label" for="quarantine-new-plants">Quarantine new plants</label>
    </div>
    <p class="settings-hint">
        A plant you add that was bought, swapped or a gift starts in quarantine. You can untick it on the form.
    </p>
</section>

<section class="settings-group">
    <h2>Your data</h2>
    <div class="settings-rows">
        <SettingsRow Href="rooms-and-tags" Title="Rooms and tags" Detail="@RoomsAndTagsLine" />
        <SettingsRow Href="#" Title="Collection numbers" Detail="Number the plants you have, oldest first." OnClick="OpenNumberingAsync" />
        <SettingsRow Href="backup" Title="Backup and storage" Detail="@BackupLine" />
    </div>
    @if (numberingMessage is not null)
    {
        <p class="settings-hint" role="status">@numberingMessage</p>
    }
    <div class="form-check form-switch mt-4">
        <input class="form-check-input" type="checkbox" role="switch" id="error-reports"
               checked="@(!errorReportsOff)" @onchange="SetErrorReportsAsync" />
        <label class="form-check-label" for="error-reports">Send error reports</label>
    </div>
    <p class="settings-hint">
        When something goes wrong, the app sends a report of what failed so it can be fixed. It never has your plants, notes or photos. <a href="privacy#error-reports">What's in a report</a>
    </p>
</section>

<section class="settings-group">
    <h2>About</h2>
    <div class="settings-rows">
        <SettingsRow Href="help" Title="Help" Detail="How Stikling works" />
        <SettingsRow Href="privacy" Title="Privacy" Detail="What is kept and where" />
        <SettingsRow Href="settings/whats-new" Title="What's new" Detail="@AppVersion.Label" />
        <SettingsRow Href="plant-names" Title="Plant names" Detail="Where the name suggestions come from" />
        <SettingsRow Href="https://github.com/LaugeM/stikling" Title="Source code" Detail="Stikling is open source, on GitHub" External="true" />
    </div>
</section>

<Sheet Title="Collection numbers" @bind-Open="numberingOpen">
    @if (numberingPlan is { } plan)
    {
        <p>@plan.Summary</p>
        @if (!plan.IsEmpty)
        {
            <ul class="number-plan">
                @foreach (var item in plan.Plants)
                {
                    <li><span class="number-plan-code">#@item.Code</span> @item.Plant.DisplayName</li>
                }
                @foreach (var item in plan.Cuttings)
                {
                    <li><span class="number-plan-code">#@item.Code</span> @item.Propagation.DisplayName</li>
                }
            </ul>
            <p class="form-text">Nothing already numbered is changed, and you can edit any number afterwards.</p>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-primary" disabled="@numberingBusy" @onclick="NumberThemAsync">Number them</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@numberingBusy" @onclick="() => numberingOpen = false">Cancel</button>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => numberingOpen = false">Close</button>
            </div>
        }
    }
</Sheet>

@code {
    private bool numberingOpen;
    private bool numberingBusy;
    private NumberAllPlan? numberingPlan;
    private string? numberingMessage;

    private async Task OpenNumberingAsync()
    {
        numberingMessage = null;
        numberingPlan = await Numbering.PlanAsync();
        numberingOpen = true;
    }

    private async Task NumberThemAsync()
    {
        if (numberingPlan is null)
            return;
        numberingBusy = true;
        try
        {
            // Planned again from what is stored now, since a sync may have changed the plants while the sheet was open
            var plan = await Numbering.PlanAsync();
            await Numbering.ApplyAsync(plan);
            var parts = new List<string>();
            if (plan.Plants.Count > 0)
                parts.Add($"Numbered {Labels.Plants(plan.Plants.Count)}");
            if (plan.Cuttings.Count > 0)
                parts.Add($"{(parts.Count == 0 ? "Gave" : "gave")} {Labels.Count(plan.Cuttings.Count, "cutting")} a letter");
            numberingMessage = string.Join(" and ", parts) + ".";
            numberingOpen = false;
        }
        finally
        {
            numberingBusy = false;
        }
    }

    private static readonly (ThemeMode Mode, string Label)[] options =
    [
        (ThemeMode.System, "Match system"),
        (ThemeMode.Light, "Light"),
        (ThemeMode.Dark, "Dark")
    ];

    private static readonly (EverydayNameLanguage Language, string Label)[] everydayOptions =
    [
        (EverydayNameLanguage.English, "English"),
        (EverydayNameLanguage.Danish, "Danish")
    ];

    private static readonly (int Days, string Label)[] recentChangesOptions =
    [
        (0, "Off"),
        (7, "1 week"),
        (14, "2 weeks"),
        (28, "4 weeks")
    ];

    private int recentChangesDays;
    private static readonly int[] cleanWeeksOptions = [2, 4, 6, 8];
    private int cleanWeeks = PestService.DefaultCleanWeeks;
    private static readonly int[] quarantineWeeksOptions = [1, 2, 3, 4];
    private int quarantineDays = Plant.DefaultQuarantineDays;
    private decimal potUpWarnCm = PotSizeChange.DefaultWarnCm;
    private bool quarantineNewPlants;
    private ThemeMode mode;
    private EverydayNameLanguage everydayLanguage;
    private int roomCount;
    private int tagCount;
    private DateOnly? lastBackup;
    private bool photoReminder;
    private bool wateringReminder;
    private bool dailyRound;
    private AccountState? account;
    private bool accountChecking;
    private bool accountLoadStarted;
    private bool googlePhotos;
    private bool errorReportsOff;
    private bool accountUnreachable;
    private bool accountHintRead;

    protected override async Task OnInitializedAsync()
    {
        Account.Changed += OnAccountChanged;
        Sync.StatusChanged += OnSyncChanged;
        // Clerk is only loaded on a device where someone signed in, so it stays out of the way otherwise
        accountChecking = Account.IsAvailable && await Account.WasSignedInAsync();
        accountHintRead = true;
        lastBackup = await Files.GetLastBackupAsync();
        await LoadDataAsync();
    }

    /// <summary>What comes from the records, which sync can change while the page is open.</summary>
    private async Task LoadDataAsync()
    {
        mode = await Theme.GetModeAsync();
        var settings = await SettingsService.GetAsync();
        photoReminder = settings.PhotoReminder;
        googlePhotos = settings.GooglePhotos;
        errorReportsOff = settings.ErrorReportsOff;
        wateringReminder = settings.WateringReminder;
        dailyRound = settings.DailyRound;
        roundDays = [.. settings.RoundDays ?? []];
        notifyAt = settings.NotifyAt ?? new TimeOnly(8, 0);
        notifyDaysChoice = settings.NotifyOn;
        notifyWeekdays = [.. settings.NotifyWeekdays ?? []];
        recentChangesDays = RecentChanges.DaysOf(settings.RecentChangesDays);
        cleanWeeks = settings.CleanWeeks ?? PestService.DefaultCleanWeeks;
        quarantineDays = settings.QuarantineDays ?? Plant.DefaultQuarantineDays;
        potUpWarnCm = PotSizeChange.WarnLimit(settings);
        quarantineNewPlants = settings.QuarantineNewPlants;
        everydayLanguage = await Names.GetEverydayLanguageAsync();
        roomCount = (await RoomService.GetAllAsync()).Count;
        tagCount = PlantTags.InUse(await Plants.GetAllAsync()).Count;
        ownKindCount = (await OwnCareKinds.GetAllAsync()).Count;
        ownFieldCount = (await OwnFieldBook.GetAllAsync()).Count;
        intervalCount = (await CareIntervalRepository.GetAllAsync()).Count;
    }

    private async Task SetEverydayLanguageAsync(EverydayNameLanguage language)
    {
        everydayLanguage = language;
        await Names.SetEverydayLanguageAsync(language);
    }

    private async Task SetPhotoReminderAsync(ChangeEventArgs e)
    {
        photoReminder = e.Value is true;
        await SettingsService.SetPhotoReminderAsync(photoReminder);
    }

    private async Task SetGooglePhotosAsync(ChangeEventArgs e)
    {
        googlePhotos = e.Value is true;
        await SettingsService.SetGooglePhotosAsync(googlePhotos);
    }

    private async Task SetErrorReportsAsync(ChangeEventArgs e)
    {
        errorReportsOff = e.Value is not true;
        await ErrorReports.SetOffAsync(errorReportsOff);
    }

    private async Task SetWateringReminderAsync(ChangeEventArgs e)
    {
        wateringReminder = e.Value is true;
        await SettingsService.SetWateringReminderAsync(wateringReminder);
    }

    private async Task SetDailyRoundAsync(ChangeEventArgs e)
    {
        dailyRound = e.Value is true;
        await SettingsService.SetDailyRoundAsync(dailyRound);
    }

    private static readonly Weekday[] weekdays = Enum.GetValues<Weekday>();

    private List<Weekday> roundDays = [];

    private async Task ToggleRoundDayAsync(Weekday day)
    {
        if (!roundDays.Remove(day))
            roundDays.Add(day);
        await SettingsService.SetRoundDaysAsync(roundDays);
    }

    // Notifications. What this device has is in NotificationService, what the person picked is in the settings
    private static readonly TimeOnly[] notifyTimes =
        [.. Enumerable.Range(0, 96).Select(i => new TimeOnly(i / 4, i % 4 * 15))];

    private static readonly (NotifyDays Days, string Label)[] notifyDayOptions =
    [
        (NotifyDays.EveryDay, "Every day"),
        (NotifyDays.RoundDays, "Round days"),
        (NotifyDays.Picked, "Pick days")
    ];

    private string? notifySupport;
    private string notifyPermission = "default";
    private bool notifyOn;
    private ServerCheck? notifyServer;
    private bool notifyBusy;
    private bool notifyLoadStarted;
    private string? notifyMessage;
    private TimeOnly notifyAt = new(8, 0);
    private NotifyDays notifyDaysChoice = NotifyDays.EveryDay;
    private List<Weekday> notifyWeekdays = [];

    /// <summary>What this device can do and has. Only when someone is signed in, so a device without an account never touches it.</summary>
    private async Task LoadNotificationsAsync()
    {
        notifyLoadStarted = true;
        notifySupport = await Notifications.SupportAsync();
        if (notifySupport != "ok")
            return;

        notifyPermission = await Notifications.PermissionAsync();
        notifyOn = await Notifications.IsOnAsync();
        if (!notifyOn)
            notifyServer = await Notifications.CheckServerAsync();
    }

    private async Task TurnOnNotificationsAsync()
    {
        notifyBusy = true;
        notifyMessage = null;
        try
        {
            // The prompt comes straight from this tap, so nothing is awaited before it
            switch (await Notifications.TurnOnAsync())
            {
                case TurnOnResult.Done:
                    notifyOn = true;
                    await LoadDataAsync();
                    break;
                case TurnOnResult.Ready:
                    notifyMessage = "Ready. Tap Turn on again.";
                    break;
                case TurnOnResult.Denied:
                    notifyMessage = "Notifications are blocked for stikling.app in this browser. Allow them in the site settings (the icon next to the address), then tap Turn on again.";
                    break;
                case TurnOnResult.NotSetUp:
                    notifyServer = ServerCheck.NotSetUp;
                    break;
                default:
                    notifyMessage = "Couldn't turn notifications on right now. Try again in a moment.";
                    break;
            }

            notifyPermission = await Notifications.PermissionAsync();
        }
        finally
        {
            notifyBusy = false;
        }
    }

    private async Task TurnOffNotificationsAsync()
    {
        notifyBusy = true;
        notifyMessage = null;
        try
        {
            await Notifications.TurnOffAsync();
            notifyOn = false;
            notifyServer ??= await Notifications.CheckServerAsync();
        }
        finally
        {
            notifyBusy = false;
        }
    }

    private async Task SendTestNotificationAsync()
    {
        notifyBusy = true;
        notifyMessage = null;
        try
        {
            notifyMessage = (await Notifications.SendTestAsync()).Message;
        }
        finally
        {
            notifyBusy = false;
        }
    }

    private async Task SetNotifyAtAsync(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParseExact(e.Value?.ToString(), "HH:mm", out var time))
            return;

        notifyAt = time;
        await SettingsService.SetNotifyAtAsync(time);
        await Notifications.UploadAsync(force: true);
    }

    private async Task SetNotifyDaysAsync(NotifyDays days)
    {
        notifyDaysChoice = days;
        await SettingsService.SetNotifyOnAsync(days);
        await Notifications.UploadAsync(force: true);
    }

    private async Task ToggleNotifyWeekdayAsync(Weekday day)
    {
        if (!notifyWeekdays.Remove(day))
            notifyWeekdays.Add(day);
        await SettingsService.SetNotifyWeekdaysAsync(notifyWeekdays);
        await Notifications.UploadAsync(force: true);
    }

    private async Task SetPotUpWarnCmAsync(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var cm))
        {
            return;
        }
        potUpWarnCm = Math.Clamp(cm, 1, 20);
        await SettingsService.SetPotUpWarnCmAsync(potUpWarnCm);
    }

    private async Task SetQuarantineDaysAsync(int days)
    {
        quarantineDays = days;
        await SettingsService.SetQuarantineDaysAsync(days);
    }

    private async Task SetQuarantineNewPlantsAsync(ChangeEventArgs e)
    {
        quarantineNewPlants = e.Value is true;
        await SettingsService.SetQuarantineNewPlantsAsync(quarantineNewPlants);
