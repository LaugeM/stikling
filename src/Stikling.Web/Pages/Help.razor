@page "/help"
@layout WideLayout
@* Short answers to what people ask. Keep this in step with the app: a feature that is added or
   changed should have its answer added or changed here in the same pull request. The deploy renders it
   to plain HTML for search engines and llms.txt (tools/static-pages/render.cs), without a browser, so
   calls into JavaScript stay in OnAfterRenderAsync. *@
@implements IAsyncDisposable
@using System.Globalization
@using System.Net
@inject IJSRuntime JS
@inject AccountService Account

<PageTitle>@Strings.Help.PageTitle</PageTitle>

<a class="back-link" href="settings?section=about">@Strings.Help.BackToSettings</a>
<h1>@Strings.Help.Title</h1>

<div class="help-layout">

<p class="help-intro">
    @Strings.Help.Intro
</p>

@* Only after the first render, since the search needs JavaScript and the plain HTML copy has none *@
@if (searchReady)
{
    <div class="help-search">
        <input type="search" class="form-control" placeholder="@Strings.Help.SearchPlaceholder" aria-label="@Strings.Help.SearchLabel"
               autocomplete="off" @ref="searchInput" />
        <div class="help-no-match" @ref="noMatch" hidden>
            @NoMatchParts[0]<button type="button" class="btn btn-link p-0 align-baseline" @onclick="ClearSearchAsync">@Strings.Help.ClearSearch</button>@NoMatchParts[1]
        </div>
    </div>
}

<nav class="help-toc" aria-label="@Strings.Help.TopicsNav">
    @foreach (var (id, title) in topics)
    {
        <a class="chip" href="help#@id">@title</a>
    }
</nav>

