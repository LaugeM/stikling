@page "/"
@using System.Globalization
@inject CoverPhotos Covers
@inject TodayService TodayService
@inject ITimelineRepository Entries
@inject IPhotoRepository PhotoRepository
@inject IPestCaseRepository PestCases
@inject IPestTreatmentRepository PestTreatments
@using Stikling.Core.Settings
@inject DeviceFiles Files
@inject AccountService Account
@inject SettingsService SettingsService
@inject PutOffService PutOffService
@inject ICareLogRepository CareLogs
@inject AwayService AwayService
@inject SitterSheetService SitterSheets
@inject TimelineService TimelineService
@inject CareService Care
@inject CareIntervalService CareIntervalService
@inject ILogger<Home> Logger
@inject WateringAnswers Answers
@inject AppBadge Badge
@inject PlantService PlantService
@inject PropagationService PropagationService
@inject ExampleService Example
@inject TourService Tour
@inject TimeProvider Time
@inject YearCardService YearCardsService
@using Stikling.Core.Year
@implements IAsyncDisposable

<PageTitle>@Strings.Care.TodayPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

@* Today takes the whole width beside the menu on a computer once it has loaded, except the first-run page, which stays a centred column *@
<div class="@(loaded && !FirstRun ? "page-full" : null)">
<div class="page-heading">
    <h1>@Strings.Care.TodayTitle</h1>
    <span class="today-date">@Today.ToString(Strings.Care.TodayLongDayFormat, TextCulture.ForDates)</span>
</div>

@if (!loaded)
{
    <p class="text-body-secondary">@Strings.Care.Loading</p>
}
else if (plants.Count == 0 && propagations.Count == 0)
{
    <div class="empty-state first-run">
        <svg viewBox="0 0 64 64" aria-hidden="true">
            <path class="pot" d="M18 36h28v6H18Z" /><path class="pot" d="M21 42h22l-3 16H24Z" />
            <path class="growth" d="M32 36V18" /><path class="growth" d="M32 28c0-8-6-13-14-13 0 8 6 13 14 13Z" /><path class="growth" d="M32 23c0-7 6-11 13-11 0 7-6 11-13 11Z" />
        </svg>
        <h2>@Strings.Care.TodayFirstTitle</h2>
        <p>
            @Strings.Care.TodayFirstText
        </p>
        @if (Account.IsAvailable)
        {
            <p>@Strings.Care.TodayFirstAccount</p>
        }
        else
        {
            <p>@Strings.Care.TodayFirstNoAccount</p>
        }
        <div class="first-run-actions">
            <a class="btn btn-primary" href="plants/new">@Strings.Care.TourAddPlant</a>
            <a class="btn btn-outline-primary" href="propagations/new">@Strings.Care.TodayFirstPropagation</a>
            <button type="button" class="btn btn-outline-primary" disabled="@exampleBusy" @onclick="ShowMeAroundAsync">
                @(exampleBusy ? Strings.Care.TodayFirstLoading : Strings.Settings.ShowMeAround)
            </button>
        </div>
        @if (exampleFailed)
        {
            <p class="text-danger" role="alert">@Strings.Settings.TourFailed</p>
        }
        <p class="first-run-more">
            @LinkedText(Strings.Care.TodayFirstMore, ("plants/quick-add", Strings.Care.TodayFirstQuickAdd), ("plants/import", Strings.Care.TodayFirstImport), ("plants/new?from=photos", Strings.Care.TodayFirstPhotos))
        </p>
        <a class="first-run-help" href="help">@Strings.Care.TodayFirstHelp</a>
    </div>
}
else
{
    <p class="today-counts">
        @Labels.Plants(plants.Count(p => p.InCollection)) · @Plural.Of(active.Count, Strings.Care.TodayPropagationsGoing_One, Strings.Care.TodayPropagationsGoing_Other)@(monthResult is null ? "" : " · " + string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayPottedUp, monthResult.PottedUp, monthResult.Total))
    </p>

    @if (exampleLoaded)
    {
        <div class="reminder">
            @if (confirmingRemoval)
            {
                <span>@Strings.Care.TodayExampleRemoveConfirm</span>
                <button type="button" class="btn btn-danger btn-sm" disabled="@exampleBusy" @onclick="RemoveExampleAsync">@Strings.Common.Remove</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => confirmingRemoval = false">@Strings.Common.Cancel</button>
            }
            else
            {
                <span>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayExampleIs, ExampleFamily.MotherNickname))</span>
                <button type="button" class="btn btn-outline-primary" @onclick="() => confirmingRemoval = true">@Strings.Common.Remove</button>
            }
        </div>
        @if (removeFailed)
        {
            <p class="text-danger" role="alert">@Strings.Care.TourRemoveFailed</p>
        }
    }

    @if (upcoming is not null)
    {
        <div class="reminder">
            <span><b>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayAwayFrom, upcoming.From.ToString(Strings.Care.TodayLongDayFormat, TextCulture.ForDates)))</b> @Strings.Care.TodayAwayLeaveSheet</span>
            <a class="btn btn-outline-primary" href="sitter-sheet">@Strings.Care.TodaySitterSheet</a>
        </div>
    }

    @if (sections.AwayNow is { } span)
    {
        var total = span.Until.DayNumber - span.From.DayNumber;
        var dayNumber = Today.DayNumber - span.From.DayNumber + 1;
        var toGo = span.Until.DayNumber - Today.DayNumber;
        var isAway = span.Kind == AwayKind.Away;
        <section class="away-block" aria-label="@(isAway ? Strings.Care.TodayYoureAway : Strings.Care.AwayKindQuiet)">
            <h2 class="away-title"><span>@(isAway ? Strings.Care.TodayYoureAway : Strings.Care.AwayKindQuiet)</span>@Plural.Of(toGo, Strings.Care.TodayDaysToGo_One, Strings.Care.TodayDaysToGo_Other)</h2>
            <div class="away-bar" role="img" aria-label="@BarLabel(span, dayNumber, total)">
                <div class="away-bar-done" style="width: @Percent(dayNumber - 0.5, total)"></div>
                @foreach (var visit in visitDates)
                {
                    <span class="away-visit" style="left: @Percent(visit.DayNumber - span.From.DayNumber + 0.5, total)"></span>
                }
                <span class="away-bar-now" style="left: @Percent(dayNumber - 0.5, total)"></span>
            </div>
            <div class="away-ends">
                <span>@span.From.ToString(Strings.Care.TodayShortDayFormat, TextCulture.ForDates)</span>
                @if (visitDates.Count > 0)
                {
                    <span class="away-key">@Strings.Care.TodayDotsKey</span>
                }
                <span>@(isAway ? Strings.Care.TodayBack : Strings.Care.TodayUntil) <b>@span.Until.ToString(Strings.Care.TodayShortDayFormat, TextCulture.ForDates)</b></span>
            </div>
            <p class="away-note">
                @(isAway
                    ? Strings.Care.TodayNothingAsksAway
                    : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayNothingAsksQuiet, span.Until.ToString(Strings.Care.TodayLongDayFormat, TextCulture.ForDates)))
            </p>
            <div class="away-actions">
                <button type="button" class="btn btn-primary" disabled="@awayBusy" @onclick="ImBackAsync">@Strings.Care.TodayImBack</button>
                <a class="btn btn-outline-primary" href="@(span.Stretches.Count == 1 ? $"away/{span.Stretches[0].Id}" : "away")">@Strings.Care.SitterChange</a>
                @if (isAway)
                {
                    <a class="away-link" href="sitter-sheet">@Strings.Care.TodaySitterSheet</a>
                }
            </div>
        </section>
    }

    @if (sections.Holding && backSpan is { } back)
    {
        var backDays = back.Until.DayNumber - back.From.DayNumber;
        <section class="back-panel" aria-labelledby="back-title">
            <h2 id="back-title">@Strings.Care.TodayWelcomeBack</h2>
            <p class="back-lead">
                @(back.Kind == AwayKind.Away ? Plural.Of(backDays, Strings.Care.TodayBackAway_One, Strings.Care.TodayBackAway_Other) : Plural.Of(backDays, Strings.Care.TodayBackQuiet_One, Strings.Care.TodayBackQuiet_Other))
                @Strings.Care.TodayBackLead
            </p>
            <ol class="back-rows">
                @foreach (var (row, index) in sections.BackRows.Select((r, i) => (r, i)))
                {
                    <li @key="row.Subject.Id" class="back-row">
                        <span class="back-num" aria-hidden="true">@(index + 1)</span>
                        <a class="back-main" href="@SubjectThumb.LinkTo(row.Subject)">
                            <SubjectThumb Subject="row.Subject" />
                            <div class="item-text">
                                <div class="item-name">@row.Name</div>
                                <div class="item-meta">@BackMeta(row)</div>
                            </div>
                        </a>
                        <button type="button" class="row-btn" title="@Strings.Care.TodayLookedAtIt" aria-label="@Strings.Care.TodayLookedAtIt" disabled="@awayBusy"
                                @onclick="() => LookedAtAsync(row)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                        </button>
                    </li>
                }
            </ol>
            <div class="back-foot">
                <a class="btn btn-primary" href="round/back">@Strings.Care.TodayGoRoundThese</a>
                <button type="button" class="back-done" disabled="@awayBusy" @onclick="DoneWithListAsync">@Strings.Care.TodayDoneWithList</button>
            </div>
        </section>
    }

    @if (!sections.Away && backupReminder is { } reminder)
    {
        <div class="reminder">
            <span>@reminder</span>
            <a class="btn btn-outline-primary" href="backup">@Strings.Care.TodayBackUp</a>
        </div>
    }

    @* From 64rem the sections that ask for something sit in a wide column with the rest beside it. The markup keeps the phone order. *@
    <div class="today-columns" data-tour="today">
    <div class="today-todo">
    @if (!sections.Away && sections.RoundSuggestion is { } suggested)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayRound</h2>
            <ul class="item-list">
                <TodayRow OnPutOff="days => PutOffAsync(PutOffs.Round(suggested.Room.Id), Today.AddDays(days))"
                          SkipLabel="@Strings.Care.TodaySkipToday" OnSkip="() => PutOffAsync(PutOffs.DailyRound, Today.AddDays(1))">
                    <a class="item-card" href="round/@suggested.Room.Id?daily=true">
                        <div class="item-thumb" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 11.5 12 5l8 6.5" /><path d="M6 10.5V19h12v-8.5" /><path d="M10 19v-5h4v5" /></svg>
                        </div>
                        <div class="item-text">
                            <div class="item-name">@suggested.Room.Name</div>
                            <div class="item-meta wraps">
                                <span>@RoundMeta(suggested)</span>
                            </div>
                        </div>
                    </a>
                </TodayRow>
            </ul>
        </section>
    }

    @foreach (var (heading, cases) in AwayHides(sections.DuePests))
    {
        <section class="today-section">
            <h2>@heading</h2>
            <ul class="item-list">
                @foreach (var view in cases)
                {
                    <li>
                        <a class="item-card" href="pests/@view.Case.Id">
                            <div class="item-thumb alert" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                            </div>
                            <div class="item-text">
                                <div class="item-name">@Labels.For(view.Case.Pest)</div>
                                <div class="item-meta">
                                    <span class="pest-due now">@Labels.Due(view)</span>
                                    @if (view.Step is { } step)
                                    {
                                        <span>· @(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayStep, view.StepNumber, view.StepCount))@(StepWhat(step) is { } what ? $" · {what}" : "")</span>
                                    }
                                    <span>· @Labels.ScopeAndCount(view)</span>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.ReadyNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayReadyToResolve</h2>
            <ul class="item-list">
                @foreach (var view in sections.ReadyNow)
                {
                    <TodayRow @key="view.Case.Id" DoneLabel="@Strings.Care.TodayResolve" OnDone="() => ResolveAsync(view)"
                              OnPutOff="days => PutOffAsync(PutOffs.Resolve(view.Case.Id), Today.AddDays(days))">
                        <a class="item-card" href="pests/@view.Case.Id">
                            <div class="item-thumb alert" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                            </div>
                            <div class="item-text">
                                <div class="item-name">@Labels.For(view.Case.Pest)</div>
                                <div class="item-meta">
                                    <span>@Plural.Of(view.CleanWeeks, Strings.Care.TodayCleanFor_One, Strings.Care.TodayCleanFor_Other)</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.PlanDoneNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayPlanDone</h2>
            <ul class="item-list">
                @foreach (var view in sections.PlanDoneNow)
                {
                    <TodayRow @key="view.Case.Id" DoneLabel="@Strings.Care.TodayStartWatching" OnDone="() => StartWatchingAsync(view)"
                              SkipLabel="@Strings.Care.TodayKeepTreating" OnSkip="() => KeepTreatingAsync(view)"
                              OnPutOff="days => PutOffAsync(PutOffs.PlanDone(view.Case.Id), Today.AddDays(days))">
                        <a class="item-card" href="pests/@view.Case.Id">
                            <div class="item-thumb alert" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                            </div>
                            <div class="item-text">
                                <div class="item-name">@Labels.For(view.Case.Pest)</div>
                                <div class="item-meta">
                                    <span>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayDoneWith, view.Case.PlanName))</span>
                                    <span>· @Labels.ScopeAndCount(view)</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.FlaggedNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayNeedsAttention</h2>
            <ul class="item-list">
                @foreach (var item in sections.FlaggedNow)
                {
                    <TodayRow @key="item.Subject.Id" OnDone="() => ClearFlagAsync(item)"
                              OnPutOff="days => PutOffAsync(PutOffs.Flag(item.Subject.Id, item.Attention), Today.AddDays(days))">
                        <a class="item-card" href="@SubjectThumb.LinkTo(item.Subject)">
                            <SubjectThumb Subject="item.Subject" />
                            <div class="item-text">
                                <div class="item-name">@item.Name</div>
                                <div class="item-meta">
                                    <span class="flag-line"><b>@item.Attention.Reason</b> · @(item.From is { } from ? Labels.FlagFrom(from) : Labels.DaysAgo(item.Attention.DaysSince(Today)))</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.LookAgainNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayLookAgain</h2>
            <ul class="item-list">
                @foreach (var item in sections.LookAgainNow)
                {
                    var due = item;
                    <TodayRow @key="item.Problem.Id" OnPutOff="days => PutOffAsync(PutOffs.Problem(due.Problem.Id, due.Since), Today.AddDays(days))">
                        <div class="look-again-row">
                            <a class="item-card look-again-link" href="problems/@item.Problem.Id">
                                <SubjectThumb Subject="item.Plant" />
                                <div class="item-text">
                                    <div class="item-name">@item.Plant.DisplayName</div>
                                    <div class="item-meta">
                                        <span>@ProblemText.Signs(item.Problem.KnownSigns) · @Plural.Of(ProblemText.DaysLasted(item.Problem, Today), Strings.Care.TodayDays_One, Strings.Care.TodayDays_Other)</span>
                                    </div>
                                </div>
                            </a>
                            <div class="look-again-buttons" role="group" aria-label="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayHowDoesItLook, item.Plant.DisplayName))">
                                @foreach (var trend in Enum.GetValues<ProblemTrend>())
                                {
                                    var picked = trend;
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => LookAt(due, picked)">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">@ProblemIcons.Trend(trend)</svg>
                                        @(trend == ProblemTrend.Same ? Strings.Care.TodayTrendSame : ProblemText.Trend(trend))
                                    </button>
                                }
                            </div>
                        </div>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.QuarantineNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayQuarantineUp</h2>
            <ul class="item-list">
                @foreach (var plant in sections.QuarantineNow)
                {
                    <TodayRow @key="plant.Id" DoneLabel="@Strings.Care.TodayQuarantineDone" OnDone="() => LetOutAsync(plant)"
                              OnPutOff="days => PutOffAsync(PutOffs.Quarantine(plant.Id, plant.QuarantinedSince!.Value), Today.AddDays(days))">
                        <a class="item-card" href="plants/@plant.Id">
                            <SubjectThumb Subject="plant" />
                            <div class="item-text">
                                <div class="item-name">@plant.DisplayName</div>
                                <div class="item-meta">
                                    <span>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayQuarantineMeta, Plural.Of(plant.DaysInQuarantine(Today) ?? 0, Strings.Care.TodayDays_One, Strings.Care.TodayDays_Other)))</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.TransitionNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayMovingToSemiHydro</h2>
            <ul class="item-list">
                @foreach (var plant in sections.TransitionNow)
                {
                    var lastNews = plant.TransitionLastNews!.Value;
                    <TodayRow @key="plant.Id" DoneLabel="@Strings.Care.TodayLookedStillWaiting" OnDone="() => PutOffAsync(PutOffs.Transition(plant.Id, lastNews), Today.AddDays(14))"
                              OnPutOff="days => PutOffAsync(PutOffs.Transition(plant.Id, lastNews), Today.AddDays(days))">
                        <a class="item-card" href="plants/@plant.Id">
                            <SubjectThumb Subject="plant" />
                            <div class="item-text">
                                <div class="item-name">@plant.DisplayName</div>
                                <div class="item-meta">
                                    <span>@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayNothingNew, Plural.Of((Today.DayNumber - lastNews.DayNumber) / 7, Strings.Care.TodayWeeks_One, Strings.Care.TodayWeeks_Other)))</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.RestNow.Count > 0)
    {
        <section class="today-section">
            <h2>@Strings.Care.TodayGoneDormant</h2>
            <ul class="item-list">
                @foreach (var (plant, windowStart) in sections.RestNow)
                {
                    <TodayRow @key="plant.Id" DoneLabel="@Strings.Care.TodayYesDormant" OnDone="() => WentDormantAsync(plant)"
                              OnPutOff="days => PutOffAsync(PutOffs.Rest(plant.Id, windowStart), Today.AddDays(days))"
                              SkipLabel="@Strings.Care.TodayNotThisYear" OnSkip="() => PutOffAsync(PutOffs.Rest(plant.Id, windowStart), windowStart.AddDays(RestSeason.WindowDays))">
                        <a class="item-card" href="plants/@plant.Id">
                            <SubjectThumb Subject="plant" />
                            <div class="item-text">
                                <div class="item-name">@plant.DisplayName</div>
                                <div class="item-meta">
                                    <span>@(plant.GrowingSeason == GrowingSeason.Summer ? Strings.Care.TodayRestsWinter : Strings.Care.TodayRestsSummer)</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && sections.OuterPot.Due.Count > 0)
    {
        <section class="today-section">
            <div class="today-section-head">
                <h2>@Strings.Care.TodayEmptyOuterPot</h2>
                @if (sections.OuterPot.Due.Count >= 2)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@emptying" @onclick="() => EmptiedAsync(sections.OuterPot.Due)">@Strings.Care.TodayAllEmptied</button>
                }
            </div>
            <ul class="item-list">
                @foreach (var due in sections.OuterPot.Due)
                {
                    <li @key="due.Plant.Id" class="today-row">
                        <div class="today-row-main">
                            <a class="item-card" href="plants/@due.Plant.Id">
                                <SubjectThumb Subject="due.Plant" />
                                <div class="item-text">
                                    <div class="item-name">@due.Plant.DisplayName</div>
                                </div>
                            </a>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@emptying" @onclick="() => EmptiedAsync([due])">@Strings.Care.TodayEmptied</button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    @if (!sections.Away && !sections.Holding && (sections.WaterNow.Count > 0 || sections.WaterComing.Count > 0 || NextRoundWaterLine is not null))
    {
        var now = sections.WaterNow;
        var coming = sections.WaterComing;
        <section class="today-section">
            <div class="today-section-head">
                <h2>@Strings.Care.TodayWater</h2>
                <div class="today-head-links">
                    <a class="today-go-round" href="water">
                        @Strings.Care.WaterTitle
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                    </a>
                    @if (now.Count >= 2)
                    {
                        <a class="today-go-round" href="round/due">
                            @Strings.Care.TodayGoRoundThese
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                        </a>
                    }
                </div>
            </div>
            @if (NextRoundWaterLine is { } nextRound)
            {
                <p class="today-next-round">
                    <span>@nextRound</span>
                    <a class="today-go-round" href="round/next">
                        @Strings.Care.TodayGoRoundNow
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                    </a>
                </p>
            }
            @if (now.Any(d => d.Guess.Form == WateringForm.TopWatered && d.Guess.Mode != WateringMode.Meter))
            {
                <details class="today-hint">
                    <summary>@Strings.Care.TodayHowToTell</summary>
                    <ul>
                        <li>@Strings.Care.TodayHintFinger</li>
                        <li>@Strings.Care.TodayHintSkewer</li>
                        <li>@Strings.Care.TodayHintLift</li>
                        <li>@Strings.Care.TodayHintMeter</li>
                    </ul>
                </details>
            }
            @if (now.Count > 0)
            {
                <ul class="item-list">
                    @foreach (var due in now)
                    {
                        @WaterRow(due)
                    }
                </ul>
            }
            @if (coming.Count > 0)
            {
                <h3 class="today-subhead">@Strings.Care.TodayComingUp</h3>
                <ul class="item-list">
                    @foreach (var due in coming)
                    {
                        @WaterRow(due)
                    }
                </ul>
            }
        </section>
    }

    @if (!sections.Away && !sections.Holding && (sections.CareNow.Count > 0 || sections.CareComing.Count > 0 || CareNextRoundLine is not null))
