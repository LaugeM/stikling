@page "/"
@using System.Globalization
@inject IPlantRepository Plants
@inject IPropagationRepository Propagations
@inject ITimelineRepository Entries
@inject IPhotoRepository PhotoRepository
@inject IPestCaseRepository PestCases
@inject IPestTreatmentRepository PestTreatments
@inject DeviceFiles Files
@inject PlantService PlantService
@inject PropagationService PropagationService
@inject RoomService RoomService
@inject TimeProvider Time

<PageTitle>Today · Stikling</PageTitle>

<div class="page-heading">
    <h1>Today</h1>
    <span class="today-date">@Today.ToString("dddd d MMMM", CultureInfo.InvariantCulture)</span>
</div>

@if (!loaded)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (plants.Count == 0 && propagations.Count == 0)
{
    <div class="empty-state first-run">
        <svg viewBox="0 0 64 64" aria-hidden="true">
            <path class="pot" d="M18 36h28v6H18Z" /><path class="pot" d="M21 42h22l-3 16H24Z" />
            <path class="growth" d="M32 36V18" /><path class="growth" d="M32 28c0-8-6-13-14-13 0 8 6 13 14 13Z" /><path class="growth" d="M32 23c0-7 6-11 13-11 0 7-6 11-13 11Z" />
        </svg>
        <h2>Start with a plant</h2>
        <p>
            Stikling keeps track of your plants and the cuttings you grow from them, with notes and photos
            as they go. Add a plant you have, and this page fills up with what needs doing.
        </p>
        <p>Everything stays on this device. There is no account to make.</p>
        <div class="first-run-actions">
            <a class="btn btn-primary" href="plants/new">Add a plant</a>
            <a class="btn btn-outline-primary" href="propagations/new">Start a propagation</a>
        </div>
        <a class="first-run-help" href="help">How Stikling works</a>
    </div>
}
else
{
    <p class="today-counts">
        @Labels.Plants(plants.Count(p => p.Status == PlantStatus.Active)) · @Labels.Count(active.Count, "propagation") going
    </p>

    @if (backupReminder is { } reminder)
    {
        <div class="reminder">
            <span>@reminder</span>
            <a class="btn btn-outline-primary btn-sm" href="settings">Back up</a>
        </div>
    }

    @foreach (var (heading, cases) in DuePests)
    {
        <section class="today-section">
            <h2>@heading</h2>
            <ul class="item-list">
                @foreach (var view in cases)
                {
                    <li>
                        <a class="item-card" href="pests/@view.Case.Id">
                            <div class="item-thumb alert" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                            </div>
                            <div class="item-text">
                                <div class="item-name">@Labels.For(view.Case.Pest)</div>
                                <div class="item-meta">
                                    <span class="pest-due now">@Labels.Due(view.DaysUntilDue ?? 0, view.IsCheck)</span>
                                    <span>· @Labels.ScopeAndCount(view)</span>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @if (FlaggedNow.Count > 0)
    {
        <section class="today-section">
            <h2>Needs attention</h2>
            <ul class="item-list">
                @foreach (var item in FlaggedNow)
                {
                    <TodayRow @key="item.Subject.Id" OnDone="() => ClearFlagAsync(item)"
                              OnPutOff="days => PutOffAsync(PutOffs.Flag(item.Subject.Id, item.Attention), Today.AddDays(days))">
                        <a class="item-card" href="@SubjectThumb.LinkTo(item.Subject)">
                            <SubjectThumb Subject="item.Subject" />
                            <div class="item-text">
                                <div class="item-name">@item.Name</div>
                                <div class="item-meta">
                                    <span class="flag-line"><b>@item.Attention.Reason</b> · @Labels.DaysAgo(item.Attention.DaysSince(Today))</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    @if (QuarantineNow.Count > 0)
    {
        <section class="today-section">
            <h2>Quarantine is up</h2>
            <ul class="item-list">
                @foreach (var plant in QuarantineNow)
                {
                    <TodayRow @key="plant.Id"
                              OnPutOff="days => PutOffAsync(PutOffs.Quarantine(plant.Id, plant.QuarantinedSince!.Value), Today.AddDays(days))">
                        <a class="item-card" href="plants/@plant.Id">
                            <SubjectThumb Subject="plant" />
                            <div class="item-text">
                                <div class="item-name">@plant.DisplayName</div>
                                <div class="item-meta">
                                    <span>Time to check it and let it out · in quarantine @Labels.Count(plant.DaysInQuarantine(Today) ?? 0, "day")</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        </section>
    }

    <section class="today-section">
        <h2>Worth a look</h2>
        @if (ChecksNow.Count == 0)
        {
            <p class="text-body-secondary mb-0">
                @(active.Count == 0
                    ? "No propagations on the go. Open a plant and tap Propagate to start one."
                    : checks.Count > 0
                        ? "Nothing else waiting. The ones you put off come back by themselves."
                        : "Nothing waiting. Every propagation has been looked at in the last week.")
            </p>
        }
        else
        {
            <ul class="item-list">
                @foreach (var check in ChecksNow)
                {
                    <TodayRow @key="check.Propagation.Id"
                              OnPutOff="days => PutOffAsync(PutOffs.Check(check.Propagation.Id), Today.AddDays(days))">
                        <a class="item-card" href="propagations/@check.Propagation.Id">
                            <PropagationThumb Propagation="check.Propagation" Days="check.Propagation.DaysSinceStart(Today)" />
                            <div class="item-text">
                                <div class="item-name">@check.Propagation.DisplayName</div>
                                <div class="item-meta">
                                    <StageBadge Stage="check.Propagation.Stage" Type="check.Propagation.Type" />
                                    <span>@Labels.Summary(check.Propagation) · @LastSeen(check)</span>
                                </div>
                            </div>
                        </a>
                    </TodayRow>
                }
            </ul>
        }
    </section>

    @if (photoRound.Count > 0 && !putOffs.IsPutOff(PutOffs.PhotoRound, Today))
    {
        <section class="today-section">
            <h2>Photos</h2>
            <ul class="item-list">
                <TodayRow OnPutOff="days => PutOffAsync(PutOffs.PhotoRound, Today.AddDays(days))"
                          SkipLabel="Skip this month" OnSkip="() => PutOffAsync(PutOffs.PhotoRound, PhotoRound.NextRound(Today))">
                    <button type="button" class="item-card round-toggle" aria-expanded="@(showRound ? "true" : "false")"
                            aria-controls="photo-round" @onclick="() => showRound = !showRound">
                        <div class="item-thumb" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4Z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        </div>
                        <div class="item-text">
                            <div class="item-name">@Labels.Count(photoRound.Count, "photo") to take</div>
                            <div class="item-meta">For @Today.ToString("MMMM", CultureInfo.InvariantCulture)</div>
                        </div>
                        <svg class="round-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                </TodayRow>
            </ul>
            @if (showRound)
            {
                <ul class="item-list photo-round" id="photo-round">
                    @foreach (var due in photoRound)
                    {
                        <PhotoRoundRow @key="due.Subject.Id" Due="due" OnTaken="LoadAsync" />
                    }
                </ul>
            }
        </section>
    }

    <section class="today-section">
        <h2>Lately</h2>
        @if (recent.Count == 0)
        {
            <p class="text-body-secondary mb-0">Nothing written down yet. Notes and photos you add to a plant or propagation show up here.</p>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var entry in recent)
                {
                    <li>
                        <a href="@LinkTo(entry)">
                            <span class="activity-subject">@NameOf(entry)</span>
                            <span class="activity-text">@Summary(entry)</span>
                        </a>
                        <span class="activity-day">@DayLabel(entry.OccurredAt)</span>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private IReadOnlyList<Plant> plants = [];
    private IReadOnlyList<Propagation> propagations = [];
    private List<Propagation> active = [];
    private IReadOnlyList<PropagationCheck> checks = [];
    private IReadOnlyList<PestCaseView> dueTreatments = [];
    private IReadOnlyList<TimelineEntry> recent = [];
    private IReadOnlyList<AttentionItem> flagged = [];
    private IReadOnlyList<PhotoDue> photoRound = [];
    private PutOffs putOffs = PutOffs.Empty();
    private Dictionary<Guid, string> names = [];
    private string? backupReminder;
    private bool showRound;
    private bool loaded;

    private DateOnly Today => Time.Today();

    private List<AttentionItem> FlaggedNow =>
        flagged.Where(i => !putOffs.IsPutOff(PutOffs.Flag(i.Subject.Id, i.Attention), Today)).ToList();

    private List<Plant> QuarantineNow =>
        TodayBoard.QuarantineUp(plants, Today)
            .Where(p => !putOffs.IsPutOff(PutOffs.Quarantine(p.Id, p.QuarantinedSince!.Value), Today)).ToList();

    // A propagation already under Needs attention isn't listed a second time
    private List<PropagationCheck> ChecksNow =>
        checks.Where(c => !putOffs.IsPutOff(PutOffs.Check(c.Propagation.Id), Today)
                          && FlaggedNow.All(i => i.Subject.Id != c.Propagation.Id))
            .ToList();

    // Treatments first, then the cases only being watched, each under its own heading when there are any
    private IEnumerable<(string Heading, List<PestCaseView> Cases)> DuePests =>
        new[]
        {
            ("Treatment due", dueTreatments.Where(v => !v.IsCheck).ToList()),
            ("Check for pests", dueTreatments.Where(v => v.IsCheck).ToList())
        }.Where(group => group.Item2.Count > 0);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        plants = await Plants.GetAllAsync();
        propagations = await Propagations.GetAllAsync();
        active = propagations.Where(p => p.IsActive).ToList();

        var latest = await Entries.GetLatestPerSubjectAsync();
        checks = TodayBoard.NeedsChecking(propagations, latest, Time);
        flagged = TodayBoard.NeedsAttention(plants, propagations);
        putOffs = await Files.GetPutOffsAsync(Today);

        var places = await RoomService.GetPlacesAsync();
        photoRound = await Files.GetPhotoReminderAsync()
            ? PhotoRound.Due(plants, propagations, await PhotoRepository.GetNewestPerSubjectAsync(), places, Time)
            : [];

        dueTreatments = PestService.Due(
            PestService.Describe(await PestCases.GetAllAsync(), plants, await PestTreatments.GetAllAsync(), places, Today));

        names = plants.ToDictionary(p => p.Id, p => p.DisplayName);
        foreach (var propagation in propagations)
            names[propagation.Id] = propagation.DisplayName;

        // Only what's still here: entries left behind by a deleted plant have nowhere to go
        recent = await Entries.GetRecentAsync(8, names.Keys.ToHashSet());

        backupReminder = await BackupReminderAsync();
        loaded = true;
    }

    private async Task PutOffAsync(string key, DateOnly until)
    {
        putOffs.PutOff(key, until);
        await Files.SetPutOffsAsync(putOffs);
    }

    private async Task ClearFlagAsync(AttentionItem item)
    {
        if (item.Subject is Plant plant)
            await PlantService.SetAttentionAsync(plant, null);
        else if (item.Subject is Propagation propagation)
            await PropagationService.SetAttentionAsync(propagation, null);
        flagged = TodayBoard.NeedsAttention(plants, propagations);
    }

    // Nagging once a month is enough, and only when there's something to lose
    private async Task<string?> BackupReminderAsync()
    {
        if (plants.Count == 0 && propagations.Count == 0)
            return null;

        var last = await Files.GetLastBackupAsync();
        return TodayBoard.DaysSinceBackup(last, Today) switch
        {
            null => "No backup yet. Your plants live on this device only.",
            >= 30 and var days => $"Last backup was {Labels.DaysAgo(days)}.",
            _ => null
        };
    }

    // The tile already says how long it has been going, so don't repeat that number when
    // nothing has been noted since it started
    private string LastSeen(PropagationCheck check) =>
        check.DaysSince >= check.Propagation.DaysSinceStart(Today)
            ? "no notes yet"
            : $"last seen {Labels.DaysAgo(check.DaysSince)}";

    private string NameOf(TimelineEntry entry) => names[entry.SubjectId];

    private string LinkTo(TimelineEntry entry) =>
        entry.SubjectType == SubjectType.Plant
            ? $"plants/{entry.SubjectId}?tab=history"
            : $"propagations/{entry.SubjectId}?tab=history";

    private static string Summary(TimelineEntry entry)
    {
        var text = entry.Text?.ReplaceLineEndings(" · ");
        if (!string.IsNullOrWhiteSpace(text))
            return text;
        return entry.PhotoIds.Count == 1 ? "Photo added" : $"{entry.PhotoIds.Count} photos added";
    }

    private string DayLabel(DateTimeOffset moment)
    {
        var day = Time.LocalDay(moment);
        return day == Today ? "today"
            : day == Today.AddDays(-1) ? "yesterday"
            : Labels.Date(day);
    }
}
