                    <figcaption>@Labels.Date(Time.LocalDay(memory.Newest.TakenAt))@PhotoDayCount.Suffix(PhotoDayCount.PlantAge(memory.Plant, Time.LocalDay(memory.Newest.TakenAt)))</figcaption>
