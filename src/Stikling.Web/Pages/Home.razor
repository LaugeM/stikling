                        </div>
                        <div class="item-text">
                            <div class="item-name">@Plural.Of(sections.PhotosDue.Count, Strings.Care.TodayPhotosToTake_One, Strings.Care.TodayPhotosToTake_Other)</div>
                            <div class="item-meta">@(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Care.TodayPhotosFor, Today.ToString(Strings.Care.TodayMonthFormat, TextCulture.ForDates)))</div>
                        </div>
