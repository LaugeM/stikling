@page "/settings/measurements"
@inject MeasurementService MeasureService
@inject ILogger<MeasurementKinds> Logger

<PageTitle>@Strings.Measurements.PageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="settings?section=care">@Strings.Care.BackToSettings</a>
<h1>@Strings.Measurements.Title</h1>

<p class="settings-hint">
    @Strings.Measurements.Hint
</p>

@if (loading)
{
    <p class="text-body-secondary">@Strings.Measurements.Loading</p>
}
else if (kinds.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Measurements.EmptyTitle</p>
        <p class="text-body-secondary">
            @Strings.Measurements.EmptyText
        </p>
        <button type="button" class="btn btn-primary mt-2" @onclick="StartNew">@Strings.Measurements.AddFirst</button>
    </div>
}
else
{
    <div class="form-actions mt-3 mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Measurements.AddMore</button>
    </div>

    <section class="settings-section">
        <h2>@Strings.Measurements.YourKinds</h2>

        <ul class="kind-list">
            @foreach (var kind in kinds)
            {
                <li>
                    <button type="button" class="kind-row" @onclick="() => StartEdit(kind)">
                        <span class="kind-title">@kind.Name</span>
                        <span class="kind-use">@Use(kind)</span>
                    </button>
                </li>
            }
        </ul>
    </section>
}

<Sheet Title="@(editing is null ? Strings.Measurements.SheetAdd : Strings.Measurements.SheetEdit)" Open="sheetOpen" OpenChanged="SheetOpenChanged">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    @if (confirmingRemove && editing is not null)
    {
        <p>@(F(Strings.Measurements.RemoveConfirm, editing.Name))</p>
        <div class="care-actions">
            <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="RemoveAsync">@Strings.Common.Remove</button>
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => confirmingRemove = false">@Strings.Common.Cancel</button>
        </div>
    }
    else
    {
        <div class="mb-2">
            <label class="form-label" for="measure-kind-name">@Strings.Measurements.KindName</label>
            <input id="measure-kind-name" class="form-control form-control-sm" placeholder="@Strings.Measurements.KindNamePlaceholder"
                   autocomplete="off" maxlength="60" @bind="name" @bind:event="oninput" />
        </div>

        @if (editing is null)
        {
            <div class="mb-2">
                <div class="form-label" id="measure-kind-as">@Strings.Measurements.KindMeasuredAs</div>
                <div class="chip-row" role="group" aria-labelledby="measure-kind-as">
                    <button type="button" class="chip @(isLength ? "picked" : null)" aria-pressed="@(isLength ? "true" : "false")"
                            @onclick="() => isLength = true">@Strings.Measurements.KindLength</button>
                    <button type="button" class="chip @(isLength ? null : "picked")" aria-pressed="@(isLength ? "false" : "true")"
                            @onclick="() => isLength = false">@Strings.Measurements.KindCount</button>
                </div>
            </div>
        }
        else
        {
            @* Changing a length into a count would change what the measurements already taken mean *@
            <p class="settings-hint">@F(Strings.Measurements.KindFixed, editing.IsLength ? Strings.Measurements.KindFixedLength : Strings.Measurements.KindFixedCount)</p>
        }

        <div class="care-actions">
            <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(name))" @onclick="SaveAsync">
                @(editing is null ? Strings.Common.Add : Strings.Common.Save)
            </button>
            @if (editing is not null)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => confirmingRemove = true">@Strings.Common.Remove</button>
            }
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="CloseSheet">@Strings.Common.Cancel</button>
        </div>
    }
</Sheet>

@code {
    private IReadOnlyList<OwnMeasureKind> kinds = [];
    private Dictionary<Guid, int> uses = [];
    private bool loading = true;

    private bool sheetOpen;
    private OwnMeasureKind? editing;
    private string name = "";
    private bool isLength = true;
    private bool confirmingRemove;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        kinds = await MeasureService.GetOwnKindsAsync();
        uses = [];
        foreach (var kind in kinds)
            uses[kind.Id] = await MeasureService.OwnKindUseAsync(kind.Id);
        loading = false;
    }

    private string Use(OwnMeasureKind kind)
    {
        var type = kind.IsLength ? Strings.Measurements.RowLength : Strings.Measurements.RowCount;
        var count = uses.GetValueOrDefault(kind.Id);
        return count == 0
            ? F(Strings.Measurements.RowUnused, type)
            : F(count == 1 ? Strings.Measurements.RowUsed_One : Strings.Measurements.RowUsed_Other, type, count);
    }

    private void StartNew()
    {
        editing = null;
        name = "";
        isLength = true;
        Open();
    }

    private void StartEdit(OwnMeasureKind kind)
    {
        editing = kind;
        name = kind.Name;
        Open();
    }

    private void Open()
    {
        confirmingRemove = false;
        error = null;
        sheetOpen = true;
    }

    private void SheetOpenChanged(bool open) => sheetOpen = open;

    private void CloseSheet() => sheetOpen = false;

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (editing is null)
            {
                var trimmed = name.Trim();
                if (kinds.FirstOrDefault(k => string.Equals(k.Name.Trim(), trimmed, StringComparison.CurrentCultureIgnoreCase)) is { } existing)
                {
                    error = F(Strings.Measurements.AlreadyHave, existing.Name);
                    return;
                }
                await MeasureService.AddOwnKindAsync(name, isLength);
            }
            else
            {
                await MeasureService.RenameOwnKindAsync(editing.Id, name);
            }

            sheetOpen = false;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving a kind of measurement failed");
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveAsync()
    {
        if (editing is null)
            return;

        busy = true;
        try
        {
            await MeasureService.RemoveOwnKindAsync(editing.Id);
            sheetOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a kind of measurement failed");
            error = ex.Message;
            confirmingRemove = false;
        }
        finally
        {
            busy = false;
        }
    }
}
