@page "/fields"
@inject OwnFieldService FieldService
@inject ILogger<OwnFields> Logger

<PageTitle>@Strings.Shared.OwnFieldsPageTitle</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="settings?section=plants">@Strings.Layout.Settings</a>
<h1>@Strings.Shared.OwnFieldsTitle</h1>

<p class="settings-hint">@Strings.Shared.OwnFieldsHint</p>

@if (loading)
{
    <p class="text-body-secondary">@Strings.Shared.Loading</p>
}
else if (fields.Count == 0)
{
    <div class="empty-state">
        <p>@Strings.Shared.OwnFieldsEmpty</p>
        <p class="text-body-secondary">@Strings.Shared.OwnFieldsEmptyHint</p>
        <button type="button" class="btn btn-primary mt-2" @onclick="StartNew">@Strings.Shared.OwnFieldsAdd</button>
    </div>
}
else
{
    <div class="form-actions mt-3 mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartNew">@Strings.Shared.OwnFieldsAddPlus</button>
    </div>

    <section class="settings-section">
        <h2>@Strings.Shared.OwnFieldsTitle</h2>

        <ul class="field-list">
            @foreach (var field in fields)
            {
                <li>
                    <button type="button" class="field-row" @onclick="() => StartEdit(field)">
                        <span class="field-title">@field.Name</span>
                        <span class="field-kind">@KindText(field)</span>
                        <span class="field-use">@UseText(field)</span>
                    </button>
                </li>
            }
        </ul>
    </section>
}

<Sheet Title="@(Editing is null ? Strings.Shared.OwnFieldsAdd : Strings.Shared.OwnFieldsEdit)" Open="sheetOpen" OpenChanged="SheetOpenChanged">
    @if (error is not null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">@error</div>
    }

    @if (Editing is not { } field)
    {
        <OwnFieldForm Prefix="field-new" Added="AddedAsync" Cancelled="CloseSheet" />
    }
    else if (confirmingRemove)
    {
        <p>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.OwnFieldsRemoveConfirm, field.Name, Labels.Plants(UseCount(field)))</p>
        <div class="care-actions">
            <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="RemoveAsync">@Strings.Common.Remove</button>
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => confirmingRemove = false">@Strings.Common.Cancel</button>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label" for="field-edit-name">@Strings.Shared.OwnFieldsName</label>
            <input id="field-edit-name" class="form-control form-control-sm" autocomplete="off"
                   maxlength="@OwnField.MaxNameLength" value="@name" @oninput="e => name = e.Value?.ToString() ?? string.Empty" />
            <div class="care-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(name) || name.Trim() == field.Name)"
                        @onclick="RenameAsync">@Strings.Shared.OwnFieldsRename</button>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-label" id="field-edit-kind">@Strings.Shared.OwnFieldsWhatItHolds</div>
            <div class="chip-row" role="group" aria-labelledby="field-edit-kind">
                @foreach (var (value, text) in kinds)
                {
                    var picked = pendingKind == value;
                    <button type="button" class="chip @(picked ? "picked" : null)" aria-pressed="@(picked ? "true" : "false")"
                            @onclick="() => PickKindAsync(value)">@text</button>
                }
            </div>
            @if (pendingKind != field.Kind)
            {
                @if (notFitting > 0)
                {
                    <div class="form-text">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, notFitting == 1 ? Strings.Shared.OwnFieldsNotFitting_One : Strings.Shared.OwnFieldsNotFitting_Other, notFitting, pendingKind == OwnFieldKind.Number ? Strings.Shared.OwnFieldsAsNumber : Strings.Shared.OwnFieldsAsDate)
                    </div>
                }
                else if (pendingKind == OwnFieldKind.Choice && field.Choices.Count == 0)
                {
                    <div class="form-text">@Strings.Shared.OwnFieldsBecomeChoices</div>
                }
                <div class="care-actions">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@busy" @onclick="ChangeKindAsync">@ChangeToText(pendingKind)</button>
                    <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => pendingKind = field.Kind">@Strings.Common.Cancel</button>
                </div>
            }
        </div>

        @if (field.Kind == OwnFieldKind.Choice)
        {
            <div class="mb-3">
                <div class="form-label">@Strings.Shared.OwnFieldsChoices</div>
                @if (field.Choices.Count == 0)
                {
                    <div class="form-text">@Strings.Shared.OwnFieldsNoChoices</div>
                }
                <ul class="field-choices">
                    @foreach (var choice in field.Choices)
                    {
                        <li>
                            @if (renamingChoice == choice)
                            {
                                <input class="form-control form-control-sm" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.OwnFieldsChoiceNewName, choice)" autocomplete="off"
                                       maxlength="@OwnField.MaxNameLength" value="@renameTo" @oninput="e => renameTo = e.Value?.ToString() ?? string.Empty" />
                                <div class="form-text">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.OwnFieldsChoiceRenameNote, choice)</div>
                                <div class="care-actions">
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(renameTo))"
                                            @onclick="() => RenameChoiceAsync(choice)">@Strings.Shared.OwnFieldsRename</button>
                                    <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => renamingChoice = null">@Strings.Common.Cancel</button>
                                </div>
                            }
                            else
                            {
                                <span class="field-choice">@choice</span>
                                <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => StartRenameChoice(choice)">@Strings.Shared.OwnFieldsRename</button>
                                <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="() => RemoveChoiceAsync(choice)">@Strings.Common.Remove</button>
                            }
                        </li>
                    }
                </ul>
                <div class="form-text mb-2">@Strings.Shared.OwnFieldsChoiceRemoveNote</div>
                <div class="tag-draft">
                    <input class="form-control" placeholder="@Strings.Shared.OwnFieldsNewChoice" aria-label="@Strings.Shared.OwnFieldsNewChoice" autocomplete="off"
                           enterkeyhint="done" maxlength="@OwnField.MaxNameLength" value="@newChoice"
                           @oninput="e => newChoice = e.Value?.ToString() ?? string.Empty" @onkeydown="NewChoiceKey" />
                    <button type="button" class="btn btn-outline-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newChoice))"
                            @onclick="AddChoiceAsync">@Strings.Common.Add</button>
                </div>
            </div>
        }

        <div class="care-actions">
            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => confirmingRemove = true">@Strings.Shared.OwnFieldsRemoveField</button>
            <button type="button" class="btn btn-link btn-sm" disabled="@busy" @onclick="CloseSheet">@Strings.Common.Done</button>
        </div>
    }
</Sheet>

@code {
    private IReadOnlyList<OwnField> fields = [];
    private Dictionary<Guid, int> useCounts = [];
    private bool loading = true;

    private bool sheetOpen;
    private Guid? editingId;
    private string name = "";
    private OwnFieldKind pendingKind;
    private int notFitting;
    private string? renamingChoice;
    private string renameTo = "";
    private string newChoice = "";
    private bool confirmingRemove;
    private bool busy;
    private string? error;

    private OwnField? Editing => editingId is { } id ? fields.FirstOrDefault(f => f.Id == id) : null;

    private static readonly (OwnFieldKind Value, string Text)[] kinds =
    [
        (OwnFieldKind.Text, Strings.Shared.OwnFieldKindText),
        (OwnFieldKind.Number, Strings.Shared.OwnFieldKindNumber),
        (OwnFieldKind.Date, Strings.Shared.OwnFieldKindDate),
        (OwnFieldKind.Choice, Strings.Shared.OwnFieldKindChoice)
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        fields = await FieldService.GetAllAsync();
        var counts = new Dictionary<Guid, int>();
        foreach (var field in fields)
            counts[field.Id] = await FieldService.UseCountAsync(field.Id);
        useCounts = counts;
        loading = false;
    }

    private int UseCount(OwnField field) => useCounts.GetValueOrDefault(field.Id);

    private string UseText(OwnField field) =>
        UseCount(field) == 0 ? Strings.Shared.OwnFieldsOnNone : string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.OwnFieldsOn, Labels.Plants(UseCount(field)));

    private static string KindName(OwnFieldKind kind) => kinds.First(k => k.Value == kind).Text;

    private static string ChangeToText(OwnFieldKind kind) => kind switch
    {
        OwnFieldKind.Number => Strings.Shared.OwnFieldsChangeToNumber,
        OwnFieldKind.Date => Strings.Shared.OwnFieldsChangeToDate,
        OwnFieldKind.Choice => Strings.Shared.OwnFieldsChangeToChoice,
        _ => Strings.Shared.OwnFieldsChangeToText
    };

    private static string KindText(OwnField field) =>
        field.Kind == OwnFieldKind.Choice && field.Choices.Count > 0
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Shared.OwnFieldsChoiceList, string.Join(", ", field.Choices))
            : KindName(field.Kind);

    private void StartNew()
    {
        editingId = null;
        Open();
    }

    private void StartEdit(OwnField field)
    {
        editingId = field.Id;
        name = field.Name;
        pendingKind = field.Kind;
        notFitting = 0;
        renamingChoice = null;
        newChoice = "";
        Open();
    }

    private void Open()
    {
        confirmingRemove = false;
        error = null;
        sheetOpen = true;
    }

    private void SheetOpenChanged(bool open) => sheetOpen = open;

    private void CloseSheet() => sheetOpen = false;

    private async Task AddedAsync(OwnField added)
    {
        sheetOpen = false;
        await LoadAsync();
    }

    private async Task PickKindAsync(OwnFieldKind kind)
    {
        pendingKind = kind;
        notFitting = Editing is { } field && kind is OwnFieldKind.Number or OwnFieldKind.Date
            ? await FieldService.NotFittingCountAsync(field.Id, kind)
            : 0;
    }

    // Runs a change to the open field, then loads the fields again. A failure says why in the sheet.
    private async Task RunAsync(Func<OwnField, Task> change, string failure)
    {
        if (Editing is not { } field)
            return;
        busy = true;
        error = null;
        try
        {
            await change(field);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Failure}", failure);
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private Task RenameAsync() => RunAsync(async field =>
    {
        await FieldService.RenameAsync(field.Id, name);
        name = name.Trim();
    }, "Renaming a field failed");

    private Task ChangeKindAsync() => RunAsync(async field =>
    {
        await FieldService.SetKindAsync(field.Id, pendingKind);
        notFitting = 0;
    }, "Changing the kind of a field failed");

    private void StartRenameChoice(string choice)
    {
        renamingChoice = choice;
        renameTo = choice;
    }

    private Task RenameChoiceAsync(string choice) => RunAsync(async field =>
    {
        await FieldService.RenameChoiceAsync(field.Id, choice, renameTo);
        renamingChoice = null;
    }, "Renaming a choice failed");

    private Task RemoveChoiceAsync(string choice) =>
        RunAsync(field => FieldService.RemoveChoiceAsync(field.Id, choice), "Removing a choice failed");

    private async Task NewChoiceKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newChoice))
            await AddChoiceAsync();
    }

    private Task AddChoiceAsync() => RunAsync(async field =>
    {
        await FieldService.AddChoiceAsync(field.Id, newChoice);
        newChoice = "";
    }, "Adding a choice failed");

    private async Task RemoveAsync()
    {
        if (Editing is not { } field)
            return;
        busy = true;
        try
        {
            await FieldService.RemoveAsync(field.Id);
            sheetOpen = false;
            editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing a field failed");
            error = ex.Message;
            confirmingRemove = false;
        }
        finally
        {
            busy = false;
        }
    }
}
