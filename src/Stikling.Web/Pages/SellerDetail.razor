@page "/sellers/{Id:guid}"
@inject SellerService SellerService
@inject IPlantRepository PlantRepository
@inject IPropagationRepository PropagationRepository
@inject IPestCaseRepository PestCaseRepository
@inject NavigationManager Navigation

<PageTitle>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.SellerPageTitle, seller?.Name ?? Strings.Supplies.SellerFallbackName)</PageTitle>
<ReloadOnSync Reload="LoadAsync" />

<a class="back-link" href="sellers">@Strings.Supplies.SellerBack</a>

@if (loading)
{
    <p class="text-body-secondary">@Strings.Supplies.Loading</p>
}
else if (seller is null || summary is null)
{
    <p class="text-body-secondary">@Strings.Supplies.SellerMissing</p>
}
else
{
    <h1>@seller.Name</h1>
    <p class="seller-kind">@Labels.For(seller.Kind)@(string.IsNullOrWhiteSpace(seller.Notes) ? null : $" · {seller.Notes}")</p>

    @if (errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var error in errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <section class="settings-section">
        <h2>@Strings.Supplies.SellerHowTheyDid</h2>

        @if (summary.Total == 0)
        {
            <p class="text-body-secondary">@Strings.Supplies.SellerNothingYet</p>
        }
        else
        {
            <dl class="detail-list">
                <dt>@Strings.Supplies.SellerPlants</dt>
                <dd>@PlantsText</dd>

                @if (summary.Propagations.Count > 0)
                {
                    <dt>@Strings.Supplies.SellerPropagations</dt>
                    <dd>@Plural.Of(summary.Propagations.Count, Strings.Supplies.Propagation_One, Strings.Supplies.Propagation_Other)</dd>
                }

                <dt>@Strings.Supplies.SellerPestsEarly</dt>
                <dd>@PestsText</dd>

                <dt>@Strings.Supplies.SellerHowArrived</dt>
                <dd>
                    @ArrivalText
                    @if (summary.Problems.Count > 0)
                    {
                        <div class="seller-problems">@string.Join(", ", summary.Problems.Select(p => $"{Labels.For(p.Key).ToLowerInvariant()} {p.Value}"))</div>
                    }
                </dd>

                @if (summary.PaidCount > 0)
                {
                    <dt>@Strings.Supplies.SellerPaid</dt>
                    <dd>@PaidText</dd>
                }
            </dl>

            @if (summary.Plants.Count > 0)
            {
                <h3 class="seller-list-title">@Strings.Supplies.SellerPlants</h3>
                <ul class="seller-things">
                    @foreach (var plant in summary.Plants)
                    {
                        <li>
                            <a class="seller-thing" href="plants/@plant.Id">
                                <span>@plant.DisplayName</span>
                                <span class="seller-thing-note">@ThingNote(plant)</span>
                            </a>
                        </li>
                    }
                </ul>
            }

            @if (summary.Propagations.Count > 0)
            {
                <h3 class="seller-list-title">@Strings.Supplies.SellerPropagations</h3>
                <ul class="seller-things">
                    @foreach (var propagation in summary.Propagations)
                    {
                        <li>
                            <a class="seller-thing" href="propagations/@propagation.Id">
                                <span>@propagation.DisplayName</span>
                                <span class="seller-thing-note">@Arrival.PoorText(propagation.ArrivedIn, propagation.ArrivalProblems)</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    </section>

    <section class="settings-section">
        <h2>@Strings.Supplies.SellerAbout</h2>

        <div class="mb-3">
            <label class="form-label" for="seller-name">@Strings.Supplies.Name</label>
            <input id="seller-name" class="form-control" autocomplete="off" @bind="name" @bind:event="oninput" />
            <div class="form-text">@Strings.Supplies.SellerRenameHint</div>
        </div>

        <div class="mb-3">
            <div class="form-label" id="seller-kind-label">@Strings.Supplies.WhatItIs</div>
            <div class="chip-row" role="group" aria-labelledby="seller-kind-label">
                @foreach (var option in Enum.GetValues<SellerKind>())
                {
                    <button type="button" class="chip @(kind == option ? "picked" : null)"
                            aria-pressed="@(kind == option ? "true" : "false")"
                            @onclick="() => kind = option">@Labels.For(option)</button>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="seller-notes">@Strings.Supplies.Notes</label>
            <textarea id="seller-notes" class="form-control" rows="2" @bind="notes"></textarea>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">@Strings.Supplies.SaveChanges</button>
        </div>
    </section>

    <section class="settings-section">
        <h2>@Strings.Supplies.SellerTidy</h2>

        @if (mode == Mode.Merging)
        {
            <div class="mb-3">
                <label class="form-label" for="seller-merge">@Strings.Supplies.SellerMergeInto</label>
                <select id="seller-merge" class="form-select" @bind="mergeTarget">
                    <option value="">@Strings.Supplies.SellerPick</option>
                    @foreach (var other in others)
                    {
                        <option value="@other.Id">@other.Name</option>
                    }
                </select>
                <div class="form-text">
                    @string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.SellerMergeHint, seller.Name)
                </div>
            </div>
            <div class="care-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(busy || mergeTarget is null)" @onclick="MergeAsync">@Strings.Supplies.SellerMerge</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => mode = Mode.None">@Strings.Common.Cancel</button>
            </div>
        }
        else if (mode == Mode.Deleting)
        {
            <p>
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Supplies.SellerDeleteConfirm, seller.Name)
            </p>
            <div class="care-actions">
                <button type="button" class="btn btn-danger btn-sm" disabled="@busy" @onclick="DeleteAsync">@Strings.Common.Delete</button>
                <button type="button" class="btn btn-link btn-sm" @onclick="() => mode = Mode.None">@Strings.Common.Cancel</button>
            </div>
        }
        else
        {
            <div class="care-actions">
                @if (others.Count > 0)
                {
                    <button type="button" class="btn btn-link btn-sm link-action" @onclick="StartMerge">@Strings.Supplies.SellerMergeLink</button>
                }
                <button type="button" class="btn btn-link btn-sm link-action" @onclick="() => mode = Mode.Deleting">@Strings.Common.Delete</button>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private enum Mode { None, Merging, Deleting }

    private Seller? seller;
    private SellerSummary? summary;
    private IReadOnlyList<Seller> others = [];
    private bool loading = true;
    private bool busy;
    private List<string> errors = [];
    private Mode mode;

    // Kept apart from the seller, so a sync arriving doesn't change what is being typed
    private string name = "";
    private SellerKind kind;
    private string? notes;
    private Guid? loadedFor;

    private string? mergeTarget
    {
        get => mergeId?.ToString();
        set => mergeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private Guid? mergeId;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var sellers = await SellerService.GetSellersAsync();
        var found = sellers.Find(Id);
        if (found is not null && found.Id != Id)
        {
            // Merged into another one, possibly on another device
            Navigation.NavigateTo($"sellers/{found.Id}", replace: true);
            return;
        }

        seller = found;
        if (found is not null)
        {
            summary = SellerSummary.For(
                found, sellers,
                await PlantRepository.GetAllAsync(),
                await PropagationRepository.GetAllAsync(),
                await PestCaseRepository.GetAllAsync());
            others = sellers.Live.Where(s => s.Id != found.Id).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

            if (loadedFor != found.Id)
            {
                name = found.Name;
                kind = found.Kind;
                notes = found.Notes;
                loadedFor = found.Id;
                mode = Mode.None;
                errors = [];
            }
        }
        loading = false;
    }

    private void StartMerge()
    {
        mergeId = null;
        mode = Mode.Merging;
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            await SellerService.UpdateAsync(Id, name, kind, notes);
            loadedFor = null;
        });
    }

    private async Task MergeAsync()
    {
        if (mergeId is not { } target)
            return;

        await RunAsync(async () =>
        {
            await SellerService.MergeAsync(Id, target);
            Navigation.NavigateTo($"sellers/{target}");
        });
    }

    private async Task DeleteAsync()
    {
        await RunAsync(async () =>
        {
            await SellerService.DeleteAsync(Id);
            Navigation.NavigateTo("sellers");
        });
    }

    private async Task RunAsync(Func<Task> work)
    {
        busy = true;
        errors = [];
        try
        {
            await work();
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            errors = [ex.Message];
        }
        catch (InvalidOperationException ex)
        {
            errors = [ex.Message];
        }
        finally
        {
            busy = false;
        }
    }

    private static System.Globalization.CultureInfo culture => System.Globalization.CultureInfo.CurrentCulture;

    private static string Money(decimal amount) =>
        amount.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);

    private string PlantsText
    {
        get
        {
            if (summary!.Plants.Count == 0)
                return Strings.Supplies.SellerNone;
            var parts = new List<string>();
            if (summary.StillHere > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerStillHere, summary.StillHere));
            if (summary.Died > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerDied, summary.Died));
            if (summary.GivenAway > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerGivenAway, summary.GivenAway));
            if (summary.Sold > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerSold, summary.Sold));
            return string.Format(culture, Strings.Supplies.SellerPlantsBreakdown, Labels.Plants(summary.Plants.Count), string.Join(", ", parts));
        }
    }

    private string PestsText => summary!.PestCases == 0
        ? string.Format(culture, Strings.Supplies.SellerNoPestCases, SellerSummary.PestWindowDays)
        : string.Format(culture, Strings.Supplies.SellerPestCases,
            Plural.Of(summary.PestCases, Strings.Supplies.PestCase_One, Strings.Supplies.PestCase_Other),
            SellerSummary.PestWindowDays, Labels.Plants(summary.PlantsWithPests));

    private string ArrivalText
    {
        get
        {
            if (!summary!.HasArrivals)
                return Strings.Supplies.SellerNotRated;
            var parts = new List<string>();
            if (summary.ArrivedGood > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerArrivedGood, summary.ArrivedGood));
            if (summary.ArrivedOk > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerArrivedOk, summary.ArrivedOk));
            if (summary.ArrivedPoor > 0) parts.Add(string.Format(culture, Strings.Supplies.SellerArrivedPoor, summary.ArrivedPoor));
            return string.Join(", ", parts);
        }
    }

    private string PaidText =>
        string.Format(culture, Strings.Supplies.SellerPaidText, Money(summary!.PaidTotal), Money(summary.PaidAverage ?? 0), Labels.Plants(summary.PaidCount));

    private static string ThingNote(Plant plant) =>
        string.Join(" · ", new[]
        {
            plant.InCollection ? null : Labels.StatusOf(plant),
            Arrival.PoorText(plant.ArrivedIn, plant.ArrivalProblems)
        }.Where(p => !string.IsNullOrEmpty(p)));
}
