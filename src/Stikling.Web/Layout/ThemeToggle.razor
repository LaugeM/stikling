@implements IDisposable
@inject ThemeService Theme

<button type="button" class="theme-toggle" @onclick="ToggleAsync"
        aria-label="@(isDark ? "Switch to light mode" : "Switch to dark mode")"
        title="@(isDark ? "Switch to light mode" : "Switch to dark mode")">
    @if (isDark)
    {
        @* Sun: shown in dark mode, tap for light *@
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    }
    else
    {
        @* Moon: shown in light mode, tap for dark *@
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    }
</button>

@code {
    private bool isDark;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;
        isDark = await Theme.IsDarkAsync();
    }

    private async Task ToggleAsync() =>
        await Theme.SetModeAsync(isDark ? ThemeMode.Light : ThemeMode.Dark);

    private async void OnThemeChanged()
    {
        isDark = await Theme.IsDarkAsync();
        StateHasChanged();
    }

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
