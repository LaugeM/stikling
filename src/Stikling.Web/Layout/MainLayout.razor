@inherits LayoutComponentBase
@inject IndexedDb Db

<div class="app-shell">
    <header class="app-header">
        <span class="app-title">Stikling</span>
        <ThemeToggle />
    </header>

    <main class="app-content @(updateReady ? "with-banner" : null)">
        @Body
    </main>

    <UpdateBanner ReadyChanged="ready => updateReady = ready" />

    <nav class="bottom-nav" aria-label="Main">
        <NavLink class="bottom-nav-link" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" /></svg>
            <span>Today</span>
        </NavLink>
        <NavLink class="bottom-nav-link" href="plants">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
            <span>Plants</span>
        </NavLink>
        <NavLink class="bottom-nav-link" href="propagations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l-1 6v9a3 3 0 0 1-6 0V9Z" /><path d="M12 12v4M12 16l-2 2M12 16l2 2" /></svg>
            <span>Props</span>
        </NavLink>
        <NavLink class="bottom-nav-link" href="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
            <span>Settings</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool updateReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            // Asks the browser to keep the data when space runs low. Installed apps are
            // usually granted this without asking the user anything.
            await Db.RequestPersistenceAsync();
        }
        catch (JSException)
        {
            // Storage that can't be made persistent still works
        }
    }
}
