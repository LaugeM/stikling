@inherits LayoutComponentBase
@implements IDisposable
@inject IndexedDb Db
@inject ThemeService Theme
@inject SyncRunner Sync
@inject IPestCaseRepository PestCases
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-header">
        <a class="app-title" href="">
            <img src="icon-192.png" alt="" width="28" height="28" />
            Stikling
        </a>
        <NavLink class="settings-link" href="settings" aria-label="@(Sync.HasProblem ? "Settings, sync problem" : "Settings")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
            @if (Sync.HasProblem)
            {
                <span class="settings-link-dot" aria-hidden="true"></span>
            }
        </NavLink>
    </header>

    <main class="app-content @(updateReady ? "with-banner" : null)">
        @Body
    </main>

    <UpdateBanner ReadyChanged="ready => updateReady = ready" />

    <nav class="bottom-nav" aria-label="Main">
        <NavLink class="bottom-nav-link" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" /></svg>
            <span>Today</span>
        </NavLink>
        <NavLink class="bottom-nav-link" href="plants">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21v-9" /><path d="M12 12C12 7 8 4 4 4c0 4 3 8 8 8Z" /><path d="M12 14c0-4 3-7 8-7 0 4-3 7-8 7Z" /></svg>
            <span>Plants</span>
        </NavLink>
        <NavLink class="bottom-nav-link" href="propagations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l-1 6v9a3 3 0 0 1-6 0V9Z" /><path d="M12 12v4M12 16l-2 2M12 16l2 2" /></svg>
            <span>Props</span>
        </NavLink>
        @if (pestTab)
        {
            <NavLink class="bottom-nav-link" href="pests">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4" /><path d="M12 9V6M8.5 10.5 6 8M15.5 10.5 18 8M8 13H4M20 13h-4M8.5 15.5 6 18M15.5 15.5 18 18M12 17v3" /></svg>
                <span>Pests</span>
            </NavLink>
        }
        @* Without its own tab, Pests is reached from Supplies, so that tab shows where you are *@
        <NavLink class="@($"bottom-nav-link {(!pestTab && OnPestsPage ? "active" : null)}")" href="supplies">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 4.5h15v3.5h-15Z" /><path d="M6 8l1.5 11a1.5 1.5 0 0 0 1.5 1.3h6a1.5 1.5 0 0 0 1.5-1.3L18 8" /></svg>
            <span>Supplies</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool updateReady;

    // Pests only has a tab while a case is open, so someone who never has pests isn't shown one.
    // It is worked out again when the page changes and when sync brings changes. Saving a case
    // goes to its page, so that covers opening and resolving one.
    private bool pestTab;

    private bool OnPestsPage =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] is var path
        && (path == "pests" || path.StartsWith("pests/", StringComparison.Ordinal));

    protected override async Task OnInitializedAsync()
    {
        Sync.StatusChanged += OnSyncChanged;
        Sync.Received += OnReceived;
        Navigation.LocationChanged += OnLocationChanged;
        await CheckPestsAsync();
    }

    private void OnSyncChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnReceived() => _ = InvokeAsync(CheckPestsAsync);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(CheckPestsAsync);

    private async Task CheckPestsAsync()
    {
        var open = (await PestCases.GetAllAsync()).Any(c => c.IsOpen);
        if (open != pestTab)
        {
            pestTab = open;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Sync.StatusChanged -= OnSyncChanged;
        Sync.Received -= OnReceived;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The saved theme counts, the copy in localStorage is only for the first paint
        await Theme.ApplySavedAsync();

        try
        {
            // Asks the browser to keep the data when space runs low. Installed apps are
            // usually granted this without asking the user anything.
            await Db.RequestPersistenceAsync();
        }
        catch (JSException)
        {
            // Storage that can't be made persistent still works
        }

        // After the app is on screen, so a slow or missing connection never holds it back
        await Sync.StartAsync();
    }
}
