@using Stikling.Core.Sharing
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@Heading</title>
<meta name="description" content="@Description">
@if (!Context.Searchable)
{
    <meta name="robots" content="noindex, nofollow">
}
<meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121814" media="(prefers-color-scheme: dark)">
@if (Context.Canonical is not null)
{
    <link rel="canonical" href="@Context.Canonical">
}
<meta property="og:title" content="@Heading">
<meta property="og:description" content="@Description">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Stikling">
<meta property="og:url" content="@(Context.Canonical ?? Context.PageUrl)">
@if (Image is { } image)
{
    <meta property="og:image" content="@(Context.RootUrl)/photos/@image.Id/full">
    @if (image.Width > 0 && image.Height > 0)
    {
        <meta property="og:image:width" content="@image.Width">
        <meta property="og:image:height" content="@image.Height">
    }
}
<meta name="twitter:card" content="summary_large_image">
<style>@((MarkupString)PublicPageStyles.Css)</style>

@code {
    [Parameter, EditorRequired] public PublicPageContext Context { get; set; } = null!;

    /// <summary>The text of the browser tab, like "Lauge's plants on Stikling".</summary>
    [Parameter, EditorRequired] public string Heading { get; set; } = "";

    [Parameter] public string? Line { get; set; }

    /// <summary>The picture for a link preview.</summary>
    [Parameter] public Stikling.Core.Sharing.SharePhoto? Image { get; set; }

    private string Description => Line ?? PublicPageText.Description;
}
