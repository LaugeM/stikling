@using Stikling.Api.Sharing
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121814" media="(prefers-color-scheme: dark)">
    <title>Not here - Stikling</title>
    <style>@((MarkupString)ShareStyles.Css)</style>
</head>
<body>
    <main class="gone">
        <h1>Stikling</h1>
        <p class="line">This page isn't here any more. It may have been turned off by the person who shared it.</p>
        <p><a class="start" href="@ShareStyles.AppUrl">Go to Stikling</a></p>
    </main>
</body>
</html>
